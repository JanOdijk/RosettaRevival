< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I2:complrel/SENTENCE{SENTENCErec1}
                                 [ I3:mu9,
                                   subjrel/T2,
                                   I4:mu6 
                                 ],
                      mu5,
                      I1:rel1/T1,
                      mu7 
                    ],
              mu8 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I2:complrel/SENTENCE{SENTENCErec1}
                                 [ I3:mu9,
                                   I4:mu6 
                                 ],
                      mu5,
                      I1:rel1/T1,
                      mu7 
                    ],
              mu8 
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [indobjrel]
       I2: SENTENCErec1.PROSubject = true
       I3: ALL(mu9, I31:rel3/..)
           I31: rel3 IN [shiftrel, conjrel]
       I4: NOT EXIST(mu6, [shiftrel/..])
      >

<
   SUBRULE
      <
       T1:VARPREPP{VARPREPPrec1}
                  [head/PREP{PREPrec1},
                   objrel/NPVAR{NPVARrec1}
                  ]
       T2:NPVAR{NPVARrec2}
      >
      <T1:VARPREPP{VARPREPPrec1}
                  [head/PREP{PREPrec1},
                   objrel/NPVAR{NPVARrec1}
                  ]
      >

      COMP
         <
          C1:(rel1 = indobjrel) AND (VERBrec1.controller = indobj) AND
              (NPVARrec1 = NPVARrec2)
          A1: @
         >

      DECOMP
         <
          C1:(rel1 = indobjrel) AND (VERBrec1.controller = indobj) 
          A1: NPVARrec2 := NPVARrec1
         >


   SUBRULE
      <
       T1:VARPREPP{VARPREPPrec1}
                  [head/PREP{PREPrec1},
                   objrel/CNVAR{CNVARrec1}
                  ]
       T2:CNVAR{CNVARrec2}
      >
      <T1:VARPREPP{VARPREPPrec1}
                  [head/PREP{PREPrec1},
                   objrel/CNVAR{CNVARrec1}
                  ]
      >

      COMP
         <
          C1:(rel1 = indobjrel) AND (VERBrec1.controller = indobj) AND
              (CNVARrec1 = CNVARrec2)
          A1: @
         >

      DECOMP
         <
          C1:(rel1 = indobjrel) AND (VERBrec1.controller = indobj) 
          A1: CNVARrec2 := CNVARrec1
         >
>
&

