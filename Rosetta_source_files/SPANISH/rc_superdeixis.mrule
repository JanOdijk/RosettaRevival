\begin{verbatim}
%
% RULE Rfinpresentsuperdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            mu5
           ] 

>

<
   SUBRULE
      < mu5: [I1: mu6]>
      < mu5: [I1: mu6]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto <> perfectivo) OR
               ((CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := presente;
             
             C12:(CLAUSErec1.supertiempo = presente) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo= presente) AND
              ((CLAUSErec2.aspecto <> perfectivo) OR
               ((CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = presente)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = presente)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.tiempo = omegatiempo)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto <> perfectivo OR
               CLAUSErec1.retro = true)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := presente;
             
             C12:(CLAUSErec1.supertiempo = presente) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto <> perfectivo OR
               CLAUSErec2.retro = true)
             )
              C11: (CLAUSErec2.supertiempo = presente)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = presente)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.tiempo = omegatiempo)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto <> perfectivo OR
               CLAUSErec1.retro = true)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := presente;
             
             C12:(CLAUSErec1.supertiempo = presente) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto <> perfectivo OR
               CLAUSErec2.retro = true)
             )
              C11: (CLAUSErec2.supertiempo = presente)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = presente)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjtiempo = omegatiempo) AND
           (SENTENCErec1.temporal = true)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto <> perfectivo OR
               CLAUSErec1.retro = true)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := presente;
             
             C12:(CLAUSErec1.supertiempo = presente) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto <> perfectivo OR
               CLAUSErec2.retro = true)
             )
              C11: (CLAUSErec2.supertiempo = presente)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = presente)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpresentsuperdeixis
\item[* relevant examples:] ella dice (que Juan duerme)
                            ella dice (que viene a las tres)
                            ella quiere (que venga a las tres)
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 21-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentsuperdeixis dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 21/11/88 \ \ \ \ author: Lisette Appelo
\item date: 31/01/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on retro. If retro is true, aspect may be perfective.
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT.
               This rule is for a finite dependent clause.
               The most right verb in the clause gets a present tense.
               The deixis 
value of the possible reference adverbial is checked for 
               omega.
               The clause is marked for present superdeixis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials and the not occurrence of a reference adverbial. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be presentdeixis in the case 
this sentence is a sentence with {\em graag}\\
21/11/88: Added condition on aspect of clause. Perfective aspect is only 
allowed when  adverbials are absent. Perfective aspect goes with future tense 
otherwise.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rfinpastsuperdeixis1
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            mu5
           ] 

>

<
   SUBRULE (* no reference adverbials *)
      < mu5: [I1: mu6]>
      < mu5: [I1: mu6]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto <> perfectivo) 
                OR
              ((CLAUSErec1.aspecto = perfectivo) AND
               (VERBrec1.aspecto <> perfectivo) (* subjuntivo *)
              ) OR
              ((CLAUSErec1.aspecto = perfectivo) AND
               (VERBrec1.aspecto = perfectivo) AND
               (CLAUSErec1.retro = false ->
                QUOTE_tempdurnotfound(mu5))
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto <> perfectivo) 
                OR
              ((CLAUSErec2.aspecto = perfectivo) AND
               (VERBrec1.aspecto <> perfectivo) (* subjuntivo *)
              ) OR
              ((CLAUSErec2.aspecto = perfectivo) AND
               (VERBrec2.aspecto = perfectivo) AND
               (CLAUSErec2.retro = false ->
                QUOTE_tempdurnotfound(mu5))
              )
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = pasado)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpastsuperdeixis1
\item[* relevant examples:] ella dijo (que dorm\'{i}a/durm\'{i}o)
ella dijo (que hab\'{\i}a dormido (por 4 horas))
ella quer\'{\i}a que durmiera
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 21-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentsuperdeixis
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/06/89\ \ \ \ \ author: Lisette Appelo\\
Splitted Rfinpastsuperdeixis into Rfinpastsuperdeixis1 and 2. This rule is the 
counterpart of Rfinpresentsuperdeixis in the past. It corresponds to 
Lpastsuperdeixis and Rinfinpastsuperdeixis and Rfinpastfutsuperdeixis. It 
accounts for the cases without reference adverbials, because they have a future 
interpretation (Rfinpastfutsuperdeixis) or a `past-past'-interpretation (
Rfinpastsuperdeixis2). The perfective, non-retro case with duration adverbial 
is also excluded here. It is accounted for in Rfinpastfutsuperdeixis
({\em Dijo que dormir\'{\i}a por tres horas}) or Rfinpastsuperdeixis2
({\em dijo que durmi\'{o} por tres horas}).
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a finite dependent clause.
               The most right verb in the clause gets a past tense.
               The deixis 
value of the possible reference adverbial is checked for 
               omega.
               The clause is marked for past superdeixis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials and the not occurrence of a reference adverbial. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be presentdeixis in the case 
this sentence is a sentence with {\em graag}\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rfinpastsuperdeixis2
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            mu5
           ] 

>

<
   SUBRULE (* 1: duration adverbial, no reference adverbial *)
      < mu5: [I1: mu6]>
      < mu5: [I1: mu6]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6) AND
           (NOT QUOTE_tempdurnotfound(mu6))
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto = perfectivo AND 
                CLAUSErec1.retro = false) ->
               (VERBrec1.aspecto = perfectivo)
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              ((CLAUSErec2.aspecto = perfectivo AND
                CLAUSErec2.retro = false) ->
               (VERBrec2.aspecto = perfectivo)
              ) 
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = pasado)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.tiempo IN [omegatiempo, pasado])
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec2.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto = perfectivo AND 
               CLAUSErec1.retro = false) ->
               (VERBrec1.aspecto = perfectivo)
              ) 
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              ((CLAUSErec2.aspecto = perfectivo AND
                CLAUSErec2.retro = false) ->
               (VERBrec2.aspecto = perfectivo)
              ) 
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = pasado)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.tiempo IN [omegatiempo, pasado])
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto = perfectivo AND 
                CLAUSErec1.retro = false) ->
               (VERBrec1.aspecto = perfectivo)
              )  
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              ((CLAUSErec2.aspecto = perfectivo AND
                CLAUSErec2.retro = false) ->
               (VERBrec2.aspecto = perfectivo)
              )  
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = pasado)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjtiempo IN [omegatiempo, pasado]) AND
           (SENTENCErec1.temporal = true)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto = perfectivo AND 
                CLAUSErec1.retro = false) ->
               (VERBrec1.aspecto = perfectivo)
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             
             C12:(CLAUSErec1.supertiempo = pasado) 
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              ((CLAUSErec2.aspecto = perfectivo AND
                CLAUSErec2.retro = false) ->
               (VERBrec2.aspecto = perfectivo)
              )
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

              C12: (CLAUSErec2.supertiempo = pasado)(* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;

         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpastsuperdeixis2
\item[* relevant examples:] ella dijo (que dorm\'{i}a/durm\'{i}o ayer)\\
                            ella dijo (que ven\'{i}a/vino a las tres)\\
                            ella dijo (que hab\'{\i} venido a las tres/ ayer)\\
                            ella dijo (que trabj\'{o} por 4 horas)\\
                            ella quiso (que hubiera trabajado (por 4 horas))\\
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 21-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentsuperdeixis
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/06/89\ \ \ \ \ author: Lisette Appelo\\
Splitted Rfinpastsuperdeixis into Rfinpastsuperdeixis1 + 2. This rule 
corresponds to Lpastpastsuperdeixis and Rinfinpastsuperdeixisspec. It accounts 
for the past-past-reading of the embedded sentence with respect to the matrix 
clause. In non-retrospective, perfective clauses the subjuntivo is exluded here
. it is supposed that it has only a simultanuous/future reading with respect to 
the matrix clause. 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a finite dependent clause.
               The most right verb in the clause gets a past tense.
               The deixis 
value of the possible reference adverbial is checked for 
               omega.
               The clause is marked for past superdeixis.
