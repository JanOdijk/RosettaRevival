\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
Via a condition on 
{\em QP.posspred}=true ,
{\em much} and {\em (a) little} would be excluded from this rule.
These forms become (as BDET) already DETP via RDETPformation1. 
However, in view of rqpamountmod the Qs should be allowed to become DETP too. 
Ambiguity must still be resolved. (08-07-91; FJ)

\item modifications:27/10/88: Added superdeixis\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE DETPformation4
< m1: DEMADJ{DEMADJrec1} 
>

< m : DETP{DETPrec1}[head/DEMADJ{DEMADJrec1}]
>

      COMP
         <
          C1: true
              C11: DEMADJrec1.number = singular
              A11: DETPrec1.posscomas := [count, mass];
              C12: DEMADJrec1.number = plural
              A12: DETPrec1.posscomas := [count];
          A1: DETPrec1.possnumbers := [DEMADJrec1.number];
              DETPrec1.definite := def;
              DETPrec1.posspred := true;
              (* mood, possnietnp, superdeixis
                 remain default *)
         >

      DECOMP
         <
          C1: DETPrec1.definite = def AND
              DETPrec1.posspred = true AND
              DETPrec1.possnietnp = false AND
              DETPrec1.mood = nowh AND
              DETPrec1.superdeixis = omegadeixis AND
              DETPrec1.possnumbers = [DEMADJrec1.number]
              C11: [mass, count] * DETPrec1.posscomas <> [] AND
                   DEMADJrec1.number = singular
              A11: @
              C12: [count] * DETPrec1.posscomas <> [] AND
                   DEMADJrec1.number = plural
              A12: @
          A1: @
         >
&

\end{verbatim}
