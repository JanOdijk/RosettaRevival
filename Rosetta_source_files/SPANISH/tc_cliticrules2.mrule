SPANISH 90
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TDOclminusPERSPRO2
< m1:I1::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}[ mu4,
                                        head/I5::VERB{VERBrec1}[mu3],
                                        cliticrel/CLITIC{}[mu7],
                                        mu10,
                                        I3:rel1/I4::NP{NPrec1}[mu5],
                                        mu6 
                                      ],
              mu9
            ]
>

< m:I1::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}[ mu4,
                                        head/I5::VERB{VERBrec1}[mu3],
                                        cliticrel/CLITIC{}[mu8],
                                        mu10,
                                        mu6
                                      ],
              mu9
            ]
>


   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.finiteness = infinite) AND
           (CLAUSErec1.voice <> SEpassive)
            (*  AND
           (NPrec1.animate = noanimate -> 
            NOT EXIST (mu1, [subjrel/I61::NP{NPrec6}])) 
                      I61: NPrec6.NPhead = SEimpershead *)   
       I3: rel1 IN [objrel, predrel]
       I4: (NPrec1.NPhead = persproNP)   AND
           (Prepositive IN NPrec1.cases) OR
           (Accusative IN NPrec1.cases) 
       I5: NOT (VERBrec1.thetaVP IN [vp010, vp012, vp021])
       
      >

<
   SUBRULE  (* me + deletion of mí; masc. *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_yomascBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel9/..]))  AND
             ALL (mu11, seCLrel/..)  
       I112: rel9 IN [unoCLrel, tresCLrel, dosCLrel]
      >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc) 
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)  AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                          AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >

SUBRULE  (* me + deletion of mí; masc. ; IO vosotros *)
      <mu7: [I11:mu11,
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu22]] >
      <mu8: [I11:mu11,
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu22], 
                 rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_yomascBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <  
       I13:  PERSPROrec2.numero = singular
       I11:  ALL (mu11, seCLrel/..)
       >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc) 
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)  AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                          AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >

   SUBRULE  (* me + deletion of mí; fem. *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_yofemBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel9/..]))  AND
             ALL (mu11, seCLrel/..)  
       I112: rel9 IN [unoCLrel, dosCLrel, tresCLrel]
      >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc) 
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma]) 
                                                                             AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >

SUBRULE  (* me + deletion of mí; fem.  IO vosotros *)
      <mu7: [I11:mu11,
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu22]] >      
      <mu8: [I11:mu11,
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu22], 
                 rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_yofemBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >

   MATCHCONDITIONS
      <
       I13:  PERSPROrec2.numero = singular 
       I11:  ALL (mu11, seCLrel/..)  
      >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc) 
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma]) 
                                                                             AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >


   SUBRULE  (* te + deletion of ti; masc. *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_tumascBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
       I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]
      >

      COMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 2;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := dosCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)           AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 2)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = dosCLrel)
          A1:  @
         >

   SUBRULE  (* te + deletion of ti; fem. *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_tufemBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
       I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]
      >

      COMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 2;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := dosCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 2)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = dosCLrel)
          A1:  @
         >


   SUBRULE  (* lo + deletion of  él/usted *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = reflexive) 
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = reflexive) AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >

   SUBRULE  (* lo + deletion of  él/usted *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [ unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = notreflexive)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = notreflexive) AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >

   SUBRULE  (* lo + deletion of ello *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_elloBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [ seCLrel,unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = neutro)         AND
              (VERBrec1.reflexivity = reflexive)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := neutro;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = neutro)           AND
              (VERBrec1.reflexivity = reflexive) AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = neutro)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >

SUBRULE  (* lo + deletion of ello *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_elloBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = neutro)         AND
              (VERBrec1.reflexivity = notreflexive)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := neutro;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = neutro)           AND
              (VERBrec1.reflexivity = notreflexive) AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = neutro)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >


SUBRULE  (* le + deletion of él/usted *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel10/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel,unoCLrel, dosCLrel]
       I112: rel10 IN [tresCLrel]  
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusLEcl;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)           AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusLEcl)  AND
              (rel3 = tresCLrel)
          A1:  @
         >


   SUBRULE  (* la + deletion of ella/usted *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel] 
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = singular) AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >


   SUBRULE  (* nos + deletion of nosotros (masc) *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_nosotrosBPERSPROkey){BPERSPROrec1}]
            ] 
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel9/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, dosCLrel]  
       I112: rel9 IN [unoCLrel, tresCLrel]
      >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >

   SUBRULE  (* nos + deletion of nosotras (fem) *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_nosotrasBPERSPROkey){BPERSPROrec1}]
            ]
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel9/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, dosCLrel]  
       I112: rel9 IN [unoCLrel, tresCLrel]
      >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >


   SUBRULE  (* os + deletion of vosotros (masc) *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_vosotrosBPERSPROkey){BPERSPROrec1}]
            ]
      >       
 

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
             I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]      
      >

      COMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 2;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := dosCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 2)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = dosCLrel)
          A1:  @
         >


   SUBRULE  (* os + deletion of vosotras (fem) *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                 [head/BPERSPRO(KEY_vosotrasBPERSPROkey){BPERSPROrec1}]
            ] 
      >       
 

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
             I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]      
      >

      COMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 2;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := dosCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 2)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = dosCLrel)
          A1:  @
         >


   SUBRULE  (* los + deletion of ellos/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_ellosBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = reflexive)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = reflexive)  AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >

SUBRULE  (* los + deletion of ellos/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_ellosBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = notreflexive)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = notreflexive) AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >


   SUBRULE  (* les + deletion of ellos/ustedes *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_ellosBPERSPROkey){BPERSPROrec1}]
            ]         
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel10/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel,unoCLrel, dosCLrel]
       I112: rel10 IN [tresCLrel]  
       >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusLEcl;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                           AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusLEcl)  AND
              (rel3 = tresCLrel)
          A1:  @
         >


   SUBRULE  (* las + deletion of ellas/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_ellasBPERSPROkey){BPERSPROrec1}],
             I12:mu12]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := tresCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 3)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = tresCLrel)
          A1:  @
         >
>

&

