 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3>, VPID6)
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID6);
       SUBVERBREC1 := COPYT_btosubverb(BVERBREC1);
 >

&
