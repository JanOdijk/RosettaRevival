pragma c_include('tstring.pf');
package surfcomlangspec;
with tstring;
const
     surfcomlangspec_nrow = 14 ;
type setofchar = set of char;
type
     surfcomlangspec_int=integer;
     surfcomlangspec_bool=boolean;
     surfcomlangspec_graphtypetype = (atomgraph,stargraph,optgraph,enclosedgraph);
plosstring = ^losstring;
losstring = record
   next:plosstring;
   carriage:boolean;
   arg:tstring_string
 end; 
localfile = record 
first,last:plosstring
 end; 
surfcomlangspec_ident = record 
str:TSTRING_string;

 end; 
plosident = ^losident;
losident = record
   next:plosident;
   arg:surfcomlangspec_ident
 end; 
surfcomlangspec_setofidents = record 
first,last:plosident
 end; 
     surfcomlangspec_pterminal = ^surfcomlangspec_terminal;
     surfcomlangspec_terminal = 
         record
                       str:tstring_string
           end;
     surfcomlangspec_puttrec = ^surfcomlangspec_uttrec;
     surfcomlangspec_uttrec = 
         record
           end;
     surfcomlangspec_prulespecrec = ^surfcomlangspec_rulespecrec;
     surfcomlangspec_rulespecrec = 
         record
                       rulename:TSTRING_string;
           end;
     surfcomlangspec_pgraphrec = ^surfcomlangspec_graphrec;
     surfcomlangspec_graphrec = 
         record
           end;
     surfcomlangspec_pnumberrec = ^surfcomlangspec_numberrec;
     surfcomlangspec_numberrec = 
         record
                            str:TSTRING_string;
           end;
     surfcomlangspec_prulebodyrec = ^surfcomlangspec_rulebodyrec;
     surfcomlangspec_rulebodyrec = 
         record
           end;
     surfcomlangspec_pblockrec = ^surfcomlangspec_blockrec;
     surfcomlangspec_blockrec = 
         record
                         number:TSTRING_string;
           end;
     surfcomlangspec_ppascalrec = ^surfcomlangspec_pascalrec;
     surfcomlangspec_pascalrec = 
         record
           end;
     surfcomlangspec_category = (comment,identifier,UTT,RULESPEC,RULEBODY,BLOCK,PASCALTOHEKJE,PASCALTOGLOBAL,PASCALTOEND,
PSTOSTARRIGHT,GRAPH,NUMBER,INITBLOCK,FINALBLOCK,PROCENT,LEFTSTAR,STARRIGHT,SLASH,COLON,ISCAT,DOT,HEKJE,DOLLAR,ACTION,CONDITION,
GLOBAL,LOCALCONDITION,VARCAT,AUX,KEYtje,MAKE,HINITCAT,HFINALCAT,REGULAREXPRESSION,CONDITIONSANDACTIONS,UNDERSCORE,SEMICOLON,COMMA,
ROUNDOPEN,ROUNDCLOSE);

surfcomlangspec_pfielddef = ^surfcomlangspec_fielddef;
surfcomlangspec_fielddef =
         record
      case cat:surfcomlangspec_category of
                  UTT:
                     (UTTfield:surfcomlangspec_puttrec);
                  RULESPEC:
                     (RULESPECfield:surfcomlangspec_prulespecrec);
                  RULEBODY:
                     (RULEBODYfield:surfcomlangspec_prulebodyrec);
                  BLOCK:
                     (BLOCKfield:surfcomlangspec_pblockrec);
                  PASCALTOHEKJE:
                     (PASCALTOHEKJEfield:surfcomlangspec_ppascalrec);
                  PASCALTOGLOBAL:
                     (PASCALTOGLOBALfield:surfcomlangspec_ppascalrec);
                  PASCALTOEND:
                     (PASCALTOENDfield:surfcomlangspec_ppascalrec);
                  PSTOSTARRIGHT:
                     (PSTOSTARRIGHTfield:surfcomlangspec_ppascalrec);
                  GRAPH:
                     (GRAPHfield:surfcomlangspec_pgraphrec);
                  NUMBER:
                     (NUMBERfield:surfcomlangspec_pnumberrec);
                  INITBLOCK:
                     (INITBLOCKfield:surfcomlangspec_pblockrec);
                  FINALBLOCK:
                     (FINALBLOCKfield:surfcomlangspec_pblockrec);
identifier,                  PROCENT,
                  LEFTSTAR,
                  STARRIGHT,
                  SLASH,
                  COLON,
                  ISCAT,
                  DOT,
                  HEKJE,
                  DOLLAR,
                  ACTION,
                  CONDITION,
                  GLOBAL,
                  LOCALCONDITION,
                  VARCAT,
                  AUX,
                  KEYtje,
                  MAKE,
                  HINITCAT,
                  HFINALCAT,
                  REGULAREXPRESSION,
                  CONDITIONSANDACTIONS,
                  UNDERSCORE,
                  SEMICOLON,
                  COMMA,
                  ROUNDOPEN,
                  ROUNDCLOSE:
                     (      terminal:surfcomlangspec_pterminal);
           end;

procedure initint(var s:integer);external;
procedure initbool(var s:boolean);external;
procedure initsetofidents(var s:surfcomlangspec_setofidents); external;
function stillidents(var s:surfcomlangspec_setofidents):boolean; external;
procedure takeident(var ident1:surfcomlangspec_ident
        ;var s:surfcomlangspec_setofidents); external;
procedure appendident(ident1:surfcomlangspec_ident
        ;var s:surfcomlangspec_setofidents); external;
 function surfcomlangspec_scanchars:setofchar;
         external;
 procedure surfcomlangspec_init; external;
 procedure surfcomlangspec_word(i:integer;var s:tstring_string);
         external;
 function surfcomlangspec_wcat(i:integer):surfcomlangspec_category;
         external;
 function surfcomlangspec_scat(c:char):surfcomlangspec_category;
         external;
 procedure surfcomlangspec_createterm(s:surfcomlangspec_category;
           w:tstring_string;var f:surfcomlangspec_fielddef);
         external;
end{langspec};
