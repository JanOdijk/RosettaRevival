\newpage
\begin{verbatim}
% TRANSFORMATION TShallWill
< m1: SENTENCE{SENTENCErec1}
              [ I1: mu1,
                auxrel/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                           [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                      ],
                mu2
              ]
>

< m : SENTENCE{SENTENCErec1}
              [ I1: mu1,
                auxrel/VERB{VERBrec2}
                      [head/SUBVERB{SUBVERBrec2}
                           [head/BVERB(KEY_shallBVERBkey){BVERBrec2}]
                      ],
                mu2
              ]
>

   MATCHCONDITIONS
      <
       I1: EXIST (mu1, [subjrel/I11::NP{NPrec1}[mu3]])
         I11: NPrec1 = { person : 1
                         NPhead : persproNP }
      >

      COMP
         <
          C1: SENTENCErec1 = { mood      IN [yesnointerrogative,
                                             whinterrogative]
                               senttype   : mainclause
                               modus      : indicative
                               finiteness : finite }  AND
              VERBrec1 = { tense   : presenttense
                           persons NI 1
                           modus   : indicative } AND
              VERBrec1 = COPYT_subverbTOverb(SUBVERBrec1) AND
              SUBVERBrec1 = COPYT_bverbTOsubverb(BVERBrec1)
          A1: SUBVERBrec2 := COPYT_bverbTOsubverb(BVERBrec2);
              VERBrec2 := COPYT_subverbTOverb(SUBVERBrec2);
              VERBrec2 := { tense   : presenttense
                            persons : [1]
                            numbers : VERBrec1.numbers
                            modus   : indicative }
         >

      DECOMP
         <
          C1: VERBrec2 = { tense   : presenttense
                           persons NI 1
                           modus   : indicative } AND
              VERBrec2 = COPYT_subverbTOverb(SUBVERBrec2) AND
              SUBVERBrec2 = COPYT_bverbTOsubverb(BVERBrec2)
          A1: SUBVERBrec1 := COPYT_bverbTOsubverb(BVERBrec1);
              VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
              VERBrec1 := { tense   : presenttense
                            persons : [1]
                            numbers : VERBrec2.numbers
                            modus   : indicative }

         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TShallWill
\item[* relevant examples:] (where) I will see you $\rightarrow$ 
(where) I shall see you \\
((where) shall I see you; in analysis also: He said 
that I shall see you, I shall see you)
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) 
TC\_ShallWillSwap
\item[* date of creation:] 7-DEC-1989 16:45:45  
\item[* author:] margreet sanders
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to swap the auxiliary {\em will\/} for the equivalent 
{\em shall\/} when the subject is {\em I\/} or {\em we\/}.
\item[\ \ strategy:] (also: deviations from accepted proposals) It is assumed 
that this {\em shall\/} is a spelling variant for {\em will\/}. The 
{\em shall\/} that is used as an emphatic {\em will\/} or {\em must\/} must be 
treated differently (it should have a special skey, e.g.\ {\em emphshallkey\/}).
It is also assumed that the rule should only work in present tense contexts, 
i.e. {\em should\/} is not seen simply as the past tense of {\em shall\/}.
The rule is placed here because then TNegAuxAdapt also works for 
{\em shan't\/}. Note that {\em shall\/} is made obligatory for 1st person 
questions! This can of course be removed.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
In generation for questions only, in analysis always allowed
