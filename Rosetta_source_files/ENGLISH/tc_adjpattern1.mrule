\begin{verbatim}
% TRANSFORMATION TADJPATTERN16   
                    (* sentential object with omitted preposition 
                       I am glad that it will be going to rain
                       I am afraid to fly
                       I am glad to be able to join you
                       I am curious whether it is going to rain *)

< m1: ADJPPROP{ADJPPROPrec1}
                      [mu1,
                       predrel/ADJP{ADJPrec1}
                              [head/ADJ{ADJrec1}[mu2],
                               argrel/SENTENCEVAR{SENTENCEVARrec1}
                              ]
                       ]
>

< m : ADJPPROP{ADJPPROPrec2}
         [mu1,
          predrel/ADJP{ADJPrec2}
                  [head/ADJ{ADJrec1}[mu2],
                   complrel/SENTENCEVAR{SENTENCEVARrec1}
                  ]
         ]
>


      COMP
         <
          C1: (ADJrec1.adjpatterns * [synOPENTOSENT,  
                                        synTHATSENT,
                                        synQSENT
                                        ]  <> [])       AND
              (ADJPPROPrec1.adjpatternefs = []) AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                  }
              )

             C11: (* I am afraid to get lost *)
                  (synOPENTOSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { PROsubject  : true                    
                                       finiteness  : infinite
                                       mood        : declarative
                                       infsort     : toinf
                                      }
                   )
             A11: 
                  ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synOPENTOSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synOPENTOSENT]

             C13: (* he is glad that it will be going to rain *)
                  (synTHATSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { finiteness  : finite
                                       mood        : declarative
                                      }
                  )
             A13: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synTHATSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synTHATSENT]

             C14: (* he is curious whether it will be raining;
                     not: ........ who is going to win *)
                  (synQSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1.finiteness = finite) AND
                  (SENTENCEVARrec1.mood IN 
                   [WHinterrogative, YesNointerrogative])
                                       
             A14: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synQSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synQSENT]


          A1: @
 
         >

      DECOMP
         <
          C1: (ADJrec1.adjpatterns * [synOPENTOSENT,  
                                        synTHATSENT,
                                        synQSENT
                                        ]  <> [])       AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                  }
              )

              C11: (synOPENTOSENT IN ADJrec1.adjpatterns) AND
                   (synOPENTOSENT IN ADJPrec2.adjpatternefs) AND
                   (synOPENTOSENT IN ADJPPROPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1 = { PROsubject  : true                    
                                        finiteness  : infinite
                                        mood        : declarative
                                        infsort     : toinf
                                      }
                    )
              A11: @

              C13: (synTHATSENT IN ADJrec1.adjpatterns) AND
                   (synTHATSENT IN ADJPrec2.adjpatternefs) AND
                   (synTHATSENT IN ADJPPROPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1 = { finiteness  : finite
                                        mood        : declarative
                                      }
                   )
              A13: @

              C14: (synQSENT IN ADJrec1.adjpatterns) AND
                   (synQSENT IN ADJPrec2.adjpatternefs) AND
                   (synQSENT IN ADJPPROPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1.finiteness = finite) AND
                   (SENTENCEVARrec1.mood IN [WHinterrogative, 
                                                 YesNointerrogative])
                                       
              A14: @

          A1: ADJPPROPrec1 := ADJPPROPrec2;
              ADJPPROPrec1.adjpatternefs := [];
              ADJPrec1 := ADJPrec2;
              ADJPrec1.adjpatternefs := [];

         >

&

\end{verbatim}
