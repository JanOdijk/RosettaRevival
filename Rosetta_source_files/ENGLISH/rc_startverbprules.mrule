\begin{verbatim}
%RULE RSTARTVPPROP120          (* transitives *)

<m1: I1::SUBVERB{SUBVERBrec1}[mu1]
 m2: T1
 m3: T2
>

<m: I4::VERBPPROP{VERBPPROPrec1}
                [ I2:subjrel/T1, 
                  predrel/VERBP{VERBPrec1}
                         [head/I5::VERB{VERBrec1}
                               [ head/I1::SUBVERB{SUBVERBrec1}[mu1]],
                          I3:argrel/T2
                         ]
                ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBrec1.thetavp = vp120 
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
       I3: T2.CAT IN AUX_VARCATSET
       m3: T2.CAT IN AUX_VARCATSET
       I4: VERBPPROPrec1 = VERBPPROPrecdef EXCEPT FOR [thetavp] AND
           VERBPPROPrec1.thetavp = vp120
       I5: VERBrec1 = { numbers      : []
                        persons      : []   
                        modus        : omegamodus  
                        tense        : omegatense  }
      >

COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
       (* attributes get default values *)
       VERBPPROPrec1.thetavp := vp120
       (* other attributes get default values *)
 >
DECOMP
 <
   C1: VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)
   A1: @
 >

&
\end{verbatim}
