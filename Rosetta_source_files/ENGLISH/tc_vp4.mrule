ENGLISH 46

&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TVerbpattern5
< m1: I1::VERBPPROP{VERBPPROPrec1}[ mu1, 
                                    predrel/VERBP{VERBPrec1}
                                           [ head/VERB{VERBrec1}[mu2],
                                             argrel/T1,
                                             argrel/T2
                                           ] 
                                  ]
>

< m : VERBPPROP{VERBPPROPrec2}[ mu1,
                                predrel/VERBP{VERBPrec1}
                                       [ head/VERB{VERBrec1}[mu2],
                                         rel1/T1,
                                         rel2/T2
                                       ] 
                              ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
      >

<
   SUBRULE (* 1a. x1 force x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: SENTENCEVAR{SENTENCEVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synDONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf        
                                } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENTOSENT];
              rel1 := objrel;
              rel2 := complrel              
         >
      DECOMP
         <
          C1: synDONP_OPENTOSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf  
                                } (*not all attributes*)  AND
              rel1 = objrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. x1 force x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: SENTENCEVAR{SENTENCEVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synDONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf        
                                } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENTOSENT];
              rel1 := objrel;
              rel2 := complrel              
         >
      DECOMP
         <
          C1: synDONP_OPENTOSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf        
                                } (*not all attributes*)  AND
              rel1 = objrel AND
              rel2 = complrel              
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2a. x1 elect x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: NPPROPVAR{NPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synDONP_OPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENNPPROP];
              rel1 := objrel;
              rel2 := complrel              
         >
      DECOMP
         <
          C1: synDONP_OPENNPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND               
              rel1 = objrel AND
              rel2 = complrel              
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b. x1 elect x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: NPPROPVAR{NPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synDONP_OPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENNPPROP];
              rel1 := objrel;
              rel2 := complrel              
         >
      DECOMP
         <
          C1: synDONP_OPENNPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND               
              rel1 = objrel AND
              rel2 = complrel              
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3a. x1 paint x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synDONP_OPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENADJPPROP];
              rel1 := objrel;
              rel2 := complrel              
         >
      DECOMP
         <
          C1: synDONP_OPENADJPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true AND
              rel1 = objrel AND
              rel2 = complrel              
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3b. x1 paint x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synDONP_OPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENADJPPROP];
              rel1 := objrel;
              rel2 := complrel              
         >
      DECOMP
         <
          C1: synDONP_OPENADJPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true AND
              rel1 = objrel AND
              rel2 = complrel              
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4a1. x1 put x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_LOCOPENPREPPPROP];
              rel1 := objrel;
              rel2 := locargrel
         >
      DECOMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = locargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4b1. x1 put x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_LOCOPENPREPPPROP];
              rel1 := objrel;
              rel2 := locargrel
         >
      DECOMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = locargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4a2. ?meet x1 x2 *)
      <T1: NPVAR{NPVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_LOCOPENPREPPPROP];
              rel1 := objrel;
              rel2 := locargrel
         >
      DECOMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = locargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4b2. ? meet x1 x2 *)
      <T1: CNVAR{CNVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_LOCOPENPREPPPROP];
              rel1 := objrel;
              rel2 := locargrel
         >
      DECOMP
         <
          C1: synDONP_LOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = locargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5a1. x1 drive into x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_DIROPENPREPPPROP];
              rel1 := objrel;
              rel2 := dirargrel
         >
      DECOMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              dir IN PREPPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = dirargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5b1. x1 drive into x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_DIROPENPREPPPROP];
              rel1 := objrel;
              rel2 := dirargrel
         >
      DECOMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              dir IN PREPPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = dirargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5a2. ?x1 send x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              diradv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_DIROPENPREPPPROP];
              rel1 := objrel;
              rel2 := dirargrel
         >
      DECOMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              diradv IN ADVPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = dirargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5b2. ?x1 send x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              diradv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_DIROPENPREPPPROP];
              rel1 := objrel;
              rel2 := dirargrel
         >
      DECOMP
         <
          C1: synDONP_DIROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              diradv IN ADVPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = dirargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 6a. x1 tell x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synDONP_EMPTY IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_EMPTY];
              rel1 := objrel;
              rel2 := prepobjrel
         >
      DECOMP
         <
          C1: synDONP_EMPTY IN VERBPPROPrec2.synvpefs AND
              synDONP_EMPTY IN VERBrec1.synvps AND
              rel1 = objrel AND
              rel2 = prepobjrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 6b. x1 tell x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synDONP_EMPTY IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_EMPTY];
              rel1 := objrel;
              rel2 := prepobjrel
         >
      DECOMP
         <
          C1: synDONP_EMPTY IN VERBPPROPrec2.synvpefs AND
              synDONP_EMPTY IN VERBrec1.synvps AND
              rel1 = objrel AND
              rel2 = prepobjrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7. seem x1 to x2 *)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      <T1: ADJPPROPVAR{ADJPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synCLOSEDADJPPROP_EMPTY IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDADJPPROP_EMPTY];
              rel1 := complrel;
              rel2 := prepobjrel
         >
      DECOMP
         <
          C1: synCLOSEDADJPPROP_EMPTY IN VERBPPROPrec2.synvpefs AND
              synCLOSEDADJPPROP_EMPTY IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false AND
              rel1 = complrel AND
              rel2 = prepobjrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 8. seem x1 to x2 *)
      <T1: NPPROPVAR{NPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      <T1: NPPROPVAR{NPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synCLOSEDNPPROP_EMPTY IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDNPPROP_EMPTY];
              rel1 := complrel;
              rel2 := prepobjrel
         >
      DECOMP
         <
          C1: synCLOSEDNPPROP_EMPTY IN VERBPPROPrec2.synvpefs AND
              synCLOSEDNPPROP_EMPTY IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = false AND
              rel1 = complrel AND
              rel2 = prepobjrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 9. seem x1 to x2 *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      <T1: PREPPPROPVAR{PREPPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synOTHERCLOSEDPREPPPROP_EMPTY IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHERCLOSEDPREPPPROP_EMPTY];
              rel1 := complrel;
              rel2 := prepobjrel
         >
      DECOMP
         <
          C1: synOTHERCLOSEDPREPPPROP_EMPTY IN VERBPPROPrec2.synvpefs AND
              synOTHERCLOSEDPREPPPROP_EMPTY IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> [] AND
              rel1 = complrel AND
              rel2 = prepobjrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 10a. x1 tear x2 x3 *)
      <T1: NPVAR{NPVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: NPVAR{NPVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDONP_OTHEROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              other IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OTHEROPENPREPPPROP];
              rel1 := objrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synDONP_OTHEROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_OTHEROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              other IN PREPPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 10b. x1 tear x2 x3 *)
      <T1: CNVAR{CNVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: CNVAR{CNVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDONP_OTHEROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              other IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OTHEROPENPREPPPROP];
              rel1 := objrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synDONP_OTHEROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDONP_OTHEROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              other IN PREPPPROPVARrec1.actsubcefs AND
              rel1 = objrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 11. say x1 x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synTHATSENT_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  PROsubject : false
                                  finiteness : finite }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synTHATSENT_LOCOPENPREPPPROP];
              rel1 := complrel;
              rel2 := locargrel
         >
      DECOMP
         <
          C1: synTHATSENT_LOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synTHATSENT_LOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  PROsubject : false
                                  finiteness : finite } AND
              rel1 = complrel AND
              rel2 = locargrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >
   SUBRULE (* 12a. x1 catch x2 x3 *)
      <T1:NPVAR{NPVARrec1}
       T2:SENTENCEVAR{SENTENCEVARrec1}>

      <T1:NPVAR{NPVARrec1}
       T2:SENTENCEVAR{SENTENCEVARrec1}>

      COMP
         <
          C1:synDONP_OPENGERUND IN VERBrec1.synvps AND
             SENTENCEVARrec1 = { senttype   : subordinateclause
                                 PROsubject : true
                                 finiteness : finite
                                 infsort    : openING }
          A1:VERBPPROPrec2 := VERBPPROPrec1;
             VERBPPROPrec2.synvpefs := [synDONP_OPENGERUND];
             rel1 := objrel;
             rel2 := complrel;
         >
      DECOMP
         <
          C1:synDONP_OPENGERUND IN VERBPPROPrec2.synvpefs AND
             synDONP_OPENGERUND IN VERBrec1.synvps AND
             SENTENCEVARrec1 = { senttype   : subordinateclause
                                 PROsubject : true
                                 finiteness : finite
                                 infsort    : openING } AND
             rel1 = objrel AND
             rel2 = complrel
          A1:VERBPPROPrec1 := VERBPPROPrec2;
             VERBPPROPrec1.synvpefs := [];
         >

 SUBRULE (* 12b. x1 catch x2 x3 *)
      <T1:CNVAR{CNVARrec1}
       T2:SENTENCEVAR{SENTENCEVARrec1}>

      <T1:CNVAR{CNVARrec1}
       T2:SENTENCEVAR{SENTENCEVARrec1}>

      COMP
         <
          C1:synDONP_OPENGERUND IN VERBrec1.synvps AND
             SENTENCEVARrec1 = { senttype   : subordinateclause
                                 PROsubject : true
                                 finiteness : finite
                                 infsort    : openING }
          A1:VERBPPROPrec2 := VERBPPROPrec1;
             VERBPPROPrec2.synvpefs := [synDONP_OPENGERUND];
             rel1 := objrel;
             rel2 := complrel;
         >
      DECOMP
         <
          C1:synDONP_OPENGERUND IN VERBPPROPrec2.synvpefs AND
             synDONP_OPENGERUND IN VERBrec1.synvps AND
             SENTENCEVARrec1 = { senttype   : subordinateclause
                                 PROsubject : true
                                 finiteness : finite
                                 infsort    : openING } AND
             rel1 = objrel AND
             rel2 = complrel
          A1:VERBPPROPrec1 := VERBPPROPrec2;
             VERBPPROPrec1.synvpefs := [];
         >

   SUBRULE (*13a. x1 force x2 *)
      < T1: NPVAR{NPVARrec1} 
        T2: PROSENTVAR{PROSENTVARrec1}>

      < T1: NPVAR{NPVARrec1} 
        T2: PROSENTVAR{PROSENTVARrec1}>

      COMP
         <
          C1: synDONP_PROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = false 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PROSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_PROSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_PROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = false AND
              rel1 = objrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 13b. x1 force x2 *)
      < T1: CNVAR{CNVARrec1} 
        T2: PROSENTVAR{PROSENTVARrec1}>
      
      < T1: CNVAR{CNVARrec1} 
        T2: PROSENTVAR{PROSENTVARrec1}>
      

      COMP
         <
          C1: synDONP_PROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = false 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PROSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_PROSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_PROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = false AND
              rel1 = objrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >
  
SUBRULE (*14a. x1 instruct x2 x3 *)
      <T1:NPVAR{NPVARrec1}
       T2:SENTENCE{SENTENCErec1}>

      <T1:NPVAR{NPVARrec1}
       T2:SENTENCE{SENTENCErec1}>

      COMP
         <
          C1: synDONP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_QSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_QSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_QSENT IN VERBrec1.synvps AND
              rel1 = objrel AND
              rel2 = complrel AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

SUBRULE (*14b. x1 instruct x2 x3 *)
      <T1:CNVAR{CNVARrec1}
       T2:SENTENCE{SENTENCErec1}>

      <T1:CNVAR{CNVARrec1}
       T2:SENTENCE{SENTENCErec1}>

      COMP
         <
          C1: synDONP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_QSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_QSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_QSENT IN VERBrec1.synvps AND
              rel1 = objrel AND
              rel2 = complrel AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

  SUBRULE (* 15a. x1 convince x2 x3*)
      < T1: NPVAR{NPVARrec1} 
        T2: SENTENCEVAR{SENTENCEVARrec1}>

      < T1: NPVAR{NPVARrec1} 
        T2: SENTENCEVAR{SENTENCEVARrec1}>

      COMP
         <
          C1: synDONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : finite
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_THATSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_THATSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                } AND (*not all attributes*)
              rel1 = objrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 15b. x1 convince x2 x3*)
      < T2: CNVAR{CNVARrec1} 
        T1: SENTENCEVAR{SENTENCEVARrec1}>

      < T2: CNVAR{CNVARrec1} 
        T1: SENTENCEVAR{SENTENCEVARrec1}>

      COMP
         <
          C1: synDONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : finite
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_THATSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_THATSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                } AND (*not all attributes*)
              rel1 = objrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (*16a x1 help x2 x3*)
    < T1: NPVAR{NPVARrec1} 
      T2: SENTENCEVAR{SENTENCEVARrec1}>

    < T1: NPVAR{NPVARrec1} 
      T2: SENTENCEVAR{SENTENCEVARrec1}>

    COMP
         <
          C1: synDONP_OPENINFSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : inf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENINFSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_OPENINFSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENINFSENT IN VERBrec1.synvps AND
              rel1 = objrel AND
              rel2 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
