      >

      COMP
         <
          C1: mass IN NPrec1.actcomas AND
              NPrec1.number = singular AND
              NPrec1.definite = indef
          A1: @
         >
      DECOMP
         <
          C1: count IN NPrec1.actcomas  AND
              NPrec1.number = singular AND
              NPrec1.definite = indef
          A1: CNrec1 := {
                         numbers : [singular]
                         posscomas : [mass]
                        }
         >

