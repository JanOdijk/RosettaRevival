\begin{verbatim}

% RULE Rfinirrmodalsuperdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                I1:[mu2,
                    rel1/VERB{VERBrec1}
                        [head/SUBVERB{SUBVERBrec1}
                             [I2:head/BVERB(KEY1){BVERBrec1}]
                        ],
                     mu3
                   ],
            mu4,
            sig1,
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
               I1:[mu2,
                    rel1/VERB{VERBrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I3:head/BVERB(KEY2){BVERBrec1}]
                        ],
                     mu3
                   ],
            mu4,
            sig1,
            mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: LEFTTORIGHT
       I2: KEY1 = KEY_can1BVERBkey OR
           KEY1 = KEY_can2BVERBkey OR
           KEY1 = KEY_must1BVERBkey OR
           KEY1 = KEY_must2BVERBkey 
       I3: KEY2 = KEY_can1BVERBkey OR
           KEY2 = KEY_can2BVERBkey OR
           KEY2 = KEY_shallbverbkey OR
           KEY2 = KEY_should2BVERBkey 

      >

<
   SUBRULE (*1: ADVPVAR*)
      <sig1: [ ]>
      <sig1: [ ]>

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (VERBrec1.tense = omegatense) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = finite) 
             )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
                 C111: KEY1 = KEY_can1BVERBkey OR
                       KEY1 = KEY_can2BVERBkey
                 A111: KEY2 := KEY1;
                       SUBVERBrec2 := SUBVERBrec1;
                       VERBrec2 := VERBrec1;
                       VERBrec2.tense := pasttense;

                 C112: KEY1 = KEY_must1BVERBkey
                 A112: KEY2 := KEY_shallbverbkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;

                 C113: KEY1 = KEY_must2BVERBkey
                 A113: KEY2 := KEY_should2BVERBkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;
                      
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := pastdeixis
             
             C12:(CLAUSErec1.superdeixis = pastdeixis) (* geval graag *)
                 C121: KEY1 = KEY_can1BVERBkey OR
                       KEY1 = KEY_can2BVERBkey
                 A121: KEY2 := KEY1;
                       SUBVERBrec2 := SUBVERBrec1;
                       VERBrec2 := VERBrec1;
                       VERBrec2.tense := pasttense;

                 C122: KEY1 = KEY_must1BVERBkey
                 A122: KEY2 := KEY_shallbverbkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;

                 C123: KEY1 = KEY_must2BVERBkey
                 A123: KEY2 := KEY_should2BVERBkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;
                      
             A12: CLAUSErec2 := CLAUSErec1;

          A1: @             
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = finite) AND
              (VERBrec2.tense = pasttense)
             )
              
              (* other values: default values *)
             C11: (CLAUSErec2.superdeixis = pastdeixis)

                  C111: KEY2 = KEY_can1BVERBkey OR
                        KEY2 = KEY_can2BVERBkey
                  A111: KEY1 := KEY2;
                        SUBVERBrec1 := SUBVERBrec2;
                        VERBrec1 := VERBrec2;
                        VERBrec1.tense := omegatense;
 
                  C112: KEY2 = KEY_shallbverbkey
                  A112: KEY1 := KEY_must1BVERBkey;
                        SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                        VERBrec1 := COPYT_subverbtoverb(SUBVERBrec2);

                  C113: KEY2 = KEY_should2BVERBkey
                  A113: KEY1 := KEY_must2BVERBkey;
                        SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                        VERBrec1 := COPYT_subverbtoverb(SUBVERBrec2);
                 
            A11: CLAUSErec1 := CLAUSErec2;
                 CLAUSErec1.superdeixis := omegadeixis;
 
             C12: (CLAUSErec2.superdeixis = pastdeixis)
                  C121: KEY2 = KEY_can1BVERBkey OR
