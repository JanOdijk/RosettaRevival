\begin{verbatim}
% RULE Rdiremptysubst1
< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ I6:mu2,
                     head/VERB{VERBrec1}[mu3],
                     cliticrel/CLITIC{}[mu8],
                     I2:mu6,
                     dirargrel/EMPTYVAR{EMPTYVARrec1},
                     mu4
                   ],
             mu5
           ] 
SUBST:
m2: EMPTY(AUX_emptyEMPTYkey){EMPTYrec1}
>

< m :I4::CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ I6:mu2,
                     head/VERB{VERBrec1}[mu3],
                     cliticrel/CLITIC{}[mu8],
                     I2:mu6,
                     I5:mu4
                   ],
             mu5
           ] 
>

   MATCHCONDITIONS
      <
       I1: synDONP_DIREMPTY IN CLAUSErec1.synvpefs
       I2: NOT EXIST(mu6,[dirargrel/..])
       I3: EMPTYVARrec1.index = LEVEL
       I4: synDONP_DIREMPTY IN CLAUSErec2.synvpefs
       I5: NOT EXIST(mu4, [../EMPTYVAR{}]) AND
           NOT EXIST(mu4, [../VARPREPP{}[I51:mu7]])
       I51: EXIST(mu7, [../EMPTYVAR{}])
       I6: NOT EXIST(mu2,[dirargrel/..])
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: EMPTYVARrec1 =
               { 
                 persona :  3
                 numero  :  omeganumero
                 genero  :  omegagenero
               }                        
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: true
          A1: EMPTYVARrec1.index := LEVEL;
              EMPTYVARrec1 :=
               { 
                 persona :  3
                 numero  :  omeganumero
                 genero  :  omegagenero
               };
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := [synDONP_DIREMPTY]
         >
&

\end{verbatim}
