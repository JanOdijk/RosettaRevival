pragma c_include('tstring.pf');
package afxprlangspec;
with tstring;
const
     afxprlangspec_nrow = 2  ;
type setofchar = set of char;
type
     afxprlangspec_int=integer;
     afxprlangspec_boolean=boolean;
     afxprlangspec_KindType = (RoundKind,ConcKind,AltKind,RepKind,OptKind,AtomKind);
plosstring = ^losstring;
losstring = record
   next:plosstring;
   carriage:boolean;
   arg:tstring_string
 end; 
localfile = record 
first,last:plosstring
 end; 
afxprlangspec_atomnode = record 
str:TSTRING_string;
afxid:afxprlangspec_int;

 end; 
plosatomnode = ^losatomnode;
losatomnode = record
   next:plosatomnode;
   arg:afxprlangspec_atomnode
 end; 
afxprlangspec_setofatomnodes = record 
first,last:plosatomnode
 end; 
     afxprlangspec_pterminal = ^afxprlangspec_terminal;
     afxprlangspec_terminal = 
         record
                       str:tstring_string
           end;
     afxprlangspec_pexprrecord = ^afxprlangspec_exprrecord;
     afxprlangspec_exprrecord = 
         record
                       Eps:afxprlangspec_boolean;
                     First:afxprlangspec_SETOFatomnodes;
                      Eps2:afxprlangspec_boolean;
                    First2:afxprlangspec_SETOFatomnodes;
                      Kind:afxprlangspec_KindType;
           end;
     afxprlangspec_puttrecord = ^afxprlangspec_uttrecord;
     afxprlangspec_uttrecord = 
         record
                       Eps:afxprlangspec_boolean;
                     First:afxprlangspec_SETOFatomnodes;
                      Eps2:afxprlangspec_boolean;
                    First2:afxprlangspec_SETOFatomnodes;
                      Kind:afxprlangspec_KindType;
           end;
     afxprlangspec_category = (comment,identifier,EXPR,LEAVE,ROUND,REP,LOR,LOPT,LAND,UTT,AFFIXEXPR,EXPREND,EQUAL,DOT,BAR,LSQUARE,
RSQUARE,LROUND,RROUND,LCURLY,RCURLY);

afxprlangspec_pfielddef = ^afxprlangspec_fielddef;
afxprlangspec_fielddef =
         record
      case cat:afxprlangspec_category of
                  EXPR:
                     (EXPRfield:afxprlangspec_pexprrecord);
                  LEAVE:
                     (LEAVEfield:afxprlangspec_pexprrecord);
                  ROUND:
                     (ROUNDfield:afxprlangspec_pexprrecord);
                  REP:
                     (REPfield:afxprlangspec_pexprrecord);
                  LOR:
                     (LORfield:afxprlangspec_pexprrecord);
                  LOPT:
                     (LOPTfield:afxprlangspec_pexprrecord);
                  LAND:
                     (LANDfield:afxprlangspec_pexprrecord);
                  UTT:
                     (UTTfield:afxprlangspec_puttrecord);
identifier,                  AFFIXEXPR,
                  EXPREND,
                  EQUAL,
                  DOT,
                  BAR,
                  LSQUARE,
                  RSQUARE,
                  LROUND,
                  RROUND,
                  LCURLY,
                  RCURLY:
                     (      terminal:afxprlangspec_pterminal);
           end;

procedure initint(var s:integer);external;
procedure initbool(var s:boolean);external;
procedure initsetofatomnodes(var s:afxprlangspec_setofatomnodes); external;
function stillatomnodes(var s:afxprlangspec_setofatomnodes):boolean; external;
procedure takeatomnode(var atomnode1:afxprlangspec_atomnode
        ;var s:afxprlangspec_setofatomnodes); external;
procedure appendatomnode(atomnode1:afxprlangspec_atomnode
        ;var s:afxprlangspec_setofatomnodes); external;
 function afxprlangspec_scanchars:setofchar;
         external;
 procedure afxprlangspec_init; external;
 procedure afxprlangspec_word(i:integer;var s:tstring_string);
         external;
 function afxprlangspec_wcat(i:integer):afxprlangspec_category;
         external;
 function afxprlangspec_scat(c:char):afxprlangspec_category;
         external;
 procedure afxprlangspec_createterm(s:afxprlangspec_category;
           w:tstring_string;var f:afxprlangspec_fielddef);
         external;
end{langspec};
