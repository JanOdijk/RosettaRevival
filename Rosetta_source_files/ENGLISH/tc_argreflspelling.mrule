         <
          C1: NPrec1 = AUX_NPONitRFLPR EXCEPT FOR [cases] AND
              CNVARrec1.numbers = [singular] AND
              CNVARrec1.genders = [omegagender] AND
              CNVARrec1.sexes = [] 
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := NPrec1.cases
         >


   SUBRULE (* 6. themselves *)
      < >
      < T1: REFLPRO(AUX_themselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: CNVARrec1.numbers = [plural]
          A1: NPrec1 := AUX_NPONthemRFLPR;
              NPrec1.cases := CNVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONthemRFLPR EXCEPT FOR [cases] AND
