(* uitgezet (nooit aan geweest) *)
TRANSFORMATION TADJPATTERN18b     (* unchanged copy of the Dutch M-grammar *)
                                  (* empty counterpart of 18a:
                                      non-modifier voor-object
                                      ("belanghebbend voorwerp")
                                      No relevant examples found yet.
                                      *)
< m1: ADJPPROP{ADJPPROPrec1}
                      [mu1,
                       predrel/ADJP{ADJPrec1}
                              [argrel/EMPTYVAR{EMPTYVARrec1},
                               head/ADJ{ADJrec1}[mu2]
                              ]
                       ]
>

< m : ADJPPROP{ADJPPROPrec2}
                      [mu1,
                       predrel/ADJP{ADJPrec2}
                              [indobjrel/EMPTYVAR{EMPTYVARrec1},
                               head/ADJ{ADJrec1}[mu2]
                              ]
                       ]
>

      COMP
         <
          C1: (synFOREMPTY IN ADJrec1.adjpatterns) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: ADJPPROPrec2 := ADJPPROPrec1;
              ADJPPROPrec2.adjpatternefs := [synFOREMPTY];
              ADJPrec2 := ADJPrec1;
              ADJPrec2.adjpatternefs := [synFOREMPTY];
         >

      DECOMP
         <
          C1: (synFOREMPTY IN ADJrec1.adjpatterns)  AND
              (synFOREMPTY IN ADJPrec2.adjpatternefs) AND
              (synFOREMPTY IN ADJPPROPrec2.adjpatternefs)
          A1: ADJPPROPrec1 := ADJPPROPrec2;
              ADJPPROPrec1.adjpatternefs := [];
              ADJPrec1 := ADJPrec2;
              ADJPrec1.adjpatternefs := []
         >
&

