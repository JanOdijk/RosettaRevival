            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       rel1/NP{NPrec1}[mu3],
                       rel2/NP{NPrec2}
                           [ mu4,
                             head/PERSPRO{PERSPROrec1}[mu5],
                             mu6
                           ],
                       mu7
                     ],
              mu8
            ]
>
  
         <
          C1: true
          A1: @
         >

