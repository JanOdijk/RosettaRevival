       #ACTION: BEGIN
                  SEND_UTT;
                END
*>
END;

PROCEDURAL PART
VAR rulenumber::int;
BEGIN 
INIT:BEGIN TFILES_open(RTNfile,'rtnfile',7,3);
           TFILES_open(BLOCKSenv,'blocksenv',9,3);
           TFILES_open(BLOCKSpas,'blockspas',9,3);
           rulenumber:=0;
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
3: <* SEND: BEGIN rulenumber:=rulenumber+1;%%RULESPEC.number:=rulenumber; END
      !RULESPEC.
      RECEIVE: BEGIN appendfile(%%RULESPEC.procpars,RTNfile);
                     appendfile(%%RULESPEC.blockenv,blocksenv);
                     appendfile(%%RULESPEC.blockpas,blockspas);
               END
   *>
*>
FINAL: BEGIN
       END
END;
&


%RULESPEC
BASIS RULE
  RULESPEC = IDENTIFIER/2.REGULAREXPRESSION/1.COLON/1.
              IDENTIFIER/5.ISCAT/1.GRAPH/3.
             COLON/1.RULEBODY/4
SURFACE PART
VAR rulename:TSTRING_string;

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN rulename:=%.str
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_RULESPEC;
                  $RULESPEC.rulename:=rulename;
                END
*>
END;

PROCEDURAL PART
VAR str,rulename:TSTRING_string;
    number::int;
    procpars,blockenv,blockpas:LOCALFILE;
BEGIN 
INIT:BEGIN number:=$$RULESPEC.number;
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN rulename:=%.str END
      !.
      RECEIVE: BEGIN
               END
   *>
3: <* SEND: BEGIN END
      !GRAPH.
      RECEIVE: BEGIN 
               END
   *>
4: <* SEND: BEGIN \RTNfile.\GLOBAL. "+" ""rulename""\\
                  %%RULEBODY.number:=number;
                  %%RULEBODY.rulename:=rulename 
            END
      !RULEBODY.
      RECEIVE: BEGIN procpars:=%%RULEBODY.procpars;
                     blockpas:=%%RULEBODY.blockpas;
                     blockenv:=%%RULEBODY.blockenv;
               END
   *>
5: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN \RTNfile.\GLOBAL.
                     ""str"" "="\\
               END
   *>
*>
FINAL: BEGIN 
             $$RULESPEC.procpars:=procpars;
             $$RULESPEC.blockenv:=blockenv;
             $$RULESPEC.blockpas:=blockpas;
       END
END;
&

