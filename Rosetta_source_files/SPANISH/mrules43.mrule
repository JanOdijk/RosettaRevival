   MATCHCONDITIONS
      <
       I2: (NOT EXIST(mu6, [auxrel/I21:: VERB{VERBrec1}[mu7]])) AND
           (NOT EXIST(mu6, [I22:rel1/VERB{VERBrec2}[I221:mu8]])) AND
           (NOT EXIST(mu6, [predrel/VERBP{VERBPrec1}[I23:mu12]]))

