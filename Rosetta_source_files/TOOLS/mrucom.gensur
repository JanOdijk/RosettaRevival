%CATRECNAME
BASIS RULE
      CATRECNAME = IDENTIFIER/1.[QUOTEtje/2]
SURFACE PART
VAR str:TSTRING_string;
HELP FUNCTION RELSTRING:TSTRING_string;
VAR str:TSTRING_string;
begin
TSTRING_constant(str,'REL',3);
RELSTRING:=str
end;
FUNCTION EXTRACT(str:TSTRING_string):BOOLEAN;
VAR ch:CHAR;
BEGIN
TSTRING_extractchar(ch,str,4);
EXTRACT:=(ch IN ['1','2','3','4','5','6','7','8','9'])
END;
FUNCTION checkparname(str:TSTRING_string):BOOLEAN;
VAR paramtable1::setofparams;
    param1::param;
    found:BOOLEAN;
BEGIN
paramtable1:=paramtable;
found:=false;
while stillparams(paramtable1) and not(found) do
   begin
   takeparam(param1,paramtable1);
   found:=(TSTRING_compare(param1.parname,str)=0)
   end;
checkparname:=found
END;

<*
INIT: BEGIN END;
1 : <* LOCALCONDITION:((TSTRING_COMPAREbegin(%.str,RELstring)<>0)
                       OR NOT(EXTRACT(%.str))) AND
                      (NOT(checkparname(%.str)))
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%.str END
    *>
2 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN TSTRING_appendchar(str,str,'_')END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_CATRECNAME; 
                      $CATRECNAME.str:=str 
                END
*>
END;
PROCEDURAL PART
VAR rec:TSTRING_string;
BEGIN
INIT: BEGIN END;
<*
1: <* SEND: BEGIN rec:=%.str END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN TSTRING_appendchar(rec,rec,'_') END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN
        $$CATRECNAME.ident:=rec;
      END
END;
&
 
