echo sur $1:$2
#
#
# component  = p1
# source     = p2
#
#
#
echo " " > $1/target/surfrules.sur
if test -s $1/source/surfrules1.sur
then cat $1/source/surfrules1.sur >> $1/target/surfrules.sur
else cat $RBS_ARCHIVE$RBS_RELEASE/$1/surfrules1.sur >> $1/target/surfrules.sur
fi
if test -s $1/source/surfrules2.sur
then cat $1/source/surfrules2.sur >> $1/target/surfrules.sur
else cat $RBS_ARCHIVE$RBS_RELEASE/$1/surfrules2.sur >> $1/target/surfrules.sur
fi
if test -s $1/source/surfrules3.sur
then cat $1/source/surfrules3.sur >> $1/target/surfrules.sur
else cat $RBS_ARCHIVE$RBS_RELEASE/$1/surfrules3.sur >> $1/target/surfrules.sur
fi
if test -s $1/source/surfrules4.sur
then cat $1/source/surfrules4.sur >> $1/target/surfrules.sur
else cat $RBS_ARCHIVE$RBS_RELEASE/$1/surfrules4.sur >> $1/target/surfrules.sur
fi
#
echo "inputfile $1/target/surfrules.sur" > lognames
echo "graphspas $1/target/surfrulesgraphs.p" >> lognames
echo "rulespas $1/target/surfrules.p" >> lognames
echo "primspas $1/target/ldprims.p" >> lognames
cat RBS_logicals >> lognames
#
execute $1 surcom.exe
