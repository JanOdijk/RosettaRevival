\begin{description}
\item[* name:] TADVPNomCaseAssignment
\item[* relevant examples:] tan .. como  yo
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] ADVPformation
\item[* class:] (name of rule, transformation or filter class)
\item[* date of creation:] 4-JAN-1990 13:09:11  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To assign nominative case to the NP-complement 
of the como-complement of {\em tan}.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}
% RULE RADVPSubst2

< m1 : ADVP{ADVPrec1}[head/ADV{ADVrec1}[mu8],
                      thanascomplrel/THANP{THANPrec1}
                           [I1:mu1,
                            I2:complrel/NPVAR{NPVARrec1}
                           ]
                      ]
SUBST:
 m2: NP{NPrec1}[mu5]
>

< m : ADVP{ADVPrec1}[head/ADV{ADVrec1}[mu8],
                     thanascomplrel/THANP{THANPrec1}
                            [I1:mu1,
                             complrel/NP{NPrec2}[mu6]
                            ]
                    ]
>

   MATCHCONDITIONS
      <
       I1: EXIST(mu1, [head/..])
       I2: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
             NPrec1.cases = [] AND 
             NPrec1.generic = nogeneric AND
             NPrec1.supertiempo = ADVPrec1.supertiempo
          A1:QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases);
             NPrec2.generic := omegageneric;
             NPrec2.supertiempo := omegatiempo
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []) ;
              NPrec1.generic := nogeneric;
              NPrec1.supertiempo := ADVPrec1.supertiempo;
         >
&

\end{verbatim}
