\newpage
\begin{verbatim}
% TRANSFORMATION Tfincontrol0
< m1:CLAUSE{CLAUSErec1}[mu5, predrel/VERBP{VERBPrec1}[I2:mu4], I1:mu1]
>

< m :CLAUSE{CLAUSErec1}[mu5, predrel/VERBP{VERBPrec1}[I2:mu4], I1:mu1]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[complrel/I12::SENTENCE{SENTENCErec1}[mu3]]) OR
           EXIST(mu1, [complrel/I12::SENTENCE{SENTENCErec1}[I11:mu2]])
           I11: NOT EXIST(mu2, [I111:subjrel/T1])
                I111: T1.CAT IN [NPVAR, CNVAR]
           I12: SENTENCErec1.finiteness = finite
       I2: (NOT EXIST(mu4,[complrel/I22::SENTENCE{SENTENCErec1}[mu3]]) OR
            EXIST(mu4, [complrel/I22::SENTENCE{SENTENCErec1}[I21:mu2]])
           ) AND
           ( NOT EXIST(mu4,[prepobjrel/PREPP{}
                               [mu7, ../I22::SENTENCE{SENTENCErec1}[mu3],mu6 ]
                           ])                  OR
             EXIST(mu4,[prepobjrel/PREPP{}
                           [mu7, ../I22::SENTENCE{SENTENCErec1}[I21:mu2],mu6 ]
                       ])                  
           )
           I21: NOT EXIST(mu2, [I211:subjrel/T1])
                I211: T1.CAT IN [NPVAR, CNVAR]
           I22: SENTENCErec1.finiteness = finite
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
