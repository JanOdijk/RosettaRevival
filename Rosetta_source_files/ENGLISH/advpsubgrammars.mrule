                       [ head/ADV{ADVrec1}[mu2], 
                         complrel/T1 
                       ] 
              ]
>

   MATCHCONDITIONS
      <
       I1: ADVPrec1.advpatternefs = []
       I2: ADVPPROPrec1.advpatternefs = []
      >

<
   SUBRULE (* 1. CLAUSE *)
      < T1: CLAUSEVAR{CLAUSEVARrec1} >
      < T1: CLAUSEVAR{CLAUSEVARrec1} >


      COMP
         <
          C1: synCLAUSE IN ADVrec1.advpatterns 
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synCLAUSE];
              ADVPPROPrec2 := ADVPPROPrec1;
              ADVPPROPrec2.advpatternefs := [synCLAUSE];
         >
      DECOMP
         <
          C1: synCLAUSE IN ADVrec1.advpatterns AND
              synCLAUSE IN ADVPrec2.advpatternefs AND
              synCLAUSE IN ADVPPROPrec2.advpatternefs
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
              ADVPPROPrec1 := ADVPPROPrec2;
              ADVPPROPrec1.advpatternefs := [];
         >

   SUBRULE  (* 2. open SENTENCE *)
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >


      COMP
         <
          C1: synOPENINFSENT IN ADVrec1.advpatterns AND
              SENTENCEVARrec1 = { PROsubject : true
                                  finiteness : infinite
                                  infsort    : inf }
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synOPENINFSENT];
              ADVPPROPrec2 := ADVPPROPrec1;
              ADVPPROPrec2.advpatternefs := [synOPENINFSENT];
         >
      DECOMP
         <
          C1: synOPENINFSENT IN ADVrec1.advpatterns AND
              synOPENINFSENT IN ADVPrec2.advpatternefs AND
              synOPENINFSENT IN ADVPPROPrec2.advpatternefs AND
              SENTENCEVARrec1 = { PROsubject : true
                                  finiteness : infinite
                                  infsort    : inf }
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
              ADVPPROPrec1 := ADVPPROPrec2;
              ADVPPROPrec1.advpatternefs := [];
         >

  SUBRULE  (* 3. closed SENTENCE *)
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >


      COMP
         <
          C1: synCLOSEDINFSENT IN ADVrec1.advpatterns AND
              SENTENCEVARrec1 = { PROsubject : false
                                  finiteness : infinite
                                  infsort    : inf }
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synCLOSEDINFSENT];
              ADVPPROPrec2 := ADVPPROPrec1;
              ADVPPROPrec2.advpatternefs := [synCLOSEDINFSENT];
         >
      DECOMP
         <
          C1: synCLOSEDINFSENT IN ADVrec1.advpatterns AND
              synCLOSEDINFSENT IN ADVPrec2.advpatternefs AND
              synCLOSEDINFSENT IN ADVPPROPrec2.advpatternefs AND
              SENTENCEVARrec1 = { PROsubject : false
                                  finiteness : infinite
                                  infsort    : inf }
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
              ADVPPROPrec1 := ADVPPROPrec2;
              ADVPPROPrec1.advpatternefs := [];
         >

  SUBRULE  (* 4. VERBPPROP *)
      < T1: VERBPPROPVAR{VERBPPROPVARrec1}>
      < T1: VERBPPROPVAR{VERBPPROPVARrec1}>


      COMP
         <
          C1: synVERBPPROP IN ADVrec1.advpatterns 
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synVERBPPROP];
              ADVPPROPrec2 := ADVPPROPrec1;
              ADVPPROPrec2.advpatternefs := [synVERBPPROP];
         >
      DECOMP
         <
          C1: synVERBPPROP IN ADVrec1.advpatterns AND
              synVERBPPROP IN ADVPrec2.advpatternefs AND
              synVERBPPROP IN ADVPPROPrec2.advpatternefs 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
              ADVPPROPrec1 := ADVPPROPrec2;
              ADVPPROPrec1.advpatternefs := [];
         >
>

&

\end{verbatim}
