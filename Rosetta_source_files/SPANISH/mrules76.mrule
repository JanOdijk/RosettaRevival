                    ]
>

< m : CN{CNrec2}[modrel/DETP{DETPrec2}[mu4,
                                       head/NUM{NUMrec2}
                                      ],
                 I3:mu3,
                 I1:head/N1[mu2],
                 mu5
                ]
>

   MATCHCONDITIONS
      <
       I1: N1.CAT  IN [NOUN, EN]
       I3: ALL (mu3, I13:modrel/T2)
       I13: T2.CAT IN [ADJP, SENTENCE]

      >



      COMP
         <
          C1: (CNrec1.definite = omegadef) AND
              (DETPrec1.genero IN CNrec1.generos  ) AND
              (CNrec1.numero = DETPrec1.numero ) AND
              (CNrec1.supertiempo = DETPrec1.supertiempo) 
            C11:  NUMrec1.key <> KEY_'s_algunos_NUM_1' AND
                  NUMrec1.key <> KEY_'s_algunas_NUM_1'
            A11:  NUMrec2 := NUMrec1;
                  CNrec2 := CNrec1;
                  CNrec2.definite := def;     (* 'tres hombres' is def     *)
                                           (* via NPformation: 'los tres ... *) 
                  DETPrec2 := DETPrec1;
                  DETPrec2.supertiempo := omegatiempo;
            C12:  NUMrec1.key = KEY_'s_algunos_NUM_1 '
            A12:  NUMrec2 := NUMrec1;
                  CNrec2 := CNrec1;
                  CNrec2.definite := def;     (* 'tres hombres' is def     *)
                                           (* via NPformation: 'los tres ... *) 
                  DETPrec2 := DETPrec1;
                  DETPrec2.supertiempo := omegatiempo;
                  NUMrec2.key := KEY_'s_diversos_NUM_1';
            C13:  NUMrec1.key = KEY_'s_algunas_NUM_1' 
            A13:  NUMrec2 := NUMrec1;
                  CNrec2 := CNrec1;
                  CNrec2.definite := def;     (* 'tres hombres' is def     *)
                                           (* via NPformation: 'los tres ... *) 
                  DETPrec2 := DETPrec1;
                  DETPrec2.supertiempo := omegatiempo;
                  NUMrec2.key := KEY_'s_diversas_NUM_1';

          A1: @               

         >

      DECOMP
         <
          C1: CNrec2.definite = def AND
              (DETPrec2.genero IN CNrec1.generos) AND
              (CNrec1.numero = DETPrec2.numero ) AND
              (DETPrec2.supertiempo = omegatiempo) 
            C11:  NUMrec2.key <> KEY_'s_diversos_NUM_1' AND
                  NUMrec2.key <> KEY_'s_diversas_NUM_1'
            A11: NUMrec1 := NUMrec2;
                 CNrec1 := CNrec2;
                 CNrec1.definite := omegadef;
                 DETPrec1 := DETPrec2;
                 DETPrec1.supertiempo := CNrec1.supertiempo;
            C12:  NUMrec2.key = KEY_'s_diversos_NUM_1' 
            A12: NUMrec1 := NUMrec2;
                 NUMrec1.key := KEY_'s_algunos_NUM_1';
                 CNrec1 := CNrec2;
                 CNrec1.definite := omegadef;
                 DETPrec1 := DETPrec2;
                 DETPrec1.supertiempo := CNrec1.supertiempo;
            C13:  NUMrec2.key <> KEY_'s_diversas_NUM_1'
            A13: NUMrec1 := NUMrec2;
                 NUMrec1.key := KEY_'s_algunas_NUM_1';
                 CNrec1 := CNrec2;
                 CNrec1.definite := omegadef;
                 DETPrec1 := DETPrec2;
                 DETPrec1.supertiempo := CNrec1.supertiempo;

          A1: @
         >
&

\end{verbatim}
