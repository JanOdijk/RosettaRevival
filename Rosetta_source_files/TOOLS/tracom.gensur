%ILRULENAME
BASIS RULE
      ILRULENAME = IDENTIFIER/1
SURFACE PART
VAR str:TSTRING_string;

<*
INIT: BEGIN END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%.str END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_ILRULENAME; 
                      $ILRULENAME.str:=str
                END
*>
END;
PROCEDURAL PART
VAR
BEGIN
INIT: BEGIN END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
*>
FINAL:BEGIN END
END;
&
