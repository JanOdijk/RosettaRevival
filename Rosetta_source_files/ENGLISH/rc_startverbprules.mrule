\newpage
\begin{verbatim}

%RULE RSTARTVPPROP000      (* weather verbs *)

<m1: I3::SUBVERB{SUBVERBrec1}[mu1]
>

<m : I1::VERBPPROP{VERBPPROPrec1}
                 [ subjrel/NP{NPrec1}
                          [ head/PERSPRO{PERSPROrec1}
                                [ head/BPERSPRO(AUX_itbpersprokey)
                                                {BPERSPROrec1}]
                          ], 
                   predrel/VERBP{VERBPrec1}
                          [ head/I2::VERB{VERBrec1}
                                [ head/I3::SUBVERB{SUBVERBrec1}[mu1]]
                          ]
                 ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1 = VERBPPROPrecdef EXCEPT FOR [thetavp] AND
           VERBPPROPrec1.thetavp = vp000
       I2: VERBrec1 = { numbers      : []
                        persons      : []   
                        modus        : omegamodus
                        tense        : omegatense  }
       I3: SUBVERBrec1.thetavp = vp000 
      >

COMP
 <
  C1: true
  A1: PERSPROrec1 := COPYT_bpersprotoperspro(BPERSPROrec1);
      (* persprocase retains the default value omegacase *)
      NPrec1 := AUX_NPONitPRSPR;
      VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
      VERBPPROPrec1.thetavp := vp000
      (* other attributes receive default values *)
 >
DECOMP
 <
  C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
      PERSPROrec1.persprocase = omegacase AND 
      NPrec1 = AUX_NPONitPRSPR AND
      VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)
  A1: @
 >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RSTARTVPPROP000
\item[* relevant examples:] it is raining, it was thawing, it snows
\item[* language:] english
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] RC: Startverbprules
\item[* date of creation:] 11-08-87 
\item[* author:] Agnes Mijnhout, margreet sanders
\item[* copied from:] Dutch RStartVPProp000
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 31/08/90\ \ \ \ \ author:Petra de Wit
analysis: changed nominative (case) to omegacase, which is the default value in 
English.
\end{enumerate}
\item[* task:] Combines a SUBVERB with its required number of arguments and 
puts them either inside the subject position or inside the VERBP.
\item[\ \ strategy:] (also: deviations from accepted proposals) Note that the 
syncategorematically introduced subject `it' can be antecedent for a 
reflexive ({\em it has rained itself out\/}). Therefore, it must be spelled out 
here.
\item[\ \ rejected alternatives:] 
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of 
parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] Function-application and "thematic role" 
assignment.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ 
Attribute thetavp with BVERBs.
\item rules:\\ 
This is the first rule-class of the relevant subgrammar
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}  
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\
The number of arguments should remain 
the same.
\end{enumerate}
\item[* relevant literature/documents:] doc. nr. 108 (Verbpatterns in Rosetta3)
\item[\ \ remarks:]\mbox{} 
\begin{enumerate}
\item problems:\\
For more comment on weather verbs, see TVerbpattern0. 
\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}

%RULE RSTARTVPPROP100         (* intransitives *)

<m1: I1::SUBVERB{SUBVERBrec1}[mu1]
 m2: T1
>

<m: I3::VERBPPROP{VERBPPROPrec1}
                 [ I2:subjrel/T1, 
                   predrel/VERBP{VERBPrec1}
                          [ head/I4::VERB{VERBrec1}
                                 [head/I1::SUBVERB{SUBVERBrec1}[mu1]]
                          ]
                 ]
>

   MATCHCONDITIONS
      <
        I1: SUBVERBrec1.thetavp = vp100
        I2: T1.CAT IN AUX_VARCATSET
        m2: T1.CAT IN AUX_VARCATSET
        I3: VERBPPROPrec1 = VERBPPROPrecdef EXCEPT FOR [thetavp] AND
            VERBPPROPrec1.thetavp  = vp100
        I4: VERBrec1 = { numbers      : []   
                         persons      : []   
                         modus        : omegamodus  
                         tense        : omegatense  }
      >

COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
       (* all other attributes retain their default values *)
       VERBPPROPrec1.thetavp := vp100
       (* all other attributes retain their default values *)
 >
DECOMP
 < 
   C1: VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)
   A1: @
 >

&
\end{verbatim}
