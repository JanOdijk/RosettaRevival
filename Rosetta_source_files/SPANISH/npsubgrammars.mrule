\begin{verbatim}
% TRANSFORMATION TnppPROsubj
< m1: I1::NPPROP{NPPROPrec1}[I2:mu1]
>

< m : NPPROP{NPPROPrec2}[I2:mu1]
>

   MATCHCONDITIONS
      <
       I1: NPPROPrec1.PROsubject = false
       I2: EXIST(mu1,[predrel/..])
      >

      COMP
         <
          C1: true
          A1: NPPROPrec2 := NPPROPrec1;
              NPPROPrec2.PROsubject := true
         >
      DECOMP
         <
          C1: NPPROPrec2.PROsubject = true
          A1: NPPROPrec1 := NPPROPrec2;
              NPPROPrec1.PROsubject := false
         >
&

\end{verbatim}
