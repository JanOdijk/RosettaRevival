\begin{verbatim}
% RULE RppSubstitution4       (* ADVP *)
< m1: PREPP{PREPPrec1}
           [ mu2,
             objrel/ADVPVAR{ADVPVARrec1},
             mu3 
           ]
  SUBST:
  m2: ADVP{ADVPrec1}[mu4]
>

< m : PREPP{PREPPrec1}
           [ mu2,
             objrel/ADVP{ADVPrec2}[mu4],
             mu3 
           ]
>

   MATCHCONDITIONS
      <
       I1: ADVPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: ADVPVARrec1 = COPYT_ADVPtovar(ADVPrec1) AND
              ADVPrec1.superdeixis = PREPPrec1.superdeixis AND
              (PREPPrec1.actsubcefs * [temp] <> [] ->
               ADVPrec1.temporal = true)
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: ADVPrec2.superdeixis = omegadeixis AND
              (PREPPrec1.actsubcefs * [temp] <> [] ->
               ADVPrec2.temporal = true)
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := PREPPrec1.superdeixis;
              ADVPVARrec1 := COPYT_ADVPtovar(ADVPrec2);
              ADVPVARRec1.index := LEVEL;
         >

&

\end{verbatim}
