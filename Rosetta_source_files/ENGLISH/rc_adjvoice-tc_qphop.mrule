ENGLISH 57

&
\begin{verbatim}
%
% RULE RADJVoiceDefault
< m1: ADJPPROP{ADJPPROPrec1}
              [ mu1,
                predrel/ADJP{ADJPrec1}
                       [ mu2,
                         head/ADJ{ADJrec1}[ mu3 ],
                         mu4
                       ],
                mu5
              ]
>

< m : ADJPPROP{ADJPPROPrec2}
              [ mu1,
                predrel/ADJP{ADJPrec1}
                       [ mu2,
                         head/ADJ{ADJrec2}[ mu3 ],
                         mu4
                       ],
                mu5
              ]
>

      COMP
         <
          C1: true
          A1: ADJrec2 := ADJrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
          >
      DECOMP
         <
          C1: true
          A1: ADJrec1 := ADJrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
         >
&

\end{verbatim}
