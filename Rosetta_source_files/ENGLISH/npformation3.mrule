% RULE RNPformation9
< m1: PROPERNOUN{PROPERNOUNrec1}[mu1] 
>

< m : NP{NPrec1}[head/PROPERNOUN{PROPERNOUNrec1}[mu1]]
>


      COMP
         <
          C1: singular IN PROPERNOUNrec1.numbers AND
              PROPERNOUNrec1.subc <> monthnoun
          A1: NPrec1 := { req           : [pospol,negpol,omegapol]
                          env           : [pospol,negpol,omegapol]
                          class         : PROPERNOUNrec1.class
                          superdeixis   : omegadeixis
                          deixis        : PROPERNOUNrec1.deixis
                          aspect        : PROPERNOUNrec1.aspect
                          retro         : PROPERNOUNrec1.retro
                          definite      : def
                          person        : 3
                          number        : singular
                          cases         : []
                          genders       : PROPERNOUNrec1.genders
                          sexes         : PROPERNOUNrec1.sexes
                          actsubcs      : [PROPERNOUNrec1.subc]
                          temporal      : PROPERNOUNrec1.temporal
                          poss          : PROPERNOUNrec1.poss
                          animate       : PROPERNOUNrec1.animate
                          human         : PROPERNOUNrec1.human
                          actcomas      : [count]
                          thetanp       : omegathetanp
                          nounpatternefs: []
                          posspred      : true
                          possnietnp    : false
                          mood          : nowh
                          generic       : nogeneric
                          syntquant     : omegaquant
                          NPhead        : otherNP
                          specQ         : yesspec
                         }
         >

      DECOMP
         <
          C1: singular IN PROPERNOUNrec1.numbers AND
              PROPERNOUNrec1.subc <> monthnoun AND
              NPrec1.actcomas * [count] <> [] AND
              NPrec1 = { req           : [pospol,negpol,omegapol]
                         env           : [pospol,negpol,omegapol]
                         class         : PROPERNOUNrec1.class
                         superdeixis   : omegadeixis
                         deixis        : PROPERNOUNrec1.deixis
                         aspect        : PROPERNOUNrec1.aspect
                         retro         : PROPERNOUNrec1.retro
                         definite      : def
                         person        : 3
                         number        : singular
                         cases         : []
                         genders       : PROPERNOUNrec1.genders
                         sexes         : PROPERNOUNrec1.sexes
                         actsubcs      : [PROPERNOUNrec1.subc]
                         temporal      : PROPERNOUNrec1.temporal
                         poss          : PROPERNOUNrec1.poss
                         animate       : PROPERNOUNrec1.animate
                         human         : PROPERNOUNrec1.human
                         thetanp       : omegathetanp
                         nounpatternefs: []
                         posspred      : true
                         possnietnp    : false
                         mood          : nowh
                         generic       : nogeneric
                         syntquant     : omegaquant
                         NPhead        : otherNP
                         specQ         : yesspec
                        }
          A1: @
         >

&
