\newpage
\begin{verbatim}
% RULE Rtempadvsentsubstitution           (* temporal SENTENCE under S for VERBP-node *)
< m1:T1 = N1
          [ mu1,
            predrel/I2::N2 [mu3],
            mu2,
            tempadvrel/I1::SENTENCEVAR{SENTENCEVARrec1},
            mu4
          ] 
SUBST:
  m2: SENTENCE{SENTENCErec1}[mu5]
>

< m :T1 = N1
          [ mu1,
            predrel/I2::N2 [mu3],
            mu2,
            tempadvrel/SENTENCE{SENTENCErec1}[mu5],
            mu4
          ] 
>

   MATCHCONDITIONS
      <
       m1 : T1.CAT IN [VERBPPROP, ADJPPROP, ADVPPROP, PREPPPROP, NPPROP]
       m  : T1.CAT IN [VERBPPROP, ADJPPROP, ADVPPROP, PREPPPROP, NPPROP] AND
            NOT EXIST(mu2, [I11:../T2]) AND
            NOT EXIST(mu3, [I11:../T2]) AND
            NOT EXIST(mu4, [I11:../T2])
            I11: T2.CAT IN AUX_propvarcats 
       I1 : SENTENCEVARrec1.index = LEVEL
       I2 : N2.CAT IN [VERBP, ADJP, ADVP, PREPP, NP]
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: (SENTENCErec1.temporal = true) AND
              (SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)) AND
              ((SENTENCErec1.conjclass = reference) OR
               (SENTENCErec1.conjclass = frequential) OR
               ((SENTENCErec1.conjclass = duration) AND
                ((SENTENCErec1.conjaspecto = perfectivo) AND
                 (T1.REC.aktionsarts * [stative, activity] <> [])
                ) OR
                ((SENTENCErec1.conjaspecto = imperfectivo) AND
                 (T1.REC.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCErec1.temporal = true) AND
              ((SENTENCErec1.conjclass = reference) OR
               (SENTENCErec1.conjclass = frequential) OR
               ((SENTENCErec1.conjclass = duration) AND
                ((SENTENCErec1.conjaspecto = perfectivo) AND
                 (T1.REC.aktionsarts * [stative, activity] <> [])
                ) OR
                ((SENTENCErec1.conjaspecto = imperfectivo) AND
                 (T1.REC.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )

          A1: SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;

         >


&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rtempadvsentsubstitution
\item[* relevant examples:]
(ella) bailar x1 $\rightarrow$\\
(ella) bailar cuando quer\'{i}a/cuando estaba enamorada
(ella) (ser/estar) enferma x1 $\rightarrow$\\
(ella) (ser/estar) enferma cuando estaba enamorada
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPto CLAUSE
\item[* class:] RC:propositionsubstitution
\item[* date of creation:] 21-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rtempadvsentsubstitution dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 25/08/88\ \ \ \ \ author: Lisette Appelo
\item date: 12/10/90\ \ \ \ \ author: Lisette Appelo\\
Added T1 = N1 in model and changed conditions on N1.REC into T1.REC, because
N.REC has not been implemented.
 \end{enumerate}
\item[* task:] To insert temporal adverbials of category SENTENCE in XPPROPs.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
Polarity, superdeixis, substorder conditions still to be added
\item modifications: CONJSENT has been substituted by SENTENCE; the typical 
attributes for CONJSENT have been added to SENTENCE and are prefixed by `conj'.\\
Gsubstordercondition added.\\
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE rtempadvsubstitution3
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             I1: rel1/T2,
             mu2,
             predrel/VERBP{VERBPrec1}[mu3],
             mu4
           ] 
SUBST:
  m2: T1
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             I2:rel1/T3,
             mu2,
             predrel/VERBP{VERBPrec1}[mu3],
             mu4
           ] 
>

   MATCHCONDITIONS
      <
       m2 : QUOTE_Gsubstordercondition(mu2, mu3, mu4) AND
            T1.CAT IN [ADVP, NP]
       m  : QUOTE_substordercondition(mu2, mu3, mu4) 
       I1 : rel1 IN [shiftrel] AND
            (T2.CAT IN [ADVPVAR, NPVAR] WITH T2.REC.index = LEVEL )
       I2 : rel1 IN [shiftrel] AND
            T3.CAT IN [ADVP, NP]
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* 1 ADVP *)
      <T1: ADVP{ADVPrec1}[mu5]
       T2: ADVPVAR{ADVPVARrec1}[] >
      <T3: ADVP{ADVPrec2}[mu5] >

      COMP
         <
          C1: (tempadv IN ADVPrec1.actsubcefs) AND
              (ADVPVARrec1 = COPYT_advptovar(ADVPrec1)) AND
              ((ADVPrec1.class = reference) OR
               (ADVPrec1.class = frequential) OR
               ((ADVPrec1.class = duration) AND
                ((ADVPrec1.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((ADVPrec1.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              ) 
              C11:(CLAUSErec1.tiempo <> omegatiempo) AND
                  (ADVPrec1.supertiempo = CLAUSErec1.tiempo)
              A11: @
              C12:(CLAUSErec1.supertiempo <> omegatiempo) AND
                  (ADVPrec1.supertiempo = CLAUSErec1.supertiempo) 
              A12: @
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.supertiempo := omegatiempo;
              CLAUSErec2 := CLAUSErec1;

         >
      DECOMP
         <
          C1: (tempadv IN ADVPrec2.actsubcefs) 
              C11:((ADVPrec2.class = reference) OR
                    (ADVPrec2.class = frequential)) 
                  C111: (CLAUSErec2.tiempo <> omegatiempo)
                  A111: ADVPrec1 := ADVPrec2;
                        ADVPrec1.supertiempo := CLAUSErec2.tiempo;
                  C112: CLAUSErec2.supertiempo <> omegatiempo
                  A112: ADVPrec1 := ADVPrec2;
                        ADVPrec1.supertiempo := CLAUSErec2.supertiempo;
               A11: CLAUSErec1 := CLAUSErec2;

               C12: (ADVPrec2.class = duration) 
                   C121: (ADVPrec2.aspecto = perfectivo) 
                        C1211: stative IN CLAUSErec2.aktionsarts
                               C12111: (CLAUSErec2.tiempo <> omegatiempo)
                               A12111: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.supertiempo := 
                                                        CLAUSErec2.tiempo;
                               C12112: CLAUSErec2.supertiempo <> omegatiempo
                               A12112: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.supertiempo := 
                                                     CLAUSErec2.supertiempo;
                        A1211: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [stative];

                        C1212: activity IN CLAUSErec2.aktionsarts
                               C12121: (CLAUSErec2.tiempo <> omegatiempo)
                               A12121: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.supertiempo := 
                                                        CLAUSErec2.tiempo;
                               C12122: CLAUSErec2.supertiempo <> omegatiempo
                               A12122: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.supertiempo := 
                                                     CLAUSErec2.supertiempo;
                        A1212: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [activity];
                   A121: @

                   C122: (ADVPrec2.aspecto = imperfectivo) 
                        C1221: accomplishment IN CLAUSErec2.aktionsarts
                               C12211: (CLAUSErec2.tiempo <> omegatiempo)
                               A12211: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.supertiempo := 
                                                        CLAUSErec2.tiempo;
                               C12212: CLAUSErec2.supertiempo <> omegatiempo
                               A12212: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.supertiempo := 
                                                     CLAUSErec2.supertiempo;
                        A1221: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [accomplishment];

                        C1222: achievement IN CLAUSErec2.aktionsarts
                               C12221: (CLAUSErec2.tiempo <> omegatiempo)
                               A12221: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.supertiempo := 
                                                        CLAUSErec2.tiempo;
                               C12222: CLAUSErec2.supertiempo <> omegatiempo
                               A12222: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.supertiempo := 
                                                     CLAUSErec2.supertiempo;
                        A1222: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [achievement];
                   A122: @
              A12: @ 

          A1: ADVPVARrec1 := COPYT_advptovar(ADVPrec1);
              ADVPVARrec1.index := LEVEL;

         >

   SUBRULE (* 2 frequential NP *)
      <T1: NP{NPrec1}[mu5]
       T2: NPVAR{NPVARrec1}[] >
      <T3: NP{NPrec2}[mu5] >

      COMP
         <
          C1: (unitnoun IN NPrec1.actsubcs) AND
              (NPVARrec1 = COPYT_Nptovar(NPrec1)) AND
              (NPrec1.class = frequential) 
              C11:(CLAUSErec1.tiempo <> omegatiempo) AND
                  (NPrec1.supertiempo = CLAUSErec1.tiempo)
              A11: @
              C12:(CLAUSErec1.supertiempo <> omegatiempo) AND
                  (NPrec1.supertiempo = CLAUSErec1.supertiempo) 
              A12: @
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: (unitnoun IN NPrec2.actsubcs) AND
               (NPrec2.class = frequential) 
              C11: CLAUSErec2.tiempo <> omegatiempo
              A12: NPrec1 := NPrec2;
                   NPrec1.supertiempo := CLAUSErec2.tiempo;
              C12: CLAUSErec1.supertiempo <> omegatiempo
              A12: NPrec1 := NPrec2;
                   NPrec1.supertiempo := CLAUSErec2.supertiempo;
          A1: NPVARrec1 := COPYT_Nptovar(NPrec1);
              NPVARrec1.index := LEVEL;
              CLAUSErec1 := CLAUSErec2;

         >
>


&

\end{verbatim}
