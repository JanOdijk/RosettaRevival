\newpage
\begin{verbatim}
% TRANSFORMATION TObjReflInsertion1        (* NPVAR antecedent *)
< m1: VERBPPROP{VERBPPROPrec1}
               [mu8,
                subjrel/NPVAR{NPVARrec1},
                mu1,
                predrel/VERBP{VERBPrec1}
                       [mu4,
                        head/I1::VERB{VERBrec1}[mu3],
                        I3:sig1,
                        I2:mu2
                       ],
                mu5
               ]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu8,
                subjrel/NPVAR{NPVARrec1},
                mu1,
                predrel/VERBP{VERBPrec1}
                       [mu4,
                        head/I1::VERB{VERBrec1}[mu3],
                        I3:sig1,
                        objrel/NP{NPrec1}[head/T1],
                        I2:mu2
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.reflexivity = dobjrefl 
       I2: NOT EXIST (mu2, [objrel/..]) AND
           NOT EXIST (mu2, [partrel/..])
       I3: ALL (sig1, partrel/..)
      >

<
   SUBRULE (* 1. myself *)
      < >
      < T1: REFLPRO(AUX_myselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 1 }
          A1: NPrec1 := AUX_NPONmyRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 1 } AND
              NPrec1 = AUX_NPONmyRFLPR 
          A1: @
         >

   SUBRULE (* 2. yourself *)
      < >
      < T1: REFLPRO(AUX_yourselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 2 }
          A1: NPrec1 := AUX_NPONyoursgRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 2 } AND
              NPrec1 = AUX_NPONyoursgRFLPR
          A1: @
         >

   SUBRULE (* 3. himself *)
      < >
      < T1: REFLPRO(AUX_himselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 3 } AND
              NPVARrec1.NPhead <> oneNP
            C11: masculine IN NPVARrec1.sexes OR
                 NPVARrec1 = { sexes    : []
                               genders NI masculinegender }
            A11: @
          A1: NPrec1 := AUX_NPONhimRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 3 } AND
              NPVARrec1.NPhead <> oneNP AND
              NPrec1 = AUX_NPONhimRFLPR
            C11: masculine IN NPVARrec1.sexes OR
                 NPVARrec1 = { sexes    : []
                               genders NI masculinegender }
            A11: @
          A1: @
         >

   SUBRULE (* 4. herself *)
      < >
      < T1: REFLPRO(AUX_herselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 3 } AND
              NPVARrec1.NPhead <> oneNP
            C11: feminine IN NPVARrec1.sexes OR
                 NPVARrec1 = { sexes    : []
                               genders NI femininegender }
            A11: @
          A1: NPrec1 := AUX_NPONherRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 3 } AND
              NPVARrec1.NPhead <> oneNP AND
              NPrec1 = AUX_NPONherRFLPR
            C11: feminine IN NPVARrec1.sexes OR
                 NPVARrec1 = { sexes    : []
                               genders NI femininegender }
            A11: @
          A1: @
         >

   SUBRULE (* 5. itself *)
      < >
      < T1: REFLPRO(AUX_itselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 3 }  AND
              NPVARrec1.NPhead <> oneNP
            C11: NPVARrec1.genders = [omegagender] AND
                 NPVARrec1.sexes = []
            A11: @
          A1: NPrec1 := AUX_NPONitRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : singular
                            person   : 3} AND
              NPVARrec1.NPhead <> oneNP AND
              NPrec1 = AUX_NPONitRFLPR
            C11: NPVARrec1.genders = [omegagender] AND
                 NPVARrec1.sexes = []
            A11: @
          A1: @
         >

   SUBRULE (* 6. ourselves *)
      < >
      < T1: REFLPRO(AUX_ourselvesreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : plural
                            person   : 1 }
          A1: NPrec1 := AUX_NPONourRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : plural
                            person   : 1 } AND
              NPrec1 = AUX_NPONourRFLPR
          A1: @
         >

   SUBRULE (* 7. yourselves *)
      < >
      < T1: REFLPRO(AUX_yourselvesreflprokey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { number   : plural
                            person   : 2 }
          A1: NPrec1 := AUX_NPONyourplRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : plural
                            person   : 2 } AND
              NPrec1 = AUX_NPONyourplRFLPR
          A1: @
