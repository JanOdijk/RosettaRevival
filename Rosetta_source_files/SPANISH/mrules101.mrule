
SPANISH 101
&
There are four rules to form adverbial subordinate clauses:
\begin{description}
 \item[Rconjsent1] finite subordinate adverbial clauses introduced by a
                     conjunction: cuando ven\'{\i}a
 \item[Rconjsent2] infinite subordinate adverbial clauses intorduced by a
                     conjunction: ?antes de venir
 \item[Rconjsent3] finite subordinate adverbial clauses intorduced by a
                     preposition: antes de que ven\'{i}a, despues de que..
 \item[Rconjsent4] infinite subordinate adverbial clauses intorduced by a
                     preposition:sin venir, antes de venir
 \item[Rconjsent5] gerund adverbial clauses introduced by the abstract
                   conjunction gerCONJkey: nadando
\end{description}

\newpage
\begin{verbatim}
%
% RULE Rconjsent1
< m1:SENTENCE{SENTENCErec1}[conjrel/CONJ(KEY_queCONJkey){CONJrec1}, mu1 ] 
  m2:CONJ{CONJrec2}
>

< m : SENTENCE{SENTENCErec2}[conjrel/CONJ{CONJrec2}, mu1 ] 
>
      COMP
         <
          C1: CONJrec2.adverbial = true                     AND
              SENTENCErec1 =                  
		  {
		  senttype   : subordinateclause
		  conjkey    : KEY_queCONJkey
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto : omegaaspecto
		  conjretro  : false
		  }
              C11: CONJrec2.temporal = false
                   C111: synQUESENTind IN CONJrec2.conjpatterns AND
                        SENTENCErec1.modo = indicativo
                   A111: @
                   C112: synQUESENTsubj IN CONJrec2.conjpatterns AND
                        SENTENCErec1.modo = subjuntivo
                   A112: @
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2 :=                  
		           {
		            conjkey    : CONJrec2.key
		            adverbial  : CONJrec2.adverbial
		            temporal   : CONJrec2.temporal
		            conjclass  : CONJrec2.class
		            conjtiempo : CONJrec2.tiempo
		            conjaspecto : CONJrec2.aspecto
		            conjretro  : CONJrec2.retro
		           };

              C12: CONJrec2.temporal = true
                   C121: synQUESENTind IN CONJrec2.conjpatterns AND
                         SENTENCErec1.modo = indicativo
                                 
                         C1211: CONJrec2.class = duration OR
                                CONJrec2.class = frequential OR
                                (CONJrec2.class = reference AND
                                 CONJrec2.retro = true)
                         A1211: SENTENCErec2 := SENTENCErec1;
                               SENTENCErec2 :=                  
		                {
		                 conjkey    : CONJrec2.key
		                 adverbial  : CONJrec2.adverbial
		                 temporal   : CONJrec2.temporal
		                 conjclass  : CONJrec2.class
		                 conjtiempo : CONJrec2.tiempo
		                 conjaspecto : CONJrec2.aspecto
		                 conjretro  : CONJrec2.retro
		                };

                         C1212: CONJrec2.class = reference AND
                                CONJrec2.retro = false AND
                                (((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = perfectivo
                                 ) AND
                                 (SENTENCErec1.aspecto = perfectivo)
                                 ) OR
                                 ((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = imperfectivo
                                  ) AND
                                 (SENTENCErec1.aspecto = imperfectivo)
                                )
                               ) 
                               C12121: (CONJrec2.tiempo = presente) AND
                                       (SENTENCErec1.tiempo = presente)
                               A12121: SENTENCErec2 := SENTENCErec1;
                                       SENTENCErec2.conjtiempo:= presente;
                               C12122: (CONJrec2.tiempo = omegatiempo OR
                                        CONJrec2.tiempo = pasado
                                       ) AND
                                       (SENTENCErec1.tiempo = pasado)
                               A12122: SENTENCErec2 := SENTENCErec1;
                                       SENTENCErec2.conjtiempo:= pasado;
                               C12123: (CONJrec2.tiempo = futuro) OR
                                       (CONJrec2.tiempo = omegatiempo AND
                                        SENTENCErec1.tiempo = presente)
                               A12123: SENTENCErec2 := SENTENCErec1;
                                       SENTENCErec2.conjtiempo:= futuro;

                        A1212: SENTENCErec2 :=
      		               {
 	                        conjkey    : CONJrec2.key
                                adverbial  : CONJrec2.adverbial
	                        temporal   : CONJrec2.temporal
		                conjclass  : CONJrec2.class
		                conjaspecto : CONJrec2.aspecto
		                conjretro  : CONJrec2.retro
 		               };
                  A121: @
                  C122: synQUESENTsubj IN CONJrec2.conjpatterns AND
                        SENTENCErec1.modo = subjuntivo
                         C1221: CONJrec2.class = duration OR
                                CONJrec2.class = frequential OR
                                (CONJrec2.class = reference AND
                                 CONJrec2.retro = true)
                         A1221: SENTENCErec2 := SENTENCErec1;
                               SENTENCErec2 :=                  
		                {
		                 conjkey    : CONJrec2.key
		                 adverbial  : CONJrec2.adverbial
		                 temporal   : CONJrec2.temporal
		                 conjclass  : CONJrec2.class
		                 conjtiempo : CONJrec2.tiempo
		                 conjaspecto : CONJrec2.aspecto
		                 conjretro  : CONJrec2.retro
		                };

                         C1222: CONJrec2.class = reference AND
                                CONJrec2.retro = false AND
                                (((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = perfectivo
                                 ) AND
                                 (SENTENCErec1.aspecto = perfectivo)
                                 ) OR
                                 ((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = imperfectivo
                                  ) AND
                                 (SENTENCErec1.aspecto = imperfectivo)
                                )
                               ) 
                               C12221: (CONJrec2.tiempo = presente) AND
                                       (SENTENCErec1.tiempo = presente)
                               A12221: SENTENCErec2 := SENTENCErec1;
                                       SENTENCErec2.conjtiempo:= presente;
                               C12222: (CONJrec2.tiempo = omegatiempo OR
                                        CONJrec2.tiempo = pasado
                                       ) AND
                                       (SENTENCErec1.tiempo = pasado)
                               A12222: SENTENCErec2 := SENTENCErec1;
                                       SENTENCErec2.conjtiempo:= pasado;
                               C12223: (CONJrec2.tiempo = futuro) OR
                                       (CONJrec2.tiempo = omegatiempo AND
                                        SENTENCErec1.tiempo = presente)
                               A12223: SENTENCErec2 := SENTENCErec1;
                                       SENTENCErec2.conjtiempo:= futuro;

                        A1222: SENTENCErec2 :=
      		               {
 	                        conjkey    : CONJrec2.key
                                adverbial  : CONJrec2.adverbial
	                        temporal   : CONJrec2.temporal
		                conjclass  : CONJrec2.class
		                conjaspecto : CONJrec2.aspecto
		                conjretro  : CONJrec2.retro
 		               };

                  A122: @
              A12:@
          A1: @
         >
      DECOMP
         <
          C1: CONJrec2.adverbial = true
 
              C11: CONJrec2.temporal = false AND
                  SENTENCErec2 =                  
		  {
		  senttype   : subordinateclause
		  conjkey    : CONJrec2.key
		  adverbial  : CONJrec2.adverbial
		  temporal   : CONJrec2.temporal
		  conjclass  : CONJrec2.class
		  conjtiempo : CONJrec2.tiempo
		  conjaspecto : CONJrec2.aspecto
		  conjretro  : CONJrec2.retro
		  }
                 C111: synQUESENTind IN CONJrec2.conjpatterns AND
                       SENTENCErec2.modo = indicativo
                 A111: @
                 C121: synQUESENTsubj IN CONJrec2.conjpatterns AND
                       SENTENCErec2.modo = subjuntivo
                 A121: @

              A11: SENTENCErec1 := SENTENCErec2;

              C12: CONJrec2.temporal = true
                   C121: synQUESENTind IN CONJrec2.conjpatterns AND
                         SENTENCErec2.modo = indicativo
                         C1211: (CONJrec2.class = duration OR
                                 CONJrec2.class = frequential OR
                                 (CONJrec2.class = reference AND
                                  CONJrec2.retro = true)
                                ) AND
                                SENTENCErec2 =                  
		                {
		                  conjkey    : CONJrec2.key
		                  adverbial  : CONJrec2.adverbial
		                  temporal   : CONJrec2.temporal
		                  conjclass  : CONJrec2.class
		                  conjtiempo : CONJrec2.tiempo
		                  conjaspecto : CONJrec2.aspecto
		                  conjretro  : CONJrec2.retro
		                }
                         A1211: SENTENCErec1 := SENTENCErec2;

                         C1212: CONJrec2.class = reference AND
                                CONJrec2.retro = false AND
                                (((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = perfectivo
                                  ) AND
                                  (SENTENCErec2.aspecto = perfectivo)
                                 ) OR
                                 ((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = imperfectivo
                                  ) AND
                                  (SENTENCErec2.aspecto = imperfectivo)
                                 )
                                ) 
                                C12121: (CONJrec2.tiempo = presente) AND
                                        (SENTENCErec2.tiempo = presente) AND
                                        (SENTENCErec2.conjtiempo= presente)
                                A12121: SENTENCErec1 := SENTENCErec2;
                                C12122: (CONJrec2.tiempo = omegatiempo OR
                                         CONJrec2.tiempo = pasado
                                        ) AND
                                        (SENTENCErec2.tiempo = pasado) AND
                                        (SENTENCErec2.conjtiempo= pasado)
                                A12122: SENTENCErec1 := SENTENCErec2;
                                C12123: ((CONJrec2.tiempo = futuro) OR
                                         (CONJrec2.tiempo = omegatiempo AND
                                          SENTENCErec2.tiempo = presente)
                                        )  AND
                                        SENTENCErec2.conjtiempo = futuro
                                A12123: SENTENCErec1 := SENTENCErec2;
                         A1212: @ 


                   A121: @
                   C122: synQUESENTsubj IN CONJrec2.conjpatterns AND
                         SENTENCErec2.modo = subjuntivo

                         C1221: (CONJrec2.class = duration OR
                                 CONJrec2.class = frequential OR
                                 (CONJrec2.class = reference AND
                                  CONJrec2.retro = true) 
                                ) AND
                                SENTENCErec2 =                  
		                {
		                  conjkey    : CONJrec2.key
		                  adverbial  : CONJrec2.adverbial
		                  temporal   : CONJrec2.temporal
		                  conjclass  : CONJrec2.class
		                  conjtiempo : CONJrec2.tiempo
		                  conjaspecto : CONJrec2.aspecto
		                  conjretro  : CONJrec2.retro
		                }
                         A1221: SENTENCErec1 := SENTENCErec2;

                         C1222: CONJrec2.class = reference AND
                                CONJrec2.retro = false AND
                                (((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = perfectivo
                                  ) AND
                                  (SENTENCErec2.aspecto = perfectivo)
                                 ) OR
                                 ((CONJrec2.aspecto = omegaaspecto OR
                                   CONJrec2.aspecto = imperfectivo
                                  ) AND
                                  (SENTENCErec2.aspecto = imperfectivo)
                                 )
                                ) 
                                C12221: (CONJrec2.tiempo = presente) AND
                                        (SENTENCErec2.tiempo = presente) AND
                                        (SENTENCErec2.conjtiempo= presente)
                                A12221: SENTENCErec1 := SENTENCErec2;
                                C12222: (CONJrec2.tiempo = omegatiempo OR
                                         CONJrec2.tiempo = pasado
                                        ) AND
                                        (SENTENCErec2.tiempo = pasado) AND
                                        (SENTENCErec2.conjtiempo= pasado)
                                A12222: SENTENCErec1 := SENTENCErec2;
                                C12223: ((CONJrec2.tiempo = futuro) OR
                                         (CONJrec2.tiempo = omegatiempo AND
                                          SENTENCErec2.tiempo = presente)
                                        )  AND
                                        SENTENCErec2.conjtiempo = futuro
                                A12223: SENTENCErec1 := SENTENCErec2;
                         A1222: @ 

                   A122: @
              A12: @
          A1: SENTENCErec1 :=                  
		  {
		  conjkey    : KEY_queCONJkey
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto : omegaaspecto
		  conjretro  : false
		  }
         >



&

