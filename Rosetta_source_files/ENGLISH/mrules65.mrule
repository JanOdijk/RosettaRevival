% RULE RQPinfcomplmod

< m1: QP{QPrec1}[mu1, head/Q{Qrec1}]
  m2: I5::SENTENCE{SENTENCErec1}[mu5]
>


< m : QP{QPrec1}[mu1,
                 head/Q{Qrec1},
                 toinfcomplrel/I6::SENTENCE{SENTENCErec2}[mu5]
                ]

>


   MATCHCONDITIONS
      <m1: QPrec1.thanas = tocompl
       m:  QPrec1.thanas = tocompl 
       I5: SENTENCErec1 = 
                          {
                           prosubject: true
                           finiteness: infinite
                           infsort: toinf
                          } AND
           SENTENCErec1.mood IN [declarative, proobjmod]           
       I6: SENTENCErec2 = 
                          {
                           prosubject: true
                           finiteness: infinite
                           infsort   : toinf
                          } AND
           SENTENCErec2.mood IN [declarative, proobjmod]           

      >

      COMP
         <
          C1: SENTENCErec1.superdeixis = QPrec1.superdeixis
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.superdeixis := omegadeixis;

         >
      DECOMP
         <
          C1: SENTENCErec2.superdeixis = omegadeixis
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.superdeixis := QPrec1.superdeixis;
         >


&

\end{verbatim}
