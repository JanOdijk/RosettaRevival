\begin{verbatim}
% RULE RCNmodbareNP
< m1: I3::CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2]
                ] 
               
  m2: NP{NPrec1}[I1:mu3,
                 head/I4::CN{CNrec2}[I2:mu4]
                ]
>
< m: I3::CN{CNrec1}[mu1,
                    head/NOUN{NOUNrec1}[mu2],
                    modrel/PREPP{PREPPrec1}
                              [head/PREP(KEY_deprepkey){PREPrec1},
                               objrel/I5::NP{NPrec2}[I1:mu3,
                                                     head/I4::CN{CNrec2}[I2:mu4]
                                                     ]
                              ]
                   ]

>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu3, [detrel/..])
       I2: EXIST(mu4, [head/NOUN{NOUNrec8}[mu8]])
       I3: count IN CNrec1.posscomas AND 
           CNrec1.thetanp = omegathetanp AND
           CNrec1.animate = noanimate
       I4: CNrec2.definite <> def AND
           ((mass IN CNrec2.posscomas) OR
            ( CNrec2.numero = plural)) 
       m2: NPrec1.definite = indef
       I5: NPrec2.definite = indef
      >


      COMP
         <
          C1: NPrec1.supertiempo = CNrec1.supertiempo AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo AND
              NPrec2.generic = omegageneric
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := CNrec1.supertiempo;
              NPrec1.cases := [];
              NPrec1.generic := nogeneric;
              (* CNrec2.cases ?? *)
         >

&

\end{verbatim}
