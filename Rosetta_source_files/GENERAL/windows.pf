 *  Postcondition   : The specified part of the window is inserted
 *  Side Effects    : Scrolling of the text
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_InsertLines (VAR w    : Windows_Window;
                               StartRow : Windows_RowRange;
                               NrLines  : Integer);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_InsertLine
 *  Description     : inserts text lines in the specified window
 *  Parameters      : w        : Windows_Window
 *                    StartRow : Windows_RowRange
 *                    line     : String_String
 *  Precondition    : w is opened.
 *  Postcondition   : The specified part of the window is inserted
 *  Side Effects    : Scrolling of the text
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_InsertLine  (VAR w    : Windows_Window;
                               StartRow : Windows_RowRange;
                               line     : String_String);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_EraseLine
 *  Description     : Erases specified line from specified column
 *                    to end of line
 *  Parameters      : w        : Windows_Window
 *                    StartRow : Windows_RowRange
 *                    StartColumn: Windows_ColumnRange
 *  Precondition    : w is opened.
 *  Postcondition   : The specified part of the window is inserted
 *  Side Effects    : Scrolling of the text
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_EraseLine   (VAR w    : Windows_Window;
                               StartRow : Windows_RowRange;
                               StartColumn : Windows_ColumnRange);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_DrawHorizontalLine
 *  Description     : Will draw an horizontal line in a window
 *  Parameters      : VAR w       : Windows_Window
 *                        Row     : Windows_RowRange
 *                        Column  : Windows_ColumnRange
 *                        Columns : Windows_ColumnRange
 *  Precondition    : 
 *  Postcondition   : Line drawn from (Row,Column) to 
 *                    (Row, Column + Columns - 1)
 *  Side Effects    : cursor movement
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_DrawHorizontalLine (VAR w       : Windows_Window;
                                          Row     : Windows_RowRange;
                                          Column  : Windows_ColumnRange;
                                          Columns : Windows_ColumnRange);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_DrawVerticalLine
 *  Description     : Will draw a vertical line
 *  Parameters      : VAR w       : Windows_Window
 *                        Row     : Windows_RowRange
 *                        Column  : Windows_ColumnRange
 *                        Rows    : Windows_RowRange
 *  Precondition    : 
 *  Postcondition   : Line drawn from (Row,Column) to (Row + Rows - 1,Column)
 *  Side Effects    : cursor movement
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_DrawVerticalLine (VAR w       : Windows_Window;
                                        Row     : Windows_RowRange;
                                        Column  : Windows_ColumnRange;
                                        Rows    : Windows_RowRange);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_DrawRectangle
 *  Description     : Will draw a rectangle
 *  Parameters      : VAR w       : Windows_Window
 *                        Row     : Windows_RowRange
 *                        Column  : Windows_ColumnRange
 *                        Rows    : Windows_RowRange
 *                        Columns : Windows_ColumnRange
 *  Precondition    : 
 *  Postcondition   : Rectangle drawn with top-left point (Row,Column) and
 *                    bottom-right point (Row + Rows - 1,Column + Columns - 1)
 *  Side Effects    : Cursor movement
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_DrawRectangle (VAR w       : Windows_Window;
                                     Row     : Windows_RowRange;
                                     Column  : Windows_ColumnRange;
                                     Rows    : Windows_RowRange;
                                     Columns : Windows_ColumnRange);
EXTERNAL;



