\newpage
\begin{verbatim}
% TRANSFORMATION Tsuperdeixisadaptation1a
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3:mu7,
                    rel2/VERB{VERBrec2}[mu8],
                    mu9
                   ],
            mu10,
            I1:rel1/SENTENCE{SENTENCErec1}[mu2], 
            mu3
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3:mu7,
                    rel2/VERB{VERBrec2}[mu8],
                    mu9
                   ],
            mu10,
            I1:rel1/SENTENCE{SENTENCErec2}[mu2], 
            mu3
           ]

>
   MATCHCONDITIONS
      <
       I1: rel1 IN [complrel, prepobjrel, extraposrel]
       I3: NOT EXIST (mu7, [auxrel/..])
      >

<
   SUBRULE (* no have in VERBP *)
      <mu2: [I2:mu4]>
      <mu2: [I2:mu4]>

   MATCHCONDITIONS
      <
       I2: NOT EXIST(mu4, [predrel/VERBP{VERBPrec1}[I21:mu5]])
       I21: EXIST(mu5, [auxrel/I22::VERB{VERBrec1}[mu6]])
       I22: (VERBrec1.subc IN [haveverb])
      >


      COMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec1.superdeixis = omegadeixis) AND
                  (((SENTENCErec1.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis) 
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec1.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     ) 
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                           in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

                  (* dependent clause present *)
             C12: (SENTENCErec1.superdeixis = presentdeixis) AND
                  (SENTENCErec1.deixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec1.finiteness = finite)
                 A121: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := presentdeixis;

                 C122: (SENTENCErec1.finiteness = infinite)
                 A122: SENTENCErec2 := SENTENCErec1;

             A12: SENTENCErec2.superdeixis := omegadeixis;

                  (* dependent clause past *)
             C13: (SENTENCErec1.deixis = omegadeixis) AND
                  (SENTENCErec1.superdeixis = pastdeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec1.finiteness = finite)
                 A131: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := pastdeixis;

                 C132: (SENTENCErec1.finiteness = infinite)
                 A132: SENTENCErec2 := SENTENCErec1;

             A13: SENTENCErec2.superdeixis := omegadeixis;


          A1: @
         >

      DECOMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec2.superdeixis = omegadeixis) AND
                  (((SENTENCErec2.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis) 
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec2.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     ) 
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                           in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec1 := SENTENCErec2;

                 (* dependent clause present *)
             C12:(SENTENCErec2.superdeixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec2.deixis = presentdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C122: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.superdeixis := presentdeixis;

                  (* dependent clause past *)
              C13:(SENTENCErec2.superdeixis = omegadeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec2.deixis = pastdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A131: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C132: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A132: SENTENCErec1 := SENTENCErec2;

              A13: SENTENCErec1.superdeixis := pastdeixis;

          A1: @
         >
   SUBRULE (* have in VERBP *)
      <mu2: [I2:mu4]>
      <mu2: [I2:mu4]>

   MATCHCONDITIONS
      <
       I2:  EXIST(mu4, [predrel/VERBP{VERBPrec1}[I21:mu5]])
       I21: EXIST(mu5, [auxrel/I22::VERB{VERBrec1}[mu6]])
       I22: (VERBrec1.subc IN [haveverb])
      >


      COMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec1.superdeixis = omegadeixis) AND
                  (((SENTENCErec1.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    ) 
                   ) OR
                   ((SENTENCErec1.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec1.deixis = omegadeixis) AND
                    (NOT (QUOTE_temprefnotfound(mu2))
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                         in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

                  (* dependent clause present *)
             C12: (SENTENCErec1.superdeixis = presentdeixis) AND
                  (SENTENCErec1.deixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec1.finiteness = finite)
                 A121: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := presentdeixis;

                 C122: (SENTENCErec1.finiteness = infinite)
                 A122: SENTENCErec2 := SENTENCErec1;

             A12: SENTENCErec2.superdeixis := omegadeixis;

                  (* dependent clause past *)
             C13: (SENTENCErec1.deixis = omegadeixis) AND
                  (SENTENCErec1.superdeixis = pastdeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec1.finiteness = finite)
                 A131: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := pastdeixis;

                 C132: (SENTENCErec1.finiteness = infinite)
                 A132: SENTENCErec2 := SENTENCErec1;

             A13: SENTENCErec2.superdeixis := omegadeixis;


          A1: @
         >

      DECOMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec2.superdeixis = omegadeixis) AND
                  (((SENTENCErec2.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    ) 
                   ) OR
                   ((SENTENCErec2.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec2.deixis = omegadeixis) AND
                    (NOT (QUOTE_temprefnotfound(mu2))
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                         in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec1 := SENTENCErec2;

                 (* dependent clause present *)
             C12:(SENTENCErec2.superdeixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec2.deixis = presentdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C122: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.superdeixis := presentdeixis;

                  (* dependent clause past *)
              C13:(SENTENCErec2.superdeixis = omegadeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec2.deixis = pastdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A131: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C132: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A132: SENTENCErec1 := SENTENCErec2;

              A13: SENTENCErec1.superdeixis := pastdeixis;

          A1: @
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tsuperdeixisadaptation1a
\item[* relevant examples:]
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:]  XPPROPtoCLAUSE
\item[* class:] TC: Superdeixisadaptation
\item[* date of creation:] 28-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Tsuperdeixisadaptation1 Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 29/09/88\ \ \ \ \ author: Lisette Appelo
\item date: 02/11/89\ \ \ \ \ author: Lisette Appelo\\
Changed name to ..1a. The original rule had to be splitted into a and b.\\
Added condition in independent complement part for modal verbs.
\end{enumerate}
\item[* task:] Check superdeixis of complementsentence with superdeixis or 
deixis of the higher clause in case of temporally dependent complement 
sentences. The superdeixis of the complement sentence is set omega/given a 
value present or past and the deixis value is given a value present or past/ 
set omega in cases necessary. (This is needed for efficiency 
reasons of the surface parser.) For temporally independent sentences this rule 
does nothing. 
\item[\ \ strategy:] It is assumed that there will be only one such a sentence 
in the clause; sentences that can be present more than once (adverbials) are 
treated with superdeixisadaptation11 (recursive) and Ftempindep1.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] A complement 
sentence with infinitive {\em have} may be independent, while other infinitive 
complement sentences are considered to be dependent. subrule 1 is for all 
complement clause without {\em have} in the VP. subrule 2 is for complement 
clauses with {\em have} in the VP. If {\em have} has its infinitive formit is 
always in the VP.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc. nr 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The combination of an independent presentdeixis complement 
clause with a present9deixis) higher clause is ruled out. It is supposed that 
these cases are always independent.\\
The rule is split up into two subrules. Only infinitive complement sentences 
with {\em have} may be independent.\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION Tsuperdeixisadaptation1b
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            subjrel/SENTENCE{SENTENCErec1}[mu2], 
            mu10,
            predrel/VERBP{VERBPrec1}
                   [I3:mu7,
                    rel2/VERB{VERBrec2}[mu8],
                    mu9
                   ],
            mu3
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            subjrel/SENTENCE{SENTENCErec2}[mu2], 
            mu10,
            predrel/VERBP{VERBPrec1}
                   [I3:mu7,
                    rel2/VERB{VERBrec2}[mu8],
                    mu9
                   ],
            mu3
           ]

>
   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [auxrel/..])
      >

<
   SUBRULE (* no have in VERBP *)
      <mu2: [I2:mu4]>
      <mu2: [I2:mu4]>

   MATCHCONDITIONS
      <
       I2: NOT EXIST(mu4, [predrel/VERBP{VERBPrec1}[I21:mu5]])
       I21: EXIST(mu5, [auxrel/I22::VERB{VERBrec1}[mu6]])
       I22: (VERBrec1.subc IN [haveverb])
      >


      COMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec1.superdeixis = omegadeixis) AND
                  (((SENTENCErec1.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis) 
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec1.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     ) 
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                           in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

                  (* dependent clause present *)
             C12: (SENTENCErec1.superdeixis = presentdeixis) AND
                  (SENTENCErec1.deixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec1.finiteness = finite)
                 A121: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := presentdeixis;

                 C122: (SENTENCErec1.finiteness = infinite)
                 A122: SENTENCErec2 := SENTENCErec1;

             A12: SENTENCErec2.superdeixis := omegadeixis;

                  (* dependent clause past *)
             C13: (SENTENCErec1.deixis = omegadeixis) AND
                  (SENTENCErec1.superdeixis = pastdeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec1.finiteness = finite)
                 A131: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := pastdeixis;

                 C132: (SENTENCErec1.finiteness = infinite)
                 A132: SENTENCErec2 := SENTENCErec1;

             A13: SENTENCErec2.superdeixis := omegadeixis;


          A1: @
         >

      DECOMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec2.superdeixis = omegadeixis) AND
                  (((SENTENCErec2.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis) 
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec2.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     ) 
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                         in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec1 := SENTENCErec2;

                 (* dependent clause present *)
             C12:(SENTENCErec2.superdeixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec2.deixis = presentdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C122: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.superdeixis := presentdeixis;

                  (* dependent clause past *)
              C13:(SENTENCErec2.superdeixis = omegadeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec2.deixis = pastdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A131: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C132: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A132: SENTENCErec1 := SENTENCErec2;

              A13: SENTENCErec1.superdeixis := pastdeixis;

          A1: @
         >
   SUBRULE (* have in VERBP *)
      <mu2: [I2:mu4]>
      <mu2: [I2:mu4]>

   MATCHCONDITIONS
      <
       I2:  EXIST(mu4, [predrel/VERBP{VERBPrec1}[I21:mu5]])
       I21: EXIST(mu5, [auxrel/I22::VERB{VERBrec1}[mu6]])
       I22: (VERBrec1.subc IN [haveverb])
      >


      COMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec1.superdeixis = omegadeixis) AND
                  (((SENTENCErec1.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    ) 
                   ) OR
                   ((SENTENCErec1.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec1.deixis = omegadeixis) AND
                    (NOT (QUOTE_temprefnotfound(mu2))
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                         in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

                  (* dependent clause present *)
             C12: (SENTENCErec1.superdeixis = presentdeixis) AND
                  (SENTENCErec1.deixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec1.finiteness = finite)
                 A121: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := presentdeixis;

                 C122: (SENTENCErec1.finiteness = infinite)
                 A122: SENTENCErec2 := SENTENCErec1;

             A12: SENTENCErec2.superdeixis := omegadeixis;

                  (* dependent clause past *)
             C13: (SENTENCErec1.deixis = omegadeixis) AND
                  (SENTENCErec1.superdeixis = pastdeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec1.finiteness = finite)
                 A131: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := pastdeixis;

                 C132: (SENTENCErec1.finiteness = infinite)
                 A132: SENTENCErec2 := SENTENCErec1;

             A13: SENTENCErec2.superdeixis := omegadeixis;


          A1: @
         >

      DECOMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec2.superdeixis = omegadeixis) AND
                  (((SENTENCErec2.deixis = presentdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> presentdeixis) AND
                      (CLAUSErec1.superdeixis <> presentdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    ) 
                   ) OR
                   ((SENTENCErec2.deixis = pastdeixis) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.deixis <> pastdeixis) AND
                      (CLAUSErec1.superdeixis <> pastdeixis)
                     ) OR
                     (NOT (QUOTE_temprefnotfound(mu2))
                     )
                    )
                   ) OR
                   ((SENTENCErec2.deixis = omegadeixis) AND
                    (NOT (QUOTE_temprefnotfound(mu2))
                    )
                   ) OR (* modal auxiliary; superdeixis already dealt with
                         in previous cycle *)
                   ((VERBrec2.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec1 := SENTENCErec2;

                 (* dependent clause present *)
             C12:(SENTENCErec2.superdeixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec2.deixis = presentdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C122: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.superdeixis := presentdeixis;

                  (* dependent clause past *)
              C13:(SENTENCErec2.superdeixis = omegadeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec2.deixis = pastdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A131: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C132: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A132: SENTENCErec1 := SENTENCErec2;

              A13: SENTENCErec1.superdeixis := pastdeixis;

          A1: @
         >

>
&

