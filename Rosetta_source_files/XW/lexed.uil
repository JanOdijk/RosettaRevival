/* Rosetta lexed: main window definition */

module Rosetta
  
version = 'v1.0'
names = case_sensitive
character_set=iso_latin1
objects= {
  XmCascadeButton = gadget;
  XmToggleButton = gadget;
  XmPushButton = gadget;
  XmLabel = gadget;
  XmArrowButton = gadget;
  XmSeparator = gadget;
}

#include "Xwuil.h"

procedure
  XwuCreateWidget(integer);
  XwuManageWidget(integer);
  XwuUnmanageWidget(integer);
  XwaAction(integer);
  XwbAction(integer);
  XwdAction(integer);
  XwhAction(integer);
  XwlAction(integer);
  XwtAction(integer);

value
/*
  spacing             : 10;
  spacing_h           : 10;
  spacing_v           : 10;
*/
  spacing             : 4;
  spacing_h           : 4;
  spacing_v           : 4;

identifier
  small;
  normal;
  bold;
  big;
  bigbold;

list button_box_args : arguments {
  XmNpacking    = XmPACK_COLUMN;
  XmNentryAlignment = XmALIGNMENT_CENTER;
  XmNspacing    = spacing;
  XmNmarginWidth  = 0;
  XmNmarginHeight   = 0;
};

list button_args : arguments {
  XmNmarginHeight     = 4;
  XmNmarginWidth    = 4;
  XmNfontList       = bigbold;
  XmNhighlightThickness = 2;
  XmNshadowThickness  = 4;
  XmNsensitive      = false;
};

list cascade_args : arguments {
  XmNmarginHeight     = 4;
  XmNmarginWidth    = 4;
  XmNfontList       = bold;
  XmNsensitive      = false;
};

list form_args : arguments {
  XmNhorizontalSpacing = spacing_h;
  XmNverticalSpacing   = spacing_v;
};

list list_args : arguments {
  XmNscrollBarDisplayPolicy = XmSTATIC;
  XmNfontList      = normal;
  XmNhighlightThickness = 0;
};

list form_dialog_args : arguments {
  XmNdialogStyle  = XmDIALOG_MODELESS;
  arguments form_args;
};

list arrow_button_args : arguments {
  XmNheight      = 21;
  XmNwidth       = 25;
};

list text_args : arguments {
  XmNfontList      = normal;
};

list label_args : arguments {
  XmNfontList      = bold;
};

list toggle_args : arguments {
  XmNfontList      = normal;
};


#include "le_select.uil"
#include "le_sid.uil"
#include "le_id.uil"
#include "le_il.uil"
#include "le_dialogs.uil"

object le_window : XmMainWindow {
  arguments {
    XmNmenuBar     = XmMenuBar le_menubar;
    XmNworkWindow   = XmForm le_work;
/*  XmNmessageWindow = XmFrame le_message_window; */
  };
  controls {
  XmMenuBar le_menubar;
  XmForm le_work;
/*    XmFrame le_message_window; */

  unmanaged XmFormDialog le_select_window; 
   unmanaged XmFormDialog le_sid_window;  
   unmanaged XmFormDialog le_id_window;  
   unmanaged XmFormDialog le_il_window;  
   unmanaged XmFormDialog le_ask_string_window;  
   unmanaged XmQuestionDialog le_ask_boolean_window;  
    unmanaged XmErrorDialog le_error_window;
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget (X_le_window);
  };
};  

object le_menubar : XmMenuBar {
  arguments {
    XmNmenuHelpWidget = XmCascadeButton le_help_menu;
    XmNspacing    = 30;
  };
  controls {
    XmCascadeButton le_file_menu;
    XmCascadeButton le_lemma_menu;
    XmCascadeButton le_edit_menu;
    XmCascadeButton le_options_menu;
    XmCascadeButton le_help_menu;
  };
};

object le_file_menu : XmCascadeButton {
  arguments { 
    arguments cascade_args;
    XmNlabelString = 'File'; 
    XmNsensitive   = true;
  };
  controls { 
    XmPulldownMenu {
      controls {
    XmCascadeButton {
      arguments {
      arguments cascade_args;
      XmNlabelString = 'Load'; 
      };
      controls { 
        XmPulldownMenu {
        controls {
            XmPushButton {
              arguments { 
                arguments cascade_args;
                XmNlabelString = 'Current'; 
              };
              callbacks {
                MrmNcreateCallback = procedure
                    XwuCreateWidget (X_le_current_button);
                XmNactivateCallback = procedure 
                 XwbAction (X_le_current_button);
              };
            };
            XmPushButton {
              arguments { 
                arguments cascade_args;
                XmNlabelString = 'Frozen'; 
              };
              callbacks {
                MrmNcreateCallback = procedure
                    XwuCreateWidget (X_le_frozen_button);
                XmNactivateCallback = procedure 
                 XwbAction (X_le_frozen_button);
              };
            };
            XmPushButton {
              arguments { 
                arguments cascade_args;
                XmNlabelString = 'Local'; 
              };
              callbacks {
                MrmNcreateCallback = procedure
                    XwuCreateWidget (X_le_local_button);
                XmNactivateCallback = procedure 
                 XwbAction (X_le_local_button);
              };
            };
          };
        };
      };
    };
    XmCascadeButton {
      arguments {
        arguments cascade_args;
        XmNlabelString = 'Language'; 
        XmNsensitive   = true;
      };
      controls { 
        XmPulldownMenu {
          controls {
            XmPushButton {
              arguments { 
                arguments cascade_args;
                XmNlabelString = 'Dutch'; 
              };
              callbacks {
                MrmNcreateCallback = procedure
                    XwuCreateWidget (X_le_dutch_button);
                XmNactivateCallback = procedure 
                 XwbAction (X_le_dutch_button);
              };
            };
            XmPushButton {
              arguments { 
                arguments cascade_args;
                XmNlabelString = 'English'; 
              };
              callbacks {
                MrmNcreateCallback = procedure
                    XwuCreateWidget (X_le_english_button);
                XmNactivateCallback = procedure 
                 XwbAction (X_le_english_button);
              };
            };
            XmPushButton {
              arguments { 
                arguments cascade_args;
                XmNlabelString = 'Spanish'; 
              };
              callbacks {
                MrmNcreateCallback = procedure
                    XwuCreateWidget (X_le_spanish_button);
                XmNactivateCallback = procedure 
                 XwbAction (X_le_spanish_button);
              };
            };
          };
        };
      };
    };
    XmPushButton {
      arguments { 
        arguments cascade_args;
        XmNlabelString = 'Exit'; 
      };
      callbacks {
        MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_exit_button);
        XmNactivateCallback = procedure 
            XwbAction (X_le_exit_button);
          };
        };
      };
    };
  };
};

