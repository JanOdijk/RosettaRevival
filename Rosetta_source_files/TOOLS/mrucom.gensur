%BONUSspec
BASIS RULE
      BONUSspec = (SBONUS/1|WBONUS/2).(MINCAT/3|PLUSCAT/4).NUMBER/5.[SEMICOLON/6]
SURFACE PART

<*
INIT: BEGIN
      END;
1 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
3 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
4 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
5 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        END
    *>
6 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_BONUSspec; 
                END
*>
END;
PROCEDURAL PART
VAR minus::bool;
    sbonuspres,wbonuspres::bool;
    sbonusval,wbonusval::int;
    len:INTEGER;len1:STRING_range;
    bonusfile:LOCALFILE;
    str1:STRING(5);
BEGIN
INIT: BEGIN  minus:=FALSE;sbonuspres:=FALSE;wbonuspres:=FALSE;
            sbonusval:=0;wbonusval:=0;
            \bonusfile.\LOCAL. INITLOCALFILE(bonusfile);
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN sbonuspres:=TRUE END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN wbonuspres:=TRUE END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN minus:=TRUE END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
5: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF sbonuspres THEN
                           BEGIN
                           TSTRING_extractchars(str1,len1,%NUMBER.str,1,
                              length(%NUMBER.str));
                           len:=len1;
                           sbonusval:=converttointeger(str1,len);
                           IF minus THEN sbonusval:=-sbonusval;
                           END
                          ELSE
                           BEGIN
                           TSTRING_extractchars(str1,len1,%.str,1,
                              length(%.str));
                           len:=len1;
                           wbonusval:=converttointeger(str1,len);
                           IF minus THEN wbonusval:=-wbonusval;
                           END;
               IF sbonuspres THEN
                 BEGIN
                 IF sbonusval>=0 THEN BEGIN 
                    "wbonus:=1000*" """sbonusval""" ";"\\ END
                 ELSE BEGIN "wbonus:=-1000*" """-sbonusval""" ";" \\ END;
                 END
               ELSE
                 BEGIN
                 IF wbonusval>=0 THEN BEGIN "wbonus:=" """wbonusval""" ";"\\ END
                 ELSE BEGIN "wbonus:=-" """-wbonusval""" ";" \\ END;
                 END;
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN $$BONUSspec.bonusfile:=bonusfile;
      END
END;
&

 
%DTREE
BASIS RULE
      DTREE = (IDENTIFIER/2.SLASH/1.(RULE|RULECLASS).
               SQUAREOPEN/15.DTREE/4.{COMMA/1.DTREE/4}.SQUARECLOSE/1|
               BLEX/1.SLASH/1.(IDENTIFIER/16.ROUNDOPEN/1.KEYNAME/8.ROUNDCLOSE/1
               |LABELEDTD/9|BARETD/11))|
               X1/3|X2/3|X3/3|X4/3|X5/3
      VALUE = IDENTIFIER/6|X1/7|X2/7|X3/7|X4/7|X5/7
      PARAMETERS = CURLYOPEN/13.[VPID/17].{(IDENTIFIER/5|LEVEL/10|SUBST/14).
       DOTDOT/1.VALUE}.CURLYCLOSE/1
      RULE = IDENTIFIER/12.[PARAMETERS]
      RULECLASS = ROUNDOPEN/1.{RULE}.ROUNDCLOSE/1
SURFACE PART
VAR rulenode,normalnode,variable::bool;
    nrargs::int;
    str1,str:TSTRING_string;
    recordsvar,muvarlist,sigmavarlist,treevarlist,nodevarlist,
    relvarlist::setofidents;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

<*
INIT: BEGIN initsetofidents(recordsvar);
            initsetofidents(muvarlist);
            initsetofidents(sigmavarlist);
            initsetofidents(treevarlist);
            initsetofidents(nodevarlist);
            initsetofidents(relvarlist);
            TSTRING_constantempty(str);
            nrargs:=0;
            variable:=FALSE;rulenode:=FALSE;normalnode:=FALSE;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN variable:=TRUE;
                              str:=%.str;
                        END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                              APPENDSETS(%DTREE.records,recordsvar);
                              APPENDSETS(%DTREE.MuVarList,MuVarList);
                              APPENDSETS(%DTREE.SigmaVarList,SigmaVarList);
                              APPENDSETS(%DTREE.TreeVarList,TreeVarlist);
                              APPENDSETS(%DTREE.NodeVarList,NodeVarList);
                              APPENDSETS(%DTREE.RelVarList,relVarList);
                              nrargs:=nrargs+1;
                        END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
7 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
8 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%KEYNAME.str1;normalnode:=TRUE END
    *>
9 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                              APPENDSETS(%LABELEDTD.records,recordsvar);
                              APPENDSETS(%LABELEDTD.MuVarList,MuVarList);
                              APPENDSETS(%LABELEDTD.SigmaVarList,SigmaVarList);
                              APPENDSETS(%LABELEDTD.TreeVarList,TreeVarlist);
                              APPENDSETS(%LABELEDTD.NodeVarList,NodeVarList);
                              APPENDSETS(%LABELEDTD.RelVarList,relVarList);
                        END
    *>
10 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
11 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                              APPENDSETS(%BARETD.records,recordsvar);
                              APPENDSETS(%BARETD.MuVarList,MuVarList);
                              APPENDSETS(%BARETD.SigmaVarList,SigmaVarList);
                              APPENDSETS(%BARETD.TreeVarList,TreeVarlist);
                              APPENDSETS(%BARETD.NodeVarList,NodeVarList);
                              APPENDSETS(%BARETD.RelVarList,relVarList);
                        END
    *>
12 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN rulenode:=TRUE;normalnode:=TRUE;
                      str1:=MRUCOMDECL_Convinttostring(counter);
                      TSTRING_constantempty(str);
                      TSTRING_append(str,'_');
                      TSTRING_append(str,str1);
                      assigncounter(counter+1);
                        END
    *>
13 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
14 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
15 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
16 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
17 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_DTREE;
                      $DTREE.nrargs:=nrargs;
                      $DTREE.rulenode:=rulenode;
                      $DTREE.normalnode:=normalnode;
                      $DTREE.variable:=variable;
                      $DTREE.str:=str;
                      $DTREE.records:=recordsvar;
                      $DTREE.muvarlist:=muvarlist;
                      $DTREE.sigmavarlist:=sigmavarlist;
                      $DTREE.treevarlist:=treevarlist;
                      $DTREE.nodevarlist:=nodevarlist;
                      $DTREE.relvarlist:=relvarlist;
                END
*>
END;
PROCEDURAL PART
VAR rightcom,externprocedures,procedures,body,comactions,decomactions:LOCALFILE;
    subgrammarname,category,paramname,name,treevarname,procedurename,str:TSTRING_string;
    counter,externcounter,nrargs,nrofrules,len,number,numberofitems:INTEGER;
    levelids::setofidents;
    len1:STRING_range;
    str1:STRING(30);
    ptr:^INTEGER;
    crash,substpar,paramspresent,normalnode,rulenode::bool;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;
BEGIN
INIT: BEGIN initlocalfile(rightcom);
            initlocalfile(procedures);
            initlocalfile(externprocedures);
            initlocalfile(body);
            initlocalfile(comactions);
            initlocalfile(decomactions);
            crash:=FALSE;
            nrargs:=$DTREE.nrargs;
            nrofrules:=0;
            initsetofidents(levelids);
            substpar:=FALSE;
            paramspresent:=FALSE;
            rulenode:=$DTREE.rulenode;
            normalnode:=$DTREE.normalnode;
            counter:=$$DTREE.counter;
            externcounter:=$$DTREE.externcounter;
            procedurename:=$DTREE.str;
            name:=$$DTREE.name;
            \rightcom.\LOCAL.
            "function crdtree" ""procedurename"" 
            IF not normalnode THEN """externcounter + 1"""
                 ":HYPERDTREE_pHyperdtree;"\\
            "VAR d,dson:HYPERDTREE_pHyperDtree;"\\
                 " number:INTEGER;"\\
                 " hypernodeelt:HYPERDTREE_phypernodeelt;"\\
                 " params:LDMRULES_LiParameters;"\\
                 " lsps:LSPARAMS_precord;"\\
                 " elts:HYPERDTREE_SetOfHyperNodeElt;"\\
            \body.\LOCAL.
            "BEGIN"\\
            "HYPERDTREE_emptynode(elts);"\\
            "lsps:=NIL;"\\
            IF rulenode THEN
              BEGIN "HYPERDTREE_NewHyperDtree(d);"\\ END
            ELSE
              BEGIN "HYPERDTREE_NewHyperDtreeLeave(d);"\\ 
                    "d^.basicnodekind:=HYPERDTREE_basicnode;"\\
              END;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN subgrammarname:=%.str END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN %%DTREE.counter:=counter;
                  %%DTREE.externcounter:=externcounter;
                  %%DTREE.name:=name;
            END
      !DTREE.
      RECEIVE: BEGIN appendlocfile(%%DTREE.rightcom,procedures);
                     appendlocfile(%%DTREE.extern,externprocedures);
                     appendlocfile(%%DTREE.comactions,comactions);
                     appendlocfile(%%DTREE.decomactions,decomactions);
                     appendsets(%%DTREE.levelids,levelids);
                     counter:=%%DTREE.counter;
                     externcounter:=%%DTREE.externcounter;
                     str:=%DTREE.str;
                     "dson:=crdtree" ""str"" 
                     IF not %DTREE.normalnode THEN """externcounter""" ";"\\
                     "HYPERDTREE_AddToTuple(dson,d^.args);"\\
               END
   *>
5: <* SEND: BEGIN str:=%.str;paramname:=str; END
      !.
      RECEIVE: BEGIN "lsps^.X" """number""" 
                     ""str"" ":="
               END
   *>
6: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN ""str"" ";"\\ 
                    \decomactions.\LOCAL.
                    IF not substpar THEN
                      BEGIN
                      "lsps:=loopholes.retype(" ""name"" "delt" """counter"""
                          "^.parameters.ls,LSPARAMS_precord);"\\
                      "match:=match AND (" ""str"" "=" \\
                          "lsps^.X" """number""" 
                           ""paramname"" ");" \\ 
                      END ELSE substpar:=FALSE;
                    \body.\LOCAL.
               END
   *>
7: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN TSTRING_ExtractEND(str,str,2);
                     "-" ""str"" "-1;" \\
                     "params.index:=-" ""str"" "-1;"\\
                    \decomactions.\LOCAL.
                    str:=%.str;
                    ""str"" ":=" 
                         ""name"" "delt" """counter"""
                      "^.parameters.index;" \\ 
                    \body.\LOCAL.
               END
   *>
8: <* SEND: BEGIN str:=%KEYNAME.str1 END
      !.
      RECEIVE: BEGIN \body.\LOCAL.
                     "d^.Isrulenode:=FALSE;"\\
                     "d^.basicnodekind:=HYPERDTREE_basicnode;"\\
                     IF NOT(%KEYNAME.keyIvar) THEN
                       BEGIN
                       "HYPERDTREE_NewHyperDtreeBxpr(hypernodeelt,auxkey('" ""str""
                         "'));"\\
                       END
                     ELSE
                       BEGIN
                       "HYPERDTREE_NewHyperDtreeBxpr(hypernodeelt,0);"\\
                       END;
                     "HYPERDTREE_AddToNode(hypernodeelt,elts);"\\
                     IF %KEYNAME.keyIvar THEN 
                       BEGIN
                       counter:=counter+1;
                       ""name"" "d" """counter""" ":=d;"\\
                       \comactions.\LOCAL.
                       "hulpstree:=LDBLEX_read(" ""str"" ");"\\
                        ""name"" "d" """counter""" 
                         "^.li^.stree:=loopholes.retype"
                         "(hulpstree,HYPERDTREE_pstree);"\\
                       \decomactions.\LOCAL.
                       "hulplsstree:=loopholes.retype(" \\""name"" "d" """counter"""
                             "^.li^.stree,LSSTREE_pstree);"\\
                       "IF match THEN " 
                         ""str"" ":=hulplsstree^.ls^." ""category""
                       "field^.key;"\\ 
                       \body.\LOCAL.
                       END;
               END
   *>
9: <* SEND: BEGIN str:=%LABELEDTD.rhslabel.str END
      !LABELEDTD.
      RECEIVE: BEGIN treevarname:=%LABELEDTD.treevarname;
                     levelids:=%%LABELEDTD.levelids;
                     category:=%LABELEDTD.category;
                     \externprocedures.\LOCAL.
                     externcounter:=externcounter+1;
                     "PROCEDURE matchtree" """externcounter"""
                      "(s:LSSTREE_pstree;VAR match:BOOLEAN);"\\
                     appendlocfile(%%LABELEDTD.leftcom,externprocedures);
                     "BEGIN"\\
                     IF %LABELEDTD.containsTi THEN
                       BEGIN
                       ""treevarname"" ":=s;"\\
                       "match:=TRUE;"\\
                       END
                     ELSE
                       BEGIN
                       "matchnode(s,match);"\\
                       "match:=match AND (s^.sons=NIL);"\\
                       END;
                     "IF match THEN match:= matchcond" ""str"" ";"\\
                     "END;"\\
          "PROCEDURE createtree" """externcounter""" "(VAR s:LSSTREE_pstree);"\\
                     appendlocfile(%%LABELEDTD.rightcom,externprocedures);
                     "BEGIN"\\
                     IF %LABELEDTD.containsTi THEN
                       BEGIN
                       "s:=" ""treevarname"" ";"\\
                       END
                     ELSE
                       BEGIN
                       "s:=MAKET_stree(" ""category"" ");"\\
                       "createnode(s);s^.sons:=NIL"\\
                       END;
                     "END;"\\
                     counter:=counter+1;
                     \comactions.\LOCAL.
                     "createtree" """externcounter""" "(hulplsstree);"\\
                     ""name"" "d" """counter""" 
                        "^.li^.stree:=loopholes.retype"
                        "(hulplsstree,Hyperdtree_pstree);"\\
                     \decomactions.\LOCAL.
                     "hulplsstree:=loopholes.retype(" \\""name"" "d" """counter"""
                             "^.li^.stree,LSSTREE_pstree);"\\
                     "IF match THEN matchtree" """externcounter"""
                       "(hulplsstree,match);"\\
                     \body.\LOCAL.
                     IF %LABELEDTD.varcat THEN
                       BEGIN
                       "HYPERDTREE_NewHyperDtreeVar(hypernodeelt,0,LICAT0);"\\
                       "d^.basicnodekind:=HYPERDTREE_varnode;"\\
                       END
                     ELSE
                       BEGIN
                       "HYPERDTREE_NewHyperDtreeBxpr(hypernodeelt,0);"\\
                       END;
                     "HYPERDTREE_AddToNode(hypernodeelt,elts);"\\
                     ""name"" "d" """counter""" ":=d;"\\
               END
   *>
10: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "params.index:="
               END
   *>
11: <* SEND: BEGIN END
      !BARETD.
      RECEIVE: BEGIN \externprocedures.\LOCAL.
                     category:=%BARETD.category;
                     appendsets(%%BARETD.levelids,levelids);
                     treevarname:=%BARETD.treevarname;
                     externcounter:=externcounter+1;
                     "PROCEDURE matchtree" """externcounter"""
                      "(s:LSSTREE_pstree;VAR match:BOOLEAN);"\\
                     appendlocfile(%%BARETD.leftcom,externprocedures);
                     "BEGIN"\\
                     IF %BARETD.containsTi THEN
                       BEGIN
                       ""treevarname"" ":=s;"\\
                       "match:=TRUE;"\\
                       END
                     ELSE
                       BEGIN
                       "matchnode(s,match);"\\
                       IF %%BARETD.numberofitems=0 THEN BEGIN
                       "match:=match AND (s^.sons=NIL);"\\ END
                       ELSE BEGIN
                         numberofitems:=%%BARETD.numberofitems;
                         "IF match THEN matchlist"
                         """numberofitems"""
                         "items(s^.sons,TRUE,match);"\\
                         END;
                       END;
                     "END;"\\
          "PROCEDURE createtree" """externcounter""" "(VAR s:LSSTREE_pstree);"\\
          "VAR list:LSMRUQUO_listofstrees;"\\
                     appendlocfile(%%BARETD.rightcom,externprocedures);
                     "BEGIN"\\
                     IF %BARETD.containsTi THEN
                       BEGIN
                       "s:=" ""treevarname"" ";"\\
                       END
                     ELSE
                       BEGIN
                       "s:=MAKET_stree(" ""category"" ");"\\
                       "createnode(s);"\\
                       "createlist1(list);s^.sons:=list.first;"\\
                       "IF list.first<>NIL THEN" " list.last^.brother:=NIL;"\\
                       END;
                     "END;"\\
                     counter:=counter+1;
                     \comactions.\LOCAL.
                     "createtree" """externcounter""" "(hulplsstree);"\\
                     ""name"" "d" """counter""" 
                        "^.li^.stree:=loopholes.retype"
                        "(hulplsstree,hyperdtree_pstree);"\\
                     \decomactions.\LOCAL.
                     "hulplsstree:=loopholes.retype(" \\""name"" "d" """counter"""
                             "^.li^.stree,LSSTREE_pstree);"\\
                     "IF match THEN matchtree" """externcounter"""
                       "(hulplsstree,match);"\\
                     \body.\LOCAL.
                     IF %BARETD.varcat THEN
                       BEGIN
                       "HYPERDTREE_NewHyperDtreeVar(hypernodeelt,0,LICAT0);"\\
                       "d^.basicnodekind:=HYPERDTREE_varnode;"\\
                       END
                     ELSE
                       BEGIN
                       "HYPERDTREE_NewHyperDtreeBxpr(hypernodeelt,0);"\\
                       END;
                     "HYPERDTREE_AddToNode(hypernodeelt,elts);"\\
                     ""name"" "d" """counter""" ":=d;"\\
               END
   *>
12: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN 
             nrofrules:=nrofrules + 1;
             IF nrofrules>1 THEN
               BEGIN
               "params.ls:=loopholes.retype(lsps,LDMRULES_lsparams);"\\
               "HYPERDTREE_NewHyperDtreeRule"
                        "(hypernodeelt,0,number,params);"\\
               "HYPERDTREE_AddToNode(hypernodeelt,elts);"\\
               IF paramspresent THEN
                 BEGIN ""name""
                 "delt" """counter""" ":=hypernodeelt;"\\
                 END;
               END;
            paramspresent:=FALSE;
            number:=0;
            TSTRING_extractchars(str1,len1,str,1,length(str));
            len:=len1;
            "number:=" 
            LDMRULES_rulenumber(number,str1,len);
            IF number=0 THEN
              BEGIN
              "-"
              LDMRULES_transformationnumber(number,str1,len);
              END;
            """number""" ";"\\
{            "LDMRULES_rulenumber(number," "'" ""str"" "'"
              "," """TSTRING_length(str)""" ");"\\
            "IF number=0 THEN BEGIN"\\
            "LDMRULES_transformationnumber(number," "'" ""str"" "'"
              "," """TSTRING_length(str)""" ");" \\
            "number:=-number;"\\ 
            "END;"\\}
            "MEM_NewDefault(loopholes.sizeof(LSPARAMS_record),"
            "loopholes.retype(lsps,MEM_ptr));" \\
            "params.index:=-1;params.subst:=-1;"\\
            IF number=0 THEN 
                 BEGIN
                 writeln('WARNING, ',str,' not known as rule or transformation');
                 IF TSTRING_comparechars(subgrammarname,'IDFORMATION',11)<>0 
                     THEN crash:=TRUE;
                 END;
               END
   *>
13: <* SEND: BEGIN paramspresent:=TRUE END
      !.
      RECEIVE: BEGIN counter:=counter+1
               END
   *>
14: <* SEND: BEGIN substpar:=TRUE END
      !.
      RECEIVE: BEGIN "params.subst:=" END
   *>
15: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               "params.ls:=loopholes.retype(lsps,LDMRULES_lsparams);"\\
               "HYPERDTREE_NewHyperDtreeRule"
                      "(hypernodeelt,0,number,params);"\\
               "HYPERDTREE_AddToNode(hypernodeelt,elts);"\\
               IF paramspresent THEN
                 BEGIN ""name""
                 "delt" """counter""" ":=hypernodeelt;"\\
                 END;
               END
   *>
16: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN category:=%.str
               END
   *>
17: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \comactions.\LOCAL. "loopholes.retype("
                         ""name"" "delt" """counter"""
                      "^.parameters.ls,LSPARAMS_precord)^.X" """number"""
                               "vpid:=VPID;" \\ 
                     \decomactions.\LOCAL.
                         "VPID:=loopholes.retype(" ""name"" "delt" 
                      """counter""" "^.parameters.ls,LSPARAMS_precord)^.X" 
                         """number""" "vpid;" \\ 
               END
   *>
*>
FINAL:BEGIN appendlocfile(procedures,rightcom);
            IF FALSE{crash} THEN
              BEGIN
              ptr:=NIL;
              dispose(ptr);
              END;
            \body.\LOCAL.
            IF nrargs>0 THEN
              BEGIN
              "d^.nrofargs:=" """nrargs""" ";"\\
              END;
            "HYPERDTREE_addcluster(elts,d^.elts);"\\
            "crdtree" ""procedurename"" 
            IF not normalnode THEN """externcounter""" ":=d;"\\
            "END;"\\
            appendlocfile(body,rightcom);
            $$DTREE.rightcom:=rightcom; 
            $$DTREE.comactions:=comactions; 
            $$DTREE.extern:=externprocedures;
            $$DTREE.decomactions:=decomactions; 
            $$DTREE.counter:=counter; 
            $$DTREE.levelids:=levelids; 
            $$DTREE.externcounter:=externcounter; 
      END
END;
&

 
%LABELEDDTREE
BASIS RULE
      LABELEDDTREE = [LABELtje/3.DOTDOT/1].DTREE/2
SURFACE PART
VAR str,labelstr:TSTRING_string;
    recordsvar,muvarlist,sigmavarlist,treevarlist,nodevarlist,
    relvarlist::setofidents;
    variable:BOOLEAN;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

<*
INIT: BEGIN initsetofidents(recordsvar);
            initsetofidents(muvarlist);
            initsetofidents(sigmavarlist);
            initsetofidents(treevarlist);
            initsetofidents(nodevarlist);
            initsetofidents(relvarlist);
            TSTRING_constantempty(labelstr);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%DTREE.str;
                              variable:=%DTREE.variable;
                              APPENDSETS(%DTREE.records,recordsvar);
                              APPENDSETS(%DTREE.MuVarList,MuVarList);
                              APPENDSETS(%DTREE.SigmaVarList,SigmaVarList);
                              APPENDSETS(%DTREE.TreeVarList,TreeVarlist);
                              APPENDSETS(%DTREE.NodeVarList,NodeVarList);
                              APPENDSETS(%DTREE.RelVarList,relVarList);
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN labelstr:=%LABELtje.str END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_LABELEDDTREE;
                      $LABELEDDTREE.variable:=variable;
                      $LABELEDDTREE.labelstr:=labelstr;
                      $LABELEDDTREE.str:=str;
                      $LABELEDDTREE.records:=recordsvar;
                      $LABELEDDTREE.muvarlist:=muvarlist;
                      $LABELEDDTREE.sigmavarlist:=sigmavarlist;
                      $LABELEDDTREE.treevarlist:=treevarlist;
                      $LABELEDDTREE.nodevarlist:=nodevarlist;
                      $LABELEDDTREE.relvarlist:=relvarlist;
                END
*>
END;
PROCEDURAL PART
VAR extern,rightcom,comactions,decomactions:LOCALFILE;
    name,str:TSTRING_string;
    levelids::setofidents;
BEGIN
INIT: BEGIN initlocalfile(rightcom);name:=$$LABELEDDTREE.name;
            str:=$LABELEDDTREE.str;
            initsetofidents(levelids);
            \rightcom.\LOCAL.
            "function crdtree" ""name"" ";"\\
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN %%DTREE.counter:=0;
                  %%DTREE.externcounter:=0;
                  %%DTREE.name:=name;
            END
      !DTREE.
      RECEIVE: BEGIN appendlocfile(%%DTREE.rightcom,rightcom);
                     comactions:=%%DTREE.comactions;
                     levelids:=%%DTREE.levelids;
                     decomactions:=%%DTREE.decomactions;
                     extern:=%%DTREE.extern;
               END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN 
            "BEGIN"\\
            "crdtree" ""name"" ":=crdtree" ""str""\\
            "END;"\\
            $$LABELEDDTREE.rightcom:=rightcom;
            $$LABELEDDTREE.extern:=extern; 
            $$LABELEDDTREE.levelids:=levelids;
            $$LABELEDDTREE.comactions:=comactions;
            $$LABELEDDTREE.decomactions:=decomactions;
      END
END;
&
