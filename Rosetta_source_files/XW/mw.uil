/* Rosetta mw : main window definition */

object mw_window : XmMainWindow {
    arguments {
        XmNmenuBar       = XmMenuBar mw_menubar;
        XmNworkWindow	 = XmPanedWindow mw_work_window;
	XmNmessageWindow = XmFrame mw_message_window;
    };
    controls {
	XmMenuBar mw_menubar;
	XmPanedWindow mw_work_window;
        XmFrame mw_message_window;
!
!	All other 'main' windows
!
	unmanaged XmFormDialog amb1_window;
	unmanaged XmFormDialog amb2_window;
	unmanaged XmFormDialog amb3_window;
	unmanaged XmFormDialog attr_window;
	unmanaged XmFormDialog dbg_window;
	unmanaged XmErrorDialog err_window;
	unmanaged XmQuestionDialog question_window;
	unmanaged XmFormDialog help_window;
	unmanaged XmFormDialog mp_window;
	unmanaged XmFormDialog mg_window;
	unmanaged XmPromptDialog file_window;
	unmanaged XmFormDialog dbgset_window;
	unmanaged XmFormDialog env_window;
	unmanaged XmFormDialog trees_window;
	unmanaged XmFormDialog tree_window;
	unmanaged XmFormDialog mps_window;
	unmanaged XmFormDialog hn_window;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_window);
    };
};	

object mw_menubar : XmMenuBar {
    arguments {
        XmNmenuHelpWidget = XmCascadeButton mw_help_menu;
        XmNspacing        = 30;
    };
    controls {
        XmCascadeButton mw_file_menu;
        XmCascadeButton mw_options_menu;
        XmCascadeButton mw_help_menu;
    };
};

object mw_file_menu : XmCascadeButton {
    arguments { 
        arguments cascade_args;
	XmNlabelString = N_mw_file_menu; 
    };
    controls { 
        XmPulldownMenu {
            controls {
                XmPushButton {
                    arguments { 
                        arguments cascade_args;
		        XmNlabelString = N_mw_new_button; 
                        XmNsensitive   = false;
                        XmNaccelerator = "Alt<Key>n";
                        XmNacceleratorText = "Alt/n";
		    };
                    callbacks {
                        MrmNcreateCallback = procedure
                                XwuCreateWidget (X_mw_new_button);
                        XmNactivateCallback = procedure 
	   		        XwbAction (X_mw_new_button);
                    };
                };
                XmPushButton {
                    arguments { 
                        arguments cascade_args;
		        XmNlabelString = N_mw_modify_button; 
                        XmNsensitive   = false;
                        XmNaccelerator = "Alt<Key>m";
                        XmNacceleratorText = "Alt/m";
		    };
                    callbacks {
                        MrmNcreateCallback = procedure
                                XwuCreateWidget (X_mw_modify_button);
                        XmNactivateCallback = procedure 
	   		        XwbAction (X_mw_modify_button);
                    };
                };
                XmPushButton {
                    arguments { 
                        arguments cascade_args;
		        XmNlabelString = N_mw_exit_button; 
                        XmNsensitive   = false;
                        XmNaccelerator = "Alt<Key>e";
                        XmNacceleratorText = "Alt/e";
		    };
                    callbacks {
                        MrmNcreateCallback = procedure
                                XwuCreateWidget (X_mw_exit_button);
                        XmNactivateCallback = procedure 
	   		        XwbAction (X_mw_exit_button);
                    };
                };
            };
        };
    };
};

