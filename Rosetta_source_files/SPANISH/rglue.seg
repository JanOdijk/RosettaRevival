{ 1st person pl.; comamos+nos+lo - comámonoslo }

*amos + nos + lo + (G) :: *ámonoslo(G) ;

*emos + nos + lo + (G) :: *émonoslo(G) ;


{ 2nd person pl.; recibid - recibídmelo }

*ad + (B1) + (A3) :: *ád(B1)(A3) ;

*ed + (B1) + (A3) :: *éd(B1)(A3) ;

*id + (B1) + (A3) :: *íd(B1)(A3) ;


{ 2nd person pl.; comed+os+lo --> coméoslo }

*ad + os + (F) :: *áos(F) ;

*ed + os + (F) :: *éos(F) ;

*id + os + (F) :: *íos(F) ;


{ 3rd person pl. ending on -an; cómanmelo }


*a(OE)(MED1)an+(B)+(A3) :: *á(OE)(MED1)an(B)(A3) ;

*e(OE)(MED1)an+(B)+(A3) :: *é(OE)(MED1)an(B)(A3) ;

*o(OE)(MED1)an+(B)+(A3) :: *ó(OE)(MED1)an(B)(A3) ;


