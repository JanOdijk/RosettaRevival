\newpage
\begin{verbatim}

% RULE RNPPossIngMood
< m1: I3::CLAUSE{CLAUSErec1}
                [ I1:subjrel/T1,
                  I6:mu2,
                  predrel/VERBP{VERBPrec1}
                         [I7:mu4,
                          rel1/VERB{VERBrec1}[mu3],
                          mu1
                         ],
                  mu5
                ] 
>

< m : NP{NPrec1}[ head/I5::SENTENCE{SENTENCErec1}
                          [ I2:subjrel/T2,
                            I6:mu2,
                            predrel/VERBP{VERBPrec1}
                                   [I7:mu4,
                                    rel1/VERB{VERBrec2}[mu3],
                                    mu1
                                   ],
                            mu5
                          ]
                     ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [ NP] 
       I2: T2.CAT IN [ NP, POSSADJ ] 
       I3: CLAUSErec1 = { finiteness : infinite
                          aspect     : perfective
                          infsort    : omegainf
                          PROsubject : false 
                          modus      : omegamodus }
       m:  NPrec1 = NPrecdef EXCEPT FOR 
                    [ NPhead, specQ, definite, 
                      superdeixis, aspect ] AND
           NPrec1 = { NPhead     : sentNP 
                      specQ      : yesspec
                      definite   : def
                      aspect     : SENTENCErec1.aspect
                      superdeixis: SENTENCErec1.superdeixis }
       I5: SENTENCErec1 = { mood        : declarative
                            senttype    : subordinateclause
                            modus       : ingform
                            finiteness  : infinite
                            aspect      : perfective
                            PROsubject  : false
                            infsort     : possing
                            conjkey     : 0
                            adverbial   : false
                            temporal    : false
                            conjclass   : omegaTimeAdvClass
                            conjdeixis  : omegadeixis
                            conjaspect  : omegaaspect
                            conjretro   : false }
       I6: ALL (mu2, I61:rel2/..)
         I61: rel2 IN 
              (AUX_preauxAdvRels + AUX_postauxAdvRels 
               + [negrel, tempadvrel])
       I7: NOT EXIST (mu4, [../VERB{VERBrec3}[mu8]])
     >

<
   SUBRULE (* 1. NPs on CN or INDEFPRO *)
      < T1: NP{NPrec2}[I8:mu6] >
      < T2: NP{NPrec3}[I8:mu6,
                         gluerel/GLUE{GLUErec1},
                         modrel/GEN(AUX_genGENkey){GENrec1}
                        ] >

   MATCHCONDITIONS
      <
       I8: NOT EXIST (mu6, [head/PERSPRO{PERSPROrec1}[mu7]]) AND
           NOT EXIST (mu6, [head/WHPRO{WHPROrec1}[mu7]])
       T1: QUOTE_CheckGen(T1)
      >

      COMP
         <
          C1: VERBrec1.modus = omegamodus AND
              NPrec2.cases = []
          A1: NPrec1 := { NPhead      : sentNP
                          specQ       : yesspec
                          mood        : nowh
                          definite    : def
                          person      : 3
                          number      : singular 
                          aspect      : CLAUSErec1.aspect
                          superdeixis : CLAUSErec1.superdeixis };
              VERBrec2 := VERBrec1;
              VERBrec2.modus := ingform;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood        : declarative
                                senttype    : subordinateclause
                                modus       : ingform
                                infsort     : possing };
              NPrec3 := NPrec2;
              NPrec3.cases := [accusative]
         >
      DECOMP
         <
          C1: VERBrec2.modus = ingform AND
              NPrec3.cases = [accusative]
          A1: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1 := { infsort     : omegainf
                              modus       : omegamodus };
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              NPrec2 := NPrec3;
              NPrec2.cases := []
         >

   SUBRULE (* 2. NP on PERSPRO *)
      < T1: NP{NPrec2}[head/PERSPRO{PERSPROrec1}
                           [head/BPERSPRO{BPERSPROrec1}]
                      ] >
      < T2: POSSADJ{POSSADJrec1}
                           [head/BPERSPRO{BPERSPROrec1}] >

      COMP
         <
          C1: VERBrec1.modus = omegamodus AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = omegacase AND
              NPrec2 = AUX_NPonPRSPR EXCEPT FOR [person, number, cases,
                        genders, animate] AND
              NPrec2 = { person  : PERSPROrec1.person
                         number  : PERSPROrec1.number
                         genders : [PERSPROrec1.gender]
                         animate : PERSPROrec1.animate
                         cases   : [] }
          A1: NPrec1 := { NPhead      : sentNP
                          specQ       : yesspec
                          mood        : nowh
                          definite    : def
                          person      : 3
                          number      : singular 
                          aspect      : CLAUSErec1.aspect
                          superdeixis : CLAUSErec1.superdeixis };
              (* other values, e.g. cases, remain default *)
              VERBrec2 := VERBrec1;
              VERBrec2.modus := ingform;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood        : declarative
                                senttype    : subordinateclause
                                modus       : ingform
                                infsort     : possing };
              POSSADJrec1.mood := nowh
              (* antecedent remains default *);
         >
      DECOMP
         <
          C1: VERBrec2.modus = ingform AND
              POSSADJrec1 = { mood       : nowh
                              antecedent : noant } 
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := omegacase;
              NPrec2 := AUX_NPonPRSPR;
              NPrec2 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate
                          cases   : [] };
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1 := { infsort     : omegainf
                              modus       : omegamodus };
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus
         >

   SUBRULE (* 3. NP on WHPRO *)
      < T1: NP{NPrec2}[head/WHPRO{WHPROrec1}
                           [head/BWHPRO{BWHPROrec1}]
                      ] >
      < T2: POSSADJ{POSSADJrec1}
                           [head/BWHPRO{BWHPROrec1}] >

      COMP
         <
          C1: VERBrec1.modus = omegamodus AND
              WHPROrec1 = COPYT_bwhproTOwhpro(BWHPROrec1) AND
              WHPROrec1.whcase = true AND
              (* `what' is excluded from this moodrule *)
              WHPROrec1.cases = [] AND
              NPrec2 = AUX_NPonWHPRO EXCEPT FOR 
                        [number, cases, animate] AND
              NPrec2 = { animate : WHPROrec1.animate
                         cases   : [] 
                         number  : WHPROrec1.number }
          A1: NPrec1 := { NPhead      : sentNP
                          specQ       : yesspec
                          mood        : nowh
                          definite    : def
                          person      : 3
                          number      : singular 
                          aspect      : CLAUSErec1.aspect
                          superdeixis : CLAUSErec1.superdeixis };
              (* other attributes, e.g. cases, remain default *)
              VERBrec2 := VERBrec1;
              VERBrec2.modus := ingform;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood        : declarative
                                senttype    : subordinateclause
                                modus       : ingform
                                infsort     : possing };
              POSSADJrec1.mood := wh
              (* antecedent remains default *);
         >
      DECOMP
         <
          C1: VERBrec2.modus = ingform AND
              POSSADJrec1 = { mood       : wh
                              antecedent : noant } AND
              BWHPROrec1.whcase = true
          A1: WHPROrec1 := COPYT_bwhproTOwhpro(BWHPROrec1);
              WHPROrec1.cases := [];
              NPrec2 := AUX_NPonWHPRO;
              NPrec2 := { animate : BWHPROrec1.animate
                          cases   : []
                          number  : BWHPROrec1.number };
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1 := { infsort     : omegainf
                              modus       : omegamodus };
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus
         >
>
&

\end{verbatim}
