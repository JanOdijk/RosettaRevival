\begin{verbatim}
%TRANSFORMATION TREFLspelling2a  (* object antecedent, NPVAR *)

< m1:I1::VERBPPROP{VERBPPROPrec1}
                      [ mu1,
                        predrel/VERBP{VERBPrec1}
                            [ mu11,
                              head/I2::VERB{VERBrec1}[mu6],
                              cliticrel/CLITIC{CLITICrec1}[mu4],
                              mu2,
                              I3:objrel/T2,
                              mu3
                            ],
                         mu10
                       ]
>

< m :I1::VERBPPROP{VERBPPROPrec1}
                      [ mu1,
                        predrel/VERBP{VERBPrec1}
                            [ mu11,
                              head/I2::VERB{VERBrec1}[mu6],
                              cliticrel/CLITIC{CLITICrec1}[mu5],
                              mu2,
                              I3:objrel/T2,
                              mu3
                            ],
                         mu10
                       ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.thetavp IN [vp010, vp012, vp021]
       I2: ( VERBrec1.reflexivity = reflexive )
         
         (*  AND ( VERBrec1.Caseassigner = false ) ????? *) 
           
       I3: T2.CAT IN [NP, NPVAR]
      >

<
   SUBRULE (*Me*)
      < mu4: [I3: mu7] >
      < mu5: [rel2/REFLPRO(AUX_Mereflprokey){REFLPROrec1}[],mu7] >

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [I31: rel3/..])
       I31: rel3 IN [unoclrel, dosclrel]
      >

      COMP
         <
          C1: (T2.REC.numero = singular) AND
              (T2.REC.persona = 1)
          A1: rel2 := unoclrel;
         >


   SUBRULE (*Te*)
      < mu4: [I3: mu7] >
      < mu5: [rel2/REFLPRO(AUX_Tereflprokey){REFLPROrec1}[],mu7] >

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [dosclrel/..])
      >

      COMP
         <
          C1: (T2.REC.persona = 2) AND
              (T2.REC.numero = singular)
          A1: rel2 := dosclrel
         >


   SUBRULE (*Se*)
      < mu4: [I3: mu7] >
      < mu5: [rel2/REFLPRO(AUX_Sereflprokey){REFLPROrec1}[],mu7] >

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [seclrel/..])
      >

      COMP
         <
          C1: T2.REC.persona = 3
          A1: rel2 := seclrel
         >


   SUBRULE (*Nos*)
      < mu4: [I3: mu7] >
      < mu5: [rel2/REFLPRO(AUX_Nosreflprokey){REFLPROrec1}[],mu7] >

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [I31: rel3/..])
       I31: rel3 IN [unoclrel, dosclrel]
      >

      COMP
         <
          C1: (T2.REC.numero = plural) AND
              (T2.REC.persona = 1)
          A1: rel2 := unoclrel
         >


   SUBRULE (*Os*)
      < mu4: [I3: mu7] >
      < mu5: [rel2/REFLPRO(AUX_Osreflprokey){REFLPROrec1}[],mu7] >

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [dosclrel/..])
      >

      COMP
         <
          C1: (T2.REC.numero = plural) AND
              (T2.REC.persona = 2)
          A1: rel2 := dosclrel
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TREFLspelling2a
\item[* relevant examples:]
   Sp. derretirse (= 'smelten'; ergative/reflexive)\\
       x1 derrite $\rightarrow$ x1 se derrite\\
       x1 dan $\rightarrow$ x1 se dan\\
e.g. Se dan casos = 'er doen zich gevallen voor'
  (Dutch:  x1 voordoen $\rightarrow$ x1 zich voordoen)\\

\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] TC:REFLspelling
\item[* date of creation:] 13-JULY-1987 10:20:00  
\item[* author:] Elly van Munster
\item[* copied from:] Jan Odijk
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 16/12/87\ \ \ \ \ author: Lisette Appelo
\item date: 23/1/89\ \ \ \ \ author: Elly van Munster\\
NP (T2) added.
\item date: 31/1/89\ \ \ \ \ author: Elly van Munster\\
M-rule notation changed (analogously to TreflCLOSEDCAT1a).
\end{enumerate}
\item[* task:] To spell out the reflexive pronoun {\em se} if the antecedent
is an object. Me and nos only in case there is no second person indirect object 
clitic.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] None
\item[\  \ suggested semantics:] dna
