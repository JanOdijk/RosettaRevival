\begin{verbatim}
% RULE RPPSRelMarking
< m1: CLAUSE{CLAUSErec1}
            [ mu1, 
              rel2/PREPP{PREPPrec1}
                  [ mu2,
                    I1:rel1/T1,
                    mu3
                  ],
              mu4 
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              rel2/PREPP{PREPPrec2}
                  [ mu2,
                    I2:rel1/T2,
                    mu3
                  ],
              mu4 
            ]
>


   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, PREPPVAR, ADVPVAR] 
                     WITH T1.REC.index = indexpar
       I2: T2.CAT IN [NPVAR, PREPPVAR, ADVPVAR] 
                     WITH T2.REC.mood IN [relativexpmood, topicmood]
      >

   PARAMETERS
      <
       indexpar   : indextype
       xpmoodpar  : xpmoodtype
      >

  <
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1} >
      < T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: NPVARrec1.mood = nowh AND
              xpmoodpar IN [relativexpmood, topicmood]
            C11: PREPPrec1.mood = nowh AND
                 xpmoodpar = relativexpmood
            A11: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := relativexpmood
            C12: PREPPrec1.mood = nowh AND
                 xpmoodpar = topicmood
            A12: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := topicmood
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.mood := xpmoodpar
         >

      DECOMP
         <
          C1: true
            C11: PREPPrec2.mood = relativexpmood
            A11: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := nowh
            C12: PREPPrec2.mood = topicmood
            A12: WBONUS -1;
                 PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := nowh
          A1: indexpar  := NPVARrec2.index; 
              xpmoodpar := NPVARrec2.mood;
              NPVARrec1 := NPVARrec2;
              NPVARrec1.mood := nowh;
         >

   SUBRULE (* 2. PREPPVAR *)
      < T1: PREPPVAR{PREPPVARrec1} >
      < T2: PREPPVAR{PREPPVARrec2} >

      COMP
         <
          C1: PREPPVARrec1.mood = nowh AND
              xpmoodpar IN [relativexpmood, topicmood]
            C11: PREPPrec1.mood = nowh AND
                 xpmoodpar = relativexpmood
            A11: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := relativexpmood
            C12: PREPPrec1.mood = nowh AND
                 xpmoodpar = topicmood
            A12: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := topicmood
          A1: PREPPVARrec2 := PREPPVARrec1;
              PREPPVARrec2.mood := xpmoodpar
         >

      DECOMP
         <
          C1: true
            C11: PREPPrec2.mood = relativexpmood
            A11: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := nowh
            C12: PREPPrec2.mood = topicmood
            A12: WBONUS -1;
                 PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := nowh
          A1: indexpar  := PREPPVARrec2.index; 
              xpmoodpar := PREPPVARrec2.mood;
              PREPPVARrec1 := PREPPVARrec2;
              PREPPVARrec1.mood := nowh;
         >

   SUBRULE (* 3. ADVPVAR *)
      < T1: ADVPVAR{ADVPVARrec1} >
      < T2: ADVPVAR{ADVPVARrec2} >

      COMP
         <
          C1: ADVPVARrec1.mood = nowh AND
              xpmoodpar IN [relativexpmood, topicmood]
            C11: PREPPrec1.mood = nowh AND
                 xpmoodpar = relativexpmood
            A11: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := relativexpmood
            C12: PREPPrec1.mood = nowh AND
                 xpmoodpar = topicmood
            A12: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := topicmood
          A1: ADVPVARrec2 := ADVPVARrec1;
              ADVPVARrec2.mood := xpmoodpar
         >

      DECOMP
         <
          C1: true
            C11: PREPPrec2.mood = relativexpmood
            A11: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := nowh
            C12: PREPPrec2.mood = topicmood
            A12: WBONUS -1;
                 PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := nowh
          A1: indexpar  := ADVPVARrec2.index; 
              xpmoodpar := ADVPVARrec2.mood;
              ADVPVARrec1 := ADVPVARrec2;
              ADVPVARrec1.mood := nowh;
         >
>
&

\end{verbatim}
