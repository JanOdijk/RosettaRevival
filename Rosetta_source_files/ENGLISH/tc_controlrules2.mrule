\begin{verbatim}
% TRANSFORMATION TOblObjControlADVP  (* OPENADVPPROP, obj control *)
< m1:CLAUSE{CLAUSErec1}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      I1:rel1/OPENADVPPROP{OPENADVPPROPrec1}
                             [ subjrel/T2,
                               predrel/ADVP{ADVPrec1}[mu4] 
                             ],
                      mu5
                    ],
             mu6 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      I1:rel1/ADVP{ADVPrec1}[mu4],
                      mu5
                    ],
             mu6 
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [locargrel, dirargrel, complrel]
       I3: NOT EXIST (mu1, [I31:auxrel/VERB{VERBrec1}[mu11]])
         I31: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} 
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1:
              NPVARrec1 = NPVARrec2 AND
              (* including cases, which should be nominative *)
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [req, env, aktionsarts, 
                            superdeixis, PROsubject] AND
              OPENADVPPROPrec1 = { aktionsarts  : [stative] 
                                   superdeixis  : omegadeixis 
                                   PROsubject   : true }
              (* nop test on req and env *)
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [diradjunct, locadjunct] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: @
         >
              
      DECOMP
         <
          C1: true
              C11: CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs :=
                   CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [diradjunct, locadjunct] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: NPVARrec2 := NPVARrec1;
              (* including cases, which should be nominative *)
              OPENADVPPROPrec1 := COPYT_advpTOprop(ADVPrec1);
              OPENADVPPROPrec1 := { aktionsarts  : [stative] 
                                    superdeixis  : omegadeixis 
                                    PROsubject   : true }
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1} 
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: 
              CNVARrec1 = CNVARrec2 AND
              (* including cases, which should be nominative *)
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [req, env, aktionsarts, 
                            superdeixis, PROsubject] AND
              OPENADVPPROPrec1 = { aktionsarts : [stative] 
                                   superdeixis : omegadeixis 
                                   PROsubject  : true }
              (* req and env have default value *)
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [diradjunct, locadjunct] <> []
              A12: CLAUSErec2 := CLAUSErec2;
          A1: @
         >
              
      DECOMP
         <
          C1: true
              C11: CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs :=
                    CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [diradjunct, locadjunct] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: 
              CNVARrec2 := CNVARrec1;
              (* including cases, which is nominative *)
              OPENADVPPROPrec1 := COPYT_advpTOprop(ADVPrec1) ;
              OPENADVPPROPrec1 := { aktionsarts : [stative] 
                                    superdeixis : omegadeixis 
                                    PROsubject  : true }
         >
>

&
\end{verbatim}
