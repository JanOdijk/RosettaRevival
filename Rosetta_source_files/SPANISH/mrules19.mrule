\begin{verbatim}
% TRANSFORMATION TSVagr1

      (* normal SV-agreement for different categories in subj.position *)

< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             head/I2::VERB{VERBrec1}
                  [ I4:rel1/VERB{VERBrec2}[mu3],
                    mu4 
                  ],
             mu5
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             head/I3::VERB{VERBrec3}
                    [ I4:rel1/VERB{VERBrec4}[mu3],
                      mu4 
                    ],
             mu5
           ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = finite 
       I2: VERBrec1.status = VV
       I3: VERBrec3.status = VV
       I4: rel1 IN [head, auxrel]
      >

<
   SUBRULE        (* 1 : NPVAR *)
      <T1:NPVAR{NPVARrec1}>
      <T1:NPVAR{NPVARrec1}>
      

      COMP
         <
          C1: (VERBrec1 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })                        AND

              (VERBrec2 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })       
               
          A1: VERBrec4 := VERBrec2;
              VERBrec4 :=
                  {
                   numero   : NPVARrec1.numero
                   persona  : NPVARrec1.persona
                  };

              VERBrec3 := VERBrec1;
              VERBrec3 :=
                  {
                   numero   : NPVARrec1.numero
                   persona  : NPVARrec1.persona
                  };                 
         >

      DECOMP
         <
          C1: (VERBrec4.numero = NPVARrec1.numero)     AND
              (VERBrec1.persona = NPVARrec1.persona)   AND

              (VERBrec3.numero = NPVARrec1.numero)     AND
              (VERBrec3.persona = NPVARrec1.persona)

          A1: VERBrec2 := VERBrec4;
              VERBrec1 := VERBrec3;

              VERBrec2 :=
                  {
                   numero   : omeganumero 
                   persona  : 3
                  };

              VERBrec1 :=
                  {
                   numero   : omeganumero 
                   persona  : 3
                  }
          >


   SUBRULE       (* 2 : CNVAR *)
      <T1:CNVAR{CNVARrec1}>
      <T1:CNVAR{CNVARrec1}>
      

      COMP
         <
          C1: (VERBrec1 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })                            AND

              (VERBrec2 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })       

          A1: VERBrec4 := VERBrec2;
              VERBrec4 :=
                  {
                   numero   : CNVARrec1.numero
                   persona  : 3
                  };

              VERBrec3 := VERBrec1;
              VERBrec3 :=
                  {
                   numero   : CNVARrec1.numero
                   persona  : 3
                  };
         >

      DECOMP
         <
          C1: (VERBrec4.numero = CNVARrec1.numero)  AND
              (VERBrec1.persona = 3)                AND

              (VERBrec3.numero = CNVARrec1.numero)  AND
              (VERBrec3.persona = 3)

          A1: VERBrec2 := VERBrec4;
              VERBrec1 := VERBrec3;

              VERBrec2 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  };

              VERBrec1 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  }
         >


SUBRULE       (* 3 : PRONP *)
      <T1:PRONP{PRONPrec1}[mu6]>
      <T1:PRONP{PRONPrec1}[mu6]>
      

      COMP
         <
          C1: (VERBrec1 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })                             AND

              (VERBrec2 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })              

          A1: VERBrec4 := VERBrec2;
              VERBrec4 :=
                  {
                   numero   : PRONPrec1.numero
                   persona  : PRONPrec1.persona
                  };

              VERBrec3 := VERBrec1;
              VERBrec3 :=
                  {
                   numero   : PRONPrec1.numero
                   persona  : PRONPrec1.persona
                  };                 
         >

      DECOMP
         <
          C1: (VERBrec4.numero = PRONPrec1.numero)    AND
              (VERBrec4.persona = PRONPrec1.persona)  AND

              (VERBrec3.numero = PRONPrec1.numero)    AND
              (VERBrec3.persona = PRONPrec1.persona)

          A1: VERBrec2 := VERBrec4;
              VERBrec1 := VERBrec3;

              VERBrec2 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  };

              VERBrec1 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  }
         >


   SUBRULE     (* 4 : NP *)
      <T1:NP{NPrec1}[mu7]>
      <T1:NP{NPrec1}[mu7]>
      

      COMP
         <
          C1: (VERBrec1 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })                               AND

              (VERBrec2 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })

          A1: VERBrec4 := VERBrec2;
              VERBrec4 :=
                  {
                   numero   : NPrec1.numero
                   persona  : NPrec1.persona
                  };

              VERBrec3 := VERBrec1;
              VERBrec3 :=
                  {
                   numero   : NPrec1.numero
                   persona  : NPrec1.persona
                  };                 
         >

      DECOMP
         <
          C1: (VERBrec4.numero = NPrec1.numero)   AND
              (VERBrec4.persona = NPrec1.persona) AND

              (VERBrec3.numero = NPrec1.numero)   AND
              (VERBrec1.persona = NPrec1.persona)

          A1: VERBrec2 := VERBrec4;
              VERBrec1 := VERBrec3;

              VERBrec2 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  };

              VERBrec1 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  }
         >

   SUBRULE    (*  5 : PRONPVAR *)
      <T1:PRONPVAR{PRONPVARrec1}>
      <T1:PRONPVAR{PRONPVARrec1}>
      

      COMP
         <
          C1: (VERBrec1 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })                               AND

              (VERBrec2 =
                  {
                   numero   : omeganumero 
                   persona  : 3
                  })

          A1: VERBrec4 := VERBrec2;
              VERBrec4 :=
                  {
                   numero   : PRONPVARrec1.numero
                   persona  : PRONPVARrec1.persona
                  };
              VERBrec3 := VERBrec1;
              VERBrec3 :=
                  {
                   numero   : PRONPVARrec1.numero
                   persona  : PRONPVARrec1.persona
                  }      
         >

      DECOMP
         <
          C1: (VERBrec4.numero = PRONPVARrec1.numero)     AND
              (VERBrec4.persona = PRONPVARrec1.persona)   AND

              (VERBrec3.numero = PRONPVARrec1.numero)     AND
              (VERBrec3.persona = PRONPVARrec1.persona)

          A1: VERBrec2 := VERBrec4;
              VERBrec1 := VERBrec3;

              VERBrec2 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  };

              VERBrec1 :=
                  {
                   numero   : omeganumero
                   persona  : 3
                  }
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TSVagr1
\item[* relevant examples:]
Yo ven $\rightarrow$ yo vengo\\
\'{e}l ven $\rightarrow$ \'{e}l viene\\
etc.\\
(el hombre) que ven $\rightarrow$ (el hombre) que viene\\
ese ser el libro $\rightarrow$ ese es el libro\\
estos ser los libros $\rightarrow$ estos son los libros\\
la casa ser construida $\rightarrow$ la casa es construida
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPTOCLAUSE
\item[* class:] TC:TSVagr
\item[* date of creation:] 18-MAR-1988 11:45:00  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 21/11/88\ \ \ \ \ author: Elly van Munster\\
subrule 4 extended to apply for {\bf all} NPs (i.e. not only for redelloNP, 
eseNP, etc., but also for cases with CLOSED category, e.g. futuro).
\item date: 13/01/89\ \ \ \ \ author: Lisette Appelo\\
Added matchcondition 5 to exclude ADJPs. In that case TSVagr2 should apply.
\item date: 25/01/89\ \ \ \ \ author: Lisette Appelo\\
Added condition voice <> passive
\item date: 26/01/89\ \ \ \ \ author: Lisette Appelo\\
Deleted condition on passive and ADJP, because separate rules for Adj- and
participle agreement will be written. This rule takes care of all subject-verb-
agreement. SVagr2 and 3 will be deleted and substituted by the new rules for 
ADJ and participle agreement.
\end{enumerate}
\item[* task:] To make the verb agree in "persona" and "numero" with the 
subject in a finite sentence.\\
NB. The V-Cluster node gets these attribute values too.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
Separate subrules are made for the categories {\bf PRONP} (i.e. 
subject-position with "SEactive") and {\bf PRONPVAR} (subject-position with 
ergative verbs when the subject is postverbal). \\ 
An alternative would have 
been to call the Categories in these positions NP with the (existing!) 
attributes NPhead = {\bf SEimpershead} (for PRONP) and NPhead = {\bf proSEhead}
(for PRONPVAR).
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\
\end{enumerate}
\end{description}


