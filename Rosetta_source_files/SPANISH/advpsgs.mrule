\newpage
\begin{verbatim}
%
%SUBGRAMMAR Advderivation

(RBADVtoSUB/1 | RSubadjtoSubadv/2)


HEAD:
<
BADV BASIC EXPRESSION
BADVSUFF BASIC EXPRESSION
>

<(* import *)>

EXPORT:
< SUBADV >
&


\newpage
% RULE RBAdvtoSUB
< m1:BADV{BADVrec1} 
>

< m :SUBADV{SUBADVrec1}[head/BADV{BADVrec1} ]
>

      COMP
         <
          C1: true
          A1: SUBADVrec1 := COPYT_BtoSUBADV(BADVrec1)
         >

      DECOMP
         <
          C1: SUBADVrec1 = COPYT_BtoSUBADV(BADVrec1)
          A1: @
         >
&

\end{verbatim}
