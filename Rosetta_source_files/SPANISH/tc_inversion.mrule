\newpage
\begin{verbatim}
% TRANSFORMATION Tinversion2     (* Imperatives *)
< m1:SENTENCE{SENTENCErec1}
             [ I1:sig1,
               subjrel/T2,
               I2:mu2,
               head/VERB{VERBrec1}[mu3],
               I3:mu5,
               I4:mu4
             ]
>

< m :SENTENCE{SENTENCErec1}
             [ I1:sig1,
               I2:mu2,
               head/VERB{VERBrec1}[mu3],
               I3:mu5,
               subjrel/T2,
               I4:mu4
             ]
>


   MATCHCONDITIONS
      <
       I1: ALL(sig1, leftdislocrel/..)
       I2: NOT EXIST(mu2, [leftdislocrel/..])
       I3: ALL(mu5, I5:rel1/..)
       I4: NOT EXIST (mu4, [I5:rel1/..])
       I5: rel1 IN [gluerel, cliticrel]
      >


      COMP
         <
          C1: SENTENCErec1.mood IN [imperativemood, yesnointerrogative] AND
              SENTENCErec1.senttype = mainclause
          A1: @
         >
      DECOMP
         <
          C1: SENTENCErec1.mood IN [imperativemood, yesnointerrogative] AND
              SENTENCErec1.senttype = mainclause
          A1: @
         >

&

\end{verbatim}
