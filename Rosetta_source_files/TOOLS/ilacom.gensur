%ILRULE
BASIS RULE
  ILRULE = IDENTIFIER/2.(PARAMETERS/1.LEFTARROW/1.
           {(PARAMname/3.COLON/1.TYPEname/4|LEVEL/5)}.RIGHTARROW/1|
           SEMICOLON/1)

SURFACE PART
VAR rulespec::rulespec;
    params::setofparams;
    param::param;
HELP FUNCTION checktypename(str:TSTRING_string):BOOLEAN;
     VAR found::bool;
         table::setoftypespecs;
         typespec::typespec;
     BEGIN
     found:=false;
     table:=typestable;
     WHILE stilltypespecs(table) AND not(found) DO
       BEGIN
       taketypespec(typespec,table);
       found:=(TSTRING_compare(typespec.typename,str)=0);
       END;
     IF not found THEN writeln('type ',str, ' used but not defined');
     checktypename:=found
     END;

<*
 INIT:BEGIN initsetofparams(params);
      END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN assigncounter(counter+1);
                                rulespec.rulename:=%.str;
                                rulespec.rulenr:=counter;
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN param.name:=%PARAMNAME.str;
                          END
       *>
4:     <*
        LOCALCONDITION: checktypename(%TYPENAME.str)
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN param.typename:=%TYPENAME.str;
                                appendparam(param,params);
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN TSTRING_constantempty(param.name);
                                TSTRING_appendchars(param.name,
                                      param.name,'LEVEL',5);
                                TSTRING_constantempty(param.typename);
                                TSTRING_appendchars(param.typename,
                                      param.typename,'INTEGER',7);
                                appendparam(param,params);
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  rulespec.params:=params;
                  appendrulespec(rulespec,rulestable);
                  SEND_ILRULE;
                END
*>
END;

