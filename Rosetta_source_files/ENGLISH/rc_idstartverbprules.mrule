\begin{verbatim}

%RULE RIDDERIV1

<m1: I1::SUBVERB{SUBVERBREC1}[head/BVERB(KEY1){BVERBREC1}]
 m2: T1
>

< m:  IDFORMATION/TIDCLAUSETOVPPROP
        [CLAUSETOSENTENCE/ROBJNPSUBST{LEVEL:X1 
                                      SUBST:2}
           [IDFORMATION/TIDVPPROPTOCLAUSE
              [VERBPPROPFORMATION/TVERBPATTERN1
                 [VERBPPROPFORMATION/RSTARTVPPROP120
                    [VERBDERIVATION/RBVERBTOSUB
                       [BLEX/BVERB(KEY2)],
                  BLEX/I2:T1,
                  BLEX/NPVAR(X1){NPVARrec1}
                    ]
                 ]
              ],
            IDFORMATION/RIDALTNPFORMATION1{VPID}
              [CNFORMATION/RCNFORMATION1
                 [IDFORMATION/RIDSUBNOUNTONOUN{VPID}
                    [NPDERIVATION/BNOUNTOSUBNOUN
                       [BLEX/BNOUN(KEY3)]
                    ]
                 ]
              ]
           ]
        ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBREC1.thetavp = vp120 
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
      >
COMP
 <
   C1: COMPINIDDICT(KEY1, VPID1)
   A1: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID1);
   C2: COMPINIDDICT(KEY1, VPID21)
   A2: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID21);
   C3: COMPINIDDICT(KEY1, VPID33)
   A3: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID33);
   C4: COMPINIDDICT(KEY1, VPID27)
   A4: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID27);
   C5: COMPINIDDICT(KEY1, VPID40)
   A5: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID40);
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3>, VPID1)
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID1);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
   C2: DECOMPINIDDICT(<KEY2, KEY3>, VPID21)
   A2: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID21);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
   C3: DECOMPINIDDICT(<KEY2, KEY3>, VPID33)
   A3: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID33);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
   C4: DECOMPINIDDICT(<KEY2, KEY3>, VPID27)
   A4: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID27);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
   C5: DECOMPINIDDICT(<KEY2, KEY3>, VPID40)
   A5: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID40);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
 >

&
\end{verbatim}
