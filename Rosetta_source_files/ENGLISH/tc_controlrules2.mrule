\newpage
\begin{verbatim}

% TRANSFORMATION TOblObjControlPREPP   (* OPENPREPPPROP, 
                                          object antecedent *)
< m1:CLAUSE{CLAUSErec1}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      I1:rel1/OPENPREPPPROP{OPENPREPPPROPrec1}
                             [ subjrel/T2,
                               predrel/PREPP{PREPPrec1}[mu4] 
                             ],
                      mu5
                    ],
             mu6 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      I2:rel2/PREPP{PREPPrec1}[mu4],
                      mu5
                    ],
             mu6 
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [locargrel, dirargrel, complrel]
       I2: rel2 IN [locargrel, dirargrel, predrel]
       I3: NOT EXIST (mu1, [I31:auxrel/VERB{VERBrec1}[mu11]])
         I31: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} 
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: 
              NPVARrec1 = NPVARrec2  AND
              (* including cases, which should be nominative *)
              OPENPREPPPROPrec1 = COPYT_preppTOpreppprop(PREPPrec1)
                EXCEPT FOR [ PROsubject, aktionsarts, superdeixis] AND
              OPENPREPPPROPrec1 = { PROsubject  : true
                                    aktionsarts : [stative] 
                                    superdeixis : omegadeixis }
              C11: ((CLAUSErec1.synvpefs * AUX_openxppvps <> []) OR
                    (ClAUSErec1.adjuncts * [diradjunct, locadjunct] <> [])) AND
                   rel1 IN [dirargrel, locargrel] 
              A11: CLAUSErec2 := CLAUSErec1;
                   rel2 := rel1;
              C12: ((CLAUSErec1.synvpefs * AUX_openxppvps <> []) OR
                    (CLAUSErec1.adjuncts * [resPP] <> [] ))           AND
                   rel1 IN [complrel] 
              A12: CLAUSErec2 := CLAUSErec1;
                   rel2 := predrel;
          A1: @
         >

      DECOMP
         <
          C1: true
              C11: ((CLAUSErec2.synvpefs * AUX_openxppvps <> []) OR
                    (ClAUSErec2.adjuncts * [diradjunct, locadjunct] <> [])) AND
                   rel2 IN [dirargrel, locargrel] 
              A11: CLAUSErec1 := CLAUSErec2;
                   rel1 := rel2;
              C12: ((CLAUSErec2.synvpefs * AUX_openxppvps <> []) OR
                    (CLAUSErec2.adjuncts * [resPP] <> [] ))           AND
                   rel2 IN [predrel] 
              A12: CLAUSErec1 := CLAUSErec2;
                   rel1 := complrel;
          A1: 
              NPVARrec2 := NPVARrec1;
              (* including cases, which should be nominative *)
              OPENPREPPPROPrec1 := COPYT_preppTOpreppprop(PREPPrec1);
              OPENPREPPPROPrec1 := { PROsubject  : true
                                     aktionsarts : [stative] 
                                     superdeixis : omegadeixis }
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1} 
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 AND
              (* including cases, which should be nominative *)
              OPENPREPPPROPrec1 = COPYT_preppTOpreppprop(PREPPrec1)
                EXCEPT FOR [PROsubject, aktionsarts, superdeixis] AND
              OPENPREPPPROPrec1 = { PROsubject  : true
                                    aktionsarts : [stative] 
                                    superdeixis : omegadeixis }
              C11: ((CLAUSErec1.synvpefs * AUX_openxppvps <> []) OR
                    (ClAUSErec1.adjuncts * [diradjunct, locadjunct] <> [])) AND
                   rel1 IN [dirargrel, locargrel] 
              A11: CLAUSErec2 := CLAUSErec1;
                   rel2 := rel1;
              C12: ((CLAUSErec1.synvpefs * AUX_openxppvps <> []) OR
                    (CLAUSErec1.adjuncts * [resPP] <> [] ))           AND
                   rel1 IN [complrel] 
              A12: CLAUSErec2 := CLAUSErec1;
                   rel2 := predrel;

          A1: @
         >

      DECOMP
         <
          C1: true
              C11: ((CLAUSErec2.synvpefs * AUX_openxppvps <> []) OR
                    (ClAUSErec2.adjuncts * [diradjunct, locadjunct] <> [])) AND
                   rel2 IN [dirargrel, locargrel] 
              A11: CLAUSErec1 := CLAUSErec2;
                   rel1 := rel2;
              C12: ((CLAUSErec2.synvpefs * AUX_openxppvps <> []) OR
                    (CLAUSErec2.adjuncts * [resPP] <> [] ))           AND
                   rel2 IN [predrel] 
              A12: CLAUSErec1 := CLAUSErec2;
                   rel1 := complrel;
          A1: 
              CNVARrec2 := CNVARrec1;
              (* including cases, which should be nominative *)
              OPENPREPPPROPrec1 := COPYT_preppTOpreppprop(PREPPrec1);
              OPENPREPPPROPrec1 := { PROsubject  : true
                                     aktionsarts : [stative] 
                                     superdeixis : omegadeixis }
         >
>

&
\end{verbatim}
