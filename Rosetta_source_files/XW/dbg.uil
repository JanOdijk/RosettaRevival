/* debug: debug output window */

object dbg_window : XmFormDialog {
    arguments {
	XmNdialogTitle	= N_dbg_window;
        arguments form_dialog_args;
        XmNdefaultPosition  = false;
    };
    controls {
	XmRowColumn    dbg_button_box;
        XmScrolledText dbg_area;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_dbg_window + DEFAULT_BUTTON_OFFSET*X_dbg_ok_button);
    };
};

object dbg_button_box : XmRowColumn {
    arguments {
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_dbg_stop_button;
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_dbg_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_dbg_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_dbg_hold_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure 
                    XwuCreateWidget (X_dbg_hold_button);
		XmNactivateCallback = procedure 
		    XwdAction (X_dbg_hold_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_dbg_tofile_button;
	    };
	    callbacks {
		XmNactivateCallback = procedure XwdAction (X_dbg_tofile_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_dbg_help_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_dbg_help_button);
		XmNactivateCallback = procedure XwhAction (X_dbg_help_button);
	    };
	};
    };
};


object dbg_area : XmScrolledText {
    arguments {
        arguments text_args;
        XmNeditable		= false;
	XmNeditMode		= XmMULTI_LINE_EDIT;
	XmNcolumns		= 60;
	XmNrows			= 10;
	XmNtopAttachment	= XmATTACH_FORM;
	XmNleftAttachment       = XmATTACH_FORM;
	XmNrightAttachment	= XmATTACH_FORM;
	XmNbottomAttachment	= XmATTACH_WIDGET;
	XmNbottomWidget		= XmRowColumn dbg_button_box;
        XmNscrollHorizontal     = false;
        XmNwordWrap             = true;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_dbg_area);
    };
};
