                        )
                       )

                       C1221: (SENTENCErec1.finiteness = finite)
                       A1221: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := pasado;

                       C1222: (SENTENCErec1.finiteness = infinite)
                       A1222: SENTENCErec2 := SENTENCErec1;

                 A122: SENTENCErec2.supertiempo := omegatiempo;


              A12: @

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:((SENTENCErec2.supertiempo = omegatiempo) AND
                  (((SENTENCErec2.tiempo = presente) AND
