\newpage
\begin{verbatim}
% RULE RppSuperdeixis
< m1: PREPP{PREPPrec1}[mu1] 
>

< m : PREPP{PREPPrec2}[mu1] 
>

   PARAMETERS
      <
       super : deixistype
      >

      COMP
         <
          C1: PREPPrec1.superdeixis = omegadeixis AND
              super IN [presentdeixis, pastdeixis]
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := super;
         >
      DECOMP
         <
          C1: PREPPrec2.superdeixis IN [presentdeixis, pastdeixis]
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.superdeixis := omegadeixis;
              super := PREPPrec2.superdeixis;
         >

&

\end{verbatim}
