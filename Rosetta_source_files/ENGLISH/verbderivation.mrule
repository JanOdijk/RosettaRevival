\newpage
\begin{verbatim}
% RULE Rnoundim
< m1:CN{CNrec1}[mu2, head/NOUN{NOUNrec1}[mu1],mu3] 
>

< m :CN{CNrec1}
       [ mu2,
         sig1,
         head/NOUN{NOUNrec1}[mu1],
         mu3
       ]
>

<

   SUBRULE
      <mu2: [mu4]>
      <mu2: [mu4]
       sig1:[modrel/ADJP{ADJPrec1}
             [head/ADJ{ADJrec1}
              [head/SUBADJ{SUBADJrec1}
               [head/BADJ(KEY1){BADJrec1}] 
              ] 
             ]
            ]
      >

   MATCHCONDITIONS
      <
       mu2: NOT EXIST(mu4,[../ADJP{ADJPrec2}
                               [head/ADJ{ADJrec2}
                                 [head/SUBADJ{SUBADJrec2}
                                   [head/I11::BADJ{BADJrec2}] 
                                 ] 
                               ]
                          ])
            I11: BADJrec2.key = KEY_littleBADJkey OR
                 BADJrec2.key = KEY_smallBADJkey
      >

      COMP
         <
          C1: true
          A1: KEY1 := KEY_littleBADJkey;
              SUBADJrec1 := COPYT_badjtosubadj(BADJrec1);
              SUBADJrec1.affix := noaffix;
              ADJrec1 := COPYT_subadjtoadj(SUBADJrec1);
              ADJrec1.compform := basic;
              ADJPrec1 :=
                      {
                       req:              [pospol, negpol, omegapol]
                       env:              [pospol, negpol, omegapol]
                       class:            ADJrec1.class
                       deixis:           ADJrec1.deixis
                       aspect:           ADJrec1.aspect
                       retro:            ADJrec1.retro
                       actuseefs:        ADJrec1.uses
                       temporal:         ADJrec1.temporal
                       actsubcefs:       ADJrec1.subcs
                       thetaadj:         ADJrec1.thetaadj
                       adjpatternefs:    ADJrec1.adjpatterns
                       mood:             nowh
                       coord:            nocoord
                      }
         >

(* no DECOMP *)

   SUBRULE
      <mu2: [mu4]>
      <mu2: [mu4]
       sig1:[]
      >

   MATCHCONDITIONS
      <
       mu2: EXIST(mu4,[../ADJP{ADJPrec2}
                               [head/ADJ{ADJrec2}
                                 [head/SUBADJ{SUBADJrec2}
                                   [head/I11::BADJ{BADJrec2}] 
                                 ] 
                               ]
                          ])
            I11: BADJrec2.key = KEY_littleBADJkey OR
                 BADJrec2.key = KEY_smallBADJkey
      >

      COMP
         <
          C1: true
          A1: @
         >

(* no DECOMP *)

>
&

\end{verbatim}
