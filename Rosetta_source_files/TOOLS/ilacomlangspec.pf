pragma c_include('tstring.pf');
package ilacomlangspec;
with tstring;
const
     ilacomlangspec_nrow = 10 ;
type setofchar = set of char;
type
     ilacomlangspec_int=integer;
     ilacomlangspec_bool=boolean;
     ilacomlangspec_typekindtype = (enumkind,subrangekind,setkind,boolkind,intkind);
plosstring = ^losstring;
losstring = record
   next:plosstring;
   carriage:boolean;
   arg:tstring_string
 end; 
localfile = record 
first,last:plosstring
 end; 
ilacomlangspec_typespec = record 
typename:TSTRING_string;
basetype:TSTRING_string;
basefirst:TSTRING_string;
baselast:TSTRING_string;
typekind:ilacomlangspec_typekindtype;

 end; 
plostypespec = ^lostypespec;
lostypespec = record
   next:plostypespec;
   arg:ilacomlangspec_typespec
 end; 
ilacomlangspec_setoftypespecs = record 
first,last:plostypespec
 end; 
ilacomlangspec_ident = record 
str:TSTRING_string;

 end; 
plosident = ^losident;
losident = record
   next:plosident;
   arg:ilacomlangspec_ident
 end; 
ilacomlangspec_setofidents = record 
first,last:plosident
 end; 
ilacomlangspec_param = record 
name:TSTRING_string;
typename:TSTRING_string;

 end; 
plosparam = ^losparam;
losparam = record
   next:plosparam;
   arg:ilacomlangspec_param
 end; 
ilacomlangspec_setofparams = record 
first,last:plosparam
 end; 
ilacomlangspec_rulespec = record 
rulename:TSTRING_string;
rulenr:ilacomlangspec_int;
params:ilacomlangspec_setofparams;

 end; 
plosrulespec = ^losrulespec;
losrulespec = record
   next:plosrulespec;
   arg:ilacomlangspec_rulespec
 end; 
ilacomlangspec_setofrulespecs = record 
first,last:plosrulespec
 end; 
     ilacomlangspec_pterminal = ^ilacomlangspec_terminal;
     ilacomlangspec_terminal = 
         record
                       str:tstring_string
           end;
     ilacomlangspec_puttrecord = ^ilacomlangspec_uttrecord;
     ilacomlangspec_uttrecord = 
         record
               typestable:ilacomlangspec_setoftypespecs;
               rulestable:ilacomlangspec_setofrulespecs;
           end;
     ilacomlangspec_plangrecord = ^ilacomlangspec_langrecord;
     ilacomlangspec_langrecord = 
         record
           end;
     ilacomlangspec_pilrulesrecord = ^ilacomlangspec_ilrulesrecord;
     ilacomlangspec_ilrulesrecord = 
         record
           end;
     ilacomlangspec_pilrulerecord = ^ilacomlangspec_ilrulerecord;
     ilacomlangspec_ilrulerecord = 
         record
           end;
     ilacomlangspec_pparamrecord = ^ilacomlangspec_paramrecord;
     ilacomlangspec_paramrecord = 
         record
                      str:TSTRING_string;
           end;
     ilacomlangspec_ptyperecord = ^ilacomlangspec_typerecord;
     ilacomlangspec_typerecord = 
         record
                      str:TSTRING_string;
           end;
     ilacomlangspec_ptypespecrecord = ^ilacomlangspec_typespecrecord;
     ilacomlangspec_typespecrecord = 
         record
           end;
     ilacomlangspec_ptypedefrecord = ^ilacomlangspec_typedefrecord;
     ilacomlangspec_typedefrecord = 
         record
           end;
     ilacomlangspec_penumdefrecord = ^ilacomlangspec_enumdefrecord;
     ilacomlangspec_enumdefrecord = 
         record
           end;
     ilacomlangspec_psubrandefrecord = ^ilacomlangspec_subrandefrecord;
     ilacomlangspec_subrandefrecord = 
         record
           end;
     ilacomlangspec_pintdefrecord = ^ilacomlangspec_intdefrecord;
     ilacomlangspec_intdefrecord = 
         record
           end;
     ilacomlangspec_pbooldefrecord = ^ilacomlangspec_booldefrecord;
     ilacomlangspec_booldefrecord = 
         record
           end;
     ilacomlangspec_psetdefrecord = ^ilacomlangspec_setdefrecord;
     ilacomlangspec_setdefrecord = 
         record
           end;
     ilacomlangspec_category = (comment,identifier,UTT,LANGVERSION,ILRULESspec,ILRULE,PARAMname,TYPEname,TYPESPEC,TYPEDEFINITION,
ENUMDEF,SUBRANGEDEF,INTEGERDEF,BOOLEANDEF,SETDEF,LEFTARROW,RIGHTARROW,SQUAREOPEN,SQUARECLOSE,ROUNDOPEN,ROUNDCLOSE,CURLYOPEN,
CURLYCLOSE,TYPEStje,DOT,INTEGERtje,BOOLEANtje,SETtje,OFtje,SEMICOLON,EQUIVALENT,ILRULES,LEVEL,INTERLINGUA,DEFINITION,COLON,
PARAMETERS,COMMA);

ilacomlangspec_pfielddef = ^ilacomlangspec_fielddef;
ilacomlangspec_fielddef =
         record
      case cat:ilacomlangspec_category of
                  UTT:
                     (UTTfield:ilacomlangspec_puttrecord);
                  LANGVERSION:
                     (LANGVERSIONfield:ilacomlangspec_plangrecord);
                  ILRULESspec:
                     (ILRULESspecfield:ilacomlangspec_pilrulesrecord);
                  ILRULE:
                     (ILRULEfield:ilacomlangspec_pilrulerecord);
                  PARAMname:
                     (PARAMnamefield:ilacomlangspec_pparamrecord);
                  TYPEname:
                     (TYPEnamefield:ilacomlangspec_ptyperecord);
                  TYPESPEC:
                     (TYPESPECfield:ilacomlangspec_ptypespecrecord);
                  TYPEDEFINITION:
                     (TYPEDEFINITIONfield:ilacomlangspec_ptypedefrecord);
                  ENUMDEF:
                     (ENUMDEFfield:ilacomlangspec_penumdefrecord);
                  SUBRANGEDEF:
                     (SUBRANGEDEFfield:ilacomlangspec_psubrandefrecord);
                  INTEGERDEF:
                     (INTEGERDEFfield:ilacomlangspec_pintdefrecord);
                  BOOLEANDEF:
                     (BOOLEANDEFfield:ilacomlangspec_pbooldefrecord);
                  SETDEF:
                     (SETDEFfield:ilacomlangspec_psetdefrecord);
identifier,                  LEFTARROW,
                  RIGHTARROW,
                  SQUAREOPEN,
                  SQUARECLOSE,
                  ROUNDOPEN,
                  ROUNDCLOSE,
                  CURLYOPEN,
                  CURLYCLOSE,
                  TYPEStje,
                  DOT,
                  INTEGERtje,
                  BOOLEANtje,
                  SETtje,
                  OFtje,
                  SEMICOLON,
                  EQUIVALENT,
                  ILRULES,
                  LEVEL,
                  INTERLINGUA,
                  DEFINITION,
                  COLON,
                  PARAMETERS,
                  COMMA:
                     (      terminal:ilacomlangspec_pterminal);
           end;

procedure initint(var s:integer);external;
procedure initbool(var s:boolean);external;
procedure initsetoftypespecs(var s:ilacomlangspec_setoftypespecs); external;
function stilltypespecs(var s:ilacomlangspec_setoftypespecs):boolean; external;
procedure taketypespec(var typespec1:ilacomlangspec_typespec
        ;var s:ilacomlangspec_setoftypespecs); external;
procedure appendtypespec(typespec1:ilacomlangspec_typespec
        ;var s:ilacomlangspec_setoftypespecs); external;
procedure initsetofidents(var s:ilacomlangspec_setofidents); external;
function stillidents(var s:ilacomlangspec_setofidents):boolean; external;
procedure takeident(var ident1:ilacomlangspec_ident
        ;var s:ilacomlangspec_setofidents); external;
procedure appendident(ident1:ilacomlangspec_ident
        ;var s:ilacomlangspec_setofidents); external;
procedure initsetofparams(var s:ilacomlangspec_setofparams); external;
function stillparams(var s:ilacomlangspec_setofparams):boolean; external;
procedure takeparam(var param1:ilacomlangspec_param
        ;var s:ilacomlangspec_setofparams); external;
procedure appendparam(param1:ilacomlangspec_param
        ;var s:ilacomlangspec_setofparams); external;
procedure initsetofrulespecs(var s:ilacomlangspec_setofrulespecs); external;
function stillrulespecs(var s:ilacomlangspec_setofrulespecs):boolean; external;
procedure takerulespec(var rulespec1:ilacomlangspec_rulespec
        ;var s:ilacomlangspec_setofrulespecs); external;
procedure appendrulespec(rulespec1:ilacomlangspec_rulespec
        ;var s:ilacomlangspec_setofrulespecs); external;
 function ilacomlangspec_scanchars:setofchar;
         external;
 procedure ilacomlangspec_init; external;
 procedure ilacomlangspec_word(i:integer;var s:tstring_string);
         external;
 function ilacomlangspec_wcat(i:integer):ilacomlangspec_category;
         external;
 function ilacomlangspec_scat(c:char):ilacomlangspec_category;
         external;
 procedure ilacomlangspec_createterm(s:ilacomlangspec_category;
           w:tstring_string;var f:ilacomlangspec_fielddef);
         external;
end{langspec};
