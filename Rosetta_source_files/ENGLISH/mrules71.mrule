\begin{verbatim}
%
% RULE Rinfinpastdeixisspec
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3: mu2,
                    I2: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3: mu2,
                    auxrel/VERB{VERBrec3}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(AUX_havebverbkey){BVERBrec1}
                               ] 
                          ],
                    I2: rel1/VERB{VERBrec2}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST (mu5, [tempadvrel/..])
       I2: (rel1 IN [head, passauxrel, progauxrel])
       I3: NOT EXIST (mu2, [auxrel/..])
      >

<
   SUBRULE (*1: ADVPVAR *)
      <mu5 : [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I3: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.deixis = pastdeixis)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus)
            )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis) 
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = pastdeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modus = participle) AND
              (VERBrec2.tense = omegatense) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
                     {
                      numbers   : []
                      persons   : []
                      modus     : omegamodus
                      tense     : omegatense
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.superdeixis = omegadeixis)
             A11: CLAUSErec1 := CLAUSErec2;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.superdeixis = omegadeixis)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := pastdeixis;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis;
         >

   SUBRULE (*2: PREPPVAR*)
      <mu5 : [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I3: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.deixis = pastdeixis)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus)
            )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = pastdeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modus = participle) AND
              (VERBrec2.tense = omegatense) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
                     {
                      numbers   : []
                      persons   : []
                      modus     : omegamodus
                      tense     : omegatense
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.superdeixis = omegadeixis)
             A11: CLAUSErec1 := CLAUSErec2;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.superdeixis = omegadeixis)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := pastdeixis;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis;
         >


   SUBRULE (*3: SENTENCE*)
      <mu5 : [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5 : [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I3: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjdeixis = pastdeixis)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus)
            )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = pastdeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modus = participle) AND
              (VERBrec2.tense = omegatense) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
                     {
                      numbers   : []
                      persons   : []
                      modus     : omegamodus
                      tense     : omegatense
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.superdeixis = omegadeixis)
             A11: CLAUSErec1 := CLAUSErec2;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.superdeixis = omegadeixis)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := pastdeixis;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis;
         >

>
&
\end{verbatim}

\newpage
\begin{description}
\item[* name:] Rinfinpastdeixisspec
\item[* relevant examples:] He believes (him to have bought a car yesterday)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 28-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:]Rinfinpastdeixisspec Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a infinite independent clause. This
               is a special rule,because past is expressed by the auxiliary 
               verb {\em have}. 
               The most left verb in the clause (input generative rule)
gets modus past participle.
The auxiliary verb {\em have
} is introduced with an omega tense.
               The deixis 
value of the reference adverbial is checked for 
               past.
               The clause is marked for past deixis.
\item[\ \ strategy:] No other auxiliaries are allowed to the left of {\em have}
; if they are present, this rule will be applied in the next cycle (
analytically spoken).
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different (variable) categories for the reference 
adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial, perfective aspect rule \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: This rule has the same semantics as 
Rfinpastdeixis.\\

\item in other languages: \\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be pastdeixis in the case 
this sentence is a sentence with something like {\em graag} in Dutch or an 
auxiliary verb that is semantically a head and treated as a basic expression.\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rimpdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2
                   ],
            mu3
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2
                   ],
            mu3
           ] 

>


<
   SUBRULE
      <mu3: [I1: mu4]>
      <mu3: [I1: mu4]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu4)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.superdeixis = omegadeixis) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.modus = omegamodus)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.modus := imperative;
              CLAUSErec2.deixis := presentdeixis
         >

      DECOMP
         <
          C1:((CLAUSErec2.deixis = presentdeixis) AND
              (CLAUSErec2.superdeixis = omegadeixis) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.modus = imperative) 
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis          
         >

   SUBRULE
      <mu3:[mu4, I1: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu5]>
      <mu3:[mu4, I1: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu5]>

   MATCHCONDITIONS
      <
       I1: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           ((ADVPVARrec1.deixis = presentdeixis) OR
            (ADVPVARrec1.deixis = omegadeixis) OR
            (ADVPVARrec1.deixis = futuredeixis)
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.superdeixis = omegadeixis) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.modus = omegamodus)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.modus := imperative;
              CLAUSErec2.deixis := presentdeixis
         >

      DECOMP
         <
          C1:((CLAUSErec2.deixis = presentdeixis) AND
              (CLAUSErec2.superdeixis = omegadeixis) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.modus = imperative) 
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis          
         >

   SUBRULE
      <mu3:[mu4, I1: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu5]>
      <mu3:[mu4, I1: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu5]>

   MATCHCONDITIONS
      <
       I1: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           ((PREPPVARrec1.deixis = presentdeixis) OR
            (PREPPVARrec1.deixis = omegadeixis) OR
            (PREPPVARrec1.deixis = futuredeixis)
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.superdeixis = omegadeixis) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.modus = omegamodus)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.modus := imperative;
              CLAUSErec2.deixis := presentdeixis
         >

      DECOMP
         <
          C1:((CLAUSErec2.deixis = presentdeixis) AND
              (CLAUSErec2.superdeixis = omegadeixis) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.modus = imperative) 
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis          
         >

   SUBRULE
      <mu3:[mu4, I1: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu5]>
      <mu3:[mu4, I1: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu5]>

   MATCHCONDITIONS
      <
       I1: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           ((SENTENCErec1.conjdeixis = presentdeixis) OR
            (SENTENCErec1.conjdeixis = omegadeixis) OR
            (SENTENCErec1.conjdeixis = futuredeixis)
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.superdeixis = omegadeixis) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.modus = omegamodus)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.modus := imperative;
              CLAUSErec2.deixis := presentdeixis
         >

      DECOMP
         <
          C1:((CLAUSErec2.deixis = presentdeixis) AND
              (CLAUSErec2.superdeixis = omegadeixis) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.modus = imperative) 
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.deixis := omegadeixis          
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rimpdeixis
\item[* relevant examples:] Come (tomorrow)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 30-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rimpdeixis Dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 07/07/88\ \ \ \ \ author: Margreet and Jan O.\\
Deixis of the clause is set to presentdeixis, to agree with REFdeletion (same 
as in Dutch)
\item date: 19/05/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on futuredeixis adverbial.
\end{enumerate}
\item[* task:] The relation between S and Rs is not relevant.
               This rule is for a finite independent (main) clause that will 
get mood {\em imperativemood  or letsmood} in the mood rules..
               The deixis 
value of the reference adverbial is checked for 
               present, future or omega.
               The clause is not marked for deixis.
               The clause is marked with modus = imperative.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of (the variables for) the 
possible reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: Maybe the deixis value of the reference value should not be 
presentdeixis in English but `future deixis'. The same problems as with future 
tense.\\

\item modifications: \\
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}

% RULE Rfinirrmodaldeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                I1:[mu2,
                    rel1/VERB{VERBrec1}
                        [head/SUBVERB{SUBVERBrec1}
                             [I2:head/BVERB(KEY1){BVERBrec1}]
                        ],
                     mu3
                   ],
            mu4,
            tempadvrel/T1,
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
               I1:[mu2,
                    rel1/VERB{VERBrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I3:head/BVERB(KEY2){BVERBrec1}]
                        ],
                     mu3
                   ],
            mu4,
            tempadvrel/T1,
            mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: LEFTTORIGHT
       I2: KEY1 = KEY_can1BVERBkey OR
           KEY1 = KEY_can2BVERBkey OR
           KEY1 = KEY_must1BVERBkey OR
           KEY1 = KEY_must2BVERBkey 
       I3: KEY2 = KEY_can1BVERBkey OR
           KEY2 = KEY_can2BVERBkey OR
           KEY2 = KEY_shallbverbkey OR
           KEY2 = KEY_should2BVERBkey 

      >

<
   SUBRULE (*1: ADVPVAR*)
      <T1: ADVPVAR{ADVPVARrec1}[ ]>
      <T1: ADVPVAR{ADVPVARrec1}[ ]>

      COMP
         <
          C1:((ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false) AND
              (ADVPVARrec1.deixis = pastdeixis) AND
              (CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (VERBrec1.tense = omegatense) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = finite) 
             )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
                 C111: KEY1 = KEY_can1BVERBkey OR
                       KEY1 = KEY_can2BVERBkey
                 A111: KEY2 := KEY1;
                       SUBVERBrec2 := SUBVERBrec1;
                       VERBrec2 := VERBrec1;
                       VERBrec2.tense := pasttense;

                 C112: KEY1 = KEY_must1BVERBkey
                 A112: KEY2 := KEY_shallbverbkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;

                 C113: KEY1 = KEY_must2BVERBkey
                 A113: KEY2 := KEY_should2BVERBkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;
                      
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.superdeixis = pastdeixis) (* geval graag *)
                 C121: KEY1 = KEY_can1BVERBkey OR
                       KEY1 = KEY_can2BVERBkey
                 A121: KEY2 := KEY1;
                       SUBVERBrec2 := SUBVERBrec1;
                       VERBrec2 := VERBrec1;
                       VERBrec2.tense := pasttense;

                 C122: KEY1 = KEY_must1BVERBkey
                 A122: KEY2 := KEY_shallbverbkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;

                 C123: KEY1 = KEY_must2BVERBkey
                 A123: KEY2 := KEY_should2BVERBkey;
                       SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec1);
                       VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
                       VERBrec2.tense := pasttense;
                      
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
             
         >
      DECOMP
         <
          C1:((ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false) AND
              (ADVPVARrec1.deixis = pastdeixis) AND
              (CLAUSErec2.deixis = pastdeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = finite) AND
              (VERBrec2.tense = pasttense)
             )
              
              (* other values: default values *)
             C11: (CLAUSErec2.superdeixis = omegadeixis)

                  C111: KEY2 = KEY_can1BVERBkey OR
                        KEY2 = KEY_can2BVERBkey
                  A111: KEY1 := KEY2;
                        SUBVERBrec1 := SUBVERBrec2;
                        VERBrec1 := VERBrec2;
                        VERBrec1.tense := omegatense;
 
                  C112: KEY2 = KEY_shallbverbkey
                  A112: KEY1 := KEY_must1BVERBkey;
                        SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                        VERBrec1 := COPYT_subverbtoverb(SUBVERBrec2);

                  C113: KEY2 = KEY_should2BVERBkey
                  A113: KEY1 := KEY_must2BVERBkey;
                        SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                        VERBrec1 := COPYT_subverbtoverb(SUBVERBrec2);
                 
            A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.superdeixis = omegadeixis)
                  C121: KEY2 = KEY_can1BVERBkey OR
                        KEY2 = KEY_can2BVERBkey
                  A121: KEY1 := KEY2;
                        SUBVERBrec1 := SUBVERBrec2;
                        VERBrec1 := VERBrec2;
                        VERBrec1.tense := omegatense;
 
                  C122: KEY2 = KEY_shallbverbkey
                  A122: KEY1 := KEY_must1BVERBkey;
                        SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                        VERBrec1 := COPYT_subverbtoverb(SUBVERBrec2);

                  C123: KEY2 = KEY_should2BVERBkey
                  A123: KEY1 := KEY_must2BVERBkey;
                        SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                        VERBrec1 := COPYT_subverbtoverb(SUBVERBrec2);

             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := pastdeixis;

          A1: CLAUSErec1.deixis := omegadeixis;
         >


   SUBRULE (*2: PREPPVAR*)
