\begin{verbatim}
% RULE RcoorditS
< m1:SENTENCE{SENTENCErec1}[I1:mu1, head/COORD{COORDrec1}, mu2]
  m2:SENTENCE{SENTENCErec2}[mu3] 
>

< m : SENTENCE{SENTENCErec1}
           [ argrel/SENTENCE{SENTENCErec2}[mu3],
             puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1},
             I1:mu1, head/COORD{COORDrec1}, mu2]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1, [head/COORD{}])
      >

      COMP
         <
          C1:  SENTENCErec1 =
                 {
                   mood       : SENTENCErec2.mood
                   senttype   : SENTENCErec2.senttype
                   PROsubject : SENTENCErec2.PROsubject
                   modus      : SENTENCErec2.modus
                   finiteness : SENTENCErec2.finiteness
                   infsort    : SENTENCErec2.infsort
                   superdeixis: SENTENCErec2.superdeixis
                   adverbial  : SENTENCErec2.adverbial
                   temporal   : SENTENCErec2.temporal
                 }
          A1: @
         >
      DECOMP
         <
          C1:  SENTENCErec1 =
                 {
                   mood       : SENTENCErec2.mood
                   senttype   : SENTENCErec2.senttype
                   PROsubject : SENTENCErec2.PROsubject
                   modus      : SENTENCErec2.modus
                   finiteness : SENTENCErec2.finiteness
                   infsort    : SENTENCErec2.infsort
                   superdeixis: SENTENCErec2.superdeixis
                   adverbial  : SENTENCErec2.adverbial
                   temporal   : SENTENCErec2.temporal
                 }
          A1: @
         >


&

\end{verbatim}
