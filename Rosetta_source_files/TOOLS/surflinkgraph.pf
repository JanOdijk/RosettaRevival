pragma C_include ('surflinklangspec.pf');
pragma C_include ('surflinkdecl.pf');

PACKAGE surflinkGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH surflinkDECL,
     surflinkLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: surflinkLANGSPEC_Category;
                          b: surflinkDECL_nodeid): surflinkDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: surflinkDECL_psurfgraph): surflinkDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: surflinkDECL_psurfgraph): surflinkDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: surflinkDECL_psurfgraph): surflinkDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: surflinkDECL_psurfgraph): surflinkDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: surflinkLANGSPEC_Category; 
                          c: surflinkDECL_psurfgraph); EXTERNAL;
 
END {surflinkGRAPH};
