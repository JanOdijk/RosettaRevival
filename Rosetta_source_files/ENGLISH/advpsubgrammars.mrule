\newpage
\begin{verbatim}

% RULE RSubadjToSubadv
< m1: BADVSUFF(KEY_lyBADVSUFFkey){BADVSUFFrec1}
  m2: I1::SUBADJ{SUBADJrec1}[mu1]
>

< m : SUBADV{SUBADVrec1}
            [ complrel/I1::SUBADJ{SUBADJrec1}[mu1],
              head/BADVSUFF(KEY_lyBADVSUFFkey){BADVSUFFrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: SUBADJrec1.advformation <> noAdv
      >

      COMP
         <
          C1: true
            C11: SUBADJrec1.compformations <> [noComp]
            A11: SUBADVrec1.compformations := [moreComp]
            C12: SUBADJrec1.compformations = [noComp]
            A12: SUBADVrec1.compformations := [noComp]
          A1: SUBADVrec1 := { affix       : lyaffix
                              req         : SUBADJrec1.req
                              env         : SUBADJrec1.env
                              class       : SUBADJrec1.class
                              deixis      : SUBADJrec1.deixis
                              aspect      : SUBADJrec1.aspect
                              retro       : SUBADJrec1.retro
                              thetaadv    : BADVSUFFrec1.thetaadv
                              advpatterns : BADVSUFFrec1.advpatterns
                              position    : BADVSUFFrec1.position
                              subcs       : BADVSUFFrec1.subcs
                              mood        : BADVSUFFrec1.mood
                              prepkey     : BADVSUFFrec1.prepkey
                              thanas      : BADVSUFFrec1.thanas
                              possnietnp  : BADVSUFFrec1.possnietnp
                              temporal    : BADVSUFFrec1.temporal }
         >

      DECOMP
         <
          C1: SUBADVrec1  = { affix       : lyaffix
                              req         : SUBADJrec1.req
                              env         : SUBADJrec1.env
                              class       : SUBADJrec1.class
                              deixis      : SUBADJrec1.deixis
                              aspect      : SUBADJrec1.aspect
                              retro       : SUBADJrec1.retro
                              thetaadv    : BADVSUFFrec1.thetaadv
                              advpatterns : BADVSUFFrec1.advpatterns
                              position    : BADVSUFFrec1.position
                              subcs       : BADVSUFFrec1.subcs
                              mood        : BADVSUFFrec1.mood
                              prepkey     : BADVSUFFrec1.prepkey
                              thanas      : BADVSUFFrec1.thanas
                              possnietnp  : BADVSUFFrec1.possnietnp
                              temporal    : BADVSUFFrec1.temporal }
            C11: SUBADVrec1.compformations = [moreComp] AND
                 SUBADJrec1.compformations <> [noComp]
            A11: @
            C12: SUBADVrec1.compformations = [noComp] AND
                 SUBADJrec1.compformations = [noComp]
            A12: @
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RSubadjToSubadv
\item[* relevant examples:] happy $\rightarrow$ happily; loud $\rightarrow$ 
loudly
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] AdvDerivation
\item[* class:] (name of rule, transformation or filter class) 
\item[* date of creation:] 17-OCT-1988
\item[* author:] margreet sanders
\item[* copied from:] RlocalSubAdjToSubAdv (with modifications)
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to make ADVs out of ADJs for those cases in which the adv is 
not in the dictionary
\item[\ \ strategy:] (also: deviations from accepted proposals) 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\
It is assumed that the lyBADVSUFF has been provided with all relevant 
attribute values in the dictionary. The following values are implemented:\\
thetaadv : advp120\\
subcs    : agvpadv\\
advpatterns : [synVERBPPROP]\\
position : [1,2,3,4] (=default)\\
temporal : false\\
other attributes: default (prepkey, thanas, possnietnp)\\
\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:] For the moment, it is assumed that 
adverbs formed by derivation are subject-oriented (agvpadv), and therefore have 
advp120. Probably, they may also be vpadv (advp100), depending on the subject 
the ADJ used to go with (semantic criterion: 
an ADJ that can be used to modify an animate noun is agvpadv, an ADJ modifying 
an inanimate noun will become vpadv: a heavy man $\rightarrow$ x1 to walk (x1 
heavily; a loud conversation $\rightarrow$ x1 to talk loudly). Since there is 
no way to specify this yet, a choice is made for the agvpadv case. It seems
as if sentAdvs are less frequently formed by regular derivation (examples:
lucky $\rightarrow$ luckily; accidental(?) $\rightarrow$ accidentally). Finally,
it is assumed that derived advs never are temporal (late $\rightarrow$ 
$^{*}$lately). The correct value for {\em position\/} has not been decided yet;
it is filled with the default value for the moment.

Another point is the assumption of synVERBPPROP for the advpatterns. If relation
with the subject (agvpadv) is to be checked, the  subject must preferably be 
in its canonical position and must not have been substituted for ({\em Er werd 
enthousiast geklapt\/}: relation between `enthousiast' and the subject variable, 
, not an EMPTY), suggesting an early introduction. However, the wide scope 
adverbials have seems to favour a later introduction, not depending on the 
subject at all. In that case, a synCLAUSE is more appropriate. For the moment, 
a choice is made for the early introduction.

Finally, the compformations have been decided on more ore less semantic grounds:
if an adj cannot form a comparative, this will usually be for semantic reasons
(whole $\rightarrow$ $^{*}$more whole) and therefore the adv probably will not 
have a comparative either ($^{*}$more wholly). In all other cases, regularly 
derived advs are assumed to have [moreComp].
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
See above
\item modifications:\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}

%SUBGRAMMAR ADVPformation
(* highest number used: 21 *)

   (* RC_StartAdvpRules *)
( RstartADVP0/1   | RstartADVP1/2  )
.
   (* TC_AdvpPatterns *)
( TADVPpattern0/3 | TADVPpattern1/4 ) 
.
   (* RC_AdvpSuperdeixis *)
( RADVPsuperdeixis/5 )

(* Modification rules *)

. [ RADVPdegreemod1/13 | RADVPdegreemod2/14 | RADVPdegreemod3/15 ]
(* = degreemodification of temporal ADVPs *)

. [ RADVPCOMPARISONcomplmod/16 ] 

. [ TADVPAccCaseAssignment/21 ]

. [ RADVPinfcomplmod/9 ]
(* cf. mrules65 *)

. [ RADVPforobjmod/10 ] 
(* cf. mrules65 *)
 
. { TADVmoreTOer/8} . FpostADVmoreTOer/9


   (* RC_AdvpSubst *)

. { RADVPsubst1/6 | (* RADVPsubst2/7 | *) RADVPsubst3/16 | RADVPsubst4/17 }

. [ RADVPamountmod/12 ]
(* = degreemodification of non-temporal ADVPs zonder complementen *)
(* cf. mrules65 *)

. [TADVQPhopping1/18 | TADVQPhopping2/19 ] . FpostADVQPhopping/20

HEAD:
<
SUBADV FROM (ADVderivation)
>

(* IMPORT: *)
<
 2: < ARGUMENT 2      NPVAR     BASIC EXPRESSION   >
 6: < ARGUMENT 2      NP        FROM (NPformation) >
 7: < ARGUMENT 2      NP        FROM (NPformation) >
13: < ARGUMENT 2      QP        FROM (QPformation) >
13: < ARGUMENT 2      ADVP      FROM (ADVPformation) >
14: < ARGUMENT 2      QP        FROM (QPformation) >
15: < ARGUMENT 2      ADVP      FROM (ADVPformation) >
16: < ARGUMENT 2      ADVP      FROM (ADVPformation) >

>

EXPORT:
< ADVP >

&

\end{verbatim}
\newpage
\begin{verbatim}

% RULE RstartADVP0
< m1: SUBADV{SUBADVrec1}[mu1] 
>

< m : ADVP{ADVPrec1}
          [ head/ADV{ADVrec1}
                [ head/SUBADV{SUBADVrec1}[mu1]] 
          ]
>


      COMP
         <
          C1: SUBADVrec1.thetaadv = advp100
          A1: ADVrec1 := COPYT_subadvTOadv(SUBADVrec1);
              ADVrec1.compform := basic;
              ADVPrec1 := COPYT_advTOadvp(ADVrec1); 
              (* superdeixis, thanascompl, advpatternefs:
                 default values *)
              ADVPrec1.actsubcefs := ADVrec1.subcs;
         >
      DECOMP
         <
          C1: SUBADVrec1.thetaadv = advp100 AND
              ADVrec1 = COPYT_subadvTOadv(SUBADVrec1) AND
              ADVrec1.compform = basic AND
              ADVPrec1 = COPYT_advTOadvp(ADVrec1) AND
              ADVPrec1 = { advpatternefs : []
                           superdeixis   : omegadeixis
                           thanascompl   : false } AND
              ADVPrec1.actsubcefs * ADVrec1.subcs <> []       (*!!!!*)
          A1: @
         >
&

\end{verbatim}
