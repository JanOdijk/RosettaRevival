\begin{verbatim}
(* uitgezet *) 
% RULE RNOUNargmod2
< m1: CN{CNrec1}[
                 head/I1::NOUN{NOUNrec1}[mu2]
                ] 
  m2: SENTENCEVAR{SENTENCEVARrec1}
>

< m : CN{CNrec1}[
                 head/I1::NOUN{NOUNrec1}[mu2],
                 complrel/VARPREPP{VARPREPPrec1}
                          [head/PREP(KEY_deprepkey){PREPrec1},
                           complrel/SENTENCEVAR{SENTENCEVARrec1}
                          ]
                ]
>

   MATCHCONDITIONS
      <
       I1: NOUNrec1.nounpatterns * [synQSENT, synQUESENTsubj] <> [] 
      >

      COMP
         <
          C1: true
            C11: synQUESENTind IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: declarative
                                     modo: indicativo
                                    }
            A11: @
            C12: synQUESENTsubj IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: declarative
                                     modo: subjuntivo
                                    }
            A12: @
            C13: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: whinterrogative
                                    }

            A13: @
            C14: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: yesnointerrogative
                                    }

            A14: @

          A1: @
         >
      DECOMP
         <
          C1: true
            C11: synQUESENTind IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: declarative
                                     modo: indicativo
                                    }
            A11: @
            C12: synQUESENTsubj IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: declarative
                                     modo: subjuntivo
                                    }
            A12: @
            C13: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: whinterrogative
                                    }

            A13: @
            C14: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: yesnointerrogative
                                    }

            A14: @

          A1: @
         >

&

\end{verbatim}
