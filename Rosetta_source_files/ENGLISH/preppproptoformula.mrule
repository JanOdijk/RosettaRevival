\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RPPPsuperdeixis
< m1: PREPPFORMULA{PREPPFORMULArec1}[mu1] 
>

< m : PREPPFORMULA{PREPPFORMULArec2}[mu1] 
>

   PARAMETERS
      <
       superpar : deixistype
      >

      COMP
         <
          C1: PREPPFORMULArec1.superdeixis = omegadeixis AND
              superpar IN [presentdeixis, pastdeixis]
          A1: PREPPFORMULArec2 := PREPPFORMULArec1;
              PREPPFORMULArec2.superdeixis := superpar;
         >
      DECOMP
         <
          C1: PREPPFORMULArec2.superdeixis IN [presentdeixis, pastdeixis]
          A1: PREPPFORMULArec1 := PREPPFORMULArec2;
              PREPPFORMULArec1.superdeixis := omegadeixis;
              superpar := PREPPFORMULArec2.superdeixis;
         >

&

\end{verbatim}
