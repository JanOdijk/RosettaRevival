      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)             
          A1: @
         >
   

   SUBRULE  (* te + deletion of ti; masc. *)
      <mu7: [I11:mu11]>

   MATCHCONDITIONS
