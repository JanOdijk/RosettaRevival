 *  Remarks         :  this scanner yields for each surface rule a sequence of 
 *                     tokens, representing the terminals of the regular 
 *                     expression; the remainder of the rule is simply copied
 *                     but for a few replacements, done in the function 
 *                     transduce (see doc. R0164).
 *
 *EMP:::===================================================================*)

pragma C_include('surcomdecl.pf');

PACKAGE surcomscanner;
WITH surcomdecl;
(*MPF:::===================================================================*
 *
 *  Procedure Name  : scanner 
 *  Description     : 
 *  Parameters      : 
 *  Precondition    : if1 contains a number of surface rules
 *  Postcondition   : if2 contains the token sequence for the first surface
 *                    rule encountered, of1 the text following the regular
 *                    expression of this rule, which is essentially copied from
 *                    if1, but for a few substitutions.
 *
 *EMP:::===================================================================*)

PROCEDURE SURCOMSCANNER_body(var if1:text;var rulenaam:SURCOMDECL_string;
				var if2:SURCOMDECL_pconnectionnode;var of1:text); EXTERNAL;

END;

