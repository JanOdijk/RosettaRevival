%LANGVERSION
BASIS RULE
  LANGVERSION = LANGUAGE/2 . COLON/2 . IDENTIFIER/1 

SURFACE PART
HELP FUNCTION CheckLanguage(str:TSTRING_String):BOOLEAN;
     BEGIN
       IF (str='DUTCH') OR (str='ENGLISH') OR (str='SPANISH') 
                   THEN CheckLanguage:=TRUE
                   ELSE CheckLanguage:=FALSE;
     END;     

<*
  INIT:BEGIN
       END;
1:     <*
        LOCALCONDITION:CheckLanguage(%.str)
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_LANGVERSION;
                END
*>
END;

PROCEDURAL PART
VAR language : TSTRING_string;
BEGIN
INIT: BEGIN 
      END;
<*
1: <* SEND: BEGIN
              language:=%.str;
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN
        $$LANGVERSION.language:=language;
      END
END;
&

%RULESTRANS
BASIS RULE
  RULESTRANS = RULE/1.TRANSLATION/1.LEFTARROW/1 . {RULETRANS/2} . RIGHTARROW/1

SURFACE PART

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN 
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_RULESTRANS;
                END
*>
END;

PROCEDURAL PART
VAR 
   rightpresent,leftpresent::bool;
   rightsimples,leftsimples::setofsimples;
   intequals,leftcopy,rightcopy,anfile,genfile,helpfile:LOCALFILE;
   ilrulenr,mrulenr::int;
   helpcodes,leftnumcodes,rightnumcodes,numcodes::setofnumcodes;
   numcode::numcode;
   pairsets::setofpairsets;
HELP PROCEDURE MERGEleftnumcode(numcode::numcode);
     VAR table::setofnumcodes;
         numcode1::numcode;
         found::bool;
     BEGIN
     table:=leftnumcodes;
     found:=false;
     WHILE stillnumcodes(table) and not found DO
       BEGIN
       takenumcode(numcode1,table);
       IF numcode1.num=numcode.num THEN found:=true
       END;
     IF not found then appendnumcode(numcode,leftnumcodes)
     ELSE
       BEGIN
       table:=leftnumcodes;
       initsetofnumcodes(leftnumcodes);
       WHILE stillnumcodes(table) DO
         BEGIN
         takenumcode(numcode1,table);
         IF numcode1.num=numcode.num THEN
           BEGIN
           appendlocfile(numcode.code,numcode1.code);
           END;
         appendnumcode(numcode1,leftnumcodes);
         END;
       END;
     END;
PROCEDURE MERGErightnumcode(numcode::numcode);
     VAR table::setofnumcodes;
         numcode1::numcode;
         found::bool;
     BEGIN
     table:=rightnumcodes;
     found:=false;
     WHILE stillnumcodes(table) and not found DO
       BEGIN
       takenumcode(numcode1,table);
       IF numcode1.num=numcode.num THEN found:=true
       END;
     IF not found then appendnumcode(numcode,rightnumcodes)
     ELSE
       BEGIN
       table:=rightnumcodes;
       initsetofnumcodes(rightnumcodes);
       WHILE stillnumcodes(table) DO
         BEGIN
         takenumcode(numcode1,table);
         IF numcode1.num=numcode.num THEN
           BEGIN
           appendlocfile(numcode.code,numcode1.code);
           END;
         appendnumcode(numcode1,rightnumcodes);
         END;
       END;
     END;
BEGIN
INIT: BEGIN initlocalfile(anfile);
            initlocalfile(genfile);
            initlocalfile(intequals);
            initsetofnumcodes(rightnumcodes);
            initsetofnumcodes(leftnumcodes);
            pairsets:=$$RULESTRANS.pairsets;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN %%RULETRANS.pairsets:=pairsets END
      !RULETRANS.
      RECEIVE: BEGIN
              appendlocfile(%%RULETRANS.intequals,intequals);
              leftpresent:=%RULETRANS.leftpresent;
              rightpresent:=%RULETRANS.rightpresent;
              IF leftpresent THEN
                BEGIN
                numcodes:=%%RULETRANS.leftnumcodes;
                WHILE stillnumcodes(numcodes) DO
                  BEGIN
                  takenumcode(numcode,numcodes);
                  mergeleftnumcode(numcode);
                  END;
                END;
              IF rightpresent THEN
                BEGIN
                numcodes:=%%RULETRANS.rightnumcodes;
                WHILE stillnumcodes(numcodes) DO
                  BEGIN
                  takenumcode(numcode,numcodes);
                  mergerightnumcode(numcode);
                  END;
                END;
            END;
   *>
*>
FINAL:BEGIN \genfile.\LOCAL.
            helpcodes:=leftnumcodes;
            "IF R IN [0..254] THEN"\\
            helpcodes:=leftnumcodes;
            "CASE R OF"\\
             WHILE stillnumcodes(helpcodes) DO
               BEGIN
               takenumcode(numcode,helpcodes);
               IF numcode.num<=254 THEN
                 BEGIN
                 """numcode.num""" " :BEGIN"\\
                 appendlocfile(numcode.code,genfile);
                 " END;"\\
                 END;
               END;
             "END;{CASE}"\\
            "R:=R-254;"\\
            helpcodes:=leftnumcodes;
            "IF R >0 THEN IF R<=254 THEN"\\
            helpcodes:=leftnumcodes;
            "CASE R OF"\\
            "0: BEGIN END;"\\{omdat de case niet leeg mag zijn}
             WHILE stillnumcodes(helpcodes) DO
               BEGIN
               takenumcode(numcode,helpcodes);
               IF numcode.num>254 THEN IF numcode.num<=508 THEN
                 BEGIN
                 """numcode.num-254""" " :BEGIN"\\
                 appendlocfile(numcode.code,genfile);
                 " END;"\\
                 END;
               END;
             "END;{CASE}"\\
            "R:=R-254;"\\
            helpcodes:=leftnumcodes;
            "IF R >0 THEN"\\
            helpcodes:=leftnumcodes;
            "CASE R OF"\\
            "0: BEGIN END;"\\{omdat de case niet leeg mag zijn}
             WHILE stillnumcodes(helpcodes) DO
               BEGIN
               takenumcode(numcode,helpcodes);
               IF numcode.num>762 THEN 
                  writeln('total number of rules exceeded, WARN Rene');
               IF numcode.num>508 THEN
                 BEGIN
                 """numcode.num-508""" " :BEGIN"\\
                 appendlocfile(numcode.code,genfile);
                 " END;"\\
                 END;
               END;
             "END;{CASE}"\\
            \anfile.\LOCAL. 
            helpcodes:=rightnumcodes;
            "IF R IN [0..254] THEN"\\
            helpcodes:=rightnumcodes;
            "CASE R OF"\\
             WHILE stillnumcodes(helpcodes) DO
               BEGIN
               takenumcode(numcode,helpcodes);
               IF numcode.num<=254 THEN
                 BEGIN
                 """numcode.num""" " :BEGIN"\\
                 appendlocfile(numcode.code,anfile);
                 " END;"\\
                 END;
               END;
            "END;{CASE}"\\
            "R:=R-254;"\\
            helpcodes:=rightnumcodes;
            "IF R >0 THEN IF R<=254 THEN"\\
            helpcodes:=rightnumcodes;
            "CASE R OF"\\
            "0: BEGIN END;"\\{omdat de case niet leeg mag zijn}
             WHILE stillnumcodes(helpcodes) DO
               BEGIN
               takenumcode(numcode,helpcodes);
               IF numcode.num>254 THEN IF numcode.num<=508 THEN
                 BEGIN
                 """numcode.num-254""" " :BEGIN"\\
                 appendlocfile(numcode.code,anfile);
                 " END;"\\
                 END;
               END;
            "END;{CASE}"\\
            "R:=R-254;"\\
            helpcodes:=rightnumcodes;
            "IF R >0 THEN"\\
            helpcodes:=rightnumcodes;
            "CASE R OF"\\
            "0: BEGIN END;"\\{omdat de case niet leeg mag zijn}
             WHILE stillnumcodes(helpcodes) DO
               BEGIN
               takenumcode(numcode,helpcodes);
               IF numcode.num>762 THEN 
                  writeln('total number of rules exceeded, WARN Rene');
               IF numcode.num>508 THEN
                 BEGIN
                 """numcode.num-508""" " :BEGIN"\\
                 appendlocfile(numcode.code,anfile);
                 " END;"\\
                 END;
               END;
            "END;{CASE}"\\
            $$RULESTRANS.intequals:=intequals;
            $$RULESTRANS.genfile:=genfile;
            $$RULESTRANS.anfile:=anfile;
      END
END;
&


%RULETRANS
BASIS RULE
  RULETRANS = MRULENAME/2.[CURLYOPEN/1.{ANDCOND/6}.CURLYCLOSE/1].
              {(COMMA/8|BAR/8).MRULENAME/2.[CURLYOPEN/1.{ANDCOND/6}.CURLYCLOSE/1]}.
                     [LEFTARROW/4].DASH/1.[RIGHTARROW/5].
              ILRULENAME/3.[CURLYOPEN/1.{ANDCOND/7}.CURLYCLOSE/1].
              {(COMMA/9|BAR/9).ILRULENAME/3.[CURLYOPEN/1.{ANDCOND/7}.CURLYCLOSE/1]}.
              [[COLON/1].(SBONUS/10|WBONUS/11).[DASH/12|PLUS/13].IDENTIFIER/14]
SURFACE PART
VAR leftpresent,rightpresent,leftsimple,rightsimple::bool;
    str:TSTRING_string;
    len:STRING_range;
    str1:STRING(5);
    minus::bool;
    sbonuspres,wbonuspres::bool;
    sbonusval,wbonusval::int;

<*
 INIT:BEGIN leftpresent:=false;
            rightpresent:=false;
            leftsimple:=true;
            rightsimple:=true;
            wbonuspres:=false;
            sbonuspres:=false;
            wbonusval:=0;
            sbonusval:=0;
            minus:=false;
      END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN str:=%MRULENAME.str
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN leftpresent:=true;
                                IF not leftsimple THEN
      writeln('left hand side of translation of Mrules including ',str,' not simple');
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN rightpresent:=true;
                          END
       *>
6:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN leftsimple:=leftsimple AND %ANDCOND.simple
                          END
       *>
7:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN rightsimple:=rightsimple AND %ANDCOND.simple;
                                IF rightpresent and (not rightsimple) THEN
         writeln('right hand side of translation of Mrule ',str,' not simple');
                          END
       *>
8:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
9:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
10:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN sbonuspres:=TRUE
                          END
       *>
11:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN wbonuspres:=TRUE
                          END
       *>
12:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN minus:=TRUE
                          END
       *>
13:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
14:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          IF sbonuspres THEN
                           BEGIN
                           TSTRING_extractchars(str1,len,%.str,1,
                                                       STRING_length(%.str));
                           sbonusval:=converttointeger(str1,len);
                           IF minus THEN sbonusval:=-sbonusval;
                           END
                          ELSE
                           BEGIN
                           TSTRING_extractchars(str1,len,%.str,1,
                                                        STRING_length(%.str));
                           wbonusval:=converttointeger(str1,len);
                           IF minus THEN wbonusval:=-wbonusval;
                           END
                          END
       *>
FINAL: #CONDITION: (NOT(leftpresent) OR leftsimple) AND
                   (NOT(rightpresent) OR rightsimple) AND
                   (leftpresent OR rightpresent)
       #ACTION: BEGIN
                  SEND_RULETRANS;
                  $RULETRANS.leftpresent:=leftpresent;
                  $RULETRANS.rightpresent:=rightpresent;
                  $RULETRANS.wbonus:=wbonusval+1000*sbonusval;
                  $RULETRANS.sbonus:=sbonusval;
                END
*>
END;

PROCEDURAL PART
VAR leftsimples,rightsimples,rightsimples1::setofsimples;
    simplesets1,simplesets2,rightsimplesets,leftsimplesets::setofsimplesets;
    simpleset::simpleset;
    wbonus,sbonus::int;
    found::bool;
    simple::simple;
    mparamlist:LDMRULES_paramlist;
    ilparamlist:LIILRULES_paramlist;
    leftpresent,rightpresent::bool;
    intequals,helpfile,leftcopy,rightcopy,tempfile:LOCALFILE;
    numofleftconds,numofrightconds::int;
    ilrulenr,Mrulenr,sgnr::int;
    str: STR_string;
    len:STRING_range;
    paramname:TSTRING_string;
    leftnumcodes,rightnumcodes::setofnumcodes;
    numcode::numcode;
    pairsets::setofpairsets;
    pairset::pairset;
    pairs::setofpairs;
    pair::pair;
    leftsets,rightsets::setofidentsets;
    identset::identset;
    lefts,rights::setofidents;
    identset1,identset2::identset;
    ident::ident;
HELP 
     FUNCTION FINDILPARAM(pairsets::setofpairsets;str:TSTRING_string;
                ilparamlist:LIILRULES_paramlist)::pairset;
     VAR result,ilparamname:TSTRING_string;
         pairset::pairset;
         found::bool;
         list:LIILRULES_paramlist;
     BEGIN
     initsetofpairs(pairset.pairs);
     found:=false;
     TSTRING_constantempty(result);
     WHILE stillpairsets(pairsets) and not found DO
       BEGIN
       takepairset(pairset,pairsets);
       found:=(TSTRING_compare(pairset.mruparam,str)=0);
       IF found THEN
         BEGIN
         found:=FALSE;
         list:=ilparamlist;
         WHILE (list<>NIL) AND NOT(found) DO
           BEGIN
           TSTRING_constant(ilparamname,list^.paramname,
                                         list^.length);
           found:=(TSTRING_compare(pairset.ilparam,ilparamname)=0);
           list:=list^.next
           END;
         END;
       END;
     IF found THEN result:=pairset.ilparam
     ELSE writeln('WARNING no translation for MRULE-parameter ',str);
     findilparam:=pairset;
     END;
     FUNCTION FINDMRUPARAM(pairsets::setofpairsets;str:TSTRING_string;
                          mparamlist:LDMRULES_paramlist)::pairset;
     VAR result,mparamname:TSTRING_string;
         pairset::pairset;
         found::bool;
         list:LDMRULES_paramlist;
     BEGIN
     initsetofpairs(pairset.pairs);
     found:=false;
     TSTRING_constantempty(result);
     WHILE stillpairsets(pairsets) and not found DO
       BEGIN
       takepairset(pairset,pairsets);
       found:=(TSTRING_compare(pairset.ilparam,str)=0);
       IF found THEN
         BEGIN
         found:=FALSE;
         list:=mparamlist;
         WHILE (list<>NIL) AND NOT(found) DO
           BEGIN
           TSTRING_constant(mparamname,list^.paramname,
                                         list^.length);
           found:=(TSTRING_compare(pairset.mruparam,mparamname)=0);
           list:=list^.next
           END;
         END;
       END;
     IF found THEN result:=pairset.mruparam
     ELSE writeln('WARNING no translation for IL-parameter ',str);
     findmruparam:=pairset;
     END;
     PROCEDURE MERGEleftnumcode(numcode::numcode);
     VAR table::setofnumcodes;
         numcode1::numcode;
         found::bool;
     BEGIN
     table:=leftnumcodes;
     found:=false;
     WHILE stillnumcodes(table) and not found DO
       BEGIN
       takenumcode(numcode1,table);
       IF numcode1.num=numcode.num THEN found:=true
       END;
     IF not found then appendnumcode(numcode,leftnumcodes)
     ELSE
       BEGIN
       table:=leftnumcodes;
       initsetofnumcodes(leftnumcodes);
       WHILE stillnumcodes(table) DO
         BEGIN
         takenumcode(numcode1,table);
         IF numcode1.num=numcode.num THEN
           BEGIN
           appendlocfile(numcode.code,numcode1.code);
           END;
         appendnumcode(numcode1,leftnumcodes);
         END;
       END;
     END;
PROCEDURE MERGErightnumcode(numcode::numcode);
     VAR table::setofnumcodes;
         numcode1::numcode;
         found::bool;
     BEGIN
     table:=rightnumcodes;
     found:=false;
     WHILE stillnumcodes(table) and not found DO
       BEGIN
       takenumcode(numcode1,table);
       IF numcode1.num=numcode.num THEN found:=true
       END;
     IF not found then appendnumcode(numcode,rightnumcodes)
     ELSE
       BEGIN
       table:=rightnumcodes;
       initsetofnumcodes(rightnumcodes);
       WHILE stillnumcodes(table) DO
         BEGIN
         takenumcode(numcode1,table);
         IF numcode1.num=numcode.num THEN
           BEGIN
           appendlocfile(numcode.code,numcode1.code);
           END;
         appendnumcode(numcode1,rightnumcodes);
         END;
       END;
     END;
BEGIN
INIT: BEGIN initsetofsimples(leftsimples);
            initsetofsimples(rightsimples);
            initsetofsimplesets(leftsimplesets);
            initsetofsimplesets(rightsimplesets);
            numofleftconds:=0;
            numofrightconds:=0;
            initlocalfile(leftcopy);
            initlocalfile(rightcopy);
            leftpresent:=$RULETRANS.leftpresent;
            rightpresent:=$RULETRANS.rightpresent;
            mrulenr:=-1;
            initlocalfile(intequals);
            initsetofnumcodes(leftnumcodes);
            initsetofnumcodes(rightnumcodes);
            pairsets:=$$RULETRANS.pairsets;
            wbonus:=$RULETRANS.wbonus;
            sbonus:=$RULETRANS.sbonus;
      END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN TSTRING_extractchars(str,len,%.str,0,TSTRING_length(%MRULENAME.str));
                  mrulenr:=-1;
                  LDMRULES_rulenumber(mrulenr,str,len);
                  IF mrulenr=-1 THEN
                    BEGIN
                    mrulenr:=1;
                    writeln('WARNING: unknown Mrule ',%MRULENAME.str);
                    END;
                  sgnr:=-1;
                  LDMRULES_subgrammarnumber(mrulenr,sgnr);
                  IF sgnr=-1 THEN BEGIN
                    writeln('WARNING:RULE ',%MRULENAME.str,' is not in any SUBGRAMMAR');
                    END;
            END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN  TSTRING_extractchars(str,len,%.str,0,TSTRING_length(%ILRULENAME.str));
                   LIILRULES_Rulenumber(ilrulenr,str,len);
                  IF ilrulenr=-1 THEN
                    BEGIN
                    ilrulenr:=1;
                    writeln('WARNING: unknown ILrule ',%ILRULENAME.str);
                    END;
             END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
5: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
6: <* SEND: BEGIN numofleftconds:=numofleftconds+1;
                  %%ANDCOND.rulenumber:=mrulenr;
            END
      !ANDCOND.
      RECEIVE: BEGIN appendlocfile(%%ANDCOND.intequals,intequals);
                     IF leftpresent THEN
                     appendsimple(%%ANDCOND.simple,leftsimples);
                     \leftcopy.\LOCAL.
                     IF numofleftconds=1 THEN "("
                     IF numofleftconds>1 THEN BEGIN " AND (" \\ END;
                     appendlocfile(%%ANDCOND.copy,leftcopy);
                     ")"
               END
   *>
7: <* SEND: BEGIN numofrightconds:=numofrightconds+1;
                  %%ANDCOND.rulenumber:=ilrulenr;
            END
      !ANDCOND.
      RECEIVE: BEGIN appendlocfile(%%ANDCOND.intequals,intequals);
                     IF rightpresent THEN
                     appendsimple(%%ANDCOND.simple,rightsimples);
                     \rightcopy.\LOCAL.
                     IF numofrightconds=1 THEN "("
                     IF numofrightconds>1 THEN BEGIN " AND (" \\ END;
                     appendlocfile(%%ANDCOND.copy,rightcopy);
                     ")"
               END
   *>
8: <* SEND: BEGIN \leftcopy.\LOCAL.
                  IF numofleftconds=0 THEN 
                    BEGIN initlocalfile(leftcopy);" TRUE " \\ END;
                  simpleset.val:=leftsimples;
                  simpleset.copy:=leftcopy;
                  simpleset.rulenr:=mrulenr;
                  appendsimpleset(simpleset,leftsimplesets);
                  numofleftconds:=0;
                  initlocalfile(leftcopy);
                  initsetofsimples(leftsimples);
            END
      !.
      RECEIVE: BEGIN
               END
   *>
9: <* SEND: BEGIN \rightcopy.\LOCAL.
                  IF numofrightconds=0 THEN 
                    BEGIN initlocalfile(rightcopy); "TRUE " \\ END;
                  simpleset.val:=rightsimples;
                  simpleset.copy:=rightcopy;
                  simpleset.rulenr:=ilrulenr;
                  appendsimpleset(simpleset,rightsimplesets);
                  numofrightconds:=0;
                  initlocalfile(rightcopy);
                  initsetofsimples(rightsimples);
            END
      !.
      RECEIVE: BEGIN
               END
   *>
10: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN
               END
   *>
11: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN
               END
   *>
12: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN
               END
   *>
13: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN
               END
   *>
14: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN
               END
   *>
*>
FINAL:BEGIN   \leftcopy.\LOCAL.
                  IF numofleftconds=0 THEN BEGIN initlocalfile(leftcopy);" TRUE " \\ END;
              \rightcopy.\LOCAL.
                  IF numofrightconds=0 THEN BEGIN initlocalfile(rightcopy); " TRUE " \\ END;
              simpleset.val:=leftsimples;
              simpleset.copy:=leftcopy;
              simpleset.rulenr:=mrulenr;
              appendsimpleset(simpleset,leftsimplesets);
              simpleset.val:=rightsimples;
              simpleset.copy:=rightcopy;
              simpleset.rulenr:=ilrulenr;
              appendsimpleset(simpleset,rightsimplesets);
              IF leftpresent THEN
               BEGIN
               \helpfile.\LOCAL.
               simplesets1:=rightsimplesets;
               WHILE stillsimplesets(simplesets1) DO
                BEGIN
                takesimpleset(simpleset,simplesets1);
                rightcopy:=simpleset.copy;
                ilrulenr:=simpleset.rulenr;
                rightsimples:=simpleset.val;
                simplesets2:=leftsimplesets;
                WHILE stillsimplesets(simplesets2) DO
                  BEGIN
                  initlocalfile(helpfile);
                  takesimpleset(simpleset,simplesets2);
                  leftsimples:=simpleset.val;
                  leftcopy:=simpleset.copy;
                  mrulenr:=simpleset.rulenr;
                  " HYPERDTREE_emptyNode(result1);"\\
                  " WITH ps.params DO BEGIN"\\
                  "IF "
                  savelocfile(rightcopy,tempfile);
                  appendlocfile(tempfile,helpfile);
                  LDMRULES_subgrammarnumber(mrulenr,sgnr);
                  " THEN BEGIN"\\
                  IF wbonus<0 THEN BEGIN "resultelt.bonus:=-" """-wbonus""" ";"\\
                  END ELSE BEGIN "resultelt.bonus:=" """wbonus""" ";" \\ END;
                  "      resultelt.sg:=" """sgnr""" ";"\\
                  "      resultelt.R:=" """mrulenr""" ";"\\
                  "      MEM_newdefault(loopholes.sizeof(LSPARAMS_record)," 
                         "loopholes.retype(lsps,MEM_ptr));"\\ 
                  "      lsps^.rulenr:=" """mrulenr""" ";"\\
                  "      resultelt.parameters.rulenr:=" """mrulenr""" ";"\\
                  "      resultelt.parameters.subst:=ps.subst;"\\
                  "      resultelt.parameters.index:=-1;"\\
                  LDMRULES_ruleparameters(mrulenr,mparamlist);
                  WHILE mparamlist<>NIL DO
                    BEGIN
                    TSTRING_constant(paramname,mparamlist^.paramname,
                                          mparamlist^.length);
                    IF TSTRING_comparechars(paramname,'LEVEL',5)=0 THEN
                      BEGIN
                      "    resultelt.parameters.index:=ps.index;"\\
                      END;
                    mparamlist:=mparamlist^.next;
                    END;
                  WHILE stillsimples(leftsimples) DO
                    BEGIN
                    takesimple(simple,leftsimples);
                    savelocfile(simple.valeu,tempfile);
                    " lsps^.X" """mrulenr""" ""simple.param""
                     ":=" appendlocfile(tempfile,helpfile); ";"\\
                    END;
                  " resultelt.parameters.ls:=loopholes.retype" 
                   "(lsps,LDMRULES_lsparams);"\\
                  " MEM_newdefault(loopholes.sizeof" "(HYPERDTREE_hypernodeelt),"
                    "loopholes.retype(p,MEM_ptr));"\\
                  " p^:=resultelt;"\\
                  " HYPERDTREE_AddToNode(p,result1);"\\
                  LDMRULES_ruleparameters(mrulenr,mparamlist);
                  LIILRULES_ruleparameters(ilrulenr,ilparamlist);
                  WHILE mparamlist<>NIL DO
                    BEGIN
                    TSTRING_constant(paramname,mparamlist^.paramname,
                                          mparamlist^.length);
                    IF TSTRING_comparechars(paramname,'LEVEL',5)<>0 THEN
                      BEGIN
                      found:=false;
                      leftsimples:=simpleset.val;
                      WHILE stillsimples(leftsimples) and not found DO
                        BEGIN
                        takesimple(simple,leftsimples);
                        found := TSTRING_compare(simple.param,paramname)=0
                        END;
                      IF not found THEN
                        BEGIN
                        pairset:=findilparam(pairsets,paramname,ilparamlist);
                        pairs:=pairset.pairs;
                        "helpresult1:=result1;"\\
                        "HYPERDTREE_emptyNode(result1);"\\
                        WHILE stillpairs(pairs) DO
                          BEGIN
                          takepair(pair,pairs);
                          IF pair.leftpresent THEN
                             BEGIN
                             IF pair.rightsetvalued THEN
                                BEGIN
                                rightsets:=pair.rightsets;
                                WHILE stillidentsets(rightsets) DO
                                  BEGIN
                                  takeidentset(identset1,rightsets);
                                  " IF X" """ilrulenr"""
                                        ""pairset.ilparam"" "= ["
                                  WHILE stillidents(identset1.val) DO
                                    BEGIN
                                    takeident(ident,identset1.val);
                                    ""ident.str""
                                    IF stillidents(identset1.val) THEN ","
                                    \\
                                    END;
                                  " ] THEN BEGIN"\\
                                  IF pair.leftsetvalued THEN
                                    BEGIN
                                    leftsets:=pair.leftsets;
                                    WHILE stillidentsets(leftsets) DO
                                      BEGIN
                                      takeidentset(identset2,leftsets);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HYPERDTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HYPERDTREE_TakeFromNode(p,result2);"\\
                          " resultelt:=p^;"\\
                          "lsps1:=loopholes.retype"
                           "(resultelt.parameters.ls,LSPARAMS_precord);"\\
                          "MEM_newdefault(loopholes.sizeof(LSPARAMS_record),"
                          "loopholes.retype(lsps,MEM_ptr));lsps^:=lsps1^;"\\
                          "lsps^.X" """mrulenr""" ""paramname""
                                  ":=["
                                      WHILE stillidents(identset2.val) DO
                                        BEGIN
                                        takeident(ident,identset2.val);
                                        ""ident.str""
                                        IF stillidents(identset2.val) THEN ","
                                         \\
                                        END;
                                      " ];"\\
                          "resultelt.parameters.ls:=loopholes.retype" 
                           "(lsps,LDMRULES_lsparams);"\\
                     "MEM_newdefault(loopholes.sizeof" "(HYPERDTREE_hypernodeelt),"
                          "loopholes.retype(p,MEM_ptr));"\\
                          "p^:=resultelt;"\\
                          "HYPERDTREE_addtoNode(p,result1);"\\
                          "END;"\\
                                      END;
                                    END
                                  ELSE {not pair.leftsetvalued}
                                    BEGIN
                                    lefts:=pair.lefts;
                                    WHILE stillidents(lefts) DO
                                      BEGIN
                                      takeident(ident,lefts);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HYPERDTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HYPERDTREE_TakeFromNode(p,result2);"\\
                          " resultelt:=p^;"\\
                          "lsps1:=loopholes.retype"
                         "(resultelt.parameters.ls,LSPARAMS_precord);"\\
                          "MEM_newdefault(loopholes.sizeof(LSPARAMS_record),"
                          "loopholes.retype(lsps,MEM_ptr));lsps^:=lsps1^;"\\
                          "lsps^.X" """mrulenr""" ""paramname""
                                  ":=" ""ident.str"" ";"\\
                          "resultelt.parameters.ls:=loopholes.retype" 
                         "(lsps,LDMRULES_lsparams);"\\
                    " MEM_newdefault(loopholes.sizeof" "(HYPERDTREE_hypernodeelt),"
                          "loopholes.retype(p,MEM_ptr));"\\
                          "p^:=resultelt;"\\
                          "HYPERDTREE_addtonode(p,result1);"\\
                          "END;"\\
                                      END;
                                    END;
                                  " END;"\\
                                  END;
                                END
                             ELSE {not pair.rightsetvalued}
                                BEGIN
                                rights:=pair.rights;
                                WHILE stillidents(rights) DO
                                  BEGIN
                                  takeident(ident,rights);
                                  " IF X" """ilrulenr"""
                                        ""pairset.ilparam"" "=" ""ident.str""
                                  " THEN BEGIN"\\
                                  IF pair.leftsetvalued THEN
                                    BEGIN
                                    leftsets:=pair.leftsets;
                                    WHILE stillidentsets(leftsets) DO
                                      BEGIN
                                      takeidentset(identset2,leftsets);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HYPERDTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HYPERDTREE_TakeFromNode(p,result2);"\\
                          " resultelt:=p^;"\\
                          "lsps1:=loopholes.retype"
                      "(resultelt.parameters.ls,LSPARAMS_precord);"\\
                          "MEM_newdefault(loopholes.sizeof(LSPARAMS_record),"
                          "loopholes.retype(lsps,MEM_ptr));lsps^:=lsps1^;"\\
                          "lsps^.X" """mrulenr""" ""paramname""
                                  ":=["
                                      WHILE stillidents(identset2.val) DO
                                        BEGIN
                                        takeident(ident,identset2.val);
                                        ""ident.str""
                                        IF stillidents(identset2.val) THEN ","
                                         \\
                                        END;
                                      " ];"\\
                          "resultelt.parameters.ls:=loopholes.retype" 
                        "(lsps,LDMRULES_lsparams);"\\
                   " MEM_newdefault(loopholes.sizeof" "(HYPERDTREE_hypernodeelt),"
                          "loopholes.retype(p,MEM_ptr));"\\
                          "p^:=resultelt;"\\
                          "HYPERDTREE_addtoNode(p,result1);"\\
                          "END;"\\
                                      END;
                                    END
                                  ELSE {not pair.leftsetvalued}
                                    BEGIN
                                    lefts:=pair.lefts;
                                    WHILE stillidents(lefts) DO
                                      BEGIN
                                      takeident(ident,lefts);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HYPERDTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HYPERDTREE_TakeFromNode(p,result2);"\\
                          " resultelt:=p^;"\\
                          "lsps1:=loopholes.retype"
                        "(resultelt.parameters.ls,LSPARAMS_precord);"\\
                          "MEM_newdefault(loopholes.sizeof(LSPARAMS_record),"
                          "loopholes.retype(lsps,MEM_ptr));lsps^:=lsps1^;"\\
                          "lsps^.X" """mrulenr""" ""paramname""
                                  ":=" ""ident.str"" ";"\\
                          "resultelt.parameters.ls:=loopholes.retype" 
                        "(lsps,LDMRULES_lsparams);"\\
                    " MEM_newdefault(loopholes.sizeof" "(HYPERDTREE_hypernodeelt),"
                          "loopholes.retype(p,MEM_ptr));"\\
                          "p^:=resultelt;"\\
                          "HYPERDTREE_addtoNode(p,result1);"\\
                          "END;"\\
                                      END;
                                    END;
                                  "END;"\\
                                  END;
                                END;
                             END;
                          END;
                        END;
                      END;
                    mparamlist:=mparamlist^.next;
                    END;
                  "appendresults(" """sgnr""" ",result1,result);"\\
                  "      END;"\\
                  "      END{WITH};"\\
                  numcode.code:=helpfile;
                  numcode.num:=ilrulenr;
                  mergeleftnumcode(numcode);
                  END;
                 END;
                END;
            IF rightpresent THEN
              BEGIN
                \helpfile.\LOCAL.
              simplesets1:=rightsimplesets;
              WHILE stillsimplesets(simplesets1) DO
               BEGIN
               takesimpleset(simpleset,simplesets1);
               rightsimples:=simpleset.val;
               rightcopy:=simpleset.copy;
               ilrulenr:=simpleset.rulenr;
               simplesets2:=leftsimplesets;
               WHILE stillsimplesets(simplesets2) DO
                BEGIN
                takesimpleset(simpleset,simplesets2);
                leftsimples:=simpleset.val;
                leftcopy:=simpleset.copy;
                mrulenr:=simpleset.rulenr;
                initlocalfile(helpfile);
                rightsimples1:=rightsimples;
                LIILRULES_ruleparameters(ilrulenr,ilparamlist);
                "lsps:=loopholes.retype(ps.ls,LSPARAMS_precord);"\\
                "HILTREE_emptyNode(result1);"\\
                "WITH lsps^ DO BEGIN"\\
                "IF "
                savelocfile(leftcopy,tempfile);
                appendlocfile(tempfile,helpfile);
                  " THEN BEGIN"\\
                  IF wbonus<0 THEN BEGIN "resultelt.sembonus:=-" """-wbonus""" ";"\\
                  END ELSE BEGIN "resultelt.sembonus:=" """wbonus""" ";" \\END;
                  "      resultelt.R:=" """ilrulenr""" ";"\\
                  "      lips.rulenr:=" """ilrulenr""" ";"\\
                  "      resultelt.parameters.index:=-1;"\\
                  "      resultelt.parameters.subst:=ps.subst;"\\
                  WHILE stillsimples(rightsimples1) DO
                    BEGIN
                    takesimple(simple,rightsimples1);
                    savelocfile(simple.valeu,tempfile);
                    " lips.X" """ilrulenr""" ""simple.param""
                     ":=" appendlocfile(tempfile,helpfile); ";"\\
                    END;
                  LIILRULES_ruleparameters(ilrulenr,ilparamlist);
                  WHILE ilparamlist<>NIL DO
                    BEGIN
                    TSTRING_constant(paramname,ilparamlist^.paramname,
                                          ilparamlist^.length);
                    IF TSTRING_comparechars(paramname,'LEVEL',5)=0 THEN
                      BEGIN
                      "    resultelt.parameters.index:=ps.index;"\\
                      END;
                    ilparamlist:=ilparamlist^.next;
                    END;
                  " resultelt.parameters.params:=lips;"\\
                  " HILTREE_newhyperiltreerule(p," """ilrulenr"""
                    ",resultelt.parameters);"\\
                  " HILTREE_storehypernodeelt(p,resultelt);"\\
                  " HILTREE_AddToNode(p,result1);"\\
                  LDMRULES_ruleparameters(mrulenr,mparamlist);
                  LIILRULES_ruleparameters(ilrulenr,ilparamlist);
                  WHILE ilparamlist<>NIL DO
                    BEGIN
                    TSTRING_constant(paramname,ilparamlist^.paramname,
                                          ilparamlist^.length);
                    IF TSTRING_comparechars(paramname,'LEVEL',5)<>0 THEN
                      BEGIN
                      found:=false;
                      rightsimples1:=rightsimples;
                      WHILE stillsimples(rightsimples1) and not found DO
                        BEGIN
                        takesimple(simple,rightsimples1);
                        found := TSTRING_compare(simple.param,paramname)=0
                        END;
                      IF not found THEN
                        BEGIN
                        pairset:=findmruparam(pairsets,paramname,mparamlist);
                        pairs:=pairset.pairs;
                        "helpresult1:=result1;"\\
                        "HILTREE_emptyNode(result1);"\\
                        WHILE stillpairs(pairs) DO
                          BEGIN
                          takepair(pair,pairs);
                          IF pair.rightpresent THEN
                             BEGIN
                             IF pair.leftsetvalued THEN
                                BEGIN
                                leftsets:=pair.leftsets;
                                WHILE stillidentsets(leftsets) DO
                                  BEGIN
                                  takeidentset(identset1,leftsets);
                                  " IF X" """mrulenr"""
                                        ""pairset.mruparam"" "= ["
                                  WHILE stillidents(identset1.val) DO
                                    BEGIN
                                    takeident(ident,identset1.val);
                                    ""ident.str""
                                    IF stillidents(identset1.val) THEN ","
                                    \\
                                    END;
                                  " ] THEN BEGIN"\\
                                  IF pair.rightsetvalued THEN
                                    BEGIN
                                    rightsets:=pair.rightsets;
                                    WHILE stillidentsets(rightsets) DO
                                      BEGIN
                                      takeidentset(identset2,rightsets);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HILTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HILTREE_TakeFromNode(p,result2);"\\
                          " HILTREE_LoadHypernodeelt(p,resultelt);"\\
                          "lips:=resultelt.parameters.params;"\\
                          "lips.X" """ilrulenr""" ""paramname""
                                  ":=["
                                      WHILE stillidents(identset2.val) DO
                                        BEGIN
                                        takeident(ident,identset2.val);
                                        ""ident.str""
                                        IF stillidents(identset2.val) THEN ","
                                         \\
                                        END;
                                      " ];"\\
                          " resultelt.parameters.params:=lips;"\\
                          " HILTREE_newhyperiltreerule(p," """ilrulenr"""
                           ",resultelt.parameters);"\\
                          " HILTREE_storehypernodeelt(p,resultelt);"\\
                          "HILTREE_addtoNode(p,result1);"\\
                          " END;"\\
                                      END;
                                    END
                                  ELSE {not pair.rightsetvalued}
                                    BEGIN
                                    rights:=pair.rights;
                                    WHILE stillidents(rights) DO
                                      BEGIN
                                      takeident(ident,rights);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HILTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HILTREE_TakeFromNode(p,result2);"\\
                          " HILTREE_LoadHypernodeelt(p,resultelt);"\\
                          "lips:=resultelt.parameters.params;"\\
                          "lips.X" """ilrulenr""" ""paramname""
                                  ":=" ""ident.str"" ";"\\
                          " resultelt.parameters.params:=lips;"\\
                          " HILTREE_newhyperiltreerule(p," """ilrulenr"""
                            ",resultelt.parameters);"\\
                          " HILTREE_storehypernodeelt(p,resultelt);"\\
                          "HILTREE_addtonode(p,result1);"\\
                          " END;"\\
                                      END;
                                    END;
                                  " END;"\\
                                  END;
                                END
                             ELSE {not pair.leftsetvalued}
                                BEGIN
                                lefts:=pair.lefts;
                                WHILE stillidents(lefts) DO
                                  BEGIN
                                  takeident(ident,lefts);
                                  " IF X" """mrulenr"""
                                        ""pairset.mruparam"" "=" ""ident.str""
                                  " THEN BEGIN"\\
                                  IF pair.rightsetvalued THEN
                                    BEGIN
                                    rightsets:=pair.rightsets;
                                    WHILE stillidentsets(rightsets) DO
                                      BEGIN
                                      takeidentset(identset2,rightsets);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HILTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HILTREE_TakeFromNode(p,result2);"\\
                          " HILTREE_LoadHypernodeelt(p,resultelt);"\\
                          "lips:=resultelt.parameters.params;"\\
                          "lips.X" """ilrulenr""" ""paramname""
                                  ":=["
                                      WHILE stillidents(identset2.val) DO
                                        BEGIN
                                        takeident(ident,identset2.val);
                                        ""ident.str""
                                        IF stillidents(identset2.val) THEN ","
                                         \\
                                        END;
                                      " ];"\\
                          " resultelt.parameters.params:=lips;"\\
                          " HILTREE_newhyperiltreerule(p," """ilrulenr"""
                            ",resultelt.parameters);"\\
                          " HILTREE_storehypernodeelt(p,resultelt);"\\
                          "HILTREE_addtoNode(p,result1);"\\
                          " END;"\\
                                    END;
                                    END
                                  ELSE {not pair.rightsetvalued}
                                    BEGIN
                                    rights:=pair.rights;
                                    WHILE stillidents(rights) DO
                                      BEGIN
                                      takeident(ident,rights);
                          "result2:=helpresult1;"\\
                          "WHILE NOT(HILTREE_IsEmptyNode(result2)) DO"\\
                          " BEGIN"\\
                          " HILTREE_TakeFromNode(p,result2);"\\
                          " HILTREE_LoadHypernodeelt(p,resultelt);"\\
                          "lips:=resultelt.parameters.params;"\\
                          "lips.X" """ilrulenr""" ""paramname""
                                  ":=" ""ident.str"" ";"\\
                          " resultelt.parameters.params:=lips;"\\
                          " HILTREE_newhyperiltreerule(p," """ilrulenr"""
                            ",resultelt.parameters);"\\
                          " HILTREE_storehypernodeelt(p,resultelt);"\\
                          "HILTREE_addtoNode(p,result1);"\\
                          " END;"\\
                                    END;
                                    END;
                                  "END;"\\
                                  END;
                                END;
                             END;
                          END;
                        END;
                      END;
                    ilparamlist:=ilparamlist^.next;
                    END;
                  "appendresults(result1,result);"\\
                  " END;"\\
                  " END{WITH};"\\
                numcode.code:=helpfile;
                numcode.num:=mrulenr;
                mergerightnumcode(numcode);
                END;
               END;
              END;
            $$RULETRANS.intequals:=intequals;
            $$RULETRANS.leftnumcodes:=leftnumcodes;
            $$RULETRANS.rightnumcodes:=rightnumcodes;
      END
END;
