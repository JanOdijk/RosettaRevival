              (NPrec1 = AUX_NPONnomBPRSPR 
                                  EXCEPT FOR [numero, persona, genero]) AND
              (NPrec1.numero = singular)                                AND
              (NPrec1.persona = 1)                                      AND
              (NPrec1.genero = masc)
