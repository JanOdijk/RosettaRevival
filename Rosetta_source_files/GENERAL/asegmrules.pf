 *  Copyright (c) 1985, by Nederlandse Philips Bedrijven BV.        
 *                                                                  
 *  Remarks         : Provides function for applying the analytical
 *                    segmentation rules. The module supports 5 kinds of rules:
 *                    Prefix rules, Suffix rules, LGLUE rules, R-GLUE rules and
 *                    M-GLUE rules.
 *
 *EMP:::===================================================================*)

pragma C_include('string.pf');
pragma C_include('segmrules.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
PACKAGE ASEGMRULES;
WITH STRNG, SEGMRULES;


(*MPP:::===================================================================*
 *
 *  Procedure Name  : ASEGMRULES_Init
 *  Description     : Initialization of the ASEGMRULES module
 *  Precondition    : None
 *  Side Effects    : ASEGMRULES has been initialized
 *
 *EMP:::===================================================================*)

PROCEDURE ASEGMRULES_init; EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : ASEGMRULES_ASuffixTableHandler
 *  Description    : Applies analytical suffix segmentation rules.
 *  Parameters     : s: STRING_String; String that is to be segmented.
 *  Result         : SEGMRULES_pSFruleResult; datastructure containing the
 *                                            (possibly ambiguous) result (cf.
 *                                            module SEGMRULES for further
 *                                            information).
 *  Precondition   : ASEGMRULES_Init has been called
 *  Postcondition  : The input string has been segmented according to the
 *                   segmentation rules
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION ASEGMRULES_ASuffixTableHandler(s: STRING_String):
                                                SEGMRULES_pSFruleResult; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : ASEGMRULES_APrefixTableHandler
 *  Description    : Applies analytical prefix segmentation rules.
 *  Parameters     : s: STRING_String; String that is to be segmented.
 *  Result         : SEGMRULES_pSFruleResult; datastructure containing the
 *                                            (possibly ambiguous) result (cf.
 *                                            module SEGMRULES for further
 *                                            information).
 *  Precondition   : ASEGMRULES_Init has been called
 *  Postcondition  : The input string has been segmented according to the
 *                   segmentation rules
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION ASEGMRULES_APrefixTableHandler(s: STRING_String):
                                                SEGMRULES_pPFruleResult; EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : ASEGMRULES_ALGLUE
 *  Description    : Applies analytical left glue segmentation rules.
 *  Parameters     : s: STRING_String; String that is to be segmented.
 *  Result         : SEGMRULES_pSFruleResult; datastructure containing the
 *                                            (possibly ambiguous) result (cf.
 *                                            module SEGMRULES for further
 *                                            information).
 *  Precondition   : ASEGMRULES_Init has been called
 *  Postcondition  : The input string has been segmented according to the
 *                   segmentation rules
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION ASEGMRULES_ALGLUE(s: STRING_String):
                                              SEGMRULES_pGLUEruleResult; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : ASEGMRULES_ARGLUE
 *  Description    : Applies analytical right glue segmentation rules.
 *  Parameters     : s: STRING_String; String that is to be segmented.
 *  Result         : SEGMRULES_pSFruleResult; datastructure containing the
 *                                            (possibly ambiguous) result (cf.
 *                                            module SEGMRULES for further
 *                                            information.
 *  Precondition   : ASEGMRULES_Init has been called
 *  Postcondition  : The input string has been segmented according to the
 *                   segmentation rules
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION ASEGMRULES_ARGLUE(s: STRING_String): 
                                              SEGMRULES_pGLUEruleResult; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : ASEGMRULES_AMGLUE
 *  Description    : Applies analytical middle glue segmentation rules.
 *  Parameters     : s: STRING_String; String that is to be segmented.
 *  Result         : SEGMRULES_pSFruleResult; datastructure containing the
 *                                            (possibly ambiguous) result (cf.
 *                                            module SEGMRULES for further
 *                                            information.
 *  Precondition   : ASEGMRULES_Init has been called
 *  Postcondition  : The input string has been segmented according to the
 *                   segmentation rules
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION ASEGMRULES_AMGLUE(s: STRING_String):
                                              SEGMRULES_pGLUEruleResult; EXTERNAL;

END {ASEGMRULES};
