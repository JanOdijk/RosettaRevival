\newpage
\begin{verbatim}
%
% TRANSFORMATION Tpolite1 (* wouldinsertion *)
< m1:SENTENCE{SENTENCErec1}
           [I2:mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_doBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 
>

< m :SENTENCE{SENTENCErec2}
           [I2:mu1,
            I4:auxrel/VERB{VERBrec3}
                  [head/SUBVERB{SUBVERBrec3}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec3}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 

>
   MATCHCONDITIONS
      <
       I1: KEY2 = KEY_likeBVERBkey OR
           KEY2 = KEY_preferBVERBkey OR
           KEY2 = KEY_appreciateBVERBkey OR
           KEY2 = KEY_wantBVERBkey OR
           KEY2 = KEY_'s_auxverb177' (* want *)
 
       I2: EXIST (mu1, [I5:subjrel/NP{NPrec1}[mu5]])
       I3: VERBrec1.tense = presenttense
       I4: VERBrec3.tense = pasttense
       I5: NPrec1.person = 1
       m1: SENTENCErec1.mood = declarative
       m : SENTENCErec2.mood = declarative

      >


      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (SENTENCErec1.deixis = presentdeixis)                  

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
              VERBrec3 :=
                {
                  numbers     : VERBrec1.numbers
                  persons     : VERBrec1.persons
                  modus       : VERBrec1.modus
                  tense       : pasttense
                };
               SENTENCErec2:= SENTENCErec1;
               SENTENCErec2.deixis := pastdeixis;
         >
      DECOMP
         <
          C1:(SENTENCErec2.finiteness = finite) AND
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3)) AND
              (SUBVERBrec3.affix = noaffix)  AND 
              (SENTENCErec2.deixis = pastdeixis)
              
          A1:SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                        {
                          numbers     : VERBrec3.numbers
                          persons     : VERBrec3.persons
                          modus       : VERBrec3.modus
                          tense       : presenttense
                        };
              SENTENCErec1:= SENTENCErec2;
              SENTENCErec1.deixis := presentdeixis;

         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tpolite1
\item[* relevant examples:] I do like/prefer/appreciate/want to swim 
$\rightarrow$ I would like/prefer/appreciate/want to swim
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_polite
\item[* date of creation:] 20-FEB-1990
\item[* author:] Lisette Appelo
\item[* copied from:] Rwouldinsertion
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] To insert {\em would}  and delete {\em do} in context of 
{\em like, prefer, appreciate, want} to express politeness. For finite 
declarative main SENTENCEs with presentdeixis and first person subject only.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task) 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:  

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages: 

\end{enumerate}
\item[* relevant literature/documents:] 
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

