pragma C_include('listree.pf');
pragma C_include('lidomaint.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LDAFFIXLEX;
WITH LISTREE, LIDOMAINT;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_Suffix
 *  Description    : Makes an Stree for the suffix with the correponding key.
 *  Parameters     : key: INTEGER
 *  Result         : LISTREE_pStree;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_Suffix(key: INTEGER): LISTREE_pStree;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_Prefix
 *  Description    : Makes an Stree for the prefix with the correponding key.
 *  Parameters     : key: INTEGER
 *  Result         : LISTREE_pStree;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_Prefix(key: INTEGER): LISTREE_pStree;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_SuffixCat
 *  Description    : Checks whether the category is a Suffix category.
 *  Parameters     : cat: LIDOMAINT_syntcat;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_SuffixCat(c: LIDOMAINT_syntcat): BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_PrefixCat
 *  Description    : Checks whether the category is a Prefix category.
 *  Parameters     : cat: LIDOMAINT_syntcat;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_PrefixCat(c: LIDOMAINT_syntcat): BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_AffixCat
 *  Description    : Checks whether the category is an Affix category.
 *  Parameters     : cat: LIDOMAINT_syntcat;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_AffixCat(c: LIDOMAINT_syntcat): BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_GetSuffixKey
 *  Description    : Returns the key of the input Suffix S-tree.
 *  Parameters     : t: LISTREE_pStree;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_GetSuffixKey(t: LISTREE_pStree): INTEGER;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDAFFIXLEX_GetPrefixKey
 *  Description    : Returns the key of the input Prefic S-tree.
 *  Parameters     : t: LISTREEE_pStree;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LDAFFIXLEX_GetPrefixKey(t: LISTREE_pStree): INTEGER;
EXTERNAL;


END {LDAFFIXLEX};
