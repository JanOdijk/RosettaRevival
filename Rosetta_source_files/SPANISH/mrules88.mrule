\item modifications: \\
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rconjsentsubst1
< m1: N1[ leftdislocrel/I3::SENTENCEVAR{SENTENCEVARrec1},
          mu1
        ]  

SUBST:         
  m2: SENTENCE{SENTENCErec1}[I2:mu3] 
>

< m : N1[ leftdislocrel/SENTENCE{SENTENCErec1}[I2:mu3, I1:sig1],
          mu1
        ]

>

   MATCHCONDITIONS
      <
       m  : NOT EXIST(mu1, [I11:../T1]) 
            I11: T1.CAT IN AUX_propvarcats
       I1: ALL(sig1,puncrel/PUNC(KEY_kommaPUNCkey){PUNCrec2})
       I2: EXIST(mu3,[conjrel/I21::CONJ{CONJrec1}]) OR
            EXIST(mu3, [modrel/PREP{}]) OR
           NOT EXIST(mu3, [conjrel/CONJ{CONJrec1}]) 
           I21: initial IN CONJrec1.distri
       I3: SENTENCEVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE
      < >
      <sig1:[puncrel/PUNC(KEY_kommaPUNCkey){PUNCrec1}]>

      COMP
         <
          C1: SENTENCEVARrec1 = COPYT_SENTENCEtoVAR(SENTENCErec1) AND
              SENTENCErec1.adverbial = true AND
              SENTENCErec1.mood = declarative
          A1: @
         >
      DECOMP
         <
          C1: SENTENCErec1.adverbial = true AND
              SENTENCErec1.mood = declarative
          A1: SENTENCEVARrec1 := COPYT_SENTENCEtoVAR(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
         >

   SUBRULE
      < >
      <sig1:  []>

      DECOMP
         <
          C1: SENTENCErec1.adverbial = true  AND
              SENTENCErec1.mood = declarative
          A1: SENTENCEVARrec1 := COPYT_SENTENCEtoVAR(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
         >

>
&

\end{verbatim}
