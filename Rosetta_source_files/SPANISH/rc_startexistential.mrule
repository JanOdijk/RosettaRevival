\newpage
\begin{verbatim}
% RULE Rexistsadvvar
< m1: NPPROP{NPPROPrec1}
                [ mu1,
                  objrel/T1,
                  I4:mu4,
                  I3:mu3 
                ]

  m2: I1::ADVPVAR{ADVPVARrec1}                 
>

< m :NPPROP{NPPROPrec1}
                [ mu1,
                  objrel/T1,
                  I4:mu4,
                  sentadvrel/I1::ADVPVAR{ADVPVARrec1},
                  I5:mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: ADVPVARrec1.actsubcefs * [sentadv, causadv] <> []
       I4: ALL(mu4, I41:rel4/..)
       I3: NOT EXIST (mu3, [I41:rel4/..])
           I41: rel4 IN [locadvrel, sentadvrel, tempadvrel]
       I5: NOT EXIST(mu3,[I51:rel5/..])
           I51: rel5 IN [locadvrel, tempadvrel, sentadvrel]
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
