The rest of this file 
contains transformations to deal with obligatory control of
infinitival adverbial sentences. 
It is assumed that only subjects can control such adverbial clauses.
For other controllers separate transformations must be made.

The transformation class must be applied iteratively. It must be followed by
a filter. To speed up analysis, it can be preceded by a prefilter.
The TC must be applied after tc_objectok and before pruning of S.

The following transformations are planned:

\begin{description}
\item[tadvcontrol1] deals with subject-control if the subject precedes the
adverbial sentence
\item[tadvcontrol2] deals with subject-control if the subject follows the
adverbial sentence
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION Tadvcontrol1
< m1:CLAUSE{CLAUSErec1}[mu1, 
                        subjrel/T1,
                        mu2,
                        I1:rel1/I5::SENTENCE{SENTENCErec1}
                              [ I3:mu3,
                                subjrel/T2,
                                I4:mu4 
                              ],
                        mu5
                       ]
>

< m :CLAUSE{CLAUSErec1}[mu1, 
                        subjrel/T1,
                        mu2,
                        I1:rel1/I5::SENTENCE{SENTENCErec1}
                              [ I3:mu3,
                                I4:mu4 
                              ],
                        mu5
                       ]
>


   MATCHCONDITIONS
      <
       I1: rel1 IN [postsentadvrel, tempadvrel]
       I3: ALL(mu3,I31:rel3/..)
           I31: rel3 IN [modrel, conjrel]
       I4: ALL(mu4,I41:rel4/..) 
           I41:QUOTE_Srelprec(subjrel, rel4) AND rel4 <> subjrel
       I5: SENTENCErec1.adverbial = true AND
           SENTENCErec1.finiteness = infinite
      >


<
   SUBRULE
      <T1:NPVAR{NPVARrec1} 
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1}>


      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = []
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [];
         >

   SUBRULE
      <T1:CNVAR{CNVARrec1} 
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1}>


      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = []
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [];
         >

>
&

\end{verbatim}
