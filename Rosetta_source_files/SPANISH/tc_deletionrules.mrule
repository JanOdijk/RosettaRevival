\newpage
\begin{verbatim}
% TRANSFORMATION TsePassPersproObjdel
< m1: I1::SENTENCE{SENTENCErec1}
                   [ mu1,
                     cliticrel/CLITIC{}[ seCLrel/REFLPRO{REFLPROrec1} ],
                     head/VERB{VERBrec1}[mu2],
                     mu3,
                     predrel/VERBP{VERBPrec1}
                          [ mu4,
                            objrel/I2::NP{NPrec1}[mu5],
                            mu6
                          ],
                     mu7
                   ]
>

< m: I1::SENTENCE{SENTENCErec1}
                   [ mu1,
                     cliticrel/CLITIC{}[ seCLrel/REFLPRO{REFLPROrec1} ],
                     head/VERB{VERBrec1}[mu2],
                     mu3,
                     predrel/VERBP{VERBPrec1}
                          [ mu4,
                            mu6
                          ],
                     mu7
                   ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCErec1.voice = SEpassive
       I2: (NPrec1.NPhead = persproNP)    AND
           (NPrec1.animate = NoAnimate)   AND
           (Accusative IN NPrec1.cases) 
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
