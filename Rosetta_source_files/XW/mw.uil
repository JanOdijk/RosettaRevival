object mw_output_area : XmScrolledText {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
	XmNtopWidget	    = XmLabel mw_translation_label;
	XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn mw_generation_button_box;
        XmNrightAttachment  = XmATTACH_WIDGET;
	XmNrightWidget      = XmFrame mw_generation_frame;
	XmNrightOffset      = spacing;

        arguments text_args;
	XmNeditable         = false;
	XmNeditMode         = XmMULTI_LINE_EDIT;
	XmNcolumns          = 60;
	XmNrows             = 10;
        XmNscrollHorizontal = false;
        XmNwordWrap         = true;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_output_area);
    };
};

