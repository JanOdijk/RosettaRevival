 *                    Rows          : Windows_RowRange
 *                    Column        : Windows_ColumnRange
 *                    Columns       : Windows_ColumnRange
 *                    VideoAttribs  : Windows_VideoAttributeSet
 *                    ReverseAttribs: Windows_VideoAttributeSet
 *  Precondition    : w is opened.
 *  Postcondition   : The specified part of the window is displayed using
 *                    the specified video attributes.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_SetVideoAttrExist (VAR w         : Windows_Window;
                                     Row           : Windows_RowRange;
                                     Rows          : Windows_RowRange;
                                     Column        : Windows_ColumnRange;
                                     Columns       : Windows_ColumnRange;
                                     VideoAttribs  : Windows_VideoAttributeSet;
                                     ReverseAttribs: Windows_VideoAttributeSet);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_SetDefaultVideoAttr
 *  Description     : Changes the way in which the text is displayed.
 *  Parameters      : w             : Windows_Window
 *                    VideoAttribs  : Windows_VideoAttributeSet
 *                    ReverseAttribs: Windows_VideoAttributeSet
 *  Precondition    : w is opened.
 *  Postcondition   : The display attributes are set to the specified video 
 *                    attributes.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_SetDefaultVideoAttr (VAR w        : Windows_Window;
                                       VideoAttribs : Windows_VideoAttributeSet;
                                     ReverseAttribs: Windows_VideoAttributeSet);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_Erase
 *  Description     : Erases Characters in the specified window
 *  Parameters      : w            : Windows_Window
 *                    Row          : Windows_RowRange
 *                    Rows         : Windows_RowRange
 *                    Column       : Windows_ColumnRange
 *                    Columns      : Windows_ColumnRange
 *  Precondition    : w is opened.
 *  Postcondition   : The specified part of the window is filled with spaces.
