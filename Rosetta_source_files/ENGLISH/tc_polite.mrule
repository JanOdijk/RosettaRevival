\newpage
\begin{verbatim}
% TRANSFORMATION Tpolite6 (* is possible/necessary --> would be possible/
                                                                necessary *)
< m1:SENTENCE{SENTENCErec1}
           [mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_dobverbkey){BVERBrec1}]
                  ],
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERBrec2}
                             [head/SUBVERB{SUBVERBrec2}
                                  [head/BVERB(KEY_bebverbkey){BVERBrec2}]
                             ],
                    mu2,
                    predrel/ADJP{ADJPrec1}
                           [mu3,
                            I1: head/ADJ{ADJrec1}[mu4],
                            mu5
                           ],
                    mu6
                   ],
            mu7
           ] 
>

< m :SENTENCE{SENTENCErec2}
           [mu1,
            I4:auxrel/VERB{VERBrec3}
                  [head/SUBVERB{SUBVERBrec3}
                       [I1:head/BVERB(KEY_willBVERBkey){BVERBrec3}]
                  ],
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERBrec2}
                             [head/SUBVERB{SUBVERBrec2}
                                  [head/BVERB(KEY_bebverbkey){BVERBrec2}]
                             ],
                    mu2,
                    predrel/ADJP{ADJPrec1}
                           [mu3,
                            I1:head/ADJ{ADJrec1}[mu4],
                            mu5
                           ],
                    mu6
                   ],
            mu7
           ] 

>
   MATCHCONDITIONS
      <
       I1: ADJrec1.subcs * [modaladj] <> []
       I3: VERBrec1.tense = presenttense
       I4: VERBrec3.tense = pasttense
       m1: SENTENCErec1.mood = yesnointerrogative
       m : SENTENCErec2.mood = yesnointerrogative

      >

<
   SUBRULE (* twee- of drieplaatsig ADJ *)
      <mu1: [I2:mu8] >
      <mu1: [I2:mu8] >

   MATCHCONDITIONS
      <
       I2: EXIST (mu8, [I5:subjrel/NP{NPrec1}[mu9]])
       I5: NPrec1.person IN [1, 2]
      >

      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec1.tense = presenttense) AND
              (ADJrec1.thetaadj IN [adjp120, adjp123, adjp012]) 
              C11: SENTENCErec1.deixis = presentdeixis 
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.deixis := pastdeixis;
              C12: SENTENCErec1.superdeixis = presentdeixis
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.superdeixis := pastdeixis;                  

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
                   VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
                   VERBrec3 :=
                     {
                      numbers     : VERBrec1.numbers
                      persons     : VERBrec1.persons
                      modus       : VERBrec1.modus
                      tense       : pasttense
                     };

         >
      DECOMP
         <
          C1:(SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3)) AND
              (SUBVERBrec1.affix = noaffix)  AND
              (VERBrec3.tense = pasttense) AND
              (ADJrec1.thetaadj IN [adjp120, adjp123, adjp012]) 
              C11: SENTENCErec2.deixis = pastdeixis 
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.deixis := presentdeixis;
              C12: SENTENCErec2.superdeixis = pastdeixis
              A12: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.superdeixis := presentdeixis;                  

              
          A1:SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                     {
                      numbers     : VERBrec3.numbers
                      persons     : VERBrec3.persons
                      modus       : VERBrec3.modus
                      tense       : presenttense
                     };

         >

   SUBRULE (* eenplaatsig ADJ *)
      <mu1: [I2:mu8] >
      <mu1: [I2:mu8] >

   MATCHCONDITIONS
      <
       I2: NOT EXIST (mu8, [I5:subjrel/NP{NPrec1}[mu9]])
       I5: NPrec1.person IN [1, 2]
      >

      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec1.tense = presenttense) AND
              (ADJrec1.thetaadj IN [adjp100, adjp010]) 
              C11: SENTENCErec1.deixis = presentdeixis 
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.deixis := pastdeixis;
              C12: SENTENCErec1.superdeixis = presentdeixis
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.superdeixis := pastdeixis;                  

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
                   VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
                   VERBrec3 :=
                     {
                      numbers     : VERBrec1.numbers
                      persons     : VERBrec1.persons
                      modus       : VERBrec1.modus
                      tense       : pasttense
                     };

         >
      DECOMP
         <
          C1:(SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3)) AND
              (SUBVERBrec1.affix = noaffix)  AND
              (VERBrec3.tense = pasttense) AND
              (ADJrec1.thetaadj IN [adjp100, adjp010]) 
              C11: SENTENCErec2.deixis = pastdeixis 
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.deixis := presentdeixis;
              C12: SENTENCErec2.superdeixis = pastdeixis
              A12: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.superdeixis := presentdeixis;                  

              
          A1:SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                     {
                      numbers     : VERBrec3.numbers
                      persons     : VERBrec3.persons
                      modus       : VERBrec3.modus
                      tense       : presenttense
                     };

         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tpolite6
\item[* relevant examples:] is it possible ....? $\rightarrow$ would it be
possible ..?\\
is it necessary ....? $\rightarrow$ would it be necessary.....?\\
Are you able to...? $\rightarrow$ Would you be able to..?
Am I obligated to...? $\rightarrow$ Would I be obligated to...?
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_polite
\item[* date of creation:] 23-FEB-1990
\item[* author:] Lisette Appelo
\item[* copied from:] Tpolite5a/5b
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] To change {\em is possible/necessary, I am/you are 
able/obligated} into {\em would be possible/necessary, I/you would be
able/obligated}
 to express politeness. For finite 
yesnointerrogative SENTENCEs with presentdeixis, and first or second
person subject only in case of two or more place adjectives.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task) 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:  

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages: 

\end{enumerate}
\item[* relevant literature/documents:] 
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: 
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION Tpolite7 (* would want -> would like *)
< m1:SENTENCE{SENTENCErec1}
           [mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 
>

< m :SENTENCE{SENTENCErec2}
           [mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec3}
                        [head/SUBVERB{SUBVERBrec3}
                             [head/BVERB(KEY_likeBVERbkey){BVERBrec3}]
                        ],
                    mu3
                   ],
            mu4
           ] 

>
   MATCHCONDITIONS
      <
       I1: KEY2 = KEY_wantBVERBkey OR
           KEY2 = KEY_'s_auxverb177' (* want *)
 
       I3: VERBrec1.tense = pasttense

      >


      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1) EXCEPT FOR
                               [persons, numbers, tense, modus]) AND
              (SUBVERBrec1.affix = noaffix) AND
              (SUBVERBrec2 = COPYT_bverbtosubverb(BVERBrec2)) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec2) EXCEPT FOR
                               [persons, numbers, tense, modus]) AND
              (SUBVERBrec2.affix = noaffix) AND
              (SENTENCErec1.deixis = pastdeixis)                  

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
              VERBrec3 :=
                     {
                      numbers     : VERBrec2.numbers
                      persons     : VERBrec2.persons
                      modus       : VERBrec2.modus
                      tense       : VERBrec2.tense
                     };
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.synvpefs := VERBrec3.synvps;

(* thetavp and infsort of like and want asumed to be the same;
   assumed that voice is active and aktionsart is [stative]
*)
         >
      DECOMP
         <
          C1:(SENTENCErec2.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1) EXCEPT FOR
                               [persons, numbers, tense, modus]) AND
              (SUBVERBrec1.affix = noaffix)  AND 
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3) EXCEPT FOR
                               [persons, numbers, tense, modus]) AND
              (SUBVERBrec3.affix = noaffix)  AND 
              (SENTENCErec2.deixis = pastdeixis)
              
          A1:KEY2 := KEY_'s_auxverb177'; (* want *) 
             SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec2);
             VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
             VERBrec2 :=
                     {
                      numbers     : VERBrec3.numbers
                      persons     : VERBrec3.persons
                      modus       : VERBrec3.modus
                      tense       : VERBrec3.tense
                     };
              SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.synvpefs := VERBrec2.synvps;
  
         >

&

\end{verbatim}
