              NPrec1.genero := fem
         >


   SUBRULE
      < T1:BPERSPRO(KEY_elloBPERSPROkey){BPERSPROrec1}>
      < >

      COMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 3)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
