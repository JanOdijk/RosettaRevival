                               mood      : NPVARrec1.mood
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 } AND
              rel1 = objrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 10b. x1 refer (EMPTY) to x2 *)
       <T1: EMPTYVAR{EMPTYVARrec1} 
        T2: CNVAR{CNVARrec1}>

       <T1: EMPTYVAR{EMPTYVARrec1} 
        T2: CNVAR{CNVARrec1}>

      COMP
         <
          C1: synEMPTY_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := objrel
         >
      DECOMP
         <
          C1: synEMPTY_PREPNP IN VERBrec1.synvps AND
              synEMPTY_PREPNP IN VERBPPROPrec2.synvpefs 
              AND
              VARPREPPrec1 = { synppefs NI synNP 
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              rel1 = objrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 11 x1 advise (EMPTY) against x3 *)
      < T1: EMPTYVAR{EMPTYVARrec1} 
        T2: NPVAR{NPVARrec2} >

      < T1: EMPTYVAR{EMPTYVARrec2} 
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synEMPTY_PREPOPENGERUND IN VERBrec1.synvps AND
              NPVARrec2.NPhead = openIngNP
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_PREPOPENGERUND];
              VARPREPPrec1 := { headkey     : PREPrec1.key
                                actsubcefs  : PREPrec1.subcs
                                synppefs    : [synOPENGERUND]
                                mood        : NPVARrec2.mood
                                specQ       : NPVARrec2.specQ
                                class       : PREPrec1.class
                                aspect      : PREPrec1.aspect
                                deixis      : PREPrec1.deixis
                                retro       : PREPrec1.retro
                                thetapp     : pp120 } ;
              rel1 := objrel
         >
      DECOMP
         <
          C1: synEMPTY_PREPOPENGERUND IN VERBrec1.synvps AND
              synEMPTY_PREPOPENGERUND IN VERBPPROPrec2.synvpefs AND
              NPVARrec2.NPhead = openIngNP AND
              VARPREPPrec1 = { synppefs   NI synOPENGERUND
                               mood        : NPVARrec2.mood
                               specQ       : NPVARrec2.specQ
                               thetapp     : pp120 }  AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 12a. x1 leave x2 up tp x3 *)
      <T1:SENTENCEVAR{SENTENCEVARrec1} 
       T2:NPVAR{NPVARrec1}>

      <T1:SENTENCEVAR{SENTENCEVARrec1} 
       T2:NPVAR{NPVARrec1}>

      COMP
         <
          C1: synOPENGERUND_PREPNP IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { senttype   : subordinateclause
                                  PROsubject : true
                                  finiteness : infinite
                                  infsort    : opening }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENGERUND_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENGERUND_PREPNP IN VERBrec1.synvps AND
              synOPENGERUND_PREPNP IN VERBPPROPrec2.synvpefs AND
              SENTENCEVARrec1 = { senttype   : subordinateclause
                                  PROsubject : true
                                  finiteness : infinite
                                  infsort    : opening } AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec2.mood 
                               specQ     : NPVARrec2.specQ
                               thetapp   : pp120 }  AND
              rel1 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 12b. x1 leave x2 up to x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1} 
        T2: CNVAR{CNVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1} 
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synOPENGERUND_PREPNP IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { senttype   : subordinateclause
                                  PROsubject : true
                                  finiteness : infinite
                                  infsort    : opening }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENGERUND_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENGERUND_PREPNP IN VERBrec1.synvps AND
              synOPENGERUND_PREPNP IN VERBPPROPrec2.synvpefs AND
              SENTENCEVARrec1 = { senttype   : subordinateclause
                                  PROsubject : true
                                  finiteness : infinite
                                  infsort    : opening } AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec2.mood 
                               specQ     : NPVARrec2.specQ
                               thetapp   : pp120 }  AND
              rel1 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TVerbpattern8
\item[* relevant examples:] in general: DONP\_PREP..
\begin{description}
\item[subrule 1a/b:] DONP\_PREPOPENNPPROP\\
  (vp012): turn x1 into x2: He turned into a frog (unless this is a 
  PREPCLOSEDNPPROP, and the verb has only one argument)\\
  (vp123): x1 name x2 as x3: The President named him as Secretary of State\\
  (vp123): x1 regard x2 as x3: They regard her as a friend\\
  (vp123): x1 turn x2 into x3: We turned our back yard into a workshop\\
  (vp123): x1 mistake x2 for x3: I mistook you for somebody else\\
  (vp123): ?x1 name x2 after x3: They named him after his father\\
  (vp123): ?x1 charge x2 on x3: They charge a tax on imported bottles of wine\\
  (vp123): x1 allow x2 on x3: The bank allows 5 per cent (interest) on money 
kept with it\\
  (vp123): ?x1 ask x2 for x3: How much are you asking(/do you want) for that 
  painting?\\
  (It is assumed that `How much' is not a measure phrase. Perhaps the prep-part 
  of the last two examples
  is not an argument; however, the specific translation of `for' and `on' seems 
  to depend on the verb)\\
The general strategy that has been devised in case of doubt between the 
patterns DONP\_PREPOPENNPPROP and DONP\_PREPNP is to choose the first pattern 
when at least some relation between the two arguments seems present; the second 
pattern is only for those cases where no relation exists.
Note that the surface realisation of the two patterns will 
  usually be the same.
\item[subrule 2a/b:] DONP\_PREPOPENADJPPROP\\
  (vp123): x1 change x2 (from x3a) to x3b: We changed the main colour from 
brown to red\\
  (vp123): x1 regard x2 as x3: We regard her as clever\\
It is assumed that the colour names are treated as adjectives. If they are 
nouns, no special rule for them seems necessary (cf. we changed the main 
ingredient from water to milk)
\item[subrule 3a/d:] DONP\_PREPNP\\
  (vp123): x1 give x2 to x3: I gave the book to John
\item[subrule 4a/b:] DONP\_PREPOPENGERUND (now considered NPs!)\\
  (vp123): x1 talk x2 out of x3: They talked him out of jumping from the 
  top of the building   (see below under REMARKS) \\
  (vp123): x1 keep x2 from x3: Can't you keep him from forgetting?\\
  (vp123): x1 regard x2 as x3: I regard him as being without principles
\item[subrule 5a/b:] CLOSEDADJPPROP\_PREPNP\\
  (vp012): seem x1 to x2: He seemed ill to me
\item[subrule 6a/b:] CLOSEDNPPPROP\_PREPNP\\
  (vp012): seem x1 to x2: He seemed a fool to me
\item[subrule 7a/b:] OTHERCLOSEDPREPPPPROP\_PREPNP\\
  (vp012): seem x1 to x2: He seemed against the analysis to me
\item[subrule 8a/b:] DONP\_PREPOTHEROPENPREPPPROP\\
  (vp123): x1 regard x2 as x3: I regard him as without principles
\item[subrule 9a/b:] DONP\_PREPQSENT\\
  (vp123): x1 instruct x2 in x3: They instructed him in how to do it
\item[subrule 10a/b:] EMPTY\_PREPNP\\
  (vp123): x1 refer (EMPTY) to x3: We refer to the manager (see below under 
REMARKS)\\
\item[subrule 11:] EMPTY\_PREPOPENGERUND\\
  (vp123): x1 advise (EMPTY) against x3: I strongly advise against eating 
British beef.
\item[subrule 12a/b:]OPENGERUND\_PREPNP\\
  (vp123): x1 leave x2 to x3: I'll leave cleaning to you
\end{description}
\item[* language:] (Dutch, English, Spanish) english
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] (name of rule, transformation or filter class)TC: 
Verbpatternrules
\item[* date of creation:] 09-DEC-1987
\item[* author:] Margeet Sanders
\item[* copied from:] Dutch RVerbpattern10, 11, 12
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 30/08/88\ \ \ \ \ author: margreet sanders, jan odijk. SpecQ, 
aspect, class, deixis, retro. For comment, see Verbpattern 6.
\item date: 08/06/90\ \ \ \ \ author:Petra de Wit
Added subrules 9,10,11,12 (for comment see above)
\end{enumerate}
\item[* task:] Checks if the category of the variables is compatible with the 
category of the arguments that the verb expects. The rule also introduces the 
preposition and the prep-phrase necessary for the prepositional object. Note 
that the first argument should be the direct object. If the first argument is 
the indirect object or goal or simply the argument that does not translate into 
a direct object, the verb is covered in the next transformation, TVerbpattern9.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] each subrule 
handles a specific verbpattern
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\
Values for the attribute `synvps' for basic verbs
\item rules:\\
these transformations follow the startrules
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc.\ nr.\ 108 (Verbpatterns in 
Rosetta3)
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item real remarks:\\
Note that the gerund in subrule 3 receives the ordinary objrel in the 
prepp (cf.\ elsewhere, where a complrel is assumed for gerunds)\\
Note that subrule 10 is only meant to deal with structures where the EMPTY is 
in objrel. This allows us to conclude that prepkey1 is the relevant prepkey to 
look at. For verbs that allow an empty prepobjrel, we introduced a special 
pattern synEMPTY_PREP2NP (for comment see tverbpattern10).
\item problems:\\
\item modifications:\\

\end{enumerate}
\end{description}


