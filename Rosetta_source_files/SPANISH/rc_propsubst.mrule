             [ leftdislocrel/SENTENCE{SENTENCErec1}[mu4],
               mu1,
               predrel/VERBP{VERBPrec1}
                       [ head/VERB{VERBrec1}[mu5],
                         cliticrel/CLITIC{CLITICrec1}
                             [mu6,
                              tresclrel/PERSPRO{PERSPROrec1}
                                       [head/BPERSPRO(AUX_elbpersprokey)
                                                                {BPERSPROrec1}]
                             ],
                         I1:mu2,
                         I2:mu3
                       ],
                mu7
             ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2,[objrel/T1])
       I2: NOT EXIST(mu3,[objrel/T1])
