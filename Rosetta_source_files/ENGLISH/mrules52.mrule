\newpage
\begin{verbatim}
% RULE ROrdinalform
< m1:BADJSUFF(KEY_ordBADJSUFFkey){BADJSUFFrec1}
  m2:CARD{CARDrec1}[mu1]
>

< m :SUBADJ{SUBADJrec1}
     [ modrel/CARD{CARDrec1}[mu1],
       head/BADJSUFF(KEY_ordBADJSUFFkey){BADJSUFFrec1} 
     ]
>
      COMP
         <
          C1:TRUE
          A1:SUBADJrec1 := COPYT_badjtosubadj(BADJSUFFrec1);
             SUBADJrec1.affix := ordaffix;
         >
      DECOMP
         <
          C1:SUBADJrec1 = COPYT_badjtosubadj(BADJSUFFrec1) 
                                        EXCEPT FOR [affix] AND
             SUBADJrec1.affix = ordaffix
          A1:@
         >

&

\end{verbatim}
