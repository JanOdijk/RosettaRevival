pragma C_include('listree.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE GlobSubst;
WITH LISTREE;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : GlobSubst_Init
 *  Description     : Initialization function of the GlobSubst module.
 *  Parameters      : none
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE GlobSubst_Init;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : GlobSubst_Push
 *  Description     : Puts both parameters on top of the substitution S-tree
 *                    stack.
 *  Parameters      : index: INTEGER;
 *                    subst: LISTREE_pStree;
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE GlobSubst_Push(index: INTEGER;
                                    subst: LISTREE_pStree);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : GlobSubst_Pop
 *  Description     : Removes top values from substitution S-tree stack.
 *  Parameters      : none
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE GlobSubst_Pop;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : GlobSubst_Get
 *  Description    : Gives S-tree belonging to specified index.
 *  Parameters     : index: INTEGER;
 *  Result         : LISTREE_pStree;
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION GlobSubst_Get(index: INTEGER)
                    : LISTREE_pStree;
EXTERNAL;


END {GlobSubst};
