SPANISH 14
&
\section{ General}

This rule class contains the following members:
\begin{enumerate}
  \item OPENADJPPROP as complrel
  \item CLOSEDADJPPROP as complrel
  \item OPENADVPPROP as locargrel, dirargrel
  \item OPENNPPROP as complrel
  \item CLOSEDNPPROP as complrel
  \item OPENPREPPPROP as locargrel
  \item CLOSEDPREPPPROP as locargrel
  \item OPENPREPPPROP as dirargrel
  \item CLOSEDPREPPPROP as dirargrel
  \item CLOSEDPREPPPROP as complrel
  \item OPENVERBPPROP as complrel   **
  \item CLOSEDVERBPPROP as complrel **
  \item SENTENCE in ADVPPROP  (* graag-like  etc  -> propsubst2 *)
  \item SENTENCE in ADVPPROP  (* toevallig-happen  -> propsubst2 *)
  \item SENTENCE in VERBPPROP (* futuro  -> propsubst2 *)
  \item SENTENCE as complrel
  \item OPENADJPPROP as prepobjrel
  \item CLOSEDADJPPROP as prepobjrel
  \item OPENNPPROP as prepobjrel
  \item CLOSEDNPPROP as prepobjrel
  \item SENTENCE as prepobjrel
  \item SENTENCE as "subjrel"
  \item SENTENCE as "extraposrel"  (* het verbaast me dat hij komt etc. *)
  \item SENTENCE as leftdislocrel
  \item OPENADJPPROP as postsentadvrel (* vloer schoon poetsen*)(*EP; 14/3/91*)  
\end{enumerate}

** means : still to be added

!!modification: JO  2-SEP-1988 11:38:37 added mu7 to the right of VERBP, 
 everywhere 
\section{Rules}
\newpage
\begin{verbatim}
%
% RULE ROPENADJPPROPsubstitution
< m1:VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ mu2,
                         complrel/ADJPPROPVAR{ADJPPROPVARrec1},
                         mu3 
                       ],
                mu7
              ] 

SUBST:
  m2: OPENADJPPROP{OPENADJPPROPrec1}[ mu4 ]         (* substituent *)
>

< m :VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ mu2,
                         complrel/OPENADJPPROP{OPENADJPPROPrec1}[mu4],
                         mu3 
                       ],
                mu7
              ] 
>


      PARAMETERS
         <
          LEVEL
         >

      COMP
         <
          C1:  ADJPPROPVARrec1.index = LEVEL  AND
               (synDONP_OPENADJPPROP IN VERBPPROPrec1.synvpefs OR
               (resAP IN VERBPPROPrec1.adjuncts  AND 
                OPENADJPPROPrec1.actsubcefs * [coloradj, measureadj] <> [])) 
	       C11: ADJPPROPVARrec1 = 
                    COPYT_ADJPPROPtoVAR(OPENADJPPROPrec1) (* !! *)
	       A11: @  
          A1: @
         >

      DECOMP
         <
          C1: (synDONP_OPENADJPPROP IN VERBPPROPrec1.synvpefs OR
               (resAP IN VERBPPROPrec1.adjuncts AND 
                OPENADJPPROPrec1.actsubcefs * [coloradj, measureadj] <> []))
	       C11: true
	       A11: ADJPPROPVARrec1 := 
                    COPYT_ADJPPROPtoVAR(OPENADJPPROPrec1) 
          A1: ADJPPROPVARrec1.index := LEVEL
         >

&

\end{verbatim}
