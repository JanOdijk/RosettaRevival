\newpage
\begin{verbatim}
% RULE RLocAdvSubst             (* locadvrel,sentadvrel/PREPP,ADVP *)
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}[mu2],
              mu3,
              I1:rel1/T1,
              mu6 
            ] 

  SUBST:
  m2: T2
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}[mu2],
              mu3,
              I2:rel1/T3,
              mu6 
            ] 
>

   MATCHCONDITIONS
      <
       m2: T2.CAT IN [PREPP, VARPREPP, ADVP] AND
           QUOTE_Gsubstordercondition1(mu6, T2, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T2) 
       m : QUOTE_substordercondition1(mu6, CLAUSErec1.prosubject)
       I1: (T1.CAT IN [PREPPVAR, ADVPVAR] WITH T1.REC.index = LEVEL) AND
           rel1 IN [locadvrel,sentadvrel]
       I2: T3.CAT IN [PREPP, VARPREPP, ADVP] AND
           NOT QUOTE_NegPhrase(T3)           AND
           rel1 IN [locadvrel,sentadvrel]
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* 1. PREPP *)
      < T1: PREPPVAR{PREPPVARrec1} 
        T2: PREPP{PREPPrec1}[mu4]  >
      < T3: PREPP{PREPPrec2}[mu4]  >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_preppTOvar(PREPPrec1) AND
              PREPPrec1.mood <> topicmood AND
              [loc,caus] * PREPPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              PREPPrec1.superdeixis)
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: [loc,caus] * PREPPrec2.actsubcefs  <> [] AND
              PREPPrec2.superdeixis = omegadeixis AND
              PREPPrec2.mood <> topicmood
          A1: PREPPVARrec1 := COPYT_preppTOvar(PREPPrec2);
              PREPPVARrec1.index := LEVEL;
              PREPPrec1 := PREPPrec2;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 PREPPrec1.superdeixis)
         >

   SUBRULE (* 2. VARPREPP *)
      < T1: PREPPVAR{PREPPVARrec1} 
        T2: VARPREPP{VARPREPPrec1}[mu4]  >
      < T3: VARPREPP{VARPREPPrec2}[mu4]  >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_preppTOvar(VARPREPPrec1) AND
              VARPREPPrec1.mood <> topicmood AND
              [loc,caus] * PREPPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              VARPREPPrec1.superdeixis)
          A1: VARPREPPrec2 := VARPREPPrec1;
              VARPREPPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: [loc,caus] * PREPPrec2.actsubcefs  <> [] AND
              VARPREPPrec2.superdeixis = omegadeixis AND
              VARPREPPrec2.mood <> topicmood
          A1: PREPPVARrec1 := COPYT_preppTOvar(VARPREPPrec2);
              PREPPVARrec1.index := LEVEL;
              VARPREPPrec1 := VARPREPPrec2;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 VARPREPPrec1.superdeixis)
         >

   SUBRULE (* 3. ADVP *)
      < T1: ADVPVAR{ADVPVARrec1} 
        T2: ADVP{ADVPrec1}[mu5]  >
      < T3: ADVP{ADVPrec2}[mu5]  >

      COMP
         <
          C1: ADVPVARrec1 = COPYT_advpTOvar(ADVPrec1) AND
              ADVPrec1.mood <> topicmood AND
              locadv IN ADVPrec1.actsubcefs AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              ADVPrec1.superdeixis)
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: locadv IN ADVPrec2.actsubcefs  AND 
              ADVPrec2.mood <> topicmood AND
              ADVPrec2.superdeixis = omegadeixis
          A1: ADVPVARrec1 := COPYT_advpTOvar(ADVPrec2);
              ADVPVARrec1.index := LEVEL;
              ADVPrec1 := ADVPrec2;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 ADVPrec1.superdeixis)
         >
>
&
\end{verbatim}
