PROCEDURAL PART
VAR str:TSTRING_string;
    id::ident;
    headtable,exporttable::setofidents;
BEGIN
INIT: BEGIN \cofenv1.\GLOBAL. "{*" \\ 
            initsetofidents(headtable);
            initsetofidents(exporttable);
      END;
<*
1: <*SEND: BEGIN END
     !.
     RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !GRAPH.
      RECEIVE: BEGIN APPENDfile(%%GRAPH.make,cofenv1);
                     "BEGIN"\\
                     ""str"" ":=GRAPH"\\
                     "END;"\\
               END
   *>
3: <* SEND: BEGIN str:=%.str;
            "SUBGRAMMAR"\\
            ""str""\\
            "FUNCTION " ""str"" ":LDMRULES_pCtrlExpr;"\\
            END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN id.str:=%CATNAME.str;appendident(id,headtable) END
      !.
      RECEIVE: BEGIN END
   *>
5: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
9: <* SEND: BEGIN id.str:=%CATNAME.str;appendident(id,exporttable) END
      !.
      RECEIVE: BEGIN END
   *>
10:<* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
11:<* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
12:<* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN \cofenv1.\GLOBAL.
             "*"\\
             WHILE stillidents(headtable) DO
               BEGIN
               takeident(id,headtable);
               ""id.str""\\
               END;
             "*"\\
             WHILE stillidents(exporttable) DO
               BEGIN
               takeident(id,exporttable);
               ""id.str""\\
               END;
             "*"\\
             "}" \\ 
      END
END;
