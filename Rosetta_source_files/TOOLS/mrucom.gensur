    *>
39: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION:TRUE
               #ACTION: BEGIN haakjescounter:=haakjescounter-1 END
    *>
FINAL: #CONDITION:haakjescounter=0
       #ACTION: BEGIN SEND_PASCALEXPR;
                      IF catpresent AND inpresent THEN
                        BEGIN
                        vartype.varname:=str1;
                        vartype.cattable:=cattable;
                        END
                      ELSE TSTRING_constantempty(vartype.varname);
                      $PASCALEXPR.vartype:=vartype
                END
*>
END;
PROCEDURAL PART
VAR commatchfile,commatchfile1,helpfile,casefile,decommatchfile:LOCALFILE;
    string,waarde:TSTRING_string;
    found,found1:BOOLEAN;
    vartypes,vartypes1::setofvartypes;
    vartype,vartype1::vartype;
    cattable,cattable1::setofidents;
    cat::ident;
    str1,str2,str3,str4:TSTRING_string;
    allexistcounter:INTEGER;
    varkind,varkind1::varkindtype;
    notpresent,before,after,inaanwezig,haakjetoegevoegd,nogeenhaakje,
    uitgesteldhaakje:BOOLEAN;
    haakjesopen, zoalsbijIN:INTEGER;
BEGIN
INIT: BEGIN
        nogeenhaakje:=FALSE;
        uitgesteldhaakje:=FALSE;
        haakjetoegevoegd:=FALSE;
        inaanwezig:=FALSE;
        haakjesopen:=0;
        after:=FALSE;
        before:=FALSE;
        notpresent:=FALSE;
        vartypes:=$$PASCALEXPR.vartypes;
        allexistcounter:=$$PASCALEXPR.allexistcounter;
        found:=FALSE;
        INITLOCALFILE(commatchfile); 
        INITLOCALFILE(commatchfile1); 
        INITLOCALFILE(casefile); 
        INITLOCALFILE(helpfile); 
        INITLOCALFILE(decommatchfile); 
      END;
<*
1: <* SEND: BEGIN inaanwezig:=TRUE; zoalsbijIN:=haakjesopen END
      !.
      RECEIVE: BEGIN 
               \commatchfile.\LOCAL. 
                   " IN "
               END
   *>
2: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN 
                 str3:=%VARNAME.str1;
                 str4:=%VARNAME.str2;
                 string:=%%VARNAME.string;
                 varkind1:=%VARNAME.varkind;
                 IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec) THEN
                   BEGIN
                   \commatchfile.\LOCAL.
                   ""string""
                   END
                 ELSE
                   BEGIN
                   after:=true;
                   vartypes1:=vartypes;
                   found:=FALSE;
                   WHILE stillvartypes(vartypes1) DO
                         BEGIN
                         takevartype(vartype1,vartypes1);
                         found1:=TSTRING_compare(str3,vartype1.varname)=0;
                         if found1 then 
                           begin
                           found:=TRUE;
                           vartype:=vartype1
                           end;
                         END;
                   IF found THEN cattable:=vartype.cattable
                     ELSE writeln('ERROR, ',str3,'.REC not guarded');
                   END;
               END
   *>
3: <* SEND: BEGIN END
      !VALUENAME.
      RECEIVE: BEGIN
                 string:=%%VALUENAME.string;
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   ""string""
                 END;                 
               END
   *>
4: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN
                 str1:=%VARNAME.str1;
                 str2:=%VARNAME.str2;
                 string:=%%VARNAME.string;
                 varkind:=%VARNAME.varkind;
                 IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec) THEN
                   BEGIN
                   \commatchfile.\LOCAL.
                   ""string""
                   END
                 ELSE
                   BEGIN
                   before:=TRUE;
                   vartypes1:=vartypes;
                   found:=FALSE;
                   WHILE stillvartypes(vartypes1) DO
                         BEGIN
                         takevartype(vartype1,vartypes1);
                         found1:=TSTRING_compare(str1,vartype1.varname)=0;
                         if found1 then 
                           begin
                           found:=TRUE;
                           vartype:=vartype1
                           end;
                         END;
                   IF found THEN cattable:=vartype.cattable
                     ELSE writeln('ERROR, ',str1,'.REC not guarded');
                   END;
               END
   *>
