\begin{verbatim}
% RULE RNPformation5      (*  .. + NOUN + posrel --> detrel + [..  + NOUN] *)

< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec3}[mu6],
                 mu7,
                 posrel/NP{NPrec1}
                       [head/PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}]
                       ]
                ]
>

< m : NP{NPrec2}[detrel/POSSADJ{POSSADJrec1}[head/BPERSPRO{BPERSPROrec1}] ,
                 mu1,
                 head/CN{CNrec1}[mu1,
                                 head/NOUN{NOUNrec3}[mu6],
                                 mu7
                                 ]
                ]
>
   MATCHCONDITIONS
      <
               m: NPrec2 = { 
                      persona   : 3
                      NPhead    : otherNP
                     }

      >


      COMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaAspecto
		  retro         : false
		  definite      : def
		  persona       : PERSPROrec1.persona
		  numero        : PERSPROrec1.numero
		  cases         : []
		  genero        : PERSPROrec1.genero
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : omegageneric
		  syntquant     : omegaquant
		  NPhead        : PERSPROrec1.NPhead
		  specQ         : yesspec
		  } AND
              PERSPROrec1 = COPYT_BTOPERSPRO(BPERSPROrec1)
             C11: masc IN NOUNrec3.generos
                  C111: NOUNrec3.numero = singular
                  A111: POSSADJrec1.concordnumero := sing;
                  C112: NOUNrec3.numero = plural
                  A112: POSSADJrec1.concordnumero := plur;
             A11: NPrec2.genero := masc;
             C12: fem IN NOUNrec3.generos
                  C121: NOUNrec3.numero = singular
                  A121: POSSADJrec1.concordnumero := sing;
                  C122: NOUNrec3.numero = plural
                  A122: POSSADJrec1.concordnumero := plur;
             A12: NPrec2.genero := fem;

          A1: NPrec2 := { posspred          : true
                          definite          : def 
                          possnietnp        : false
                          mood              : declxpmood

                          numero            : NOUNrec3.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         };  
         >

      DECOMP
         <
          C1: POSSADJrec1.antecedent = noant AND
              NPrec2 = { posspred          : true
                          definite          : def 
                          possnietnp        : false
                          mood              : declxpmood

                          numero            : NOUNrec3.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         }  
             C11: masc IN NOUNrec3.generos AND
                  NPrec2.genero = masc
                  C111: NOUNrec3.numero = singular AND
                        POSSADJrec1.concordnumero = sing
                  A111: @
                  C112: NOUNrec3.numero = plural AND
                         POSSADJrec1.concordnumero = plur
                  A112: @
             A11: @
             C12: fem IN NOUNrec3.generos
                  C121: NOUNrec3.numero = singular AND
                        POSSADJrec1.concordnumero = sing
                  A121: @
                  C122: NOUNrec3.numero = plural AND
                         POSSADJrec1.concordnumero = plur
                  A122: @
             A12: NPrec2.genero := fem;
          A1: PERSPROrec1 := COPYT_BTOPERSPRO(BPERSPROrec1);
              NPrec1 := 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaAspecto
		  retro         : false
		  definite      : def
		  persona       : PERSPROrec1.persona
		  numero        : PERSPROrec1.numero
		  cases         : []
		  genero        : PERSPROrec1.genero
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  actcomas      : [count]
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : omegageneric
		  syntquant     : omegaquant
		  NPhead        : PERSPROrec1.NPhead
		  specQ         : yesspec
		  } 
               >
&


\end{verbatim}
\newpage
\begin{description}
\item[* name:] RNPformation5
\item[* relevant examples:] 
libro yo --> mi libro, etc
\item[* language:] Spanish
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) NPformationrules
\item[* date of creation:] 26-JAN-1989 16:05:19  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Changing a postnominal 'posrel' (modification of a CN 
containing a NOUN), into a prenominal 'detrel'. 
(libro yo --> mi libro, etc.)
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
SUBRULE 2 and 5: In analysis both the reduced and the non-reduced form of the
POSSADJ are accepted. Only the non-reduced form is generated.                 
