\begin{verbatim}

%RULE RIDSTARTVPPROP1VAR2ID0

<m1: I1::SUBVERB{SUBVERBREC1}[head/BVERB(KEY1){BVERBREC1}]
 m2: T1
>

<m: I4::VERBPPROP{VERBPPROPREC1}
       [ I2:subjrel/T1, 
         predrel/VERBP{VERBPREC1}
              [ head/I5::VERB{VERBREC1}
                   [ head/SUBVERB{SUBVERBREC1}[head/BVERB(KEY3){BVERBREC2}]
                   ],
                objrel/NP{NPREC1}[detrel/DETP{DETPREC1}
                                       [head/ART(KEY4){ARTREC1}],
                                  head/CN{CNREC1}
                                       [head/NOUN{NOUNREC1}
                                           [head/SUBNOUN{SUBNOUNREC1}
                                               [head/BNOUN(KEY2){BNOUNREC1}]
                                           ]
                                        ]
                                  ]
              ]
       ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBrec1.thetavp = vp120 
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
       I4: VERBPPROPrec1 =
		  { 
		   thetavp     : vp120
		   req         : [ pospol, negpol, omegapol]
		   env         : [ pospol, negpol, omegapol]
		   superdeixis : Omegadeixis
		   PROsubject  : false
		   voice       : omegavoice
		   synvpefs    : [synNP]
                   aktionsarts : []
		  }

       I5: VERBrec1 =
		  { 
                   thetavp      : vp120
		   numbers      : []
		   persons      : []   
		   modus        : omegamodus  
		   tense        : omegatense  
		  }
      >

COMP
 <
   C1: COMPINIDDICT(KEY1, vpid2)
      C11: true
      A11: SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC2);
           VERBREC1 := COPYT_subverbtoverb(SUBVERBREC1);
           SUBNOUNREC1 := COPYT_bnountosubnoun(BNOUNREC1);
           NOUNREC1 := COPYT_subnountonoun(SUBNOUNREC1);
           CNREC1 := COPYT_nountocn(NOUNREC1);
           NPREC1 := COPYT_cntonp(CNREC1);
           NPREC1.definite:=def;
           NPREC1.superdeixis := omegadeixis;
           NPREC1.generic := omegageneric;
           CNREC1.superdeixis := omegadeixis;           
           VERBPPROPREC1.synvpefs := [synNP];
   A1: <KEY3,KEY4,KEY2> := COMPGETIDDICT(KEY1, vpid2);
       VERBPPROPrec1.thetavp := vp120;
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY3,KEY4,KEY2>, vpid2)
      C11: SUBVERBREC1 = COPYT_bverbtosubverb(BVERBREC2) AND
           VERBREC1 = COPYT_subverbtoverb(SUBVERBREC1)   AND
           SUBNOUNREC1 = COPYT_bnountosubnoun(BNOUNREC1) AND
           NOUNREC1 = COPYT_subnountonoun(SUBNOUNREC1)   AND
           CNREC1 = COPYT_nountocn(NOUNREC1)             AND
           NPREC1 = COPYT_cntonp(CNREC1) 
                    EXCEPT FOR [specQ, NPhead, syntquant, possRform, generic,
                                mood, possnietnp, posspred, actcomas, number,
                                person, definite]        AND
           NPREC1.superdeixis = omegadeixis              AND
           NPREC1.generic = omegageneric                 AND
           CNREC1.superdeixis = omegadeixis
      A11: @
   A1: KEY1 := DECOMPGETIDDICT(<KEY3,KEY4,KEY2>, vpid2) 
 >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] RIDSTARTVPPROP1VAR2ID0
\item[* relevant examples:] x1 kick the bucket, Mary kicks the bucket
\item[* language:]  English
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] RC:Startverbprules
\item[* date of creation:] 21-JUNE-1988 15:20:00  
\item[* author:] Andre\'{e} Schenk
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] On the basis of an skey in idiom dictionary keys are looked up;
these are placed in the relevant slots in the model. One argument is placed in
subject position and one inside the VERBP; the argument NP in VERBP is part of
an idiom. The keys of all leaves are represented in the dictionary, also for 
words that are introduced syncategorematically otherwise. This is done because 
if this were not the case there would be too many rules. In the case of this 
rule there would have to be rules for the definite and indefinite article.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of 
parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] Function-application and "thematic role" .
assignment.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ Attribute thetavp with BVERBs.

\item rules:\\ This is the first rule-class.

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{} The number of arguments should remain 
the same.
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc. nr. 273 ??
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

