\newpage
\begin{verbatim}
% TRANSFORMATION TADJmostNOTTOst                           (* regel2: *)


< m1: ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      degreemodrel/QP{QPrec1}
                                         [mu3,
                                          head/Q(AUX_mostQkey){Qrec1}
                                         ],
                                      head/I1::ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                              ]
>

< m : ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [I2:mu2,
                                      degreemodrel/QP{QPrec1}
                                         [mu3,
                                          head/Q(AUX_mostQkey){Qrec1}
                                         ],
                                      head/I1::ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                            ]
>
   MATCHCONDITIONS
      <I1: morecomp IN ADJrec1.compformations AND
           ADJrec1.compform = basic
       I2: NOT EXIST(mu2, [premodrel/..])
       I3: ALL(mu3, premodrel/..)
      >

<
   SUBRULE
      <mu3: [mu6] >
      <mu3: [mu6] >

   MATCHCONDITIONS
      <
       mu3: EXIST(mu6, [artrel/ART(KEY_theARTkey){ARTrec1}])
      >

      COMP
         <
          C1: true
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.actuseefs :=   ADJrec1.uses * [predicative];

         >
      DECOMP
         <
          C1: ADJPrec2.actuseefs * ADJrec1.uses <> []  AND
              predicative IN ADJPrec2.actuseefs 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.actuseefs := [];
         >

   SUBRULE
      <mu3: [mu6, 
             artrel/ART(KEY_theARTkey){ARTrec1}
            ] 
      >
      <mu3: [mu6] >

   MATCHCONDITIONS
      <
       mu3: NOT EXIST(mu6, [artrel/ART(KEY_theARTkey){ARTrec1}])
      >

      COMP
         <
          C1: true
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.actuseefs :=   ADJrec1.uses * [predicative];

         >
      DECOMP
         <
          C1: ADJPrec2.actuseefs * ADJrec1.uses <> []  AND
              [predicative] * ADJPrec2.actuseefs = []
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.actuseefs := [];
         >
>

&

\end{verbatim}
