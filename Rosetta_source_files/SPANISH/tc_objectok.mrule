\newpage
\begin{verbatim}
% TRANSFORMATION TObjectok4a (* not-passive, ergative, object(def) -> object *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             I4:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      I2:objrel/T1,                      
                      mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             subjrel/PRONPVAR{PRONPVARrec1},
             I4:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      I2:objrel/T1,
                      mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1:  (CLAUSErec1.thetavp IN [vp010])                    AND
            NOT (CLAUSErec1.voice IN [Passive,SEpassive])      AND
            (CLAUSErec1.synvpefs * AUX_ergativeclosedvps = [])
       I2:  T1.CAT IN [NP,NPVAR,CNVAR]
       I3:  ALL (mu1, I31:rel1/..)
       I31: rel1 IN AUX_presubjrels
       I4:  NOT EXIST (mu8, [subjrel/..]) AND
            NOT EXIST (mu8, [I41:rel2/..])
       I41: rel2 IN AUX_presubjrels
      >


<
   SUBRULE (*4a*)
      <T1: NP{NPrec1}[mu9] >
      <T1: NP{NPrec1}[mu9] >

      COMP
         <
          C1: NPrec1.definite = def AND
              [NPrec1.NPhead] * [redelloNP, redellosNP, persproNP] = []
          A1: PRONPVARrec1 := 
                       {  req            : NPrec1.req
                          env            : NPrec1.env
                          supertiempo    : NPrec1.supertiempo
                          class          : NPrec1.class
                          tiempo         : NPrec1.tiempo
                          aspecto        : NPrec1.aspecto
                          retro          : NPrec1.retro
                          persona        : NPrec1.persona
                          genero         : NPrec1.genero
                          actsubcs       : NPrec1.actsubcs
                          temporal       : NPrec1.temporal
                          animate        : NPrec1.animate
                          human          : NPrec1.human
                          actcomas       : NPrec1.actcomas
                          mood           : NPrec1.mood
                          numero         : NPrec1.numero
                          definite       : NPrec1.definite
                          generic        : NPrec1.generic
                          thetanp        : NPrec1.thetanp
                          nounpatternefs : NPrec1.nounpatternefs
                          posspred       : NPrec1.posspred
                          possnietnp     : NPrec1.possnietnp
                          syntquant      : NPrec1.syntquant
                          NPhead         : NPrec1.NPhead
                          SpecQ          : NPrec1.SpecQ
                          DefSpec        : NPrec1.DefSpec
                          cases          : NPrec1.cases
                          index          : 0
                       }
         >

      DECOMP
         <
          C1: (NPrec1.definite = def) AND
              (PRONPVARrec1 = 
                       {  req            : NPrec1.req
                          env            : NPrec1.env
                          supertiempo    : NPrec1.supertiempo
                          class          : NPrec1.class
                          tiempo         : NPrec1.tiempo
                          aspecto        : NPrec1.aspecto
                          retro          : NPrec1.retro
                          persona        : NPrec1.persona
                          genero         : NPrec1.genero
                          actsubcs       : NPrec1.actsubcs
                          temporal       : NPrec1.temporal
                          animate        : NPrec1.animate
                          human          : NPrec1.human
                          actcomas       : NPrec1.actcomas
                          mood           : NPrec1.mood
                          numero         : NPrec1.numero
                          definite       : NPrec1.definite
                          generic        : NPrec1.generic
                          thetanp        : NPrec1.thetanp
                          nounpatternefs : NPrec1.nounpatternefs
                          posspred       : NPrec1.posspred
                          possnietnp     : NPrec1.possnietnp
                          syntquant      : NPrec1.syntquant
                          NPhead         : NPrec1.NPhead
                          SpecQ          : NPrec1.SpecQ
                          DefSpec        : NPrec1.DefSpec
                          cases          : NPrec1.cases
                          index          : 0
                       }) AND
              [NPrec1.NPhead] * [redelloNP, redellosNP, persproNP] = []

          A1: @
         >


   SUBRULE (*4a'*)
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1.definite = def AND
              [NPVARrec1.NPhead] * [redelloNP, redellosNP, persproNP] = []
          A1: PRONPVARrec1 := NPVARrec1;
              PRONPVARrec1.index := 0
         >

      DECOMP
         <
          C1: (NPVARrec1.definite = def) AND
              (PRONPVARrec1 = NPVARrec1 EXCEPT FOR [index])  AND
              (PRONPVARrec1.index = 0) AND
              [NPVARrec1.NPhead] * [redelloNP, redellosNP, persproNP] = []
          A1: @
         >

   SUBRULE (*4a''*)
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: true
          A1: PRONPVARrec1 := COPYT_CNVARtoNPVAR(CNVARrec1);
              PRONPVARrec1.index := 0

             (* the other attributes have default value *)
         >

      DECOMP
         <
          C1: (PRONPVARrec1 = COPYT_CNVARtoNPVAR(CNVARrec1) 
                                           EXCEPT FOR [index])  AND
              (PRONPVARrec1.index = 0)
          A1: @
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TObjectok4a
\item[* relevant examples:]
lleg\'{o} el hombre $\rightarrow$ $<$PRONPVAR$>$ lleg\'{o} el hombre
muri\'{o} el soldado $\rightarrow$ $<$PRONPVAR$>$ muri\'{o} el soldado
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] TC:ObjectOkrules
\item[* date of creation:] 11-MAR-1988 15:40:00  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 13/12/88\ \ \ \ \ author: Elly van Munster\\
cliticrel/.. added.
\item date: 19/12/88\ \ \ \ \ author: ELLy van Munster\\
Condition/action for index of PRONPVAR added.
\item date: 20/01/89\ \ \ \ \ author: Lisette Appelo\\
Added mu6-mu8, MC I3,I4.
\item date: 29/1/89\ \ \ \ \ author: Elly van Munster\\
Condition on CLAUSErec1.synvpefs added in I1 ("ergativeclodsedvps").
\item date: 30/1/89\ \ \ \ \ author: Elly van Munster\\
The rule only applies for ergatives with vp010 !
\end{enumerate}
\item[* task:] To introduce in a construction with an ergative verb and 
a definite object
a subjrel/PRONPVAR with the record of the object. The object remains in 
object-position.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
4a' is for NPVAR, 4a'' for CNVAR.\\
I split this rule up since it probably wrong to say: PRONPVARrec1 := T1.REC
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:]
