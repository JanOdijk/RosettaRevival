\begin{verbatim}
% TRANSFORMATION TIOclCambioSEplus2
< m1:I1::CLAUSE{CLAUSErec1}
             [ mu1,
               predrel/VERBP{VERBPrec1}
                         [ mu5,
                           head/I6::VERB{VERBrec1}[mu4],
                           cliticrel/CLITIC{}[ I2:mu2,
                                        tresCLrel/I3::PERSPRO{PERSPROrec1}[mu3] 
                                               ],
                           mu8, 
                           I4:rel1/I5::NP{NPrec1}
                                [head/PERSPRO{PERSPROrec2}
                                [head/T1]
                                ], 
                           mu6
                         ],
               mu7
             ]
>

< m:I1::CLAUSE{CLAUSErec1}
         [ mu1,
           predrel/VERBP{VERBPrec1}
                         [ mu5,
                           head/I6::VERB{VERBrec1}[mu4],
                           cliticrel/CLITIC{}
                                [seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1},
                                 I2:mu2,
                                 tresCLrel/PERSPRO{PERSPROrec3}[head/T2]
                                ],
                           mu8,
                           I4:rel1/I5::NP{NPrec1}
                              [head/PERSPRO{PERSPROrec2}
                               [head/T1]
                              ],
                           mu6
                         ], 
           mu7
         ]
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = infinite
       I2: NOT EXIST(mu2, [seCLrel/..])
       I3: (PERSPROrec1.persona = 3)          AND
           (PERSPROrec1.forma = datCL)
       I4: rel1 IN [objrel, predrel]
       I5: Prepositive IN NPrec1.cases
       I6: NOT (VERBrec1.thetavp IN [vp012])
      >

<     
   SUBRULE    (* le(s) lo --> SE lo; masc. *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = singular)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := singular;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero;
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                            EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = singular)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                             EXCEPT FOR [forma] AND
              PERSPROrec2.numero = singular                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc

          A1:  PERSPROrec1.numero := REFLPROrec1.numero;
         >

   
   SUBRULE    (* le(s) le --> SE le *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = singular)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := singular;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusLeCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3) 
                                          EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = singular)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusLECL)                   AND
              (REFLPROrec1.persona = 3)                       AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)
                                            EXCEPT FOR [forma]   AND
              PERSPROrec2.numero = singular                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc
          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >


   SUBRULE    (* le(s) los --> SE los *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = plural)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := plural;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                            EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = plural)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                             EXCEPT FOR [forma] AND
              PERSPROrec2.numero = plural                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc

          A1: PERSPROrec1.numero := REFLPROrec1.numero
         >


   SUBRULE    (* le(s) les --> SE les *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = plural)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := plural;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusleCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                                     EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = plural)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusleCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                              EXCEPT FOR [forma] AND
              PERSPROrec2.numero = plural                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc
 
          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >


   SUBRULE    (* le(s) la --> SE la *)
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = singular)   AND
              (BPERSPROrec2.genero = fem)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := singular;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := fem;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                          EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = singular)               AND
              (PERSPROrec3.genero = fem)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                            EXCEPT FOR [forma] AND
              PERSPROrec2.numero = singular                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = fem

          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >


   SUBRULE    (* le(s) las --> SE las *)
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = plural)   AND
              (BPERSPROrec2.genero = fem)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := plural;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := fem;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                           EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = plural)               AND
              (PERSPROrec3.genero = fem)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                           EXCEPT FOR [forma] AND
              PERSPROrec2.numero = plural                   AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = fem

          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >

>

&

\end{verbatim}
