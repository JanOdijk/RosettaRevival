pragma C_include ('tracomlangspec.pf');
pragma C_include ('tracomdecl.pf');

PACKAGE tracomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH tracomDECL,
     tracomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: tracomLANGSPEC_Category;
                          b: tracomDECL_nodeid): tracomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: tracomDECL_psurfgraph): tracomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: tracomDECL_psurfgraph): tracomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: tracomDECL_psurfgraph): tracomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: tracomDECL_psurfgraph): tracomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: tracomLANGSPEC_Category; 
                          c: tracomDECL_psurfgraph); EXTERNAL;
 
END {tracomGRAPH};
