\begin{verbatim}

% RULE RObjNPSentSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        I1:rel1/NPVAR{NPVARrec1},
                        mu3
                       ],
                mu5
               ]
  
  SUBST:
  m2: I2::NP{NPrec1}[mu4]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        I3:rel1/NP{NPrec1}[mu4],
                        mu3
                       ],
                mu5
               ]
>


   MATCHCONDITIONS
      <
       I1: NPVARrec1.index = LEVEL AND
           rel1 IN [objrel, indobjrel] AND 
           NPVARrec1.NPhead = sentNP
       I2: NPrec1.NPhead = sentNP
       I3: rel1 IN [objrel, indobjrel] AND 
           NPrec1.NPhead = sentNP
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_npTOvar(NPrec1)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec1 := COPYT_npTOvar(NPrec1);
              NPVARrec1.index := LEVEL
         >
&

\end{verbatim}
