\begin{verbatim}
% TRANSFORMATION TNoControl4  
                           (* CLOSEDNPPROP in prepobjrel, predrel *)
< m1:CLAUSE{CLAUSErec1}      
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu3,
                      prepobjrel/PREPP{PREPPrec1}
                                [ mu4, 
                                  objrel/CLOSEDNPPROP{CLOSEDNPPROPrec1}
                                        [ subjrel/T2,
                                          predrel/NP{NPrec1}[mu5] 
                                        ],
                                  mu6
                                ],
                      mu7
                    ],
             mu8 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu3,
                      objrel/T2,
                      prepobjrel/PREPP{PREPPrec2}
                                [ mu4, 
                                  objrel/NP{NPrec1}[mu5],
                                  mu6
                                ],
                      mu7
                    ],
             mu8 
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3, [objrel/..])
      >

<
   SUBRULE
      <T2:NP{NPrec2}[mu9] >
      <T2:NP{NPrec2}[mu9] >

      COMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPCLOSEDNPPROP] <> []) AND
              ( CLOSEDNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative] 
		    thetanp        : NPrec1.thetanp
		    nounpatternefs : NPrec1.nounpatternefs
		    PROsubject     : false
		   }
              )
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPCLOSEDNPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
                                      [synPREPCLOSEDNPPROP];
              CLOSEDNPPROPrec1 :=
		   { 
		    thetanp        : NPrec1.thetanp
		    nounpatternefs : NPrec1.nounpatternefs
		    PROsubject     : false
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >

   SUBRULE
      <T2: T1 >
      <T2: T1 >

   MATCHCONDITIONS
      <
       T2: T1.CAT IN [NPVAR, CNVAR]
      >

      COMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPCLOSEDNPPROP] <> []) AND
              ( CLOSEDNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative] 
		    thetanp        : NPrec1.thetanp
		    nounpatternefs : NPrec1.nounpatternefs
		    PROsubject     : false
		   }
              )
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPCLOSEDNPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
                                      [synPREPCLOSEDNPPROP];
              CLOSEDNPPROPrec1 :=
		   { 
		    thetanp        : NPrec1.thetanp
		    nounpatternefs : NPrec1.nounpatternefs
		    PROsubject     : false
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >
>
&

