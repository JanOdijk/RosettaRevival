\begin{verbatim}

% RULE ROpenPrepPREPPPropSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        prepobjrel/VARPREPP{VARPREPPrec1}
                                  [head/PREP{PREPrec1},
                                   objrel/I1::PREPPPROPVAR{PREPPPROPVARrec1}
                                  ],
                        mu3 
                       ],
                mu7
               ]
  
  SUBST:
  m2: OPENPREPPPROP{OPENPREPPPROPrec1}[mu6]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        prepobjrel/PREPP{PREPPrec1}
                                  [head/PREP{PREPrec1},
                                   objrel/OPENPREPPPROP
                                              {OPENPREPPPROPrec1}[mu6]
                                  ],
                        mu3 
                       ],
                mu7
               ]
>

   MATCHCONDITIONS
      <
       I1: PREPPPROPVARrec1.index = LEVEL 
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: PREPPPROPVARrec1 = COPYT_prepppropTOvar
                                           (OPENPREPPPROPrec1) AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> [] 
          A1: PREPPrec1 := VARPREPPrec1
         >
      DECOMP
         <
          C1: true 
          A1: PREPPPROPVARrec1 := COPYT_prepppropTOvar
                                              (OPENPREPPPROPrec1);
              PREPPPROPVARrec1.actsubcefs := 
                    OPENPREPPPROPrec1.actsubcefs * AUX_otherprepsubcs;
              PREPPPROPVARrec1.index := LEVEL;
              VARPREPPrec1 := PREPPrec1
         >
&

\end{verbatim}
