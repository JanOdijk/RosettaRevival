\begin{verbatim}
% RULE Rexistspreppvar
< m1: NPPROP{NPPROPrec1}
                [ mu1,
                  objrel/T1,
                  I4:mu4,
                  I3:mu3 
                ]

  m2: I1::PREPPVAR{PREPPVARrec1}                 
>

< m :NPPROP{NPPROPrec1}
                [ mu1,
                  objrel/T1,
                  I4:mu4,
                  sentadvrel/I1::PREPPVAR{PREPPVARrec1},
                  I5:mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: caus IN PREPPVARrec1.actsubcefs 
       I4: ALL(mu4, I41:rel4/..)
       I3: NOT EXIST(mu3, [sentadvrel/..])
           I41: rel4 IN [locadvrel, sentadvrel, tempadvrel]
       I5: NOT EXIST(mu3,[I51:rel5/..])
           I51: rel5 IN [locadvrel, tempadvrel, sentadvrel]
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
