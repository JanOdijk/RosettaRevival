\newpage
\begin{verbatim}
% TRANSFORMATION TSEspellingCLpassive   
< m1:I1::CLAUSE{CLAUSErec1}
           [ I4:mu1,
             subjrel/I2::NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}[mu6]],
             I3:mu2,
             cliticrel/CLITIC{}[I5:mu3],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
              predrel/VERBP{VERBPrec1}[objrel/T1,
                                       mu8],
             mu10
           ]
>

< m:I1::CLAUSE{CLAUSErec2}
          [ I4:mu1,
            I3:mu2,
            subjrel/T2,
            cliticrel/CLITIC{}[seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1},
                               I5:mu3
                              ],
            head/VERB{VERBrec3}
                 [ mu15,
                   head/VERB{VERBrec4}
                     [head/SUBVERB{SUBVERBrec1}
                        [head/I6::BVERB{BVERBrec1}]
                     ]
                 ],
            predrel/VERBP{VERBPrec1}[mu8],
            mu10
                           
          ]
>

   MATCHCONDITIONS
      
      <
       I1:  CLAUSErec1.finiteness = finite
       I2:  (NPrec1.NPhead = Seimpershead)    AND
            (NPrec1.numero = singular)        AND
            (NPrec1.persona = 3)              AND
            (NPrec1.cases = [nominative])
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  ALL (mu3, I53:rel3/PERSPRO{PERSPROrec1}[mu51])
       I53: PERSPROrec1.forma = Datcl
       I6:  (BVERBrec1.reflexivity = notreflexive)    AND
            (BVERBrec1.key <> KEY_haberque1BVERBkey)  AND
            (BVERBrec1.key <> KEY_haberque2BVERBkey)
                
     >

<

    SUBRULE

               < T1: I8::NP{NPrec2}
                           [head/PERSPRO{PERSPROrec2}[mu22]
                           ] >
               < T2: NP{NPrec3}
                           [head/PERSPRO{PERSPROrec3}[mu22]
                           ] >   

       
       
     MATCHCONDITIONS
      
            < 
               I8: NPrec2.NPhead = persproNP AND
                   NPrec2.persona = 3 
               >
  
 
      COMP

         <
          
          C1: CLAUSErec1.voice = active  
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEpassive;
              PERSPROrec3 := PERSPROrec2;
              PERSPROrec3.forma := nomfuerte; 
              NPrec3 := NPrec2;
              NPrec3.cases := [nominative];
              VERBrec3.numero := NPrec3.numero;
              VERBrec4 := VERBrec1;
              VERBrec4.numero := NPrec3.numero
               
         >

     
     SUBRULE

               < T1: I8::NP{NPrec2}[mu22] >
               < T2: NP{NPrec3}[mu22] >  

       
     MATCHCONDITIONS
      
         < 
               I8: NPrec2.NPhead = OtherNP   AND
                   NPrec2.human = nohuman  
          >
  

     COMP

         <
          C1: CLAUSErec1.voice = active
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEpassive;
              NPrec2.cases := NPrec1.cases;
              NPrec3 := NPrec2;
              VERBrec3 := VERBrec2;
              VERBrec3.numero := NPrec3.numero;
              VERBrec4 := VERBrec1;
              VERBrec4.numero := NPrec3.numero
               
         >

    
    SUBRULE

               < T1: I8::NP{NPrec2}[mu22] >
               < T2: NP{NPrec3}[mu22] >  

 
     MATCHCONDITIONS
      
       <
       
             I8: NPrec2.NPhead = OtherNP AND
                 NPrec2.human = yeshuman   AND
                 NPrec2.definite = indef
      >


      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEpassive;
              NPrec2.cases := NPrec1.cases;
              NPrec3 := NPrec2;
              VERBrec3 := VERBrec2;
              VERBrec3.numero := NPrec3.numero;
              VERBrec4 := VERBrec1;
              VERBrec4.numero := NPrec3.numero
               
         >

  
>

     
&

\end{verbatim}
