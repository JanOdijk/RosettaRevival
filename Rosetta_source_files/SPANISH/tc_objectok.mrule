\newpage
\begin{verbatim}
% TRANSFORMATION TObjectok4c (* seactive, ergative, not-reflexive *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             I4:mu7,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      I6:head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      I5:mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I3: mu1,
             subjrel/PRONPVAR{PRONPVARrec1},
             I4: mu7,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      I6:head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      I5:mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice = seactive) AND
           (CLAUSErec1.thetavp IN [vp010,vp012, vp021])
       I3:  ALL (mu1, I31:rel1/..)
       I31: rel1 IN AUX_presubjrels
       I4:  NOT EXIST (mu7, [subjrel/..]) AND
            NOT EXIST (mu7, [I41:rel2/..])
       I41: rel2 IN AUX_presubjrels
       I5:  NOT EXIST (mu3, [I51:rel3/..])
       I51: rel3 IN [objrel, complrel]
       I6: VERBrec1.reflexivity = notreflexive
      >


      COMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARonECBPRSPR;
              PRONPVARrec1.persona := 3;
              PRONPVARrec1.numero := singular;
              PRONPVARrec1.genero := masc;
         >

      DECOMP
         <
          C1: PRONPVARrec1 = AUX_PRONPVARonECBPRSPR EXCEPT FOR
                                           [persona, numero, genero] AND
              PRONPVARrec1.persona = 3 AND
              PRONPVARrec1.numero = singular AND
              PRONPVARrec1.genero = masc

          A1: @
         >


&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TObjectok4c
\item[* relevant examples:]
 llegar $\rightarrow$ $<$PRONPVAR$>$ llegar\\
(Later: se llega)
\item[* language:] Spanish
