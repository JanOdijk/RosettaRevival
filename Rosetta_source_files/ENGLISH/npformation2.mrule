\newpage
\begin{verbatim}
% RULE RNPPresentSuperdeixis1
< m1: NP{NPrec1}[mu1,
                 head/CN{CNrec1}[mu4],
                 mu2
                 ] 
>

< m: NP{NPrec2}[mu1,
                 head/CN{CNrec2}[mu4],
                 mu2
                 ] 
>

   MATCHCONDITIONS
      <
       m1: NPrec1.superdeixis = omegadeixis 
       m: NPrec2.superdeixis = presentdeixis
      >


      COMP
         <
          C1: CNrec1.superdeixis = presentdeixis
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := presentdeixis;
              CNrec2 := CNrec1;
              CNrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: CNrec2.superdeixis = omegadeixis
          A1: NPrec1 := NPrec2;
              CNrec1 := CNrec2;
              CNrec1.superdeixis := presentdeixis;
              NPrec1.superdeixis := omegadeixis; 
         >
&

\end{verbatim}
