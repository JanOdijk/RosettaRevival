\newpage
\begin{verbatim}
% RULE RBPROPERNOUNtoSUBNOUN
< m1: BPROPERNOUN{BPROPERNOUNrec1} 
>

< m : SUBNOUN{SUBNOUNrec1}[head/BPROPERNOUN{BPROPERNOUNrec1}]
>

      COMP
         <
          C1:true
          A1:SUBNOUNrec1 := COPYT_bpropernTOsubnoun(BPROPERNOUNrec1);
             SUBNOUNrec1.subcs := [BPROPERNOUNrec1.subc];
             SUBNOUNrec1.posscomas := [count]
             (* other subnoun attributes get default values *)
         >
      DECOMP
         <
          C1:SUBNOUNrec1 = COPYT_bpropernTOsubnoun(BPROPERNOUNrec1)
             EXCEPT FOR [subcs, posscomas] AND
             (* other attributes must have default value *)
             BPROPERNOUNrec1.subc IN SUBNOUNrec1.subcs AND
             count IN SUBNOUNrec1.posscomas 
          A1:@
         >

&

\end{verbatim}
