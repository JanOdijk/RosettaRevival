\begin{verbatim}
% RULE RAgvpadv1                  (* antecedent is a subject *)
<  SUBST:
  m1: CLAUSE{CLAUSErec1}         
               [ mu1,
                 subjrel/T1,
                 mu2,
                 predrel/VERBP{VERBPrec1}[ mu3 ],
                 mu4
               ]

  m2: OPENADVPPROP{OPENADVPPROPrec1}
                  [ subjrel/T2,
                    predrel/I1::ADVP{ADVPrec1}
                           [ mu5,
                             head/ADV{ADVrec1}[mu6],
                             complrel/I2::CLAUSEVAR{CLAUSEVARrec1},
                             mu7
                           ] 
                  ]

>

< m : CLAUSE{CLAUSErec1}          
               [ mu1,
                 subjrel/T1,
                 mu2,
                 predrel/VERBP{VERBPrec1}
                        [ mu3,
                          agvpadvrel/I1::ADVP{ADVPrec1}
                                    [ mu5,
                                      head/ADV{ADVrec1}[mu6],
                                      mu7
                                    ]
                        ],
                 mu4
               ]
 
>

   MATCHCONDITIONS
      <
       I1: ADVPrec1.Qstatus = false                 AND
           agvpadv IN ADVPrec1.actsubcefs
       I2: CLAUSEVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2}
      >
      < T1:NPVAR{NPVARrec1}
      >


      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL                               AND
              CLAUSEVARrec1 = COPYT_CLAUSEtovar(CLAUSErec1)       AND
              OPENADVPPROPrec1 = COPYT_advptoprop (ADVPrec1)      EXCEPT FOR
                      [supertiempo, PROsubject, aktionsarts]        AND
              OPENADVPPROPrec1 =
                     { 
                       aktionsarts  : [stative]
                       PROsubject   : true
                     }                                                     AND
              NPVARrec2 = NPVARrec1 EXCEPT FOR [ cases ]                   AND
              NPVARrec2.cases = []                                         AND
              QUOTE_tiempomax(CLAUSErec1.tiempo,CLAUSErec1.supertiempo,
                    OPENADVPPROPrec1.supertiempo)                        
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: CLAUSEVARrec1 := COPYT_CLAUSEtovar(CLAUSErec1);
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advptoprop (ADVPrec1);
              OPENADVPPROPrec1 :=
                     { 
                       aktionsarts  : [stative]
                       PROsubject   : true
                     };
              NPVARrec2 := NPVARrec1 ;
              NPVARrec2.cases := [];
              QUOTE_asstiempomax(CLAUSErec1.tiempo,CLAUSErec1.supertiempo,
                    OPENADVPPROPrec1.supertiempo);
         >


   SUBRULE   (* CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2}
      >
      < T1:CNVAR{CNVARrec1}
      >


      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL                               AND
              CLAUSEVARrec1 = COPYT_CLAUSEtovar(CLAUSErec1) AND
              OPENADVPPROPrec1 = COPYT_advptoprop (ADVPrec1)     EXCEPT FOR
                      [supertiempo, PROsubject, aktionsarts]        AND
              OPENADVPPROPrec1 =
                     { 
                       aktionsarts  : [stative]
                       PROsubject   : true
                     }                                                     AND
              CNVARrec2 = CNVARrec1 EXCEPT FOR [ cases ]                   AND
              CNVARrec2.cases = []                                         AND
              QUOTE_tiempomax(CLAUSErec1.tiempo,CLAUSErec1.supertiempo,
                    OPENADVPPROPrec1.supertiempo)
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: 
              CLAUSEVARrec1 := COPYT_CLAUSEtovar(CLAUSErec1);
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advptoprop (ADVPrec1);
              OPENADVPPROPrec1 :=
                     { 
                       aktionsarts  : [stative]
                       PROsubject   : true
                     };
              CNVARrec2 := CNVARrec1 ;
              CNVARrec2.cases := [];
              QUOTE_asstiempomax(CLAUSErec1.tiempo,CLAUSErec1.supertiempo,
                    OPENADVPPROPrec1.supertiempo);
         >


   SUBRULE  (* EMPTYVAR *)
      < T1:EMPTYVAR{EMPTYVARrec1}
        T2:EMPTYVAR{EMPTYVARrec2}
      >
      < T1:EMPTYVAR{EMPTYVARrec1}
      >


      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL                               AND
              CLAUSEVARrec1 = COPYT_CLAUSEtovar(CLAUSErec1) AND
              OPENADVPPROPrec1 = COPYT_advptoprop (ADVPrec1) EXCEPT FOR
                      [supertiempo, PROsubject, aktionsarts]            AND
              OPENADVPPROPrec1 =
                     { 
                       aktionsarts  : [stative]
                       PROsubject   : true
                     }                                                     AND
              EMPTYVARrec2 = EMPTYVARrec1 AND
              QUOTE_tiempomax(CLAUSErec1.tiempo,CLAUSErec1.supertiempo,
                    OPENADVPPROPrec1.supertiempo)
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: CLAUSEVARrec1 := COPYT_CLAUSEtovar(CLAUSErec1);
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advptoprop (ADVPrec1);
              OPENADVPPROPrec1 :=
                     { 
                       aktionsarts  : [stative]
                       PROsubject   : true
                     };
              EMPTYVARrec2 := EMPTYVARrec1 ;
              QUOTE_asstiempomax(CLAUSErec1.tiempo,CLAUSErec1.supertiempo,
                    OPENADVPPROPrec1.supertiempo);
         >
>
&

\end{verbatim}
