         <
          C1: (* CNrec1.human <> yeshuman AND *)
              SUBADVrec1 = COPYT_badvTOsubadv(BADVrec1) AND
              SUBADVrec1.affix = noaffix AND
              ADVrec1 = COPYT_subadvTOadv(SUBADVrec1) AND
              ADVrec1.compform = basic 

              C11: (* temporally independent *)
                   (SENTENCErec2.superdeixis = omegadeixis) AND
                   (((SENTENCErec2.deixis = presentdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> presentdeixis)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.deixis = pastdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> pastdeixis) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;

               C12: (* temporally dependent *)
                    SENTENCErec2. superdeixis = omegadeixis AND
                    SENTENCErec2.deixis = CNrec1.superdeixis 
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.deixis := omegadeixis;
                    SENTENCErec1.superdeixis := CNrec1.superdeixis

           A1: CNVARrec1 := COPYT_CNTOVAR(CNrec1);
               CNVARrec1.index := LEVEL;
               CNVARrec1.cases := [accusative];
               SENTENCErec1.conjkey := KEY_thatCONJkey;
               VARPREPPrec1 := { mood       : relativexpmood
                                 headkey    : PREPrec1.key
                                 actsubcefs : PREPrec1.subcs
                                 class      : PREPrec1.class
                                 deixis     : PREPrec1.deixis
                                 aspect     : PREPrec1.aspect
                                 retro      : PREPrec1.retro
                                 thetapp    : PREPrec1.thetapp
                                 synppefs   : PREPrec1.synpps
                                 specQ      : yesspec }
         >

   SUBRULE  (* 9b. varprepp with deleted prep = where, no comma *)
      < T1  : VARPREPP{VARPREPPrec1}
                      [head/PREP(KEY_inPREPkey){PREPrec1},
                       objrel/CNVAR{CNVARrec1}] >
      < sig1: []
        T2  : ADV{ADVrec1}
                 [head/SUBADV{SUBADVrec1}
                      [head/BADV(KEY_'s_badv50008'){BADVrec1}] 
                 ] 
      >

      COMP
         <
          C1: CNrec1.human <> yeshuman AND
              CNVARrec1 = COPYT_CNTOVAR(CNrec1) 
                                EXCEPT FOR [cases] AND
              CNVARrec1.cases * [accusative] <> [] AND
              CNVARrec1.index = LEVEL AND
              VARPREPPrec1 = { mood       : relativexpmood
                               headkey    : PREPrec1.key
                               actsubcefs : PREPrec1.subcs
                               class      : PREPrec1.class
                               deixis     : PREPrec1.deixis
                               aspect     : PREPrec1.aspect
                               retro      : PREPrec1.retro
                               thetapp    : PREPrec1.thetapp
                               specQ      : yesspec } AND
              VARPREPPrec1.synppefs * PREPrec1.synpps <> []

            C11: (* temporally independent *)
                   (SENTENCErec1.superdeixis = omegadeixis) AND
                   (((SENTENCErec1.deixis = presentdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> presentdeixis)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec1.deixis = pastdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> pastdeixis) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
             A11: SENTENCerec2 := SENTENCerec1;

             C12: (* temporally dependent *)
                  SENTENCErec1. deixis = omegadeixis AND
                  CNrec1.superdeixis = SENTENCErec1.superdeixis
             A12: SENTENCErec2 := SENTENCErec1;
                  SENTENCErec2.deixis := CNrec1.superdeixis;
                  SENTENCErec2.superdeixis := omegadeixis;

          A1: SUBADVrec1 := COPYT_badvTOsubadv(BADVrec1);
              ADVrec1 := COPYT_subadvTOadv(SUBADVrec1);
         >

      DECOMP
         <
          C1: (* CNrec1.human <> yeshuman AND *)
              SUBADVrec1 = COPYT_badvTOsubadv(BADVrec1) AND
              SUBADVrec1.affix = noaffix AND
              ADVrec1 = COPYT_subadvTOadv(SUBADVrec1) AND
              ADVrec1.compform = basic

              C11: (* temporally independent *)
                   (SENTENCErec2.superdeixis = omegadeixis) AND
                   (((SENTENCErec2.deixis = presentdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> presentdeixis)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.deixis = pastdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> pastdeixis) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;

               C12: (* temporally dependent *)
                    SENTENCErec2. superdeixis = omegadeixis AND
                    SENTENCErec2.deixis = CNrec1.superdeixis 
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.deixis := omegadeixis;
                    SENTENCErec1.superdeixis := CNrec1.superdeixis

           A1: CNVARrec1 := COPYT_CNTOVAR(CNrec1);
               CNVARrec1.index := LEVEL;
               CNVARrec1.cases := [accusative];
               SENTENCErec1.conjkey := KEY_thatCONJkey;
               VARPREPPrec1 := { mood       : relativexpmood
                                 headkey    : PREPrec1.key
                                 actsubcefs : PREPrec1.subcs
                                 class      : PREPrec1.class
                                 deixis     : PREPrec1.deixis
                                 aspect     : PREPrec1.aspect
                                 retro      : PREPrec1.retro
                                 thetapp    : PREPrec1.thetapp
                                 synppefs   : PREPrec1.synpps
                                 specQ      : yesspec }
         >
>
&


\end{verbatim}
\newpage
\begin{description}
\item[* name:] CNmodRELSENT1
\item[* relevant examples:] \mbox{}\\
1. house/man + [x2 he saw] $\rightarrow$ house/man [that he saw] \\
2. houseman + [x2 he saw] $\rightarrow$ house/man [he saw]\\ 
3. house + [x2 he saw] $\rightarrow$ house [which he saw]\\ 
4. man + [x2 he saw ] $\rightarrow$ man [whom he saw]\\
5. house + [on x2 he has an option] $\rightarrow$ house [on which he has an 
option]  (varprepp: prepobjrel, byobjrel; locpreps, temppreps. Quirk (p.\ 867) 
gives some constraints for advs, but these have not been incorporated yet)\\
6. man + [on x2 he depends] $\rightarrow$ man [on whom he depends] (varprepp: 
prepobjrel, byobjrel)
\\
7. house + [in x2 he lives] $\rightarrow$ house [in which he lives] (prepp: 
predrel, locargrel, dirargrel, complrel) \\
8. man + [to x2 he went] $\rightarrow$ man [to whom he went] (prepp: predrel, 
locargrel, dirargrel, complrel)
9. place + [`in' x2 he swims] $\rightarrow$ place [where he swims] (varprepp: 
only for `abstract' locative prep yet)
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) modrules
\item[* date of creation:] 11-SEP-1988 11:57:36  
\item[* author:] Franciska de Jong
\item[* copied from:] Dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/10/88\ \ \ \ \ author: Lisette Appelo
\item date: 30/01/89\ \ \ \ \ author: Margreet Sanders
\item date: 07/02/89\ \ \ \ \ author: Margreet Sanders
\item date: 19/04/89\ \ \ \ \ author: Lisette Appelo
\item date: 04/10/89\ \ \ \ \ author: Margreet Sanders
\end{enumerate}
\item[* task:] Modification of a CN by a restrictive, finite, relative SENTENCE.
\item[\ \ strategy:] (also: deviations from accepted proposals) \mbox{}
Note that only the 
masc.\ sing.\ {\em who\/} is used in these rules as a `relpro', irrespective 
of the number and person of the antecedent\\
For the (var)prepp subrules, no option with `that' or a zero relpro exists: $
^{*}$the man with that I left. For the zero relpro, a subject must be present 
in the sentence: $^{*}$The man lives there is ill.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
There is one subrule for every version of the relative. In the `a' version of 
the subrules a comma is present behind the relative clause;
this is accepted only in analysis.\\
In the `b'-version subrules, cases where no comma is present are dealt 
with; this is both for generation and analysis.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] In analysis the presence
of a comma behind the  relative sentence \'{i}s accepted, but in generation
a comma is always omitted.
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
It is not known to me yet whether the surface parser will be able to give {\em 
relativexpmood\/} to a PREPP consisting if {\em PREP + which\/}. If such a 
PREPP is called {\em wh\/}, the subrules dealing with {\em which\/} must be 
adapted.

\item modifications: 28/10/88: Superdeixis conditions/actions.\\
 `Temporally 
independent' relative clauses are only allowed if the higher node superdeixis 
is different from the relative clause deixis. In case of past deixis this is 
only allowed if there is an overt referential adverbial. This condition is 
added to make analysis less ambiguous for Rosetta3 as it translates only 
isolated sentences. In RosettaX this condition should be changed in conformity 
with the treatment of context.\\
In the `temporally dependent' relative clauses the superdeixis value is changed 
to a deixis value and vice versa. This is for the surface parser. It is the 
same action that is done in the superdeixisadaptation rules for complement 
sentences.

\item modifications: 30/01/89: The absence and presence of a comma has been 
reversed over the subrules: the comma should {\em not\/} be generated, only 
accepted (here, English differs from Dutch).\\
Also, the rule has been changed so as to introduce the WHPRO {\em who\/} as a 
relative pronoun, in stead of the RELPRO {\em who\/}, because only the WHPRO 
can take case inflection (the RELPRO does not have any attributes).

\item modifications: 07/02/89: extension of the subrules to allow for 
(var)prepps with an embedded CNVAR, and for a zero relpro. Also, only one 
alternative is left for generation (who/which; that and zero are for analysis 
only).

\item modifications: 19/04/89: Changed conditions/actions of superdeixis for 
independent sentences: allowed are:\\
- presentdeixis without refvar and CN.superdeixis <> presentdeixis\\
- presentdeixis with refvar\\
- pastdeixis without refvar and CN.superdeixis <>pastdeixis\\
- pastdeixis with refvar

\item modifications: 04/10/89: added subrules for varprepp with `abstract prep' 
for locadvs: {\em in which\/} $\rightarrow$ {\em where\/}. Removed conditions 
on synpatterns of sentence from subrules 5-8, since the (VAR)PREPP may also 
come from an embedded sentence, or not be an argument at all. In analysis, both 
PREPP and VARPREPP will now be produced; the wrong should be stopped in 
the wh-shift rules, where the conditions on synpatterns have been formulated in 
detail.
\end{enumerate}
\end{description}


