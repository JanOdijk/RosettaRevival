\begin{verbatim}
% TRANSFORMATION TTempconjsentadaptation
< m1:SENTENCE{SENTENCErec3}[ mu4,
                             rel1/SENTENCE{SENTENCErec1}
                                          [mu1,
                                           conjrel/CONJ{CONJrec1}[mu2],
                                           mu3
                                          ],
                             mu5
                           ]
>

< m :SENTENCE{SENTENCErec3}[ mu4,
                             rel1/SENTENCE{SENTENCErec2}
                                           [mu1,
                                            conjrel/CONJ{CONJrec1}[mu2],
                                            mu3
                                           ],
                             mu5
                           ]

>
      COMP
         <
          C1:SENTENCErec1.adverbial = true AND
             SENTENCErec1.temporal = true AND
             SENTENCErec1.conjclass = reference AND
             SENTENCErec1.conjretro = false AND
             SENTENCErec1.conjdeixis = SENTENCErec1.deixis AND
             (SENTENCErec1.deixis = presentdeixis OR
              SENTENCErec1.deixis = pastdeixis) AND
            CONJrec1.deixis = omegadeixis
             
          A1:SENTENCErec2 := SENTENCErec1;
             SENTENCErec2.conjdeixis := omegadeixis;
         >
      DECOMP
         <
          C1:SENTENCErec2.adverbial = true AND
             SENTENCErec2.temporal = true AND
             SENTENCErec2.conjclass = reference AND
             SENTENCErec2.conjretro = false AND
             SENTENCErec2.conjdeixis = omegadeixis AND
             (SENTENCErec2.deixis = presentdeixis OR
              SENTENCErec2.deixis = pastdeixis) AND
             CONJrec1.deixis = omegadeixis
          A1:SENTENCErec1 := SENTENCErec2;
             SENTENCErec1.conjdeixis := SENTENCErec1.deixis;
         >

&

\end{verbatim}
