% RULE DETPformation3a  (* moet iets  worden met: la majoria de 
                           of mucho,  ipv mas *)
< m1: QP{QPrec1}[head/Q(KEY_'s_mas2qkey'){Qrec1}]

>

< m : DETP{DETPrec1}[I1:artrel/T1,
                     head/QP{QPrec2}[head/Q(KEY_'s_mas2qkey'){Qrec1}]
                    ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [ART]
      >

<   
   SUBRULE
      < >
      <T1: ART(KEY_elARTkey){ARTrec1} >

      COMP
         <
          C1: true
          A1: DETPrec1 := 
                 { 
                   genero      :  masc
                   numero      :  singular
                   definite    :  QPrec1.definite
                   posspred    :  QPrec1.posspred
                   posscomas   :  QPrec1.posscomas
                   mood        :  QPrec1.mood
                   supertiempo :  QPrec1.supertiempo
                 };
               QPrec2 := QPrec1;
               QPrec2.supertiempo := omegatiempo;

         >

      DECOMP
         <
          C1: DETPrec1 = 
                 { 
                   genero      :  masc
                   numero      :  singular
                   definite    :  QPrec2.definite
                   posspred    :  QPrec2.posspred
                   posscomas   :  QPrec2.posscomas
                   mood        :  QPrec2.mood
                 } AND
               QPrec2.supertiempo = omegatiempo
          A1:  QPrec1 := QPrec2;
               QPrec1.supertiempo := DETPrec1.supertiempo
         >

   SUBRULE
      < >
      <T1: ART(KEY_laARTkey){ARTrec1} >


      COMP
         <
          C1: true
          A1: DETPrec1 := 
                 { 
                   genero      :  fem
                   numero      :  singular
                   definite    :  QPrec1.definite
                   posspred    :  QPrec1.posspred
                   posscomas   :  QPrec1.posscomas
                   mood        :  QPrec1.mood
                   supertiempo :  QPrec1.supertiempo
                 };
               QPrec2 := QPrec1;
               QPrec2.supertiempo := omegatiempo;

         >

      DECOMP
         <
          C1: DETPrec1 = 
                 { 
                   genero      :  fem
                   numero      :  singular
                   definite    :  QPrec2.definite
                   posspred    :  QPrec2.posspred
                   posscomas   :  QPrec2.posscomas
                   mood        :  QPrec2.mood
                 } AND
               QPrec2.supertiempo = omegatiempo
          A1:  QPrec1 := QPrec2;
               QPrec1.supertiempo := DETPrec1.supertiempo
         >

   SUBRULE
      < >
      <T1: ART(KEY_losARTkey){ARTrec1} >


      COMP
         <
          C1: true
          A1: DETPrec1 := 
                 { 
                   genero      :  masc
                   numero      :  plural
                   definite    :  QPrec1.definite
                   posspred    :  QPrec1.posspred
                   posscomas   :  QPrec1.posscomas
                   mood        :  QPrec1.mood
                   supertiempo :  QPrec1.supertiempo
                 };
               QPrec2 := QPrec1;
               QPrec2.supertiempo := omegatiempo;

         >

      DECOMP
         <
          C1: DETPrec1 = 
                 { 
                   genero      :  masc
                   numero      :  plural
                   definite    :  QPrec2.definite
                   posspred    :  QPrec2.posspred
                   posscomas   :  QPrec2.posscomas
                   mood        :  QPrec2.mood
                 } AND  
               QPrec2.supertiempo = omegatiempo
          A1:  QPrec1 := QPrec2;
               QPrec1.supertiempo := DETPrec1.supertiempo
         >

   SUBRULE
      < >
      <T1: ART(KEY_lasARTkey){ARTrec1} >

      COMP
         <
          C1: true
          A1: DETPrec1 := 
                 { 
                   genero      :  fem
                   numero      :  plural
                   definite    :  QPrec1.definite
                   posspred    :  QPrec1.posspred
                   posscomas   :  QPrec1.posscomas
                   mood        :  QPrec1.mood
                   supertiempo :  QPrec1.supertiempo
                 };
               QPrec2 := QPrec1;
               QPrec2.supertiempo := omegatiempo;

         >

      DECOMP
         <
          C1: DETPrec1 = 
                 { 
                   genero      :  fem
                   numero      :  plural
                   definite    :  QPrec2.definite
                   posspred    :  QPrec2.posspred
                   posscomas   :  QPrec2.posscomas
                   mood        :  QPrec2.mood
                 } AND
               QPrec2.supertiempo = omegatiempo
          A1:  QPrec1 := QPrec2;
               QPrec1.supertiempo := DETPrec1.supertiempo
         >

>

&

