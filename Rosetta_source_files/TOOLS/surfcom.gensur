PROCEDURAL PART
VAR procpars,blockpas,blockenv:LOCALFILE;
    number::int;
    str,rulename:TSTRING_string;
    first,write::bool;
    parameters::setofidents;
    id::ident;
BEGIN 
INIT:BEGIN initlocalfile(procpars);
           initlocalfile(blockenv);
           initlocalfile(blockpas);
           initsetofidents(parameters);
           first:=TRUE;
           write:=FALSE;
           rulename:=$$RULEBODY.rulename;
           number:=$$RULEBODY.number;
           \procpars.\LOCAL. "#" ""rulename"" "#REC = RECORD"\\
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN str:=%.str; 
            END
      !.
      RECEIVE: BEGIN 
               END
   *>
3: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN IF write THEN BEGIN
                       IF TSTRING_comparechars(str,'BOOLEAN',7)<>0 THEN "LSDOMAINT_"
                       ""str""\\
                       END;
                     write:=FALSE;
               END
   *>
4: <* SEND: BEGIN %%BLOCK.rulename:=rulename;
                  %%BLOCK.parameters:=parameters;
            END
      !BLOCK.
      RECEIVE: BEGIN appendlocfile(%%BLOCK.blockenv,blockenv);
                     appendlocfile(%%BLOCK.blockpas,blockpas);
               END
   *>
5: <* SEND: BEGIN %%INITBLOCK.rulename:=rulename;
                  %%INITBLOCK.parameters:=parameters;
            END
      !INITBLOCK.
      RECEIVE: BEGIN appendlocfile(%%INITBLOCK.blockenv,blockenv);
                     appendlocfile(%%INITBLOCK.blockpas,blockpas);
               END
   *>
6: <* SEND: BEGIN %%FINALBLOCK.rulename:=rulename;
            END
      !FINALBLOCK.
      RECEIVE: BEGIN appendlocfile(%%FINALBLOCK.blockenv,blockenv);
                     appendlocfile(%%FINALBLOCK.blockpas,blockpas);
               END
   *>
7: <* SEND: BEGIN IF NOT first THEN ";" 
                  first:=FALSE;
                  id.str:=str;
                  appendident(id,parameters);
            END
      !.
      RECEIVE: BEGIN ""str"" ":" write:=TRUE;
               END
   *>
*>
FINAL: BEGIN \procpars.\LOCAL. " END;"\\
            $$RULEBODY.procpars:=procpars;
             \blockenv.\LOCAL.
            " FUNCTION comp_" ""rulename"" 
            "(rec1,rec2:" ""rulename"" "typ):BOOLEAN;EXTERNAL;"\\
            $$RULEBODY.blockenv:=blockenv;
             \blockpas.\LOCAL.
            " FUNCTION comp_" ""rulename"" 
            "(rec1,rec2:" ""rulename"" "typ):BOOLEAN;"\\
            "BEGIN WITH rec1^ DO comp_" ""rulename"" ":="\\
            IF NOT(stillidents(parameters)) THEN BEGIN "TRUE" \\ END;
            WHILE stillidents(parameters) DO BEGIN
              takeident(id,parameters);
              "(" ""id.str"" "=rec2^." 
                    ""id.str"" ")"
              IF stillidents(parameters) THEN " AND" \\
              END;
            "END;"\\
            $$RULEBODY.blockpas:=blockpas;
       END
END;
&

%BLOCK
BASIS RULE
  BLOCK = NUMBER/2.COLON/1.LEFTSTAR/1.LOCALCONDITION/1.COLON/1.
          PASCALTOGLOBAL/3.COLON/1.HEKJE/1.CONDITION/1.COLON/1.PASCALTOHEKJE/4.
          ACTION/1.COLON/1.PSTOSTARRIGHT/5
SURFACE PART
VAR blocknumber:TSTRING_string;

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN blocknumber:=%NUMBER.str
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_BLOCK;
                  $BLOCK.number:=blocknumber;
                END;
*>
END;

PROCEDURAL PART
VAR blockenv,blockpas:LOCALFILE;
    rulename,blocknumber,str:TSTRING_string;
    parameters::setofidents;
BEGIN 
INIT:BEGIN initlocalfile(blockenv);
           initlocalfile(blockpas);
           parameters:=$$BLOCK.parameters;
           rulename:=$$BLOCK.rulename;
           blocknumber:=$BLOCK.number;
           \blockenv.\LOCAL.
           "FUNCTION " ""rulename"" "_"
                   ""blocknumber"" \\ "(VAR rec:" ""rulename"" 
                   "typ;{VAR synrel:LSDOMAINT_synrel;}"
                   "b:LSSTREE_pstree):BOOLEAN;EXTERNAL;"\\
           \blockpas.\LOCAL.
           "FUNCTION " ""rulename"" "_"
                   ""blocknumber"" \\ "(VAR rec:" ""rulename"" 
                   "typ;{VAR synrel:LSDOMAINT_synrel;}"
                   "b:LSSTREE_pstree):BOOLEAN;"\\
           "VAR result:BOOLEAN;"\\
           "BEGIN WITH rec^ DO BEGIN result:=FALSE;IF "\\
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN \RTNfile.\GLOBAL. "+" ""str""\\
                     \blockpas.\LOCAL.
               END
   *>
3: <* SEND: BEGIN END
      !.{PASCALTOGLOBAL}
      RECEIVE: BEGIN {appendlocfile(%%PASCALTOGLOBAL.copy,blockpas);
                    \\"THEN IF"\\}
               END
   *>
4: <* SEND: BEGIN END
      !PASCALTOHEKJE.
      RECEIVE: BEGIN appendlocfile(%%PASCALTOHEKJE.copy,blockpas);
                   \\"THEN result:=TRUE;IF result THEN"\\
               END
   *>
5: <* SEND: BEGIN %%PSTOSTARRIGHT.parameters:=parameters END
      !PSTOSTARRIGHT.
      RECEIVE: BEGIN appendlocfile(%%PSTOSTARRIGHT.copy,blockpas);
               END
   *>
*>
FINAL: BEGIN $$BLOCK.blockenv:=blockenv;
             "END;" ""rulename"" "_" ""blocknumber""
             ":=result;"\\
{             "DEBUG_writestr('<-" ""rulename"" "_"
            ""blocknumber"" "',DEBUG_MaxIO,0,TRUE);"\\
            "IF result THEN"
             " DEBUG_writestr('TRUE',DEBUG_MaxIO,0,TRUE)"\\
            "ELSE"
             " DEBUG_writestr('FALSE',DEBUG_MaxIO,0,TRUE);"\\
             "DEBUG_writeline(TRUE);"\\}
             "END;"\\
             $$BLOCK.blockpas:=blockpas; 
       END
END;
&

