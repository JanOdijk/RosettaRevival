\newpage
\begin{verbatim}
% RULE RnppSubstitution1
< m1: I1::NPPROP{NPPROPrec1}
                [ mu1,
                  subjrel/I2::NPVAR{NPVARrec1},
                  mu2
                ]
  SUBST:
  m2: NP{NPrec1}[mu5] 
>

< m : I1::NPPROP{NPPROPrec1}
                [ mu1,
                  subjrel/NP{NPrec2}[mu6],
                  mu2
                ]
>

   MATCHCONDITIONS
      <
       I1: NPPROPrec1.PROsubject = false
       I2: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) 
                               EXCEPT FOR [cases] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric AND
              NPrec1.supertiempo = NPPROPrec1.supertiempo
          A1: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases);
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []);
              NPrec1.supertiempo := NPPROPrec1.supertiempo;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RnppSubstitution1
\item[* relevant examples:]
\item[* language:] (Dutch, English, Spanish) Spanish
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] toNPPROP
\item[* class:] (name of rule, transformation or filter class)
\item[* date of creation:] 12-APR-1989 10:50:27  
\item[* author:] margreet sanders
\item[* copied from:] English RnppSubjSubst
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] substitution of Subject NPs in the (embedded) NPPROP. Needed 
because in Spanish some structures do not take a subject in the main clause 
(e.g.\ after {\em Parece que...\/} as translation of {\em Hij lijkt...\/})
\item[\ \ strategy:] (also: deviations from accepted proposals) It is assumed 
the NPPROP can not have its own deixis, but will always be dependent.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
