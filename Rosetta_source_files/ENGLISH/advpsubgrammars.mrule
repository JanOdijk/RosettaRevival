\newpage
\begin{verbatim}
% RULE RADVPSubst3

< m1 : ADVP{ADVPrec1}[forobjrel/PREPP{PREPPrec1}
                         [I1:mu1,
                          I2:objrel/NPVAR{NPVARrec1}
                         ],
                  head/ADV{ADVrec1}[mu3],
                  mu2
                 ]

SUBST:
 m2: NP{NPrec1}[mu5]
>

< m : ADVP{ADVPrec1}[forobjrel/PREPP{PREPPrec1}
                         [I1:mu1,
                          objrel/NP{NPrec2}[mu6]
                         ],
                  head/ADV{ADVrec1}[mu3],
                  mu2
                 ]
>

   MATCHCONDITIONS
      <
       I1: EXIST(mu1, [head/..])
       I2: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
             NPrec1.cases = [] AND 
             NPrec1.generic = nogeneric AND
             NPrec1.superdeixis = ADVPrec1.superdeixis
          A1:QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases);
             NPrec2.generic := omegageneric;
             NPrec2.superdeixis := omegadeixis
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis 
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []) ;
              NPrec1.generic := nogeneric;
              NPrec1.superdeixis := ADVPrec1.superdeixis;
         >

&

\end{verbatim}
