\begin{verbatim}
%  RULE RNPformation2   (* DETP + [.. EN ..] *)

< m1: CN{CNrec1}[mu1,
                 head/EN{ENrec1},
                 mu2
                ]


  m2: DETP{DETPrec1}[mu3]
>

< m : NP{NPrec1}[detrel/DETP{DETPrec2}[mu3],
                 head/CN{CNrec1}[mu1,
                                 head/EN{ENrec1},
                                 mu2
                                 ]
                ]
>
   MATCHCONDITIONS
      <
       m: NPrec1 = { 
                      persona   : 3
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                      NPhead    : enNP
                     }
      >

      COMP
         <
          C1: (DETPrec1.posscomas * CNrec1.posscomas <> []) AND
              (DETPrec1.supertiempo = CNrec1.supertiempo) AND
               DETPrec1.genero IN CNrec1.generos AND
               DETPrec1.numero = CNrec1.numero 
                 C11: CNrec1.numero = plural 
                 A11: NPrec1.actcomas := [count];
                      NPrec1.numero := plural    
                 C12: ((CNrec1.numero = singular) AND
                      (mass IN CNrec1.posscomas))           
                 A12: NPrec1.actcomas := [mass];
                      NPrec1.numero := singular  
                 C13: CNrec1.numero = singular AND
                      count IN CNrec1.posscomas 
                 A13: NPrec1.actcomas := [count];
                      NPrec1.numero := singular  
          A1: NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          NPhead     : enNP
                         } ;
              DETPrec2 := DETPrec1;
              DETPrec2.supertiempo := omegatiempo;
          >

      DECOMP
         <
          C1: DETPrec2.posscomas * CNrec1.posscomas <> []
               AND
              DETPrec2.genero IN CNrec1.generos AND
              DETPrec2.numero = CNrec1.numero AND
              NPrec1 = { posspred          : DETPrec2.posspred
                          definite          : DETPrec2.definite
                          mood              : DETPrec2.mood
                          genero            : DETPrec2.genero

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         }  AND

               (NPrec1.actcomas *  
                       (CNrec1.posscomas * DETPrec2.posscomas) <> []) 
               AND
               (NPrec1.cases = [])  AND
               (DETPrec2.supertiempo = omegatiempo)
                   C11:( CNrec1.numero = plural) AND
                       (NPrec1.actcomas * [count] <> []) AND
                       (NPrec1.numero = plural) 
                   A11: @
                   C12:((CNrec1.numero = singular) AND
                        (mass IN CNrec1.posscomas)) AND
                        (NPrec1.actcomas * [mass] <> []) AND
                        (NPrec1.numero = singular)
                   A12: @
                   C13: CNrec1.numero  = singular AND
                        NPrec1.actcomas * [count] <> [] AND
                        NPrec1.numero = singular
                  A13:  @
          A1:   DETPrec1 := DETPrec2;
                DETPrec1.supertiempo := CNrec1.supertiempo;
         >
 
&


\end{verbatim}
