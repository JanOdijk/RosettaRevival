\begin{verbatim}

%RULE RIdDeriv10

<m1: I1::SUBVERB{SUBVERBREC1}[head/BVERB(KEY1){BVERBREC1}]
 m2: T1
 m3: T2
 m4: T3
>

< m:  XPPROPTOCLAUSE/(RLOCOPENPREPPPROPSUBST{LEVEL:X1 
                                             SUBST:2}
                      RDIROPENPREPPPROPSUBST{LEVEL:X1 
                                             SUBST:2}
                     )
        [VERBPPROPFORMATION/TVERBPATTERN5
           [VERBPPROPFORMATION/RSTARTVPPROP123
              [VERBDERIVATION/RBVERBTOSUB
                 [BLEX/BVERB(KEY2)],
               BLEX/I2:T1,
               BLEX/I3:T2,
               BLEX/PREPPPROPVAR(X1){PREPPPROPVARrec1}
              ]
           ],
         PREPPFORMATION/ROPENPPPMOOD
           [PREPPFORMATION/TPPPPROSUBJ
              [PREPPFORMATION/RPPPNPSUBST{LEVEL:X2
                                          SUBST:2}
                 [PREPPPROPFORMATION/RPREPTOFORMULA
                    [PREPPPROPFORMATION/TPPPPATTERN1
                       [PREPPPROPFORMATION/RSTARTPPPROP120
                          [PREPDERIVATION/RPREPTOSUB
                             [BLEX/PREP(KEY3)],
                           BLEX/T4,
                           BLEX/NPVAR(X2){NPVARREC1}
                          ]
                       ]
                    ],
                  IDFORMATION/RIDNPFORMATION
                    [CNFORMATION/RCNFORMATION1
                       [CNFORMATION/RSUBNOUNTONOUN1
                          [NPDERIVATION/BNOUNTOSUBNOUN
                             [BLEX/BNOUN(KEY4)]
                          ]
                       ],
                     BLEX/I4:T3
                    ]
                 ]
              ]
           ]
        ]
        
>

   MATCHCONDITIONS
      <
       I1: SUBVERBREC1.thetavp = vp123
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
       I3: T2.CAT IN AUX_VARCATSET 
       m3: T2.CAT IN AUX_VARCATSET 
       I4: T3.CAT IN AUX_VARCATSET 
       m4: T3.CAT IN AUX_VARCATSET 
      >

<
   SUBRULE  (* 1 *)
      <T2:NPVAR{NPVARrec2}>
      <T2:NPVAR{NPVARrec2}
       T4:NPVAR{NPVARrec3}>

COMP
 <
   C1: COMPINIDDICT(KEY1, VPID11)
   A1: <KEY2, KEY3, KEY4> := COMPGETIDDICT (KEY1, VPID11);
       NPVARrec3 := NPVARrec2;
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3, KEY4>, VPID11)           AND
       NPVARrec3.index = NPVARrec2.index
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3, KEY4>, VPID11);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
 >
   SUBRULE  (* 2 *)
      <T2:CNVAR{CNVARrec1}>
      <T2:CNVAR{CNVARrec1}
       T4:CNVAR{CNVARrec2}>

COMP
 <
   C1: COMPINIDDICT(KEY1, VPID11)
   A1: <KEY2, KEY3, KEY4> := COMPGETIDDICT (KEY1, VPID11);
       CNVARrec2 := CNVARrec1;
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3, KEY4>, VPID11)           AND
       CNVARrec2.index = CNVARrec1.index
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3, KEY4>, VPID11);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
 >
>

&

\end{verbatim}
