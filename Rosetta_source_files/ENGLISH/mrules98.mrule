% RULE RIdentLocadvVar
< m1: NPPROP{NPPROPrec1}
               [ mu1,
                 idrel/NPVAR{NPVARrec1},
                 I4: mu4,
                 I5: mu3 
               ]

  m2: I1::ADVPVAR{ADVPVARrec1}                 
>

< m : NPPROP{NPPROPrec1}
               [ mu1,
                 idrel/NPVAR{NPVARrec1},
                 I4: mu4,
                 locadvrel/I1::ADVPVAR{ADVPVARrec1},
                 I3: mu3
               ]
>

   MATCHCONDITIONS
      <
       I1: locadv IN ADVPVARrec1.actsubcefs 
       I3: NOT EXIST (mu3, [I31:rel1/..])
         I31: rel1 IN [locadvrel, tempadvrel]
       I4: ALL (mu4, locadvrel/..)
       I5: NOT EXIST (mu3, [locadvrel/..])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
