SPANISH 50
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TADJaspectneutralisation
< m1:ADJPFORMULA{ADJPFORMULArec1}[mu1, 
                                  predrel/ADJP{ADJPrec1}[mu2]
                                 ] 

>

< m :ADJPFORMULA{ADJPFORMULArec2}[mu1,
                                  predrel/ADJP{ADJPrec2}[mu2]
                                 ]
>
      COMP
         <
          C1: ADJPFORMULArec1.aspecto = imperfectivo AND
              ADJPrec1.aspecto = imperfectivo 
          A1: ADJPFORMULArec2 := ADJPFORMULArec1;
              ADJPrec2 := ADJPrec1;
              ADJPFORMULArec2.aspecto := omegaaspecto;
              ADJPrec2.aspecto := omegaaspecto;
         >

      DECOMP
         <
          C1: ADJPFORMULArec2.aspecto = omegaaspecto AND
              ADJPrec2.aspecto = omegaaspecto
          A1: ADJPFORMULArec1 := ADJPFORMULArec2;
              ADJPFORMULArec1.aspecto := imperfectivo;
              ADJPrec1 := ADJPrec2;
              ADJPrec1.aspecto := imperfectivo;

         >

&

\end{verbatim}
