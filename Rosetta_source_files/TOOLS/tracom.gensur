1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN %%ANDCOND.rulenumber:=rulenumber END
      !ANDCOND.
      RECEIVE: BEGIN copy:=%%ANDCOND.copy;
                     simple:=%%ANDCOND.simple;
                     intequals:=%%ANDCOND.intequals;
               END
   *>
3: <* SEND: BEGIN %%PASCALEXPR.rulenumber:=rulenumber END
      !PASCALEXPR.
      RECEIVE: BEGIN copy:=%%PASCALEXPR.copy;
                     simple:=%%PASCALEXPR.simple;
                     intequals:=%%PASCALEXPR.intequals;
               END
   *>
*>
FINAL:BEGIN $$ELEMENTARYCOND.copy:=copy;
            $$ELEMENTARYCOND.simple:=simple;
            $$ELEMENTARYCOND.intequals:=intequals;
      END
END;
&
%PASCALEXPR
BASIS RULE
      PASCALEXPR = EQUALS|SETBOOLEAN|NIBOOLEAN|INTEQUALS
       INTEQUALS = PARAMNAME/18.EQUIVALENT/1.(X1/17|X2/17|X3/17)
          EQUALS = PARAMNAME/10.
                         (EQUIVALENT/2|(LEFTARROW/3.RIGHTARROW/1)).
                   (VALUENAME/11|SETVALUENAME/12)
      SETBOOLEAN = [NOTCAT/4].[ROUNDOPEN/5].PARAMNAME/13.
                     (INCAT/6|LEFTARROW/7.EQUIVALENT/1|RIGHTARROW/8.EQUIVALENT/1).
                   SETVALUENAME/14.[ROUNDCLOSE/9]
      NIBOOLEAN = [NOTCAT/4].[ROUNDOPEN/5].PARAMNAME/15.NICAT/1.VALUENAME/16.
                      [ROUNDCLOSE/9]
SURFACE PART
VAR simple::bool;
    initialcounter::int;
    notpresent,openpresent::bool;

<*
INIT: BEGIN simple:=true;notpresent:=false;openpresent:=false;
            initialcounter:=counter;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN simple:=false END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN notpresent:=true
                        END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: notpresent
               #ACTION: BEGIN openpresent:=true END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
7 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
8 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
9 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: openpresent
               #ACTION: BEGIN 
                        END
    *>
10: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
11: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                        END
    *>
12: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
13: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN simple:=false END
    *>
14: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
15: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
16: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
17: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN assigncounter(counter+1) END
    *>
18: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_PASCALEXPR;
                      $PASCALEXPR.initialcounter:=initialcounter;
                      $PASCALEXPR.simple:=simple;
                      $PASCALEXPR.notpresent:=notpresent;
                END
*>
END;
PROCEDURAL PART
VAR copy,intequals:LOCALFILE;
    param:TSTRING_string;
    valeu,tempfile:LOCALFILE;
    str,str1:TSTRING_string;
    simple::simple;
    notpresent::bool;
    rulenumber,initialcounter::int;
BEGIN
INIT: BEGIN initlocalfile(copy);
            initlocalfile(intequals);
            initlocalfile(valeu);
            initialcounter:=$PASCALEXPR.initialcounter;
            rulenumber:=$$PASCALEXPR.rulenumber;
            notpresent:=$PASCALEXPR.notpresent;
            \copy.\LOCAL.
            If notpresent THEN "NOT("
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN " = "
               END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN " = "
               END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
5: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN " IN "
               END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "<="
               END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN ">="
               END
   *>
9: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
10: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%PARAMNAME.str;
                     "X" """rulenumber""" ""str""
                     param:=str;
               END
   *>
11: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \valeu.\LOCAL.
                     str:=%VALUENAME.str;
                     ""str""
                     \copy.\LOCAL.
                     ""str""
               END
   *>
12: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN savelocfile(%%SETVALUENAME.copy,tempfile);
                     appendlocfile(tempfile,copy);
                     savelocfile(%%SETVALUENAME.copy,tempfile);
                     appendlocfile(tempfile,valeu);
               END
   *>
13: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%PARAMNAME.str;
                     ""str""
               END
   *>
14: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN  appendlocfile(%%SETVALUENAME.copy,copy)
               END
   *>
15: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str1:=%PARAMNAME.str;
               END
   *>
16: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%VALUENAME.str;
                     ""str"" " IN " ""str1""
               END
   *>
17: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%.str;
                     initialcounter:=initialcounter+1;
                     "intequals" """initialcounter""" "(X"
                     """rulenumber""" ""param"" ")"
                     \intequals.\LOCAL.
                     "function intequals" """initialcounter""" 
                          "(param:INTEGER):BOOLEAN;"\\
                     "begin"\\
                     ""str"" ":=" "param" ";"
                     \\ "intequals" """initialcounter"""
                       ":=TRUE"\\
                     "end;"\\
                     \valeu.\LOCAL.
                     str:=%VALUENAME.str;
                     ""str""
               END
   *>
18: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%PARAMNAME.str;
                     param:=str;
               END
   *>
*>
FINAL:BEGIN IF notpresent THEN BEGIN ")" \\END;
            $$PASCALEXPR.intequals:=intequals;
            $$PASCALEXPR.copy:=copy;
            simple.valeu:=valeu;
            simple.param:=param;
            simple.copy:=copy;
            $$PASCALEXPR.simple:=simple;
      END
END;
&
 
 
%SETVALUENAME
BASIS RULE
      SETVALUENAME = SQUAREOPEN/1.[VALUENAME/2.{COMMA/3.VALUENAME/2}
                                  ].
                     SQUARECLOSE/1
