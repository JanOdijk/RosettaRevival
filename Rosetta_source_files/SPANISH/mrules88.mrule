\newpage
\begin{verbatim}
% RULE RPropsubstfuturo       (* "futurobverb" *)
< m1: I1::VERBPPROP{VERBPPROPrec1}
              [ mu18,
                predrel/VERBP{VERBPrec1}
                       [ head/VERB{VERBrec1}
                             [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(KEY_futurobverbkey){BVERBrec1}]
                             ],
                         cliticrel/CLITIC{}[],
                         complrel/SENTENCEVAR{SENTENCEVARrec1}
                         ],
                I2: mu1
              ]
SUBST:
  m2: I3::SENTENCE{SENTENCErec1}     (* substituent *)
                   [ subjrel/T5,
                     mu2,
                     predrel/VERBP{VERBPrec2}
                            [mu3,
                             rel1/VERB{VERBrec2}[mu4],
                             mu5
                            ],
                     mu6
                   ]
>

<
  m : VERBPPROP{VERBPPROPrec2}
               [ mu18,
                 subjrel/T5,
                 mu2,
                 predrel/VERBP{VERBPrec2}
                        [mu3,
                         auxrel/VERB{VERBrec3}
                             [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(KEY_futurobverbkey){BVERBrec1}]
                             ],
                         rel1/VERB{VERBrec4}[mu4],
                         mu17
                        ],
                 mu6,
                 I2: mu1
               ]
>


   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = [synCLOSEDINFSENT] 
       I2: QUOTE_tempdurnotfound(mu1) AND
           (* QUOTE_tempfreqnotfound(mu1) AND *)
           QUOTE_tempretronotfound(mu1)
       I3: (SENTENCErec1.VRcompl = true) AND
           (SENTENCErec1.PROsubject = false) AND
           (SENTENCErec1.restructuring = false)

      >


   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* no clitic node in complement *)
      <mu5:[I4:mu7, I5:mu8] >
      <mu17:[I4: mu7, cliticrel/CLITIC{}[], I5:mu8] >

   MATCHCONDITIONS
      <
       I4: ALL (mu7, I41:rel2/..)
       I41:rel2 IN [auxrel, head]
       I5: (NOT EXIST (mu8, [I51: rel3/..])) 
       I51: rel3 IN [auxrel, head, cliticrel]

      >

      COMP
         <
          C1: (SENTENCEVARrec1.index = LEVEL) AND
              (SENTENCEVARrec1 = COPYT_SENTENCEtovar(SENTENCErec1)) 
                                                                           AND
              ( VERBPPROPrec1 =
		  {
                   req : [pospol,negpol,omegapol]
                   env : [pospol,negpol,omegapol]
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                   voice : active
                   synvpefs: [synCLOSEDINFSENT]
                   thetavp : vp010 
		  } 
              )                                AND

              VERBrec2.status = bareV AND
              VERBrec2.modo = infinitivo AND
              ( SENTENCErec1 = 
                      {
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
                      }

              )                                

          A1: VERBPPROPrec2 :=
		     { 
		      supertiempo : SENTENCErec1.supertiempo
		      PROsubject  : false
		      voice       : SENTENCErec1.voice 
		      synvpefs    : SENTENCErec1.synvpefs
		      thetavp     : SENTENCErec1.thetavp
		      aktionsarts : SENTENCErec1.aktionsarts
		     };

               VERBrec3 := VERBrec1;
               VERBrec3.futuro := sifuturo;
               VERBrec4 := VERBrec2;
               VERBrec4.modo := omegamodo; 
         >

      DECOMP
         <
          C1: VERBPPROPrec2.supertiempo <> omegatiempo AND
              VERBrec4.modo = omegamodo AND
              VERBrec4.status = bareV 

          A1: SENTENCErec1 :=
		     { 
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
		       supertiempo : VERBPPROPrec2.supertiempo
          	       voice       : VERBPPROPrec2.voice
		       synvpefs    : VERBPPROPrec2.synvpefs
		       thetavp     : VERBPPROPrec2.thetavp
		       aktionsarts : VERBPPROPrec2.aktionsarts
		     };
             (* polarity still to be accounted for *)
              VERBrec1 := VERBrec3;
              VERBrec1.futuro := nofuturo;
              VERBrec2 := VERBrec4;
              VERBrec2.modo := infinitivo;
                            
              SENTENCEVARrec1 := COPYT_SENTENCEtovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
              VERBPPROPrec1 := 
                 {
                   req : [pospol,negpol,omegapol]
                   env : [pospol,negpol,omegapol]
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                   voice : active
                   synvpefs: [synCLOSEDINFSENT]
                   thetavp : vp010 
                };
         >

 
    SUBRULE (* clitic node in complement achter alle verbs *)
      <mu5: [I6:mu9, cliticrel/CLITIC{}[mu10], I7:mu11] >
      <mu17: [I6:mu9, cliticrel/CLITIC{}[mu10], I7:mu11]>

   MATCHCONDITIONS
      <
       I6: ALL (mu9, I61:rel2/..)
       I61:rel2 IN [auxrel, head]
       I7: (NOT EXIST (mu11, [I71: rel3/..])) 
       I71: rel3 IN [auxrel, head, cliticrel]

      >

      COMP
         <
          C1: (SENTENCEVARrec1.index = LEVEL) AND
              (SENTENCEVARrec1 = COPYT_SENTENCEtovar(SENTENCErec1)) 
                                                                           AND
              ( VERBPPROPrec1 =
		  {
                   req : [pospol,negpol,omegapol]
                   env : [pospol,negpol,omegapol]
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                   voice : active
                   synvpefs: [synCLOSEDINFSENT]
                   thetavp : vp010 
		  } 
              )                                AND

              VERBrec2.status = bareV AND
              VERBrec2.modo = infinitivo AND
              ( SENTENCErec1 = 
                      {
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
                      }

              )                                

          A1: VERBPPROPrec2 :=
		     { 
		      supertiempo : SENTENCErec1.supertiempo
		      PROsubject  : false
		      voice       : SENTENCErec1.voice 
		      synvpefs    : SENTENCErec1.synvpefs
		      thetavp     : SENTENCErec1.thetavp
		      aktionsarts : SENTENCErec1.aktionsarts
		     };

               VERBrec3 := VERBrec1;
               VERBrec3.futuro := sifuturo;
               VERBrec4 := VERBrec2;
               VERBrec4.modo := omegamodo; 
         >

      DECOMP
         <
          C1: VERBPPROPrec2.supertiempo <> omegatiempo AND
              VERBrec4.modo = omegamodo AND
              VERBrec4.status = bareV 

          A1: SENTENCErec1 :=
		     { 
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
		       supertiempo : VERBPPROPrec2.supertiempo
          	       voice       : VERBPPROPrec2.voice
		       synvpefs    : VERBPPROPrec2.synvpefs
		       thetavp     : VERBPPROPrec2.thetavp
		       aktionsarts : VERBPPROPrec2.aktionsarts
		     };
             (* polarity still to be accounted for *)
              VERBrec1 := VERBrec3;
              VERBrec1.futuro := nofuturo;
              VERBrec2 := VERBrec4;
              VERBrec2.modo := infinitivo;
                            
              SENTENCEVARrec1 := COPYT_SENTENCEtovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
              VERBPPROPrec1 := 
                 {
                   req : [pospol,negpol,omegapol]
                   env : [pospol,negpol,omegapol]
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                   voice : active
                   synvpefs: [synCLOSEDINFSENT]
                   thetavp : vp010 
                };
         >

    SUBRULE (* 3: clitic node in complement achter haber *)
      <mu5: [mu12, I8: auxrel/VERB{VERBrec5}[mu13],
                   cliticrel/CLITIC{}[mu14], 
                   I9: head/VERB{VERBrec6}[mu15],
             mu16] >
     <mu17: [mu12, I8: auxrel/VERB{VERBrec5}[mu13],
                  I9: head/VERB{VERBrec6}[mu15],
                  cliticrel/CLITIC{}[mu14], 
             mu16] >
 
   MATCHCONDITIONS
      <
       I8: VERBrec5.subc = haberaux AND
           VERBrec5.modo IN [Infinitivo, gerundio]
       I9: VERBrec6.modo = PtcPas

      >

      COMP
         <
          C1: (SENTENCEVARrec1.index = LEVEL) AND
              (SENTENCEVARrec1 = COPYT_SENTENCEtovar(SENTENCErec1)) 
                                                                           AND
              ( VERBPPROPrec1 =
		  {
                   req : [pospol,negpol,omegapol]
                   env : [pospol,negpol,omegapol]
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                   voice : active
                   synvpefs: [synCLOSEDINFSENT]
                   thetavp : vp010 
		  } 
              )                                AND

              VERBrec2.status = bareV AND
              VERBrec2.modo = infinitivo AND
              ( SENTENCErec1 = 
                      {
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
                      }

              )                                

          A1: VERBPPROPrec2 :=
		     { 
		      supertiempo : SENTENCErec1.supertiempo
		      PROsubject  : false
		      voice       : SENTENCErec1.voice 
		      synvpefs    : SENTENCErec1.synvpefs
		      thetavp     : SENTENCErec1.thetavp
		      aktionsarts : SENTENCErec1.aktionsarts
		     };

               VERBrec3 := VERBrec1;
               VERBrec3.futuro := sifuturo;
               VERBrec4 := VERBrec2;
               VERBrec4.modo := omegamodo; 
         >

      DECOMP
         <
          C1: VERBPPROPrec2.supertiempo <> omegatiempo AND
              VERBrec4.modo = omegamodo AND
              VERBrec4.status = bareV 

          A1: SENTENCErec1 :=
		     { 
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
		       supertiempo : VERBPPROPrec2.supertiempo
          	       voice       : VERBPPROPrec2.voice
		       synvpefs    : VERBPPROPrec2.synvpefs
		       thetavp     : VERBPPROPrec2.thetavp
		       aktionsarts : VERBPPROPrec2.aktionsarts
		     };
             (* polarity still to be accounted for *)
              VERBrec1 := VERBrec3;
              VERBrec1.futuro := nofuturo;
              VERBrec2 := VERBrec4;
              VERBrec2.modo := infinitivo;
                            
              SENTENCEVARrec1 := COPYT_SENTENCEtovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
              VERBPPROPrec1 := 
                 {
                   req : [pospol,negpol,omegapol]
                   env : [pospol,negpol,omegapol]
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                   voice : active
                   synvpefs: [synCLOSEDINFSENT]
                   thetavp : vp010 
                };
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RPropsubstfuturo
\item[* relevant examples:] `futuro' + x1 llegar$\rightarrow$
x1 `futuro' llegar ; 
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoClause
\item[* class:] Proposition Substitution
\item[* date of creation:]  30-SEP-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rpropsubst14
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 17/11/88\ \ \ \ \ author: Elly van Munster\\
"VRcompl" for SENTENCE(VAR) added.
\item date: 17/11/88\ \ \ \ \ author: Lisette Appelo\\
Subrules added:\\
 1) for no clitic in embedded sentence.\\
 2) for clitic in embedded sentence.
\end{enumerate}
\item[* task:] Substitute a sentence for the complementvariable of the abstract
futuro verb. 
\item[\ \ strategy:] This futuro verb is included as an auxiliary verb into its 
complement. It is given the feature sifuturo to distinguish it form other verbs 
in the deixis rules. (There are special deixis rules needed to spell out the 
futuro verb as a tense of its right adjacent verb.) In generation the VERBPPROP 
gets the supertiempo value of the complement sentence, in analysis the 
complement sentence gets the supertiempo value of the VERBPPROP. In the deixis 
rules special measures are taken to guarantee there is a path that has not/does 
not require 
omega for the supertiempo attribute.
This rule is an example of subgrammar switch.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] There are no 
subrules
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
