\begin{verbatim}
%
% RULE RClosedNPPropSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/I1::NPPROPVAR{NPPROPVARrec1},
                        mu3 
                       ],
                mu5
               ]
  
  SUBST:
  m2: CLOSEDNPPROP{CLOSEDNPPROPrec1}[mu4]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/CLOSEDNPPROP{CLOSEDNPPROPrec1}[mu4],
                        mu3 
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: NPPROPVARrec1.index = LEVEL 
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPPROPVARrec1 = COPYT_nppropTOvar(CLOSEDNPPROPrec1) 
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPPROPVARrec1 := COPYT_nppropTOvar(CLOSEDNPPROPrec1);
              NPPROPVARrec1.index := LEVEL
         >
&

\end{verbatim}
