\begin{verbatim}
%
% TRANSFORMATION TPrepppropOverIO
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/PREPPPROP{PREPPPROPrec1},
                    indobjrel/PREPP{PREPPrec1}[mu3],
                    mu4
                   ],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                   [mu2,
                    indobjrel/PREPP{PREPPrec1}[mu3],
                    rel1/PREPPPROP{PREPPPROPrec1},
                    mu4
                   ],
              mu5
            ]
>

      COMP
         <
          C1:true
          A1:@
         >

      DECOMP
         <
          C1:true
          A1:@
         >
&

\end{verbatim}
