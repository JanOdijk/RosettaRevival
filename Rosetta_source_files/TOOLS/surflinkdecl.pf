pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('surflinklangspec.pf');

PACKAGE surflinkDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     surflinkLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   surflinkDECL_Surfrulemode = (loccond, globcond);
   surflinkDECL_psyntcat     = ^surflinkLANGSPEC_Category;
   surflinkDECL_syntcatset   = SET OF surflinkLANGSPEC_Category;
   surflinkDECL_nodeid         = HINIT..HFINAL;
   surflinkDECL_plonodeid      = ^surflinkDECL_lonodeid;
   surflinkDECL_lonodeid       = RECORD
   			          next: surflinkDECL_plonodeid;
   			          arg : surflinkDECL_nodeid
   	 	               END;
   surflinkDECL_pSnode       = ^surflinkDECL_Snode;
   surflinkDECL_pRsnode      = ^surflinkDECL_Rsnode;
   surflinkDECL_Rsnode       = RECORD
                                sonnumber:surflinkDECL_nodeid;
                                node    : surflinkDECL_pSnode;
                                brother : surflinkDECL_pRsnode
                             END;
   surflinkDECL_Snode        = RECORD
                                sonlist : surflinkDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : surflinkLANGSPEC_Category;
                                ldfield : surflinkLANGSPEC_FieldDef
                             END;
   surflinkDECL_pLostree     = ^surflinkDECL_Lostree;
   surflinkDECL_Lostree      = RECORD
                                next    : surflinkDECL_pLostree;
                                arg     : surflinkDECL_pSnode
                             END;
   surflinkDECL_pConnectionnode
                           = ^surflinkDECL_Connectionnode;
   surflinkDECL_pSingleSegmList
                           = ^surflinkDECL_SingleSegmList;
   surflinkDECL_Connectionnode 
                           = RECORD
                                list    : surflinkDECL_pSingleSegmList;
                                next,
                                prev    : surflinkDECL_pConnectionnode;
                                idnr    : integer
                             END;
   surflinkDECL_SingleSegmList
                           = RECORD
                                next    : surflinkDECL_pSingleSegmlist;
                                rn      : surflinkDECL_pConnectionnode;
                                stree   : surflinkDECL_pSnode
                             END;
   surflinkDECL_psurfgraph     = ^surflinkDECL_surfgraphtype;
   surflinkDECL_psurfgraphnode = ^surflinkDECL_surfgraphnode;
   surflinkDECL_surfgraphtype  = RECORD
   			          first,
   			          last: surflinkDECL_psurfgraphnode
   		               END;
   surflinkDECL_plossurfgraphnode 
                             = ^surflinkDECL_lossurfgraphnode;
   surflinkDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : surflinkDECL_plossurfgraphnode;
   			       END;
   surflinkDECL_lossurfgraphnode 
                             = RECORD
   				   next :  surflinkDECL_plossurfgraphnode;
   				   arg  :  surflinkDECL_psurfgraphnode
   			       END;
   surflinkDECL_surfgraphnode  = RECORD
      			          left,
   			          right: surflinkDECL_psurfgraphnode;
   			          n    : surflinkDECL_nodeid;
   			          cat  : surflinkDECL_psyntcat;
   			          nextnodes: surflinkDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : surflinkDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

