\newpage
\begin{verbatim}
% RULE RpppNPmod
< m1:PREPPPROP{PREPPPROPrec1}[mu1, predrel/PREPP{PREPPrec1}[mu2] ]
  m2:NP{NPrec1}[mu3] 
>

< m :PREPPPROP{PREPPPROPrec1}[mu1, predrel/PREPP{PREPPrec1}
                                          [ modrel/NP{NPrec2}[mu3],
                                            mu2
                                          ] 
                             ]
>

      COMP
         <
          C1: unitnoun  IN NPrec1.actsubcs AND
              NPrec1.supertiempo = presente AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: unitnoun  IN NPrec1.actsubcs AND
              NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := presente;
              NPrec1.generic := nogeneric;
         >


&

\end{verbatim}
