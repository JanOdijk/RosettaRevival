\newpage
\begin{verbatim}
% TRANSFORMATION TThatDeletion
< m1: CLAUSE{CLAUSErec1}[ leftdislocrel/I1::SENTENCE{SENTENCErec1}[mu1],
                          subjrel/NP{NPrec1}
                                 [head/DEMPRO(AUX_thatDEMPROkey){DEMPROrec1}],
                          I2:mu2
                        ]
>

< m : CLAUSE{CLAUSErec1}[ leftdislocrel/I1::SENTENCE{SENTENCErec1}[mu1],
                          I2:mu2
                        ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCErec1.adverbial = false
       I2: NOT EXIST (mu2, [subjrel/..])
      >

      COMP
         <
          C1: NPrec1 = AUX_NPONthatDMPR
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPrec1 := AUX_NPONthatDMPR
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TThatDeletion
\item[* relevant examples:] That he went away so eraly that surprised me 
$\rightarrow$ That he went away so early surprised me
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_ThatDel
