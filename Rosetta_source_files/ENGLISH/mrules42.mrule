      COMP
         <
          C1: NPVARrec1 = { number   : plural
                            person   : 3 }
          A1: NPrec1 := AUX_NPONthemRFLPR
         >
      DECOMP
         <
          C1: NPVARrec1 = { number   : plural
                            person   : 3 } AND
              NPrec1 = AUX_NPONthemRFLPR
          A1: @
