\newpage
\begin{verbatim}
% TRANSFORMATION TNoVPDeletion
< m1: T1
>

< m : T1
>

<
   SUBRULE (* 1. SENTENCE *)
      < T1: SENTENCE{SENTENCErec1}
                    [ mu1,
                      predrel/VERBP{VERBPrec1}
                             [ I1:mu2 ],
                      mu3
                    ] >
      < T1: SENTENCE{SENTENCErec1}
                    [ mu1,
                      predrel/VERBP{VERBPrec1}
                             [ I1:mu2 ],
                      mu3
                    ] >

   MATCHCONDITIONS
      <
       I1: EXIST (mu2, [rel1/..])
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. NP *)
      < T1: NP{NPrec1}[mu1] >
      < T1: NP{NPrec1}[mu1] >

   MATCHCONDITIONS
      <
       T1: NPrec1.NPhead IN [openIngNP, sentNP]
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 3. PREPP *)
      < T1: PREPP{PREPPrec1}[mu1] >
      < T1: PREPP{PREPPrec1}[mu1] >

   MATCHCONDITIONS
      <
       T1: EXIST (mu1, [objrel/I1::NP{NPrec1}[mu2]])
       I1: NPrec1.NPhead IN [openIngNP, sentNP]
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 4. CLOSEDVERBPPROP *)
      < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >
      < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TNoVPDeletion
\item[* relevant examples:] \mbox{}
subrule 1: Did he $_{VP}$[buy a book], Has he $_{VP}$[a book] \\
subrule 2: (my) knowing this\\
subrule 3: without (my) knowing this\\
subrule 4: the house built by a famous architect
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) TC\_VPDeletion
\item[* date of creation:] 8-SEP-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch Tvpdel0
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 16/10/88\ \ \ \ \ author: margreet sanders\\
adapted to let other structures than SENTENCEs pass this tc
\item date: 12/10/89\ \ \ \ \ author: margreet sanders\\
allowed all VPs that have anything in them to pass, not just VPs with a head.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to let structures in which the verbp still contains anything 
pass this transformation class
