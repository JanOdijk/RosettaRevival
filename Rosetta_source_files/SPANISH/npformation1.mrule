% RULE RNPformation12   
< 
  m1: CN{CNrec1}[head/EN{ENrec1}]
  m2: DETP{DETPrec1}[I1:mu1] 
>

< m : I4::NP{NPrec1}[detrel/DETP{DETPrec2}[I1:mu1],
                 head/CN{CNrec1}[head/EN{ENrec1}]
                ]
>

   MATCHCONDITIONS
      <
        I1:EXIST(mu1,[head/DET{DETrec1}[mu8]])
        I4: NPrec1 = { NPhead    : otherNP
                       persona   : 3
                       class     : omegaTimeAdvclass
                       tiempo    : omegatiempo
                       aspecto   : omegaaspecto
                       retro     : false }
        
      >


          COMP
         <
            C1: DETPrec1.supertiempo = CNrec1.supertiempo AND
              DETPrec1.posscomas * [count] <> [] AND
              DETPrec1.numero = CNrec1.numero AND
              CNrec1.posscomas * [count] <> [] AND
              CNrec1.numero = plural      (* EN count/plural *)
            A1: NPrec1 := 
                    {human     :yesHuman
                     animate   :yesAnimate
                     definite  :DETPrec1.definite
                     posspred  :false
                     numero    :plural
                     genero    :DETPrec1.genero
                     actcomas  :[count]
                     generic   :nogeneric
                     cases     :[]
                     NPhead    : enNP
                     };
              DETPrec2 := DETPrec1;
              DETPrec2.supertiempo:= omegatiempo;
         >

      DECOMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = 
                    {human     :yesHuman
                     animate   :yesAnimate
                     definite  :DETPrec2.definite
                     posspred  :false
                     numero    :plural
                     genero    :DETPrec2.genero
                     generic   :nogeneric
                     cases     :[]
                     NPhead    : enNP
                     } AND
              DETPrec2.supertiempo= omegatiempo AND
              DETPrec2.posscomas * [count] <> [] AND
              DETPrec2.genero IN CNrec1.generos AND
              DETPrec2.numero = CNrec1.numero AND
              CNrec1.posscomas * [count] <> [] AND
              CNrec1.numero = plural
          A1: DETPrec1 := DETPrec2;
              DETPrec1.supertiempo := CNrec1.supertiempo;
         >
&

\end{verbatim}
