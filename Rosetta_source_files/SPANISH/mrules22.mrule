\newpage
\begin{verbatim}
% TRANSFORMATION TCaseAssignment5
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I3:rel1/N1
                               [ mu3,
                                 I1:objrel/T1,
                                 mu4 
                               ],
                      mu5 
                    ],
             mu6 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I3:rel1/N1
                               [ mu3,
                                 I2:objrel/T2,
                                 mu4 
                               ],
                      mu5 
                    ],
             mu6 
           ]
>


   MATCHCONDITIONS
      <
       I1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [])
       I2: (T2.CAT IN [NPVAR, CNVAR, NP] WITH Prepositive IN T2.REC.cases )
       I3: N1.CAT IN [PREPP, VARPREPP] AND rel1 IN 
            [prepobjrel, porobjrel, indobjrel, paraobjrel]
      >

<
   SUBRULE
      <T1:NPVAR{NPVARrec1}>
      <T2:NPVAR{NPVARrec2}>

      COMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: true
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := []
         >


   SUBRULE
      <T1:CNVAR{CNVARrec1}>
      <T2:CNVAR{CNVARrec2}>

      COMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: true
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := []
         >


   SUBRULE
      <T1:NP{NPrec1}[mu7]>
      <T2:NP{NPrec2}[mu8]>

      COMP
         <
          C1: true
          A1: QUOTE_assigncase ( NPrec1, mu7, 
                                 NPrec2, mu8, [Prepositive] 
                               )
         >

      DECOMP
         <
          C1: true
          A1: QUOTE_assigncase ( NPrec2, mu8, 
                                 NPrec1, mu7, [] 
                               )
         >
>
&

\end{verbatim}
