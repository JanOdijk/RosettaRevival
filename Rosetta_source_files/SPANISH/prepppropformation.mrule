SPANISH 81

&
%
%SUBGRAMMAR Prepderivation

Rpreptosub/1



HEAD:
<
PREP     BASIC EXPRESSION
>


(* IMPORT: *)
<
>


EXPORT:
<
SUBPREP
>
&


%SUBGRAMMAR Prepppropformation

(
Rstartpreppprop000/1 | Rstartpreppprop100/2 | Rstartpreppprop120/3 
)
.
( Tpreppattern0/4 | Tpreppattern1/5
)

.{Rppplocadvvar/9          | Rppplocpreppvar/10     | Rpppsadvvar/11         | 
  Rpppspreppvar/12         | Rppprefvarinsertion/13 | Rpppdurvarinsertion/14 | 
  Rpppretrovarinsertion/15 | Rpppconjsvar/16        | Rpppfinconjsvar/17
 }

.
(Rprepppropvoice/6)

.[Rpppadvpmod/7 | Rpppnpmod/8]

HEAD:
<
SUBPREP     FROM (Prepderivation)
>


(* IMPORT: *)
<
>



EXPORT:
<
PREPPPROP
>
&




\newpage
\begin{verbatim}
% RULE Rpreptosub
< m1:PREP{PREPrec1} 
>

< m :SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1}]
>

      COMP
         <
          C1: true
          A1: SUBPREPrec1 := PREPrec1;
         >
      DECOMP
         <
          C1: SUBPREPrec1 = PREPrec1
          A1: @
         >

&

\end{verbatim}
