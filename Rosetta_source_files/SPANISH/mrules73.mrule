\begin{verbatim}
% RULE RNPapposition (* conditions probably must be sharpened  *)
< m1: NP{NPrec1}[mu1] 
  m2: NP{NPrec2}[mu2] 
>

< m : NP{NPrec3}[head/NP{NPrec1}[mu1],
                 puncrel/PUNC(KEY_kommapunckey){PUNCrec1},
                 apposrel/NP{NPrec4}[mu2]
                ]
>


      COMP
         <
          C1: NPrec1.numero = NPrec2.numero AND
              NPrec1.supertiempo = NPrec2.supertiempo AND
              NPrec1.cases = NPrec2.cases AND
              NPrec1.mood = declxpmood AND
              NPrec1.mood = NPrec2.mood AND
              NPrec1.NPhead IN [persproNP, othernp] AND
              NPrec2.NPhead IN [persproNP, othernp] AND
              NPrec2.generic = nogeneric
              
          A1: NPrec3 := NPrec1;
              NPrec4 := NPrec2;
              NPrec4.generic := omegageneric;
         >
      DECOMP
         <
          C1: NPrec1.numero = NPrec4.numero AND
              NPrec1.cases = NPrec4.cases AND
              NPrec1.mood = declxpmood AND
              NPrec1.mood = NPrec4.mood AND
              NPrec1.NPhead IN [persproNP, othernp] AND
              NPrec4.NPhead IN [persproNP, othernp] AND
              NPrec4.generic = omegageneric
          A1: NPrec1 := NPrec3;
              NPrec2 := NPrec4;
              NPrec2.supertiempo := NPrec1.supertiempo;
              NPrec2.cases := [nominative];
              NPrec2.generic := nogeneric;
         >

&

\end{verbatim}
