   SUBRULE
      < T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec1}>

         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 3)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                   EXCEPT FOR [numero, persona, genero]) AND
              (NPrec1.numero = singular)                                AND
              (NPrec1.persona = 3)                                      AND
              (NPrec1.genero = fem)
          A1:  @
         >


   SUBRULE
      < T1:BPERSPRO(KEY_elloBPERSPROkey){BPERSPROrec1}>

         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 3)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                    EXCEPT FOR [numero, persona, 
                                                genero, animate])       AND
              (NPrec1.numero = singular)                                AND
              (NPrec1.persona = 3)                                      AND
              (NPrec1.genero = neutro)                                  AND
              (NPrec1.animate = NoAnimate)
          A1:  @
         >


   SUBRULE
      < T1:BPERSPRO(KEY_nosotrosBPERSPROkey){BPERSPROrec1}>

         <
          C1: (VERBrec1.numero = plural)   AND
              (VERBrec1.persona = 1)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                    EXCEPT FOR [numero, persona, genero]) AND
              (NPrec1.numero = plural)                                  AND
              (NPrec1.persona = 1)                                      AND
              (NPrec1.genero = masc)
          A1:  @
         >


   SUBRULE
      < T1:BPERSPRO(KEY_nosotrasBPERSPROkey){BPERSPROrec1}>

         <
          C1: (VERBrec1.numero = plural)   AND
              (VERBrec1.persona = 1)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                    EXCEPT FOR [numero, persona, genero]) AND
              (NPrec1.numero = plural)                                  AND
              (NPrec1.persona = 1)                                      AND
              (NPrec1.genero = fem)
          A1:  @
         >


   SUBRULE
