\begin{verbatim}
%
% TRANSFORMATION TIOclCambioSEplus
< m1:I1::CLAUSE{CLAUSErec1}
             [ mu1,
               cliticrel/CLITIC{}[ I2:mu2,
                                   tresCLrel/I3::PERSPRO{PERSPROrec1}[mu3] 
                                 ],
               head/I6::VERB{VERBrec1}[mu4],
               predrel/VERBP{VERBPrec1}
                         [ mu5,
                           I4:rel1/I5::NP{NPrec1}
                             [head/PERSPRO{PERSPROrec2}
                               [head/T1]
                             ], 
                           mu6
                         ],
               mu7
             ]
>

< m:I1::CLAUSE{CLAUSErec1}
         [ mu1,
           cliticrel/CLITIC{}[ seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1},
                               I2: mu2,
                               tresCLrel/PERSPRO{PERSPROrec3}[head/T2]
                             ],
           head/I6::VERB{VERBrec1}[mu4],
           predrel/VERBP{VERBPrec1}
                         [ mu5,
                           I4:rel1/I5::NP{NPrec1}
                             [head/PERSPRO{PERSPROrec2}
                               [head/T1]
                             ],
                           mu6
                         ], 
           mu7
         ]
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = finite
       I2: NOT EXIST(mu2, [seCLrel/..])
       I3: (PERSPROrec1.persona = 3)          AND
           (PERSPROrec1.forma = datCL)
       I4: rel1 IN [objrel, predrel]
       I5: Prepositive IN NPrec1.cases
       I6: NOT (VERBrec1.thetavp IN [vp012])
      >

<     
   SUBRULE    (* le(s) lo --> SE lo; masc. *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = singular)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := singular;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero;
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3) 
                                       EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = singular)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                         EXCEPT FOR [forma]  AND
              PERSPROrec2.numero = singular                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc

          A1:  PERSPROrec1.numero := REFLPROrec1.numero;
         >

   
   SUBRULE    (* le(s) le --> SE le *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = singular)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := singular;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusLeCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3) 
                                         EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = singular)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusLECL)                   AND
              (REFLPROrec1.persona = 3)                       AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                          EXCEPT FOR [forma] AND
              PERSPROrec2.numero = singular                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc
          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >


   SUBRULE    (* le(s) los --> SE los *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = plural)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := plural;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3) 
                                           EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = plural)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                           EXCEPT FOR [forma] AND
              PERSPROrec2.numero = plural                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc

          A1: PERSPROrec1.numero := REFLPROrec1.numero
         >


   SUBRULE    (* le(s) les --> SE les *)
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = plural)   AND
              (BPERSPROrec2.genero = masc)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := plural;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := masc;
              PERSPROrec3.forma := acusleCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                           EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = plural)               AND
              (PERSPROrec3.genero = masc)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusleCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                            EXCEPT FOR [forma]  AND
              PERSPROrec2.numero = plural                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = masc
 
          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >


   SUBRULE    (* le(s) la --> SE la *)
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = singular)   AND
              (BPERSPROrec2.genero = fem)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := singular;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := fem;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3)
                                        EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = singular)               AND
              (PERSPROrec3.genero = fem)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                          EXCEPT FOR [forma] AND
              PERSPROrec2.numero = singular                 AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = fem

          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >


   SUBRULE    (* le(s) las --> SE las *)
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2} >
      <T1:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec2}
       T2:BPERSPRO(KEY_ellaBPERSPROkey){BPERSPROrec3}>

      COMP
         <
          C1: (BPERSPROrec2.numero = plural)   AND
              (BPERSPROrec2.genero = fem)       AND
              (BPERSPROrec2.persona = 3)         AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) EXCEPT FOR [forma]
          A1: PERSPROrec3 := COPYT_btoperspro(BPERSPROrec3);
              PERSPROrec3.numero := plural;
              PERSPROrec3.persona := 3;
              PERSPROrec3.genero := fem;
              PERSPROrec3.forma := acusCL;

              REFLPROrec1.persona := 3;
              REFLPROrec1.numero := PERSPROrec1.numero
         >

      DECOMP
         <
          C1: (PERSPROrec3 = COPYT_btoperspro(BPERSPROrec3) 
                                            EXCEPT FOR [forma]) AND
              (PERSPROrec3.numero = plural)               AND
              (PERSPROrec3.genero = fem)                   AND
              (PERSPROrec3.persona = 3)                     AND
              (PERSPROrec3.forma = acusCL)                   AND
              (REFLPROrec1.persona = 3)                      AND
              PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2)  
                                           EXCEPT FOR [forma] AND
              PERSPROrec2.numero = plural                   AND
              PERSPROrec2.persona = 3                       AND
              PERSPROrec2.genero = fem

          A1: PERSPROrec1.numero := REFLPROrec1.numero;
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TIOclCambioSEplus
\item[* relevant examples:] 
           *Le doy (a) \'{e}l $\rightarrow$ Se lo doy (a) \'{e}l\\
           *Les doy (a) ellas $\rightarrow$ Se las doy (a) ellas
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_cliticrules
\item[* date of creation:] 28-OCT-1988 11:41:22  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 11/01/89\ \ \ \ \ author: Lisette Appelo\\
Changed rule rigorously. Reversibility is not guaranteed!!!!
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To change "le(s)" into SE in case a DO-PERSPRO is added:\\
le(s) lo $\rightarrow$ se lo \\
le(s) le $\rightarrow$ se le \\
le(s) los $\rightarrow$ se los \\
le(s) les $\rightarrow$ se les \\
le(s) la $\rightarrow$ se la \\
le(s) las $\rightarrow$ se las\\
The PERSPRO in object position is not deleted.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

