/* Dialog window definitions */

! Exit window

object le_ask_boolean_window : XmQuestionDialog {
    arguments {
        XmNdialogTitle          = '';
	XmNmessageString	= '';
	XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL;
        XmNnoResize             = true;
        XmNbuttonFontList       = big;
	XmNlabelFontList        = bold;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget 
                     (X_le_ask_boolean_window);
        XmNokCallback      = procedure XwbAction 
                     (X_le_ask_boolean_yes_button);
        XmNcancelCallback  = procedure XwbAction 
                     (X_le_ask_boolean_no_button);
    };
};    

! err: error window

object le_error_window : XmErrorDialog {
    arguments {
        XmNdialogTitle          = '';
	XmNmessageString	= '';
	XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL;
        XmNnoResize             = true;
        XmNbuttonFontList       = big;
	XmNlabelFontList        = bold;
        XmNdefaultPosition      = false;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_error_window);
        XmNokCallback      = procedure XwbAction (X_le_error_ok_button);
    };
};    

object le_ask_string_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
        XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL;
        XmNdialogTitle  = '';
        XmNnoResize    = true;
    };
   controls {
	XmRowColumn le_ask_string_main;
	XmRowColumn le_ask_string_button_box;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_le_ask_string_window + DEFAULT_BUTTON_OFFSET*X_le_ask_string_ok_button);
    };
};

object le_ask_string_main: XmRowColumn {
    arguments {
        XmNtopAttachment    = XmATTACH_FORM;
        XmNleftAttachment   = XmATTACH_FORM;
        XmNrightAttachment  = XmATTACH_FORM;
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                arguments label_args;
                XmNlabelString  = '';
	    };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget
                             (X_le_ask_string_prompt);
            };
        };
        XmText {
            arguments {
                arguments text_args;
                XmNcolumns           = 8;
                XmNvalue = '';
            };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget
                             (X_le_ask_string_value);
            };
	};
    };
};

object le_ask_string_button_box: XmRowColumn {
    arguments {
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmRowColumn le_ask_string_main;
        XmNbottomAttachment = XmATTACH_FORM;
        XmNleftAttachment   = XmATTACH_FORM;
        XmNrightAttachment  = XmATTACH_FORM;
	arguments button_box_args;
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
       	XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString  = 'OK';
            };
            callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_le_ask_string_ok_button);
                XmNactivateCallback = procedure
                    XwbAction (X_le_ask_string_ok_button);
            };
        };
       	XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString  = 'Cancel';
            };
            callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_le_ask_string_cancel_button);
                XmNactivateCallback = procedure
                    XwbAction (X_le_ask_string_cancel_button);
            };
        };
    };
};


