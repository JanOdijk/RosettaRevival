(*MPF:::===================================================================*
 *
 *  Function Name  : surfgraph
 *  Description    : 
 *  Parameters     :0<i<=maxrnr 
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION surfgraph(i:integer):psurfgraph; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : assignsurfgraph
 *  Description    : 
 *  Parameters     : o<i<=maxrnr
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : valeu of surfgraph(i) is 'valeu'
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

  PROCEDURE assignsurfgraph(i:integer;valeu:psurfgraph); EXTERNAL;

