ENGLISH 90

&
\begin{verbatim}

PREPP.mrule

Note: this subgrammar need only be isomorphic with the ADVP subgrammar, not 
with the several PREPPPROP subgrammars. Hence, all rules necessary to provide 
the PREPP with the features needed in the surface parser are collapsed into one 
subgrammar, and their order may deviate from that in the ordinary subgrammars (
this is especially the case for superdeixis and modification; see RPPPNpMod in 
RC_PrepModRules of PREPPPROPFormation).

\end{verbatim}
\newpage
\begin{verbatim}

%
%SUBGRAMMAR Preppformation

   (* RC_StartPreppRules *)
( Rstartprepp100/1 | Rstartprepp120/2 )
.
   (* TC_PreppPatternRules *)
( TPPpreppattern0/3 | TPPpreppattern1/4 )
.
   (* RC_PPSuperdeixis *)
( Rppsuperdeixis/7 )
.
   (* RC_PreppModRules *)
[ RppAdvpmod/5 | RppNpmod/6 ]
.
   (* TC_PreppCaseAssign *)
( TPREPPca0/8 | TPREPPca1/9 )
.  
   (* RC_PreppSubst *)
{ Rppsubstitution1/10 | Rppsubstitution3/11 | 
  Rppsubstitution4/12  }
.
   (* TC_PreppToVar *)
( TNoPPtoVARPP/13 | TPPtoVARPP/14 )

HEAD:
<
SUBPREP     FROM (Prepderivation)
>

(* 
\end{verbatim}
\newpage
\begin{verbatim}
*)

(* IMPORT: *)
<
 2: < ARGUMENT 2     NPVAR           BASIC EXPRESSION
      ARGUMENT 2     CNVAR           BASIC EXPRESSION
      ARGUMENT 2     ADJPPROPVAR     BASIC EXPRESSION
      ARGUMENT 2     ADVPPROPVAR     BASIC EXPRESSION
      ARGUMENT 2     NPPROPVAR       BASIC EXPRESSION
      ARGUMENT 2     PREPPPROPVAR    BASIC EXPRESSION
      ARGUMENT 2     VERBPPROPVAR    BASIC EXPRESSION
      ARGUMENT 2     SENTENCEVAR     BASIC EXPRESSION
      ARGUMENT 2     EMPTYVAR        BASIC EXPRESSION
      ARGUMENT 2     PROSENTVAR      BASIC EXPRESSION
    >
 5: < ARGUMENT 2     ADVP            FROM (AdvpFormation)  >
 6: < ARGUMENT 2     NP              FROM (NPFormation)    >
10: < ARGUMENT 2     NP              FROM (NPFormation)    > 
11: < ARGUMENT 2     PREPP           FROM (PreppFormation) >
12: < ARGUMENT 2     ADVP            FROM (AdvpFormation)  >
>


EXPORT:
<
PREPP
VARPREPP
>
&

\end{verbatim}
\newpage
\begin{verbatim}

% RULE RStartPrepp100
< m1: SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1}] 
>

< m : PREPP{PREPPrec1}[head/PREP{PREPrec1}]
>

      COMP
         <
          C1: PREPrec1.thetapp = pp100 AND
              SUBPREPrec1 = PREPrec1   
          A1: PREPPrec1 := PREPPrecdef;
              PREPPrec1 := { thetapp    : pp100
                             headkey    : PREPrec1.key
                             actsubcefs : PREPrec1.subcs
                             class      : PREPrec1.class
                             deixis     : PREPrec1.deixis
                             aspect     : PREPrec1.aspect
                             retro      : PREPrec1.retro }
          >

      DECOMP
         <
          C1: PREPrec1.thetapp = pp100  AND
              PREPPrec1   = PREPPrecdef                  
                   EXCEPT FOR [thetapp, headkey, actsubcefs, class,
                                deixis, aspect, retro]       AND
              PREPPrec1 = { thetapp     : pp100 
                            headkey     : PREPrec1.key
                            actsubcefs  : PREPrec1.subcs
                            class       : PREPrec1.class
                            deixis      : PREPrec1.deixis
                            aspect      : PREPrec1.aspect 
                            retro       : PREPrec1.retro }
          A1: SUBPREPrec1 := PREPrec1;
         >

&

\end{verbatim}
