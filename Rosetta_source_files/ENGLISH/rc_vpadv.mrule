<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL AND
              CLAUSEVARrec1 = COPYT_clauseTOvar(CLAUSErec1) AND
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [superdeixis, PROsubject, aktionsarts] AND
              OPENADVPPROPrec1 = { aktionsarts  : [stative]
                                   PROsubject   : true } AND
              NPVARrec2 = NPVARrec1 EXCEPT FOR [ cases ] AND
              NPVARrec2.cases = [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis)
          A1: @
         >

      DECOMP
         <
          C1: true
