\newpage
\begin{verbatim}
% TRANSFORMATION TpppPROsubj
< m1:PREPPFORMULA{PREPPFORMULArec1}[mu1]
>

< m :PREPPFORMULA{PREPPFORMULArec2}[mu1]
>

      COMP
         <
          C1: PREPPFORMULArec1.prosubject = false
          A1: PREPPFORMULArec2 := PREPPFORMULArec1;
              PREPPFORMULArec2.prosubject := true;
         >
      DECOMP
         <
          C1: PREPPFORMULArec2.prosubject = true
          A1: PREPPFORMULArec1 := PREPPFORMULArec2;
              PREPPFORMULArec1.prosubject := false;
         >

&

\end{verbatim}
