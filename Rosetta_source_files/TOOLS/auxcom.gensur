PROCEDURAL PART
VAR str          : TSTRING_string;
    AbbrCounter  ::INT;
BEGIN
INIT: BEGIN
        AbbrCounter:=$$ABBRLIST.NumOfAbbrsInh; 
        BEGIN
        END;   
      END;
<*
1: <* SEND: BEGIN 
              BEGIN
                \of2.\GLOBAL.
                "["
              END;
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN 
              str:=%.str;
                \of2.\GLOBAL.
                ""str""
            END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN 
              BEGIN
                \of2.\GLOBAL.
                ","\\
              END;
            END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN 
              BEGIN
                \of2.\GLOBAL.
                "]"\\
              END;
            END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN
        AbbrCounter:=AbbrCounter - 1;
        $$ABBRLIST.NumOfAbbrsSyn:=AbbrCounter;
      END
END;
&

