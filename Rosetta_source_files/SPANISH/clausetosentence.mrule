%SUBGRAMMAR TESTNP

( RBperspro/1)


HEAD:
<
BPERSPRO BASIC EXPRESSION
>

<(* no import *)>

EXPORT:
< NP >
&

\newpage
% RULE Rbperspro
< m1:BPERSPRO{BPERSPROrec1} 
>

< m :NP{NPrec1}[head/PERSPRO{PERSPROrec1}
                     [ head/BPERSPRO{BPERSPROrec1}
                     ]
               ]
>

      COMP
         <
          C1: true
          A1: PERSPROrec1 := COPYT_Btoperspro(BPERSPROrec1);
	      NPrec1 :=
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  supertiempo   : presente
		  class         : omegaTimeAdvClass
		  tiempo        : omegatiempo
		  aspecto       : omegaaspecto
		  retro         : false
		  persona       : PERSPROrec1.persona
		  genero        : PERSPROrec1.genero 
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  actcomas      : [count]
		  mood          : declxpmood
		  numero        : PERSPROrec1.numero
		  definite      : def
		  generic       : nogeneric
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  syntquant     : omegaquant
		  NPhead        : persproNP
		  specQ         : yesspec
                  defSpec       : false
		  cases         : []
		  }
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_Btoperspro(BPERSPROrec1) AND
	      NPrec1=
 		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  supertiempo   : presente
		  class         : omegaTimeAdvClass
		  tiempo        : omegatiempo
		  aspecto       : omegaaspecto
		  retro         : false
		  persona       : PERSPROrec1.persona
		  genero        : PERSPROrec1.genero
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  actcomas      : [count]
		  mood          : declxpmood
		  numero        : PERSPROrec1.numero
		  definite      : def
		  generic       : nogeneric
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  syntquant     : omegaquant
		  NPhead        : persproNP
		  specQ         : yesspec
                  defSpec       : false
		  cases         : []
		  }
          A1: @
         >
&

