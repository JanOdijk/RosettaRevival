\begin{verbatim}
%
% RULE Rfinpresentdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                 I2:[I4:mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                I3:[I4:mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu5, [tempadvrel/..])
       I2: VERBrec1.subc = haveverb ->
           NOT EXIST (mu3, [auxrel/T2])
       I3: VERBrec2.subc = haveverb ->
           NOT EXIST (mu3, [auxrel/T2])
       I4: NOT EXIST (mu2, [rel2/VERB{VERBrec3}[mu8]])
      >

<
   SUBRULE
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            ((ADVPVARrec1.deixis = presentdeixis) OR
             (ADVPVARrec1.deixis = omegadeixis)
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [14] = []) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspect <> perfective) OR
               ((CLAUSErec1.aspect = perfective) AND
                (ADVPVARrec1.deixis = presentdeixis) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;

             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis) 
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := presentdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.tense := presenttense;

         >
      DECOMP
         <
          C1:((VERBrec2.tense = presenttense) AND
              (VERBrec2.conjclasses * [14] = []) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = presentdeixis) AND
              ((CLAUSErec2.aspect <> perfective) OR
               ((CLAUSErec2.aspect = perfective) AND
                (ADVPVARrec1.deixis = presentdeixis) AND
                (CLAUSErec2.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = omegadeixis)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := presentdeixis;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tense := omegatense;
              CLAUSErec1.deixis := omegadeixis;

         >

   SUBRULE
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            ((PREPPVARrec1.deixis = presentdeixis) OR
             (PREPPVARrec1.deixis = omegadeixis)
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [14] = []) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspect <> perfective) OR
               ((CLAUSErec1.aspect = perfective) AND
                (PREPPVARrec1.deixis = presentdeixis) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := presentdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.tense := presenttense;

         >
      DECOMP
         <
          C1:((VERBrec2.tense = presenttense) AND
              (VERBrec2.conjclasses * [14] = []) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = presentdeixis) AND
              ((CLAUSErec2.aspect <> perfective) OR
               ((CLAUSErec2.aspect = perfective) AND
                (PREPPVARrec1.deixis = presentdeixis) AND
                (CLAUSErec2.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = omegadeixis)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := presentdeixis;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tense := omegatense;
              CLAUSErec1.deixis := omegadeixis;

         >


   SUBRULE
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            ((SENTENCErec1.conjdeixis = presentdeixis) OR
             (SENTENCErec1.conjdeixis = omegadeixis)
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [14] = []) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec2.aspect <> perfective) OR
               ((CLAUSErec2.aspect = perfective) AND
                (SENTENCErec1.deixis = presentdeixis) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := presentdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.tense := presenttense;

         >
      DECOMP
         <
          C1:((VERBrec2.tense = presenttense) AND
              (VERBrec2.conjclasses * [14] = []) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = presentdeixis) AND
              ((CLAUSErec2.aspect <> perfective) OR
               ((CLAUSErec2.aspect = perfective) AND
                (SENTENCErec1.deixis = presentdeixis) AND
                (CLAUSErec2.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = omegadeixis)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := presentdeixis;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tense := omegatense;
              CLAUSErec1.deixis := omegadeixis;

         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpresentdeixis
\item[* relevant examples:] he works,
he is working,
he can,
he is ill,
* he uses to
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 25-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentdeixis Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 17/11/88\ \ \ \ \ author: Lisette Appelo 
\item date: 01/02/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on retro.
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT.
               This rule is for a finite independent clause.
               The most left verb in the clause gets a present tense.
               The deixis 
value of the reference adverbial is checked for 
               present or omega.
               The clause is marked for present deixis.
\item[\ \ strategy:] the match is assumed to be left to right.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be presentdeixis in the case 
this sentence is a sentence with adverbs such as {\em graag} in Dutch. 
In English this may be 
the case in cases in which e.g. a verb is a semantic head but behaves as an  
auxiliary verb (e.g. some modal verbs)\\
14/11/88: Added conditions on perfectivity and deixis of adverbial. Perfective 
present is only allowed if there is a present deixis adverbial. Excluded are 
omega deixis adverbials such as {\em at 3 o'clock}.
17/11/88: Added condition on absence of durative adverbial in case of 
perfective aspect to avoid {\em He swims for four hours}. This sentence has 
only an habitual interpretation.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rfinpastdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}
                        [head/SUBVERB{SUBVERBrec1}
                             [head/BVERB(KEY1){BVERBrec1}]
                        ],
                    mu3
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}
                        [head/SUBVERB{SUBVERBrec1}
                             [head/BVERB(KEY1){BVERBrec1}]
                        ],
                    mu3
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu5, [tempadvrel/..])
      >

<
   SUBRULE
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            ((ADVPVARrec1.deixis = pastdeixis) OR
             (ADVPVARrec1.deixis = omegadeixis) OR
             (ADVPVARrec1.deixis = futuredeixis )
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (CLAUSErec1.aspect <> habitual) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [13] = []) AND
              (CLAUSErec1.finiteness = finite) AND
              (ADVPVARrec1.deixis = futuredeixis ->
               KEY1 = KEY_willbverbkey)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.tense := pasttense;

         >
      DECOMP
         <
          C1:((VERBrec2.tense = pasttense) AND
              (VERBrec2.conjclasses * [13] = []) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect <> habitual) AND
              (CLAUSErec2.deixis = pastdeixis) AND
              (ADVPVARrec1.deixis = futuredeixis ->
               KEY1 = KEY_willbverbkey)
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = omegadeixis)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := pastdeixis;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tense := omegatense;
              CLAUSErec1.deixis := omegadeixis;

         >

   SUBRULE
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            ((PREPPVARrec1.deixis = pastdeixis) OR
             (PREPPVARrec1.deixis = omegadeixis) OR
             (PREPPVARrec1.deixis = futuredeixis )
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (CLAUSErec1.aspect <> habitual) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [13] = []) AND
              (CLAUSErec1.finiteness = finite) AND
              (PREPPVARrec1.deixis = futuredeixis ->
               KEY1 = KEY_willbverbkey)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.tense := pasttense;

         >
      DECOMP
         <
          C1:((VERBrec2.tense = pasttense) AND
              (VERBrec2.conjclasses * [13] = []) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect <> habitual) AND
              (CLAUSErec2.deixis = pastdeixis) AND
              (PREPPVARrec1.deixis = futuredeixis ->
               KEY1 = KEY_willbverbkey)
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = omegadeixis)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := pastdeixis;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tense := omegatense;
              CLAUSErec1.deixis := omegadeixis;

         >


   SUBRULE
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            ((SENTENCErec1.conjdeixis = pastdeixis) OR
             (SENTENCErec1.conjdeixis = omegadeixis) OR
             (SENTENCErec1.conjdeixis = futuredeixis )
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (CLAUSErec1.aspect <> habitual) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [13] = []) AND
              (CLAUSErec1.finiteness = finite) AND
              (SENTENCErec1.conjdeixis = futuredeixis ->
               KEY1 = KEY_willbverbkey)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := pastdeixis;
              VERBrec2 := VERBrec1;
              VERBrec2.tense := pasttense;

         >
      DECOMP
         <
          C1:((VERBrec2.tense = pasttense) AND
              (VERBrec2.conjclasses * [13] = []) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect <> habitual) AND
              (CLAUSErec2.deixis = pastdeixis) AND
              (SENTENCErec1.conjdeixis = futuredeixis ->
               KEY1 = KEY_willbverbkey)
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = omegadeixis)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := pastdeixis;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tense := omegatense;
              CLAUSErec1.deixis := omegadeixis;

         >

>
&

\end{verbatim}
