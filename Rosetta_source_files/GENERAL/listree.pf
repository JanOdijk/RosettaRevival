(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIStree_SaveParseResult
 *  Description     : Saves the Dtrees resulting from applying M-Parser to t.
 *  Parameters      : ds : LIStree_pSetOfSuperDtree;
 *                    VAR t : LIStree_pStree
 *  Precondition    : ds CAST SuperDtree_SetOfSuperDtree = M-Parser(t)
 *  Postcondition   : LIStree_IsParseResultSaved(t)
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE LIStree_SaveParseResult (ds : LIStree_pSetOfSuperDtree;
                                              VAR t : LIStree_pStree);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIStree_IsParseResultSaved
 *  Description    : Tells whether the result of applying M-parser to t has been
 *                   saved.
 *  Parameters     : t : LIStree_pStree
 *  Result         : TRUE iff the result of applying M-parser to t has been
 *                   saved.
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION LIStree_IsParseResultSaved (t : LIStree_pStree)
                    : BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIStree_ReturnParseResult
 *  Description    : Returns the Dtrees resulting from applying M-Parser to t.
 *  Parameters     : t : LIStree_pStree
 *  Result         : LIStree_pSetOfSuperDtree
 *  Precondition   : LIStree_IsParseResultSaved(t)
 *  Postcondition  : RETURNS ds AND ds CAST SuperDtree_pSetOfSuperDtree = M-Parser(t)
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION LIStree_ReturnParseResult (t : LIStree_pStree)
                    : LIStree_pSetOfSuperDtree;
EXTERNAL;

