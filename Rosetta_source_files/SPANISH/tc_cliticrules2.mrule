\begin{verbatim}
%TRANSFORMATION TDOclminusPERSPRO
< m1:I1::CLAUSE{CLAUSErec1}
            [ mu1,
              cliticrel/CLITIC{}[mu7],
              head/I5::VERB{VERBrec1}[mu3],
                            predrel/VERBP{VERBPrec1}[ mu4,
                                        I3:rel1/I4::NP{NPrec1}[mu5],
                                        mu6 
                                      ],
              mu9
            ]
>

< m:I1::CLAUSE{CLAUSErec1}
            [ mu1,
              cliticrel/CLITIC{}[mu8],
              head/I5::VERB{VERBrec1}[mu3],
                            predrel/VERBP{VERBPrec1}[ mu4,
                                        mu6
                                      ],
              mu9
            ]
>


   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.finiteness = finite)  AND
           (CLAUSErec1.voice <> SEpassive) 
         (*   AND
           (NPrec1.animate = noanimate -> 
            NOT EXIST (mu1, [subjrel/I61::NP{NPrec6}])) 
                      I61: NPrec6.NPhead = SEimpershead   *)
       I3: rel1 IN [objrel, predrel]
       I4: (NPrec1.NPhead = persproNP)   AND
           (Prepositive IN NPrec1.cases) OR
           (Accusative IN NPrec1.cases) 
       I5: NOT (VERBrec1.thetaVP IN [vp010, vp012, vp021])
      >


<
   SUBRULE  (* me + deletion of mí; masc. *)
      <mu7: [I11:mu11]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_yomascBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel9/..]))  AND
             ALL (mu11, seCLrel/..)  
       I112: rel9 IN [unoCLrel, dosCLrel, tresCLrel]
       >

      COMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc) 
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 1;
              PERSPROrec1.genero := masc;
              PERSPROrec1.forma := acusCL;
              rel3 := unoCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)  AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                          AND
              (PERSPROrec1.persona = 1)       AND
              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >

