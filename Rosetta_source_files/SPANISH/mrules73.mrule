\begin{verbatim}
% RULE RNPPastSuperdeixis1
< m1: NP{NPrec1}[mu1,
                 head/CN{CNrec1}[mu4],
                 mu2
                 ] 
>

< m: NP{NPrec2}[mu1,
                 head/CN{CNrec2}[mu4],
                 mu2
                 ] 
>

   MATCHCONDITIONS
      <
       m1: NPrec1.supertiempo = omegatiempo 
       m: NPrec2.supertiempo = pasado
      >


      COMP
         <
          C1: CNrec1.supertiempo = pasado
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := pasado;
              CNrec2 := CNrec1;
              CNrec2.supertiempo := omegatiempo ;
         >
      DECOMP
         <
          C1: CNrec2.supertiempo = omegatiempo 
          A1: NPrec1 := NPrec2;
              CNrec1 := CNrec2;
              CNrec1.supertiempo := pasado;
              NPrec1.supertiempo := omegatiempo ;
         >
&
 
\end{verbatim}
