% TRANSFORMATION TNoAgreement
< m1: I1::CLAUSE{CLAUSErec1}[mu1]
>

< m : I1::CLAUSE{CLAUSErec1}[mu1]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = infinite
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

