\newpage
\begin{verbatim}
% RULE RIndicFutMoodSub1          (* decl. with `do' replaced by `will' *)
< m1: I2::CLAUSE{CLAUSErec1}
                [ I4:sig1,
                  I1:mu1,
                  auxrel/VERB{VERBrec1}
                        [head/SUBVERB{SUBVERBrec1}
                             [head/BVERB(KEY_doBVERBkey){BVERBrec1}]
                        ],
                  mu3
                ]
>

< m : I3::SENTENCE{SENTENCErec1}
                  [I4:sig1,
                   conjrel/CONJ(KEY_thatCONJkey){CONJrec1},
                   I1:mu1,
                   auxrel/VERB{VERBrec2}
                         [head/SUBVERB{SUBVERBrec2}
                              [head/BVERB(KEY_willBVERBkey){BVERBrec2}]
                         ],
                   mu3
                  ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [conjrel/..]) AND
           NOT EXIST (mu1, [shiftrel/..])
       I2: CLAUSErec1.finiteness = finite  AND
           CLAUSErec1.modus = omegamodus
           (* no condition on deixis for subordinate clauses *)
       I3: SENTENCErec1 = { modus      : indicative
                            finiteness : finite
                            mood       : declarative
                            senttype   : subordinateclause
                            conjkey    : KEY_thatCONJkey
                            adverbial  : false
                            temporal   : false
                            conjdeixis : omegadeixis
                            conjretro  : false
                            conjclass  : omegaTimeAdvclass
                            conjaspect : omegaaspect }
       I4: ALL (sig1, shiftrel/..)
      >


      COMP
         <
          C1: VERBrec1.modus = omegamodus AND
              VERBrec1 = COPYT_subverbTOverb(SUBVERBrec1) AND
              SUBVERBrec1 = COPYT_bverbTOsubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix
          A1: SUBVERBrec2 := COPYT_bverbTOsubverb(BVERBrec2);
              SUBVERBrec2.affix := noaffix;
              VERBrec2 := COPYT_subverbTOverb(SUBVERBrec2);
              VERBrec2 := { modus   : indicative
                            tense   : VERBrec1.tense
                            persons : VERBrec1.persons
                            numbers : VERBrec1.numbers };
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              (* including finiteness and deixis *)
              SENTENCErec1 := { mood     : declarative
                                senttype : subordinateclause
                                modus    : indicative 
                                conjkey  : KEY_thatCONJkey }
            (* other attributes specific to sentence
               retain default values *)
         >

      (* no DECOMP part *)
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RIndicFutMoodSub1
\item[* relevant examples:] (only two examples found so far)\\
(he promised) $_{CL}$[he did see me] $\rightarrow$ (he promised) $_{S}$[that 
he would see me]\\
(you insist on it) $_{CL}$[what you do visit] $\rightarrow$ (you insist on 
it) $_{S}$[ what that you will visit] (finally: what do you insist on (??it) 
that you will visit?)
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] ClauseTOSentence
\item[* class:] (name of rule, transformation or filter class) RC\_
MoodDetermination
\item[* date of creation:] 07-MAR-1989
\item[* author:] margreet sanders
\item[* copied from:] RIndicMoodSub
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to create a subordinate sentence starting with {\em that\/} and 
having the auxiliary `will' in stead of `do'
\item[\ \ strategy:] (also: deviations from accepted proposals) This is a 
generative rule that deals with a finite translation of LInjunSub (the Dutch 
openomteinf-mood). In analysis, a finite English subsentence with `will' should 
be dealt with by ordinary finite mood rules, hence translating into a Dutch 
finite: I promised that I would swim $\rightarrow$ Ik beloofde dat ik zou 
zwemmen ($^{*}$Ik beloofde (om) te zwemmen)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed that the conjunction `that' will be deleted later if necessary 
(obligatory for wh-shift of subj, optionally for ordinary subsentences)
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
No rules exist yet for subsentences taking an obligatory `should' in stead of 
`would', like {\em order\/}: Ik beval hem om weg te gaan $\rightarrow$ I 
ordered (?him) that he should leave.
\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RIndicFutMoodSub2          (* decl. with extra `will' *)
< m1: I2::CLAUSE{CLAUSErec1}
                [ I4:sig1,
                  I1:mu1,
                  auxrel/I6::VERB{VERBrec1}[mu2],
                  mu3,
                  predrel/VERBP{VERBPrec1}
                         [ I5:mu5,
                           rel1/VERB{VERBrec3}[mu4],
                           mu6
                         ],
                  mu7
                ]
>

< m : I3::SENTENCE{SENTENCErec1}
                 [ I4:sig1,
                   conjrel/CONJ(KEY_thatCONJkey){CONJrec1},
                   I1:mu1,
                   auxrel/VERB{VERBrec2}
                         [head/SUBVERB{SUBVERBrec2}
                              [head/BVERB(KEY_willBVERBkey){BVERBrec2}]
                         ],
                   mu3,
                   predrel/VERBP{VERBPrec1}
                          [ I5:mu5,
                            rel2/I7::VERB{VERBrec3}[mu2],
                            rel1/VERB{VERBrec3}[mu4],
                            mu6
                          ],
                   mu7
                 ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [conjrel/..]) AND
           NOT EXIST (mu1, [shiftrel/..])
       I2: CLAUSErec1.finiteness = finite  AND
           CLAUSErec1.modus = omegamodus
           (* no condition on deixis for subordinate clauses *)
       I3: SENTENCErec1 = { modus      : indicative
                            finiteness : finite
                            mood       : declarative
                            senttype   : subordinateclause
                            conjkey    : KEY_thatCONJkey
                            adverbial  : false
                            temporal   : false
                            conjdeixis : omegadeixis
                            conjretro  : false
                            conjclass  : omegaTimeAdvclass
                            conjaspect : omegaaspect }
       I4: ALL (sig1, shiftrel/..)
       I5: NOT EXIST (mu5, [../VERB{VERBrec5}[mu8]])
       I6: VERBrec1.subc IN [haveVerb, beVerb]
       I7: VERBrec3.subc IN [haveVerb, beVerb]
      >


      COMP
         <
          C1: VERBrec1.modus = omegamodus 
            C11: VERBrec1.subc = haveVerb
            A11: rel2 := auxrel
            C12: VERBrec1.subc = beVerb AND
                 CLAUSErec1.voice <> passive
            A12: rel2 := progauxrel
            C13: VERBrec1.subc = beVerb AND
                 CLAUSErec1.voice = passive
            A13: rel2 := passauxrel
          A1: SUBVERBrec2 := COPYT_bverbTOsubverb(BVERBrec2);
              SUBVERBrec2.affix := noaffix;
              VERBrec2 := COPYT_subverbTOverb(SUBVERBrec2);
              VERBrec2 := { modus   : indicative
                            tense   : VERBrec1.tense
                            persons : VERBrec1.persons
                            numbers : VERBrec1.numbers };
              VERBrec3 := VERBrec1;
              VERBrec3 := { modus   : infinitive
                            tense   : omegatense
                            persons : []
                            numbers : [] } ;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              (* including finiteness and deixis *)
              SENTENCErec1 := { mood     : declarative
                                senttype : subordinateclause
                                modus    : indicative 
                                conjkey  : KEY_thatCONJkey }
            (* other attributes specific to sentence
               retain default values *)
         >

      (* no DECOMP part *)
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RIndicFutMoodSub2
\item[* relevant examples:] (only two examples found so far)\\
(he promised) $_{CL}$[he had seen the doctor by then] $\rightarrow$ (he 
promised) $_{S}$[that he would have seen the doctor by then]\\
(you insist on) $_{CL}$[what you are visiting tomorrow morning] $\rightarrow$ 
(you insist on) $_{S}$[ what that you will be visiting tomoroow morning] 
(finally: what do you insist on (??it) that you will be visiting tomorrow 
morning?) 
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] ClauseTOSentence
\item[* class:] (name of rule, transformation or filter class) RC\_
MoodDetermination
\item[* date of creation:] 07-MAR-1989
\item[* author:] margreet sanders
\item[* copied from:] RIndicFutMoodSub1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to create a subordinate sentence starting with {\em that\/} and 
having the auxiliary `will' next to another auxiliary. Note that modals are not 
accepted here (.. $^{*}$that he would could swim; $^{*}$that he would will 
swim). Therefore, for the examples given above, with an overt temporal 
expression, Lisette will probably already have introduced the auxiliary `will';
however, when there is no temporal expression the current rule is necessary.
\item[\ \ strategy:] (also: deviations from accepted proposals) This is a 
generative rule that deals with a finite translation of LInjunSub (the Dutch 
openomteinf-mood). In analysis, a finite English subsentence with `will' should 
be dealt with by ordinary finite mood rules, hence translating into a Dutch 
finite: I promised that I would swim $\rightarrow$ Ik beloofde dat ik zou 
zwemmen ($^{*}$Ik beloofde (om) te zwemmen)
\item[\ \ rejected alternatives:] to have a an indicfutmoodsub based on an 
infinitive; this would probably have been easier, since all verbs already are in
the VP then, and no auxiliary `do' is inserted (see previous rule). However, I 
was not certain how the CLAUSE attributes had to be changed when going from an 
infinite to a finite sentence.
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed that the conjunction `that' will be deleted later if necessary 
(obligatory for wh-shift of subj, optionally for ordinary subsentences)
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
No rules exist yet for subsentences taking an obligatory `should' in stead of 
`would', like {\em order\/}: Ik beval hem om weg te gaan $\rightarrow$ I 
ordered (?him) that he should leave.
\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RIndicWhMoodMain                (* wh main clause, indicative *)
< m1:I2::CLAUSE{CLAUSErec1}
               [ I4:sig1,
                 I1:shiftrel/T1,
                 mu1,
                 auxrel/VERB{VERBrec1}[mu2],
                 mu3
               ] 
>

< m :I3::SENTENCE{SENTENCErec1}
                 [ I4:sig1,
                   I1:shiftrel/T1,
                   mu1,
                   auxrel/VERB{VERBrec2}[mu2],
                   mu3
                 ] 
>

   MATCHCONDITIONS
      <
       I1 : T1.CAT IN [NP, PREPP, ADJP, ADVP] WITH
            T1.REC.mood = wh
       I2 : CLAUSErec1.finiteness = finite  AND
            CLAUSErec1.deixis <> omegadeixis AND
            CLAUSErec1.modus = omegamodus
       I3 : SENTENCErec1.deixis <> omegadeixis AND
            SENTENCErec1 = { modus      : indicative
                             finiteness : finite
                             mood       : whinterrogative
                             senttype   : mainclause
                             conjkey    : 0
                             adverbial  : false
                             temporal   : false
                             conjclass  : omegaTimeAdvClass
                             conjdeixis : omegadeixis
                             conjaspect : omegaAspect
                             conjretro  : false }
       I4 : ALL (sig1, I41:leftdislocrel/SENTENCE{SENTENCErec2}[mu4])
          I41: SENTENCErec2.adverbial =  true
      >

      COMP
         <
          C1: VERBrec1.modus = omegamodus
          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := indicative;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : whinterrogative
                                senttype : mainclause
                                modus    : indicative }
            (* other attributes specific for sentence 
               retain default values *)
         >

      DECOMP
         <
          C1: VERBrec2.modus = indicative 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus
         >

&

\end{verbatim}
