{ general spellingrules }

{ after ñ the unstressed i of the verb-ending is deleted: 
                   *riñió --> riñó                                 
  after ll the unstressed i of the verb-ending is deleted: 
                     *mullió --> mulló                        
  after y the unstressed i of the verb-ending is deleted: leyió --> leyó }


*(MED5)  +  SFKio1        ::  *(MED5)ó ;
*(MED5)  +  SFKieron      ::  *(MED5)eron ;
*(MED5)  +  SFKiera       ::  *(MED5)era ;
*(MED5)  +  SFKieras      ::  *(MED5)eras ;
*(MED5)  +  SFKie1ramos   ::  *(MED5)éramos ;
*(MED5)  +  SFKierais     ::  *(MED5)erais ;
*(MED5)  +  SFKieran      ::  *(MED5)eran ;
*(MED5)  +  SFKiese       ::  *(MED5)ese ;
*(MED5)  +  SFKieses      ::  *(MED5)eses ;
*(MED5)  +  SFKie1semos   ::  *(MED5)ésemos ;
*(MED5)  +  SFKieseis     ::  *(MED5)eseis ;
*(MED5)  +  SFKiesen      ::  *(MED5)esen ;
*(MED5)  +  SFKiendo      ::  *(MED5)endo ;


*(LETl)l  +  SFKio1       ::  *(LETl)lió ;
*(LETl)l  +  SFKieron     ::  *(LETl)lieron ;
*(LETl)l  +  SFKiera      ::  *(LETl)liera ;
*(LETl)l  +  SFKieras     ::  *(LETl)lieras ;
*(LETl)l  +  SFKie1ramos  ::  *(LETl)liéramos ;
*(LETl)l  +  SFKierais    ::  *(LETl)lierais ;
*(LETl)l  +  SFKieran     ::  *(LETl)lieran ;
*(LETl)l  +  SFKiese      ::  *(LETl)liese ;
*(LETl)l  +  SFKieses     ::  *(LETl)lieses ;
*(LETl)l  +  SFKie1semos  ::  *(LETl)liésemos ;
*(LETl)l  +  SFKieseis    ::  *(LETl)lieseis ;
*(LETl)l  +  SFKiesen     ::  *(LETl)liesen ;
*(LETl)l  +  SFKiendo     ::  *(LETl)liendo ;



{NB. It has been decided to treat *reir as real irregular, i.e. it is listed.}

{ If the stem is ending on a strong vowel, an accent is placed on the
  unstressed initial i of the verb-ending: re+imos --> reímos         
}

*(KLINK) + SFKimos    ::  *(KLINK)ímos ;
*(KLINK) + SFKiste    ::  *(KLINK)íste ;
*(KLINK) + SFKisteis  ::  *(KLINK)ísteis ;
*(KLINK) + SFKido     ::  *(KLINK)ído ;     { EvM 4/4/90  }
*(KLINK) + SFKida     ::  *(KLINK)ída ;     { EvM 11/4/89 }
*(KLINK) + SFKidos    ::  *(KLINK)ídos ;    { EvM 11/4/89 }
*(KLINK) + SFKidas    ::  *(KLINK)ídas ;    { EvM 11/4/89 }
*(KLINK) + SFKir      ::  *(KLINK)ír ;


{ verbs ending on -ar:                                              }
{ stem ending on z + ending starting with e/i --> z turns into c    }
{ cruz + e --> cruce                                                }
{ i.e.:  before a/o : z                                             }
{        before e/i : c                                             }

*z   +   SFKe      ::  *ce ;
*z   +   SFKe1     ::  *cé ;
*z   +   SFKes     ::  *ces ;
*z   +   SFKemos   ::  *cemos ;
*z   +   SFKe1is   ::  *céis ;
*z   +   SFKen     ::  *cen ;


