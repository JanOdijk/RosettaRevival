\newpage
\begin{verbatim}
% TRANSFORMATION tPPpreppattern1
< m1:PREPP{PREPPrec1}
          [ head/PREP{PREPrec1},
            argrel/T1,
            mu2
          ]
>

< m :PREPP{PREPPrec2}
          [ head/PREP{PREPrec1},
            rel1/T1,
            mu2
          ]
>

<
   SUBRULE
      <T1:T2 >
      <T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR,CNVAR]
      >

      COMP
         <
          C1: synNP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  
          A1: rel1 := objrel;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synNP];
         >
      DECOMP
         <
          C1:  synNP IN PREPrec1.synpps AND
               rel1 = objrel            AND
               synNP IN PREPPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
         >


   SUBRULE         (* from before the war *)
      <T1:T2 >
      <T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [PREPPVAR]
      >

      COMP
         <
          C1: synLOCPREPP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  
          A1: rel1 := objrel;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synLOCPREPP];
         >
      DECOMP
         <
          C1:  synLOCPREPP IN PREPrec1.synpps AND
               rel1 = objrel            AND
               synLOCPREPP IN PREPPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
         >



   SUBRULE       (* till tomorrow , since yesterday*)
      <T1:T2 >
      <T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [ADVPVAR]
      >

      COMP
         <
          C1: synLOCPREPP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  
          A1: rel1 := objrel;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synLOCPREPP];
         >
      DECOMP
         <
          C1:  synLOCPREPP IN PREPrec1.synpps AND
               rel1 = objrel            
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
         >


>


&

\end{verbatim}
