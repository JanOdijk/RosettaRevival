\begin{description}
\item[* name:] RIdSubstitution1
\item[* relevant examples:] x1 mandar a x2  a x2 buscar x3
\item[* language:] (Dutch, English, Spanish) Dutch
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) RC:Substitution
\item[* date of creation:] 01-FEB-1987 10:33:40  
\item[* author:] Andr\'{e} Schenk
\item[* copied from:]--
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] It substitutes nongeneric NPs for variables under VP, in 
particular, for variables bearing relation objrel or indobjrel.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
The function assigncase must assign a set of cases !!
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
The substitution order condition must be added. This is not simple !!
Also to be added: polarity requirements, supertiempo
\item modifications:\\

\end{enumerate}
\end{description}


% RULE Rsubstitution1
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              rel1/I1::NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4
            ] 
SUBST:
  m2: NP{NPrec1}[mu5]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              rel1/I2::NP{NPrec2}[mu6],
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4
            ] 
>

   MATCHCONDITIONS
      <
       m1: QUOTE_gsubstordercondition(mu2, mu3, mu4)
       m : QUOTE_substordercondition(mu2, mu3, mu4)
       I1: NPVARrec1.index = LEVEL AND NPVARrec1.mood <> relativexpmood 
       I2: NPrec2.NPhead <> enNP 
       m2: NPrec1.NPhead <> enNP  
     >


   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases]
              AND
              NPrec1.cases = []  AND
              ((NPrec1.supertiempo = CLAUSErec1.supertiempo) OR
               (NPrec1.supertiempo = CLAUSErec1.tiempo)
              )
          A1: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases);
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo := omegatiempo;
         >

      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo

              C11: CLAUSErec1.supertiempo = omegatiempo
                   C111: [NPrec2.NPhead] * [redellosNP, unoNP] = []
                   A111: NPVARrec1 := COPYT_nptovar(NPrec2);
                         (* including cases *)
                         NPVARrec1 := { generic : nogeneric
                                        index   : LEVEL
                                       };
              NPrec1.generic := nogeneric;
              A11: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []);
                   NPrec1.supertiempo := CLAUSErec1.tiempo;
                   
              C12: CLAUSErec1.supertiempo <> omegatiempo
                   C111: [NPrec2.NPhead] * [redellosNP, unoNP] <> []
                   A111: NPVARrec1 := COPYT_nptovar(NPrec2);
                         (* including cases *)
                         NPVARrec1 := { generic : yesgeneric
                                        index   : LEVEL
                                       };
              NPrec1.generic := yesgeneric;
              A12: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []);
                   NPrec1.supertiempo := CLAUSErec1.supertiempo;

          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rsubstitution1
\item[* relevant examples:]
x1 nada $\rightarrow$\\
Juan nada
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] RC:Substitution
\item[* date of creation:] 9-MAY-1988 13:00:00  
\item[* author:] Elly van Munster
\item[* copied from:] Jan Odijk (Rsubstitution2)
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 24/08/88\ \ \ \ \ author: Lisette Appelo
\item date: 17/10/89\ \ \ \ \ author: Lisette Appelo\\
Changed and added conditions on generic for redellosNP and unoNP.
\end{enumerate}
\item[* task:] To substitute NPs for variables under S with subjrel.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
\begin{itemize}
\item In COMP the attribute value "generic" is set to "omegageneric" for
efficiency reasons: an NP is not generic itself, but determined by the
context. So at the surface (and thus for the surface-parser) the value can be 
omega.
\item Also to be added: polarity requirements.
\item A QOUTE function to handle the supertiempo assignment should substitute 
the conditions and actions.
\end{itemize}
\item modifications: supertiempo conditions and actions have been added (LA)\\

\end{enumerate}
\end{description}

% RULE RSubstitution2                  (* NP in VP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I2:rel1/I1::NPVAR{NPVARrec1},
                      mu3
                    ],
             mu4 
           ] 
SUBST:
  m2: NP{NPrec1}[mu5]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I2:rel1/NP{NPrec2}[mu6],
                      mu3
                    ],
             mu4 
           ] 
>

   MATCHCONDITIONS
      <
       m1: QUOTE_Gsubstordercondition2(mu3,mu4) 
       m : QUOTE_substordercondition2(mu3, mu4) 
       I1: NPVARrec1.index = LEVEL
       I2: rel1 IN [ idrel, objrel, predrel] AND
           NPrec2.NPhead <> enNP 
       m2: NPrec1.NPhead <> enNP 
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = []   AND
              NPrec1.generic = nogeneric
              C11: CLAUSErec1.tiempo = omegatiempo              AND
                   NPrec1.supertiempo = CLAUSErec1.supertiempo
              A11: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo := omegatiempo
              C12: CLAUSErec1.tiempo <> omegatiempo             AND
                   NPrec1.supertiempo = CLAUSErec1.tiempo
              A12: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo := omegatiempo  
          A1: NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric 
              C11: CLAUSErec1.tiempo = omegatiempo AND
                   NPrec2.supertiempo = omegatiempo
              A11: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[]); 
                   NPrec1.supertiempo := CLAUSErec1.supertiempo;
              C12: CLAUSErec1.tiempo <> omegatiempo AND
                   NPrec2.supertiempo = omegatiempo  
              A12: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[]); 
                   NPrec1.supertiempo := CLAUSErec1.tiempo;
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.cases := NPrec2.cases;
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric;
              NPVARrec1.generic := nogeneric;
         >

&

\end{verbatim}

