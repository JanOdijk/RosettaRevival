      RECEIVE: BEGIN
               str:=%VALUENAME.str;
               \copy.\LOCAL.
               ""str""
               END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               \copy.\LOCAL.
               ","\\
               END
   *>
*>
FINAL:BEGIN 
            \copy.\LOCAL.
            "]"
            $$SETVALUENAME.copy:=copy;
      END
END;
