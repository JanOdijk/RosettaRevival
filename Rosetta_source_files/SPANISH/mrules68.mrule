\begin{verbatim}
(* regel uitgezet *)
 RULE RADJEMPTYSUBST3
                               (*subst of EMPTY as a aanobjrel/..*)
                               (* hij is bekend *)

< m1: I1::ADJPFORMULA{ADJPFORMULArec1}
                [ mu1,
                  predrel/ADJP{ADJPrec1}
                      I8:[ I2:mu2,
                           aanobjrel/EMPTYVAR{EMPTYVARrec1},
                           I3:mu3
                         ],
                  mu4 
                ]
SUBST:
  m2: EMPTY{EMPTYrec1}            (*substituent*)
>

< m : I9::ADJPFORMULA{ADJPFORMULArec2}
                [ mu1,
                  predrel/ADJP{ADJPrec2}
                      I8:[ I2:mu2,
                           I6:mu3
                         ],
                  mu4 
                ]
>

   MATCHCONDITIONS
      <
       I1: ADJPFORMULArec1.adjpatternefs * [synIOEMPTY_DONP] <> []
       I2: ALL(mu2, I4:rel1/..)
       I3: NOT EXIST(mu3, [aanobjrel/..])
       I4: rel1 IN [causadvrel, tempadvrel, locadvrel, negrel, head, 
                    degreemodrel]
       I6: NOT EXIST(mu3, [aanobjrel/..]) AND
           ( (NOT EXIST(mu3,[rel10/EMPTYVAR{}]) ) AND
             (NOT EXIST(mu3,[rel11/VARPREPP{}[I7:mu5]]))
           )   (* substordercond *)
       I7: EXIST(mu5,[../EMPTYVAR{}])
       I8: RIGHTTOLEFT
       I9: ADJPFORMULArec2.adjpatternefs * [synIOEMPTY_DONP] <> []
      >

   PARAMETERS
      <
       LEVEL
      >
      COMP
         <
          C1: EMPTYVARrec1.index = LEVEL
          A1: ADJPFORMULArec2 := ADJPFORMULArec1;
              ADJPFORMULArec2.adjpatternefs := 
                 ADJPFORMULArec1.adjpatternefs * [synIOEMPTY_DONP];
              ADJPrec2 := ADJPrec1;
              ADJPrec2.adjpatternefs := 
                 ADJPFORMULArec2.adjpatternefs 
         >
      DECOMP
         < 
          C1:  ADJPrec2.adjpatternefs = ADJPFORMULArec2.adjpatternefs 
          A1: EMPTYVARrec1.index := LEVEL;
              ADJPrec1 := ADJPrec2;
              ADJPFORMULArec1 := ADJPFORMULArec2;
              ADJPFORMULArec1.adjpatternefs := 
                 ADJPFORMULArec2.adjpatternefs * [synIOEMPTY_DONP];
              ADJPrec1.adjpatternefs := 
                 ADJPFORMULArec1.adjpatternefs

         >


&

\end{verbatim}
