\begin{verbatim}
% TRANSFORMATION TSubjToSubjRaising
< m1:CLAUSE{CLAUSErec1}
           [ I1:mu1,
             I2:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu5],
                      mu8,
                      complrel/I3::SENTENCE{SENTENCErec1}
                              [ I5:sig1,
                                subjrel/T1,
                                I4:mu4 
                              ],
                      mu6 
                    ],
             mu7 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I1:mu1,
             subjrel/T1,
             I2:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu5],
                      mu8,
                      complrel/I3::SENTENCE{SENTENCErec1}
                              [ I5:sig1,
                                I4:mu4 
                              ],
                      mu6 
                    ],
             mu7 
           ]
>

   MATCHCONDITIONS
      <
       I1 : ALL (mu1, I11:rel1/..)
       I2 : NOT EXIST (mu2, [ I11:rel1/..]) AND
            NOT EXIST (mu2, [subjrel/..])
           I11: rel1 IN AUX_presubjrels
       I3 : SENTENCErec1.PROsubject = false
       I4 : NOT EXIST (mu4, [shiftrel/..])
       I5 : ALL (sig1, shiftrel/..)
      >


      COMP
         <
          C1: CLAUSErec1.voice = Passive OR
              ( CLAUSErec1.thetavp IN [vp010, vp012] AND
                VERBrec1.Caseassigner = false )  
          A1: @
         >
      DECOMP
         <
          C1: CLAUSErec1.voice = Passive OR
              ( CLAUSErec1.thetavp IN [vp010, vp012] AND
                VERBrec1.Caseassigner = false ) 
          A1: @
         >
&

\end{verbatim}
