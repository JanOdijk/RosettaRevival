    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_MATCHBOOLEAN;
                      $MATCHBOOLEAN.MuVarlist:=MuVarList;
                      $MATCHBOOLEAN.SigmaVarlist:=SigmaVarList;
                      $MATCHBOOLEAN.NodeVarlist:=NodeVarList;
                      $MATCHBOOLEAN.TreeVarlist:=TreeVarList;
                      $MATCHBOOLEAN.RelVarlist:=RelVarList;
