%LEAVE
BASIS RULE
   LEAVE = IDENTIFIER/1

SURFACE PART
VAR
   First1 :: SETOFatomnodes;
   AtomStr :: atomnode;    

<*
   INIT: BEGIN
            INITsetofatomnodes(First1);
         END;
   1   : <*
            LOCALCONDITION: TRUE
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                AtomStr.str := %.str;
                                Afxid:=Afxid+1;
                                AtomStr.afxid :=AfxId; 
                                APPENDatomnode(AtomStr, First1);
                                END
         *>
   FINAL: #CONDITION: TRUE
          #ACTION: BEGIN SEND_LEAVE;
                         $LEAVE.Eps   := FALSE;
                         $LEAVE.First := First1;
                         $LEAVE.Kind   := AtomKind;
                      END
*>
END;

PROCEDURAL PART
VAR
   AtomStr :: atomnode;    
   str     : TSTRING_String;
BEGIN
   INIT: BEGIN
         END;
   <*
   1:    <* SEND: 
               BEGIN
                  TAKEatomnode(AtomStr, $LEAVE.First);
                  BEGIN
                     \of1.
                     TAB(of1, 3); """AtomStr.afxid"""
                     "{" ""AtomStr.str"" "}"
                     " : BEGIN" \\
		     WHILE STILLatomnodes($$LEAVE.Succ) DO BEGIN
			TAKEatomnode(AtomStr, $$LEAVE.Succ);
			TAB(of1, 15); 
                        "LDSUCC_APPENDItem("
			""ATOMStr.str"" ","
                        """ATOMStr.afxid""" ", result);" \\
		     END;
                     TAB(of1, 15); "END;" \\
                  END;
               END
            !.
            RECEIVE:
               BEGIN
               END
         *>
   *>
   FINAL: BEGIN
          END
END;
&
