\newpage
\begin{verbatim}
%
% TRANSFORMATION TPronIOdel
< m1:I1::SENTENCE{SENTENCErec1}
                      [ mu1,
                        cliticrel/CLITIC{}
                           I2:[   mu7,
                               I3:rel1/PERSPRO{PERSPROrec1}[head/T1],
                                  mu8
                             ],
                        head/VERB{VERBrec1}[mu3],
                        mu4,
                        predrel/VERBP{VERBPrec1}
                            [mu10,
                             indobjrel/PREPP{PREPPrec1}
                                  [head/PREP(KEY_aPREPkey){PREPrec1},
                                   objrel/NP{NPrec1}
                                      [head/PERSPRO{PERSPROrec2}[head/T2]]
                                  ],
                             mu9
                            ],
                        mu6
                      ]
>

< m:I1::SENTENCE{SENTENCErec1}
                     [ mu1,
                       cliticrel/CLITIC{}
                           I2:[   mu7,
                               I3:rel1/PERSPRO{PERSPROrec1}[head/T1],
                                  mu8
                              ],
                       head/VERB{VERBrec1}[mu3],
                       mu4,
                       predrel/VERBP{VERBPrec1}[mu10,
                                                mu9
                                               ],
                       mu6
                     ]
>


   MATCHCONDITIONS
      <
       I1: SENTENCErec1.finiteness = finite
       I2: ALL
       I3: PERSPROrec1.forma = datcl   
      >

< 
  SUBRULE  (* me mannelijk *)
      < T1:BPERSPRO(KEY_yomascbpersprokey){BPERSPROrec1}
        T2:BPERSPRO(KEY_yomascbpersprokey){BPERSPROrec2}>
      < T1:BPERSPRO(KEY_yomascbpersprokey){BPERSPROrec1}>

      COMP
         <
          C1: (PERSPROrec1.forma = datCL)      AND
              (PERSPROrec1.numero = singular)  AND
              (PERSPROrec1.persona = 1)        AND
              (PERSPROrec1.genero = masc)      AND
              (rel1 = unoCLrel)                 AND
                  
              (PREPPrec1 =
                   { mood          : NPrec1.mood
                     actsubcefs    : PREPrec1.subcs
                     synppefs      : PREPrec1.synpps
                     thetapp       : PREPrec1.thetapp
                     headkey       : PREPrec1.key
                     class         : NPrec1.class
                     tiempo        : NPrec1.tiempo
                     aspecto       : NPrec1.aspecto
                     retro         : NPrec1.retro
                     supertiempo   : NPrec1.supertiempo
                     SpecQ         : NPrec1.SpecQ
                   })                           AND

              (NPrec1 = AUX_NPONnomBPRSPR EXCEPT FOR [cases, numero,
                                                      persona, genero]) AND
              (prepositive IN NPrec1.cases) AND
              (NPrec1.numero = PERSPROrec2.numero) AND
              (NPrec1.persona = PERSPROrec2.persona) AND
              (NPrec1.genero = PERSPROrec2.genero) AND
 
              (PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                              EXCEPT FOR [forma]) AND
              (PERSPROrec2.forma = PrepFuerte)
          A1:  @
         >
  
     DECOMP
         <
          C1: (PERSPROrec1.forma = datCL)      AND
              (PERSPROrec1.numero = singular)  AND
              (PERSPROrec1.persona = 1)        AND
              (PERSPROrec1.genero = masc)      AND
              (rel1 = unoCLrel)      

          A1: PERSPROrec2 := COPYT_btoperspro(BPERSPROrec2);
              PERSPROrec2.forma := PrepFuerte;

              NPrec1 := AUX_NPONnomBPRSPR;
              NPrec1.cases := [prepositive];
              NPrec1.numero := PERSPROrec2.numero;
              NPrec1.persona := PERSPROrec2.persona;
              NPrec1.genero := PERSPROrec2.genero;

              PREPPrec1 := 
                   { mood          : NPrec1.mood
                     actsubcefs    : PREPrec1.subcs
                     synppefs      : PREPrec1.synpps
                     thetapp       : PREPrec1.thetapp
                     headkey       : PREPrec1.key
                     class         : NPrec1.class
                     tiempo        : NPrec1.tiempo
                     aspecto       : NPrec1.aspecto
                     retro         : NPrec1.retro
                     supertiempo   : NPrec1.supertiempo
                     SpecQ         : NPrec1.SpecQ
                   };

         >

   SUBRULE  (* me vrouwelijk *)
      < T1:BPERSPRO(KEY_yofembpersprokey){BPERSPROrec1}
        T2:BPERSPRO(KEY_yofembpersprokey){BPERSPROrec2}>
      < T1:BPERSPRO(KEY_yofembpersprokey){BPERSPROrec1}>

      COMP
         <
          C1: (PERSPROrec1.forma = datCL)      AND
              (PERSPROrec1.numero = singular)  AND
              (PERSPROrec1.persona = 1)        AND
              (PERSPROrec1.genero = fem)       AND
              (rel1 = unoCLrel)                 AND

              (PREPPrec1 =
                   { mood          : NPrec1.mood
                     actsubcefs    : PREPrec1.subcs
                     synppefs      : PREPrec1.synpps
                     thetapp       : PREPrec1.thetapp
                     headkey       : PREPrec1.key
