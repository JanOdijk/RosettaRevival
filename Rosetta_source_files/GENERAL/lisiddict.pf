 *                    The module provides I/O functions for accessing
 *                    AILDICT and GILDICT.
 *
 *EMP:::===================================================================*)

pragma C_Include('cisam.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LISIDDICT;
WITH CISAM;

(*MPT:::===================================================================*
 *
 *  Type name      : LISIDDICT_RecordDef
 *  Description    : Definition of the record type of SIDDICT
 *
 *EMP:::===================================================================*)

TYPE
   LISIDDICT_RecordDef = RECORD
                            skey          : INTEGER;
                            arg           : INTEGER;
                            argnr         : INTEGER;
                            sidskey       : INTEGER;
                            sidmkey       : INTEGER;
                         END;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_OpenSIDDict
 *  Description     : Open SIDDict for Read access
 *  Parameters      : none
 *  Precondition    : SIDDict is not yet open
 *  Postcondition   : SIDDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISIDDICT_OpenSIDDict;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_GetASIDDict
 *  Description    : 
 *  Parameters     : skey        : INTEGER;
 *                   VAR rec     : LISIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey
 *  Precondition   : SIDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_GetASIDDict(skey        : INTEGER;
                                          VAR rec     : LISIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_GetNextASIDDict
 *  Description    : 
 *  Parameters     : skey        : INTEGER
 *                   VAR rec     : LISIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey
 *  Precondition   : SIDDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_GetNextASIDDict(skey        : INTEGER;
                                         VAR rec     : LISIDDICT_RecordDef)
                                         : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_GetGSIDDict
 *  Description    : 
 *  Parameters     : sidskey     : INTEGER
 *                   VAR rec     : LISIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : SIDDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_GetGSIDDict(sidskey   : INTEGER;
                                          VAR rec     : LISIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_GetNextGSIDDict
 *  Description    : 
 *  Parameters     : sidskey     : INTEGER
 *                   VAR rec     : LISIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : SIDDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_GetNextGSIDDict(sidskey : INTEGER;
                                         VAR rec     : LISIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_GetNextSIDDict
 *  Description    : Reads next record according to current index
 *  Parameters     : VAR rec     : LISIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found 
 *  Precondition   : SIDDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_GetNextSIDDict(VAR rec     : LISIDDICT_RecordDef
                                             ): BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_CloseSIDDict
 *  Description     : Close SIDDict 
 *  Parameters      : none
 *  Precondition    : SIDDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISIDDICT_CloseSIDDict;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_SetIndex
 *  Description     : Sets index
 *  Parameters      : index
 *  Precondition    : SIDDict is open
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_SetIndex(ind: INTEGER): BOOLEAN;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_Release
 *  Description     : Unlock record
 *  Parameters      : none
 *  Precondition    : SIDDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISIDDICT_Release;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_Reset
 *  Description     : Resets record
 *  Parameters      : none
 *  Precondition    : SIDDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISIDDICT_Reset;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_OpenSIDDICT
 *  Description     : Opens SIDDICT dictionary for updating
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LISIDDICT_OpenSIDDICTWrite;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_WriteSequential
 *  Description    : Writes the current record of the SIDDICT file
 *  Parameters     : VAR rec: LISIDDICT_RecordDef;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_WriteSequential(rec: LISIDDICT_RecordDef): INTEGER;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LISIDDICT_OpenSIDDICTUpdate
 *  Description     : Opens SIDDICT dictionary for updating
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LISIDDICT_OpenSIDDICTUpdate;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_Update
 *  Description    : Updates the current record of the SIDDICT file
 *  Parameters     : VAR rec: LISIDDICT_RecordDef;
 *  Result         : CISAM_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_Update(rec: LISIDDICT_RecordDef): CISAM_StatusType;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISIDDICT_Delete
 *  Description    : Deletes the current record from the SIDDICT file
 *  Parameters     : VAR rec: LISIDDICT_RecordDef;
 *  Result         : CISAM_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LISIDDICT_Delete: CISAM_StatusType;
EXTERNAL;

END {LISIDDICT};
