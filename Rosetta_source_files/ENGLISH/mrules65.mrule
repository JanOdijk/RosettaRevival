% RULE RQPamountmod 

< m1: QP{QPrec1}[I3:mu1]
  m2: T1
>

< m : QP{QPrec1}[I2:rel1/T2,
                 I3:mu1
                ]
>

   MATCHCONDITIONS
      <
       m2: (T1.cat IN [ADVP] WITH T1.REC.actsubcefs * [degreeadv] <> [])
           OR
           ((T1.cat IN [NP] WITH T1.REC.actsubcs * [unitnoun] <> [])
                                                   (*, amountnp *) OR
            (T1.cat IN [NP] WITH T1.REC.actcomas * [mass] <> []) 
           ) 
       I2: ((T2.cat IN [ADVP] WITH T2.REC.actsubcefs * [degreeadv] <> []) AND 
            (rel1 IN [degreemodrel])
           ) OR
           (((T2.cat IN [NP] WITH T2.REC.actsubcs * [unitnoun] <> []) 
                                                   (* amountnp *) OR
            (T2.cat IN [NP] WITH T2.REC.actcomas * [mass] <> []) 
           ) AND
            (rel1 IN [premodrel])
           )
       I3: NOT EXIST(mu1, [premodrel/..]) AND
           NOT EXIST(mu1, [degreemodrel/..])
      >


< 
   SUBRULE (* 1 *)    (* too much *)
      <T1:ADVP{ADVPrec1}[mu9] >
      <T2:ADVP{ADVPrec2}[mu9] >

      COMP
         <
          C1: ADVPrec1.superdeixis = QPrec1.superdeixis
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis;
              rel1 := degreemodrel;
         >

      DECOMP
         <
          C1: ADVPrec2.superdeixis = omegadeixis
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := QPrec1.superdeixis;
         >


   SUBRULE (* 2 *) 
      <T1:NP{NPrec1}[mu8] >
      <T2:NP{NPrec2}[mu9] >

(* conditie op amountnp toevoegen; vereist domeinaanpassing en aanpassing van 
   RNPformation  *)

      COMP
         <
          C1: NPrec1.superdeixis = QPrec1.superdeixis AND
              NPrec1.cases = []
          A1: QUOTE_assigncase(NPrec1,mu8,NPrec2,mu9,[Nominative]); 
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              rel1 := premodrel;
         >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis AND
              NPrec2.generic = omegageneric AND
              nominative IN NPrec2.cases
          A1: QUOTE_assigncase(NPrec2, mu9, NPrec1, mu8, []); 
              NPrec1.superdeixis := QPrec1.superdeixis;
              NPrec1.generic := nogeneric;
         >

>
&

\end{verbatim}
