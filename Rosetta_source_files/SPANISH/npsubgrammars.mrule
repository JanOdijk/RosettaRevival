                   SENTENCErec2.tiempo := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;

          A1: PREPPrec1 := VARPREPPrec1;
              PREPPrec1.mood := relativexpmood;
              NPrec1 := 
