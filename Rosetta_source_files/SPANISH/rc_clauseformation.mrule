\begin{verbatim}
% RULE RClauseformation7a (* PREPPROP, ser *)
< m1:PREPPPROP{PREPPPROPrec1}
               [ mu1,
                 predrel/T1,
                 mu3 
               ] 
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ head/VERB{VERBrec1}
                          [ head/SUBVERB{SUBVERBrec1}
                                [head/BVERB(AUX_serbverbkey){BVERBrec1} ] 
                          ],
                      cliticrel/CLITIC{}[],
                      predrel/T2
                    ],
             mu3 
           ]
>

   MATCHCONDITIONS
      <
       I2: (CLAUSErec1.voice = Active ) AND
           (synSER IN CLAUSErec1.synvpefs ) 
      >

<
   SUBRULE
      <T1: I1::PREPP{PREPPrec1}[I3:mu2]>
      <T2: I1::PREPP{PREPPrec1}[I3:mu2]>


   MATCHCONDITIONS
      <
       I1: PREPPrec1.actsubcefs * [loc,dir] = []
       I3: NOT EXIST(mu2,[I31:../T3])
           I31: T3.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: (
               PREPPPROPrec1 =
		     {
		      mood        : PREPPrec1.mood
		      actsubcefs  : PREPPrec1.actsubcefs
		      PROsubject  : false
		      synppefs    : PREPPrec1.synppefs
		      headkey     : PREPPrec1.headkey
		      class       : omegaTimeAdvClass
		      tiempo      : omegatiempo
		      aspecto     : omegaaspecto
		      retro       : false
		     }
              ) 
          A1: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
              (* all other attributes of verb retain their default values *)
              CLAUSErec1 :=
		     { 
		      req         : PREPPPROPrec1.req
		      voice       : Active
		      synvpefs    : [synSER]
		      aktionsarts : PREPPPROPrec1.aktionsarts
		      supertiempo : PREPPPROPrec1.supertiempo
		     }
         >

      DECOMP
         <
          C1: (CLAUSErec1 = CLAUSErecdef EXCEPT FOR [ req, voice, synvpefs,
                           aktionsarts, supertiempo] )
          A1: PREPPPROPrec1 :=
		     {
		      req         : CLAUSErec1.req
		      mood        : PREPPrec1.mood
		      actsubcefs  : PREPPrec1.actsubcefs
		      PROsubject  : false
		      synppefs    : PREPPrec1.synppefs
		      headkey     : PREPPrec1.headkey
		      class       : omegaTimeAdvClass
		      tiempo      : omegatiempo
		      aspecto     : omegaaspecto
		      retro       : false
		      aktionsarts : CLAUSErec1.aktionsarts
		      supertiempo : CLAUSErec1.supertiempo
		     }
         >

   SUBRULE
      <T1: I1::PREPP{PREPPrec1}[I3:mu2]>
      <T2: I4::VARPREPP{VARPREPPrec1}[I3:mu2]>


   MATCHCONDITIONS
      <
       I1: PREPPrec1.actsubcefs * [loc,dir] = []
       I4: VARPREPPrec1.actsubcefs * [loc,dir] = []
       I3: EXIST(mu2,[I31:../T3])
           I31: T3.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: (
               PREPPPROPrec1 =
		     {
		      mood        : PREPPrec1.mood
		      actsubcefs  : PREPPrec1.actsubcefs
		      PROsubject  : false
		      synppefs    : PREPPrec1.synppefs
		      headkey     : PREPPrec1.headkey
		      class       : omegaTimeAdvClass
		      tiempo      : omegatiempo
		      aspecto     : omegaaspecto
		      retro       : false
		     }
              ) 
          A1: VARPREPPrec1 := PREPPrec1;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
              (* all other attributes of verb retain their default values *)
              CLAUSErec1 :=
		     { 
		      req         : PREPPPROPrec1.req
		      voice       : Active
		      synvpefs    : [synSER]
		      aktionsarts : PREPPPROPrec1.aktionsarts
		      supertiempo : PREPPPROPrec1.supertiempo
		     }
         >

      DECOMP
         <
          C1: (CLAUSErec1 = CLAUSErecdef EXCEPT FOR [ req, voice, synvpefs,
                           aktionsarts, supertiempo] )
          A1: PREPPrec1 := VARPREPPrec1;
              PREPPPROPrec1 :=
		     {
		      req         : CLAUSErec1.req
		      mood        : PREPPrec1.mood
		      actsubcefs  : PREPPrec1.actsubcefs
		      PROsubject  : false
		      synppefs    : PREPPrec1.synppefs
		      headkey     : PREPPrec1.headkey
		      class       : omegaTimeAdvClass
		      tiempo      : omegatiempo
		      aspecto     : omegaaspecto
		      retro       : false
		      aktionsarts : CLAUSErec1.aktionsarts
		      supertiempo : CLAUSErec1.supertiempo
		     }
         >
>
&
\end{verbatim}
