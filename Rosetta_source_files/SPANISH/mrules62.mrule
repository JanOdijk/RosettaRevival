\newpage
\begin{verbatim}
% TRANSFORMATION TADJAgreement
< m1: ADJPFORMULA{ADJPFORMULArec1}[I1:subjrel/T1,
                                   predrel/ADJP{ADJPrec1}
                                           [mu2,
                                            head/ADJ{ADJrec1}[mu4],
                                            mu3
                                            ] 
                                   ]
>

< m: ADJPFORMULA{ADJPFORMULArec1}[I1:subjrel/T1,
                                   predrel/ADJP{ADJPrec2}
                                           [mu2,
                                            head/ADJ{ADJrec2}[mu4],
                                            mu3
                                            ] 
                                   ]
>

   MATCHCONDITIONS
      <
       I1: T1.cat IN [CNVAR,NPVAR,NP]
      >


<
   SUBRULE
      <T1:CNVAR{CNVARrec1}[mu1] >
      <T1:CNVAR{CNVARrec1}[mu1] >

    COMP
       <
          C1: ADJrec1.numero = omeganumero AND
              ADJrec1.genero = omegagenero
             C11: ADJrec1.thetaadj <> adjp000
                C111: masc IN CNVARrec1.generos
                A111: ADJrec2 := ADJrec1;
                      ADJrec2.genero := masc; 
                C112: fem IN CNVARrec1.generos
                A112: ADJrec2 := ADJrec1;
                      ADJrec2.genero := fem;
             A11: ADJrec2.numero := CNVARrec1.numero;
             C12: ADJrec1.thetaadj = adjp000
                C121: masc IN CNVARrec1.generos AND
                      CNVARrec1.numero = singular
                A121: ADJrec2 := ADJrec1;
                      ADJrec2.genero := masc;
                      ADJrec2.numero := singular;
             A12: @
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.genero := ADJrec2.genero;
              ADJPrec2.numero := ADJrec2.numero
          >

      DECOMP
         <
          C1: ADJPrec2.genero = ADJrec2.genero AND
              ADJPrec2.numero = ADJrec2.numero
             C11: ADJrec2.thetaadj <> adjp000 AND
                  ADJrec2.numero = CNVARrec1.numero
                 C111: masc IN CNVARrec1.generos AND
                       ADJrec2.genero = masc
                 A111: @
                 C112: fem IN CNVARrec1.generos AND
                       ADJrec2.genero = fem
                 A112: @
             A11: ADJrec1 := ADJrec2;

             C12: ADJrec2.thetaadj = adjp000 AND
                  ADJrec2.numero = singular
                 C121: masc IN CNVARrec1.generos AND
                       ADJrec2.genero = masc
                 A121: @
             A12: @
           A1: ADJrec1.genero := omegagenero;
              ADJrec1.numero := omeganumero;
              ADJPrec1 := ADJPrec2
       >

   SUBRULE
      <T1:NPVAR{NPVARrec1}[mu1] >
      <T1:NPVAR{NPVARrec1}[mu1] >

    COMP
       <
          C1: ADJrec1.numero = omeganumero AND
              ADJrec1.genero = omegagenero
             C11: ADJrec1.thetaadj <> adjp000
             A11: ADJrec2 := ADJrec1;
                  ADJrec2.genero := NPVARrec1.genero; 
                  ADJrec2.numero := NPVARrec1.numero;

             C12: ADJrec1.thetaadj = adjp000 AND
                  NPVARrec1.numero = singular AND
                  NPVARrec1.genero = masc
             A12: ADJrec2 := ADJrec1;
                  ADJrec2.genero := masc;
                  ADJrec2.numero := singular;
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.genero := ADJrec2.genero;
              ADJPrec2.numero := ADJrec2.numero
          >

      DECOMP
         <
          C1: ADJPrec2.genero = ADJrec2.genero AND
              ADJPrec2.numero = ADJrec2.numero
             C11: ADJrec2.thetaadj <> adjp000 AND
                  ADJrec2.numero = NPVARrec1.numero AND
                  ADJrec2.genero = NPVARrec1.genero
             A11: ADJrec1 := ADJrec2;

             C12: ADJrec2.thetaadj = adjp000 AND
                  ADJrec2.numero = singular  AND
                  ADJrec2.genero = masc
             A12: @
           A1: ADJrec1.genero := omegagenero;
              ADJrec1.numero := omeganumero;
              ADJPrec1 := ADJPrec2
       >

   SUBRULE
      <T1:NP{NPrec1}[mu1] >
      <T1:NP{NPrec1}[mu1] >

    COMP
       <
          C1: ADJrec1.numero = omeganumero AND
              ADJrec1.genero = omegagenero
             C11: ADJrec1.thetaadj <> adjp000
             A11: ADJrec2 := ADJrec1;
                  ADJrec2.genero := NPrec1.genero; 
                  ADJrec2.numero := NPrec1.numero;

             C12: ADJrec1.thetaadj = adjp000 AND
                  NPrec1.numero = singular AND
                  NPrec1.genero = masc
             A12: ADJrec2 := ADJrec1;
                  ADJrec2.genero := masc;
                  ADJrec2.numero := singular;
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.genero := ADJrec2.genero;
              ADJPrec2.numero := ADJrec2.numero
          >

      DECOMP
         <
          C1: ADJPrec2.genero = ADJrec2.genero AND
              ADJPrec2.numero = ADJrec2.numero
             C11: ADJrec2.thetaadj <> adjp000 AND
                  ADJrec2.numero = NPrec1.numero AND
                  ADJrec2.genero = NPrec1.genero
             A11: ADJrec1 := ADJrec2;

             C12: ADJrec2.thetaadj = adjp000 AND
                  ADJrec2.numero = singular  AND
                  ADJrec2.genero = masc
             A12: @
           A1: ADJrec1.genero := omegagenero;
              ADJrec1.numero := omeganumero;
              ADJPrec1 := ADJPrec2
       >
>
&

\end{verbatim}
