\newpage
\begin{verbatim}
(*uitgezet; introductie relatie PREPP-VARPREPP nog niet beregeld *) 
% RULE RNPargmodsubst2                  (* provisional draft; 30-JAN-89 *)

< m1 : NP{NPrec1}[mu1,
                  head/CN{CNrec1}[
                                  head/NOUN{NOUNrec1}[mu2],
                                  complrel/VARPREPP{VARPREPPrec1}
                                      [head/PREP(KEY_deprepkey){PREPrec1},
                                       complrel/I1::SENTENCEVAR{SENTENCEVARrec1}
                                      ]
                                  ],
                  mu3
                 ]

SUBST:
  m2: SENTENCE{SENTENCErec1}[mu4]
>

< m : NP{NPrec1}[mu1,
                  head/CN{CNrec1}[
                                  head/NOUN{NOUNrec1}[mu2],
                                  complrel/PREPP{PREPPrec1}
                                      [head/PREP(KEY_deprepkey){PREPrec1},
                                       complrel/SENTENCE{SENTENCErec2}[mu4]
                                      ]
                                  ],
                  mu3
                 ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCEVARrec1.index = LEVEL
      >


   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   ((SENTENCErec1.tiempo  = presente) AND
                    (NPrec1.supertiempo <> presente)
                   ) OR
                   ((SENTENCErec1.tiempo = pasado) AND
                    (NPrec1.supertiempo <> pasado) AND
                    (NOT QUOTE_temprefnotfound(mu2))
                   )
              A11: SENTENCErec2 := SENTENCErec1;
 		   PREPPrec1 := VARPREPPrec1; 	
              C12: (* temporally dependent *)
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.supertiempo = NPrec1.supertiempo)
              A12: SENTENCErec2 := SENTENCErec1;
 		   PREPPrec1 := VARPREPPrec1;
                   SENTENCErec2.tiempo  := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;
          A1: @
         >
      DECOMP
         <
          C1: true
              C11: (* temporally independent *)
                   (SENTENCErec2.supertiempo= omegatiempo) AND
                   ((SENTENCErec2.tiempo= presente) AND
                    (NPrec1.supertiempo <> presente )
                   ) OR
                   ((SENTENCErec2.tiempo = pasado) AND
                    (NPrec1.supertiempo <> pasado)
                   )
               A11: SENTENCErec1 := SENTENCErec2;
 		    VARPREPPrec1 := PREPPrec1;

               C12: (SENTENCErec2.supertiempo = omegatiempo ) AND
                    (SENTENCErec2.tiempo = NPrec1.supertiempo )
               A12: SENTENCerec1 := SENTENCErec2;
 		    VARPREPPrec1 := PREPPrec1;
                    SENTENCErec1.supertiempo := NPrec1.supertiempo;
                    SENTENCErec1.tiempo := omegatiempo;  
          A1:SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec2);
             SENTENCEVARrec1.index := LEVEL;
                   
         >
&

\end{verbatim}
