% RULE RCNPresentsuperdeixis

< m1: CN{CNrec1}[mu1 ]
>

< m : CN{CNrec2}[mu1 ]

>
      COMP
         <
          C1: CNrec1.superdeixis = omegadeixis
          A1: CNrec2 := CNrec1;
              CNrec2.superdeixis := presentdeixis

         >
      DECOMP
         <
          C1: CNrec2.superdeixis = presentdeixis
          A1: CNrec1 := CNrec2;
              CNrec1.superdeixis := omegadeixis
         >

&

\end{verbatim}
