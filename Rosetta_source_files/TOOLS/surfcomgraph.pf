pragma C_include ('surfcomlangspec.pf');
pragma C_include ('surfcomdecl.pf');

PACKAGE surfcomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH surfcomDECL,
     surfcomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: surfcomLANGSPEC_Category;
                          b: surfcomDECL_nodeid): surfcomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: surfcomDECL_psurfgraph): surfcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: surfcomDECL_psurfgraph): surfcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: surfcomDECL_psurfgraph): surfcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: surfcomDECL_psurfgraph): surfcomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: surfcomLANGSPEC_Category; 
                          c: surfcomDECL_psurfgraph); EXTERNAL;
 
END {surfcomGRAPH};
