      <T1: NP{NPrec1}[mu9] >
      <T1: NP{NPrec1}[mu9] >

      COMP
         <
          C1: NPrec1.definite = def
          A1: @
         >

      DECOMP
         <
          C1: NPrec1.definite = def
          A1: @
         >


   SUBRULE
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1.definite = def
          A1: @
         >

      DECOMP
         <
          C1: NPVARrec1.definite = def
          A1: @
         >


   SUBRULE
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
