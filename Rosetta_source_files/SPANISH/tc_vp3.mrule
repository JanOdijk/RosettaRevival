\begin{verbatim}
% TRANSFORMATION TVerbpattern6
< m1: VERBPPROP{VERBPPROPrec1}[ mu1,
                                predrel/VERBP{VERBPrec1}
                                       [ head/VERB{VERBrec1}[mu2],
                                         argrel/T1,
                                         argrel/T2
                                       ] 
                               ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
		        [ head/VERB{VERBrec1}[mu2],
		          rel1/T1,
                          indobjrel/VARPREPP{VARPREPPrec1}
				[ head/PREP(KEY_aprepkey){PREPrec1},
                                  objrel/T2
				]
		        ] 
	       ]
>


<
   (* El milagro se le ha revelado (a \'{e}l;\\
      Me gusta el libro; Le doy un libro a Juan *)

   SUBRULE(*1a*)
      < T2:NPVAR{NPVARrec1} >
      < T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synANP_DONP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: rel1 := objrel;
                VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.SpecQ
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [ synANP_DONP]
          A1:  @
         >

   SUBRULE(*1b*)
      < T2:CNVAR{CNVARrec1} >
      < T2:CNVAR{CNVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synANP_DONP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: rel1 := objrel;
                VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [ synANP_DONP]
          A1:  @
         >


   (* Le qued\'{o} claro que ... ; Me gusta que ... (vp012)\\
      Juan me dijo (a m\'{\i}) que ... (vp123)                *)

   SUBRULE(*2a*)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >
        
      COMP
         <
          C1: synANP_QUESENTind IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 =
                 	 {
			  mood        : declarative
                          modo        : Indicativo
			  senttype    : subordinateclause
			  finiteness  : finite
                          adverbial   : false
			 }
          A1: rel1 := complrel;
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.specQ
                  };

              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synANP_QUESENTind]
         >

   SUBRULE(*2b*)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >
        
      COMP
         <
          C1: synANP_QUESENTind IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 =
         		 {
			  mood        : declarative
                          modo        : Indicativo
			  senttype    : subordinateclause
			  finiteness  : finite
                          adverbial   : false
			 }
          A1: rel1 := complrel;
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };

              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synANP_QUESENTind]
         >


   SUBRULE(*2c*)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >
        
      COMP
         <
          C1: synANP_QUESENTsubj IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 =
			 {
			  mood        : declarative
                          modo        : Subjuntivo
			  senttype    : subordinateclause
			  finiteness  : finite
                                   adverbial   : false
			 }
          A1: rel1 := complrel;
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.specQ
                  };

              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synANP_QUESENTsubj]
         >

   SUBRULE(*2d*)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >
        
      COMP
         <
          C1: synANP_QUESENTsubj IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 =
			 {
			  mood        : declarative
                          modo        : Subjuntivo
			  senttype    : subordinateclause
			  finiteness  : finite
                                   adverbial   : false
			 }
          A1: rel1 := complrel;
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };

              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synANP_QUESENTsubj]
         >


(* Le gusta al chico hacerlo. (vp012)\\
   Juan le pidi\'{o} a Pedro salir. (vp123)     *)

   SUBRULE(*3a*)
      < T2: NPVAR{NPVARrec1} >
      < T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ SENTENCEVAR ]
            C2: synANP_OPENINFSENT IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1 =
          	           {
	  		    mood        : declarative
                            modo        : Infinitivo
			    senttype    : subordinateclause
			    finiteness  : infinite
                                   adverbial   : false
                            infsort     : inf
                            PROsubject  : true
			   }
            A2: rel1 := complrel;
                VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.specQ
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synANP_OPENINFSENT]
          A1:  @
         >

   SUBRULE(*3b*)
      <T2: CNVAR{CNVARrec1} >
      <T2: CNVAR{CNVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ SENTENCEVAR ]
            C2: synANP_OPENINFSENT IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1 =
          	           {
	  		    mood        : declarative
                            modo        : Infinitivo
			    senttype    : subordinateclause
			    finiteness  : infinite
                                   adverbial   : false
                            infsort     : inf
                            PROsubject  : true
			   }
            A2: rel1 := complrel;
                VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synANP_OPENINFSENT]
          A1:  @
         >


(* D\'{\i}me qu\'{e} hago. (vp123) *)

   SUBRULE(*4a*)
        <T2: NPVAR{NPVARrec1} >
        <T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ SENTENCEVAR ]
            C2: synANP_QSENT IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1.mood  IN [yesnointerrogative, whinterrogative] 
                                                                         AND
                SENTENCEVARrec1.senttype = subordinateclause AND
                SENTENCEVARrec1.modo = Indicativo
            A2: rel1 := complrel;
                VARPREPPrec1 := PREPPrecdef;
                VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.specQ
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synANP_QSENT]
          A1:  @
         >

   SUBRULE(*4b*)
        <T2: CNVAR{CNVARrec1} >
        <T2: CNVAR{CNVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ SENTENCEVAR ]
            C2: synANP_QSENT IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1.mood  IN [yesnointerrogative, whinterrogative] 
                                                                         AND
                SENTENCEVARrec1.senttype = subordinateclause AND
                SENTENCEVARrec1.modo = Indicativo
            A2: rel1 := complrel;
                VARPREPPrec1 := PREPPrecdef;
                VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_aprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synANP_QSENT]
          A1:  @
         >


