\newpage
\begin{verbatim}
% RULE RNOUNargmod2
< m1: CN{CNrec1}[
                 head/I1::NOUN{NOUNrec1}[mu2]
                ] 
  m2: SENTENCEVAR{SENTENCEVARrec1}
>

< m : CN{CNrec1}[
                 head/I1::NOUN{NOUNrec1}[mu2],
                 complrel/SENTENCEVAR{SENTENCEVARrec1}
                ]
>

   MATCHCONDITIONS
      <
       I1: NOUNrec1.nounpatterns * [synQSENT, synTHATSENT] <> [] 
      >

      COMP
         <
          C1: true
            C11: synTHATSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: declarative
                                    }
            A11: @
            C12: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: whinterrogative
                                    }

            A12: @
            C13: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: yesnointerrogative
                                    }

            A13: @

          A1: @
         >
      DECOMP
         <
          C1: true
            C11: synTHATSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: declarative
                                    }
            A11: @
            C12: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: whinterrogative
                                    }

            A12: @
            C13: synQSENT IN NOUNrec1.nounpatterns AND
                 SENTENCEVARrec1 = {
                                     senttype :subordinateclause
                                     finiteness : finite
                                     mood: yesnointerrogative
                                    }

            A13: @

          A1: @
         >

&

