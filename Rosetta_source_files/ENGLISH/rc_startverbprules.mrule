\newpage
\begin{verbatim}

%RULE RSTARTVPPROP010a       (* monadic ergatives (OSR)
                                and raising verbs (SSR) *)

<m1: I1::SUBVERB{SUBVERBrec1}[mu1]
 m2: T1
>

<m: I3::VERBPPROP{VERBPPROPrec1}
                 [ predrel/VERBP{VERBPrec1}
                          [head/I4::VERB{VERBrec1}
                                [head/I1::SUBVERB{SUBVERBrec1}[mu1]],
                           I2:argrel/T1
                          ]
                 ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBrec1.thetavp = vp010 AND
           SUBVERBrec1.CaseAssigner =  false
       I2: T1.CAT IN AUX_VARCATSET
       m2: T1.CAT IN AUX_VARCATSET
       I3: VERBPPROPrec1 = VERBPPROPrecdef EXCEPT FOR [thetavp] AND
           VERBPPROPrec1.thetavp  = vp010
       I4: VERBrec1 = { numbers      : []
                        persons      : []   
                        modus        : omegamodus  
                        tense        : omegatense  }
      >

COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
       (* all other attributes retain their default value *)
       VERBPPROPrec1.thetavp := vp010
       (* all other attributes retain their default value *)
 >
DECOMP
 <
   C1: VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)
   A1: @
 >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] RSTARTVPPROP010a
\item[* relevant examples:]\mbox{}
\begin{enumerate}
\item ergatives: melt x1 (the ice melts), become x1, ?live x1, modals, 
?get + participle x1
\item raising verbs: seem x1, appear x1
\end{enumerate}
\item[* language:]  english
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] RC:Startverbprules
\item[* date of creation:] 09-OCT-87
\item[* author:] Agnes Mijnhout, margreet sanders
\item[* copied from:] Dutch RSTARTVPPROP010a
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Combines a SUBVERB with its required number of arguments and 
puts them either in subject position or inside the VERBP.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of 
parameters)
\item[\ \ differences analytical/generative version:] None
\item[\  \ suggested semantics:] Function-application and "thematic role" 
assignment.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ 

\item rules:\\ This is the first rule-class.

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{} 
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\
The number of arguments should remain 
the same.
\end{enumerate}
\item[* relevant literature/documents:] doc. nr. 108 (Verbpatterns in Rosetta3)
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
For Dutch, an extra possibility for the SUBVERB holds: it must be case-assigner 
= false OR reflexivity = reflexive, to cover the (probably case-assigning) case 
of {\em zich voordoen\/}: het geval deed zich voor. For English, no such verb 
has been encountered yet.
\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RSTARTVPPROP010b         (* it's raining cats and dogs *)
<m1: I1::SUBVERB{SUBVERBrec1}[mu1]
 m2: T1
>

<m: I3::VERBPPROP{VERBPPROPrec1}
                 [ subjrel/I5::NP{NPrec1}
                          [head/PERSPRO{PERSPROrec1}
                               [head/BPERSPRO(AUX_itbpersprokey){BPERSPROrec1}] 
                          ],
                   predrel/VERBP{VERBPrec1}
                          [head/I4::VERB{VERBrec1}
                                [head/I1::SUBVERB{SUBVERBrec1}[mu1]],
                           I2:argrel/T1
                          ]
                 ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBrec1.thetavp = vp010             AND
           SUBVERBrec1.CaseAssigner =  true        AND
           SUBVERBrec1.reflexivity = notreflexive
       I2: T1.CAT IN AUX_VARCATSET
       m2: T1.CAT IN AUX_VARCATSET
       I3: VERBPPROPrec1 = VERBPPROPrecdef EXCEPT FOR [thetavp] AND
           VERBPPROPrec1.thetavp = vp010
       I4: VERBrec1 = { numbers      : []
                        persons      : []   
                        modus        : omegamodus  
                        tense        : omegatense  }
       I5: NPrec1 = AUX_NPONitPRSPR
      >

COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
       (* all other attributes retain their default value *)
       VERBPPROPrec1.thetavp := vp010;
       (* all other attributes retain their default value *)
       PERSPROrec1:= COPYT_bpersproTOperspro(BPERSPROrec1);
       (* persprocase retains its default value, `omegacase' *)
       NPrec1 := AUX_NPONitPRSPR
 >
DECOMP
 <
   C1: VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1) AND
       PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
       PERSPROrec1.persprocase = nominative 
   A1: @
 > 

&
\end{verbatim}
