\newpage
\begin{verbatim}
 RULE REmptysubstitution9

(* substitution of seEMPTYVAR as an indobjrel/.. by "les .. a la gente"  *)

< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           cliticrel/CLITIC{CLITICrec1},
                           mu4,
                           I4:indobjrel/EMPTYVAR{EMPTYVARrec1},
                           mu5,
                           objrel/T1,
                           mu6
                         ],
                   mu7
                ]
SUBST:
  m2: EMPTY(KEY_seemptykey){EMPTYrec1}            (*substituent*)
>

< m : I2::CLAUSE{CLAUSErec2}
       [ mu1,
         predrel/VERBP{VERBPrec1}
                [ mu2,
                  head/I3::VERB{VERBrec1}[mu3],
                  cliticrel/CLITIC{}
                    [tresCLrel/PERSPRO{PERSPROrec1}
                            [head/BPERSPRO(KEY_ellasbpersprokey){BPERSPROrec1}
                            ]
                  ],
                  mu4,
                  mu5,
                  objrel/T1,
                  indobjrel/PREPP{PREPPrec1}
                      [head/PREP(KEY_aprepkey){PREPrec1},
                       objrel/NP{NPrec1}
                          [detrel/ART{ARTrec1},
                           head/CN{CNrec1}
                               [head/NOUN{NOUNrec1}
                                    [head/SUBNOUN{SUBNOUNrec1}
                                         [head/BNOUN(KEY_gentebnounkey){BNOUNrec1}]
                                    ]
                               ]
                          ]
                      ],
                  mu6
                ],
          mu7
        ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.finiteness = finite) AND
           (CLAUSErec1.voice = Active)
       I2: CLAUSErec2.finiteness = finite
       I3: VERBrec1.thetavp IN [vp012, vp021]
       I4: EMPTYVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: true
          A1: ARTrec1 :=
                  { definite  : def
                    genero    : fem
                    posscomas : [mass]     (* ?? *)
                    numero    : singular
                  };
              SUBNOUNrec1 := COPYT_BtoSUBNOUN(BNOUNrec1);
              NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
              CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (ARTrec1 =
                  { definite  : def
                    genero    : fem
                    posscomas : [mass]   (* ?? *)
                    numero    : singular
                  })                     AND
              (SUBNOUNrec1 = COPYT_BtoSUBNOUN(BNOUNrec1)) AND
              (NOUNrec1 = COPYT_SUBNOUNtoNOUN(SUBNOUNrec1))
          A1: CLAUSErec1 := CLAUSErec2
         >
&


\end{verbatim}
\newpage
\begin{description}
\item[* name:] REmptysubstitution9
\item[* relevant examples:]
Ned. Men houdt van kaas $\rightarrow$ \\
Sp. {\em Les} gusta el queso {\em a la gente}
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoClause
\item[* class:] RC: EMPTYsubstitution
\item[* date of creation:]  02-MAR-1988 10:45:00 
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 18./01/89\ \ \ \ \ author: Lisette Appelo\\
Added mu4, mu5, mu6, mu7.\\
Added CN. Copy-functions for CN and NP are missing!!!!; this rule is not 
reversible!!!
\item date: 25/01/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on level for EMPTYVAR
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To substitute seEMPTY as indobjrel/.. by "les .. a la gente".
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] dna
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
In the input model, the order is: VERB - indobj/EMPTYVAR - objrel/T1 
(according to the verbpattern vp012 with EMPTY indobj.)\\
In the outputmodel the order is: VERB - objrel/T1 - indobjrel/"a la gente" 
(as in the verbpattern vp012 with non-empty object).\\ \\
I put "objrel/T1" instead of mu, since the object is obligatory in this case.
This rule is merely meant as an ad hoc solution for translation of Dutch vp120
with "men" as subject (e.g. {\bf Men} houdt van kaas), into Spanish vp012 with 
an empty indobj (i.e. Les gusta el queso {\bf a la gente}).\\ \\
(NB. in other words, Dutch subjrel/menEMPTY translated into Spanish 
indobjrel/"les ... a la gente").
\end{description}


\newpage
\begin{verbatim}
% RULE REmptysubstitution10

 (* subst of seEMPTY as an objrel/..; ergative verbs with vp010 *)

< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu6,
                           I4:objrel/EMPTYVAR{EMPTYVARrec1},
                           mu4
                         ],
                  mu5
                ]
SUBST:
  m2: EMPTY(KEY_seemptykey){EMPTYrec1}            (*substituent*)
>

< m: I2::CLAUSE{CLAUSErec2}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu6,
                           mu4
                         ],
                  mu5
                ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice IN [SEactive, active])
       I2: (CLAUSErec2.voice IN [SEactive, active])
       I3: (Active IN VERBrec1.possvoices ) AND
           (VERBrec1.thetavp IN [vp010] ) 
       I4: EMPTYVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2
         >
&

\end{verbatim}
