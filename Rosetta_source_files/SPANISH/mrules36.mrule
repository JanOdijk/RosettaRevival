\begin{verbatim}
% RULE Rpppretrovarinsertion
< m1: PREPPPROP{PREPPPROPrec1}
            [mu1,
             predrel/PREPP{PREPPrec1}[mu3],
             I4: mu4,
             I1: mu2
            ] 

  m2: T1 
>

< m : PREPPPROP{PREPPPROPrec1}
            [mu1,
             predrel/PREPP{PREPPrec1}[mu3],
             I4:mu4,
             tempadvrel/T1,
             I5: mu2
            ] 
>
   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2,[locadvrel/..])  AND
           QUOTE_tempretronotfound(mu2) AND
           QUOTE_tempdurnotfound(mu2) 
       I4: ALL(mu4,locadvrel/..)
       I5: NOT EXIST(mu2,[I51:rel5/..]) AND
           QUOTE_tempretronotfound(mu2) AND
           QUOTE_tempdurnotfound(mu2) 
           I51:rel5 IN [locadvrel, sentadvrel]
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
      >
<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1}>
      < T1: ADVPVAR{ADVPVARrec1}>

      COMP
         <
          C1: (ADVPVARrec1.retro = true)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.retro = true)
          A1: @
         >
   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1}>
      < T1: PREPPVAR{PREPPVARrec1}>

      COMP
         <
          C1: (PREPPVARrec1.retro = true)
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.retro = true)
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: (SENTENCEVARrec1.conjretro = true)
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjretro = true)
          A1: @
         >
>

&

\end{verbatim}
