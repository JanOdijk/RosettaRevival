SPANISH 75
&
\begin{verbatim}
%
(* file contains 1 ADVPrule + QPsgs + QPrules  *)
% RULE RADVPamountmod  
(* planned: complementafhandeling; cf english: RC:ADVPdegreemod 
   planned: degree-modification  of temporal ADVPs     *)

< m1: ADVP{ADVPrec1}[I3:mu1]
  m2: T1
>

< m : ADVP{ADVPrec1}[I2:rel1/T2,
                 I3:mu1
                ]
>

   MATCHCONDITIONS
      <
       m2: (T1.cat IN [ADVP] WITH T1.REC.actsubcefs * [degreeadv] <> []) OR
           ((T1.cat IN [NP] WITH T1.REC.actsubcs * [unitnoun] <> [])
                                                   (*, amountnp *) OR
            (T1.cat IN [NP] WITH T1.REC.actcomas * [mass] <> []) 
           )
       I2: ((T2.cat IN [ADVP] WITH T2.REC.actsubcefs * [degreeadv] <> [] ) AND
            (rel1 IN [degreemodrel])
           ) OR
           (((T2.cat IN [NP] WITH T2.REC.actsubcs * [unitnoun] <> []) 
                                                   (* amountnp *) OR
            (T2.cat IN [NP] WITH T2.REC.actcomas * [mass] <> []) 
           ) AND
            (rel1 IN [premodrel])
           )
       I3: NOT EXIST(mu1, [premodrel/..]) AND
           NOT EXIST(mu1, [degreemodrel/..])
        m1: ADVPrec1.temporal = false
        m: ADVPrec1.temporal = false
        
      >


< 
   SUBRULE (* 1 *)    (* casi demasiado, demasiado ADJmente *)
      <T1:ADVP{ADVPrec3}[mu9] >
      <T2:ADVP{ADVPrec4}[mu9] >

      COMP
         <
          C1: ADVPrec3.supertiempo = ADVPrec1.supertiempo
          A1: ADVPrec4 := ADVPrec1;
              ADVPrec4.supertiempo := omegatiempo;
              rel1 := degreemodrel;

         >

      DECOMP
         <
          C1: ADVPrec4.supertiempo = omegatiempo
          A1: ADVPrec3 := ADVPrec1;
              ADVPrec3.supertiempo := ADVPrec1.supertiempo;
         >

   SUBRULE (* 2 *) (* dos metros demasiado, a bit too, menos (NP??) diverso *)
      <T1:NP{NPrec1}[mu8] >
      <T2:NP{NPrec2}[mu9] >

      COMP
         <
          C1: NPrec1.supertiempo = ADVPrec1.supertiempo AND
              NPrec1.cases = []
          A1: QUOTE_assigncase(NPrec1,mu8,NPrec2,mu9,[Nominative]); 
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              rel1 := premodrel;

         >

      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo  AND
              nominative IN NPrec2.cases

          A1: QUOTE_assigncase(NPrec2, mu9, NPrec1, mu8, []); 
              NPrec1.supertiempo := ADVPrec1.supertiempo;
              NPrec1.generic := nogeneric;
         >

>
&

\end{verbatim}
