\newpage
\begin{verbatim}
% RULE RordDeriv
< m1:BADJSUFF(KEY_ordBADJSUFFkey){BADJSUFFrec1} 
  m2:CARD{CARDrec1}[head/T1, mu1]
>

< m :SUBADJ{SUBADJrec1}
          [ complrel/CARD{CARDrec1}[head/T1, mu1],
            head/BADJSUFF(KEY_ordBADJSUFFkey){BADJSUFFrec1} 
          ]
>

<
   SUBRULE  (* 22, 1433, 151 *)
      <T1: CARD{CARDrec2}[mu2] >   
      <T1: CARD{CARDrec2}[mu2] >

      COMP
         <
          C1: true
          A1: SUBADJrec1 := COPYT_BtoSUBADJ(BADJSUFFrec1);
         >
      DECOMP
         <
          C1: SUBADJrec1 = COPYT_BtoSUBADJ(BADJSUFFrec1)
          A1: @
         >
   SUBRULE   (* 1, 2, 3....9*)
      <T1: DIGIT{DIGITrec1} >
      <T1: DIGIT{DIGITrec1} >

      COMP
         <
          C1:true
             C11:DIGITrec1.valeu IN [1,3]
             A11:SUBADJrec1 := COPYT_BtoSUBADJ(BADJSUFFrec1);
                 SUBADJrec1.possapocope := si
             C12:NOT (DIGITrec1.valeu IN [1,3] )
             A12:SUBADJrec1 := COPYT_BtoSUBADJ(BADJSUFFrec1);
          A1:@
         >
      DECOMP
         <
          C1:true
             C11:DIGITrec1.valeu IN [1,3] AND
                 SUBADJrec1 = COPYT_BtoSUBADJ(BADJSUFFrec1) 
                 EXCEPT FOR  [possapocope] AND 
                 SUBADJrec1.possapocope = si
             A11:@
             C12:NOT (DIGITrec1.valeu IN [1,3] ) AND
                 SUBADJrec1 = COPYT_BtoSUBADJ(BADJSUFFrec1)
             A12:@
           A1:@
         >

>
&


\end{verbatim}
