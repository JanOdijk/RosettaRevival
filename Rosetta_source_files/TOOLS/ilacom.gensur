VAR parametertype,converttype:LOCALFILE;
    str:TSTRING_string;
BEGIN
INIT: BEGIN initlocalfile(parametertype);
            initlocalfile(converttype);
      END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%TYPENAME.str;
                     \parametertype.\LOCAL.
                     "LIILrules_" ""str"" "=INTEGER;"\\
                     \converttype.\LOCAL.
                     "PROCEDURE conv" ""str"" "("
                     "valeu:LIILRULES_" ""str"" ";"
                      "VAR str:string;"
                      "VAR len:INTEGER);"\\
                     "VAR len1:STR_range;"\\
                     "BEGIN"\\
                     "STR_IntegerTostr(valeu,str,len1);"\\
                     "len:=len1;"\\
                     "len:=len1;"\\
                     "END;"\\
