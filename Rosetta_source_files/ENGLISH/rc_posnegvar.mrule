\begin{verbatim}
% RULE RSentPosVar
< m1: CLAUSE{CLAUSErec1}
            [ I1:mu1,
              I3:mu3,
              predrel/VERBP{VERBPrec1}[I4:mu4],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ I1:mu1,
              posrel/POSVAR{POSVARrec1},
              I3:mu3,
              predrel/VERBP{VERBPrec1}[I4:mu4],
              mu5
            ]
>

   MATCHCONDITIONS
      <
       I1: ALL (mu1, I11:rel1/..) 
         I11: QUOTE_SRelPrec(rel1, posrel) AND
              NOT rel1 IN [negrel, meltnegrel, posrel] 
       I3: ALL (mu3, I31:rel3/..) 
         I31: QUOTE_SRelPrec(posrel, rel3) AND NOT 
              rel3 IN [posrel, negrel, meltnegrel]
       I4: NOT EXIST (mu4, [meltnegrel/..])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
