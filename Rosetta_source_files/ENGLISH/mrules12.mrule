\newpage
\begin{verbatim}
% RULE RImpMoodplease           (* imperativemood sg/pl main clause *)
< m1:I2::CLAUSE{CLAUSErec1}
               [ subjrel/NP{NPrec1}
                     [head/PERSPRO{PERSPROrec1}
                          [I4:head/T1] 
                     ],
                 I1:mu1,
                 auxrel/VERB{VERBrec1}[mu2],
                 mu3
               ] 
>

< m :I3::SENTENCE{SENTENCErec1}
                 [ leftdislocrel/ADVP{ADVPrec1}
                                  [head/ADV{ADVrec1}
                                    [head/SUBADV{SUBADVrec1}
                                     [head/BADV(KEY_pleaseBADVkey){BADVrec1}]
                                    ] 
                                  ],
                   I1:mu1,
                   auxrel/VERB{VERBrec2}[mu2],
                   mu3
                 ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [subjrel/..])
       I2: CLAUSErec1.finiteness = finite  AND
           CLAUSErec1.deixis = presentdeixis AND
           CLAUSErec1.modus = imperative
       I3: SENTENCErec1.deixis = presentdeixis AND
           SENTENCErec1 = { modus      : imperative
                            finiteness : finite
                            mood       : imperativemood
                            senttype   : mainclause
                            conjkey    : 0
                            adverbial  : false
                            temporal   : false
                            conjclass  : omegaTimeAdvClass
                            conjdeixis : omegadeixis
                            conjaspect : omegaAspect
                            conjretro  : false }
       I4: T1.CAT = BPERSPRO
      >

   PARAMETERS
      <
       numberpar : numbertype
      >

<
   SUBRULE (* 1. singular *)
      < T1: BPERSPRO(KEY_yousgBPERSPROkey){BPERSPROrec1} >
      < >

      COMP
         <
          C1: VERBrec1 = { modus   : omegamodus 
                           persons NI 2
                           numbers NI singular } AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = Nominative AND 
              NPrec1 = AUX_NPONyousgPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [ nominative] AND
              numberpar = singular 
          A1: VERBrec2 := VERBrec1;
              VERBrec2 := { modus   : infinitive
                            persons : [] 
                            numbers : [] };
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : imperativemood
                                senttype : mainclause
                                modus    : imperative };
              (* other attributes specific to sentence 
                 retain default values *)
              SUBADVrec1 := COPYT_badvTOsubadv(BADVrec1);
              ADVrec1  := AUX_ADVonplease;
              ADVPrec1 := AUX_ADVPonplease;
         >

   SUBRULE (* 2. plural *)
      < T1: BPERSPRO(KEY_youplBPERSPROkey){BPERSPROrec1} >
      < >

      COMP
         <
          C1: VERBrec1 = { modus   : omegamodus 
                           persons NI 2
                           numbers NI plural } AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = Nominative AND 
              NPrec1 = AUX_NPONyouplPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [nominative] AND
              numberpar = plural
          A1: VERBrec2 := VERBrec1;
              VERBrec2 := { modus   : infinitive
                            persons : [] 
                            numbers : [] };
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : imperativemood
                                senttype : mainclause
                                modus    : imperative };
              (* other attributes specific to sentence 
                 retain default values *)
              SUBADVrec1 := COPYT_badvTOsubadv(BADVrec1);
              ADVrec1  := AUX_ADVonplease;
              ADVPrec1 := AUX_ADVPonplease;
         >

>
&

\end{verbatim}
