SPANISH 44
&
\newpage
\begin{verbatim}
%
% RULE Rfinpresfutdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu5, [tempadvrel/..])
      >

<
   SUBRULE
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            ((ADVPVARrec1.tiempo = futuro) OR
             (ADVPVARrec1.tiempo = omegatiempo) OR
             (ADVPVARrec1.tiempo = presente)
            ) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((ADVPVARrec1.tiempo <> presente) OR
               ((ADVPVARrec1.tiempo = presente) AND
                (CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false) AND
                (NOT QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;

          A1: CLAUSErec2.tiempo := presente;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = presente) AND
              ((ADVPVARrec1.tiempo <> presente) OR
               ((ADVPVARrec1.tiempo = presente) AND
                (CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro = false) AND
                (NOT QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              CLAUSErec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            ((PREPPVARrec1.tiempo = futuro) OR
             (PREPPVARrec1.tiempo = omegatiempo) OR
             (PREPPVARrec1.tiempo = presente)
            ) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((PREPPVARrec1.tiempo <> presente) OR
               ((PREPPVARrec1.tiempo = presente) AND
                (CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false) AND
                (NOT QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             

          A1: CLAUSErec2.tiempo := presente;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = presente) AND
              ((PREPPVARrec1.tiempo <> presente) OR
               ((PREPPVARrec1.tiempo = presente) AND
                (CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro = false) AND
                (NOT QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              CLAUSErec1.tiempo := omegatiempo;

         >


   SUBRULE
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            ((SENTENCErec1.conjtiempo = futuro) OR
             (SENTENCErec1.conjtiempo = omegatiempo) OR
             (SENTENCErec1.conjtiempo = presente)
            ) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((SENTENCErec1.conjtiempo <> presente) OR
               ((SENTENCErec1.conjtiempo = presente) AND
                (CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false) AND
                (NOT QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             

          A1: CLAUSErec2.tiempo := presente;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = presente) AND
              ((SENTENCErec1.conjtiempo <> presente) OR
               ((SENTENCErec1.conjtiempo = presente) AND
                (CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro = false) AND
                (NOT QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              CLAUSErec1.tiempo := omegatiempo;

         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpresfutdeixis
\item[* relevant examples:] dormir\'{a} ma\~{n}ana, dormir a las tres, dormir 
hoy por tres horas.
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 29-SEP-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentdeixis 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 21/11/88\ \ \ \ \ author: Lisette Appelo 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT, but with 
S `shifted' into the future.
               This rule is for a finite independent clause.
               The most left verb in the clause gets a present future tense.
               The deixis 
value of the reference adverbial is checked for 
               future
               The clause is marked for present deixis.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task) It has the 
same semantics as Rfinpresentdeixis.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: 
21/11/88: Added conditions for omegatiempo for adverbial and for presente in 
combination with perfective aspect and a duration adverbial. These cases are 
excluded from the presente deixis rule.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rfinfutpastdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    auxrel/VERB{VERBrec3}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(KEY_futurobverbkey){BVERBrec1}]
                          ],
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu5, [tempadvrel/..])
      >

<
   SUBRULE
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            (ADVPVARrec1.tiempo IN [pasado, omegatiempo, futuro]) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    }
              )
             )

             C11:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = pasado)
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := pasado;  (* switch *)
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              CLAUSErec1.tiempo := omegatiempo;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              VERBrec3 :=
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                  };

         >

   SUBRULE
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            (PREPPVARrec1.tiempo IN [pasado, omegatiempo, futuro]) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    }
              )

             )

             C11:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := omegatiempo;
             

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = pasado)
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := pasado;  (* switch *)

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              CLAUSErec1.tiempo := omegatiempo;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              VERBrec3 :=
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    };

         >


   SUBRULE
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            (SENTENCErec1.conjtiempo IN [pasado, omegatiempo, futuro]) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    }
              )

             )

             C11:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := omegatiempo;
             

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = pasado)
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := pasado;  (* switch *)

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              CLAUSErec1.tiempo := omegatiempo;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              VERBrec3 :=
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    };

         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinfutpastdeixis
\item[* relevant examples:] dormir\'{i}a (ma\~{n}ana)
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 29-SEP-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinfutpresdeixis 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is befor: PAST, but with 
S `shifted' into the future expressed by the `futureverb'.
               This rule is for a finite independent clause.
               The future verb is incorporated into its right neighbour and
               gets a past future tense.
               The deixis 
value of the reference adverbial is checked for 
               past, omega or future
               The clause is marked for past deixis.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task) It has the 
same semantics as Rfinpastdeixis.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages: It is always translated into past of {\em zullen} and 
{\em would}\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: 
\end{enumerate}
\end{description}

