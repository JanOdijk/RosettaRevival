\begin{verbatim}
% TRANSFORMATION TNoAuxToComp
< m1: T1
>

< m : T1
>

<
   SUBRULE (* 1. SENTENCE *)
      < T1: SENTENCE{SENTENCErec1}[ mu1 ] >
      < T1: SENTENCE{SENTENCErec1}[ mu1 ] >

   MATCHCONDITIONS
      <
       T1: (SENTENCErec1.senttype <> mainclause)           OR 
           (NOT EXIST (mu1, [subjrel/..]))                 OR
           ( SENTENCErec1.mood <> yesnointerrogative AND 
             NOT EXIST (mu1, [shiftrel/..])  )             AND
           ( 
             SENTENCErec1.mood = imperativemood ->
             (NOT EXIST (mu1, [auxrel/VERB{}[I5:mu5]]) AND
              NOT EXIST (mu1, [negrel/..]))
           )
       I5: EXIST (mu5, [negrel/..])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. NP *)
      < T1: NP{NPrec1}[ mu1 ] >
      < T1: NP{NPrec1}[ mu1 ] >

   MATCHCONDITIONS
      <
       T1: NPrec1.NPhead IN [openIngNP, sentNP]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 3. PREPP *)
      < T1: PREPP{PREPPrec1}[ mu1 ] >
      < T1: PREPP{PREPPrec1}[ mu1 ] >

   MATCHCONDITIONS
      <
       T1: EXIST (mu1, [objrel/I1::NP{NPrec1}[mu2]])
       I1: NPrec1.NPhead IN [openIngNP, sentNP]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 4. CLOSEDVERBPPROP *)
      < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[ mu1 ] >
      < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[ mu1 ] >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
