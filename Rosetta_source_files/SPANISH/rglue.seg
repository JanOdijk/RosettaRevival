*e(OE)(MED1)(MED2)(MED3)(UU)en + (A)  ::  *é(OE)(MED1)(MED2)(MED3)(UU)en(A) ;

*o(OE)(MED1)(MED2)(MED3)(UU)en + (A)  ::  *ó(OE)(MED1)(MED2)(MED3)(UU)en(A) ; 


*aen + (A)  ::  *áen(A) ;

*een + (A)  ::  *éen(A) ;

*oen + (A)  ::  *óen(A) ; 


*a(MED1)(UU)en + (A)  ::  *á(MED1)(UU)en(A) ;

*e(MED1)(UU)en + (A)  ::  *é(MED1)(UU)en(A) ;

*i(MED1)(UU)en + (A)  ::  *í(MED1)(UU)en(A) ;

*o(MED1)(UU)en + (A)  ::  *ó(MED1)(UU)en(A) ; 

*u(MED1)(UU)en + (A)  ::  *ú(MED1)(UU)en(A) ;


*a(MED1)(MED2)(UU)en + (A)  ::  *á(MED1)(MED2)(UU)en(A) ;

*e(MED1)(MED2)(UU)en + (A)  ::  *é(MED1)(MED2)(UU)en(A) ;

*i(MED1)(MED2)(UU)en + (A)  ::  *í(MED1)(MED2)(UU)en(A) ;

*o(MED1)(MED2)(UU)en + (A)  ::  *ó(MED1)(MED2)(UU)en(A) ; 

*u(MED1)(MED2)(UU)en + (A)  ::  *ú(MED1)(MED2)(UU)en(A) ;


*a(MED1)(MED2)(MED3)(UU)en + (A)  ::  *á(MED1)(MED2)(MED3)(UU)en(A) ;

*e(MED1)(MED2)(MED3)(UU)en + (A)  ::  *é(MED1)(MED2)(MED3)(UU)en(A) ;

*i(MED1)(MED2)(MED3)(UU)en + (A)  ::  *í(MED1)(MED2)(MED3)(UU)en(A) ;

*o(MED1)(MED2)(MED3)(UU)en + (A)  ::  *ó(MED1)(MED2)(MED3)(UU)en(A) ; 

*u(MED1)(MED2)(MED3)(UU)en + (A)  ::  *ú(MED1)(MED2)(MED3)(UU)en(A) ;



{ irregular Imperativo-forms }

*pón + (A)   ::  *pón(A) ;    { composite forms with poner; imponer - impón }

*vén + (A)   ::  *vén(A) ;    { composite forms with venir; convenir - convén }

*tén + (A)   ::  *tén(A) ;    { composite forms with tener; contener - contén }

*haz + (A)   ::  *haz(A) ;    { hacer + possible composite forms }

*sal + (A)   ::  *sal(A) ;    { salir + composite forms; sobresal }

*val + (A)   ::  *val(A) ;    { valer + possible composite forms }

*está + (A)  ::  *está(A) ;  
                              { estar + possible composite forms }
*esté + (A)  ::  *esté(A) ;  

*dé + (A)    ::  *dé(A) ;     { dar + possible composite forms }

*da + (A)    ::  *da(A) ;     { e.g. dalo  21/4/89  EvM }

{ **************************************************************** }

{ dividing a word into three segments }

{ infinitivo; comprar - comprártelo }


*ar + (B) + (A3) :: *ár(B)(A3) ;

*er + (B) + (A3) :: *ér(B)(A3) ;

*ir + (B) + (A3) :: *ír(B)(A3) ;


{ gerundio; comprando - comprándomelo }

*ando + (B) + (A3) :: *ándo(B)(A3) ;

*endo + (B) + (A3) :: *éndo(B)(A3) ;


{ Imperativo }

{ forms ending on -a; coma - cómamelo }


*a(OE)(MED1)a + (B) + (A3) :: *á(OE)(MED1)a(B)(A3) ;

*e(OE)(MED1)a + (B) + (A3) :: *é(OE)(MED1)a(B)(A3) ;

*o(OE)(MED1)a + (B) + (A3) :: *ó(OE)(MED1)a(B)(A3) ;


*a(OE)(MED1)(MED2)a + (B) + (A3) :: *á(OE)(MED1)(MED2)a(B)(A3) ;

*e(OE)(MED1)(MED2)a + (B) + (A3) :: *é(OE)(MED1)(MED2)a(B)(A3) ;

*o(OE)(MED1)(MED2)a + (B) + (A3) :: *ó(OE)(MED1)(MED2)a(B)(A3) ;


*a(OE)(MED1)(MED2)(MED3)a + (B) + (A3) :: *á(OE)(MED1)(MED2)(MED3)a(B)(A3) ;

*e(OE)(MED1)(MED2)(MED3)a + (B) + (A3) :: *é(OE)(MED1)(MED2)(MED3)a(B)(A3) ;

*o(OE)(MED1)(MED2)(MED3)a + (B) + (A3) :: *ó(OE)(MED1)(MED2)(MED3)a(B)(A3) ;



*aa + (B) + (A3) :: *áa(B)(A3) ;

*ea + (B) + (A3) :: *éa(B)(A3) ;

*oa + (B) + (A3) :: *óa(B)(A3) ;


*a(MED1)a + (B) + (A3) :: *á(MED1)a(B)(A3) ;

*e(MED1)a + (B) + (A3) :: *é(MED1)a(B)(A3) ;

*i(MED1)a + (B) + (A3) :: *í(MED1)a(B)(A3) ;

*o(MED1)a + (B) + (A3) :: *ó(MED1)a(B)(A3) ;

*u(MED1)a + (B) + (A3) :: *ú(MED1)a(B)(A3) ;



*a(MED1)(MED2)a + (B) + (A3) :: *á(MED1)(MED2)a(B)(A3) ;

*e(MED1)(MED2)a + (B) + (A3) :: *é(MED1)(MED2)a(B)(A3) ;

*i(MED1)(MED2)a + (B) + (A3) :: *í(MED1)(MED2)a(B)(A3) ;

