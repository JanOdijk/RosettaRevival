SPANISH 11
&
\newpage
\begin{verbatim}
%
%TRANSFORMATION Treflspellingdefault (* VERBPPROP, not reflexive  or reflexive
                                                                  with futuro *)

< m1:VERBPPROP{VERBPPROPrec1}[ mu1,
                               predrel/VERBP{VERBPrec1}
                                      I1:[ mu11,
                                          head/VERB{VERBrec1}[mu3],
                                          mu2
                                        ],
                               mu4
                             ]
>

< m :VERBPPROP{VERBPPROPrec1}[ mu1,
                               predrel/VERBP{VERBPrec1}
                                      I1:[ mu11,
                                          head/VERB{VERBrec1}[mu3],
                                          mu2
                                        ],
                               mu4
                             ]
>
   MATCHCONDITIONS
      <
       I1:VERBrec1.reflexivity = notreflexive OR
          (VERBrec1.reflexivity = reflexive AND
           EXIST (mu2, [cliticrel/CLITIC{CLITICrec1}[I2:mu5]]) AND
           EXIST (mu11, [I4:auxrel/VERB{VERBrec2}[mu7]])
          )
       I2: EXIST (mu5, [I3:rel1/REFLPRO{REFLPROrec1}[mu6]])
       I3: rel1 IN [unoclrel, dosclrel, seclrel]
       I4: VERBrec2.futuro = sifuturo
      >

      COMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
