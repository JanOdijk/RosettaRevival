                                         VAR d : HILtree_pHyperILtree);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : HILtree_IsOriginSaved
 *  Description    : Tells whether the stree from which this dtree resulted
 *                   has been saved.
 *  Parameters     : d : HILtree_pHyperILtree
 *  Result         : TRUE iff the stree from which this dtree resulted has been
 *                   saved.
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION HILtree_IsOriginSaved (d : HILtree_pHyperILtree)
                    : BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : HILtree_ReturnOrigin
 *  Description    : Returns the Stree from which this dtree resulted
 *  Parameters     : d : HILtree_pHyperILtree
 *  Result         : HILtree_pStree
 *  Precondition   : HILtree_IsOriginSaved(d)
 *  Postcondition  : RETURNS ts AND ts CAST LIStree_pSetOfStrees = M-Generator(d)
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION HILtree_ReturnOrigin (d : HILtree_pHyperILtree)
                    : HILtree_pDnode;
EXTERNAL;



