% RULE RIdNPFormation2

< m1: CN{CNrec1}[mu1]
>

< m : NP{NPrec1}[head/CN{CNrec1}[mu1]
                ]
>
      COMP
         <
          C1: true
            C11: CNrec1.numero = singular 
            A11: (* NPrec1 := COPYT_CNtoNP(CNrec1); *)
               NPrec1 := { 
                          numero            : singular    (*NOUNrec.number *)
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          genero            : omegagenero
                          specQ             : yesspec
                          syntquant         : omegaquant
                          generic           : nogeneric
        		  supertiempo       : omegatiempo
                         }  
            C12: CNrec1.numero = plural
            A12: (* NPrec1 := COPYT_CNtoNP(CNrec1); *)
               NPrec1 := { 
                          numero            : plural 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          genero            : omegagenero
                          specQ             : yesspec 
                          syntquant         : omegaquant 
                          generic           : nogeneric
        		  supertiempo       : omegatiempo
                         }  
          A1: NPrec1.definite := indef;
              NPrec1.posspred := true;
              NPrec1.possnietnp := true; 

         >

      DECOMP
         <
          C1:(NPrec1.definite = indef) AND
              (NPrec1.posspred =  true) AND
              (NPrec1.possnietnp = true) AND
              (NPrec1.cases = [nominative])
              C11: NPrec1 = { 
                          numero            : singular (*NOUN.number *)
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
(*                          genero            : omegagenero *)
                          specQ             : yesspec 
                          syntquant         : omegaquant
                          generic           : nogeneric
        		  supertiempo       : omegatiempo
                         }  
              A11:@
              C11: NPrec1 = { 
                          numero            : plural
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
(*                          genero            : omegagenero *)
                          specQ             : yesspec
                          syntquant         : omegaquant 
                          generic           : nogeneric
        		  supertiempo       : omegatiempo
                         }  
              A11:@

           A1:  @
         >
&


\end{verbatim}
