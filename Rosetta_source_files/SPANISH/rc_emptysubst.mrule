(* This rule will be deleted; a subject UNO will be introduced in the objectok 
rules (Tobjectok4d) *)
\newpage
\begin{verbatim}
 RULE REmptysubstitution6

       (* subst of seEMPTY as a subjrel/UNO, with a reflexive verb *)

< m1: I1::CLAUSE{CLAUSErec1}
                [ mu6,
                  I4:subjrel/EMPTYVAR{EMPTYVARrec1},
                  mu7,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu4
                         ],
                  mu5
                ]
SUBST:
  m2: EMPTY(KEY_seemptykey){EMPTYrec1}            (*substituent*)
>

< m: I2::CLAUSE{CLAUSErec2}
                [ mu6,
                  subjrel/NP{NPrec1}
                      [head/PERSPRO{PERSPROrec1}
                         [head/BPERSPRO(KEY_unoindefprokey){BPERSPROrec1}]
                      ],
                  mu7,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu4
                         ],
                  mu5
                ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.finiteness = finite) AND
           (CLAUSErec1.voice = active)
       I2: CLAUSErec2.finiteness = finite
       I3: (Active IN VERBrec1.possvoices ) AND
           (VERBrec1.thetavp IN [vp100, vp120, vp123] ) AND
           (VERBrec1.reflexivity = reflexive)
       I4: EMPTYVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: true
          A1: NPrec1.NPhead := unoNP;
              NPrec1.persona := 3;
              NPrec1.numero := singular;

              (* the other values are default *)

              CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (NPrec1 = NPrecdef EXCEPT FOR [NPhead, persona, numero]) AND
              (NPrec1.NPhead = unoNP) AND
              (NPrec1.persona = 3) AND
              (NPrec1.numero = singular)

          A1: CLAUSErec1 := CLAUSErec2
         >
&

\end{verbatim}
