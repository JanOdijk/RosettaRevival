\newpage
\begin{verbatim}
% RULE ROPENADJPPROPSentenceSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [I2:mu2,
                        complrel/I1::ADJPPROPVAR{ADJPPROPVARrec1},
                        I3:mu3 
                       ],
                I6:mu6,
                I7:mu7
               ]
  
  SUBST:
  m2: OPENADJPPROP{OPENADJPPROPrec1}
                  [
                   subjrel/T1,
                   predrel/ADJP{ADJPrec1}[mu5]
                  ]
>

< m : VERBPPROP{VERBPPROPrec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                        [I2:mu2,
                         I3:mu3 
                        ],
                 I6:mu6,
                 postsentadvrel/SENTENCE{SENTENCErec1}
                    [conjrel/CONJ(KEY_'s_till2CONJkey'){CONJrec1}[],
                     subjrel/T2,
                     auxrel/VERB{VERBrec1}
                                [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(AUX_beBVERBkey){BVERBrec1}]
                                ],
                     predrel/VERBP{VERBPrec1}
                            [complrel/ADJP{ADJPrec1}[mu5]]
                     ],
                 I7:mu7
                 ]
>

   MATCHCONDITIONS
      <
       I1: ADJPPROPVARrec1.index = LEVEL 
       I2: ALL(mu2,I21:rel2/..)
           I21: QUOTE_VPrelprec(rel2,complrel)
       I3: ALL(mu3,I31:rel3/..)
           I31: QUOTE_VPrelprec(complrel,rel3)
       I6: ALL (mu6,I61:rel6/..) AND NOT EXIST (mu6,[postsentadvrel/..])
           I61: QUOTE_Srelprec (rel6,postsentadvrel)
       I7: ALL (mu7,postsentadvrel/..)
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE
      < T1:NPVAR{NPVARrec1}>
      < T2:NPVAR{NPVARrec2}>


      COMP
         <
          C1: AUX_adjppredvps * VERBPPROPrec1.synvpefs = [] AND
              [resAP] * VERBPPROPrec1.adjuncts = [] AND
              ADJPPROPVARrec1 = COPYT_adjppropTOvar(OPENADJPPROPrec1) 
              C11: OPENADJPPROPrec1.superdeixis = presentdeixis
              A11: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
                   VERBrec1.modus := indicative;
                   VERBrec1.tense := presenttense;
                   VERBrec1.persons := [NPVARrec1.person];
                   VERBrec1.numbers := [NPVARrec1.number];
              C12: OPENADJPPROPrec1.superdeixis = pastdeixis
              A12: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
                   VERBrec1.modus := indicative;
                   VERBrec1.tense := pasttense;
                   VERBrec1.persons := [NPVARrec1.person];
                   VERBrec1.numbers := [NPVARrec1.number];
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [nominative];
              SENTENCErec1     := SENTENCErecdef;
              SENTENCErec1     :=
                       {
                       mood:              declarative
                       senttype:          subordinateclause
                       voice:             active
                       synvpefs:          VERBrec1.synvps (*synBE*)
                       thetavp:           VERBrec1.thetavp (*thetavpaux*)
                       adjuncts:          VERBrec1.adjuncts (*[]*)
                       modus:             VERBrec1.modus
                       aktionsarts:       [stative]
                       aspect:            omegaAspect
                       deixis:            omegadeixis
                       retro:             false
                       finiteness:        finite
                       superdeixis:       OPENADJPPROPrec1.superdeixis
                       conjclass:         CONJrec1.class
                       conjdeixis:        CONJrec1.deixis
                       conjaspect:        CONJrec1.aspect
                       conjretro:         CONJrec1.retro
                       }


         >
   SUBRULE
      < T1:CNVAR{CNVARrec1} >
      < T2:CNVAR{CNVARrec2} >

      COMP
         <
          C1: AUX_adjppredvps * VERBPPROPrec1.synvpefs = [] AND
              [resAP] * VERBPPROPrec1.adjuncts = [] AND
              ADJPPROPVARrec1 = COPYT_adjppropTOvar(OPENADJPPROPrec1) 
              C11: OPENADJPPROPrec1.superdeixis = presentdeixis
              A11: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
                   VERBrec1.modus := indicative;
                   VERBrec1.tense := presenttense;
                   VERBrec1.persons := [3];
                   VERBrec1.numbers := CNVARrec1.numbers;
              C12: OPENADJPPROPrec1.superdeixis = pastdeixis
              A12: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
                   VERBrec1.modus := indicative;
                   VERBrec1.tense := pasttense;
                   VERBrec1.persons := [3];
                   VERBrec1.numbers := CNVARrec1.numbers;
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [nominative];
              SENTENCErec1     := SENTENCErecdef;
              SENTENCErec1     :=
                       {
                       mood:              declarative
                       senttype:          subordinateclause
                       voice:             active
                       synvpefs:          VERBrec1.synvps (*synBE*)
                       thetavp:           VERBrec1.thetavp (*thetavpaux*)
                       adjuncts:          VERBrec1.adjuncts (*[]*)
                       modus:             VERBrec1.modus
                       aktionsarts:       [stative]
                       aspect:            omegaAspect
                       deixis:            omegadeixis
                       retro:             false
                       finiteness:        finite
                       superdeixis:       OPENADJPPROPrec1.superdeixis
                       conjclass:         CONJrec1.class
                       conjdeixis:        CONJrec1.deixis
                       conjaspect:        CONJrec1.aspect
                       conjretro:         CONJrec1.retro
                       }
         >
>
&

\end{verbatim}
