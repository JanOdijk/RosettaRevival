pragma C_include('listree.pf');
pragma C_include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE DebugMgenerator;
WITH LISTREE, WND;

PROCEDURE DebugMgenerator_Init; EXTERNAL;

PROCEDURE DebugMgenerator_Default; EXTERNAL;

PROCEDURE DebugMgenerator_Reset; EXTERNAL;

PROCEDURE DebugMgenerator_StoreStreeSet(s: LISTREE_SetOfStrees); EXTERNAL;

PROCEDURE DebugMgenerator_StoreStreeTuple(t: LISTREE_TupleOfStrees); EXTERNAL;

FUNCTION DebugMgenerator_Trace: BOOLEAN; EXTERNAL;

FUNCTION DebugMgenerator_StopParse: BOOLEAN; EXTERNAL;

FUNCTION DebugMgenerator_StopAllParse: BOOLEAN; EXTERNAL;

FUNCTION DebugMgenerator_Step: BOOLEAN; EXTERNAL;

FUNCTION DebugMgenerator_RuleBreakPoint(r: INTEGER): BOOLEAN; EXTERNAL;

FUNCTION DebugMgenerator_TransBreakPoint(r: INTEGER): BOOLEAN; EXTERNAL;

FUNCTION DebugMgenerator_PlusStree
                  : BOOLEAN; EXTERNAL;

PROCEDURE DebugMgenerator_LastTriedRule(r: INTEGER); EXTERNAL;

PROCEDURE DebugMgenerator_LastTriedTrf(r: INTEGER); EXTERNAL;

PROCEDURE DebugMgenerator_Menu; EXTERNAL;

PROCEDURE DebugMgenerator_HandleKey ( key : WND_Xid ); EXTERNAL;

END {DebugMgenerator};
