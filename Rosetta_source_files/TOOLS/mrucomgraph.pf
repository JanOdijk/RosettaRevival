pragma C_include ('mrucomlangspec.pf');
pragma C_include ('mrucomdecl.pf');

PACKAGE mrucomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH mrucomDECL,
     mrucomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: mrucomLANGSPEC_Category;
                          b: mrucomDECL_nodeid): mrucomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: mrucomDECL_psurfgraph): mrucomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: mrucomDECL_psurfgraph): mrucomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: mrucomDECL_psurfgraph): mrucomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: mrucomDECL_psurfgraph): mrucomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: mrucomLANGSPEC_Category; 
                          c: mrucomDECL_psurfgraph); EXTERNAL;
 
END {mrucomGRAPH};
