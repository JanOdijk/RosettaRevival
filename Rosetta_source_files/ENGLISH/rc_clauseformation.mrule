\newpage
\begin{verbatim}
% RULE RAdjpClauseFormation
< m1: ADJPPROP{ADJPPROPrec1}
              [ mu1,
                predrel/ADJP{ADJPrec1}
                            [ mu2,
                              head/ADJ{ADJrec1}[mu4],
                              I5:mu5,
                              I3:mu3 ],
                I6:mu6,
                I1:sig1
              ]
>

< m : I2::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [head/VERB{VERBrec1}
                              [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(AUX_beBVERBkey){BVERBrec1}]
                               ],
                           predrel/ADJP{ADJPrec2}
                                       [ mu2, 
                                         head/ADJ{ADJrec1}[mu4],
                                         I5:mu5
                                       ]
                         ],
                  I6:mu6,
                  I3:mu3,
                  I1:sig1
                ]
>

   MATCHCONDITIONS
      <
       I1: ALL (sig1, extraposrel/..)
       I2: synBE IN CLAUSErec1.synvpefs AND
           CLAUSErec1 =       {
                       voice:            active
                       thetavp:          thetavpaux
                       modus:            omegamodus
                       aspect:           omegaAspect  
                       deixis:           omegadeixis 
                       retro:            false       
                       finiteness:       omegafin
                       infsort:          omegainf        
                       }
       I3: ALL (mu3, tempadvrel/..)
       I5: NOT EXIST (mu5, [tempadvrel/..])
       I6: ALL (mu6, locadvrel/..)
      >

      COMP
         <
          C1: ADJPPROPrec1 = COPYT_adjpTOadjpprop(ADJPrec1) 
                EXCEPT FOR [aktionsarts, PROsubject, 
                superdeixis ] AND
              (* no test on these attributes *)
              ADJPrec1.actuseefs = [] AND
              predicative IN ADJrec1.uses
          A1: CLAUSErec1 := { voice         : active
                              thetavp       : thetavpaux
                              synvpefs      : [synBE]
                              superdeixis   : ADJPPROPrec1.superdeixis
                              aktionsarts   : ADJPPROPrec1.aktionsarts
                              PROsubject    : ADJPPROPrec1.PROsubject};
              (* the clause attributes get default values 
                 , except for voice and synvpefs, and those 
                 attributes from ADJPPROP that had already been set; 
                 note that PROsubject and superdeixis of the ADJPPROP 
                 should still be default *)
              (* Note that class, deixis and aspect cannot be copied 
                 to the CLAUSE, since they have a different meaning 
                 there: just copies of ADJ(P) *)
              SUBVERBrec1 := COPYT_bverbTOsubverb(BVERBrec1);
              VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
              (* other attributes receive default values *)
              (* VERBP receives default values only *)
              ADJPrec2 := ADJPrec1;
              ADJPrec2.actuseefs := [predicative]
         >

      DECOMP
         <
         C1:  SUBVERBrec1 = COPYT_bverbTOsubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix AND
              VERBrec1 = COPYT_subverbTOverb(SUBVERBrec1) AND
              VERBrec1 = { numbers   : []
                           persons   : []
                           modus     : omegamodus
                           tense     : omegatense } 
              AND
              predicative IN ADJPrec2.actuseefs
 
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := COPYT_adjpTOadjpprop(ADJPrec1);
              ADJPPROPrec1 := { 
                                PROsubject    : CLAUSErec1.PROsubject
                                superdeixis   : CLAUSErec1.superdeixis
                                aktionsarts   : CLAUSErec1.aktionsarts
                               };
              ADJPrec1.actuseefs := [];
         >  

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RAdjpClauseFormation
\item[* relevant examples:] x1 ill $\rightarrow$ x1 be ill
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) RC\_
ClauseFormation
\item[* date of creation:] 8-APR-1988 16:14:58  
\item[* author:] margreet sanders
\item[* copied from:] Dutch RClauseFormation3
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 25/10/89\ \ \ \ \ author: margreet sanders\\
Adapted rule to allow for locadvs outside the ADJP. If it is decided to 
generate them inside the ADJP, they go in mu5, and mu6 can be removed again (
unless it is needed for postsentadvrel?!)
\item date: 26/08/90\ \ \ \ \ author:Petra de Wit\\
Rewrote (DE)COMP for correct assignment of values to attributes and correct 
assumptions about these and other values in analysis. Also added 
matchcondition on clause attributes.
\end{enumerate}
\item[* task:] to make a clause with a real VERBP and a verb out of an 
adjectival structure without a verb
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] in analysis, no test is 
performed on the attribute values of the VERBP, which may not be default due to 
the actions performed by the surface parser; in generation however, these 
values are not retrieved (they are not needed for `leaves'), but simply remain 
default.
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed in this whole rule class that the verb `be' cannot assign a 
thetavp to its CLAUSE.\\
It is also assumed for the moment that the canonical position for tempadvs in 
the ADJPPROP is indeed ADJP-final. This assumption is based entirely on 
examples like 
`He was very kind to me yesterday'; no attention has been paid to an obligatory 
surface position determined by an attributively used ADJPPROP: `an ever 
reproachful look in his eyes'. For sentences like `He always was very kind to 
me' the same adv hop rules will have to apply as for clauses of other origins, 
e.g.\  `He always gave me what I asked for'.\\
If extraposition of a sentence occurring 
under the ADJP is needed, it will have to be done in the TC\_SentOKrules.
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RNpClauseFormation
< m1: NPPROP{NPPROPrec1}
            [ I2:mu1,
              predrel/NP{NPrec1}[mu2],
              mu3
            ]
>

< m : I1::CLAUSE{CLAUSErec1}
                [ I2:mu1,
                  predrel/VERBP{VERBPrec1}
                         [head/VERB{VERBrec1}
                              [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(AUX_beBVERBkey){BVERBrec1}]
                              ],
                          predrel/NP{NPrec1}[mu2]
                         ],
                   mu3 
                 ]
>

   MATCHCONDITIONS
      <
       I1: synBE IN CLAUSErec1.synvpefs
        I2: NOT EXIST(mu1,[I21:subjrel/T1])
            I21: T1.CAT IN [NP,NPVAR] 
                      WITH T1.REC.NPhead IN [itNP,thisNP,thatNP,theseNP,thoseNP]
      >

      COMP
         <
          C1: NPPROPrec1 = { thetanp        : NPrec1.thetanp
                             nounpatternefs : NPrec1.nounpatternefs}
              (* no test on superdeixis, aktionsarts, 
                 PROsubject; the latter is still default *)
          A1: CLAUSErec1 := { voice       : active
                              thetavp     : thetavpaux
                              synvpefs    : [synBE]
                              superdeixis : NPPROPrec1.superdeixis
                              aktionsarts : NPPROPrec1.aktionsarts
                              PROsubject  : NPPROPrec1.PROsubject };
              (* rest of the attributes get default values *)
              SUBVERBrec1 := COPYT_bverbTOsubverb(BVERBrec1);
              VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1)
              (* rest of attributes gets default values *)
         >

      DECOMP
         <
          C1: CLAUSErec1 = CLAUSErecdef EXCEPT FOR [voice, synvpefs,
                 thetavp, superdeixis, aktionsarts, PROsubject] AND
              CLAUSErec1.voice = active AND
              CLAUSErec1.thetavp = thetavpaux
              (* no test on superdeixis, aktionsarts, 
                 PROsubject *)
              AND
              SUBVERBrec1 = COPYT_bverbTOsubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix AND
              VERBrec1 = COPYT_subverbTOverb(SUBVERBrec1) AND
              VERBrec1 = { numbers    : []
                           persons    : []
                           modus      : omegamodus
                           tense      : omegatense }
          A1: NPPROPrec1 :={ thetanp        : NPrec1.thetanp
                             nounpatternefs : NPrec1.nounpatternefs 
                             superdeixis    : CLAUSErec1.superdeixis
                             aktionsarts    : CLAUSErec1.aktionsarts
                             PROsubject     : CLAUSErec1.PROsubject}
         >
&

\end{verbatim}
