\newpage
\begin{verbatim}
% RULE RSubstitution7          (* loPROSENT *) 
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      complrel/I3::PROSENTVAR{PROSENTVARrec1},
                      I2:mu3
                    ],
             mu4 
           ] 
SUBST:
  m2: PROSENT(KEY_loPROSENTkey){PROSENTrec1}
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      objrel/NP{NPrec1}
                          [head/PERSPRO{PERSPROrec1}
                            [head/BPERSPRO(KEY_elloBPERSPROkey){BPERSPROrec1}] 
                          ],
                      I2:mu3
                    ],
             mu4 
           ] 
>

   MATCHCONDITIONS
      <
       m1: QUOTE_Gsubstordercondition2(mu3,mu4)  
       m : QUOTE_substordercondition2(mu3,mu4)
       I1: NOT EXIST(mu2,[objrel/..])
       I2: NOT EXIST(mu3,[objrel/..])
       I3: PROSENTVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: PROSENTVARrec1.quesi =  PROSENTrec1.quesi AND
              CLAUSErec1.synvpefs * [synPROSENT] <> []
          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);
              PERSPROrec1.forma := acusCL;
              NPrec1      := AUX_NPONnomBPRSPR;
              NPrec1.cases := [Accusative];
              NPrec1.numero := singular;
              NPrec1.genero := neutro;

              CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.synvpefs := CLAUSErec1.synvpefs * [synPROSENT];
         >

      DECOMP
         <
          C1: (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1)
                                         EXCEPT FOR [forma]) AND
              NPrec1      = AUX_NPONnomBPRSPR EXCEPT FOR 
                                            [cases, numero, genero] AND
              Accusative IN NPrec1.cases AND
              CLAUSErec2.synvpefs * [synPROSENT] <> []
          A1: PROSENTVARrec1.quesi := PROSENTrec1.quesi;  
              PROSENTVARrec1.index := LEVEL;
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * [synPROSENT];
         >
&

\end{verbatim}
