\newpage
\begin{verbatim}
% RULE RCARDtoDETP
< m1:CARD{CARDrec1}[mu1] 
>

< m :DETP{DETPrec1}
         [head/CARD{CARDrec1}[mu1]]
>
      COMP
         <
          C1:TRUE
          A1:DETPrec1 := DETPrecdef;
             DETPrec1 :=
                      {
                       definite:         indef   
                       posspred:         true
                       possnumbers:      CARDrec1.possnumbers
                     }
         >
      DECOMP
         <
          C1:DETPrec1 = DETPrecdef EXCEPT FOR [definite, posspred, possnumbers]
             AND
             DETPrec1 = 
                      {
                       definite:         indef   
                       posspred:         true
                       possnumbers:      CARDrec1.possnumbers
                     }
          A1:@
         >
&

\end{verbatim}
