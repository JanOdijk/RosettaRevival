\newpage
\begin{verbatim}
% RULE RTempConjSentMoveToLeft
< m1:CLAUSE{CLAUSErec1}[mu1]
>

< m :CLAUSE{CLAUSErec1}[mu2]
>
   MATCHCONDITIONS
      <
      >

<
   SUBRULE
      <mu1: [I1:mu3, I2:tempadvrel/SENTENCE{SENTENCErec2}[mu5], I3:mu4
            ] 
      >
      <mu2: [I2:leftdislocrel/SENTENCE{SENTENCErec2}[I5:mu5, sig1], 
            I1:mu3, I3:mu4
            ]
      >


   MATCHCONDITIONS
      <
        mu2:ALL
        I1: QUOTE_temprefnotfound(mu3) AND
            ALL(mu3, I31:rel1/..) AND
            NOT EXIST (mu3, [I32:rel2/..])
        I2: SENTENCErec2.temporal = true AND
            SENTENCErec2.conjclass = reference AND
            SENTENCErec2.conjretro = false 
        I3: QUOTE_temprefnotfound(mu4) AND
            QUOTE_tempdurnotfound(mu4) AND
            QUOTE_tempretronotfound(mu4) AND
            NOT EXIST (mu4, [I31:rel1/..]) AND
            NOT EXIST (mu4, [I32:rel2/..])
        I31: QUOTE_Srelprec(rel1, tempadvrel)
        I32: rel2 IN [leftdislocrel]
        I5: NOT EXIST(mu5, [puncrel/..])
     >
<
   SUBRULE
      < >
      <sig1: [puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1}] >


      COMP
         <
          C1:true
          A1:@
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE
      < >
      <sig1:[] >


      DECOMP
         <
          C1: true
          A1: @
         >
>

   SUBRULE
      <mu1: [I1:mu3, I2:tempadvrel/SENTENCE{SENTENCErec2}[mu5], I3:mu4
            ] 
      >
      <mu2: [I2:leftdislocrel/SENTENCE{SENTENCErec2}[I5:mu5, sig1], 
            I1:mu3, I3:mu4
            ]
      >


   MATCHCONDITIONS
      <
        mu2:ALL
        I1: QUOTE_tempretronotfound(mu3) AND
            QUOTE_temprefnotfound(mu3) AND
            ALL(mu3, I11:rel1/..) AND
            NOT EXIST (mu3, [I12:rel2/..])
        I2: SENTENCErec2.temporal = true AND
            SENTENCErec2.conjclass = reference AND
            SENTENCErec2.conjretro = true
        I3: QUOTE_tempretronotfound(mu4) AND
            QUOTE_tempdurnotfound(mu4) AND
            NOT EXIST (mu4, [I31:rel3/..]) AND
            NOT EXIST (mu4, [I12:rel2/..])
        I11: QUOTE_Srelprec(rel1, tempadvrel)
        I12: rel2 IN [leftdislocrel]
        I31: QUOTE_Srelprec(rel3, tempadvrel)
        I5: NOT EXIST(mu5, [puncrel/..])

      >
<
   SUBRULE
      < >
      <sig1: [puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1}] >


      COMP
         <
          C1:true
          A1:@
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE
      < >
      <sig1:[] >


      DECOMP
         <
          C1: true
          A1: @
         >

>

   SUBRULE
      <mu1: [I1:mu3, I2:tempadvrel/SENTENCE{SENTENCErec2}[mu5], I3:mu4
            ] 
      >
      <mu2: [I2:leftdislocrel/SENTENCE{SENTENCErec2}[I5:mu5, sig1], 
            I1:mu3, I3:mu4
            ]
      >


   MATCHCONDITIONS
      <
        mu2:ALL
        I1: QUOTE_tempdurnotfound(mu3) AND
            QUOTE_tempretronotfound(mu3) AND
            QUOTE_temprefnotfound(mu3) AND
            ALL(mu3, I11:rel1/..) AND
            NOT EXIST (mu3, [I12:rel2/..])
        I2: SENTENCErec2.temporal = true AND
            SENTENCErec2.conjclass = duration 
        I3: QUOTE_tempdurnotfound(mu4) AND
            NOT EXIST (mu4, [I11:rel1/..]) AND
            NOT EXIST (mu4, [I12:rel2/..])
        I11: QUOTE_Srelprec(rel1, tempadvrel)
        I12: rel2 IN [leftdislocrel]
        I5: NOT EXIST(mu5, [puncrel/..])
      >
<
   SUBRULE
      < >
      <sig1: [puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1}] >


      COMP
         <
          C1:true
          A1:@
         >
      DECOMP
         <
          C1: true
          A1: @
         >
 
   SUBRULE
      < >
      <sig1:[] >


      DECOMP
         <
          C1: true
          A1: @
         >

>

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RTempConjSentMoveToLeft
\item[* relevant examples:] He eats an apple while he is ill$\rightarrow$
                            while he is ill(,) he eats an apple
\item[* language:] (Dutch, English, Spanish) 
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] 
\item[* class:] (name of rule, transformation or filter class)
\item[* date of creation:] 16-OCT-1990
\item[* author:] Lisette Appelo
\item[* copied from:] RTempConjSentMoveToLeft Dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 31/10/90\ \ \ \ \ author: Lisette Appelo\\
Changed topnode from SENTENCe to CLAUSE, because of change of place in control 
expression.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To move a temporal sentence from de base position (tempadvrel)
 to the left (leftdislocrel) and vice versa.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] The comma can be left out 
in analysis, but is always generated.
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
