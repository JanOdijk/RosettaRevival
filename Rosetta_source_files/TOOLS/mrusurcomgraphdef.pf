pragma C_include('mrusurcomdecl.pf');

PACKAGE mrusurcomgraphdef;

WITH mrusurcomdecl;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : SFG 
 *  Description     : creates surfgraph
 *  Parameters      : i: identifies surfgraph
 *  Precondition    : 1<=i<=maxrnr
 *  Postcondition   : Surfgraph "i" is created at surfgraph[i]
 *
 *EMP:::===================================================================*)

 PROCEDURE SFG(i:integer); EXTERNAL;

END {surfgraphdef};
