pragma C_include('interfaces.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE PRINTERF7;
WITH INTERFACES;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : PRINTERF7
 *  Description     : Prints the interface datastructure between LINEARIZER
 *                    and GMORPH on the screen.
 *  Parameters      : ifin: INTERFACES_IfDescr;
 *  Precondition    : ifin should contain a consistent datastructure (cf. 
 *                    INTERFACE7.ENV for a detailed description of the
 *                    interface.
 *  Postcondition   : TRUE
 *  Side Effects    : The datastructure has been printed on the screen.
 *
 *EMP:::===================================================================*)

PROCEDURE PRINTERF7_body(ifin: INTERFACES_IfDescr);
EXTERNAL;



END {PRINTERF7};

