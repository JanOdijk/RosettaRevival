\newpage
\begin{verbatim}
% RULE Radjpresentsuperdeixis
< m1:ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [I1: mu2,
                    head/ADJ{ADJrec1}[mu4],
                    I2: mu3
                   ],
            mu5
           ] 
>

< m :ADJPFORMULA{ADJPFORMULArec2}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [I1: mu2,
                    head/ADJ{ADJrec1}[mu4],
                    I2: mu3
                   ],
            mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [tempadvrel/..])
       I2: NOT EXIST (mu3, [tempadvrel/..])
      >


      COMP
         <
          C1:(ADJPFORMULArec1.tiempo = omegatiempo)

             C11:(ADJPFORMULArec1.supertiempo = omegatiempo)
             A11:ADJPFORMULArec2 := ADJPFORMULArec1;
                 ADJPFORMULArec2.supertiempo := presente;
             
&            C12:(ADJPFORMULArec1.supertiempo = presente) (* geval graag *)
             A12: ADJPFORMULArec2 := ADJPFORMULArec1;
%
          A1: @
         >
      DECOMP
         <
          C1:(ADJPFORMULArec2.tiempo = omegatiempo)
              C11: (ADJPFORMULArec2.supertiempo = presente)
              A11: ADJPFORMULArec1 := ADJPFORMULArec2;
                   ADJPFORMULArec1.supertiempo := omegatiempo;

&             C12: (ADJPFORMULArec2.supertiempo = presente)
              A12: ADJPFORMULArec1 := ADJPFORMULArec2;
%
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RADJpresentsuperdeixis
\item[* relevant examples:] veo (el hombre (enfermo))
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] ADJPPPROPtoADJPFORMULA
\item[* class:] Superdeixis rules
\item[* date of creation:] 23-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] RADJpresentsuperdeixis dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT.
               This rule is for a dependent ADJPFORMULA.
               Temporal adverbials are not allowed.
               The ADJPFORMULA is marked for present superdeixis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: 
the superdeixis value is assigned in analysis during (?) 
desubstitution \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be presentdeixis in the case 
this sentence is a sentence with something like {\em graag} in Dutch.\\

\end{enumerate}
\end{description}

