% RULE RCNspecProperName (* Conjunction of propernouns, in combination with a 
                            plural head noun, not accounted for yet *)
< m1: CN{CNrec1}[head/I1::NOUN{NOUNrec1}[mu1]]

  m2: I2::PROPERNOUN{PROPERNOUNrec1}[mu2]
>

<  m: CN{CNrec1}[head/I1::NOUN{NOUNrec1}[mu1],
                 postmodrel/I2::PROPERNOUN{PROPERNOUNrec1}[mu2]
                ]
>

   MATCHCONDITIONS
      <
       I1: NOUNrec1.numero = singular  
       I2: PROPERNOUNrec1.numero = singular  

      > 

