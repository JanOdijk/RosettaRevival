\newpage
\begin{verbatim}
% TRANSFORMATION TAgreement
< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  subjrel/T1,
                  mu2,
                  rel1/VERB{VERBrec1}[mu6],
                  mu3,
                  predrel/VERBP{VERBPrec1}[mu4],
                  mu5
                ]
>

< m : I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  subjrel/T1,
                  mu2,
                  rel1/VERB{VERBrec2}[mu6],
                  mu3,
                  predrel/VERBP{VERBPrec1}[mu4],
                  mu5
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = finite
      >

<
   SUBRULE (* 1. NPVAR subject *)
      < T1: NPVAR{NPVARrec1} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: VERBrec1 = { numbers : []
                           persons : [] }
          A1: VERBrec2 := VERBrec1;
              VERBrec2 := { numbers : [NPVARrec1.number]
                            persons : [NPVARrec1.person] }
         >
      DECOMP
         <
          C1: VERBrec2 = { numbers NI NPVARrec1.number
                           persons NI NPVARrec1.person }
          A1: VERBrec1 := VERBrec2;
              VERBrec1 := { numbers : []
                            persons : [] }
         >

   SUBRULE (* 2. CNVAR subject *)
      < T1: CNVAR{CNVARrec1} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: VERBrec1 = { numbers : []
                           persons : [] } 
            C11: singular IN CNVARrec1.numbers 
            A11: VERBrec2 := VERBrec1;
                 VERBrec2.numbers := [singular]

            C12: plural IN CNVARrec1.numbers 
            A12: VERBrec2 := VERBrec1;
                 VERBrec2.numbers := [plural]
          A1: VERBrec2.persons := [3]
         >
      DECOMP
         <
          C1: 3 IN VERBrec2.persons
            C11: singular IN CNVARrec1.numbers AND
                 singular IN VERBrec2.numbers
            A11: @
            C12: plural IN CNVARrec1.numbers AND
                 plural IN VERBrec2.numbers
            A12: @
          A1: VERBrec1 := VERBrec2;
              VERBrec1 := { numbers : []
                            persons : [] }
         >

   SUBRULE (* 3. NP subject *)
      < T1: NP{NPrec1}[mu7] >
      < T1: NP{NPrec1}[mu7] >

      COMP
         <
          C1: VERBrec1 = { numbers : []
                           persons : [] }
          A1: VERBrec2 := VERBrec1;
              VERBrec2 := { numbers : [NPrec1.number]
                            persons : [NPrec1.person] }
         >
      DECOMP
         <
          C1: VERBrec2 = { numbers NI NPrec1.number
                           persons NI NPrec1.person }
          A1: VERBrec1 := VERBrec2;
              VERBrec1 := { numbers : []
                            persons : [] }
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TAgreement
\item[* relevant examples:] He does go to the cinema, He will sing a song,\\
He was singing a song, They were selected by the committee, I have danced, 
There are three men in the garden, That he went away so early that surprised me
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_SubjVerbAgr
\item[* date of creation:] 24-MAR-1988 
\item[* author:] margreet sanders
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to let the number and person of the verb that has been moved out 
of the VERBP agree with the number and person of the subject. 
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] one for NPVAR, one 
for CNVAR, one for NP.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed that in the surface parser, the NP over the dummy subject 
{\em there\/} indeed will get the number of the NP following the verb, so that 
there is no need always to set the there-NP to the number singular here.
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION TNoThatDeletion
< m1: CLAUSE{CLAUSErec1}[ I1:mu1,
                          subjrel/T1,
                          mu2
                        ]
>

< m : CLAUSE{CLAUSErec1}[ I1:mu1,
                          subjrel/T1,
                          mu2
                        ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [leftdislocrel/I11::SENTENCE{SENTENCErec1}[mu3]])
           I11: SENTENCErec1.adverbial = false
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
