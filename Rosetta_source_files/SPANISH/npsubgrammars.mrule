% RULE ROPENNPPROPformation
< m1: NPPROP{NPPROPrec1}[mu1]
>

< m : OPENNPPROP{OPENNPPROPrec1}[mu1]
                                
>

      COMP
         <
          C1: NPPROPrec1.PROsubject = true
          A1: OPENNPPROPrec1 := NPPROPrec1;
         >

      DECOMP
         <
          C1: OPENNPPROPrec1.prosubject = true
          A1: NPPROPrec1 := OPENNPPROPrec1;
         >

&

\end{verbatim}
