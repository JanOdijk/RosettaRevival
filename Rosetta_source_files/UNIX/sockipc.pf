pragma c_include ('language.pf' );
pragma c_include ('langdef.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

Package SOCKIPC;

pragma calling_convention (language.C);
pragma routine_aliasing_convention (RosLangDef.Rosetta_C_aliasing_conventions7);



(*MPF:::===================================================================*
 *
 *  Function Name  : SOCKIPC_set_port
 *  Description    : set port nr for socket communication
 *                   is obvious that this function
 *                   is very dependend on the very implementation of the 
 *                   communication
 *  Parameters     : port_nr : actual port nr of communication channel
 *                   id : id of communication (currently: 0 for WIPC, 1 for MB)
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

Procedure SOCKIPC_set_port (port_nr : Integer; id : Integer);
External;


(*MPF:::===================================================================*
 *
 *  Function Name  : SOCKIPC_get_port
 *  Description    : get port nr for socket communication
 *                   is obvious that this function
 *                   is very dependend on the very implementation of the 
 *                   communication
 *  Parameters     : id : id of communication (currently: 0 for WIPC, 1 for MB)
 *  Result         : port_nr : actual port nr of communication channel
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

Function SOCKIPC_get_port (id : integer) : Integer;
External;

pragma calling_convention ();           (* switch off previous settings *)
pragma routine_aliasing_convention ();

END {SOCKIPC};
