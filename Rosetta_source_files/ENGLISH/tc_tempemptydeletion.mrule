\begin{verbatim}
% TRANSFORMATION Ttempadvrelpres
< m1:T1
>

< m :T1
>

<
   SUBRULE

      <T1:SENTENCE{SENTENCErec1}[mu1] >
      <T1:SENTENCE{SENTENCErec1}[mu1] >


   MATCHCONDITIONS
      <
       T1: EXIST(mu1, [I1:rel2/T2])      OR
           SENTENCErec1.deixis = omegadeixis  
       I1: rel2 IN [tempadvrel, shiftrel, leftdislocrel] AND
           (
            (T2.CAT IN [ADVP, PREPP,VARPREPP] 
                                     WITH (T2.REC.class = reference) AND
                                          (T2.REC.retro = false)
            )                                                              OR
            (T2.CAT IN [SENTENCE] WITH (T2.REC.conjclass = reference) AND
                                       (T2.REC.conjretro = false)
            )
           )
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true 
          A1: @
         >

   SUBRULE

      <T1:NP{NPrec1}[mu1] >
      <T1:NP{NPrec1}[mu1] >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true 
          A1: @
         >

   SUBRULE

      <T1:CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >
      <T1:CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true 
          A1: @
         >

>
&
\end{verbatim}
