                       (SENTENCErec2.tiempo = presente) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec2.tiempo = presente) AND
                              (SENTENCErec2.finiteness = finite)
                       A1211: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1212: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1212: SENTENCErec1 := SENTENCErec2;


                 A121: SENTENCErec1.supertiempo := presente;

                 C122:
                      (SENTENCErec2.tiempo = pasado) AND
                      (SENTENCErec2.supertiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )

                       C1221:(SENTENCErec2.tiempo = pasado) AND
                              (SENTENCErec2.finiteness = finite)
                       A1221: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1222: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1222: SENTENCErec1 := SENTENCErec2;

                 A122: SENTENCErec1.supertiempo := pasado;


              A12: @

          A1: @
         >

>
&

\end{verbatim}
