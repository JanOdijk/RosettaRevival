pragma C_Include('limorfdef.pf');
pragma C_Include('string.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE INTERFACE8;
WITH
LIMORFDEF, STRNG;

CONST

(*MPC:::===================================================================*
 *
 *  Constant name  :    INTERFACE8_MAXWORDAMBID
 *  Description    :    Maximum number of ambiguous segmentations for one
 *                      word.
 *
 *EMP:::===================================================================*)

   INTERFACE8_MAXWORDAMBID             = 63;


TYPE

   INTERFACE8_WordAmbIdType   = 0..INTERFACE8_MAXWORDAMBID;

(*MPT:::===================================================================*
 *
 *  Type name      : INTERFACE8_pSeqWords
 *  Description    : 
 *
 *EMP:::===================================================================*)

   INTERFACE8_pSeqWords = ^INTERFACE8_SeqWords;
   INTERFACE8_SeqWords  = RECORD
                         error : BOOLEAN;
                         marker: BOOLEAN;
                         rn,
                         prv,
                         nxt   : INTERFACE8_pSeqWords;
                         wordid: integer;
                         nxtamb: INTERFACE8_pSeqWords;
                         CC    : LIMORFDEF_ContextConds;
                         f     : LIMORFDEF_pPhonInfo;
                         ambid : INTERFACE8_WordAmbidType;
                         nonsucc: SET OF INTERFACE8_WordAmbidType;
                         word  : STRING_String
                      END;



(*MPF:::===================================================================*
 *
 *  Function Name  : INTERFACE8_MakeSeqWords
 *  Description    : 
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION INTERFACE8_MakeSeqWords(w : STRING_String;
                                     n : INTERFACE8_pSeqWords): INTERFACE8_pSeqWords;
EXTERNAL;


END {INTERFACE8};
