pragma C_include('limorfdef.pf');
pragma C_include('listree.pf');
pragma C_include('string.pf');
pragma C_include('interface1.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE ALEX;
WITH LIMORFDEF, LISTREE, STRNG, INTERFACE1;

(*MPF:::===================================================================*
 *
 *  Function Name  : ALEX_ALEXPLUS
 *  Description    : 
 *                   Translates all segment keys in their corresponding S-tree
 *                   In principle the output datastructure is exactly the same
 *                   as the input datastructure except for the keys which are
 *                   replaced by S-trees.
 *  Parameters     : r: set of seqences of rows of segment keys.
 *  Result         : Datastructure containing the translated segmented keys.
 *
 *EMP:::===================================================================*)

FUNCTION ALEX_ALEXplus(r: INTERFACE1_pRowSeqSegmKeys): 
                                  INTERFACE1_pRowSeqSegmKeys; 
EXTERNAL;


END {ALEX};
