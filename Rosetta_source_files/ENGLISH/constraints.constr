: IMPLIES((thetavp IN [vp000, vp100]),(synvps = [synNoVPArgs]) )
  " thetavp= vp000,vp100 requires synvps=[synNoVpargs]"

: IMPLIES((synPREPEMPTY IN synvps), false)
