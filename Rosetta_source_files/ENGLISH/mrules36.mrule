\begin{verbatim}
% RULE Rtempadvsentsubstitution            (* temporal SENTENCE under S 
                                              for VERBP-node *)
< m1: T1 = N1
            [ mu1,
              predrel/I2::N2 [mu3],
              mu2,
              tempadvrel/I1::SENTENCEVAR{SENTENCEVARrec1},
              mu4
            ] 

SUBST:
  m2: SENTENCE{SENTENCErec1}[mu5]
>

< m : T1 = N1
           [ mu1,
             predrel/I2::N2 [mu3],
             mu2,
             tempadvrel/SENTENCE{SENTENCErec1}[mu5],
             mu4
           ] 
>

   MATCHCONDITIONS
      <
       m1 : T1.CAT IN [VERBPPROP, ADJPPROP, ADVPPROP, PREPPPROP, NPPROP]
       m : T1.CAT IN [VERBPPROP, ADJPPROP, ADVPPROP, PREPPPROP, NPPROP] AND
           NOT EXIST(mu2, [I11:../T2]) AND
           NOT EXIST(mu3, [I11:../T2]) AND
           NOT EXIST(mu4, [I11:../T2])
         I11: T2.CAT IN AUX_propvarcats OR
              ( T2.CAT IN [NPVAR] WITH 
                T2.REC.NPhead IN [sentNP, openIngNP] )
       I1 : SENTENCEVARrec1.index = LEVEL
       I2 : N2.CAT IN [VERBP, ADJP, ADVP, PREPP, NP]
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: (SENTENCErec1.temporal = true) AND
              (SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)) AND
              ((SENTENCErec1.conjclass = reference) OR
               ((SENTENCErec1.conjclass = duration) AND
                ((SENTENCErec1.conjaspect = perfective) AND
                 (T1.REC.aktionsarts * [stative, activity] <> [])
                ) OR
                ((SENTENCErec1.conjaspect = imperfective) AND
                 (T1.REC.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCErec1.temporal = true) AND
              ((SENTENCErec1.conjclass = reference) OR
               ((SENTENCErec1.conjclass = duration) AND
                ((SENTENCErec1.conjaspect = perfective) AND
                 (T1.REC.aktionsarts * [stative, activity] <> [])
                ) OR
                ((SENTENCErec1.conjaspect = imperfective) AND
                 (T1.REC.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )

          A1: SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;

         >


&

\end{verbatim}
