PROCEDURAL PART
VAR blockpas,blockenv:LOCALFILE;
    rulename:TSTRING_string;
    parameters::setofidents;
BEGIN 
INIT:BEGIN parameters:=$$INITBLOCK.parameters;
           \blockenv.\LOCAL.
           rulename:=$$INITBLOCK.rulename;
           initlocalfile(blockenv);
           "PROCEDURE " ""rulename"" "_0(VAR rec:"
           ""rulename"" "typ);EXTERNAL;"\\
           \blockpas.\LOCAL.
           initlocalfile(blockpas);
           "PROCEDURE " ""rulename"" "_0(VAR rec:"
           ""rulename"" "typ);"\\
           "BEGIN WITH rec^ DO BEGIN"\\
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
3: <* SEND: BEGIN %%PASCALTOEND.parameters:=parameters END
      !PASCALTOEND.
      RECEIVE: BEGIN appendlocfile(%%PASCALTOEND.copy,blockpas);
               END
   *>
*>
FINAL: BEGIN "END;END;"\\
             $$initblock.blockenv:=blockenv;
             $$initblock.blockpas:=blockpas;
       END
END;
&

%FINALBLOCK
BASIS RULE
  FINALBLOCK = HFINALCAT/2.COLON/1.
               HEKJE/1.CONDITION/1.COLON/1.PASCALTOHEKJE/4.
               ACTION/1.COLON/1.PSTOSTARRIGHT/5
SURFACE PART

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
