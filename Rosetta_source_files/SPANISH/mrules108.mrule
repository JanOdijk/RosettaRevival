\newpage
\begin{verbatim}
% TRANSFORMATION ThaberqueSubjdel (* PRONPVAR deletion hay que *)
< m1:I1::SENTENCE{SENTENCErec1}
           [ I4:mu1,
             subjrel/I2::PRONPVAR{PRONPVARrec1}[],
             I3:mu2,
             cliticrel/CLITIC{}[],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5
           ]
>

< m:I1::SENTENCE{SENTENCErec1}
          [ I4:mu1,
            I3:mu2,
            cliticrel/CLITIC{}[],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
            mu5
          ]
>

   MATCHCONDITIONS
      <
       I1:  SENTENCErec1.finiteness = finite AND
            SENTENCErec1.voice = active
       I2:  (PRONPVARrec1 = AUX_PRONPVARONecBPRSPR EXCEPT FOR [numero, persona,
                                                               genero]) AND
            (PRONPVARrec1.numero = singular)   AND 
            (PRONPVARrec1.persona = 3) AND
            (PRONPVARrec1.genero = masc)
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I6:  ((BVERBrec1.key = KEY_haberque1BVERBkey)  OR
            (BVERBrec1.key = KEY_haberque2BVERBkey))
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;   
              PRONPVARrec1.numero := singular;
              PRONPVARrec1.persona := 3;
              PRONPVARrec1.genero := masc;
         >
&

\end{verbatim}
