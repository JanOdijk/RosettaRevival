(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_InsertInLine
 *  Description     : Inserts Space Characters in the specified window
 *  Parameters      : w       : Windows_Window
 *                    Row     : Windows_RowRange
 *                    Column  : Windows_ColumnRange
 *                    NrChars : Integer
 *  Precondition    : w is opened.
 *  Postcondition   : The specified part of the window is inserted
 *  Side Effects    : Scrolling of the text
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_InsertInLine (VAR w   : Windows_Window;
                                Row     : Windows_RowRange;
                                Column  : Windows_ColumnRange;
                                NrChars : Integer);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_InsertChar
 *  Description     : Inserts Character in the specified window
 *  Parameters      : w       : Windows_Window
 *                    Row     : Windows_RowRange
 *                    Column  : Windows_ColumnRange
 *                    Ch      : CHAR;
 *                    rc, rs  : WINDOWS_VideoAttributeSet;
 *  Precondition    : w is opened.
 *  Postcondition   : The specified part of the window is inserted
 *  Side Effects    : Scrolling of the text
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_InsertChar(VAR w   : Windows_Window;
                             Row     : Windows_RowRange;
                             Column  : Windows_ColumnRange;
                             Ch      : CHAR;
                             rc, rs  : Windows_VideoAttributeSet);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_InsertLines
 *  Description     : inserts empty lines in the specified window
 *  Parameters      : w        : Windows_Window
 *                    StartRow : Windows_RowRange
 *                    NrLines  : Integer
