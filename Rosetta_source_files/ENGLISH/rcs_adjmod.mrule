\begin{verbatim}
% RULE RADJmod1   (* comparison not dependent of `as' :
                  strong as a lion (probably an idiomatic expression), 
                  shy as if he were a child *)

< m1: ADJPPROP{ADJPPROPrec1}                   
                            [mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      head/ADJ{ADJrec1}[mu3],
                                      I2:mu4
                                     ]
                            ] 

  m2: T1
>

< m : ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      head/ADJ{ADJrec1}[mu3],
                                      I2:mu4,
                                      I1:postmodrel/T1
                                     ]
                            ] 
>
   MATCHCONDITIONS
      <I1: T1.cat IN [ASP, SENTENCE]
       m2: T1.cat IN [ASP, SENTENCE]
       I2: NOT EXIST (mu4, [postmodrel/..])
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
