          arguments { 
            arguments cascade_args;
            XmNlabelString = 'Split lemma'; 
          };
          callbacks {
            MrmNcreateCallback = procedure
                XwuCreateWidget (X_le_copy_lemma_button);
            XmNactivateCallback = procedure 
