\newpage
\begin{verbatim}
% RULE RIDCNmodADJP1   
< SUBST:
  m1: CN{CNrec1}[I1:head/NOUN{NOUNrec1}
                           [head/SUBNOUN{SUBNOUNrec1}
                                  [head/BNOUN{BNOUNrec1}]
                           ],
                 mu4
                ]

  m2: OPENADJPPROP{OPENADJPPROPrec1}
                            [subjrel/CNVAR{CNVARrec1},
                             predrel/ADJP{ADJPrec1}[mu2,
                                                    head/ADJ{ADJrec1}[mu3],
                                                    mu12
                                                   ] 
                            ]
>

< m : CN{CNrec1}[I1:head/NOUN{NOUNrec1}
                           [head/SUBNOUN{SUBNOUNrec1}
                                  [head/BNOUN{BNOUNrec1}]
                           ],
                 mu4,
                 postmodrel/ADJP{ADJPrec2}[mu2,
                                       head/ADJ{ADJrec1}[mu3],
                                       mu12
                                      ]
                ]
>

   MATCHCONDITIONS
      <
       I1: BNOUNrec1.nounpatterns * AUX_compoundpatterns <> []
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: (attributive IN ADJPrec1.uses) AND
              (ADJPrec1.posicion IN [postposicion, ambosposicion] ) AND
              (ADJPrec1.numero = CNrec1.numero) AND
              (ADJPrec1.genero IN CNrec1.generos) AND
              (OPENADJPPROPrec1.supertiempo = CNrec1.supertiempo) AND
              (OPENADJPPROPrec1 = COPYT_ADJPtoADJPPROP(ADJPrec1)) AND
              (OPENADJPPROPrec1.PROsubject = true) AND 
              (OPENADJPPROPrec1.aktionsarts = [stative]) AND
              (CNVARrec1 = COPYT_CNtoVAR(CNrec1)) AND
              (CNVARrec1.index = LEVEL)
          A1:  ADJPrec2 := ADJPrec1;
               ADJPrec2.uses := [attributive];
         >

      DECOMP
         <
          C1: attributive IN ADJPrec2.uses AND
              (ADJPrec1.posicion IN [postposicion, ambosposicion] ) AND
              (ADJPrec1.numero = CNrec1.numero) AND
              (ADJPrec1.genero IN CNrec1.generos) 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.uses := [attributive, nominalised];
              OPENADJPPROPrec1 := COPYT_ADJPtoADJPPROP(ADJPrec1);
              OPENADJPPROPrec1.supertiempo := CNrec1.supertiempo;
              OPENADJPPROPrec1.PROsubject := true;
              OPENADJPPROPrec1.aktionsarts := [stative];
              CNVARrec1 := COPYT_CNtoVAR(CNrec1);
              CNVARrec1.index := LEVEL

         >
&

\end{verbatim}
