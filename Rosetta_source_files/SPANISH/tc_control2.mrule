\begin{verbatim}
% TRANSFORMATION TOblControl4b
                       (* OPENNPPROP in prepobjrel, subject control *)
< m1:CLAUSE{CLAUSErec1}      
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu3,
                      I3:prepobjrel/N2
                                [ mu4, 
                                  objrel/OPENNPPROP{OPENNPPROPrec1}
                                        [ subjrel/T2,
                                          I2:rel1/NP{NPrec1}[mu5] 
                                        ],
                                  mu6
                                ],
                      mu7
                    ],
             mu8 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu3,
                      I3:prepobjrel/N2
                                [ mu4, 
                                  objrel/NP{NPrec1}[mu5],
                                  mu6
                                ],
                      mu7
                    ],
             mu8 
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3,[objrel/..])
       I2: rel1 IN [idrel, predrel]
       I3: N2.CAT IN [PREPP, VARPREPP]
      >


<
   SUBRULE (* 1 *)
      <
       T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPOPENNPPROP] <> []) AND
              (NPVARrec1 = NPVARrec2) AND 
              ( OPENNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative] 
		    PROsubject     : true
		   }
              )
              C11: (rel1 = predrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      }
                   )
              A11: @
              C12: (rel1 = idrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      }
                   )
              A12: @
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPOPENNPPROP] <> [])
              C11: true
              A11: OPENNPPROPrec1 :=
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      };
                   rel1 := predrel                  
              C12: true
              A12: OPENNPPROPrec1 :=
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      };
                    rel1 := idrel              
          A1:  CLAUSErec1 := CLAUSErec2;
               CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
                                      [synPREPOPENNPPROP];
               NPVARrec2 := NPVARrec1;
               OPENNPPROPrec1 :=
		   { 
		    PROsubject     : true
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >

   SUBRULE (* 2 *)
      <
       T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPOPENNPPROP] <> []) AND
              (CNVARrec1 = CNVARrec2) AND 
              ( OPENNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative] 
		    PROsubject     : true
		   }
              )
              C11: (rel1 = predrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      }
                   )
              A11: @
              C12: (rel1 = idrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      }
                   )
              A12: @
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synPREPOPENNPPROP] <> [])
              C11: true
              A11: OPENNPPROPrec1 :=
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      };
                   rel1 := predrel                  
              C12: true
              A12: OPENNPPROPrec1 :=
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      };
                    rel1 := idrel              
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
                                      [synPREPOPENNPPROP];
              CNVARrec2 := CNVARrec1;
              OPENNPPROPrec1 :=
		   { 
		    PROsubject     : true
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >
>
