/* Dialog window definitions */

! Exit window

object question_window : XmQuestionDialog {
    arguments {
        XmNdialogTitle          = N_question_window;
	XmNmessageString	= N_question_text;
	XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL;
        XmNnoResize             = true;
        XmNbuttonFontList       = big;
	XmNlabelFontList        = bold;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_question_window);
        XmNokCallback      = procedure XwbAction (X_question_ok_button);
        XmNcancelCallback  = procedure XwbAction (X_question_cancel_button);
    };
};    

! err: error window

object err_window : XmErrorDialog {
    arguments {
        XmNdialogTitle          = N_err_window;
	XmNmessageString	= N_err_text;
	XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL;
        XmNnoResize             = true;
        XmNbuttonFontList       = big;
	XmNlabelFontList        = bold;
        XmNdefaultPosition      = false;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_err_window);
        XmNokCallback      = procedure XwbAction (X_err_ok_button);
    };
};    

! file: dialog to enter a new file-name

object file_window : XmPromptDialog {
    arguments {
        XmNdialogTitle          = N_file_window;
        XmNselectionLabelString = N_file_text;
        XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL;
        XmNnoResize             = true;
        XmNbuttonFontList       = big;
	XmNlabelFontList        = bold;
        XmNdefaultPosition      = false;
        XmNautoUnmanage         = false;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_file_window);
        XmNokCallback      = procedure XwbAction (X_file_ok_button);
        XmNcancelCallback  = procedure XwbAction (X_file_cancel_button);
    };
};

! startup information dialog

object startup_window : XmBulletinBoardDialog {
    arguments {
        XmNdialogTitle          = N_startup_window;
    };
    controls {
        XmLabel startup_label;
    };
};

object startup_label : XmLabel {
    arguments {
        XmNlabelString      = N_startup_text;
    };
};

