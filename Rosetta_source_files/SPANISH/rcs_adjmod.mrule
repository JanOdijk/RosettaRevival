\begin{verbatim}

% RULE RADJDegreemod2a     (* genoeg ... om mee te nemen
                           te weinig ... om voor naar huis te komen *)
            
< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      head/T1,
                                      mu4 
                                     ]
                            ]  
  m2: QP{QPrec1}[head/T3,
                 I1:paramodrel/SENTENCE{SENTENCErec1}[mu5]
                ]
>

< m : ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [mu2,
                                      degreemodrel/QP{QPrec1}[head/T3],
                                      head/T1,
                                      mu4,
                                      I2:paramodrel/SENTENCE{SENTENCErec2}[mu5]
                                     ]
                            ]
>
   MATCHCONDITIONS
      <
       I1: SENTENCErec1.infsort = parainf
       I2: SENTENCErec2.infsort = parainf
      >


      COMP
         <
          C1: SENTENCErec1.supertiempo = omegatiempo
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := QPrec1.mood;  (* m.h.o. op een WH-QP *)
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.supertiempo := QPrec1.supertiempo;

         >
      DECOMP
         <
          C1: SENTENCErec2.supertiempo = QPrec1.supertiempo
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := declxpmood; 
              SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.supertiempo := omegatiempo;         
>

&

\end{verbatim}
