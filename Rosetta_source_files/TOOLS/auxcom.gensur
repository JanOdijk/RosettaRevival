PROCEDURAL PART
VAR catname,varcatname:TSTRING_string;
    attrstruct:TLDCONVREC_pCATattrstruct;
BEGIN
INIT: BEGIN \of3.\GLOBAL.
            " PROCEDURE LDSUBSTTOVAR_copy(t1:LISTREE_pstree;"\\
            "                           VAR t2:LISTREE_pstree;ind:INTEGER);"\\
            "VAR lst1,lst2:LSSTREE_pstree;"\\
            "BEGIN"\\
            "lst1:=loopholes.retype(t1,LSSTREE_pstree);"\\
            "CASE lst1^.cat OF" \\             
      END;
<*
1: <* SEND: BEGIN 
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN catname:=%.str;
                 ""catname"" " : BEGIN" \\
            END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN varcatname:=%.str;
                  \of3.\GLOBAL.
                  "lst2:=MAKET_stree(" ""varcatname"" ");"\\
                  attrstruct:=TLDCONVREC_catattrbs(catname);
                   "lst2^.ls^." ""varcatname"" "field^.index:=ind;"\\
                  WHILE attrstruct<>nil DO
                   BEGIN
                   "lst2^.ls^." ""varcatname"" "field^." 
                               ""attrstruct^.fieldname"" ":="
                   "lst1^.ls^." ""catname"" "field^."
                               ""attrstruct^.fieldname"" ";"\\
                   attrstruct:=attrstruct^.nextattr;
                   END;
                  "END;"\\
            END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN \of3.\GLOBAL.
            "END;"\\
            "t2:=loopholes.retype(lst2,LISTREE_pstree);"\\
            "END;"\\
      END
END;
&

