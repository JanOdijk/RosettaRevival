                 C121: (SENTENCErec2.deixis = presentdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C122: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.superdeixis := presentdeixis;

                  (* dependent clause past *)
