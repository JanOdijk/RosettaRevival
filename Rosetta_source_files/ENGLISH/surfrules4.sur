                           (%SENTENCE.infsort <> fortoinf)
                          )  <= (%SENTENCE.prosubject)
                         )                                         AND
                         (((%SENTENCE.finiteness = finite)   AND
                           (%SENTENCE.conjkey <> 0)
                          )                                       OR
                          ((%SENTENCE.modus = infinitive)    AND
                           (%SENTENCE.infsort IN [toinf, fortoinf])
                          )
                         )
         GLOBAL: #CONDITION: TRUE
                 #ACTION:   BEGIN
                              SYNREL           := leftdislocrel;
                              leftdislocfound  := TRUE;
                              XPinldlfound     := TRUE;
                              Sinldlfound      := TRUE;
                            END
