\newpage
\begin{verbatim}
%
% RULE RLocClosedPrepPPropSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        locargrel/I1::PREPPPROPVAR{PREPPPROPVARrec1},
                        mu3 
                       ],
                mu5
               ]
  
  SUBST:
  m2: CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}[mu4]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        locargrel/CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}[mu4],
                        mu3 
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: PREPPPROPVARrec1.index = LEVEL
       m2: LOC IN CLOSEDPREPPPROPrec1.actsubcefs 
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: PREPPPROPVARrec1 = COPYT_prepppropTOvar(CLOSEDPREPPPROPrec1) 
                                 EXCEPT FOR [actsubcefs]  AND
              PREPPPROPVARrec1.actsubcefs = [loc]
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: PREPPPROPVARrec1 := COPYT_prepppropTOvar(CLOSEDPREPPPROPrec1);
              PREPPPROPVARrec1.index := LEVEL;
              PREPPPROPVARrec1.actsubcefs := [loc]
         >
&

\end{verbatim}
