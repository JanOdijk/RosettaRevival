\newpage
\begin{verbatim}
% RULE RQPSubstitution1

< m1 : QP{QPrec1}[head/Q{Qrec1},
                  I3:rel1/N1
                         [I1:mu1,
                          I2:complrel/NPVAR{NPVARrec1}
                         ]
                    ]
SUBST:
 m2: NP{NPrec1}[mu5]
>

< m : QP{QPrec1}[head/Q{Qrec1},
                 I3:rel1/N1
                        [I1:mu1,
                          complrel/NP{NPrec2}[mu6]
                         ]
                    ]
>

   MATCHCONDITIONS
      <
       I1: EXIST(mu1, [head/..])
       I2: NPVARrec1.index = LEVEL AND
           NPVARrec1.cases <> []
       I3: rel1 IN [decomplrel, thanascomplrel]
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:NPVARrec1 = COPYT_nptovar(NPrec1) 
                            EXCEPT FOR [cases, supertiempo] AND
             NPrec1.cases = [] AND 
             NPrec1.generic = nogeneric AND
             NPrec1.supertiempo = QPrec1.supertiempo
          A1:QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases);
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo  := omegatiempo
              
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []) ;
              NPrec1.generic := nogeneric;
              NPrec1.supertiempo := QPrec1.supertiempo;
         >

&

\end{verbatim}
