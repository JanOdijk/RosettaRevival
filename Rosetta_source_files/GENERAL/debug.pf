(*MPD:::===================================================================*
 *
 *  Rosetta Project
 *
 *  Module Title    : DEBUG
 *  Creation date   :  14-NOV-1986
 *  Author          : J. Rous
 *
 *  Copyright (c) 1986, by Nederlandse Philips Bedrijven BV.
 *
 *  Remarks         : The DEBUG component provides facilities for printing
 *                    trace information on the screen during a Rosetta
 *                    run. The component is meant to be used as follows:
 *                    Before and after each call to a major Rosetta component
 *                    DEBUG_Open and DEBUG_Close resp. are called with the
 *                    correct component id.. Inside the Rosetta components
 *                    each DEBUG_Write.. or DEBUG_Read.. function can be
 *                    used.
 *                    These calls are only effective if they are preceded by
 *                    the procedure call DEBUG_Set(comp. id., TRUE). In that
 *                    case a window is openened on the screen and DEBUG_Write
 *                    causes text to be printed inside the window.
 *
 *EMP:::===================================================================*)

pragma C_Include('globdef.pf');
pragma C_Include('string.pf');
pragma C_Include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)



PACKAGE DEBUG;
WITH GLOBDEF, STRNG, WND;

(*MPC:::===================================================================*
 *
 *  Constant name  : DEBUG_MaxIO
 *  Description    : maximum length of input/output buffer
 *
 *EMP:::===================================================================*)

CONST
   DEBUG_MaxIO = WND_MaxIO;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_Init
 *  Description     : Initializes the DEBUG module
 *  Postcondition   : DEBUG module initialized
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_Init;
EXTERNAL;


(*MPP:::===================================================================*
 *
 *  Procedure Name  : DEBUG_Set
 *  Description     : Enables/disables the debug mode for a particular component
 *  Parameters      : value: boolean 
 *                    level: GLOBDEF_LevelType
 *  Precondition    : DEBUG_Init has been called
 *  Postcondition   : debug[level] = value
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_Set(level: GLOBDEF_LevelType;
                               valeu: BOOLEAN);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_Open
 *  Description     : Opens the debug window for the specified level
 *  Parameters      : level: GLOBDEF_LevelType
 *  Precondition    : DEBUG_Init has been called
 *  Postcondition   : Debug window of level opened if debug[level] = true 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_Open(level: GLOBDEF_leveltype);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_Close
 *  Description     : Closes the debug window for the specified level
 *  Parameters      : level: GLOBDEF_LevelType
 *  Precondition    : DEBUG_Init Debug_Open(level) has been called
 *  Postcondition   : Debug window of level close if debug[level] = true 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_Close(level: GLOBDEF_leveltype);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_WriteStr
 *  Description     : Writes a string to the debug window 
 *  Parameters      : s: PACKED ARRAY[lb..ub:INTEGER] OF CHAR;
 *                    l: WND_IORange;
 *                    w: WND_IORange;
 *                    j: WND_LeftJustify;
 *  Precondition    : DEBUG_Init has been called
 *  Postcondition   : if debug[level] = true and
 *                       DEBUG_Open has been performed for the current level then
 *                       s is written in debug window
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_WriteStr(CONST s : STRING;
                                    l : WND_IORange;
                                    w : WND_IORange;
                                    j : WND_LeftJustify);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_WriteString
 *  Description     : Writes a string to the debug window 
 *  Parameters      : s : STRING_String;
 *                    w : WND_IORange;
 *                    j : WND_LeftJustify;
 *  Precondition    : DEBUG_Init has been called
 *  Postcondition   : if debug[level] = true and
 *                       DEBUG_Open has been performed for the current level then
 *                       s is written in debug window
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_WriteString(s : STRING_String;
                                       w : WND_IORange;
                                       j : WND_LeftJustify);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_WriteInteger
 *  Description     : Writes an integer to the debug window 
 *  Parameters      : i : INTEGER;
 *                    w : WND_IORange;
 *                    j : WND_LeftJustify;
 *  Precondition    : DEBUG_Init has been called
 *  Postcondition   : if debug[level] = true and
 *                       DEBUG_Open has been performed for the current level then
 *                       i is written in debug window
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_WriteInteger(i: INTEGER;
                                        w: WND_IORange;
                                        l: WND_LeftJustify);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DEBUG_WriteLine
 *  Description     : Writes a linefeed to the debug window 
 *  Parameters      : b : BOOLEAN;
 *  Precondition    : DEBUG_Init has been called
 *  Postcondition   : if debug[level] = true and
 *                       DEBUG_Open has been performed for the current level then
 *                       a newline is written in debug window
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DEBUG_WriteLine(b: BOOLEAN);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : DEBUG_Mode
 *  Description    : Returns TRUE if DEBUG is TRUE and if DEBUG_Open has been
 *                   called for the current level
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION DEBUG_Mode: BOOLEAN;
EXTERNAL;

END {DEBUG};
