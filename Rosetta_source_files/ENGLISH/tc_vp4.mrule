\begin{verbatim}
% TRANSFORMATION Tverbpattern13
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                            [ head/VERB{VERBrec1}[mu2],
                              argrel/T1,
                              argrel/T2
                            ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                          [ head/VERB{VERBrec1}[mu2],
                            I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                   [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                     objrel/T1 ],
                            rel1/T2                           
                          ] 
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR
               [headkey, actsubcefs, mood, synppefs, thetapp,
                specQ, class, deixis, aspect, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            deixis     : PREPrec1.deixis
                            aspect     : PREPrec1.aspect
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >

<

   SUBRULE (* 4a. x1 talk to x3 (about EMPTY) *)
      < T1: NPVAR{NPVARrec2} 
        T2: EMPTYVAR{EMPTYVARrec1}>

      < T1: NPVAR{NPVARrec2} 
        T2: EMPTYVAR{EMPTYVARrec1}>

      COMP
         <
          C1: synPREPNP_EMPTY IN VERBrec1.synvps 
          A1: rel1 := prepobjrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_EMPTY]
         >
      DECOMP
         <
          C1: synPREPNP_EMPTY IN VERBrec1.synvps AND
              synPREPNP_EMPTY IN VERBPPROPrec2.synvpefs AND
              rel1 = prepobjrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : NPVARrec2.mood 
                               specQ      : NPVARrec2.specQ
                               thetapp    : pp120 } 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4b. x1 talk to x3 (about EMPTY) *)
      < T1: CNVAR{CNVARrec2} 
        T2: EMPTYVAR{EMPTYVARrec1} >

      < T1: CNVAR{CNVARrec2} 
        T2: EMPTYVAR{EMPTYVARrec1} >


      COMP
         <
          C1: synPREPNP_EMPTY IN VERBrec1.synvps 
          A1: rel1 := prepobjrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_EMPTY]
         >
