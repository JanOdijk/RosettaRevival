\begin{verbatim}
% RULE RNPformation8
< m1:PERSPRO{PERSPROrec1}[mu1]
>

< m :NP{NPrec1}[head/PERSPRO{PERSPROrec1}[mu1]]
>

      COMP
         <
          C1: true
              C11: PERSPROrec1.NPhead <> theyNP
              A11: NPrec1.generic := nogeneric
              C12: PERSPROrec1.NPhead = theyNP
              A12: NPrec1.generic := yesgeneric
          A1: NPrec1 := { req           : [pospol,negpol,omegapol]
                          env           : [pospol,negpol,omegapol]
                          superdeixis   : omegadeixis
                          class         : omegaTimeAdvClass
                          deixis        : omegadeixis
                          aspect        : omegaAspect
                          retro         : false
                          definite      : def
                          person        : PERSPROrec1.person
                          number        : PERSPROrec1.number
                          cases         : []
                          genders       : [PERSPROrec1.gender] 
                          sexes         : []
                          actsubcs      : [othernoun]
                          temporal      : false
                          poss          : false
                          animate       : PERSPROrec1.animate
                          human         : Omegahuman
                          actcomas      : [count]
                          thetanp       : omegathetanp
                          nounpatternefs: []
                          posspred      : true
                          possnietnp    : false
                          mood          : nowh
                          syntquant     : omegaquant
                          NPhead        : PERSPROrec1.NPhead
                          specQ         : yesspec
                         }
         >

      DECOMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1= { req           : [pospol,negpol,omegapol]
                        env           : [pospol,negpol,omegapol]
                        superdeixis   : omegadeixis
                        class         : omegaTimeAdvClass
                        deixis        : omegadeixis
                        aspect        : omegaAspect
                        retro         : false
                        definite      : def
                        person        : PERSPROrec1.person
                        number        : PERSPROrec1.number
                        cases         : []
                        genders       : [PERSPROrec1.gender]
                        sexes         : []
                        actsubcs      : [othernoun]
                        temporal      : false
                        poss          : false
                        animate       : PERSPROrec1.animate
                        human         : Omegahuman
                        thetanp       : omegathetanp
                        nounpatternefs: []
                        posspred      : true
                        possnietnp    : false
                        mood          : nowh
                        syntquant     : omegaquant
                        NPhead        : PERSPROrec1.NPhead
                        specQ         : yesspec
                       }
              C11: PERSPROrec1.NPhead <> theyNP AND
                   NPrec1.generic = nogeneric
              A11: @
              C12: PERSPROrec1.NPhead = theyNP AND
                   NPrec1.generic = yesgeneric
              A12: @
          A1: @
         >

&

\end{verbatim}
