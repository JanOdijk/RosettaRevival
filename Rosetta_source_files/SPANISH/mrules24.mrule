
SPANISH 24
&
The following substitutionrules are planned.
If they exist, between brackets the relevant rule name has been mentioned
followed by a *
 1. NP in S , nongeneric + generic redellos and uno (Rsubstitution1*) 
              (subjrel, postsubjrel, shiftrel)
 2. NP in VP, nongeneric (Rsubstitution2*) ( objrel, predrel)
 3. NP in VARPREPP in VP, nongeneric (Rsubstitution3*)
            (prepobjrel, locargrel, dirargrel, instradvrel, 
              porobjrel, indobjrel, paraobjrel, predrel)
 4. (VAR)PREPP for  PREPPVAR in S , nongeneric (Rsubstitution4*)
            ( locadvrel, causadvrel(*, tempadvrel*))
 4b.(VAR)PREPP for  PREPPVAR in VP , nongeneric (RprepSUBSTvp)
            ( vpadvrel ) (*EP; added 10/07/90*)
 5. ADVP under S (Rsubstitution5*), (locadvrel)
 5a ADVP under S (Rsubstitution5a*), (shiftrel)
 6. sentadvrel/.. (Rsubstitution6*)
 7. PROSENT (Rsubstitution7)
 8. POS (Rsubstitution8*)
 9. NEG (Rsubstitution9*)
10. NP in VARPREPP in S (shiftrel) (Rsubstitution10*)
11. PROSENT for PROSENTVAR.
12. NP with non-modified count EN in S, nongeneric (Rsubstennp1*) 
        (subjrel, shiftrel, postsubjrel)
13. NP with non-modified count EN in VP, nongeneric (Rsubstennp2*) (objrel)
14: Rdeepsubst1
15: Rdeepsubst2
\newpage
\begin{verbatim}
%
% RULE RIdSubstitution1                  (* NP in in VP complsent in VP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      complrel/SENTENCE{SENTENCErec1}
                             [ mu7,
                               predrel/VERBP{VERBPrec2}
                                   [ mu10,
                                     I2:rel1/I1::NPVAR{NPVARrec1},
                                     mu9
                                   ],
                               mu8
                             ],
                      mu3
                    ],
             mu4 
           ] 
SUBST:
  m2: NP{NPrec1}[mu5]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      complrel/SENTENCE{SENTENCErec1}
                             [ mu7,
                               predrel/VERBP{VERBPrec2}
                                   [ mu10,
                                     I2:rel1/NP{NPrec2}[mu6],
                                     mu9
                                   ],
                               mu8
                             ],
                      mu3
                    ],
             mu4 
           ] 
>

   MATCHCONDITIONS
      <
       m1: QUOTE_Gsubstordercondition(mu3,mu8,mu9) AND
           QUOTE_Gsubstordercondition1(mu4)
       m : QUOTE_substordercondition(mu3,mu8,mu9) AND
           QUOTE_substordercondition1(mu4) 
       I1: NPVARrec1.index = LEVEL
       I2: rel1 IN [ objrel, predrel] 
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = []                                    AND
              NPrec1.generic = nogeneric                           AND
              NPVARrec1.human = nohuman  (* only to block unwanted output
                                            in case of yeshuman,
                                            generation only *)
              C11: CLAUSErec1.tiempo = omegatiempo              AND
                   NPrec1.supertiempo = CLAUSErec1.supertiempo
              A11: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo := omegatiempo
              C12: CLAUSErec1.tiempo <> omegatiempo             AND
                   NPrec1.supertiempo = CLAUSErec1.tiempo
              A12: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo := omegatiempo  
          A1: NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric 
              C11: CLAUSErec1.tiempo = omegatiempo AND
                   NPrec2.supertiempo = omegatiempo
              A11: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[]); 
                   NPrec1.supertiempo := CLAUSErec1.supertiempo;
              C12: CLAUSErec1.tiempo <> omegatiempo AND
                   NPrec2.supertiempo = omegatiempo  
              A12: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[]); 
                   NPrec1.supertiempo := CLAUSErec1.tiempo;
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.cases := NPrec2.cases;
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric;
              NPVARrec1.generic := nogeneric;
         >

&

\end{verbatim}

