%RULE RIDDERIV6

<m1: I1::SUBVERB{SUBVERBREC1}[head/BVERB(KEY1){BVERBREC1}]
 m2: T1
 m3: T2
 m4: T3
>

< m:    XPPROPTOCLAUSE/RSENTENCECOMPL{LEVEL:X1 
                                      SUBST:2}
           [VERBPPROPFORMATION/TVERBPATTERN6
             [VERBPPROPFORMATION/RSTARTVPPROP123
                [VERBDERIVATION/RBVERBTOSUB
                   [BLEX/BVERB(KEY2)],
                 BLEX/I2:T1,
                 BLEX/SENTENCEVAR(X1){SENTENCEVARrec1},
                 BLEX/I3:T2
                ]
             ],
            CLAUSETOSENTENCE/RPUNC0
              [CLAUSETOSENTENCE/RMOODOPENINF
                 [CLAUSETOSENTENCE/TPROSTATUS1
                    [XPPROPTOCLAUSE/TCASEASSIGNMENT1
                       [XPPROPTOCLAUSE/TINFINITE
                          [XPPROPTOCLAUSE/RCLAUSEFORMATION1
                             [VERBPPROPFORMATION/(TAKTSTATIVE1 TAKTACTIVITY1
                                                  TAKTACTIVITY2 TAKTACTIVITY3
                                                  TAKTACTIVITY4 TAKTACTIVITY5
                                                  TAKTACTIVITY6
                                                  TAKTACCOMPLISHMENT1
                                                 )
                                [VERBPPROPFORMATION/RACTIVE
                                   [VERBPPROPFORMATION/TVERBPATTERN1
                                      [VERBPPROPFORMATION/RSTARTVPPROP120
                                         [VERBDERIVATION/RBVERBTOSUB
                                            [BLEX/BVERB(KEY3)],
                                          BLEX/I3:T2,
                                          BLEX/I4:T3
                                         ]
                                      ]
                                   ]
                                ]
                             ]
                          ]
                       ]
                    ]
                 ]
              ]
           ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBREC1.thetavp = vp123
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
       I3: T2.CAT IN AUX_VARCATSET 
       m3: T2.CAT IN AUX_VARCATSET 
       I4: T3.CAT IN AUX_VARCATSET 
       m4: T3.CAT IN AUX_VARCATSET 
      >


COMP
 <
   C1: COMPINIDDICT(KEY1, VPID7)
   A1: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID7);
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3>, VPID7)
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID7);
       SUBVERBREC1 := COPYT_btosubverb(BVERBREC1);
 >

&
\end{verbatim}

