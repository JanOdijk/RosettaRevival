\newpage
\begin{verbatim}
%
% TRANSFORMATION TCaseAssignment1
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu4],
                      mu3,
                      I1:objrel/T1,
                      mu5 
                    ],
             mu6 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu4],
                      mu3,
                      I2:objrel/T2,
                      mu5 
                    ],
             mu6 
           ]
>


   MATCHCONDITIONS
      <
       I1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [])
       I2: (T2.CAT IN [NPVAR, CNVAR, NP] WITH T2.REC.cases = [Accusative])
      >


<
   SUBRULE
      <T1: NPVAR{NPVARrec1} >
      <T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: (VERBrec1.caseassigner = true)   AND
              (CLAUSErec1.voice <> passive) AND
              ((VERBrec1.reflexivity = notreflexive) OR
                  ([VERBrec1.thetavp] * [vp010, vp012, vp021] = [] ))
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Accusative]
         >


      DECOMP
         <
          C1: (VERBrec1.caseassigner = true)   AND
              (CLAUSErec1.voice <> passive) AND
              ((VERBrec1.reflexivity = notreflexive) OR
                  ([VERBrec1.thetavp] * [vp010, vp012, vp021] = [] ))
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := []
         >


   SUBRULE
      <T1: CNVAR{CNVARrec1} >
      <T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: (VERBrec1.caseassigner = true)   AND
              (CLAUSErec1.voice <> passive) AND
              ((VERBrec1.reflexivity = notreflexive) OR
                  ([VERBrec1.thetavp] * [vp010, vp012, vp021] = [] ))
                        A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Accusative]
         >


      DECOMP
         <
          C1: (VERBrec1.caseassigner = true)  AND
              (CLAUSErec1.voice <> passive) AND
              ((VERBrec1.reflexivity = notreflexive) OR
                  ([VERBrec1.thetavp] * [vp010, vp012, vp021] = [] ))        
         A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := []
         >


   SUBRULE
      <T1: NP{NPrec1}[mu7] >
      <T2: NP{NPrec2}[mu8] >

      COMP
         <
          C1: (VERBrec1.caseassigner = true)   AND
              (CLAUSErec1.voice <> passive) AND
              ((VERBrec1.reflexivity = notreflexive) OR
                  ([VERBrec1.thetavp] * [vp010, vp012, vp021] = [] ))
          A1: QUOTE_assigncase(NPrec1, mu7, 
                               NPrec2, mu8, [Accusative]
                              )
         >


      DECOMP
         <
          C1: (VERBrec1.caseassigner = true)   AND
              (CLAUSErec1.voice <> passive) AND
              ((VERBrec1.reflexivity = notreflexive) OR
                  ([VERBrec1.thetavp] * [vp010, vp012, vp021] = [] ))
          A1: QUOTE_assigncase(NPrec2, mu8, 
                               NPrec1, mu7, []
                              )
         >
>
&

\end{verbatim}
