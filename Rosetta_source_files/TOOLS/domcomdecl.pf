pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('domcomlangspec.pf');

PACKAGE domcomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     domcomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   domcomDECL_Surfrulemode = (loccond, globcond);
   domcomDECL_psyntcat     = ^domcomLANGSPEC_Category;
   domcomDECL_syntcatset   = SET OF domcomLANGSPEC_Category;
   domcomDECL_nodeid         = HINIT..HFINAL;
   domcomDECL_plonodeid      = ^domcomDECL_lonodeid;
   domcomDECL_lonodeid       = RECORD
   			          next: domcomDECL_plonodeid;
   			          arg : domcomDECL_nodeid
   	 	               END;
   domcomDECL_pSnode       = ^domcomDECL_Snode;
   domcomDECL_pRsnode      = ^domcomDECL_Rsnode;
   domcomDECL_Rsnode       = RECORD
                                sonnumber:domcomDECL_nodeid;
                                node    : domcomDECL_pSnode;
                                brother : domcomDECL_pRsnode
                             END;
   domcomDECL_Snode        = RECORD
                                sonlist : domcomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : domcomLANGSPEC_Category;
                                ldfield : domcomLANGSPEC_FieldDef
                             END;
   domcomDECL_pLostree     = ^domcomDECL_Lostree;
   domcomDECL_Lostree      = RECORD
                                next    : domcomDECL_pLostree;
                                arg     : domcomDECL_pSnode
                             END;
   domcomDECL_pConnectionnode
                           = ^domcomDECL_Connectionnode;
   domcomDECL_pSingleSegmList
                           = ^domcomDECL_SingleSegmList;
   domcomDECL_Connectionnode 
                           = RECORD
                                list    : domcomDECL_pSingleSegmList;
                                next,
                                prev    : domcomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   domcomDECL_SingleSegmList
                           = RECORD
                                next    : domcomDECL_pSingleSegmlist;
                                rn      : domcomDECL_pConnectionnode;
                                stree   : domcomDECL_pSnode
                             END;
   domcomDECL_psurfgraph     = ^domcomDECL_surfgraphtype;
   domcomDECL_psurfgraphnode = ^domcomDECL_surfgraphnode;
   domcomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: domcomDECL_psurfgraphnode
   		               END;
   domcomDECL_plossurfgraphnode 
                             = ^domcomDECL_lossurfgraphnode;
   domcomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : domcomDECL_plossurfgraphnode;
   			       END;
   domcomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  domcomDECL_plossurfgraphnode;
   				   arg  :  domcomDECL_psurfgraphnode
   			       END;
   domcomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: domcomDECL_psurfgraphnode;
   			          n    : domcomDECL_nodeid;
   			          cat  : domcomDECL_psyntcat;
   			          nextnodes: domcomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : domcomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

