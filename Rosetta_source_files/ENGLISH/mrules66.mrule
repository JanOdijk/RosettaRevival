\newpage
\begin{verbatim}
% TRANSFORMATION TNPhop
< m1: NP{NPrec1}[mu1,
                 detrel/DETP{DETPrec1}[head/QP{QPrec1}[head/I1::Q{Qrec1}]],
                 head/CN{CNrec1}[mu2,
                                 head/T1,
                                 mu3],           
                 mu4
                ]
>
< m : NP{NPrec1}[mu1,
                 head/CN{CNrec1}[mu2,
                                 head/T1,
                                 hoprel/QP{QPrec1}[head/I1::Q{Qrec1}],
                                 mu3],           
                 mu4
                ]
>

   MATCHCONDITIONS
      <
       I1: Qrec1.hop = true
      >

      COMP
         <
          C1: DETPrec1 = { possnietnp:        true
                           definite:          QPrec1.definite
                           posspred:          QPrec1.posspred
                           possnumbers:       QPrec1.possnumbers
                           posscomas:         QPrec1.posscomas
                           mood:              QPrec1.mood
                           syntquant:         omegaquant    
                           superdeixis:       QPrec1.superdeixis
                          }
          A1: @
              
         >
      DECOMP
         <
          C1: true
          A1: DETPrec1 := { possnietnp:        true
                            definite:          QPrec1.definite
                            posspred:          QPrec1.posspred
                            possnumbers:       QPrec1.possnumbers
                            posscomas:         QPrec1.posscomas
                            mood:              QPrec1.mood
                            syntquant:         omegaquant    
                            superdeixis:       QPrec1.superdeixis
                          }
         >
&

\end{verbatim}
