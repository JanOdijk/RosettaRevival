(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
pragma C_include('listree.pf');
pragma C_Include('cisam.pf');


PACKAGE LDBLEX;
WITH LISTREE, CISAM;

(*MPT:::===================================================================*
 *
 *  Type name      : LDBLEX_pBLEXStruct
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LDBLEX_pBLEXStruct = ^INTEGER;


(*MPP:::===================================================================*
 *
 *  Procedure Name  : LDBLEX_OpenBLex
 *  Description     : Opens BLEX dictionary for reading
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LDBLEX_OpenBLex;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LDBLEX_OpenBLexWrite
 *  Description     : Opens BLEX dictionary for writing
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LDBLEX_OpenBLexWrite;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LDBLEX_OpenBLexUpdate
 *  Description     : Opens BLEX dictionary for updating
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LDBLEX_OpenBLexUpdate;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LDBLEX_CloseBLex
 *  Description     : Closes BLEX dictionary 
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LDBLEX_CloseBLex;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDBLEX_Read
 *  Description    : Reads one BLEX entry with specified key. And returns
 *                   a basic stree containing the corresponding information.
 *  Parameters     : key: INTEGER
 *  Result         : LISTREE_pStree;
 *
 *EMP:::===================================================================*)

FUNCTION LDBLEX_Read(key: INTEGER): LISTREE_pStree;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDBLEX_ReadDirect
 *  Description    : Reads one BLEX entry with specified key. And returns
 *                   a basic stree containing the corresponding information.
 *                   This procedure does not make use of the hash function
 *                   and is only used by the lexicon editor.
 *  Parameters     : key: INTEGER
 *  Result         : LISTREE_pStree;
 *
 *EMP:::===================================================================*)

FUNCTION LDBLEX_ReadDirect(key  : INTEGER): LISTREE_pStree;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDBLEX_ReadSequential
 *  Description    : Reads the current record of the BLEX file
 *  Parameters     : VAR rec: LSDOMAINT_BLEX_Struct;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LDBLEX_ReadSequential(VAR rec: LDBLEX_pBLEXStruct): BOOLEAN;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDBLEX_WriteSequential
 *  Description    : Reads the current record of the BLEX file
 *  Parameters     : VAR rec: LSDOMAINT_BLEX_Struct;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LDBLEX_WriteSequential(rec: LDBLEX_pBLEXStruct): INTEGER;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDBLEX_Update
 *  Description    : Updates the current record of the BLEX file
 *  Parameters     : rec: LDBLEX_pBLEXStruct;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LDBLEX_Update(rec: LDBLEX_pBLEXStruct): CISAM_StatusType;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDBLEX_Delete
 *  Description    : Deletes the current record of the BLEX file
 *  Parameters     : rec: LDBLEX_pBLEXStruct;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LDBLEX_Delete: CISAM_StatusType;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name : LDBLEX_Release
 *  Description    : Unlocks the current record of the BLEX file
 *  Parameters     : 
 *
 *EMP:::===================================================================*)

PROCEDURE LDBLEX_Release;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name : LDBLEX_Reset
 *  Description    : resets the current record of the BLEX file
 *  Parameters     : 
 *
 *EMP:::===================================================================*)

PROCEDURE LDBLEX_Reset;
EXTERNAL;

END {LDBLEX};
