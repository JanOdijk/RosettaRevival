\newpage
\begin{verbatim}
% TRANSFORMATION TpppPattern0
< m1: PREPPPROP{PREPPPROPrec1}
               [ mu1,
                 predrel/PREPP{PREPPrec1}
                        [ head/PREP{PREPrec1} ]
               ]
>

< m : PREPPPROP{PREPPPROPrec2}
               [ mu1,
                 predrel/PREPP{PREPPrec2}
                        [ head/PREP{PREPrec1} ]
               ]
>

      COMP
         <
          C1: synNoVPargs IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []        AND
              PREPPPROPrec1.synppefs = []    
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synNoVPargs];
              PREPPPROPrec2 := PREPPPROPrec1;
              PREPPPROPrec2.synppefs := [synNoVPargs]
         >
      DECOMP
         <
          C1: synNoVPargs IN PREPrec1.synpps AND
              synNoVPargs IN PREPPrec2.synppefs AND
              synNoVPargs IN PREPPPROPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
              PREPPPROPrec1 := PREPPPROPrec2;
              PREPPPROPrec1.synppefs := []
         >

&

\end{verbatim}
