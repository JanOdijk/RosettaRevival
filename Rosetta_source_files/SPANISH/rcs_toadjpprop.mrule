% RULE RADJSubstitution3
< m1: ADJPFORMULA{ADJPFORMULArec1}
                 [mu1,
                  I1:rel1/I2::NPVAR{NPVARrec1},
                  mu2,
                  predrel/ADJP{ADJPrec1}[mu3],
                  mu4
                 ] 
SUBST:
  m2: NP{NPrec1}[mu5]
>

< m : ADJPFORMULA{ADJPFORMULArec1}
                 [mu1,
                  I1:rel1/NP{NPrec2}[mu6],
                  mu2,
                  predrel/ADJP{ADJPrec1}[mu3],
                  mu4
                 ] 

>

   MATCHCONDITIONS
      <m1: (* substordercondition(mu2, mu3, mu4 *) true
       m : (* substordercondition(mu2, mu3, mu4*) true
       I2: NPVARrec1.index = LEVEL
       I1: rel1 IN [subjrel, preadvrel]
       
      >
   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
             NPrec1.cases = [] AND
             NPrec1.generic = nogeneric
              C11: ADJPFORMULArec1.tiempo  = omegatiempo               AND
                   NPrec1.supertiempo  = ADJPFORMULArec1.supertiempo 
              A11: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo  := omegatiempo 
              C12: ADJPFORMULArec1.tiempo  <> omegatiempo              AND
                   NPrec1.supertiempo  = ADJPFORMULArec1.tiempo 
              A12: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo  := omegatiempo   
          A1:NPrec2.generic := omegageneric

         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric 
              C11: ADJPFORMULArec1.tiempo  = omegatiempo  AND
                   NPrec2.supertiempo  = omegatiempo 
              A11: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[Nominative]); 
                   NPrec1.supertiempo  := ADJPFORMULArec1.supertiempo ;
              C12: ADJPFORMULArec1.tiempo  <> omegatiempo  AND
                   NPrec2.supertiempo  = omegatiempo   
              A12: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[Nominative]); 
                   NPrec1.supertiempo  := ADJPFORMULArec1.tiempo ;
          A1:NPVARrec1 := COPYT_nptovar(NPrec2);
             NPVARrec1.index := LEVEL;
             NPrec1.generic := nogeneric
         >


&

\end{verbatim}
