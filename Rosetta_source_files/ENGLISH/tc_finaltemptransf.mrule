\newpage
\begin{verbatim}
% TRANSFORMATION Taspectneutralization3
< m1:PREPP{PREPPrec1}
           [mu3,
            objrel/NP{NPrec1}
                  [head/SENTENCE{SENTENCErec1}[mu1]]
           ] 
>

< m :PREPP{PREPPrec2}
           [mu3,
            objrel/NP{NPrec2}
                   [head/SENTENCE{SENTENCErec2}[mu1]]
           ]
>
<
    SUBRULE (* perfective and imperfective *)
      <mu1: [mu2] >
      <mu1: [mu2] >

      COMP
         <
          C1: ((NPrec1.aspect = imperfective) AND
               (PREPPrec1.aspect = imperfective) AND
               (SENTENCErec1.aspect = imperfective)
              ) OR
              ((NPrec1.aspect = perfective) AND
               (PREPPrec1.aspect = perfective) AND
               (SENTENCErec1.aspect = perfective)
              )
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.aspect := omegaaspect;
              NPrec2 := NPrec1;
              NPrec2.aspect := omegaaspect;
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.aspect := omegaaspect;
         >

      DECOMP
         <
          C1: PREPPrec2.aspect = omegaaspect AND
              NPrec2.aspect = omegaaspect AND
              SENTENCErec2.aspect = omegaaspect
             C11: true
             A11: PREPPrec1 := PREPPrec2;
                  PREPPrec1.aspect := perfective;
                  NPrec1 := NPrec2;
                  NPrec1.aspect := perfective;
                  SENTENCErec1 := SENTENCErec2;
                  SENTENCErec1.aspect := perfective;
             C12: true
             A12: PREPPrec1 := PREPPrec2;
                  PREPPrec1.aspect := imperfective;
                  NPrec1 := NPrec2;
                  NPrec1.aspect := imperfective;
                  SENTENCErec1 := SENTENCErec2;
                  SENTENCErec1.aspect := imperfective;
          A1: @
         >

    SUBRULE (* habitual *)
      <mu1: [I1: mu2] >
      <mu1: [I1: mu2] >
   MATCHCONDITIONS
      <
       I1: NOT QUOTE_tempfreqnotfound(mu2)
      >


      COMP
         <
          C1: (PREPPrec1.aspect = habitual) AND
              (NPrec1.aspect = habitual) AND
              (SENTENCErec1.aspect = habitual)
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.aspect := omegaaspect;
              NPrec2 := NPrec1;
              NPrec2.aspect := omegaaspect;
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.aspect := habitual;

         >

      DECOMP
         <
          C1: PREPPrec2.aspect = omegaaspect AND
              NPrec2.aspect = omegaaspect AND
              SENTENCErec2.aspect = omegaaspect
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.aspect := habitual;
              NPrec1 := NPrec2;
              NPrec1.aspect := habitual;
              SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.aspect := habitual;

         >
>
&

\end{verbatim}
