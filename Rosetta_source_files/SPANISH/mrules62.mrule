\begin{verbatim}

 RULE RSTARTADJPPROP123       (* no spanish examples *)

< m1: SUBADJ{SUBADJrec1}[mu1] 
  m2: T1
  m3: T2
  m4: T3
>

< m : I3::ADJPPROP{ADJPPROPrec1}
                           [I2:subjrel/T1,
                            predrel/I7::ADJP{ADJPrec1}
                                    [I5:argrel/T2,
                                     I6:argrel/T3,
                                     head/I8::ADJ{ADJrec1}
                                          [head/SUBADJ{SUBADJrec1}[mu1]]
                                    ]
                          ]
>

   MATCHCONDITIONS
      <
       m1: SUBADJrec1.thetaadj = adjp123 
       m2: T1.cat IN AUX_VARCATSET
       I2: T1.cat IN AUX_VARCATSET
       m3: T2.cat IN AUX_VARCATSET
       I5: T2.cat IN AUX_VARCATSET
       m4: T3.cat IN AUX_VARCATSET
       I6: T3.cat IN AUX_VARCATSET
       I3: ADJPPROPrec1 = ADJPPROPRECDEF EXCEPT FOR [thetaadj, actsubcefs,
                             temporal, class, tiempo, aspecto, retro] AND
           ADJPPROPrec1.thetaadj =adjp123
       I7: ADJPrec1 = ADJPRECDEF EXCEPT FOR [thetaadj, actsubcefs,
                             temporal, class, tiempo, aspecto, retro]
           ADJPrec1.thetaadj =adjp123
       I8: true

      >


      COMP
         <
          C1: true
          A1: ADJrec1 := COPYT_subadjtoadj(SUBADJrec1);
              ADJPrec1 := COPYT_adjtoadjp(ADJrec1);
              ADJPrec1.actsubcefs := ADJrec1.subcs;
              ADJPPROPrec1 := COPYT_adjptoadjpprop(ADJPrec1)

          >
      DECOMP
         <
          C1: (ADJrec1 = COPYT_subadjtoadj(SUBADJrec1)) AND
              (ADJPrec1 = COPYT_adjtoadjp(ADJrec1)) AND
              (ADJPrec1.actsubcefs = ADJrec1.subcs ) AND
              (ADJPPROPrec1 = COPYT_adjptoadjpprop(ADJPrec1)) 
          A1: @
         >


&

\end{verbatim}
