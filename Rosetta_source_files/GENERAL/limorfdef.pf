(*MPD:::===================================================================*
 *
 *  Rosetta Project                                                 
 *                                                                  
 *  Module Title    : LIMORFDEF
 *  Creation date   :                                               
 *  Author          :                                               
 *                                                                  
 *  Copyright (c) 1985, by Nederlandse Philips Bedrijven BV.        
 *                                                                  
 *  Remarks         :  This module defines some types that have language
 *                     specific counterparts, which are only used within
 *                     the morphological components. 
 *                     The types defined here are completely
 *                     language independent. The language specific counterparts
 *                     can be found in the module LSMORFDEF for each language.
 *                     If information is passed from language specific modules
 *                     to language independent modules a CAST operation 
 *                     transforms the LS-types into the LI-types. In order
 *                     to guarantee that can be done without any problems, we
 *                     only allow it for pointers and enumeration types.
 *                     The LI counterpart of a LS pointertype will be a pointer
 *                     to integer. For each enumeration type a fixed number
 *                     of constants must be present, e.g. both 
 *                     LIMORFDEF_ContextConds
 *                     and LIMORFDEF_ContextConds must contain the same number of
 *                     constants.
 *
 *EMP:::===================================================================*)


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LIMORFDEF;


(*MPC:::===================================================================*
 *
 *  Constant name  : LIMORFDEF_MaxSplitFactor
 *  Description    : Defines the maximum -arity of the GLUE rules
 *
 *EMP:::===================================================================*)

CONST
   LIMORFDEF_MaxSplitFactor = 4;


(*MPC:::===================================================================*
 *
 *  Constant name  : LIMORFDEF_MaxLayoutFactor
 *  Description    : Defines the maximum -arity of the word layout rules
 *
 *EMP:::===================================================================*)

CONST
   LIMORFDEF_MaxLayoutFactor = 2;


TYPE

(*MPT:::===================================================================*
 *  WATCH OUT!!!
 *  Type name      : LIMORFDEF_contextconds
 *  Description    : Defines the language independent context conditions
 *                   Module LSMORFDEF of each language should contain a
 *                   definition of LSMORFDEF_ContextConds, which must also be
 *                   an enumeration type containing 81 values.
 *
 *EMP:::===================================================================*)   

   LIMORFDEF_ContextConds = 
           (LICC0,
            LICC1,LICC2,LICC3,LICC4,LICC5,LICC6,LICC7,LICC8,LICC9,LICC10,
            LICC11,LICC12,LICC13,LICC14,LICC15,LICC16,LICC17,LICC18,LICC19,LICC20,
            LICC21,LICC22,LICC23,LICC24,LICC25,LICC26,LICC27,LICC28,LICC29,LICC30,
            LICC31,LICC32,LICC33,LICC34,LICC35,LICC36,LICC37,LICC38,LICC39,LICC40,
            LICC41,LICC42,LICC43,LICC44,LICC45,LICC46,LICC47,LICC48,LICC49,LICC50,
            LICC51,LICC52,LICC53,LICC54,LICC55,LICC56,LICC57,LICC58,LICC59,LICC60,
            LICC61,LICC62,LICC63,LICC64,LICC65,LICC66,LICC67,LICC68,LICC69,LICC70,
            LICC71,LICC72,LICC73,LICC74,LICC75,LICC76,LICC77,LICC78,LICC79,LICC80 );


(*MPT:::===================================================================*
 *  WATCH OUT!!!
 *  Type name      : LIMORFDEF_PhonMarker
 *  Description    : Defines the (language independent) phonetic conditions
 *                   type between a node in the S-tree and its sons.
 *                   Module LSMORFDEF of each language should contain a
 *                   definition of LSMORFDEF_PhonMarker, which must also be
 *                   an enumeration type containing 81 values.
 *
 *EMP:::===================================================================*)   

   LIMORFDEF_PhonMarker = 
           (LIFON0,
            LIFON1,LIFON2,LIFON3,LIFON4,LIFON5,LIFON6,LIFON7,LIFON8,LIFON9,LIFON10,
            LIFON11,LIFON12,LIFON13,LIFON14,LIFON15,LIFON16,LIFON17,LIFON18,LIFON19,LIFON20,
            LIFON21,LIFON22,LIFON23,LIFON24,LIFON25,LIFON26,LIFON27,LIFON28,LIFON29,LIFON30,
            LIFON31,LIFON32,LIFON33,LIFON34,LIFON35,LIFON36,LIFON37,LIFON38,LIFON39,LIFON40,
            LIFON41,LIFON42,LIFON43,LIFON44,LIFON45,LIFON46,LIFON47,LIFON48,LIFON49,LIFON50,
            LIFON51,LIFON52,LIFON53,LIFON54,LIFON55,LIFON56,LIFON57,LIFON58,LIFON59,LIFON60,
            LIFON61,LIFON62,LIFON63,LIFON64,LIFON65,LIFON66,LIFON67,LIFON68,LIFON69,LIFON70,
            LIFON71,LIFON72,LIFON73,LIFON74,LIFON75,LIFON76,LIFON77,LIFON78,LIFON79,LIFON80 );



(*MPT:::===================================================================*
 *
 *  Type name      : LIMORFDEF_pPhonInfo
 *  Description    : Language independent counterpart of LSMORFDEF_pPhonInfo.
 *                   Is a pointer to a record that contains phonetical info.
 *
 *EMP:::===================================================================*)

TYPE
   LIMORFDEF_pPhonInfo = ^integer;


   
END {LIMORFDEF};
