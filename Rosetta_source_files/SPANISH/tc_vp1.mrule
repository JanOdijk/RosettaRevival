*)


   (* x1 lamenta [el que tenga que partir] (vp120) *)
   
   SUBRULE (*16*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synELQUESENTsubj IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Subjuntivo
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                 adverbial   : false
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synELQUESENTsubj];
              rel1 := complrel
         >


  (* x1 huela bien (vp120) *)

  SUBRULE (*17*)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synOPENADVPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENADVPPROP];
              rel1 := complrel
         >


   (* x1 dijo [que ven\'{\i}a] (vp120) *)

   SUBRULE (*18*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synQUESENTind IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Indicativo
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                 adverbial   : false
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synQUESENTind];
              rel1 := complrel
         >


   (* x1 quiere [que x2 venga] (vp120) *)


   SUBRULE (*18'*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synQUESENTsubj IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Subjuntivo
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                 adverbial   : false
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synQUESENTsubj];
              rel1 := complrel
         >


   (* x1 sabe [si puede venir]; x1 sabe [qu\'{e} debe hacer] (vp120) *)

   SUBRULE (*19*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synQSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative) AND
              SENTENCEVARrec1.modo = Indicativo
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synQSENT];
              rel1 := complrel
         >


   (* Yo me {\em lo} pregunto (vp120) *)

   SUBRULE (*22*) 
      <T1: PROSENTVAR{PROSENTVARrec1} >
      <T1: PROSENTVAR{PROSENTVARrec1} >

      COMP
         <
          C1: synPROSENT IN VERBrec1.synvps AND              
              VERBPPROPrec1.synvpefs = [] AND
              PROSENTVARrec1.quesi = omegaprosent
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPROSENT];
              rel1 := complrel
         >


   (* llevar [x1 trabajando por tres horas]  vp010 *)

   SUBRULE (*23*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synOPENGERSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1.senttype = subordinateclause AND
              SENTENCEVARrec1.mood = declarative AND
              SENTENCEVARrec1.modo = Gerundio
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENGERSENT];
              rel1 := complrel
         >


   (* caer [esto en desuso] (vp010) *)

   SUBRULE (*24a1*)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * [loc,dir] = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHERCLOSEDPREPPPROP];
              rel1 := complrel
         >

   SUBRULE (*24a2*)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synOTHEROPENPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * [loc,dir] = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHEROPENPREPPPROP];
              rel1 := complrel
         >


   (* caer [esto ADVP] ?? no example found yet. *)

   SUBRULE (*24b1*)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.PROsubject = false AND
              ADVPPROPVARrec1.actsubcefs * [locadv,DirAdv] = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHERCLOSEDPREPPPROP];
              rel1 := complrel
         >

   SUBRULE (*24b2*)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synOTHEROPENPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.PROsubject = false AND
