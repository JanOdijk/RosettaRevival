    XmScrolledText  le_attr_list;
  };
};

object le_attr_text : XmLabel {
  arguments {
  XmNtopAttachment  = XmATTACH_FORM;
  XmNleftAttachment   = XmATTACH_FORM;

    arguments label_args;
    XmNlabelString = 'Attributes:';
  };
};

object le_attr_list : XmScrolledText {
  arguments {
  XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmLabel le_attr_text;
  XmNleftAttachment   = XmATTACH_FORM;
  XmNrightAttachment  = XmATTACH_FORM;

    arguments text_args;
/*    XmNsensitive  = false; becomes always insensitive! */
  XmNeditMode     = XmMULTI_LINE_EDIT;
    XmNscrollHorizontal = false;
  XmNcolumns      = 80;
  XmNrows       = 17; 
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget (X_le_attr_list);
  };
};


