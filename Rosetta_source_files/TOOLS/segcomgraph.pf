pragma C_include('segcomlangspec.pf');
pragma C_include('segcomdecl.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE SEGCOMGRAPH;
WITH SEGCOMDECL, SEGCOMLANGSPEC;

     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: SEGCOMLANGSPEC_Category;
                          b: SEGCOMDECL_nodeid): SEGCOMDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: SEGCOMDECL_psurfgraph): SEGCOMDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: SEGCOMDECL_psurfgraph): SEGCOMDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: SEGCOMDECL_psurfgraph): SEGCOMDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: SEGCOMDECL_psurfgraph): SEGCOMDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: SEGCOMLANGSPEC_Category; 
                          c: SEGCOMDECL_psurfgraph); EXTERNAL;
END {SEGCOMGRAPH};
