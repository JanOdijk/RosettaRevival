/* env_: options environment dialog window */

object env_window : XmFormDialog {
    arguments {
	arguments form_dialog_args;
        XmNdialogTitle	= N_env_window;
        XmNnoResize    = true;
    };
    controls {
        XmSeparator env_separator;
        XmRowColumn env_button_box;
	XmForm      env_lang_form;
	XmSeparator env_separator1;
	XmForm      env_lex_form;
	XmSeparator env_separator2;
	XmForm      env_prog_form;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_env_window);
    };
};

object env_lex_form : XmForm {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_WIDGET;
	XmNleftWidget        = XmSeparator env_separator1;
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmSeparator env_separator;

        arguments form_args;
    };
    controls {
	XmLabel    env_lex_label;
	XmLabel    env_anal_label1;
	XmLabel    env_gen_label1;
	XmRadioBox env_alex_box;
	XmRadioBox env_glex_box;
    };
};

object env_prog_form : XmForm {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_WIDGET;
	XmNleftWidget        = XmSeparator env_separator2;
        XmNrightAttachment   = XmATTACH_FORM;
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmSeparator env_separator;

	arguments form_args;
    };
    controls {
	XmLabel    env_prog_label;
	XmLabel    env_anal_label2;
	XmLabel    env_gen_label2;
	XmRadioBox env_aprog_box;
	XmRadioBox env_gprog_box;
    };
};

object env_lang_form : XmForm {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_FORM;
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmSeparator env_separator;

	arguments form_args;
    };
    controls {
	XmLabel    env_lang_label;
	XmLabel    env_anal_label3;
	XmLabel    env_gen_label3;
	XmRadioBox env_alang_box;
	XmRadioBox env_glang_box;
    };
};

object env_separator : XmSeparator {
    arguments {
        XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn env_button_box;

        XmNleftOffset       = 0;
        XmNrightOffset      = 0;
        XmNmargin           = 0;
    };
};

object env_button_box : XmRowColumn {
    arguments {
        XmNleftAttachment   = XmATTACH_FORM;
	XmNbottomAttachment = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_env_ok_button;
	    };
	    callbacks {
		XmNactivateCallback = procedure 
		    XwuUnmanageWidget (X_env_window);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_env_reset_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_env_reset_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_env_reset_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_env_help_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_env_help_button);
		XmNactivateCallback = procedure XwhAction (X_env_help_button);
	    };
	};
    };
};

object env_lex_label : XmLabel {
    arguments {
        XmNlabelString      = N_env_lex_title;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNleftAttachment   = XmATTACH_FORM;
        XmNrightAttachment  = XmATTACH_FORM;
        XmNfontList         = bigbold;
    };
};

object env_anal_label1 : XmLabel {
    arguments {
        XmNlabelString      = N_env_anal_title;
        XmNtopAttachment    = XmATTACH_WIDGET;
	XmNtopWidget        = XmLabel env_lex_label;
        XmNleftAttachment   = XmATTACH_FORM;
        XmNfontList         = big;
    };
};

object env_gen_label1 : XmLabel {
    arguments {
        XmNlabelString      = N_env_gen_title;
        XmNtopAttachment    = XmATTACH_WIDGET;
	XmNtopWidget        = XmLabel env_lex_label;
	XmNleftAttachment   = XmATTACH_WIDGET;
	XmNleftWidget       = XmLabel env_anal_label1;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNfontList         = big;
    };
};

object env_alex_box : XmRadioBox {
    arguments {
        XmNtopAttachment    = XmATTACH_WIDGET;
	XmNtopWidget        = XmLabel env_anal_label1;
        XmNleftAttachment   = XmATTACH_FORM;
    };
    controls {
        XmToggleButton  env_alex1_toggle;
        XmToggleButton  env_alex2_toggle;
    };
};

object env_alex1_toggle : XmToggleButton {
    arguments {
        arguments toggle_args;
	XmNlabelString	= N_env_lex1_title;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_env_alex1_toggle);
    };
};

