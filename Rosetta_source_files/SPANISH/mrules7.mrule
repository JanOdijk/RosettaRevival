\newpage
\begin{verbatim}
% RULE Rmonthyear

< m1: NP{NPrec1}
         [ 
           head/PROPERNOUN{PROPERNOUNrec1}[mu2]
         ]
          
  m2: NP{NPrec2}[mu3]
>

< m : NP{NPrec1}
         [ 
           head/PROPERNOUN{PROPERNOUNrec1}[mu2],
           postmodrel/PREPP{PREPPrec1}
                            [
                              head/PREP(KEY_deprepkey){PREPrec1},
                              postmodrel/NP{NPrec3}[mu3]
                            ] 
         ]
                  
>
   

      COMP
         <
          C1: PROPERNOUNrec1.subc = monthnoun  AND
              NPrec2.NPhead = cardnp           AND
              NPrec2.supertiempo = NPrec1.supertiempo
          
          A1: NPrec3 := NPrec2;
              NPrec3.supertiempo:= omegatiempo;
              NPrec3.generic := omegageneric;
              NPrec3.cases := [accusative];
              PREPPrec1 := { 
                              req : [pospol,negpol,omegapol]
                              env : [pospol,negpol,omegapol]
                              mood : NPrec3.mood
                              actsubcefs : PREPrec1.subcs
                              synppefs : [synNP]
                              thetapp : pp120
                              headkey : PREPrec1.key
                              class : PREPrec1.class
                              tiempo : PREPrec1.tiempo
                              aspecto : PREPrec1.aspecto
                              retro : PREPrec1.retro
                              supertiempo : omegatiempo
                              SpecQ : NPrec3.SpecQ
                            }

         >
          
      DECOMP
         <
          C1: PROPERNOUNrec1.subc = monthnoun  AND
              NPrec3.supertiempo = omegatiempo AND
              NPrec3.generic = omegageneric AND
              NPrec3.cases = [accusative] AND
              PREPPrec1 = { 
                              req : [pospol,negpol,omegapol]
                              env : [pospol,negpol,omegapol]
                              mood : NPrec3.mood
                              actsubcefs : PREPrec1.subcs
                              synppefs   NI synNP
                              thetapp : pp120
                              headkey : PREPrec1.key
                              class : PREPrec1.class
                              tiempo : PREPrec1.tiempo
                              aspecto : PREPrec1.aspecto
                              retro : PREPrec1.retro
                              supertiempo : omegatiempo
                              SpecQ : NPrec3.SpecQ
                            }


          A1: NPrec2 := NPrec3; 
                      (*  EXCEPT FOR [supertiempo,generic,cases]; *)
              NPrec2.supertiempo := NPrec1.supertiempo;
              NPrec2.generic := nogeneric;
              NPrec2.cases := []
         >

&

\end{verbatim}
