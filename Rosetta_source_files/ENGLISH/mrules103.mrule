\newpage
\begin{verbatim}
% TRANSFORMATION Tprogbetobe2
< m1:SENTENCE{SENTENCErec1}
            [ I1:mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       head/VERB{VERBrec1}
                                 [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(KEY_progbeBVERBkey){BVERBrec1}]
                                 ],
                       complrel/SENTENCE{SENTENCErec2}
                               [predrel/VERBP{VERBPrec2}[mu3] ]
                     ],
              mu6
            ]
               
>

< m :SENTENCE{SENTENCErec1'}
            [ I1:mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       progauxrel/VERB{VERBrec2}
                                 [head/SUBVERB{SUBVERBrec2}
                                   [head/BVERB(KEY_beBVERBkey){BVERBrec2}]
                                 ],
                       mu3
                     ],
              mu6
            ]
     
     
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[auxrel/I11::VERB{VERBrec3}[mu7]])
           I11: VERBrec3.subc = modalverb
      >



      COMP
         <
          C1: VERBrec1 = COPYT_SUBVERBtoVERB(SUBVERBrec1) AND
              SUBVERBrec1 = COPYT_BVERBtoSUBVERB(BVERBrec1) AND
              SENTENCErec2.aktionsarts * [achievement] = [] AND
              SENTENCErec2.aktionsarts <> [stative] AND
              SENTENCErec2 =
                 {
                   mood:              declarative
                   senttype:          subordinateclause
                   superdeixis:       omegadeixis
                   PROsubject:        false
                   modus:             ingform
                   aspect:            omegaaspect
                   deixis:            omegadeixis 
                   retro:             false
                   finiteness:        infinite
                   infsort:           accing
                   conjkey:           0
                   adverbial:         false 
                   temporal:          false
                   conjclass:         omegatimeadvclass
                   conjdeixis:        omegadeixis 
                   conjaspect:        omegaaspect 
                   conjretro:         false       
                   coord:             nocoord     
                 }                                         AND
              SENTENCErec1 =
                 {
                   voice:             active
                   synvpefs:          [synCLOSEDGERUND]
                   thetavp:           vp010
                   adjuncts:          []
                   aktionsarts:       [stative]
                 }       
          A1: SUBVERBrec2 := COPYT_BVERBtoSUBVERB(BVERBrec2);
              VERBrec2    := COPYT_SUBVERBtoVERB(SUBVERBrec2);
              SUBVERBrec2.affix := SUBVERBrec1.affix;
              VERBrec2    :=
                 {
                  modus     : VERBrec1.modus
                  tense     : VERBrec1.tense
                  persons   : VERBrec1.persons
                  numbers   : VERBrec1.numbers
                 };
              SENTENCErec1' := SENTENCErec1;
              SENTENCErec1' := 
                 {
                   voice:             SENTENCErec2.voice
                   synvpefs:          SENTENCErec2.synvpefs
                   thetavp:           SENTENCErec2.thetavp
                   adjuncts:          SENTENCErec2.adjuncts
                   aktionsarts:       SENTENCErec2.aktionsarts
                 };
         >
      DECOMP
         <
          C1: SUBVERBrec2 = COPYT_BVERBtoSUBVERB(BVERBrec2) AND
              VERBrec2    = COPYT_SUBVERBtoVERB(SUBVERBrec2) AND
              SENTENCErec1'.aktionsarts * [achievement] = [] AND
              SENTENCErec1'.aktionsarts <> [stative]
          A1: WBONUS -1
              SUBVERBrec1 := COPYT_BVERBtoSUBVERB(BVERBrec1);   
              VERBrec1    := COPYT_SUBVERBtoVERB(SUBVERBrec1);
              SUBVERBrec1.affix := SUBVERBrec2.affix;
              VERBrec1    :=
                 {
                  modus     : VERBrec2.modus
                  tense     : VERBrec2.tense
                  persons   : VERBrec2.persons
                  numbers   : VERBrec2.numbers
                 };
              SENTENCErec2 :=
                 {
                   mood:              declarative
                   senttype:          subordinateclause
                   PROsubject:        false
                   superdeixis:       omegadeixis
                   modus:             ingform
                   aspect:            omegaaspect
                   deixis:            omegadeixis 
                   retro:             false
                   finiteness:        infinite
                   infsort:           accing
                   conjkey:           0
                   adverbial:         false 
                   temporal:          false
                   conjclass:         omegatimeadvclass
                   conjdeixis:        omegadeixis 
                   conjaspect:        omegaaspect 
                   conjretro:         false       
                   coord:             nocoord     
                 };                                         
              SENTENCErec2 := 
                 {
                   voice:             SENTENCErec1'.voice
                   synvpefs:          SENTENCErec1'.synvpefs
                   thetavp:           SENTENCErec1'.thetavp
                   adjuncts:          SENTENCErec1'.adjuncts
                   aktionsarts:       SENTENCErec1'.aktionsarts
                 };
              SENTENCErec1 := SENTENCErec1';
              SENTENCErec1 :=
                 {
                   voice:             active
                   synvpefs:          [synCLOSEDGERUND]
                   thetavp:           vp010
                   adjuncts:          []
                   aktionsarts:       [stative]
                 };       

               
         >


&

\end{verbatim}
