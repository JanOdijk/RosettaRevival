ENGLISH 87

&
\begin{verbatim}
%
%SUBGRAMMAR PrepppropTOformula

  (* RC_ppFormulaFormation *)
RprepTOformula/1 
.
  (* RC_pppAspect *)
RpppAspectImperf/5
.
  (* RC_pppTijdregels *)
RPPPsuperdeixis/4 

  (* TC_pppSuperdeixisadaptation *)

.
   (* TC_PrepCaseAssign *)
( TNoPPCaseAssign/2 | TPPCaseAssign/3)


HEAD:
<
PREPPPROP     FROM (PREPPPROPformation)
>

(* IMPORT: *)
<
>

EXPORT:
<
PREPPFORMULA
>
&

\end{verbatim}
\newpage

\begin{verbatim}
% RULE RprepTOformula
< m1: PREPPPROP{PREPPPROPrec1}[mu1]
>

< m : PREPPFORMULA{PREPPFORMULArec1}[mu1]
>

      COMP
         <
          C1: true
          A1: PREPPFORMULArec1 := PREPPPROPrec1;
         >
      DECOMP
         <
          C1: true
          A1: PREPPPROPrec1 := PREPPFORMULArec1;
         >

&

\end{verbatim}
