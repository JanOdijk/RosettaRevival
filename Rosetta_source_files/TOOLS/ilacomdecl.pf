pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('ilacomlangspec.pf');

PACKAGE ilacomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     ilacomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   ilacomDECL_Surfrulemode = (loccond, globcond);
   ilacomDECL_psyntcat     = ^ilacomLANGSPEC_Category;
   ilacomDECL_syntcatset   = SET OF ilacomLANGSPEC_Category;
   ilacomDECL_nodeid         = HINIT..HFINAL;
   ilacomDECL_plonodeid      = ^ilacomDECL_lonodeid;
   ilacomDECL_lonodeid       = RECORD
   			          next: ilacomDECL_plonodeid;
   			          arg : ilacomDECL_nodeid
   	 	               END;
   ilacomDECL_pSnode       = ^ilacomDECL_Snode;
   ilacomDECL_pRsnode      = ^ilacomDECL_Rsnode;
   ilacomDECL_Rsnode       = RECORD
                                sonnumber:ilacomDECL_nodeid;
                                node    : ilacomDECL_pSnode;
                                brother : ilacomDECL_pRsnode
                             END;
   ilacomDECL_Snode        = RECORD
                                sonlist : ilacomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : ilacomLANGSPEC_Category;
                                ldfield : ilacomLANGSPEC_FieldDef
                             END;
   ilacomDECL_pLostree     = ^ilacomDECL_Lostree;
   ilacomDECL_Lostree      = RECORD
                                next    : ilacomDECL_pLostree;
                                arg     : ilacomDECL_pSnode
                             END;
   ilacomDECL_pConnectionnode
                           = ^ilacomDECL_Connectionnode;
   ilacomDECL_pSingleSegmList
                           = ^ilacomDECL_SingleSegmList;
   ilacomDECL_Connectionnode 
                           = RECORD
                                list    : ilacomDECL_pSingleSegmList;
                                next,
                                prev    : ilacomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   ilacomDECL_SingleSegmList
                           = RECORD
                                next    : ilacomDECL_pSingleSegmlist;
                                rn      : ilacomDECL_pConnectionnode;
                                stree   : ilacomDECL_pSnode
                             END;
   ilacomDECL_psurfgraph     = ^ilacomDECL_surfgraphtype;
   ilacomDECL_psurfgraphnode = ^ilacomDECL_surfgraphnode;
   ilacomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: ilacomDECL_psurfgraphnode
   		               END;
   ilacomDECL_plossurfgraphnode 
                             = ^ilacomDECL_lossurfgraphnode;
   ilacomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : ilacomDECL_plossurfgraphnode;
   			       END;
   ilacomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  ilacomDECL_plossurfgraphnode;
   				   arg  :  ilacomDECL_psurfgraphnode
   			       END;
   ilacomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: ilacomDECL_psurfgraphnode;
   			          n    : ilacomDECL_nodeid;
   			          cat  : ilacomDECL_psyntcat;
   			          nextnodes: ilacomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : ilacomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

