 *  Remarks         : Implementation of the abstract datatype ILDict.
 *                    The module provides I/O functions for accessing
 *                    AIDDICT and GIDDICT.
 *
 *EMP:::===================================================================*)

pragma C_include('cisam.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE LIIDDICT;
WITH CISAM;


CONST
   LIIDDICT_MaxIdArgs = 10;


(*MPT:::===================================================================*
 *
 *  Type name      : LIIDDICT_IdArgs
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LIIDDICT_IdArgs = RECORD
                        nrargs  : INTEGER;
                        argkeys : ARRAY[1..LIIDDICT_MaxIdArgs] OF INTEGER;
                     END;
                        

(*MPT:::===================================================================*
 *
 *  Type name      : LIIDDICT_RecordDef
 *  Description    : Definition of the record type of IDDICT
 *
 *EMP:::===================================================================*)

TYPE
   LIIDDICT_RecordDef = RECORD
                            args          : LIIDDICT_IdArgs;
                            headkey       : INTEGER;
                            idskey        : INTEGER;
                            pattern       : INTEGER
                         END;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_OpenIDDICT
 *  Description     : Open IDDICT for Read access
 *  Parameters      : none
 *  Precondition    : IDDICT is not yet open
 *  Postcondition   : IDDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIIDDICT_OpenIDDICT;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetAIDDICT
 *  Description    : 
 *  Parameters     : args        : LIIDDICT_IdArgs;
 *                   VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   args
 *  Precondition   : SIDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetAIDDICT(args        : LIIDDICT_IdArgs;
                                        VAR rec     : LIIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetNextAIDDICT
 *  Description    : 
 *  Parameters     : args        : LIIDDICT_IdArgs
 *                   VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey
 *  Precondition   : IDDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetNextAIDDICT(args     : LIIDDICT_IdArgs;
                                         VAR rec     : LIIDDICT_RecordDef)
                                         : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_IsIdKey
 *  Description    : 
 *  Parameters     : idskey     : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   idskey
 *  Precondition   : IDDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_IsIdKey(idskey   : INTEGER): BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetGIDDICT
 *  Description    : 
 *  Parameters     : idskey     : INTEGER
 *                   VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : IDDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetGIDDICT(idskey   : INTEGER;
                                        VAR rec     : LIIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetNextGIDDICT
 *  Description    : 
 *  Parameters     : idskey     : INTEGER
 *                   VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : IDDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetNextGIDDICT(idskey : INTEGER;
                                            VAR rec     : LIIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetheadIDDICT
 *  Description    : 
 *  Parameters     : headkey     : INTEGER
 *                   VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : IDDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetheadIDDICT(headkey   : INTEGER;
                                        VAR rec     : LIIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetNextheadIDDICT
 *  Description    : 
 *  Parameters     : headkey     : INTEGER
 *                   VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : IDDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetNextheadIDDICT(headkey : INTEGER;
                                            VAR rec     : LIIDDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_GetNextIDDict
 *  Description    : Reads next record according to current index
 *  Parameters     : VAR rec     : LIIDDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found 
 *  Precondition   : IDDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_GetNextIDDict(VAR rec     : LIIDDICT_RecordDef
                                          ): BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_CloseIDDICT
 *  Description     : Close IDDICT 
 *  Parameters      : none
 *  Precondition    : IDDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIIDDICT_CloseIDDICT;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_SetIndex
 *  Description     : Sets index
 *  Parameters      : index
 *  Precondition    : IDDict is open
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_SetIndex(ind: INTEGER): BOOLEAN;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_Release
 *  Description     : Unlock record
 *  Parameters      : none
 *  Precondition    : IDDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIIDDICT_Release;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_Reset
 *  Description     : Resets record
 *  Parameters      : none
 *  Precondition    : IDDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIIDDICT_Reset;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_OpenIDDICT
 *  Description     : Opens IDDICT dictionary for reading
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LIIDDICT_OpenIDDICTWrite;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_WriteSequential
 *  Description    : Writes the current record of the IDDICT file
 *  Parameters     : VAR rec: LIIDDICT_RecordDef;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_WriteSequential(rec: LIIDDICT_RecordDef): BOOLEAN;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LIIDDICT_OpenIDDICTUpdate
 *  Description     : Opens IDDICT dictionary for updating
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LIIDDICT_OpenIDDICTUpdate;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_Update
 *  Description    : Updates the current record of the IDDICT file
 *  Parameters     : VAR rec: LIIDDICT_RecordDef;
 *  Result         : VMSRMS_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_Update(rec: LIIDDICT_RecordDef): CISAM_StatusType;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LIIDDICT_Delete
 *  Description    : Deletes the current record from the IDDICT file
 *  Parameters     : VAR rec: LIIDDICT_RecordDef;
 *  Result         : VMSRMS_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LIIDDICT_Delete: CISAM_StatusType;
EXTERNAL;

END {LIIDDICT};
