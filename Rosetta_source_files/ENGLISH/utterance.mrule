ENGLISH 100

&
\begin{verbatim}
%
%SUBGRAMMAR Utterance

( RUTTSENT/1 | RUTTNP/2 | RUTTADVP/3 | RUTTADJP/4 | RUTTPREPP/5 |
  RUTTEXCLAM/6
)

.[RaddEXCLAM/7]

HEAD:
<
SENTENCE FROM (CLAUSEtoSENTENCE)
NP       FROM (NPFORMATION)
ADVP     FROM (ADVPFORMATION)
ADJP     FROM (ADJPFORMULAtoADJPPROP)
PREPP    FROM (PREPPFORMATION)
>

(* no IMPORT *)
<
>

EXPORT:
<
UTT
>

&
\end{verbatim}
\newpage
\begin{verbatim}

% RULE RUttSent
< m1: T1
>

< m : UTT{UTTrec1}[head/T1]
>

<
   SUBRULE
      < T1: SENTENCE{SENTENCErec1}[mu1] >
      < T1: SENTENCE{SENTENCErec1}[mu1] >

      COMP
         <
          C1: SENTENCErec1.senttype = mainclause  AND
              SENTENCErec1.finiteness = finite    AND
              QUOTE_polarityOK(T1)                AND
              (NOT QUOTE_varsintree(T1))          AND
              (NOT QUOTE_acconetheyintree(T1))
          A1: @
         >
      DECOMP
         <
          C1: SENTENCErec1.senttype = mainclause AND
              SENTENCErec1.finiteness = finite AND
              QUOTE_polarityOK(T1)             AND
              (NOT QUOTE_acconetheyintree(T1))
          A1: @
         >
>
&

\end{verbatim}
