\begin{verbatim}
% FILTER FCaseAssignNOM
< m: I3::CLAUSE{CLAUSErec1}
                [ mu1,
                  I1:subjrel/T1,
                  mu2 
                ]
>


   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [] 
       I3: CLAUSErec1.finiteness = finite
      >

<
   SUBRULE
      < T1:NPVAR{NPVARrec1} >

         <
          C1: true
          A1: @
         >


   SUBRULE
      < T1:CNVAR{CNVARrec1} >

         <
          C1: true
          A1: @
         >


   SUBRULE
      < T1:NP{NPrec1}[mu3] >

         <
          C1: true
          A1: @
         >

>
&
\end{verbatim}
