TYPE  MGLUE2;


VAR

A = [I, you, he, she, it, we, you, they];

B = [he, she, it];

C = [you, we, they];

D = [I, you, we, they];

E = [I, you, he, she, we, you, they];

TABLE


{These rules make a contracted negative form of auxiliaries}

   shall  + not :: shan't;       
   should + not :: shouldn't;  
   will   + not :: won't;        
   would  + not :: wouldn't;  
   can    + nòt :: cannot;
   can    + not :: can't;         
   could  + not :: couldn't;
   must   + not :: mustn't;  
   might  + not :: mightn't;
   ought  + not :: oughtn't;
   used   + not :: usedn't;
   need   + not :: needn't;
   dare   + not :: daren't; 
   do     + not :: don't;
   does   + not :: doesn't;
   did    + not :: didn't;
   have   + not :: haven't;
   has    + not :: hasn't;
   had    + not :: hadn't;
   are    + not :: aren't;
   am     + not :: aren't;       {only in tag questions: aren't I?}
   am     + not :: ain't;        
   is     + not :: isn't;
   was    + not :: wasn't;
   were   + not :: weren't;

{These rules contract the auxiliary onto the subject} 

/G (A)   + will  :: (A)'ll;         
/G (E)   + had   :: (E)'d;          
/G (E)   + would :: (E)'d;          
/G (B)   + has   :: (B)'s;          
/G (B)   + is    :: (B)'s;
    I    + am    ::  I'm;
/G (C)   + are   :: (C)'re;
/G (D)   + have  :: (D)'ve;         

{Wanna-contraction}

want + to :: wanna;

let  + us :: let's;

END
