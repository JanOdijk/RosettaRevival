\newpage
\begin{verbatim}
% FILTER FredelloSUBJdel
< m: I2::SENTENCE{SENTENCErec1}
             [ I1:mu1,
               subjrel/NP{NPrec1}
                   [head/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(AUX_redellobpersprokey){BPERSPROrec1}]
                   ],
               mu5,
               head/I3::VERB{VERBrec1}[mu3],
               mu4
             ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [subjrel/..])
       I2: SENTENCErec1.finiteness = finite AND
           SENTENCErec1.restructuring = false
       I3: ((VERBrec1.thetavp = vp000)  OR
            (VERBrec1.thetavp = vp010) OR
            (VERBrec1.thetavp = vp021) OR
            (VERBrec1.thetavp = vp012) OR
           ((VERBrec1.thetavp = thetavpAUX) AND  
            (synHABER IN VERBRec1.synvps)))    (* existential sentences *)
                                            AND
                                         
           (VERBrec1.numero = singular)     AND
           (VERBrec1.persona = 3)  
      >

         <
          C1: (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) 
                                           EXCEPT FOR [forma]) AND
              (PERSPROrec1.forma = Nomdebil)                   AND
              (NPrec1 = AUX_NPONredelloBPRSPR EXCEPT FOR [cases])
          A1:  @
         >
&

\end{verbatim}
