\begin{verbatim}
%
% RULE RBVERBTOSUB
< m1:BVERB{BVERBrec1} 
>

< m :SUBVERB{SUBVERBrec1}[head/BVERB{BVERBrec1}]
>

      COMP
         <
          C1: true
          A1: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1)
         >
      DECOMP
         <
          C1: SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)
          A1: @
         >
&

\end{verbatim}
