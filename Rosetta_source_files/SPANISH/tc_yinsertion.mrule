SPANISH 58
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Tyinsertion
< m1:I1::SENTENCE{SENTENCErec1}
              [ mu1,
                head/VERB{VERBrec2}
                       [ head/I2::VERB{VERBrec1}
                               [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(KEY_haberBVERBkey){BVERBrec1}]
                               ],
                         I3:mu3
                       ],
                mu4
              ]
>

< m:I1::SENTENCE{SENTENCErec1}
                [ mu1,
                  head/VERB{VERBrec2}
                         [ head/I2::VERB{VERBrec1}
                                 [head/SUBVERB{SUBVERBrec1}
                                     [head/BVERB(KEY_haberBVERBkey){BVERBrec1}]
                                 ],
                           gluerel/GLUE{},
                           conjrel/CONJ(KEY_yCONJkey){CONJrec1},
                           I3:mu3
                         ],
                  mu4
                ]
>


   MATCHCONDITIONS
      <
       I1: SENTENCErec1.finiteness = finite
       I2: (VERBrec1.persona = 3) AND (VERBrec1.numero = singular) AND
           (VERBrec1.tiempo = Presente)
       I3: ( NOT EXIST (mu3, [rel1/VERB{VERBrec3}[mu5]]) )      AND
           ( NOT EXIST (mu3, [conjrel/CONJ(KEY_yCONJkey){CONJrec2}]) )
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tyinsertion
\item[* relevant examples:] ha tres libros $\rightarrow$ ha-GLUE-y tres libros
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_yinsertion
\item[* date of creation:] 13-SEP-1988 12:50:19  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Insertion of a GLUE + yCONJkey after "ha" 
(3rd person sg. of haber) in case "ha" is not followed by a PtcPas.
(The choice of CONJ is arbitrary but obvious since CONJ has no SUB- 
and B-level).\\
(i.e. "hay" $\rightarrow$ existential sentences)
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:] "hay" as a special verb (i.e. CONJclass)
which only has third person forms.
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\item This rule is both  for existential hay (hay + NP) and hay que (Dutch "men 
moet").
\end{description}


