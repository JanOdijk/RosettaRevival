\newpage
\begin{verbatim}
%TRANSFORMATION TPOSSADJSPELLING1

< m1: VERBPPROP{VERBPPROPREC1}
               [ mu8,
                 I1:subjrel/T1,
                 mu1,
                 predrel/VERBP{VERBPrec1}
                        [ mu2,
                          head/VERB{VERBrec1}[mu3],
                          mu6,
                          objrel/NP{NPrec1}
                                [ I2:detrel/T2,
                                  mu4
                                ],
                          mu5
                        ],
                  mu7
                ]
>

< m : VERBPPROP{VERBPPROPREC1}
               [ mu8,
                 I1:subjrel/T1,
                 mu1,
                 predrel/VERBP{VERBPrec1}
                        [ mu2,
                          head/VERB{VERBrec1}[mu3],
                          mu6,
                          objrel/NP{NPrec1}
                                [ detrel/POSSADJ{POSSADJrec1}
                                        [ head/BPERSPRO(KEY1){BPERSPROrec1} 
                                        ],
                                  mu4
                                ],
                          mu5
                        ],
                  mu7
                ]
>

  MATCHCONDITIONS
   < I1: T1.CAT IN [NPVAR,CNVAR]
     I2: T2.CAT IN [NPVAR,CNVAR]
   >
<
   SUBRULE    (* NPVAR *)
      <T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1}
      >


      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases]
             C11:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = singular        AND
                   NPVARREC1.NPhead <> oneNP          AND
                   NPVARREC1.sexes = []               AND
                   NPVARREC1.genders = [omegagender]
             A11:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_itBPERSPROkey;
             C12:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = singular        AND
                   NPVARREC1.NPhead <> oneNP          AND
                   (masculine IN NPVARrec1.sexes OR
                     (masculinegender IN NPVARrec1.genders AND
                      NPVARrec1.sexes = []
                     )
                   )
             A12:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_heBPERSPROkey;
             C13:  NPVARREC1.person = 1               AND
                   NPVARREC1.number = singular
             A13:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_iBPERSPROkey;
             C14:  NPVARREC1.person = 2               AND
                   NPVARREC1.number = singular
             A14:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_yousgBPERSPROkey;
             C15:  NPVARREC1.person = 2               AND
                   NPVARREC1.number = plural
             A15:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_youplBPERSPROkey;
             C16:  NPVARREC1.person = 1               AND
                   NPVARREC1.number = plural
             A16:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_weBPERSPROkey;
             C17:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = plural
             A17:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_theyBPRSPRkey;
             C18:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = singular        AND
                   NPVARREC1.NPhead <> oneNP          AND
                   (feminine IN NPVARrec1.sexes OR
                     (femininegender IN NPVARrec1.genders AND
                      NPVARrec1.sexes = []
                     )
                   )
             A18:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_sheBPERSPROkey;
          A1: @
         >
   DECOMP
         <
      C1: POSSADJREC1.mood = nowh
             C11:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = singular        AND
                   NPVARREC1.NPhead <> oneNP          AND
                   NPVARREC1.sexes = []               AND
                   NPVARREC1.genders = [omegagender]  AND
                   KEY1 = KEY_itBPERSPROkey
             A11:  @
             C12:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = singular        AND
                   NPVARREC1.NPhead <> oneNP          AND
                   (masculine IN NPVARrec1.sexes OR
                     (masculinegender IN NPVARrec1.genders AND
                      NPVARrec1.sexes = []
                     )
                   )                                  AND
                   KEY1 = KEY_heBPERSPROkey
             A12:  @
             C13:  NPVARREC1.person = 1               AND
                   NPVARREC1.number = singular        AND
                   KEY1 = KEY_iBPERSPROkey
             A13:  @
             C14:  NPVARREC1.person = 2               AND
                   NPVARREC1.number = singular        AND
                   KEY1 = KEY_yousgBPERSPROkey
             A14:  @
             C15:  NPVARREC1.person = 2               AND
                   NPVARREC1.number = plural          AND
                   KEY1 = KEY_youplBPERSPROkey
             A15:  @
             C16:  NPVARREC1.person = 1               AND
                   NPVARREC1.number = plural          AND
                   KEY1 = KEY_weBPERSPROkey
             A16: @
             C17:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = plural          AND
                   KEY1 = KEY_theyBPRSPRkey
             A17: @
             C18:  NPVARREC1.person = 3               AND
                   NPVARREC1.number = singular        AND
                   NPVARREC1.NPhead <> oneNP          AND
                   (feminine IN NPVARrec1.sexes OR
                     (femininegender IN NPVARrec1.genders AND
                      NPVARrec1.sexes = []
                     )
                   )                                  AND
                   KEY1 = KEY_sheBPERSPROkey
             A18: @
      A1: NPVARREC2 := NPVARREC1;
         >

   SUBRULE    (* CNVAR *)
      <T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1}
      >


      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases]
             C11:  singular IN CNVARREC1.numbers      AND
                   CNVARREC1.genders = []             AND
                   CNVARREC1.sexes = []
             A11:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_itBPERSPROkey;
             C12:  singular IN CNVARREC1.numbers      AND
                   (masculine IN CNVARrec1.sexes OR
                     (masculinegender IN CNVARrec1.genders AND
                      CNVARrec1.sexes = []
                     )
                   )
             A12:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_heBPERSPROkey;
             C17:  plural IN CNVARREC1.numbers
             A17:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_theyBPRSPRkey;
             C18:  singular IN CNVARREC1.numbers      AND
                   (feminine IN CNVARrec1.sexes OR
                     (femininegender IN CNVARrec1.genders AND
                      CNVARrec1.sexes = []
                     )
                   )
             A18:  POSSADJREC1.mood := nowh;
                   KEY1 := KEY_sheBPERSPROkey;
          A1: @
         >

      DECOMP
         <
      C1: POSSADJREC1.mood = nowh
             C11:  singular IN CNVARREC1.numbers      AND
                   CNVARREC1.genders = []             AND
                   CNVARREC1.sexes = []               AND
                   KEY1 = KEY_itBPERSPROkey
             A11: @
             C12:  singular IN CNVARREC1.numbers      AND
                   (masculine IN CNVARrec1.sexes OR
                     (masculinegender IN CNVARrec1.genders AND
                      CNVARrec1.sexes = []
                     )
                   )                                  AND
                   KEY1 = KEY_heBPERSPROkey
             A12:  @
             C17:  plural IN CNVARREC1.numbers        AND
                   KEY1 = KEY_theyBPRSPRkey
             A17:  @
             C18:  singular IN CNVARREC1.numbers      AND
                   (feminine IN CNVARrec1.sexes OR
                     (femininegender IN CNVARrec1.genders AND
                      CNVARrec1.sexes = []
                     )
                   )                                  AND
                   KEY1 = KEY_sheBPERSPROkey
             A18:  @
      A1: NPVARREC2 := NPVARREC1;
         >
>

&
\end{verbatim}
