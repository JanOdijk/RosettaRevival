\newpage
\begin{verbatim}
% RULE RanyNPformation
< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2],
                 I1:mu3]
>

< m: NP{NPrec1}[detrel/DETP{DETPrec1}
                      [head/DET{DETrec1}
                           [head/BDET(KEY_anyBDETkey){BDETrec1}]
                      ], 
                head/CN{CNrec1}[mu1,
                                head/NOUN{NOUNrec1}[mu2],
                                mu3
                               ]
               ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3, [posrel/NP{NPrec2}[mu8]])
       m : NPrec1  = { NPhead            : otherNP
                       person            : 3
                       class             : CNrec1.class
                       deixis            : CNrec1.deixis
                       aspect            : CNrec1.aspect
                       retro             : CNrec1.retro
                     }
      >

      COMP
         <
          C1: true

              C11: singular IN CNrec1.numbers AND
                   CNrec1.posscomas * [mass] <> [] 
              A11: NPrec1.number := singular;         
              C12: plural IN CNrec1.numbers AND
                   CNrec1.posscomas * [count] <> [] 
              A12: NPrec1.number := plural;         
(*              C13: singular IN CNrec1.numbers AND
                   CNrec1.posscomas * [count] <> [] 
              A13: NPrec1.number := singular;         

in analysis only; cf.remarks
*)
          A1: DETrec1 := COPYT_BDETtoDET(BDETrec1);
              DETPrec1 := COPYT_DETtoDETP(DETrec1);
              (* syntquant remains default *)
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          NPhead     : othernp
                         }  
         >

      DECOMP
         <
          C1: DETrec1 = COPYT_BDETtoDET(BDETrec1) AND
              DETPrec1 = COPYT_DETtoDETP(DETrec1) AND
              DETPrec1.syntquant = omegaquant AND
              NPrec1  = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          NPhead     : othernp
                         } AND
               NPrec1.actcomas  * CNrec1.posscomas <> [] 


              C11: singular IN CNrec1.numbers AND
                   mass IN CNrec1.posscomas AND
                   NPrec1.number = singular
              A11: @
              C12: plural IN CNrec1.numbers AND
                   count IN CNrec1.posscomas AND
                   NPrec1.number = plural      
              A12: @
              C13: singular IN CNrec1.numbers AND
                   count IN CNrec1.posscomas AND
                   NPrec1.number = singular   
              A13: @

          A1:  @
         >
&

\end{verbatim}
