\begin{verbatim}

% TRANSFORMATION TOblSubjControlPrepSent   (* prepobjrel/SENT,
                                              subj antec. *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             I1:subjrel/T1,
             I7:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/I6::VERB{VERBrec1}[mu5],
                      mu4,
                      prepobjrel/PREPP{PREPPrec1}
                                [head/PREP{PREPrec1},
                                 objrel/I2::SENTENCE{SENTENCErec1}
                                       [I3: sig1,
                                        I5: subjrel/T2,
                                        I4: mu6
                                       ] 
                                ],
                      mu7
                    ],
             mu8
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             I1:subjrel/T1,
             I7:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/I6::VERB{VERBrec1}[mu5],
                      mu4,
                      prepobjrel/PREPP{PREPPrec2}
                                [head/PREP{PREPrec1},
                                 objrel/I2::SENTENCE{SENTENCErec1}
                                       [I3: sig1,
                                        I4: mu6
                                       ]
                                ],
                      mu7
                    ],
             mu8
           ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: SENTENCErec1.PROsubject = true
       I3: ALL (sig1, shiftrel/..)
       I4: NOT EXIST (mu6, [shiftrel/..])
       I5: T2.CAT IN [NPVAR, CNVAR]
       I6: VERBrec1.controller = subject
       I7: NOT EXIST (mu2, [I71:auxrel/VERB{VERBrec2}[mu9]])
         I71: VERBrec2.subc = modalverb
      >

<
   SUBRULE  (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2
              (* cases of both vars are [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is [omegacase] *)
         >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2
              (* cases of both vars are [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which is [omegacase] *)
         >
>

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] TOblSubjControlPrepSent
\item[* relevant examples:]\mbox{}\\
(vp123): x1 talk (to x3) about [how x1 to prevent an accident from happening] 
$\rightarrow$ x1 talk (to x3) about [how to prevent an accident from happening]
\\
Note that {\em talk about\/} probably is a non obligatory controller. However, 
one of the possible interpretations of the BIGPRO occurring as subject of the 
embedded sentence is a version where the reference of BIGPRO and x1 are exactly 
the same. For this case the present rule is meant. What should be investigated 
more closely is whether the example verb can indeed be classified as subject 
controller, since indirect object control might be another possible 
interpretation.
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_Controlrules
\item[* date of creation:] 14-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:] TOblObjControlPrepSent
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To interpret the VAR-subject of sentences in a prepobj as the 
subject of the higher clause, and to delete this embedded subject.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One for NPVARs,
one for CNVARs.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
\item[\ \ presuppositions:]\mbox{}
