\newpage
\begin{verbatim}
% RULE RShiftPrepNPSubst     (* NP in shiftrel/PREPP in S *)
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              I5:shiftrel/PREPP{PREPPrec1}
                         [ mu3,
                           rel2/I1::NPVAR{NPVARrec1},
                           mu4
                         ],
              mu2,
              predrel/VERBP{VERBPrec1}[mu5],
              mu6 
            ] 
  SUBST:
  m2: T3=I3::NP{NPrec1}[I7:mu7]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I9:shiftrel/PREPP{PREPPrec2}
                         [ mu3,
                           I6:rel2/T4=I4::NP{NPrec2}[I8:mu8],
                           mu4
                         ],
              mu2,
              predrel/VERBP{VERBPrec1}[mu5],
              mu6 
            ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_Gsubstordercondition(mu2, mu5, mu6, T3, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T3)        
       m : QUOTE_substordercondition(mu2, mu5, mu6, CLAUSErec1.prosubject)
       I1: NPVARrec1.index = LEVEL 
       I3: NOT (NPrec1.NPhead IN [reflNP, reciproNP, sentNP, openIngNP])
       I4: NOT (NPrec2.NPhead IN [reflNP, reciproNP, sentNP, openIngNP])
       I5: PREPPrec1.actsubcefs * [loc, dir, other] <> [] AND
           PREPPrec1.actsubcefs <> [doorby]
       I6: NOT QUOTE_NegPhrase(T4)
       I7: NOT EXIST (mu7, [head/BIGPRO{}[mu10]])
       I8: NOT EXIST (mu8, [head/BIGPRO{}[mu11]])
       I9: PREPPrec2.actsubcefs * [loc, dir, other] <> [] AND
           PREPPrec2.actsubcefs <> [doorby]
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) 
                          EXCEPT FOR [cases, mood] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              NPrec1.superdeixis)
            C11: NPVARrec1.mood = topicmood AND
                 PREPPrec1.mood = topicmood AND
                 NPrec1.mood = nowh
            A11: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases); 
                 PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := nowh
            C12: NPVARrec1.mood = wh AND
                 PREPPrec1.mood = wh AND
                 NPrec1.mood = wh
            A12: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases); 
                 PREPPrec2 := PREPPrec1
          A1: NPrec2.generic := omegageneric;
              NPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
            C11: NPrec2.mood = nowh AND
                 PREPPrec2.mood = nowh
            A11: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []); 
                 NPVARrec1 := COPYT_nptovar(NPrec2);
                 NPVARrec1.mood := topicmood;
                 PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := topicmood
            C12: NPrec2.mood = wh AND
                 PREPPrec2.mood = wh
            A12: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []); 
                 NPVARrec1 := COPYT_nptovar(NPrec2);
                 PREPPrec1 := PREPPrec2
          A1: QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 NPrec1.superdeixis);
              NPVARrec1.index := LEVEL;
              NPVARrec1.generic := nogeneric;
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RShiftPrepNPSubst
\item[* relevant examples:] \mbox{}\\
shifted locargrel: in x1 did you put it $\rightarrow$ in what did you put it\\
shifted dirargrel: to x1 did they move $\rightarrow$ to what house did they 
move\\
shifted complrel: ?against x1 did he vote $\rightarrow$ against what did he 
vote\\
shifted predrel: ?against x1 are you $\rightarrow$ against what are you
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) RC\_Substitution
\item[* date of creation:] 10-OCT-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch Rsubstitution16
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 15/03/89\ \ \ \ \ author: margreet sanders\\
1) added conditions on absence of BIGPROs (needed for NOC)\\
2) added conditions on absence of an element with incorporated negation, since 
such a word must be broken down to a separate negation (no local translation of 
a word like `nobody' should be possible, except when translating bare NPs)
\item date: 13/11/89\ \ \ \ \ author: margreet sanders\\
Added conditions for topicmood (had been forgotten; only RShiftNPSubst was 
adapted).
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to substitute NPs for NPVARs inside shifted PREPPs. These PREPPs 
have been made by the control rules, where all propositional structures with 
PREPs are made into a PREPP, irrespective of whether they still contain a VAR. 
Since the original relation (locargrel, dirargrel, complrel, locadvrel) has 
been lost in 
the shifting, and since the element may have shifted to a higher sentence, no 
conditions on the synvpefs of the clause can be stated; to prevent 
too many ambiguities in analysis, some conditions on the subc of the prep can 
be given (cf. the next rule, where shifted byobjrel and prepobjrel/VARPREPPs 
have to be made on basis of the same input model). It is assumed that predrel 
PREPPs always have subc = other.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
