\newpage
\begin{verbatim}
% RULE RPassive
< m1:I1::VERBPPROP{VERBPPROPrec1}
                      [ I8:mu6,
                        I5:subjrel/T1,
                        I7:mu1,
                        predrel/VERBP{VERBPrec1}
                               [ head/I2::VERB{VERBrec1}[mu3 ],
                                 cliticrel/CLITIC{}[mu8],
                                 mu9,
                                 I6:objrel/T2,
                                 mu4
                               ],
                        mu5
                      ]
>

< m :I3::VERBPPROP{VERBPPROPrec2}
                      [ I8:mu6, 
                        I7:mu1,
                        predrel/VERBP{VERBPrec1}
                               [ head/I4::VERB{VERBrec2}[mu3 ],
                                 cliticrel/CLITIC{}[mu8],
                                 mu9,
                                 I6:objrel/T2,
                                 mu4,
                                 porobjrel/VARPREPP{VARPREPPrec1}
                                     [ head/PREP(KEY_doorporprepkey){PREPrec1},
                                       I5:objrel/T1
                                     ]
                               ],
                        mu5
                      ]
>

   MATCHCONDITIONS
      <
       I1: ( VERBPPROPrec1.voice = omegavoice) AND
           ( VERBPPROPrec1.thetavp IN [vp120, vp123] )  
       I2: VERBrec1.modo = omegamodo
       I3: ( VERBPPROPrec2.voice = Passive) AND
           ( VERBPPROPrec2.thetavp IN [vp120, vp123] )
       I4: VERBrec2.modo = PtcPas
       I5: T1.CAT IN [ NPVAR, CNVAR, EMPTYVAR ]
       I6: T2.CAT IN [ NPVAR, CNVAR ]
       I8: ALL(mu6, leftdislocrel/..)
       I7: NOT EXIST(mu1, [leftdislocrel/..])
      >

<
   SUBRULE (*1a*)
      < >
      < >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: Passive IN VERBrec1.possvoices
            A2: VERBrec2 := VERBrec1;
                VERBrec2.modo := PtcPas;
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.voice := Passive;

                VARPREPPrec1 :=
                {
                 actsubcefs  : [doorpor]
                 synppefs    : [synNP]
                 headkey     : KEY_doorporprepkey
                }
           A1: @
            (* all other attributes keep the default value *)
         >


   SUBRULE  (*1b*)
      < T1:EMPTYVAR{EMPTYVARrec1} >
      < T1:EMPTYVAR{EMPTYVARrec1} >

       COMP
         <
          C1: Passive IN VERBrec1.possvoices
          A1: VERBrec2 := VERBrec1;
              VERBrec2.modo := PtcPas;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.voice := Passive;

              VARPREPPrec1 :=
              {
               actsubcefs  : [doorpor]
               synppefs    : [synEMPTY]
               headkey     : KEY_doorporprepkey
              }
            (* all other attributes keep the default value *)
         >
>
&

\end{verbatim}
