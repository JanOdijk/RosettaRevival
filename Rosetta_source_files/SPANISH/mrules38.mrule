\newpage
\begin{verbatim}
% TRANSFORMATION Tinfinite
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
             mu5
            ]
>
      COMP
         <
          C1: ((CLAUSErec1.finiteness = omegafin) AND
               (CLAUSErec1.restructuring = false) AND
               (VERBrec1.futuro = nofuturo) AND
               (VERBrec1.aspecto = omegaaspecto)
              ) 
              C11: true
              A11: CLAUSErec2 := CLAUSErec1;
                   CLAUSErec2.restructuring := true;
              C12: true
              A12: CLAUSErec2 := CLAUSErec1;
          A1: CLAUSErec2.finiteness := infinite;
         >
      DECOMP
         <
          C1: (CLAUSErec2.finiteness = infinite) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto)
              C11: CLAUSErec2.restructuring = true
              A12: CLAUSErec1 :=  CLAUSErec2;
                   CLAUSErec1.restructuring := false 
              C12: CLAUSErec2.restructuring = false 
              A12: CLAUSErec1 := CLAUSErec2;     
          A1: CLAUSErec1.finiteness := omegafin;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Tinfinite
\item[* relevant examples:] CL(......CL(.......dormir))
                            CL(......CL(.......haber dormido))
                            NP(......CL(.......durmiendo)....))
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] finiteness transformations
\item[* date of creation:] 17-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Tinfinite DUTCH
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 04/10/88\ \ \ \ \ author: Lisette Appelo
\item date: 13/01/89\ \ \ \ \ author: Lisette Appelo
\end{enumerate}
\item[* task:] Mark the clause for infinite and, for efficiency reasons, for
restructuring is true or false.
\item[\ \ strategy:] for efficiency reasons the clause is also marked for
restructuring is true or false. restructuring is true if the clause is going to be a 
complement of a restructuring verb. In such complements the rules for 
extraposition, nominative case assignment etc.
are not allowed and so the unnecessary 
application of these rules in generation is avoided.\\
The abstract futuro verb 
is excluded because it can never form an infinite clause.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:] Both the finite and infinite 
transformation are almost
always applicable, which will result in  (temporary)
paraphrases in generation
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The abstract futuro verb is excluded with the feature 
{\em nofuturo} for the most left verb.\\
13/1/89: Added condition on omegaaspecto for verb.\\
\end{enumerate}
\end{description}

