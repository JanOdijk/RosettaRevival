\begin{verbatim}
% FILTER Fprogbetobe
< m :SENTENCE{SENTENCErec1}
         [ mu1, predrel/VERBP{VERBPrec1}[mu2],mu3]
>
  
   MATCHCONDITIONS
      <
       m: EXIST(mu1,[../VERB{}
                           [head/SUBVERB{}
                               [head/BVERB(KEY_progbeBVERBkey){BVERBrec1} ] 
                           ]
                     ]
               )                                          OR
          EXIST(mu2,[../VERB{}
                           [head/SUBVERB{}
                               [head/BVERB(KEY_progbeBVERBkey){BVERBrec1} ] 
                           ]
                     ]
               )
      >


         <
          C1: true
          A1: @
         >

&
