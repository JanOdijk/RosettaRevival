pragma C_include('lexcomdecl.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE lexcomcode;

WITH LEXCOMDECL;
(*MPF:::===================================================================*
 *
 *  Procedure Name  : writerulecode 
 *  Description     : writes pascal code from parse tree stree1.
 *  Parameters      : compas1 file contain compositional rules, decompas1 file
 *                    the decompositional ones.
 *                    
 *  Precondition    : 
 *  Postcondition   : 
 *
 *EMP:::===================================================================*)

 PROCEDURE LEXCOMCODE_writerulecode(rulenaam:LEXCOMDECL_string;stree1:LEXCOMDECL_psnode;
                      var compas1:text;var decompas1:text); EXTERNAL;
(*MPF:::===================================================================*
 *
 *  Procedure Name  : writeintercode 
 *  Description     : writes procedures acting as interface betweeen lexcom
 *                    and the morphological component
 *  Parameters      : stree1:parse tree; 
 *                    compas1 file contain compositional rules, decompas1 file
 *                    the decompositional ones.
 *                    
 *  Precondition    : 
 *  Postcondition   : 
 *
 *EMP:::===================================================================*)

 PROCEDURE LEXCOMCODE_writeintercode(rulenaam:LEXCOMDECL_string;stree1:LEXCOMDECL_psnode;
                      var comenv1:text;var decomenv1:text); EXTERNAL;
END {lexcomcodedef};
