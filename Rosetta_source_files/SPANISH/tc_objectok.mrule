\newpage
\begin{verbatim}
% TRANSFORMATION TObjectok3a (* passive, not-ergative, object(def) -> object*)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             I4:mu9,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      I2:objrel/T1,                      
                      mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I3: mu1,
             subjrel/PRONPVAR{PRONPVARrec1},
             I4: mu9,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      I2:objrel/T1,
                      mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice = Passive) AND
           NOT (CLAUSErec1.thetavp IN [vp010,vp012, vp021])
       I2: T1.CAT IN [NP,NPVAR,CNVAR]
       I3:  ALL (mu1, I31:rel1/..)
       I31: rel1 IN AUX_presubjrels
       I4:  NOT EXIST (mu9, [subjrel/..]) AND
            NOT EXIST (mu9, [I41:rel2/..])
       I41: rel2 IN AUX_presubjrels
      >


<
   SUBRULE (*3a*)
      <T1: NP{NPrec1}[mu8] >
      <T1: NP{NPrec1}[mu8] >

      COMP
         <
          C1: NPrec1.definite = def AND
              [NPrec1.Nphead] * [redelloNP, redellosNP, persproNP] = []
          A1: PRONPVARrec1 := 
                       {  req            : NPrec1.req
                          env            : NPrec1.env
                          supertiempo    : NPrec1.supertiempo
                          class          : NPrec1.class
                          tiempo         : NPrec1.tiempo
                          aspecto        : NPrec1.aspecto
                          retro          : NPrec1.retro
                          persona        : NPrec1.persona
                          genero         : NPrec1.genero
                          actsubcs       : NPrec1.actsubcs
                          temporal       : NPrec1.temporal
                          animate        : NPrec1.animate
                          human          : NPrec1.human
                          actcomas       : NPrec1.actcomas
                          mood           : NPrec1.mood
                          numero         : NPrec1.numero
                          definite       : NPrec1.definite
                          generic        : NPrec1.generic
                          thetanp        : NPrec1.thetanp
                          nounpatternefs : NPrec1.nounpatternefs
                          posspred       : NPrec1.posspred
                          possnietnp     : NPrec1.possnietnp
                          syntquant      : NPrec1.syntquant
                          NPhead         : NPrec1.NPhead
                          SpecQ          : NPrec1.SpecQ
                          DefSpec        : NPrec1.DefSpec
                          cases          : NPrec1.cases
                          index          : 0
                       }
         >

      DECOMP
         <
          C1: (NPrec1.definite = def) AND
              (PRONPVARrec1 = 
                       {  req            : NPrec1.req
                          env            : NPrec1.env
                          supertiempo    : NPrec1.supertiempo
                          class          : NPrec1.class
                          tiempo         : NPrec1.tiempo
                          aspecto        : NPrec1.aspecto
                          retro          : NPrec1.retro
                          persona        : NPrec1.persona
                          genero         : NPrec1.genero
                          actsubcs       : NPrec1.actsubcs
                          temporal       : NPrec1.temporal
                          animate        : NPrec1.animate
                          human          : NPrec1.human
                          actcomas       : NPrec1.actcomas
                          mood           : NPrec1.mood
                          numero         : NPrec1.numero
                          definite       : NPrec1.definite
                          generic        : NPrec1.generic
                          thetanp        : NPrec1.thetanp
                          nounpatternefs : NPrec1.nounpatternefs
                          posspred       : NPrec1.posspred
                          possnietnp     : NPrec1.possnietnp
                          syntquant      : NPrec1.syntquant
                          NPhead         : NPrec1.NPhead
                          SpecQ          : NPrec1.SpecQ
                          DefSpec        : NPrec1.DefSpec
                          cases          : NPrec1.cases
                          index          : 0
                       }) AND
              [NPrec1.Nphead] * [redelloNP, redellosNP, persproNP] = []

          A1: @
         >


   SUBRULE (*3a'*)
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1.definite = def AND
              [NPVARrec1.Nphead] * [redelloNP, redellosNP, persproNP] = []
          A1: PRONPVARrec1 := NPVARrec1;
              PRONPVARrec1.index := 0
         >

      DECOMP
         <
          C1: (NPVARrec1.definite = def) AND
              (PRONPVARrec1 = NPVARrec1 EXCEPT FOR [index]) AND
              (PRONPVARrec1.index = 0) AND
              [NPVARrec1.Nphead] * [redelloNP, redellosNP, persproNP] = []
          A1: @
         >

   SUBRULE (*3a''*)            (* masc *)
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: (masc IN CNVARrec1.generos)
          A1: PRONPVARrec1 := 
                      { req           : CNVARrec1.req
                        env           : CNVARrec1.env
                        supertiempo   : CNVARrec1.supertiempo
                        class         : CNVARrec1.class
                        tiempo        : CNVARrec1.tiempo
                        aspecto       : CNVARrec1.aspecto
                        retro         : CNVARrec1.retro
                        definite      : def
                        numero        : CNVARrec1.numero
                        persona       : 3
                        genero        : masc
                        actsubcs      : CNVARrec1.actsubcs
                        temporal      : CNVARrec1.temporal
                        animate       : CNVARrec1.animate
                        human         : CNVARrec1.human
                        actcomas      : CNVARrec1.posscomas
                        thetanp       : CNVARrec1.thetanp
                        nounpatternefs: CNVARrec1.nounpatternefs
                        cases         : CNVARrec1.cases
                        index         : 0
                         }
 
           (* mood, generic, posspred, possnietnp, syntquant, NPhead,
              SpecQ, DefSpec have default value                        *)
         >

      DECOMP
         <
          C1: (masc IN CNVARrec1.generos) AND
              (PRONPVARrec1 = 
                      { req           : CNVARrec1.req
                        env           : CNVARrec1.env
                        supertiempo   : CNVARrec1.supertiempo
                        class         : CNVARrec1.class
                        tiempo        : CNVARrec1.tiempo
                        aspecto       : CNVARrec1.aspecto
                        retro         : CNVARrec1.retro
                        definite      : def
                        numero        : CNVARrec1.numero
                        persona       : 3
                        genero        : masc
                        actsubcs      : CNVARrec1.actsubcs
                        temporal      : CNVARrec1.temporal
                        animate       : CNVARrec1.animate
                        human         : CNVARrec1.human
                        actcomas      : CNVARrec1.posscomas
                        thetanp       : CNVARrec1.thetanp
                        nounpatternefs: CNVARrec1.nounpatternefs
                        cases         : CNVARrec1.cases
                        index         : 0
                         })
                   (* the other attributes have default value *)
          A1: @
         >

   SUBRULE (*3a'''*)            (* fem *)
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: (fem IN CNVARrec1.generos)
          A1: PRONPVARrec1 := 
                      { req           : CNVARrec1.req
                        env           : CNVARrec1.env
                        supertiempo   : CNVARrec1.supertiempo
                        class         : CNVARrec1.class
                        tiempo        : CNVARrec1.tiempo
                        aspecto       : CNVARrec1.aspecto
                        retro         : CNVARrec1.retro
                        definite      : def
                        numero        : CNVARrec1.numero
                        persona       : 3
                        genero        : fem
                        actsubcs      : CNVARrec1.actsubcs
                        temporal      : CNVARrec1.temporal
                        animate       : CNVARrec1.animate
                        human         : CNVARrec1.human
                        actcomas      : CNVARrec1.posscomas
                        thetanp       : CNVARrec1.thetanp
                        nounpatternefs: CNVARrec1.nounpatternefs
                        cases         : CNVARrec1.cases
                        index         : 0
                      }
 
           (* mood, generic, posspred, possnietnp, syntquant, NPhead,
              SpecQ, DefSpec have default value                        *)
         >

      DECOMP
         <
          C1: (fem IN CNVARrec1.generos) AND
              (PRONPVARrec1 = 
                      { req           : CNVARrec1.req
                        env           : CNVARrec1.env
                        supertiempo   : CNVARrec1.supertiempo
                        class         : CNVARrec1.class
                        tiempo        : CNVARrec1.tiempo
                        aspecto       : CNVARrec1.aspecto
                        retro         : CNVARrec1.retro
                        definite      : def
                        numero        : CNVARrec1.numero
                        persona       : 3
                        genero        : fem
                        actsubcs      : CNVARrec1.actsubcs
                        temporal      : CNVARrec1.temporal
                        animate       : CNVARrec1.animate
                        human         : CNVARrec1.human
                        actcomas      : CNVARrec1.posscomas
                        thetanp       : CNVARrec1.thetanp
                        nounpatternefs: CNVARrec1.nounpatternefs
                        cases         : CNVARrec1.cases
                        index         : 0
                         })
                   (* the other attributes have default value *)
          A1: @
         >
>
&

\end{verbatim}
