(*MPF:::===================================================================*
 *
 *  Procedure Name  : HyperDtree_SaveOrigin
 *  Description     : Saves the Stree from which d resulted.
 *  Parameters      : t : HyperDtree_pStree;
 *                    VAR d : HyperDtree_pHyperDtree
 *  Precondition    : d subset of  MParser(CAST LIStree_pStree(t))
 *  Postcondition   : HyperDtree_IsOriginSaved(d)
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE HyperDtree_SaveOrigin (first, last : HyperDtree_pLoStree;
                                            VAR d : HyperDtree_pHyperDtree);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : HyperDtree_IsOriginSaved
 *  Description    : Tells whether the stree from which this dtree resulted
 *                   has been saved.
 *  Parameters     : d : HyperDtree_pHyperDtree
 *  Result         : TRUE iff the stree from which this dtree resulted has been
 *                   saved.
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION HyperDtree_IsOriginSaved (d : HyperDtree_pHyperDtree)
                    : BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name : HyperDtree_ReturnOrigin
 *  Description    : Returns the Stree from which this dtree resulted
 *  Parameters     : d : HyperDtree_pHyperDtree
 *  Result         : HyperDtree_pStree
 *  Precondition   : HyperDtree_IsOriginSaved(d)
 *  Postcondition  : RETURNS ts AND ts CAST LIStree_pSetOfStrees = M-Generator(d)
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

PROCEDURE HyperDtree_ReturnOrigin (d : HyperDtree_pHyperDtree;
                                         VAR first, last: HyperDtree_pLoStree);
EXTERNAL;


END {HyperDtree};
