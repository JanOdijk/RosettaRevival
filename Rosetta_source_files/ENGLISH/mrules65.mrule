\begin{verbatim}
% RULE RQPCOMPARATIVEcomplmod

< m1: QP{QPrec1}[head/Q{Qrec1}]
  m2: T1
>

< m : QP{QPrec1}[head/Q{Qrec1},
                 thanascomplrel/THANP{THANPrec1}
                         [head/THANAS(KEY_thanthanaskey){THANASrec1},
                          I2:complrel/T2
                         ]
                    ]
>

   MATCHCONDITIONS
      < m1: QPrec1.thanas = thancompl
        m2: T1.CAT IN [NPVAR, CNVAR, ADVP, PREPP, QP, DETP, OPENADJPPROP]
        m : QPrec1.thanas = thancompl 
        I2: (T2.CAT IN [NPVAR, CNVAR] 
                 WITH T2.REC.cases = []) OR
            (T2.CAT IN [ADVP, PREPP, QP, DETP, ADJP] )
      >

<
   SUBRULE (* 1: PREPP *)
      < T1: PREPP{PREPPrec1}[mu1] >
      < T2: PREPP{PREPPrec2}[mu1] >

      COMP
         <
          C1: PREPPrec1.superdeixis = QPrec1.superdeixis
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: PREPPrec2.superdeixis = omegadeixis
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.superdeixis := QPrec1.superdeixis;
         >

   SUBRULE (* 2: ADVP *)
      < T1: ADVP{ADVPrec1}[mu1] >
      < T2: ADVP{ADVPrec2}[mu1] >

      COMP
         <
          C1: ADVPrec1.superdeixis = QPrec1.superdeixis
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: ADVPrec2.superdeixis = omegadeixis
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := QPrec1.superdeixis;
         >


   SUBRULE (* 3 *) (* more than possible *)

      <T1: OPENADJPPROP{OPENADJPPROPrec3}
                  [subjrel/EMPTY(KEY_zeroemptykey){EMPTYrec1},
                   predrel/ADJP{ADJPrec3}[mu2] 
                  ]
      >

      <T2: ADJP{ADJPrec3}[mu2] >


     COMP
         <
          C1: OPENADJPPROPrec3.superdeixis = QPrec1.superdeixis
          A1: @

         >
      DECOMP
         <
          C1: true
          A1: OPENADJPPROPrec3 := COPYT_ADJPtoADJPPROP(ADJPrec3);
              OPENADJPPROPrec3.aktionsarts := [stative];
              OPENADJPPROPrec3.prosubject := true;
              OPENADJPPROPrec3.superdeixis := QPrec1.superdeixis;
         >


   SUBRULE (* 4: QP *)

      < T1: QP{QPrec3}[mu1] >
      < T2: QP{QPrec4}[mu1] >

      COMP
         <
          C1: QPrec3.superdeixis = QPrec1.superdeixis
          A1: QPrec4 := QPrec3;
              QPrec4.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: QPrec4.superdeixis = omegadeixis
          A1: QPrec3 := QPrec4;
              QPrec3.superdeixis := QPrec1.superdeixis;
         >

   SUBRULE (* 5: NPVAR *)
      < T1: NPVAR{NPVARrec1} >
      < T2: NPVAR{NPVARrec2} >

(*case is dealt with by TQPAccCaseassignment *)

      COMP
         <
          C1: NPVARrec1.superdeixis = QPrec1.superdeixis
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.superdeixis := omegadeixis;           
         >
      DECOMP
         <
          C1: NPVARrec2.superdeixis = omegadeixis
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.superdeixis := QPrec1.superdeixis;
         >

   SUBRULE (* 6: CNVAR *)
      < T1: CNVAR{CNVARrec1} >
      < T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: CNVARrec1.superdeixis = QPrec1.superdeixis
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.superdeixis := omegadeixis;
         >

      DECOMP
         <
          C1: CNVARrec1.superdeixis = omegadeixis
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.superdeixis := QPrec1.superdeixis;
         >

SUBRULE (* 7 *) (* less than three; provisional account to be replaced by
                   a rule that modifies a NUM that is the head of DETP (within
                   subgrammar DETPformation)  *)

      < T1: DETP{DETPrec1}[mu9] >
      < T2: DETP{DETPrec2}[mu9] >
 
      COMP
         <
          C1: DETPrec1.superdeixis = QPrec1.superdeixis AND
              DETPrec1.definite = indef
          A1: DETPrec2 := DETPrec1;
              DETPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: DETPrec2.superdeixis = omegadeixis AND
              DETPrec2.definite = indef
          A1: DETPrec1 := DETPrec2;
              DETPrec1.superdeixis := QPrec1.superdeixis;
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RQPCOMPARATIVEcomplmod
\item[* relevant examples:] less than Pete, more than ever, longer than me
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] QPformation
\item[* class:] (name of rule, transformation or filter class)
\item[* date of creation:] 11-MAY-1988 14:25:08  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 27/10/88\ \ \ \ \ author: Lisette Appelo
\item date: 31/07/89\ \ \ \ \ author: Margreet Sanders\\
Set required cases to [] i.s.o. [nominative] ([] is English default).\\
\end{enumerate}
\item[* task:]Introduction of a comparative complement to {\em more} or
{\em less}.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: Probably it might be necesary to have an attribute for QP 
indicating the syntactic category of T1 under complrel. In earlier versions of
the domain
the attribute thanascompl in ASPrecord and THANPrecord was supposed to
keep track of this information. According to a domain modification in august 87
this attribute has a new dunction in QP ( and accordingly a new value set): it
indicates the kind of complement a certain quantifier or adverb inherently has.
\\ 
\item modifications:27/10/88: Splitting into subrules. Superdeixis condition/
actions for XP categories added.\\

\end{enumerate}
\end{description}
