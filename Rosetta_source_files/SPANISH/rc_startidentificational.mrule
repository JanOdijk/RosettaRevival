\begin{verbatim}
 RULE RIdentSentadvVar (removed by JO)
< m1: NPPROP{NPPROPrec1}
                [ mu1,
                  idrel/T1,
                  mu3
                ]

  m2: T2
>

< m :NPPROP{NPPROPrec1}
                [ leftdislocrel/T2,
                  mu1,
                  idrel/T1,
                  mu3 
                ]
>

<
   SUBRULE (* 1. ADVP *)
      < T2: ADVPVAR{ADVPVARrec1} >
      < T2: ADVPVAR{ADVPVARrec1} >

   MATCHCONDITIONS
      <
       T2: ADVPVARrec1.actsubcefs * [sentadv, causadv] <> []
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. PREPPVAR *)
      < T2: PREPPVAR{PREPPVARrec1} >
      < T2: PREPPVAR{PREPPVARrec1} >

   MATCHCONDITIONS
      <
       T2: caus IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
