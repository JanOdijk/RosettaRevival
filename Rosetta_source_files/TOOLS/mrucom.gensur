
%UTT
BASIS RULE
  UTT = IDENTIFIER/6.IDENTIFIER/7.PROCENT/5.
         {RULESPEC/1|FILTERSPEC/3|SUBGRAMMARSPEC/4}.
        PROCENT/5

SURFACE PART
  VAR numofrules,numoftransforms,numoffilters,numofsubgrammars::int;
      language:TSTRING_string;
      filenumber:TSTRING_string;
      dtreenames::setofidents;
      id::ident;

<*
 INIT:BEGIN initsetofidents(dtreenames);
         numofrules:=0;numoftransforms:=0;numofsubgrammars:=0;numoffilters:=0
       END;
 1    :<*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          IF %RULESPEC.mrule THEN
                            numofrules:=numofrules+1
                          ELSE numoftransforms:=numoftransforms+1;
                          id.str:=%RULESPEC.dtreename;
                          IF TSTRING_length(id.str)<>0 THEN
                              appendident(id,dtreenames);
                          WHILE stillidents(%RULESPEC.setofnames) DO
                            BEGIN
                            takeident(id,%RULESPEC.setofnames);
                            appendident(id,dtreenames);
                            END;
                          END
       *>
 3    :<*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN numoffilters:=numoffilters+1
                         END
       *>
 4    :<*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         numofsubgrammars:=numofsubgrammars+1
                         END
       *>
 5    :<*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                          END
       *>
 6    :<*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN language:=%.str
                          END
       *>
 7    :<*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN filenumber:=%.str
                          END
       *>
 FINAL: #CONDITION: TRUE
         #ACTION: BEGIN
                  SEND_UTT;
                  $UTT.dtreenames:=dtreenames;
                  $UTT.numofrules:=numofrules;
                  $UTT.numoftransforms:=numoftransforms;
                  $UTT.numofsubgrammars:=numofsubgrammars;
                  $UTT.numoffilters:=numoffilters;
                  $UTT.language:=language;
                  $UTT.filenumber:=filenumber
                  END
*>
END;
PROCEDURAL PART
VAR filenumber:TSTRING_string;
    language:TSTRING_string;
    dtreenames,dtreenames1::setofidents;
    id::ident;
    H: MEM_Stackptr;
BEGIN
INIT:BEGIN TFILES_open(cofenv1,'cofenv',6,3);
           TFILES_open(cofpas1,'cofpas',6,3);
{           TFILES_open(varpool1,'varpool',7,3);}
           TFILES_open(decofenv1,'decofenv',8,3);
           TFILES_open(decofpas1,'decofpas',8,3);
           dtreenames:=$UTT.dtreenames;
           language:=$UTT.language;
           filenumber:=$UTT.filenumber;
           BEGIN \cofpas1.\GLOBAL.
"EXPORT(commrules);"\\
"pragma C_include('globsubst.pf');"\\
"pragma C_include('listree.pf');"\\
"pragma C_include('limatches.pf');"\\
"pragma C_include('lsmatches.pf');"\\
"pragma C_include('lidomaint.pf');"\\
"pragma C_include('liiddict.pf');"\\
"pragma C_include('lsdomaint.pf');"\\
"pragma C_include('maket.pf');"\\
"pragma C_include('lsstree.pf');"\\
"pragma C_include('copyt.pf');"\\
"pragma C_include('string.pf');"\\
"pragma C_include('mem.pf');"\\
IF stillidents(dtreenames) THEN BEGIN
"pragma C_include('lsparams.pf');"\\
"pragma C_include('ldmrules.pf');"\\
END;
"pragma C_include('gidderiv.pf');"\\
"pragma C_include('hyperdtree.pf');"\\
"pragma C_include('strtokey.pf');"\\
"pragma C_include('lsmruquo.pf');"\\
"pragma C_include('lsauxdom.pf');"\\
"pragma C_include('ldblex.pf');"\\
"PACKAGE comMrules;" \\
"WITH listree,lsdomaint;"\\
"pragma C_include('commrules" ""filenumber"" ".pf');"\\
"END;"\\
                           "PROGRAM comMrules" ""filenumber"" ";" \\
"WITH globsubst,listree,limatches,lsmatches,"\\
"lidomaint,liiddict,lsdomaint,maket,lsstree,"\\
"copyt,mem,"
IF stillidents(dtreenames) THEN BEGIN
"lsparams,ldmrules," END;\\
"gidderiv,hyperdtree,strtokey,lsmruquo,"\\
"lsauxdom,ldblex;"\\
                           "TYPE synrelset=SET OF LSDOMAINT_synrel;"\\
                           "VAR hulpstree:LISTREE_pstree;"\\
                            " VPID:LSDOMAINT_synpatternsettype;"\\
                                "hulplsstree:LSSTREE_pstree;"\\
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              "dtree" ""id.str"" ":HYPERDTREE_pHYPERDTREE;"\\
                              END;
                            IF stillidents(dtreenames) THEN
                             BEGIN
                             "X1,X2,X3,X4,X5:INTEGER;"\\
                             END;
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              ""id.str"" "d1," ""id.str"" "d2," \\""id.str"" "d3,"\\
                              ""id.str"" "d4," ""id.str"" "d5," \\""id.str"" "d6,"\\
                              ""id.str"" "d7," ""id.str"" "d8," \\""id.str"" "d9,"  
                              ""id.str"" "d10," ""id.str"" "d11," \\""id.str"" "d12,"\\  
                              ""id.str"" "d13," ""id.str"" "d14," \\
""id.str"" "d15:HYPERDTREE_pHyperDtree;"\\
                              ""id.str"" "delt1," ""id.str"" "delt2," \\
                              ""id.str"" "delt3," ""id.str"" "delt4," \\
                              ""id.str"" "delt5," ""id.str"" "delt6," \\
                              ""id.str"" "delt7," ""id.str"" "delt8," \\
                              ""id.str"" "delt9," ""id.str"" "delt10," \\
                              ""id.str"" "delt11," ""id.str"" "delt12," \\
                              ""id.str"" "delt13," ""id.str"" "delt14," \\
                              ""id.str"" "delt15," ""id.str"" "delt16," \\
                              ""id.str"" "delt17:HYPERDTREE_pHyperNodeElt;"\\
                              END;
                            BEGIN
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              "FUNCTION crdtree" ""id.str""
                               ":HYPERDTREE_phyperdtree;FORWARD;"\\
                              END;
                            " PROCEDURE commrules" ""filenumber"" 
                                 "_init;"\\
                            "BEGIN"\\
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              "dtree" ""id.str"" 
                                 ":=crdtree" ""id.str"" ";"\\
                              END;
                            "END;"\\
{                              "FUNCTION auxkey(strkey:STRING_string):INTEGER;"\\
                              "VAR int:INTEGER;"\\
                              "BEGIN"\\
                              " STRTOKEY_getSkey(strkey,int); auxkey:=int;"\\
                              "END;"\\
                              "PROCEDURE MatchList0Items";
                              "(L:LSSTREE_pRelNode;first:Boolean;VAR match:Boolean);"\\
                              "BEGIN"\\
                              TAB(cofpas1,2);
                              "IF first THEN match := (L=NIL) ELSE match:=FALSE"\\
                              "END;"\\
                            END;
                            BEGIN
                            "FUNCTION numberofelements(L:LSMRUQUO_Listofstrees):INTEGER;"\\
                              "VAR result:INTEGER;"\\
                              "BEGIN"\\
                              "result:=0;"\\
                              "WHILE L.first<>NIL DO"\\
                              " BEGIN"\\
                              " result:=result+1;"\\
                              " L.first:=L.first^.brother"\\
                              " END;"\\
                              "numberofelements:=result"\\
                              "END;"\\
                            "PROCEDURE copylist(L1:LSMRUQUO_Listofstrees;"
                             "VAR L2:LSMRUQUO_Listofstrees);"\\
                              "VAR p,p1:LSSTREE_prelnode;"\\
                              "BEGIN"\\
                              "IF L1.first=NIL THEN L2:=L1"\\
                              "ELSE"\\
                              " BEGIN"\\
                              " LISTREE_makerelnode(loopholes.retype"
                                  "(p1,LISTREE_prelnode));"\\
                              " p:=p1;"\\
                              " p1^:=L1.first^;"\\
                              " p1^.brother:=NIL;"\\
                              " L2.first:=p1;"\\
                              " WHILE L1.first<>L1.last DO"\\
                              "  BEGIN"\\
                              "  L1.first:=L1.first^.brother;"\\
                              "  LISTREE_makerelnode(loopholes.retype"
                                 "(p1,LISTREE_prelnode));"\\
                              "  p^.brother:=p1;"\\
                              "  p:=p1;"\\
                              "  p1^:=L1.first^;"\\
                              "  p1^.brother:=NIL;"\\
                              "  END;"\\
                              " L2.last:=p"\\
                              " END;"\\
                              "END;"\\}
                            END;
                            BEGIN
{                              "PROCEDURE SelectLfirstAndLlast";
                              "(VAR Lfirst,Llast,Lrest:LSSTREE_pRelNode;"\\
                              TAB(cofpas1,10);
                              "VAR NoMoreTrees:BOOLEAN;"\\
                              TAB(cofpas1,10);
                              "L:LSSTREE_pRelNode);"\\
                              "BEGIN"\\
                              TAB(cofpas1,2);
                              "IF L=NIL THEN nomoretrees:=TRUE"\\
                              TAB(cofpas1,2);
                              "ELSE"\\
                              TAB(cofpas1,4);
                              "BEGIN"\\
                              TAB(cofpas1,4);
                              "IF Lfirst=NIL THEN"\\
                              TAB(cofpas1,6);
                              "BEGIN"\\
                              TAB(cofpas1,6);
                              "Lfirst:=L;"\\
                              TAB(cofpas1,6);
                              "Llast:=Lfirst;"\\
                              TAB(cofpas1,6);
                              "Lrest:=Llast^.brother;"\\
                              TAB(cofpas1,6);
                              "END"\\
                              TAB(cofpas1,4);
                              "ELSE"\\
                              TAB(cofpas1,6);
                              "IF Lrest=NIL THEN "\\
                              TAB(cofpas1,8);
                              "NoMoreTrees:=TRUE"\\
                              TAB(cofpas1,6);
                              "ELSE"\\
                              TAB(cofpas1,6);
                              "BEGIN"\\
                              TAB(cofpas1,8);
                              "Llast:=Llast^.brother;"\\
                              TAB(cofpas1,8);
                              "Lrest:=Llast^.brother;"\\
                              TAB(cofpas1,6);
                              "END"\\
                              TAB(cofpas1,4);
                              "END"\\
                              "END;{SelectLfirstAndLlast"\\\\ }
{                              "PROCEDURE TcelesLfirstAndLlast";
                              "(VAR Lfirst,Llast,Lrest:LSSTREE_pRelNode;"\\
                              TAB(cofpas1,10);
                              "VAR NoMoreTrees:BOOLEAN;"\\
                              TAB(cofpas1,10);
                              "L:LSSTREE_pRelNode);"\\
                              "BEGIN"\\
                              "IF (L=NIL) OR (Lrest=NIL) THEN nomoretrees:=TRUE"\\
                              "ELSE"\\
                                TAB(cofpas1,2);
                                "BEGIN"\\
                                TAB(cofpas1,2);
                                "IF Lfirst=NIL THEN"\\
                                TAB(cofpas1,4);
                                  "BEGIN"\\
                                TAB(cofpas1,4);
                                  "Llast:=Lrest;"\\
                                TAB(cofpas1,4);
                                  "Lfirst:=Lrest"\\
                                TAB(cofpas1,4);
                                  "END"\\
                                TAB(cofpas1,2);
                                "ELSE"\\
                                TAB(cofpas1,4);
                                  "BEGIN"\\
                                TAB(cofpas1,4);
                                  "Lfirst:=Lrest"\\
                                TAB(cofpas1,4);
                                  "END;"\\
                                TAB(cofpas1,2);
                                "IF Lfirst=L THEN Lrest:=NIL"\\
                                TAB(cofpas1,2);
                                "ELSE"\\
                                TAB(cofpas1,4);
                                  "BEGIN"\\
                                TAB(cofpas1,4);
                                  "Lrest:=L;"\\
                                TAB(cofpas1,4);
                                  "WHILE Lrest^.brother<>Lfirst DO"\\
                                TAB(cofpas1,6);
                                    "BEGIN"\\
                                TAB(cofpas1,6);
                                    "Lrest:=Lrest^.brother"\\
                                TAB(cofpas1,6);
                                    "END"\\
                                TAB(cofpas1,4);
                                  "END"\\
                                TAB(cofpas1,2);
                                "END"\\
                              "END;{TcelesLfirstAndLlast"\\\\ }
                              END

           END;
           BEGIN \decofpas1.\GLOBAL.
"EXPORT(decommrules);"\\
"pragma C_include('globsubst.pf');"\\
"pragma C_include('listree.pf');"\\
"pragma C_include('limatches.pf');"\\
"pragma C_include('lsmatches.pf');"\\
"pragma C_include('lidomaint.pf');"\\
"pragma C_include('liiddict.pf');"\\
"pragma C_include('lsdomaint.pf');"\\
"pragma C_include('maket.pf');"\\
"pragma C_include('lsstree.pf');"\\
"pragma C_include('copyt.pf');"\\
"pragma C_include('string.pf');"\\
"pragma C_include('mem.pf');"\\
IF stillidents(dtreenames) THEN BEGIN
"pragma C_include('lsparams.pf');"\\
"pragma C_include('ldmrules.pf');"\\
END;
"pragma C_include('aidderiv.pf');"\\
"pragma C_include('hyperdtree.pf');"\\
"pragma C_include('strtokey.pf');"\\
"pragma C_include('lsmruquo.pf');"\\
"pragma C_include('lsauxdom.pf');"\\
"pragma C_include('ldblex.pf');"\\
"PACKAGE decommrules;" \\
"WITH listree,lsdomaint;"\\
"pragma C_include('decommrules" ""filenumber"" ".pf');"\\
"END;"\\
                           "PROGRAM decomMrules" ""filenumber"" ";" \\
"WITH globsubst,listree,limatches,lsmatches,"\\
"lidomaint,liiddict,lsdomaint,maket,lsstree,"\\
"copyt,mem,"
IF stillidents(dtreenames) THEN BEGIN
"lsparams,ldmrules," END;\\
"aidderiv,hyperdtree,strtokey,lsmruquo,"\\
"lsauxdom,ldblex;"\\
                           "TYPE synrelset=SET OF LSDOMAINT_synrel;"\\
                           "VAR hulpstree:LISTREE_pstree;"\\
                            " VPID:LSDOMAINT_synpatternsettype;"\\
                                "hulplsstree:LSSTREE_pstree;"\\
                           IF stillidents(dtreenames) THEN
                             BEGIN
                             " lsps:LSPARAMS_precord;"\\
                             END;
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              "dtree" ""id.str"" ":HYPERDTREE_pHYPERDTREE;"\\
                              END;
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              ""id.str"" "d1," ""id.str"" "d2," \\""id.str"" "d3,"  \\
                              ""id.str"" "d4," ""id.str"" "d5," \\""id.str"" "d6,"  \\
                              ""id.str"" "d7," ""id.str"" "d8," \\""id.str"" "d9,"  
                              ""id.str"" "d10," ""id.str"" "d11," \\""id.str"" "d12,"\\  
                              ""id.str"" "d13," ""id.str"" "d14," \\""id.str"" 
"d15:HYPERDTREE_pHyperDtree;"\\
                              ""id.str"" "delt1," ""id.str"" "delt2," \\
                              ""id.str"" "delt3," ""id.str"" "delt4," \\
                              ""id.str"" "delt5," ""id.str"" "delt6," \\
                              ""id.str"" "delt7," ""id.str"" "delt8," \\
                              ""id.str"" "delt9," ""id.str"" "delt10," \\
                              ""id.str"" "delt11," ""id.str"" "delt12," \\
                              ""id.str"" "delt13," ""id.str"" "delt14," \\
                              ""id.str"" "delt15," ""id.str"" "delt16," \\
                              ""id.str"" "delt17:HYPERDTREE_pHyperNodeElt;"\\
                              END;
                            IF stillidents(dtreenames) THEN
                             BEGIN
                             "X1,X2,X3,X4,X5:INTEGER;"\\
                             END;
                            BEGIN
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              "FUNCTION crdtree" ""id.str""
                               ":HYPERDTREE_phyperdtree;FORWARD;"\\
                              END;
                            " PROCEDURE decommrules" ""filenumber"" 
                               "_init;"\\
                            "BEGIN"\\
                            dtreenames1:=dtreenames;
                            WHILE stillidents(dtreenames1) DO
                              BEGIN
                              takeident(id,dtreenames1);
                              "dtree" ""id.str"" 
                                 ":=crdtree" ""id.str"" ";"\\
                              END;
                            "END;"\\
{                              "FUNCTION auxkey(strkey:STRING_string):INTEGER;"\\
                              "VAR int:INTEGER;"\\
                              "BEGIN"\\
                              " STRTOKEY_getSkey(strkey,int); auxkey:=int;"\\
                              "END;"\\
                              "PROCEDURE MatchList0Items";
                              "(L:LSSTREE_pRelNode;first:Boolean;VAR match:Boolean);"\\
                              "BEGIN"\\
                              TAB(decofpas1,2);
                              "IF first THEN match := (L=NIL) ELSE match:=FALSE"\\
                              "END;"\\
                            END;
                            BEGIN
                            "FUNCTION numberofelements"
                                 "(L:LSMRUQUO_Listofstrees):INTEGER;"\\
                              "VAR result:INTEGER;"\\
                              "BEGIN"\\
                              "result:=0;"\\
                              "WHILE L.first<>NIL DO"\\
                              " BEGIN"\\
                              " result:=result+1;"\\
                              " L.first:=L.first^.brother"\\
                              " END;"\\
                              "numberofelements:=result"\\
                              "END;"\\
                            "PROCEDURE copylist(L1:LSMRUQUO_Listofstrees;"
                                     "VAR L2:LSMRUQUO_Listofstrees);"\\
                              "VAR p,p1:LSSTREE_prelnode;"\\
                              "BEGIN"\\
                              "IF L1.first=NIL THEN L2:=L1"\\
                              "ELSE"\\
                              " BEGIN"\\
                              " LISTREE_makerelnode(loopholes.retype"
                                 "(p1,LISTREE_prelnode));"\\
                              " p:=p1;"\\
                              " p1^:=L1.first^;"\\
                              " p1^.brother:=NIL;"\\
                              " L2.first:=p1;"\\
                              " WHILE L1.first<>L1.last DO"\\
                              "  BEGIN"\\
                              "  L1.first:=L1.first^.brother;"\\
                              "  LISTREE_makerelnode(loopholes.retype"
                                 "(p1,LISTREE_prelnode));"\\
                              "  p^.brother:=p1;"\\
                              "  p:=p1;"\\
                              "  p1^:=L1.first^;"\\
                              "  p1^.brother:=NIL;"\\
                              "  END;"\\
                              " L2.last:=p"\\
                              " END;"\\
                              "END;"\\}
                            END;
                            BEGIN
{                              "PROCEDURE SelectLfirstAndLlast";
                              "(VAR Lfirst,Llast,Lrest:LSSTREE_pRelNode;"\\
                              TAB(decofpas1,10);
                              "VAR NoMoreTrees:BOOLEAN;"\\
                              TAB(decofpas1,10);
                              "L:LSSTREE_pRelNode);"\\
                              "BEGIN"\\
                              TAB(decofpas1,2);
                              "IF L=NIL THEN nomoretrees:=TRUE"\\
                              TAB(decofpas1,2);
                              "ELSE"\\
                              TAB(decofpas1,4);
                              "BEGIN"\\
                              TAB(decofpas1,4);
                              "IF Lfirst=NIL THEN"\\
                              TAB(decofpas1,6);
                              "BEGIN"\\
                              TAB(decofpas1,6);
                              "Lfirst:=L;"\\
                              TAB(decofpas1,6);
                              "Llast:=Lfirst;"\\
                              TAB(decofpas1,6);
                              "Lrest:=Llast^.brother;"\\
                              TAB(decofpas1,6);
                              "END"\\
                              TAB(decofpas1,4);
                              "ELSE"\\
                              TAB(decofpas1,6);
                              "IF Lrest=NIL THEN "\\
                              TAB(decofpas1,8);
                              "NoMoreTrees:=TRUE"\\
                              TAB(decofpas1,6);
                              "ELSE"\\
                              TAB(decofpas1,6);
                              "BEGIN"\\
                              TAB(decofpas1,8);
                              "Llast:=Llast^.brother;"\\
                              TAB(decofpas1,8);
                              "Lrest:=Llast^.brother;"\\
                              TAB(decofpas1,6);
                              "END"\\
                              TAB(decofpas1,4);
                              "END"\\
                              "END;{SelectLfirstAndLlast"\\\\ }
{                              "PROCEDURE TcelesLfirstAndLlast";
                              "(VAR Lfirst,Llast,Lrest:LSSTREE_pRelNode;"\\
                              TAB(decofpas1,10);
                              "VAR NoMoreTrees:BOOLEAN;"\\
                              TAB(decofpas1,10);
                              "L:LSSTREE_pRelNode);"\\
                              "BEGIN"\\
                              "IF (L=NIL) OR (Lrest=NIL) THEN nomoretrees:=TRUE"\\
                              "ELSE"\\
                                TAB(decofpas1,2);
                                "BEGIN"\\
                                TAB(decofpas1,2);
                                "IF Lfirst=NIL THEN"\\
                                TAB(decofpas1,4);
                                  "BEGIN"\\
                                TAB(decofpas1,4);
                                  "Llast:=Lrest;"\\
                                TAB(decofpas1,4);
                                  "Lfirst:=Lrest"\\
                                TAB(decofpas1,4);
                                  "END"\\
                                TAB(decofpas1,2);
                                "ELSE"\\
                                TAB(decofpas1,4);
                                  "BEGIN"\\
                                TAB(decofpas1,4);
                                  "Lfirst:=Lrest"\\
                                TAB(decofpas1,4);
                                  "END;"\\
                                TAB(decofpas1,2);
                                "IF Lfirst=L THEN Lrest:=NIL"\\
                                TAB(decofpas1,2);
                                "ELSE"\\
                                TAB(decofpas1,4);
                                  "BEGIN"\\
                                TAB(decofpas1,4);
                                  "Lrest:=L;"\\
                                TAB(decofpas1,4);
                                  "WHILE Lrest^.brother<>Lfirst DO"\\
                                TAB(decofpas1,6);
                                    "BEGIN"\\
                                TAB(decofpas1,6);
                                    "Lrest:=Lrest^.brother"\\
                                TAB(decofpas1,6);
                                    "END"\\
                                TAB(decofpas1,4);
                                  "END"\\
                                TAB(decofpas1,2);
                                "END"\\
                              "END;{TcelesLfirstAndLlast"\\\\ }
                              END

           END;
           BEGIN \cofenv1.\GLOBAL.
                            "{*" ""language"" "}"\\
                            " PROCEDURE commrules" ""filenumber"" 
                                 "_init;EXTERNAL;"\\
           END;
           BEGIN \decofenv1.\GLOBAL.
                            " PROCEDURE decommrules" ""filenumber"" 
                                 "_init;EXTERNAL;"\\
           END;

     END;
<*
   1: <* SEND: BEGIN MEM_markdefault(H) END
         !RULESPEC.
         RECEIVE: BEGIN MEM_releasedefault(H)
                  END
      *>
   3: <* SEND: BEGIN MEM_markdefault(H) END
         !FILTERSPEC.
         RECEIVE: BEGIN MEM_releasedefault(H)
                  END
      *>
