\newpage
\begin{verbatim}
%
% RULE RpreppvarINvp
< m1:VERBPPROP{VERBPPROPrec1}
             [ mu1, 
               predrel/VERBP{VERBPrec1}[mu2],
               mu3
             ] 
  m2:PREPPVAR{PREPPVARrec1}
>

< m :VERBPPROP{VERBPPROPrec1}       
             [ mu1, 
               predrel/VERBP{VERBPrec1}
                            [ mu2,
                              vpadvrel/PREPPVAR{PREPPVARrec1}
                            ],  (* instradvrel niet in domain *)
               mu3
             ] 
>



      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
