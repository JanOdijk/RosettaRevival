       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION: haakjescounter=0
       #ACTION: BEGIN SEND_PASCALSTATEMENT; END
*>
END;
PROCEDURAL PART
VAR copy,copy1:LOCALFILE;
    decomkeyname,str1,str2,str3,str4,attrstr,nodetreestr:TSTRING_string;
    vartype::vartype;
    vartypes,vartypes1::setofvartypes;
    found:BOOLEAN;
    varkind::varkindtype;
    cattable::setofidents;
    cat::ident;
    before,after::bool;
    idargs:LOCALFILE;
    ch:CHAR;
    argcounter::int;
    keypresent,treeornodecat,nodecatje::bool;
BEGIN
INIT: BEGIN found:=FALSE; INITLOCALFILE(copy1);treeornodecat:=FALSE;nodecatje:=FALSE;
            INITLOCALFILE(copy);vartypes:=$$PASCALSTATEMENT.vartypes;
            INITLOCALFILE(idargs);
            keypresent:=false;
            argcounter:=0;
            before:=FALSE;after:=FALSE;
      END;
<*
1: <* SEND: BEGIN \copy.\LOCAL. IF NOT treeornodecat THEN ":" END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN BEGIN \copy.\LOCAL. END;
                     str1:=%VARNAME.str1;
                     str2:=%VARNAME.str2;
                     IF (%VARNAME.varkind=treecat) THEN 
writeln('WARNING, ',str1,'.CAT:= not implemented, but Ni.CAT:= is');
                     treeornodecat:=(%VARNAME.varkind=nodecat) OR
                                    (%VARNAME.varkind=treecat);
                     nodecatje:=(%VARNAME.varkind=nodecat);
                     IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec)
                     THEN IF NOT treeornodecat THEN
                       BEGIN
                       ""str1""
                       IF TSTRING_length(str2)<>0
                       THEN 
                         BEGIN
                         "." ""str2""
                         END;
                       END;
                     IF (%VARNAME.varkind=noderec) OR (%VARNAME.varkind=treerec)
                     THEN
                       BEGIN
                       before:=TRUE;
                       varkind:=%VARNAME.varkind;
                       vartypes1:=vartypes;
                       found:=FALSE;
                       WHILE stillvartypes(vartypes1) AND NOT(found) DO
                         BEGIN
                         takevartype(vartype,vartypes1);
                         found:=TSTRING_compare(str1,vartype.varname)=0;
                         END;
                       IF found THEN cattable:=vartype.cattable
                       ELSE writeln('ERROR, ',str1,'.REC not guarded');
                       END;
               END
   *>
3: <* SEND: BEGIN END
      !VALUENAME.
      RECEIVE: BEGIN IF treeornodecat THEN
                       BEGIN
                       nodetreestr:=str1;
                       \copy.\LOCAL.
                       IF nodecatje THEN BEGIN "hulplsstree" END
                       ELSE ""nodetreestr"" 
                       ":= MAKET_stree("
                       END;
                     str1:=%%VALUENAME.string;
                     ""str1""
                     IF treeornodecat THEN ");"\\
                     IF nodecatje THEN
                       BEGIN
                       ""nodetreestr"" ":=hulplsstree^.ls^;"\\ 
                       END;
               END
   *>
4: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN
                     BEGIN \copy.\LOCAL. END;
                     APPENDLOCFILE(%%SETVALUENAME.copy,copy);
               END
   *>
5: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN BEGIN \copy.\LOCAL. END;
                     IF treeornodecat THEN
                       BEGIN
                       nodetreestr:=str1;
                       IF nodecatje THEN BEGIN "hulplsstree" END
                       ELSE ""nodetreestr"" 
                       ":= MAKET_stree("
                       END;
                     str3:=%VARNAME.str1;
                     str4:=%VARNAME.str2;
                    IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec)
                     THEN
                       BEGIN
                       ""str3""
                       IF TSTRING_length(str4)<>0 THEN 
                         BEGIN
                         "." ""str4""
                         END;
                       END;
                     IF (%VARNAME.varkind=noderec) OR (%VARNAME.varkind=treerec)
                     THEN
                       BEGIN
                       varkind:=%VARNAME.varkind;
                       after:=TRUE;
                       vartypes1:=vartypes;
                       found:=FALSE;
                       WHILE stillvartypes(vartypes1) AND NOT(found) DO
                         BEGIN
                         takevartype(vartype,vartypes1);
                         found:=TSTRING_compare(str3,vartype.varname)=0;
                         END;
                       IF found THEN cattable:=vartype.cattable
                       ELSE writeln('ERROR, ',str3,'.REC not guarded');
                       END;
                     IF treeornodecat THEN ");"\\
                     IF nodecatje THEN
                       BEGIN
                       ""nodetreestr"" ":=hulplsstree^.ls^;"\\ 
                       END;
               END
   *>
6: <* SEND: BEGIN \copy.\LOCAL. "*" END
      !.
      RECEIVE: BEGIN END
   *>
7: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN
                     BEGIN \copy.\LOCAL. END;
                     APPENDLOCFILE(%%SETVALUENAME.copy,copy);
               END
   *>
8: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN BEGIN \copy.\LOCAL. END;
                     str3:=%VARNAME.str1;
                     str4:=%VARNAME.str2;
                    IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec)
                     THEN
                       BEGIN
                       ""str3""
                       IF TSTRING_length(str4)<>0 THEN 
                         BEGIN
                         "." ""str4""
                         END;
                       END;
                     IF (%VARNAME.varkind=noderec) OR (%VARNAME.varkind=treerec)
                     THEN
                       BEGIN
                       after:=TRUE;
                       varkind:=%VARNAME.varkind;
                       vartypes1:=vartypes;
                       found:=FALSE;
                       WHILE stillvartypes(vartypes1) AND NOT(found) DO
                         BEGIN
                         takevartype(vartype,vartypes1);
                         found:=TSTRING_compare(str3,vartype.varname)=0;
                         END;
                       IF found THEN cattable:=vartype.cattable
                       ELSE writeln('ERROR, ',str3,'.REC not guarded');
                       END;
               END
   *>
9: <* SEND: BEGIN  \copy.\LOCAL. "+"END
      !.
      RECEIVE: BEGIN END
   *>
10:<* SEND: BEGIN \copy.\LOCAL. IF NOT treeornodecat THEN "=" END
      !.
      RECEIVE: BEGIN END
   *>
11: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
12: <* SEND: BEGIN str1:=%.str END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. "LSMRUQUO_" ""str1"" END
   *>
13: <* SEND: BEGIN str1:=%.str END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. 
                     if keypresent then "('"
                     ""str1""
                     if keypresent then "')"
               END
   *>
14: <* SEND: BEGIN str1:=%.str END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. ""str1""\\ END
   *>
15: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. ")" END
   *>
16: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. "[" END
   *>
17: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. "]" END
   *>
18: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. "(" END
   *>
19: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. "," END
   *>
20: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. "LSAUXDOM_" END
   *>
21: <* SEND: BEGIN \copy.\LOCAL. "-" END
      !.
      RECEIVE: BEGIN END
   *>
22: <* SEND: BEGIN \copy. str1:=%KEYNAME.str1 END
      !.
      RECEIVE: BEGIN ""str1"" END
   *>
23: <* SEND: BEGIN \copy. str1:=%.str END
      !.
      RECEIVE: BEGIN  "LIMATCHES_" ""str1"" END
   *>
24: <* SEND: BEGIN keypresent:=true END
      !.
      RECEIVE: BEGIN "auxkey" END
   *>
25: <* SEND: BEGIN argcounter:=argcounter+1;str1:=%KEYNAME.str1 END
      !.
      RECEIVE: BEGIN "idargs.argkeys[" """argcounter""" "]:="
                     ""str1"" ";"\\ 
               END
   *>
26: <* SEND: BEGIN str1:=%.str END
      !.
      RECEIVE: BEGIN "ORD(" ""str1"" ")"END
   *>
27: <* SEND: BEGIN argcounter:=argcounter+1;str1:=%KEYNAME.str1 END
      !.
      RECEIVE: BEGIN \idargs.\LOCAL.
                     ""str1"" ":=idargs.argkeys[" 
                     """argcounter""" "];"\\
                     \copy.\LOCAL.
               END
   *>
28: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "idargs.nrargs:=" """argcounter""" ";"\\
                     ""decomkeyname"" ":=LIMATCHES_DECOMPGETIDDICT(idargs"
               END
   *>
29: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "idargs" END
   *>
30: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN ")" END
   *>
31: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \copy.\LOCAL. ");VPID:=[" ""str1"" "];"
                     appendlocfile(idargs,copy);
               END
   *>
32: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN decomkeyname:=%KEYNAME.str1
               END
   *>
*>
FINAL:BEGIN
      IF found THEN
        BEGIN
        \copy1.\LOCAL.
        "CASE " 
        IF before THEN BEGIN ""str1"" END ELSE ""str3""
             "^.cat OF"
        WHILE stillidents(cattable) DO
          BEGIN
          takeident(cat,cattable);
          \\""cat.str"" ":"
          IF after THEN
            BEGIN
            appendlocfile(copy,copy1);\\
            savelocfile(copy,copy);
            END;
          IF before THEN BEGIN ""str1"" END ELSE ""str3""
          IF varkind=treerec THEN BEGIN "^.ls^." END ELSE 
            writeln('Ni.REC.attr := value not yet implemented, but Ti.REC is');
           ""cat.str"" "field^."
          IF before THEN BEGIN ""str2"" END ELSE BEGIN ""str4"" ";" END;
          IF before THEN
            BEGIN
            appendlocfile(copy,copy1);";"\\
            savelocfile(copy,copy);
            END;
          END;
        "otherwise begin "
             "writeln('ERROR from MRUCOM.GENSUR') end;"\\ "END;"\\
        copy:=copy1;
        END;
      $$PASCALSTATEMENT.copy:=copy 
      END
END;
&
 
%PASCALEXPR
BASIS RULE
      PASCALEXPR = EQUALS|OTHEREQUALS|SETBOOLEAN
          EQUALS = (VARNAME/2|VALUENAME/3|SETVALUENAME/6).
                         (ISCAT/20|(LEFTARROW/21.RIGHTARROW/13)).[ROUNDOPEN/38].
                   (VARNAME/4|VALUENAME/5|SETVALUENAME/7).
                         {(STARCAT/24|PLUSCAT/27|MINCAT/37).[ROUNDOPEN/38].
                   (SETVALUENAME/25|VARNAME/26).[ROUNDCLOSE/39]}
     OTHEREQUALS = [ROUNDOPEN/38].(SETVALUENAME/8|VARNAME/9).
                         (STARCAT/36|PLUSCAT/28|MINCAT/37).[ROUNDOPEN/38].
                   (SETVALUENAME/10|VARNAME/11).[ROUNDCLOSE/39].
                   {(STARCAT/36|PLUSCAT/28|MINCAT/37).[ROUNDOPEN/38].
                   (SETVALUENAME/10|VARNAME/11).[ROUNDCLOSE/39]}.
                         (ISCAT/12|(LEFTARROW/32.RIGHTARROW/34)).
                   (SETVALUENAME/14|VALUENAME/3|VARNAME/15)
      SETBOOLEAN = [NOTCAT/22].[ROUNDOPEN/23].
                         (SETVALUENAME/29|VALUENAME/16|VARNAME/17).
                         (INCAT/1|LEFTARROW/33.ISCAT/31|RIGHTARROW/35.ISCAT/31).
                   [ROUNDOPEN/38].(SETVALUENAME/18|VARNAME/19).
                         {(STARCAT/24|PLUSCAT/27|MINCAT/37).[ROUNDOPEN/38].
                   (SETVALUENAME/25|VARNAME/26).[ROUNDCLOSE/39]}.[ROUNDCLOSE/30]
SURFACE PART
