ENGLISH 18

&
\begin{description}
This file contains the following iterative transformations:
\begin{itemize}
\item [Targreflspelling1:] NPVAR in VP; subj=antecedent
\item [Targreflspelling2:] CNVAR in VP; subj=antecedent
\item [Targreflspelling3:] NPVAR in PP in VP; subj=antecedent
\item [Targreflspelling4:] CNVAR in PP in VP; subj=antecedent
\item [Targreflspelling5:] NPVAR in VP; indobj=antecedent
\item [Targreflspelling6:] CNVAR in VP; indobj=antecedent
\item [Targreflspelling7:] NPVAR in PP in VP; indobj=antecedent
\item [Targreflspelling8:] CNVAR in PP in VP; indobj=antecedent
\item [Targreflspelling9:] NPVAR in locargrel in VP
\item [Targreflspelling10:] CNVAR in locargrel in VP
\end{itemize}
Also, a pre- and postrule filter is added. These filters can be found in TC_
argreflspelling1.mrule.\\
The transformation class must be iterative because more reflexives may occur: 
they talked to themselves about themselves. The class might also have been 
called a rule class, but there is no need for that, since the identity of the 
variables is also preserved in translation.

A problem exists for cases where an NPVAR will upon substitution be replaced by 
an NP which contains an element which should be spelled out as a reflexive, 
since the substitution rules follow the reflexive spelling rules: x1 heard x2 
$\rightarrow$ x1 heard [stories about x1].\\[2ex]
Other problems (see also doc.\ 155 pp.\ 6-9): \\
- For long distance anaphors, there also should be a pronoun instead of a 
reflexive: he hated it when she belittled him/$^{*}$himself.\\
Also note that within an NP, a reflexive element is spelled out as a possadj or 
a genitive: you cannot see him from your position, one is always nervous in 
front of one's superiors.
\end{description}
\newpage
\begin{verbatim}
%
% TRANSFORMATION TArgReflSpelling1 (*NPVAR in VP : subj=antec*)
< m1: CLAUSE{CLAUSErec1}
         I1:[ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       rel2/NPVAR{NPVARrec2},
                       mu4
                     ],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
         I1:[ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       rel2/I3::NP{NPrec1}[head/T1],
                       mu4
                     ],
              mu5
            ]
>

   MATCHCONDITIONS
      <
       I1: RIGHTTOLEFT
       m1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
           NOT EXIST (mu3, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../VARPREPP{VARPREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) AND
           NOT EXIST (mu4, [../PREPP{PREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) 
       I3: NPrec1.NPhead = reflNP
       m : NOT EXIST (mu3, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../VARPREPP{VARPREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) AND
           NOT EXIST (mu4, [../PREPP{PREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) 
         I31: NPVARrec3 = NPVARrec1 EXCEPT FOR [cases]
      >

<
   SUBRULE (* 1. myself *)
      < >
      < T1: REFLPRO(AUX_myselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : singular }
          A1: NPrec1 := AUX_NPONmyRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONmyRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 1
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 2. yourself *)
      < >
      < T1: REFLPRO(AUX_yourselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : singular }
          A1: NPrec1 := AUX_NPONyoursgRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONyoursgRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 2
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3a. himself *)
      < >
      < T1: REFLPRO(AUX_himselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: NPrec1 := AUX_NPONhimRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONhimRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 3
                            number : singular }            AND
              NPVARrec1.NPhead <> oneNP                    AND
              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } ) 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3b. herself *)
      < >
      < T1: REFLPRO(AUX_herselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: NPrec1 := AUX_NPONherRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONherRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3c. itself *)
      < >
      < T1: REFLPRO(AUX_itselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              NPVARrec1.genders = [omegagender] AND
              NPVARrec1.sexes = [] 
          A1: NPrec1 := AUX_NPONitRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONitRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              NPVARrec1.genders = [omegagender] AND
              NPVARrec1.sexes = [] 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 4. ourselves *)
      < >
      < T1: REFLPRO(AUX_ourselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : plural }
          A1: NPrec1 := AUX_NPONourRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONourRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 1
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 5. yourselves *)
      < >
      < T1: REFLPRO(AUX_yourselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : plural }
          A1: NPrec1 := AUX_NPONyourplRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONyourplRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 2
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 6. themselves *)
      < >
      < T1: REFLPRO(AUX_themselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : plural }
          A1: NPrec1 := AUX_NPONthemRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONthemRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 3
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 6. oneself *)
      < >
      < T1: REFLPRO(AUX_oneselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1.NPhead = oneNP
          A1: NPrec1 := AUX_NPONoneRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONoneRFLPR EXCEPT FOR [cases] AND
              NPVARrec1.NPhead = oneNP
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >
>
&

\end{verbatim}
