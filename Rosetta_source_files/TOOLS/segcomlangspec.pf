pragma C_include('string.pf');
pragma C_include('segmrules.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE SEGCOMLANGSPEC;
WITH STRNG, SEGMRULES;

CONST
   SEGCOMLANGSPEC_NROW      =   23;
   SEGCOMLANGSPEC_MAXRNR    =   37;

TYPE 
   SEGCOMLANGSPEC_Category  =   (ACAT, GCAT, CCCAT, ENDCAT, FONCAT, FREEFIXCAT,
                                 LGLUE2CAT, LGLUE3CAT, LGLUE4CAT, MGLUE2CAT,
                                 PFKCAT, PREFIXCAT, RGLUE2CAT, RGLUE3CAT, 
                                 RGLUE4CAT, RPREFIXCAT, RSUFFIXCAT, SFKCAT,
                                 SUFFIXCAT, TABLECAT, TYPECAT, VARCAT, MULT,
                                 SEMCOLON, COLON, LBRACK, RBRACK, PLUS, LPAREN,
                                 RPAREN, COMMA, PERIOD, COMMENT, IDENTIFIER, 
                                 EQL, SLASH, LESS, GREATER,
                                 UTT, LGLUEDEF, RGLUEDEF, MGLUEDEF, PREDEF, 
                                 SUFDEF, FREEDEF, LGLUETYPESPEC, VARSPECPART,
                                 LGLUETABLESPEC, RGLUETYPESPEC, RGLUETABLESPEC,
                                 MGLUETYPESPEC, MGLUETABLESPEC, PRETYPESPEC,
                                 PRETABLESPEC, SUFTYPESPEC, SUFTABLESPEC,
                                 FREETYPESPEC, FREETABLESPEC, LGLUEENTRYSPEC,
                                 RGLUEENTRYSPEC, MGLUEENTRYSPEC,
                                 PREENTRYSPEC, SUFENTRYSPEC, FREEENTRYSPEC,
                                 ANGENSPEC, VARSPEC, SETCONSTR, MATCHSTRING,
                                 IDPAIR, ALIASCAT, ALIASSPEC, ALIASSPECPART);

   SEGCOMLANGSPEC_VarList   = ARRAY [1..SEGMRULES_MAXVARS] OF INTEGER;
   SEGCOMLANGSPEC_pTerminal = ^SEGCOMLANGSPEC_Terminal;
   SEGCOMLANGSPEC_Terminal  = RECORD 
                                 str : STRING_String;
                              END;
   SEGCOMLANGSPEC_SetConstrRec = RECORD 
                                    emptyvar : boolean
                                 END;
   SEGCOMLANGSPEC_IdPairRec = RECORD
                                 left, right : STRING_String
                              END;
   SEGCOMLANGSPEC_MatchStringRec = RECORD
                                    str      : STRING_String;
                                    nrvars   : integer;
                                    vars     : SEGCOMLANGSPEC_VarList
                                   END;
   SEGCOMLANGSPEC_AnGenSpecRec = RECORD
                                    agchar : char
                                 END;
   SEGCOMLANGSPEC_FieldDef  = RECORD 
                                 CASE SEGCOMLANGSPEC_Category OF
                                      ACAT, GCAT, ENDCAT, FREEFIXCAT,
                                      LGLUE2CAT, LGLUE3CAT, LGLUE4CAT, MGLUE2CAT,
                                      PREFIXCAT, RGLUE2CAT, RGLUE3CAT, 
                                      RGLUE4CAT, RPREFIXCAT, RSUFFIXCAT, 
                                      SUFFIXCAT, TABLECAT, TYPECAT, VARCAT, MULT,
                                      SEMCOLON, COLON, LBRACK, RBRACK, PLUS, LPAREN,
                                      RPAREN, COMMA, PERIOD, COMMENT, IDENTIFIER, 
                                      EQL, LESS, GREATER, ALIASCAT
                                      : ( terminal : SEGCOMLANGSPEC_pTerminal);
                                      SETCONSTR
                                      : (setconstrfield: SEGCOMLANGSPEC_SetConstrRec);
                                      MATCHSTRING
                                      : (matchstringfield: SEGCOMLANGSPEC_MatchStringRec);
                                      ANGENSPEC
                                      : (angenspecfield: SEGCOMLANGSPEC_AnGenSpecRec);
                                      IDPAIR
                                      : (idpairfield: SEGCOMLANGSPEC_IdPairRec)
                                END;

                                 

PROCEDURE SEGCOMLANGSPEC_Init; EXTERNAL;

PROCEDURE SEGCOMLANGSPEC_Word(i: integer; VAR s: STRING_String);
         EXTERNAL;

FUNCTION SEGCOMLANGSPEC_Wcat(i: integer): SEGCOMLANGSPEC_Category;
         EXTERNAL;

FUNCTION SEGCOMLANGSPEC_Scat(c: CHAR): SEGCOMLANGSPEC_Category;
         EXTERNAL;

PROCEDURE SEGCOMLANGSPEC_CreateTerminal(s: SEGCOMLANGSPEC_Category;
                                                   w: STRING_String;
                                                   VAR f: SEGCOMLANGSPEC_FieldDef); EXTERNAL;

END {SEGCOMLANGSPEC};
