\begin{verbatim}
% RULE RPrepToSub
< m1: PREP{PREPrec1} 
>

< m : SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1}]
>

      COMP
         <
          C1: true
          A1: SUBPREPrec1 := PREPrec1;
         >
      DECOMP
         <
          C1: SUBPREPrec1 = PREPrec1
          A1: @
         >

&

\end{verbatim}
