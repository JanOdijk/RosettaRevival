
SPANISH 84

&

The following shift rules exist:

\begin{description}
\item[Twhshift1a, Twhshift1b] for the actual shifting
\item[Twhshift0] to pass structures where shifting does not apply
\item[Twhshift2] for shifting out of a subordinate clause
\end{description}
\newpage
\begin{verbatim}
%
% TRANSFORMATION TWhshift1a
< m1:CLAUSE{CLAUSErec1}[I1:sig1, I2:mu1 ]
>

< m :CLAUSE{CLAUSErec2}[I1:sig1, I3:mu11]
>

   MATCHCONDITIONS
      <
       I1: ALL(sig1, leftdislocrel/..)
       I2: NOT EXIST(mu1,[I21:rel1/..])
           I21: rel1 IN [leftdislocrel, shiftrel]
       I3: NOT EXIST(mu11, [leftdislocrel/..])  AND
           QUOTE_FIRSTrel(mu11, shiftrel)         (* not really necessary *)
      >

<

   SUBRULE  (* subjrel *)
      <mu1 :[I6:mu6, I8:subjrel/T1, I7:mu7] >
      <mu11:[I8:shiftrel/T1, I6:mu6, I7:mu7] >

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [subjrel/..])
           I61: QUOTE_Srelprec(rel6, subjrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I72:rel2/..])
           I71: QUOTE_Srelprec(Subjrel, rel7)
           I72: rel2 IN [subjrel, postsubjrel]
       I8: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh, relativexpmood]) OR
           (T1.CAT IN [CNVAR])
      >

      COMP
         <
          C1: CLAUSErec1.finiteness = finite AND
              (T1.CAT IN [NPVAR, CNVAR] WITH 
                (T1.REC.cases * [Nominative] <> []  
                )
              )
          A1: CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: CLAUSErec2.finiteness = finite AND
              (T1.CAT IN [NPVAR, CNVAR] WITH 
               T1.REC.cases * [Nominative] <> [] 
              )
          A1: CLAUSErec1 := CLAUSErec2;
         >

   SUBRULE  (* tempadvrel *)
      <mu1 :[I6:mu6, tempadvrel/I8::ADVPVAR{ADVPVARrec1}, I7:mu7 ]>
      <mu11:[shiftrel/I8::ADVPVAR{ADVPVARrec1}, I6:mu6, I7:mu7 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, tempadvrel)
       I7: ALL(mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(tempadvrel, rel7 )
       I8: ADVPVARrec1.mood = wh AND tempadv IN ADVPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2;
         >

   SUBRULE  (* locadvrel *)
      <mu1 :[I6:mu6, locadvrel/I8::ADVPVAR{ADVPVARrec1}, I7:mu7 ]>
      <mu11:[shiftrel/I8::ADVPVAR{ADVPVARrec1}, I6:mu6, I7:mu7 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) 
           I61: QUOTE_Srelprec(rel6, locadvrel)
       I7: ALL(mu7, I71:rel7/..) 
           I71: QUOTE_Srelprec(locadvrel, rel7)
       I8: ADVPVARrec1.mood = wh AND locadv IN ADVPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2;
         >


   SUBRULE  (* tempadvrel, PREPPVAR *)
      <mu1 :[I6:mu6, tempadvrel/I8::PREPPVAR{PREPPVARrec1}, I7:mu7 ]>
      <mu11:[shiftrel/I8::PREPPVAR{PREPPVARrec1}, I6:mu6, I7:mu7 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, tempadvrel)
       I7: ALL(mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(tempadvrel, rel7 )
       I8: PREPPVARrec1.mood IN [wh,relativexpmood] AND 
           temp IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2;
         >


   SUBRULE  (* locadvrel, PREPPVAR *)
      <mu1 :[I6:mu6, locadvrel/I8::PREPPVAR{PREPPVARrec1}, I7:mu7 ]>
      <mu11:[shiftrel/I8::PREPPVAR{PREPPVARrec1}, I6:mu6, I7:mu7 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, locadvrel)
       I7: ALL(mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(locadvrel, rel7)
       I8: PREPPVARrec1.mood IN [relativexpmood, wh] AND 
           loc IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2;
         >

>
&

\end{verbatim}
