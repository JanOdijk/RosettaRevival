pragma C_include('interfaces.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE AMORPH;
WITH INTERFACES;

(*MPF:::===================================================================*
 *
 *  Function Name  : AMORPH
 *  Description    : Implementation of the Analytical morphological component
 *                   as specified in document R0065
 *  Parameters     : interf: INTERFACES_IfDescr; Interface structure coming
 *                                 from the ALAYOUT component. For more
 *                                 information see the
 *                                 description of the INTERFACE0 module.
 *                                 The interface is an implementation of a
 *                                 "set of sequences of words".
 *                    var error: true when an error occurred in interactive mode
 *  Result         : INTERFACES_Ifdescr; Interface structure for level 1.
 *                                 For more information see the
 *                                 description of the INTERFACE1 module.
 *                                 The interface is an implementation of a
 *                                 "set of sequences of lexical S-trees".
 *
 *EMP:::===================================================================*)

FUNCTION AMORPH(interf: INTERFACES_IfDescr; var error : Boolean): 
                           INTERFACES_IfDescr;
EXTERNAL;

END {AMORPH};
