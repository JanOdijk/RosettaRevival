\newpage
\begin{verbatim}
%
% TRANSFORMATION TOblObjControlPrepSent   (* prepobjrel/SENT,
                                             (ind)obj antec. *)
< m1:CLAUSE{CLAUSErec1}
           [ I5:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I1:rel1/T1,
                      mu5,
                      prepobjrel/PREPP{PREPPrec1}
                                [head/PREP{PREPrec1},
                                 objrel/I2::SENTENCE{SENTENCErec1}
                                       [I3: sig1,
                                        subjrel/T2,
                                        I4: mu6
                                       ] 
                                ],
                      mu7
                    ],
             mu8
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I5:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I1:rel1/T1,
                      mu5,
                      prepobjrel/PREPP{PREPPrec2}
                                [head/PREP{PREPrec1},
                                 objrel/I2::SENTENCE{SENTENCErec1}
                                       [I3: sig1,
                                        I4: mu6
                                       ]
                                ],
                      mu7
                    ],
             mu8
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [objrel, indobjrel] 
       I2: SENTENCErec1.PROsubject = true
       I3: ALL (sig1, shiftrel/..)
       I4: NOT EXIST (mu6, [shiftrel/..])
       I5: NOT EXIST (mu1, [I51:auxrel/VERB{VERBrec2}[mu9]])
         I51: VERBrec2.subc = modalverb
      >

<
   SUBRULE  (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: ((rel1 = objrel AND VERBrec1.controller = object)
               OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
              AND
              NPVARrec1 = NPVARrec2
              (* cases of both vars are [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: ((rel1 = objrel AND VERBrec1.controller = object)
               OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is [omegacase] *)
         >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: ((rel1 = objrel AND VERBrec1.controller = object)
               OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
              AND
              CNVARrec1 = CNVARrec2
              (* cases of both vars are [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: ((rel1 = objrel AND VERBrec1.controller = object)
               OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which is [omegacase] *)
         >
>

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] TOblObjControlPrepSent
\item[* relevant examples:]\mbox{}\\
No examples of obj or indobj controllers could be found. This rule was 
originally intended for x1 talk x2 out of [x2 jumping from the top of the 
building], but open gerunds are now classified as NPs i.s.o.\ sentences.
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_Controlrules
\item[* date of creation:] 04-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To interpret the VAR-subject of sentences in a prepobj as the 
(ind)object of the higher clause, and to delete this subject.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One for NPVARs,
one for CNVARs.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\
see below under `remarks'
\item rules:\\
It is assumed that all SENTENCEs occurring within a byobjrel/PREPP are finite, 
and hence do not need control. They are covered by the general TNoControl 
transformation.
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
\item modifications:\\

\end{enumerate}
\end{description}

