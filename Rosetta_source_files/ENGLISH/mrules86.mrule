\begin{verbatim}

%SUBGRAMMAR Prepppropformation


(* If modification rules are added to this subgrammar, also add
superdeixisadaptation rules to PREPPPROPtoFORMULA and XPPROPtoCLAUSE 
(if necessary) or choose a solution as in RPPPAdvpMod and RPPPNPMod *)

(* Lowest rule number available: 18. Please update rigourously! *)


   (* RC_StartPPPRules *)
( RStartPPProp000/1 | RStartPPProp100/2 | RStartPPProp120/3 )
.
   (* TC_pppPatternRules *)
( TpppPattern0/4   | TpppPattern1/5 )
.
   (* RC_pppTempVar *)
   (* RC_pppSentAdvVar *)
   (* RC_pppLocAdvVar *)
{ Rppprefvarinsertion/10 | Rpppdurvarinsertion/11 | 
  Rpppretrovarinsertion/12 |
  RpppConjsentVar/15 | RpppFinalConjsentVar/17 | RpppSentadvVar/16 |
  RpppLocAdvVar/13 | RpppLocPreppVar/14 }
.
   (* RC_pppVoiceRules *)
( RPPPVoice/6 )
.
   (* RC_PppModRules *)
[ RPPPAdvpMod/7     | RPPPNpMod/8 ]


HEAD:
<
SUBPREP     FROM (Prepderivation)
>

