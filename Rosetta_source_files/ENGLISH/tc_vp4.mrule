\newpage
\begin{verbatim}
% TRANSFORMATION TVerbpattern12
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                            [ head/VERB{VERBrec1}[mu2],
                              argrel/SENTENCEVAR{SENTENCEVARrec1},
                              I4:argrel/T4

                            ] 
                   ]
>

< m :VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                          [ head/VERB{VERBrec1}[mu2],
                            objrel/NP{NPrec1}
                                  [head/PERSPRO{PERSPROrec1}
                                       [head/BPERSPRO(AUX_itbpersprokey)
                                                      {BPERSPROrec1}]
                                  ],
                            complrel/SENTENCEVAR{SENTENCEVARrec1},
                            I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                   [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                     objrel/NPVAR{NPVARrec1}]
                          ] 
               ]
>
   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR
               [headkey, actsubcefs, mood, synppefs, thetapp,
                specQ, class, deixis, aspect, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            deixis     : PREPrec1.deixis
                            aspect     : PREPrec1.aspect
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      I4: T4.CAT IN [NPVAR,CNVAR]    
      >

      COMP
         <
          C1: synPREPNP_ITOPENTOSENT IN VERBrec1.synvps  AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  finiteness : infinite
                                  infsort    : toinf
                                  PROsubject : true }
          A1: 
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_ITOPENTOSENT];
              PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              NPrec1 := AUX_NPONitPRSPR;
         >
      DECOMP
         <
          C1: synPREPNP_ITOPENTOSENT IN VERBrec1.synvps AND
              synPREPNP_ITOPENTOSENT IN VERBPPROPrec2.synvpefs AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : relativexpmood
                               specQ      : yesspec
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  finiteness : infinite
                                  infsort    : toinf
                                  PROsubject : true } AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) 
                            EXCEPT FOR [persprocase] AND
              PERSPROrec1.persprocase = omegacase AND
              NPrec1 = AUX_NPONitPRSPR
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >
&

\end{verbatim}
