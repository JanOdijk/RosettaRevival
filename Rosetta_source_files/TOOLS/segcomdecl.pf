pragma C_include('segcomlangspec.pf');
pragma C_include('string.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE SEGCOMDECL;
WITH STRNG,
     SEGCOMLANGSPEC;

CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   SEGCOMDECL_Surfrulemode = (loccond, globcond);
   SEGCOMDECL_psyntcat     = ^SEGCOMLANGSPEC_Category;
   SEGCOMDECL_syntcatset   = SET OF SEGCOMLANGSPEC_Category;
   SEGCOMDECL_pSnode       = ^SEGCOMDECL_Snode;
   SEGCOMDECL_pRsnode      = ^SEGCOMDECL_Rsnode;
   SEGCOMDECL_Rsnode       = RECORD
                                node    : SEGCOMDECL_pSnode;
                                brother : SEGCOMDECL_pRsnode
                             END;
   SEGCOMDECL_Snode        = RECORD
                                sonlist : SEGCOMDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : SEGCOMLANGSPEC_Category;
                                ldfield : SEGCOMLANGSPEC_FieldDef
                             END;
   SEGCOMDECL_pLostree     = ^SEGCOMDECL_Lostree;
   SEGCOMDECL_Lostree      = RECORD
                                next    : SEGCOMDECL_pLostree;
                                arg     : SEGCOMDECL_pSnode
                             END;
   SEGCOMDECL_pConnectionnode
                           = ^SEGCOMDECL_Connectionnode;
   SEGCOMDECL_pSingleSegmentList
                           = ^SEGCOMDECL_SingleSegmentList;
   SEGCOMDECL_Connectionnode 
                           = RECORD
                                list    : SEGCOMDECL_pSingleSegmentList;
                                next,
                                prev    : SEGCOMDECL_pConnectionnode;
                                idnr    : integer
                             END;
   SEGCOMDECL_SingleSegmentList
                           = RECORD
                                next    : SEGCOMDECL_pSingleSegmentlist;
                                rn      : SEGCOMDECL_pConnectionnode;
                                stree   : SEGCOMDECL_pSnode
                             END;
   SEGCOMDECL_psurfgraph     = ^SEGCOMDECL_surfgraphtype;
   SEGCOMDECL_psurfgraphnode = ^SEGCOMDECL_surfgraphnode;
   SEGCOMDECL_surfgraphtype  = RECORD
   			          first,
   			          last: SEGCOMDECL_psurfgraphnode
   		               END;
   SEGCOMDECL_nodeid         = HINIT..HFINAL;
   SEGCOMDECL_plonodeid      = ^SEGCOMDECL_lonodeid;
   SEGCOMDECL_lonodeid       = RECORD
   			          next: SEGCOMDECL_plonodeid;
   			          arg : SEGCOMDECL_nodeid
   	 	               END;
   SEGCOMDECL_plossurfgraphnode 
                             = ^SEGCOMDECL_lossurfgraphnode;
   SEGCOMDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : SEGCOMDECL_plossurfgraphnode;
   			       END;
   SEGCOMDECL_lossurfgraphnode 
                             = RECORD
   				   next :  SEGCOMDECL_plossurfgraphnode;
   				   arg  :  SEGCOMDECL_psurfgraphnode
   			       END;
   SEGCOMDECL_surfgraphnode  = RECORD
      			          left,
   			          right: SEGCOMDECL_psurfgraphnode;
   			          n    : SEGCOMDECL_nodeid;
   			          cat  : SEGCOMDECL_psyntcat;
   			          nextnodes: SEGCOMDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : SEGCOMDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

