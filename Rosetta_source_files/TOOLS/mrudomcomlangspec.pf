(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
pragma C_include('tstring.pf');

PACKAGE MRUDOMCOMLANGSPEC;

WITH TSTRING;

CONST
   MRUDOMCOMLANGSPEC_NROW      =   19;
   MRUDOMCOMLANGSPEC_MAXRNR    =   28;

TYPE SETOFCHAR = SET OF CHAR;
plosstring = ^losstring;
losstring = RECORD
   next:plosstring;
   carriage:BOOLEAN;
   arg:TSTRING_string
 END; 
LOCALFILE = RECORD 
            first,last:plosstring
            END; 
   MRUDOMCOMLANGSPEC_Category  =   (Domaincat,ENDcat,IScat,roundopen,
                                 roundclose,comma,TYPEScat,dotdot,SETScat,
                                 CATEGORIEScat,dot,squareopen,squareclose,
                                 dotcomma,INTEGERcat,BOOLEANcat,SETcat,OFcat,
                                 ATTRIBUTEScat,SURFACEcat,PROCcat,INHcat,SYNcat,
                                 leftarrow,rightarrow,COMMENT,outputfiles,
                                 utt,typespec,recordspec,OUTPUTFILEScat,
                                 categoriespec,identifier,typedefinition,
                                 recorddefinition,catdefinition,enumdef,
                                 subrangedef,integerdef,booleandef,setdef,
                                 typename,attribname,defaultvalue,recordname,
                                 catlist,catname,alphabetcat,symbolscat,
                                 wordscat,alphabetspec,symbolspec,wordspec,
                                 symboldefinition,worddefinition,character,
   				 setspec,setelement,TABLEScat,tablespec);

   MRUDOMCOMLANGSPEC_pTerminal = ^MRUDOMCOMLANGSPEC_Terminal;
   MRUDOMCOMLANGSPEC_Terminal  = RECORD 
                                 str : TSTRING_String;
                              END;

   MRUDOMCOMLANGSPEC_FieldDef  = RECORD 
                                 CASE MRUDOMCOMLANGSPEC_Category OF
                                 Domaincat,ENDcat,IScat,roundopen,
                                   roundclose,comma,TYPEScat,dotdot,SETScat,
                                   CATEGORIEScat,dot,squareopen,squareclose,
                                   dotcomma,INTEGERcat,BOOLEANcat,SETcat,OFcat,
                                   leftarrow,rightarrow,COMMENT,alphabetcat,
                                   symbolscat,wordscat,ATTRIBUTEScat,
                                   PROCcat,SURFACEcat,INHcat,SYNcat,
                                   OUTPUTFILEScat,TABLEScat,identifier
                                      : ( terminal : MRUDOMCOMLANGSPEC_pTerminal);
                                   typename,attribname,defaultvalue,recordname,
   				   catname,character
                                      :(preterminal:MRUDOMCOMLANGSPEC_pTerminal)
                                 END;

 FUNCTION MRUDOMCOMLANGSPEC_ScanChars:SETOFCHAR;
         EXTERNAL;

 PROCEDURE MRUDOMCOMLANGSPEC_Init; EXTERNAL;

 PROCEDURE MRUDOMCOMLANGSPEC_Word(i: integer; VAR s: TSTRING_String);
         EXTERNAL;

 FUNCTION MRUDOMCOMLANGSPEC_Wcat(i: integer): MRUDOMCOMLANGSPEC_Category;
         EXTERNAL;

 FUNCTION MRUDOMCOMLANGSPEC_Scat(c: CHAR): MRUDOMCOMLANGSPEC_Category;
         EXTERNAL;

 PROCEDURE MRUDOMCOMLANGSPEC_CreateTerm(s: MRUDOMCOMLANGSPEC_Category;
                                                   w: TSTRING_String;
                                                   VAR f: MRUDOMCOMLANGSPEC_FieldDef); EXTERNAL;


END;
