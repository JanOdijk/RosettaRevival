\begin{verbatim}
% RULE RQPsuperdeixis
< m1:QP{QPrec1}[mu1] 
>

< m :QP{QPrec2}[mu1] 
>

   PARAMETERS
      <
       super : deixistype
      >

      COMP
         <
          C1: QPrec1.superdeixis = omegadeixis AND
              super IN [presentdeixis, pastdeixis]
          A1: QPrec2 := QPrec1;
              QPrec2.superdeixis := super;
         >
      DECOMP
         <
          C1: QPrec2.superdeixis IN [presentdeixis, pastdeixis]
          A1: QPrec1 := QPrec2;
              QPrec1.superdeixis := omegadeixis;
              super := QPrec2.superdeixis;
         >

&

\end{verbatim}
