SPANISH 95
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TVRcomplsetting
< m1:I1::SENTENCE{SENTENCErec1}[mu1]
>

< m :I2::SENTENCE{SENTENCErec2}[mu1]
>

   MATCHCONDITIONS
      <
       I1: SENTENCErec1.finiteness = infinite 
       I2: SENTENCErec2.finiteness = infinite
      >


      COMP
         <
          C1: true
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.VRcompl := true
         >

      DECOMP
         <
          C1: SENTENCErec2.VRcompl = true
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.VRcompl := false;
         >
&

\end{verbatim}
\newpage
