\newpage
\begin{verbatim}
%
% TRANSFORMATION TSubjControlConjSent
< m1: CLAUSE{CLAUSErec1}
            [ leftdislocrel/I5::SENTENCE{SENTENCErec1}
                           [ conjrel/T3,
                             subjrel/T2,
                             I4:mu4 
                           ],
              mu1, 
              I1:subjrel/T1,
              mu2
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ leftdislocrel/I5::SENTENCE{SENTENCErec1}
                           [ conjrel/T3,
                             I4:mu4 
                           ],
              mu1, 
              I1:subjrel/T1,
              mu2
            ]
>


   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I4: ALL (mu4, I41:rel4/..) 
         I41: QUOTE_Srelprec(subjrel, rel4) AND rel4 <> subjrel
       I5: SENTENCErec1.adverbial = true AND
           SENTENCErec1.finiteness = infinite
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} 
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = []
              (* no cases for subject of infinitives  *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := []
              (* no cases for subject of infinitives  *)
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1} 
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = []
              (* no cases for subject of infinitives  *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := []
              (* no cases for subject of infinitives  *)
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TSubjControlConjSent
\item[* relevant examples:] Although unwilling to pay, he drew his wallet; In 
order to leave, he packed his things.
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_
ConjSentControl
\item[* date of creation:] 20-MAR-1989 
\item[* author:] margreet sanders
\item[* copied from:] Dutch TAdvControl2
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] This transformation deals with obligatory control of
infinitival adverbial sentences. 
It is assumed that only subjects can control such adverbial clauses.
For other controllers separate transformations must be made.

The transformation class must be applied iteratively. It must be followed by
a filter. To speed up analysis, it can be preceded by a prefilter.
The TC must be applied after tc\_objectok and before pruning of S.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
