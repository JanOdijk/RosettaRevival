\begin{verbatim}
% RULE RNPformation3           (* (NUM) (ADJ) EN --> 
                                     el/la/los/las + [ (NUM) (ADJ) EN] *)

< m1: CN{CNrec1}I1:[mu1,
                    head/EN{ENrec1},
                    I2:mu2
                   ]
>

< m:  NP{NPrec1}[detrel/DETP{DETPrec1}[head/T1],
                 head/CN{CNrec1}I1:[mu1,
                                    head/EN{ENrec1},
                                    mu2
                                   ]                       
                ]
>

   MATCHCONDITIONS
      <
        I1: EXIST(mu1,[modrel/DETP{DETPrec2}[mu3,head/NUM{NUMrec1}]])  OR
            EXIST(mu1, [modrel/ADJP{ADJPrec1}[mu4]]) OR
            EXIST(mu2, [rel1/T2])
        I2: NOT EXIST(mu2, [posrel/NP{NPrec2}[mu8]])
        m: NPrec1 = { 
                      persona   : 3
                      NPhead    : enNP
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }

         
      >

<
(* 1 *)
SUBRULE
< >
<T1:ART(KEY_elartkey){ARTrec1}>

      COMP
         <
          C1: (CNrec1.generos * [masc, neutro] <> []) AND
              (CNrec1.numero = singular)
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                         possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero
                          numero            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                         
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          NPhead     : enNP
                         }  
         >

      DECOMP
         <
          C1:  (CNrec1.generos *  [masc, neutro] <> []) AND
               (CNrec1.numero = singular) AND 
               DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
               DETPrec1.posspred = true AND
               NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                          possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          numero            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         }  

          A1:  @
         >

(* 2 *)
SUBRULE
< >
<T1:ART(KEY_laartkey){ARTrec1}>

      COMP
         <
          C1: (CNrec1.generos * [fem] <> []) AND
              (CNrec1.numero = singular)
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                         possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero
                          numero            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                         
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          NPhead     : enNP
                         }  
         >

      DECOMP
         <
          C1:  (CNrec1.generos *  [fem] <> []) AND
               (CNrec1.numero = singular) AND 
               DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
               DETPrec1.posspred = true AND
               NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                          possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          numero            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         }  

          A1:  @
         >


(* 3 *)
SUBRULE
< >
<T1:ART(KEY_losartkey){ARTrec1}>

      COMP
         <
          C1: (CNrec1.generos * [masc, neutro] <> []) AND
              (CNrec1.numero = plural)
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                         possnietnp        : DETPrec1.possnietnp *)
