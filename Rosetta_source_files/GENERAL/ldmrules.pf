 *  Copyright (c) 1986, by Nederlandse Philips Bedrijven BV.
 *
 *  Remarks         : This module defines part of the interface between the
 *                    language independent part of M-Parser and M-Generator and
 *                    the language specific M-rules, to be precise that part
 *                    that is relevant both in analysis and generation.
 *                    Its corresponding implementation part, generated by the
 *                    M-Rule compiler,is language specific and to be found in
 *                    resp. the Dutch, English and Spanish component. This
 *                    counterpart consists of the modules LSMrules and LSParams.
 *
 *EMP:::===================================================================*)



(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
pragma C_include('strings.pf');
pragma C_include('windows.pf');


PACKAGE LDMrules;

WITH strings, windows;


(*MPT:::===================================================================*
 *
 *  Type name      : LDMrules_SubgrammarIndex
 *  Description    : A consequetive range of subgrammar indici.
 *
 *EMP:::===================================================================*)

TYPE
   LDMrules_SubgrammarIndex = INTEGER;



(*MPT:::===================================================================*
 *
 *  Type name      : LDMrules_TransformationIndex
 *  Description    : A (consequetive) range of transformation indici, each 
 *                   subgrammar has its own range.
 *
 *EMP:::===================================================================*)

TYPE
   LDMrules_TransformationIndex = INTEGER;




(*MPT:::===================================================================*
 *
 *  Type name      : LDMrules_RuleIndex
 *  Description    : A (consequetive) range of rule indici, each subgrammar
 *                   has its own range.
 *
 *EMP:::===================================================================*)

TYPE
   LDMrules_RuleIndex = INTEGER;





(*MPT:::===================================================================*
 *
 *  Type name      : LDMrules_LIParameters
 *  Description    : a pointer to the language specific parameters,
 *                   a subspecification of the actual rule applied.
 *                   The usual typecasting trick is used to hide the
 *                   language specific nature of this item.
 *                   The language specific definition is to be found in
 *                   the by the Mrule-compiler generated module LSParams.
 *
 *EMP:::===================================================================*)

TYPE
   LDMrules_LSparams     = ^INTEGER;
   LDMrules_LIParameters = RECORD
                              index   : INTEGER;
                              subst   : INTEGER;
                              rulenr  : INTEGER;
                              LS      : LDMrules_LSparams
                           END;

(*MPT:::===================================================================*
 *
 *  Type name      : LDMrules_CtrlExprKind
 *  Description    : the different kind of control expressions
 *
 *EMP:::===================================================================*)

TYPE
   LDMrules_CtrlExprKind = (concatenation, alternative, option, iteration,
                            rule, transformation);



(*MPT:::===================================================================*
 *
 *  Type name      : LDMrules_pCtrlExprLst,CtrlExprLst,CtrlExpr
 *  Description    : the types to make a control expression graph.
 *                   In analysis a control graph is processed from right to
 *                   left, and in geration from left to right. Therefore a
 *                   control graph is implemented by a dubble linked list.
 *
 *EMP:::===================================================================*)

TYPE
   LDMrules_pCtrlExprLst = ^LDMrules_CtrlExprLst;
   LDMrules_pCtrlExpr = ^LDMrules_CtrlExpr;
   LDMrules_CtrlExpr =
      RECORD
      CASE Kind : LDMrules_CtrlExprKind OF
                                       {first,last}
         concatenation, alternative : (left, right : LDMrules_pCtrlExprLst);
         option, iteration : (ce : LDMrules_pCtrlExpr);
         rule : (R : LDMrules_RuleIndex);
         transformation : (T : LDMrules_TransformationIndex)
      END {RECORD};
   LDMrules_CtrlExprLst =
      RECORD
         ce : LDMrules_CtrlExpr;
         left, right : LDMrules_pCtrlExprLst
      END;




(*MPF:::===================================================================*
 *
 *  Function Name  : LDMrules_MinSubgrammarIndex
 *  Description    : 
 *  Parameters     : 
 *  Result         : LDMrules_SubgrammarIndex
 *  Precondition   : 
 *  Postcondition  : RETURNS the lowest subgrammar index
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION LDMrules_MinSubgrammarIndex
                    : LDMrules_SubgrammarIndex;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDMrules_MaxSubgrammarIndex
 *  Description    : 
 *  Parameters     : 
 *  Result         : LDMrules_SubgrammarIndex
 *  Precondition   : 
 *  Postcondition  : RETURNS the highest subgrammar index
 *  Side Effects   : 
