\newpage
\begin{verbatim}
% TRANSFORMATION TSEspelling3 (* PRONPVAR seactive finite *)
< m1:I1::SENTENCE{SENTENCErec1}
           [ I4:mu1,
             subjrel/I2::PRONPVAR{PRONPVARrec1}[],
             I3:mu2,
             cliticrel/CLITIC{}[mu3],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5
           ]
>

< m:I1::SENTENCE{SENTENCErec1}
          [ I4:mu1,
            I3:mu2,
            cliticrel/CLITIC{}[mu6],
            head/VERB{VERBrec2}
                 [ mu15,
                   head/VERB{VERBrec1}
                     [head/SUBVERB{SUBVERBrec1}
                        [head/I6::BVERB{BVERBrec1}]
                     ]
                 ],
            mu5
          ]
>

   MATCHCONDITIONS
      <
       I1:  SENTENCErec1.finiteness = finite AND
            SENTENCErec1.voice = seactive
       I2:  (PRONPVARrec1 = AUX_PRONPVARONecBPRSPR EXCEPT FOR 
                          [numero, persona, genero]) 
                                              AND
            (PRONPVARrec1.numero = singular)        AND
            (PRONPVARrec1.persona = 3)              AND
            (PRONPVARrec1.genero = masc)
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel]
       I6:  (BVERBrec1.reflexivity = notreflexive)    AND
            (BVERBrec1.key <> KEY_haberque1BVERBkey)  AND
            (BVERBrec1.key <> KEY_haberque2BVERBkey)
       m1: (NOT EXIST (mu3, [seclrel/..])) OR
           (EXIST (mu3, [seclrel/..]) AND
            (EXIST (mu15, [I7:rel3/VERB{VERBrec3}[mu16]]) OR
             VERbrec1.futuro = sifuturo
            )
           )
       m:  (NOT EXIST (mu6, [seclrel/..])) OR
           (EXIST (mu6, [seclrel/..]) AND
            (EXIST (mu15, [I7:rel3/VERB{VERBrec3}[mu16]]) OR
             VERbrec1.futuro = sifuturo
            )
           )
       I7: VERBrec2.futuro = sifuturo
      >
<
   SUBRULE
      <mu3:[I5:mu7] >
      <mu6:[seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1}, I5:mu7] >

   MATCHCONDITIONS
      <
       I5:  NOT EXIST (mu7, [seCLrel/..])
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;   
              PRONPVARrec1.numero := singular;
              PRONPVARrec1.persona := 3;
              PRONPVARrec1.genero := masc;
         >

   SUBRULE (* futuro case *)
      <mu3:[I5:mu7] >
      <mu6:[I5:mu7] >

   MATCHCONDITIONS
      <
       I5:  EXIST (mu7, [seCLrel/..])
      >

      COMP
         <
          C1: true
          A1: @ 
         >

      DECOMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;   
              PRONPVARrec1.numero := singular;
              PRONPVARrec1.persona := 3;
              PRONPVARrec1.genero := masc;

         >
>
&

\end{verbatim}
