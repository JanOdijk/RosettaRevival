ENGLISH 9

&
There are 4 punctuationrules:
\begin{description}
  \item[RNoPunc] for subordinate clauses; it makes subordinate clauses pass
                this rule class
  \item[RQuMark] places a `?' after main clause questions
  \item[RExclam] places a `!' after imperatives and in analysis after 
                 letsmood-sentences; places a `.' after letsmood sentences
  \item[RPeriod] places a `.' after all other main clauses
\end{description}
In analysis the absence of punctuation marks is allowed.\\
There are no rules yet for colons, semicolons and quotes.\\[3 ex]

In this file is included the Comma Incorporation Transformation, together with 
its filters.


\newpage
\begin{verbatim}
%
% RULE RNoPunc
< m1: T1
>

< m : T1
>

<
   SUBRULE (* 1. SENTENCE *)
      < T1: SENTENCE{SENTENCErec1}[mu1] >
      < T1: SENTENCE{SENTENCErec1}[mu1] >

   MATCHCONDITIONS
      <
       T1 : SENTENCErec1.senttype = subordinateclause
      >
 
      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. NP *)
      < T1: NP{NPrec1}[mu1] >
      < T1: NP{NPrec1}[mu1] >

   MATCHCONDITIONS
      <
       T1 : NPrec1.NPhead IN [sentNP, openIngNP]
      >
 
      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 3. PREPP *)
      < T1: PREPP{PREPPrec1}[mu1] >
      < T1: PREPP{PREPPrec1}[mu1] >

   MATCHCONDITIONS
      <
       T1: EXIST (mu1, [objrel/I1::NP{NPrec1}[mu2]])
       I1: NPrec1.NPhead IN [sentNP, openIngNP]
      >
 
      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 4. CLOSEDVERBPPROP *)
      < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >
      < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
