% RULE RClauseformation3b (* estar, ADJPPROP *)
< m1:ADJPPROP{ADJPPROPrec1}[mu1, 
                            predrel/I1::ADJP{ADJPrec1}[I3:mu2, I4:mu6],
                            I5:mu5
                           ] 
>

< m :I2::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ 
		     head/VERB{VERBrec1}
			 [ head/SUBVERB{SUBVERBrec1}
			       [ head/BVERB(AUX_estarbverbkey){BVERBrec1}]
                         ],
                     cliticrel/CLITIC{CLITICrec1}[],
		     predrel/I1::ADJP{ADJPrec1}[I3:mu2]
                    ],
             I5:mu5,
             I4:mu6
          ]
>

   MATCHCONDITIONS
      <
       m1: estar IN ADJPPROPrec1.copulas
       I1: (predicative IN ADJPrec1.uses) AND
           (estar IN ADJPrec1.copulas)
       I2: (synESTAR IN  CLAUSErec1.synvpefs ) AND
           (CLAUSErec1 = 
		    { 
                     req         : [omegapol]
		     env         : [omegapol]
		     voice       : active
		     tiempo      : omegatiempo
		     aspecto     : omegaaspecto
		     retro       : false
		     thetavp     : omegathetavp
		     mood        : omegamood
		     finiteness  : omegafin
		    }
          )
        I3: NOT EXIST (mu2, [I41:rel4/..])
        I4: ALL (mu6, I41:rel4/..)
        I5: NOT EXIST (mu5, [I41:rel4/..])
            I41: rel4 IN [locadvrel, tempadvrel, sentadvrel]
         
      >


      COMP
         <
          C1: ADJPPROPrec1 =
                   {
                     aspecto       : ADJPrec1.aspecto
                     retro         : ADJPrec1.retro
                     tiempo        : ADJPrec1.tiempo
                     actsubcefs    : ADJPrec1.actsubcefs
                     class         : ADJPrec1.class
                     thetaadj      : ADJPrec1.thetaadj
                     adjpatternefs : ADJPrec1.adjpatternefs
                   }
          A1: CLAUSErec1 := COPYT_adjpproptoclause(ADJPPROPrec1);
              CLAUSErec1 := 
		    { 
                     req         : [omegapol]
		     env         : [omegapol]
		     voice       : active
		     tiempo      : omegatiempo
		     aspecto     : omegaaspecto
		     retro       : false
		     synvpefs    : [synESTAR]
		     thetavp     : omegathetavp
		     mood        : omegamood
		     finiteness  : omegafin
		    };
(* tiempo, aspecto, retro have different functions in ADJPPROP and CLAUSE;
   synESTAR is a synvp if the aux estar is the head;
   all other attributes have default values
*)

              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec1 := COPYT_subtoverb(SUBVERBrec1)
               (* other attributes retain their default values *)
 
         >

      DECOMP
         <
          C1: ( SUBVERBrec1 = COPYT_btosubverb(BVERBrec1) ) AND
              ( VERBrec1 = COPYT_subtoverb(SUBVERBrec1) ) AND
              ( VERBrec1 = 
		  { 
		   numero       : omeganumero   
		   persona      : 3  
		   modo         : infinitivo  
		   tiempo       : omegatiempo  
		   status       : bareV
		  }
               )
             (* the default values for these attributes *)              

          A1: ADJPPROPrec1 := COPYT_clauseTOadjpprop(CLAUSErec1);
              ADJPPROPrec1 :=
                   {
                     aspecto       : ADJPrec1.aspecto
                     retro         : ADJPrec1.retro
                     tiempo        : ADJPrec1.tiempo
                     actsubcefs    : ADJPrec1.actsubcefs
                     class         : ADJPrec1.class
                     thetaadj      : ADJPrec1.thetaadj
                     adjpatternefs : ADJPrec1.adjpatternefs
                   }       
         >
&

\end{verbatim}
