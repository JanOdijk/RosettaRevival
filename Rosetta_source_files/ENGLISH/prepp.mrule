\newpage
\begin{verbatim}
% RULE RStartPrepp120  
< m1: SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1}] 
  m2: T1
>

< m : PREPP{PREPPrec1}
           [ head/PREP{PREPrec1},
             I1:argrel/T1
           ]
>

   MATCHCONDITIONS
      <
       m2: T1.CAT IN AUX_VARCATSET
       I1: T1.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: PREPrec1.thetapp = pp120 AND
              SUBPREPrec1 = PREPrec1   
            C11: T1.CAT IN [NPVAR, PREPPVAR] 
            A11: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specQ := T1.REC.specQ;
                 PREPPrec1.mood := T1.REC.mood
            C12: T1.CAT IN [ADVPVAR]
            A12: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specq := yesspec;
                 PREPPrec1.mood := T1.REC.mood
            C13: T1.CAT IN [CNVAR]
            A13: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specq := yesspec;
                 PREPPrec1.mood := relativexpmood
            C14: NOT (T1.CAT IN [NPVAR, PREPPVAR, ADVPVAR, CNVAR])
            A14: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specq := yesspec;
                 PREPPrec1.mood := nowh
          A1: PREPPrec1 := { thetapp     : pp120
                             headkey     : PREPrec1.key
                             actsubcefs  : PREPrec1.subcs
                             class       : PREPrec1.class
                             deixis      : PREPrec1.deixis
                             aspect      : PREPrec1.aspect
                             retro       : PREPrec1.retro }
         >

      DECOMP
         <
          C1: PREPrec1.thetapp = pp120 AND
              PREPPrec1 = PREPPrecdef EXCEPT FOR 
                          [thetapp, headkey, actsubcefs, class,
                           deixis, aspect, retro, specQ, mood] AND
              PREPPrec1 = { thetapp     : pp120 
                            headkey     : PREPrec1.key 
                            actsubcefs  : PREPrec1.subcs 
                            class       : PREPrec1.class 
                            deixis      : PREPrec1.deixis 
                            aspect      : PREPrec1.aspect 
                            retro       : PREPrec1.retro }
            C11: (T1.CAT IN [NPVAR, PREPPVAR] WITH 
                              (T1.REC.specq = PREPPrec1.specQ AND
                               T1.REC.mood = PREPPrec1.mood) )
            A11: @
            C12: ( T1.CAT IN [ADVPVAR] WITH
                             T1.REC.mood = PREPPrec1.mood) AND
                 PREPPrec1.specQ = yesspec 
            A12: @
            C13: T1.CAT IN [CNVAR] AND
                 PREPPrec1.specQ = yesspec AND
                 PREPPrec1.mood = relativexpmood
            A13: @
            C14: NOT (T1.CAT IN [NPVAR, PREPPVAR, ADVPVAR, CNVAR]) AND
                 PREPPrec1.specQ = yesspec AND
                 PREPPrec1.mood = nowh
            A14: @
          A1: SUBPREPrec1 := PREPrec1;
         >
&

\end{verbatim}
