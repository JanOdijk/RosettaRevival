\newpage
\begin{verbatim}
% TRANSFORMATION TTempconjsentadaptation
< m1:SENTENCE{SENTENCErec3}[ mu4,
                             rel1/SENTENCE{SENTENCErec1}
                                          [mu1,
                                           conjrel/CONJ{CONJrec1}[mu2],
                                           mu3
                                          ],
                             mu5
                           ]
>

< m :SENTENCE{SENTENCErec3}[ mu4,
                             rel1/SENTENCE{SENTENCErec2}
                                           [mu1,
                                            conjrel/CONJ{CONJrec1}[mu2],
                                            mu3
                                           ],
                             mu5
                           ]

>
      COMP
         <
          C1:SENTENCErec1.adverbial = true AND
             SENTENCErec1.temporal = true AND
             SENTENCErec1.conjclass = reference AND
             SENTENCErec1.conjretro = false AND
             SENTENCErec1.conjtiempo = SENTENCErec1.tiempo AND
             (SENTENCErec1.tiempo = presente OR
              SENTENCErec1.tiempo = pasado) AND
            CONJrec1.tiempo = omegatiempo
             
          A1:SENTENCErec2 := SENTENCErec1;
             SENTENCErec2.conjtiempo := omegatiempo;
         >
      DECOMP
         <
          C1:SENTENCErec2.adverbial = true AND
             SENTENCErec2.temporal = true AND
             SENTENCErec2.conjclass = reference AND
             SENTENCErec2.conjretro = false AND
             SENTENCErec2.conjtiempo= omegatiempo AND
             (SENTENCErec2.tiempo = presente OR
              SENTENCErec2.tiempo = pasado) AND
             CONJrec1.tiempo = omegatiempo
          A1:SENTENCErec1 := SENTENCErec2;
             SENTENCErec1.conjtiempo := SENTENCErec1.tiempo;
         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TTempconjsentadaptation
\item[* relevant examples:]
\item[* language:] Spanish
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] 
\item[* class:] (name of rule, transformation or filter class)
