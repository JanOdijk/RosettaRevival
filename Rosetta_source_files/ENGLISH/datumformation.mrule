\begin{verbatim}
% RULE RWeekDay
< m1: NP{NPrec1}[detrel/DETP{DETPrec1}[I1:head/N1[mu1]],
                 head/PROPERNOUN{PROPERNOUNrec1}[mu2],
                 mu3
                ]

  m2: NP{NPrec3}[head/PROPERNOUN{PROPERNOUNrec2}[mu4]]
>

< m : NP{NPrec1}[premodrel/NP{NPrec4}[head/PROPERNOUN{PROPERNOUNrec2}[mu4]],
                 puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1},
                 detrel/DETP{DETPrec1}[I1:head/N1[mu1]],
                 head/PROPERNOUN{PROPERNOUNrec1}[mu2],
                 mu3
                ]
>
    MATCHCONDITIONS
      <
       I1:N1.cat IN [CARD]
      >
      COMP
         <
          C1:PROPERNOUNrec1.subc = monthnoun AND
             PROPERNOUNrec2.subc = daynoun AND
             NPrec3.generic = nogeneric AND
             NPrec3.superdeixis = NPrec1.superdeixis
          A1:NPrec4 := NPrec3;
             NPrec4.superdeixis := omegadeixis;
             NPrec4.generic := omegageneric;
         >
      DECOMP
         <
          C1:PROPERNOUNrec1.subc = monthnoun AND
             PROPERNOUNrec2.subc = daynoun AND
             NPrec4.generic = omegageneric AND
             NPrec4.superdeixis = omegadeixis
          A1:NPrec3 := NPrec4;
             NPrec3.superdeixis := NPrec1.superdeixis;
             NPrec3.generic := nogeneric;
             
         >

&

\end{verbatim}
