\newpage
\begin{verbatim}
% RULE RitskPPcoord
< m1:PREPP{PREPPrec1}[mu1]
  m2:PREPP{PREPPrec2}[mu2] 
>

< m :PREPP{PREPPrec3}
         [ argrel/PREPP{PREPPrec4}[mu2],
           conjrel/PUNC(KEY_commaPUNCkey){PUNCrec1},
           mu1
         ]
>

      COMP
         <
          C1: PREPPrec1.coord = simplecoord                     AND
              PREPPrec1.mood = PREPPrec2.mood                   AND
              PREPPrec1.actsubcefs * PREPPrec2.actsubcefs <> [] AND
              PREPPrec1.class = PREPPrec2.class                 AND
              PREPPrec1.aspect = PREPPrec2.aspect               AND
              PREPPrec1.retro = PREPPrec2.retro                 AND
              PREPPrec1.superdeixis = PREPPrec2.superdeixis     AND
              PREPPrec2.stranded = false                        AND
              PREPPrec2.coord = nocoord                         
              C11: (
                    PREPPrec1.deixis = PREPPrec2.deixis    OR
                    PREPPrec2.deixis = omegadeixis            
                   )
                   C111: PREPPrec1.headkey = PREPPrec2.headkey
                         C1111: PREPPrec1.specq = PREPPrec2.specq OR
                                PREPPrec2.specq = nospec
                         A1111: PREPPrec3 := PREPPrec1;
                         C1112: PREPPrec1.specq = nospec AND
                                PREPPrec2.specq = yesspec
                         A1112: PREPPrec3 := PREPPrec1;    
                                PREPPrec3.specq := yesspec;
                   A111: @
                   C112: PREPPrec1.headkey <> PREPPrec2.headkey
                         C1121: PREPPrec1.specq = PREPPrec2.specq OR
                                PREPPrec2.specq = nospec
                         A1121: PREPPrec3 := PREPPrec1;
                         C1122: PREPPrec1.specq = nospec AND
                                PREPPrec2.specq = yesspec
                         A1122: PREPPrec3 := PREPPrec1;    
                                PREPPrec3.specq := yesspec;
                   A112: PREPPrec3.headkey := 0;
              A11: @
              C12: PREPPrec1.deixis = omegadeixis  AND
                   PREPPrec2.deixis <> omegadeixis
                   C121: PREPPrec1.headkey = PREPPrec2.headkey
                         C1211: PREPPrec1.specq = PREPPrec2.specq OR
                                PREPPrec2.specq = nospec
                         A1211: PREPPrec3 := PREPPrec1;
                         C1212: PREPPrec1.specq = nospec AND
                                PREPPrec2.specq = yesspec
                         A1212: PREPPrec3 := PREPPrec1;    
                                PREPPrec3.specq := yesspec;
                   A121: @
                   C122: PREPPrec1.headkey <> PREPPrec2.headkey
                         C1221: PREPPrec1.specq = PREPPrec2.specq OR
                                PREPPrec2.specq = nospec
                         A1221: PREPPrec3 := PREPPrec1;
                         C1222: PREPPrec1.specq = nospec AND
                                PREPPrec2.specq = yesspec
                         A1222: PREPPrec3 := PREPPrec1;    
                                PREPPrec3.specq := yesspec;
                   A122: PREPPrec3.headkey := 0;
              A12: PREPPrec3.deixis := PREPPrec2.deixis 
          A1: PREPPrec4 := PREPPrec2;
              PREPPrec4.superdeixis := omegadeixis; 
         >
      DECOMP
         <
          C1: PREPPrec3.coord = simplecoord                     AND
              PREPPrec3.mood = PREPPrec4.mood                   AND
              PREPPrec3.actsubcefs * PREPPrec4.actsubcefs <> [] AND
              PREPPrec3.class = PREPPrec4.class                 AND
              PREPPrec3.aspect = PREPPrec4.aspect               AND
              PREPPrec3.retro = PREPPrec4.retro                 AND
              PREPPrec4.superdeixis = omegadeixis               AND
              PREPPrec4.stranded = false                        AND
              PREPPrec4.coord = nocoord                         
              C11: (
                    PREPPrec3.deixis = PREPPrec4.deixis    OR
                    PREPPrec4.deixis = omegadeixis            
                   )
                   C111: PREPPrec3.headkey = PREPPrec4.headkey
                         C1111: PREPPrec3.specq = PREPPrec4.specq OR
                                PREPPrec4.specq = nospec
                         A1111: PREPPrec1 := PREPPrec3;
                         C1112: PREPPrec3.specq = yesspec AND
                                PREPPrec4.specq = yesspec
                         A1112: PREPPrec1 := PREPPrec3;    
                                PREPPrec3.specq := nospec;
                   A111: @
                   C112: PREPPrec3.headkey = 0 AND
                         PREPPrec3.headkey <> PREPPrec4.headkey
                         C1121: PREPPrec3.specq = PREPPrec4.specq OR
                                PREPPrec4.specq = nospec
                         A1121: PREPPrec1 := PREPPrec3;
                         C1122: PREPPrec3.specq = yesspec AND
                                PREPPrec4.specq = yesspec
                         A1122: PREPPrec1 := PREPPrec3;    
                                PREPPrec1.specq := nospec;
                   A112: @
              A11: @
              C12: PREPPrec3.deixis = PREPPrec4.deixis AND
                   PREPPrec4.deixis <> omegadeixis
                   C121: PREPPrec3.headkey = PREPPrec4.headkey
                         C1211: PREPPrec3.specq = PREPPrec4.specq OR
                                PREPPrec4.specq = nospec
                         A1211: PREPPrec1 := PREPPrec3;
                         C1212: PREPPrec3.specq = yesspec AND
                                PREPPrec4.specq = yesspec
                         A1212: PREPPrec1 := PREPPrec3;    
                                PREPPrec3.specq := nospec;
                   A121: @
                   C122: PREPPrec3.headkey = 0 AND
                         PREPPrec3.headkey <> PREPPrec4.headkey
                         C1221: PREPPrec3.specq = PREPPrec4.specq OR
                                PREPPrec4.specq = nospec
                         A1221: PREPPrec1 := PREPPrec3;
                         C1222: PREPPrec3.specq = yesspec AND
                                PREPPrec4.specq = yesspec
                         A1222: PREPPrec1 := PREPPrec3;    
                                PREPPrec1.specq := nospec;
                   A122: @
              A12: PREPPrec1.deixis := omegadeixis; 
          A1: PREPPrec2 := PREPPrec4;
              PREPPrec2.superdeixis := PREPPrec3.superdeixis; 
         >


&

\end{verbatim}
