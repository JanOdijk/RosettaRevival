SPANISH 62
&
\begin{verbatim}
%
% RULE Rbadjtosub1
<m1: BADJ{BADJrec1}
>

<m : SUBADJ{SUBADJrec1}[head/BADJ{BADJrec1}]
>
      COMP
         <
          C1: true
          A1: SUBADJrec1 := COPYT_btosubadj(BADJrec1)
         >


      DECOMP
         <
          C1: SUBADJrec1 = COPYT_btosubadj(BADJrec1)
          A1: @
         >


&

\end{verbatim}
