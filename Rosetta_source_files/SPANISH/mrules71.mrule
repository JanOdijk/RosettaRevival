       I1:  CLAUSErec1.finiteness = finite  AND
            CLAUSErec1.voice = active   
       I2:  (NPrec1.NPhead = Seimpershead)    AND
            (NPrec1.numero = singular)        AND
            (NPrec1.persona = 3)              AND
            (NPrec1.cases = [nominative])
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  ALL (mu3, I53:rel3/PERSPRO{PERSPROrec1}[mu51])
       I53: PERSPROrec1.forma = DatCL
       I6:  (BVERBrec1.reflexivity = notreflexive)    AND
            (BVERBrec1.key <> KEY_haberque1BVERBkey)  AND
            (BVERBrec1.key <> KEY_haberque2BVERBkey)
      >

<
 
     SUBRULE

               < T1: I8::NP{NPrec2}[mu22] >
      
             
     MATCHCONDITIONS
      
         < 
               I8:  NPrec2.NPhead = OtherNP   AND
                    NPrec2.human = nohuman  
          >
  

     COMP

         <
          C1: CLAUSErec1.voice = active
          A1: @
         >


     SUBRULE

               < T1: I8::NP{NPrec2}[mu22] >
     
 
     MATCHCONDITIONS
      
       <
       
             I8: NPrec2.NPhead = OtherNP AND
                 NPrec2.human = yeshuman   AND
                 NPrec2.definite = indef
      >


  
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: @
         >

  
>

&

