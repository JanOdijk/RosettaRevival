% TRANSFORMATION TADJNOstNOmost

< m1: ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [I2:mu2,
                                      head/I1::ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                              ]
>

< m : ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [I2:mu2,
                                      head/I1::ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                            ]
>

   MATCHCONDITIONS
      <I1: ADJrec1.compform <> super
       I2: NOT EXIST (mu2, [degreemodrel/QP{QPrec1}
                                         [mu6,
                                          head/Q(AUX_mostQkey){Qrec1},
                                          mu7
                                         ]
                           ])
      >

      COMP
         <
          C1: true
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.actuseefs := ADJrec1.uses;

         >
      DECOMP
         <
          C1: ADJPrec2.actuseefs * ADJrec1.uses <> [] 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.actuseefs := []; 
         >



&

