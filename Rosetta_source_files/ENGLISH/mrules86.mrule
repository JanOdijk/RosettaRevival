       I1: NOT EXIST (mu1, [leftdislocrel/..])
       I2: NOT EXIST (mu1, [I11:rel1/..])
         I11: rel1 IN [locadvrel, tempadvrel, postsentadvrel,
                       leftdislocrel]
      >

<
