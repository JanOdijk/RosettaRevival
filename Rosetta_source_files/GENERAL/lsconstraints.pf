pragma C_include('lsdomaint.pf');
pragma C_include('files.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LSCONSTRAINTS;
WITH LSDOMAINT,
     FILES;

(*MPF:::===================================================================*
 *
 *  Function Name  : LSCONSTRAINTS_Blex
 *  Description    : Checks whether the input record satisfies the 
 *                   BLEX constraints.
 *                   Warning messages concerning violated constraints are
 *                   written to logfile.
 *  Parameters     : rec : LSDOMAINT_BlexStruct;
 *                   log : FILES_Text
 *                   cl  : INTEGER
 *  Result         : BOOLEAN; TRUE if constraints are not violated.
 *  Precondition   : Logfile "log" has been opened for write access.
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION LSCONSTRAINTS_Blex(rec: LSDOMAINT_BlexStruct;
                                       VAR log: FILES_Text;
                                       cl : INTEGER): BOOLEAN;
EXTERNAL;


END {LSCONSTRAINTS};
