
ENGLISH 52
&
\begin{verbatim}
%
% RULE Rbadjtosub1
<m1: BADJ{BADJrec1}
>

<m : SUBADJ{SUBADJrec1}[head/BADJ{BADJrec1}]
>
      COMP
         <
          C1: true
          A1: SUBADJrec1 := COPYT_badjtosubadj(BADJrec1)
              (* affix receives the default value *)
         >


      DECOMP
         <
          C1: SUBADJrec1 = COPYT_badjtosubadj(BADJrec1) AND
              SUBADJrec1.affix = noaffix
          A1: @
         >


&

\end{verbatim}
