pragma C_Include('interface0.pf');
pragma C_Include('interface1.pf');
pragma C_Include('interface2.pf');
pragma C_Include('interface3.pf');
pragma C_Include('interface4.pf');
pragma C_Include('interface5.pf');
pragma C_Include('interface6.pf');
pragma C_Include('interface7.pf');
pragma C_Include('interface8.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE INTERFACES;
WITH
INTERFACE0,
INTERFACE1,
INTERFACE2,
INTERFACE3,
INTERFACE4,
INTERFACE5,
INTERFACE6,
INTERFACE7,
INTERFACE8;


TYPE

(*MPT:::===================================================================*
 *
 *  Type name      : INTERFACES_leveltype
 *  Description    : Definition of the interface levels ( level -1 has been
 *                   added for reasons of initialization )
 *                     -1                       9
 *                   ALAYOUT                G-LAYOUT
 *                      0                       8
 *                   AMORPH                 G-MORPH
 *                      1                       7
 *                   SURFPARSER             LINEARIZER
 *                      2                       6
 *                   M-PARSER               M-GENERATOR
 *                      3                       5
 *                   A-TRANSFER             G-TRANSFER
 *                                   4
 *
 *EMP:::===================================================================*)
       INTERFACES_leveltype = -1..9;

(*MPT:::===================================================================*
 *
 *  Type name      : INTERFACES_interfacedef
 *  Description    : Definition of the interface datastructures between the
 *                   major Rosetta components
 *
 *EMP:::===================================================================*)
       INTERFACES_IfDescr= RECORD CASE level: INTERFACES_leveltype of
                                       -1: ( );
                                        0: ( if0: INTERFACE0_pSeqWords);
                                        1: ( if1: INTERFACE1_pRowSeqSegmKeys);
                                        2: ( if2: INTERFACE2_SetOfStrees);
                                        3: ( if3: INTERFACE3_SetOfSuperDtree);
                                        4: ( if4: INTERFACE4_SetOfHyperILtree);
                                        5: ( if5: INTERFACE5_SetOfHyperDtree);
                                        6: ( if6: INTERFACE6_SetOfStrees);
                                        7: ( if7: INTERFACE7_pRowSeqSegmKeys);
                                        8: ( if8: INTERFACE8_pSeqWords);
                                        9: ( )
                           END;

(*MPT:::===================================================================*
 *
 *  Type name      : INTERFACES_IfDescrList
 *  Description    : Type which can be used by a variable in order to 
 *                   contain a value for all interfaces.
 *
 *EMP:::===================================================================*)
       INTERFACES_IfDescrList = ARRAY [INTERFACES_leveltype] OF INTERFACES_IfDescr;

END {INTERFACES};

