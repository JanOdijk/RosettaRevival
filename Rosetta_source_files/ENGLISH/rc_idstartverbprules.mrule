%TRANSFORMATION TIDVPPROPTOCLAUSE

< m1: VERBPPROP{VERBPPROPREC1}[mu1]
>

< m : CLAUSE{CLAUSEREC1}[mu1]
>

COMP
 <
  C1: true
  A1: CLAUSEREC1 := COPYT_verbpproptoclause(VERBPPROPREC1);
 >
DECOMP
 <
  C1: true
  A1: VERBPPROPREC1 := COPYT_clausetoverbpprop(CLAUSEREC1);
 >

&
\end{verbatim}
