\newpage
\begin{verbatim}
% TRANSFORMATION TParticleInsertion
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                             [head/I1::VERB{VERBrec1}[mu2],
                              mu3
                             ]
               ]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                             [head/I1::VERB{VERBrec1}[mu2],
                              partrel/PART(VERBrec1.particle){PARTrec1},
                              mu3
                             ]
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.particle <> 0
       m : PARTrec1.key = VERBrec1.particle
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
