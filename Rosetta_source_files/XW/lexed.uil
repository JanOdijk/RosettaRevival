object le_help_menu : XmCascadeButton {
  arguments { 
    arguments cascade_args;
  XmNlabelString = 'Help'; 
    XmNsensitive   = true;
  };
  callbacks {
    MrmNcreateCallback = procedure
             XwuCreateWidget (X_le_help_button);
    XmNactivateCallback = procedure XwhAction (X_le_help_button);
  };
};

object le_work : XmForm {
  arguments {
/*    XmNhorizontalSpacing = 0; 
    XmNverticalSpacing   = 0; */
    arguments form_args;
  };
  controls {
    XmForm      le_morf;
    XmSeparator  le_morf_separator;
    XmForm     le_part_mean_form;
    XmForm      le_sid_id_form;
    XmForm    le_attr_form;
    XmForm      le_comment_form;
    XmRowColumn   le_button_box;
    XmForm        le_selection_form;
  };
};

object le_morf : XmForm {
  arguments {
    arguments form_args;
  };
  controls {
    XmRowColumn   le_language;
    XmRowColumn   le_stem;
    XmRowColumn   le_category;
    XmRowColumn   le_skey;
    XmRowColumn   le_where;
    XmRowColumn   le_phonetical;
  };
};

object le_language: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Language: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_language);
      };
    };
  };
};

object le_stem: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_language;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Stem: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_stem_text);
      };
    };
  };
};

object le_category: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_stem;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Category: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_category_text);
      };
    };
  };
};

object le_skey: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_category;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Skey: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_skey);
      };
    };
  };
};

object le_where: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_skey;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Where: ';
        XmNx = 3;
        XmNy = 5;
      };
    };
    XmRadioBox {
      arguments {
        XmNorientation = XmHORIZONTAL;
        XmNx = 85;
      };
      controls {
        XmToggleButton {
          arguments {
            arguments toggle_args;
            XmNhighlightThickness = 0;
            XmNlabelString  = 'analysis';
            XmNsensitive  = false;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget 
                       (X_le_analysis_toggle);
          };
        };
        XmToggleButton {
          arguments {
            arguments toggle_args;
            XmNhighlightThickness = 0;
            XmNlabelString  = 'generation';
            XmNsensitive  = false;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget 
                        (X_le_generation_toggle);
          };
        };
        XmToggleButton {
          arguments {
            arguments toggle_args;
            XmNhighlightThickness = 0;
            XmNlabelString  = 'both';
            XmNsensitive  = false;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget 
                        (X_le_angen_toggle);
          };
        };
      };
    };
  };
};

