%LAND
BASIS RULE
   LAND = EXPR/1 . [ DOT/10 ] . EXPR/2

SURFACE PART

VAR
   Eps   : BOOLEAN;
   Eps1  : BOOLEAN;
   Eps2  : BOOLEAN;
   First :: SETOFatomnodes;
   First1 :: SETOFatomnodes;
   First2 :: SETOFatomnodes;

   HELP FUNCTION Union(a1, a2:: SETOFatomnodes):: SETOFatomnodes;
   VAR
      a3:: SETOFatomnodes;
      a :: atomnode;
   BEGIN
      a3 := a1;
      WHILE STILLatomnodes(a2) DO BEGIN
	 TAKEatomnode(a, a2);
	 APPENDatomnode(a, a3);
      END;
      Union := a3
   END;


<*
   INIT: BEGIN
            Eps   := TRUE;
            Eps1  := TRUE;
            Eps2  := TRUE;
            INITsetofatomnodes(First);
            INITsetofatomnodes(First1);
            INITsetofatomnodes(First2);
         END;
   1   : <*
            LOCALCONDITION: ( %EXPR.Kind <> ConcKind )
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                Eps1 := %EXPR.Eps;
                                First1 := %EXPR.First;
                                END
         *>
   2   : <*
            LOCALCONDITION:TRUE
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                Eps2   := %EXPR.Eps;
                                First2 := %EXPR.First;
                                END
         *>
   10  : <*
            LOCALCONDITION:TRUE
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                END
         *>
   FINAL: #CONDITION: TRUE
          #ACTION: BEGIN SEND_LAND;
                         IF Eps1 
                         THEN First := Union(First1, First2)
                         ELSE First := First1;
                         Eps := Eps1 AND Eps2;

                         $LAND.Eps    := Eps;
                         $LAND.First  := First;
                         $LAND.Eps2   := Eps2;
                         $LAND.First2 := First2;
                         $LAND.Kind   := ConcKind;
                      END
*>
END;

PROCEDURAL PART
VAR
   HELP FUNCTION Union(a1, a2:: SETOFatomnodes):: SETOFatomnodes;
   VAR
      a3:: SETOFatomnodes;
      a :: atomnode;
   BEGIN
      a3 := a1;
      WHILE STILLatomnodes(a2) DO BEGIN
	 TAKEatomnode(a, a2);
	 APPENDatomnode(a, a3);
      END;
      Union := a3
   END;

BEGIN
   INIT: BEGIN
         END;
   <*
   1:    <* SEND: 
               BEGIN
                  %%EXPR.Succ := $LAND.First2;
                  IF $LAND.Eps2 THEN BEGIN
                     %%EXPR.Succ := Union(%%EXPR.Succ, $$LAND.Succ);
                  END
               END
            !EXPR.
            RECEIVE:
               BEGIN
               END
         *>
   2:    <* SEND: 
               BEGIN
                  %%EXPR.Succ := $$LAND.Succ;
               END
            !EXPR.
            RECEIVE:
               BEGIN
               END
         *>
   10:   <* SEND: 
               BEGIN
               END
            !.
            RECEIVE:
               BEGIN
               END
         *>
   *>
   FINAL: BEGIN
          END
END;
&
%LOR
BASIS RULE
   LOR = EXPR/1 . BAR/10 . EXPR/2

SURFACE PART

VAR
   Eps1  : BOOLEAN;
   Eps2  : BOOLEAN;
   First1 :: SETOFatomnodes;
   First2 :: SETOFatomnodes;

   HELP FUNCTION Union(a1, a2:: SETOFatomnodes):: SETOFatomnodes;
   VAR
      a3:: SETOFatomnodes;
      a :: atomnode;
   BEGIN
      a3 := a1;
      WHILE STILLatomnodes(a2) DO BEGIN
	 TAKEatomnode(a, a2);
	 APPENDatomnode(a, a3);
      END;
      Union := a3
   END;


<*
   INIT: BEGIN
            Eps1   := TRUE;
            Eps2   := TRUE;
            INITsetofatomnodes(First1);
            INITsetofatomnodes(First2);
         END;
   1   : <*
            LOCALCONDITION: ( %EXPR.Kind <> AltKind )
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                Eps1 := %EXPR.Eps;
                                First1 := %EXPR.First;
                                END
         *>
   2   : <*
            LOCALCONDITION:TRUE
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                Eps2 := %EXPR.Eps;
                                First2 := %EXPR.First;
                                END
         *>
   10  : <*
            LOCALCONDITION:TRUE
            GLOBAL: #CONDITION: TRUE
                    #ACTION: BEGIN
                                END
         *>
   FINAL: #CONDITION: TRUE
          #ACTION: BEGIN SEND_LOR;
                         $LOR.Eps   := Eps1 OR Eps2;
                         $LOR.First := Union(First1, First2);
                         $LOR.Kind  := AltKind;
                      END
*>
END;

PROCEDURAL PART
VAR
BEGIN
   INIT: BEGIN
         END;
   <*
   1:    <* SEND: 
               BEGIN
                  %%EXPR.Succ := $$LOR.Succ;
               END
            !EXPR.
            RECEIVE:
               BEGIN
               END
         *>
   2:    <* SEND: 
               BEGIN
                  %%EXPR.Succ := $$LOR.Succ;
               END
            !EXPR.
            RECEIVE:
               BEGIN
               END
         *>
   10:   <* SEND: 
               BEGIN
               END
            !.
            RECEIVE:
               BEGIN
               END
         *>
   *>
   FINAL: BEGIN
          END
END;
