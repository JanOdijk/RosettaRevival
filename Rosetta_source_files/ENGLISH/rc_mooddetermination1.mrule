\newpage
\begin{verbatim}
% TRANSFORMATION TConjThatDeletion
< m1: I4::SENTENCE{SENTENCErec1}
                  [ I1:sig1,
                    I2:sig2,
                    I3:mu1,
                    auxrel/VERB{VERBrec1}[mu2],
                    mu3
                  ]
>

< m : I5::SENTENCE{SENTENCErec2}
                  [ I1:sig1,
                    I6:sig3,
                    I3:mu1,
                    auxrel/VERB{VERBrec1}[mu2],
                    mu3
                  ]
>

   MATCHCONDITIONS
      <
       I1: ALL (sig1, shiftrel/..)
       I2: ALL (sig2, conjrel/..)
       I3: NOT EXIST (mu1, [shiftrel/..]) AND
           NOT EXIST (mu1, [conjrel/..])
       I4: SENTENCErec1 = { mood     : declarative
                            senttype : subordinateclause
                            modus    : indicative }
       I5: SENTENCErec2 = { mood     : declarative
                            senttype : subordinateclause
                            modus    : indicative }
       I6: ALL (sig3, conjrel/..)
      >

<
   SUBRULE (* 1. no subject: obligatory thatdel *)
      < sig1: [shiftrel/..] 
        sig2: [conjrel/CONJ(KEY_thatCONJkey){CONJrec1}]
        mu1 : [mu8 ]
      >
      < sig1: [shiftrel/..] 
        sig3: []
        mu1 : [mu8]
      >

   MATCHCONDITIONS
      <
       mu1: NOT EXIST (mu8, [subjrel/..])
      >

      COMP
         <
          C1: SENTENCErec1.conjkey = KEY_thatCONJkey
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.conjkey := 0
              (* all other conj-attributes in SENT were 
                 default anyway *)
         >
      DECOMP
         <
          C1: SENTENCErec2.conjkey = 0
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.conjkey := KEY_thatCONJkey
         >

   SUBRULE (* 2. subject: optional thatdel *)
      < sig2: [conjrel/CONJ(KEY_thatCONJkey){CONJrec1}]
        mu1 : [mu8] 
      >
      < sig3: []
        mu1 : [mu8]
      >

   MATCHCONDITIONS
      <
       mu1: EXIST (mu8, [subjrel/..])
      >

      (* no COMP part *)

      DECOMP
         <
          C1: SENTENCErec2.conjkey = 0
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.conjkey := KEY_thatCONJkey
         >

   SUBRULE (* 3. subject: no thatdel *)
      < sig2: [conjrel/CONJ(KEY_thatCONJkey){CONJrec1}]
        mu1 : [mu8] 
      >
      < sig3: [conjrel/CONJ(KEY_thatCONJkey){CONJrec1}]
        mu1 : [mu8]
      >

   MATCHCONDITIONS
      <
       mu1: EXIST (mu8, [subjrel/..])
      >

      COMP
         <
          C1: SENTENCErec1.conjkey = KEY_thatCONJkey
          A1: SENTENCErec2 := SENTENCErec1
         >
      DECOMP
         <
          C1: SENTENCErec2.conjkey = KEY_thatCONJkey
          A1: SENTENCErec1 := SENTENCErec2
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TConjThatDeletion
\item[* relevant examples:] \mbox{}
subrule 1: who (do you think) that gave me this $\rightarrow$ who (do you 
think) gave me this\\
subrule 2: (analysis only) I know that he can do it $\leftarrow$ I know he can 
do it\\
subrule 3: I know that he can do it $\rightarrow$ I know that he can do it
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] clauseTOsentence
\item[* class:] (name of rule, transformation or filter class) TC\_ConjThatDel
\item[* date of creation:] 23-FEB-1989 17:30:18  
\item[* author:] margreet sanders
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to delete the conjunction {\em that\/} if necessary, or to let 
it go through the (obligatory) transformation if no deletion is needed. In 
analysis, {\em that\/} is put back in the structure if it was missing.
\item[\ \ strategy:] (also: deviations from accepted proposals) This 
transformation is put right after RIndicMoodSub, as obligatory transformation 
following this particular mood rule only. In other subordinate clauses, {\em 
that\/} is either not introduced at all, or must be deleted on the moment of 
substitution (the latter is done for FinRelMood sentences, in CNmodrelsent).
It is assumed that in the substitution rule, it is checked whether a verb is of 
type {\em thatdel = true\/} before accepting/introducing a subordinate 
indicative clause without conjunction.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] one subrule for 
every case: obl del, opt del, no del
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] in generation, {e\ that\/
} is not deleted unless necessary; in analysis, it may always be absent.
