\newpage
\begin{verbatim}
% TRANSFORMATION Tretroneutralization1
< m1: SENTENCE{SENTENCErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I1: mu2,
                     auxrel/VERB{VERBrec1}
                           [head/SUBVERB{SUBVERBrec1}
                                [head/BVERB(AUX_havebverbkey){BVERBrec1} 
                                ] 
                           ],
                     mu3
                    ],
              mu4
             ]
>

< m : SENTENCE{SENTENCErec2}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I1: mu2,
                     auxrel/VERB{VERBrec1}
                           [head/SUBVERB{SUBVERBrec1}
                                [head/BVERB(AUX_havebverbkey){BVERBrec1} 
                                ] 
                           ],
                     mu3
                    ],
              mu4
             ]

>
   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [auxrel/I2:: VERB{VERBrec2}[mu5]])
       I2: VERBrec2.subc = modalverb
      >

     COMP
        <
          C1: SENTENCErec1.retro = true
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.retro := false;
         >
      DECOMP
         <
          C1: SENTENCErec2.retro = false
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.retro := true;
         >


&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tretroneutralization1
\item[* relevant examples:]
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC:retroneutralization
\item[* date of creation:] 25-MAR-88 
\item[* author:] Lisette Appelo
\item[* copied from:] Tretroneutralization Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 07/12/88\ \ \ \ \ author: Lisette Appelo
\item date: 03/08/89\ \ \ \ \ author: Lisette Appelo\\
Changed name of the rule from Tretroneutralization into Tretroneutralization1.
Added mu4.
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The attribute retro is made false in generation if it was true 
and in analysis it is made true as one of the options.\\
\item[\ \ strategy:]  Condition in English: there is an auxiliary {\em have}
in the clause, but another auxiliary is not allowed to the left of {\em have}.
In that case this rule will apply in the next cycle.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ 

\item rules:\\ 

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\
\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:7/12/88: Changed CLAUSE to SENTENCE because of change in 
order in control expression\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% FILTER Fretroneutralization1
< m: SENTENCE{SENTENCErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I1: mu2,
                     auxrel/VERB{VERBrec1}
                           [head/SUBVERB{SUBVERBrec1}
                                [head/BVERB(AUX_havebverbkey){BVERBrec1} 
                                ] 
                           ],
                     mu3
                    ],
             mu4
             ]

>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [auxrel/I2:: VERB{VERBrec2}[mu5]])
       I2: VERBrec2.subc = modalverb
      >

        <
          C1: SENTENCErec1.retro = true
          A1: @
         >


&
\end{verbatim}
