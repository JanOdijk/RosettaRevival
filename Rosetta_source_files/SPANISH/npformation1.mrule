\newpage
\begin{verbatim}
% RULE RNPformation9
< m1: PROPERNOUN{PROPERNOUNrec1}[mu1] 
>

< m : NP{NPrec1}[head/PROPERNOUN{PROPERNOUNrec1}[mu1]
                ]
>
   MATCHCONDITIONS
      <
        m: NPrec1 = { 
                      persona   : 3
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }
      >


      COMP
         <
          C1: PROPERNOUNrec1.subc <> monthnoun
          A1: NPrec1.numero := singular;
              NPrec1.definite := def;
              NPrec1.posspred := true;
              NPrec1.generic  := nogeneric;
              NPrec1.genero  := PROPERNOUNrec1.genero;
              NPrec1.actsubcs := [PROPERNOUNrec1.subc];
              NPrec1.animate := PROPERNOUNrec1.animate;
              NPrec1.human := PROPERNOUNrec1.human;
              (* The other attributes have default value *)
         >

      DECOMP
         <
          C1: PROPERNOUNrec1.subc <> monthnoun AND
              NPrec1.numero = singular AND 
              NPrec1.definite = def AND
              NPrec1.posspred = true AND
              NPrec1.generic  = nogeneric AND
              NPrec1.genero  = PROPERNOUNrec1.genero AND
              NPrec1.animate = PROPERNOUNrec1.animate AND
              NPrec1.human = PROPERNOUNrec1.human AND
              PROPERNOUNrec1.subc IN NPrec1.actsubcs
          A1:  @
         >
&


\end{verbatim}
