                       [ I3:shiftrel/T1,
                         I4:mu3
                       ],
               mu5
             ] >
      < mu4: [ I3:shiftrel/T1,
               I1:mu2,
               complrel/I2::SENTENCE{SENTENCErec1}
                       [ I4:mu3 ],
