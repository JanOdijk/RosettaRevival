%ANDCOND
BASIS RULE
    ANDCOND = ORCOND/2.{ANDCAT/1.ORCOND/2}
SURFACE PART
VAR simple::bool;

<*
INIT: BEGIN simple:=true;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN simple:=false END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN simple:=simple and %ORCOND.simple
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_ANDCOND;
                      $ANDCOND.simple:=simple
                END
*>
END;
PROCEDURAL PART
VAR copy,intequals:LOCALFILE;
    simple::simple;
    rulenumber::int;
BEGIN
INIT: BEGIN initlocalfile(copy);
            initlocalfile(intequals);
            \copy.\LOCAL.
            rulenumber:=$$ANDCOND.rulenumber;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN " AND "\\
               END
   *>
2: <* SEND: BEGIN %%ORCOND.rulenumber:=rulenumber
            END
      !ORCOND.
      RECEIVE: BEGIN simple:=%%ORCOND.simple;
                     appendlocfile(%%ORCOND.copy,copy);
                     appendlocfile(%%ORCOND.intequals,intequals);
               END
   *>
*>
FINAL:BEGIN $$ANDCOND.simple:=simple;
            $$ANDCOND.copy:=copy;
            $$ANDCOND.intequals:=intequals;
      END
END;
&
 
%ORCOND
