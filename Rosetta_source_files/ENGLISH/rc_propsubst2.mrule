% RULE RClosedVerbPPropSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/I1::VERBPPROPVAR{VERBPPROPVARrec1},
                        mu3 
                       ],
                mu5
               ]
  
  SUBST:
  m2: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec2}[mu4]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/CLOSEDVERBPPROP{CLOSEDVERBPPROPrec2}[mu4],
                        mu3 
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPVARrec1.index = LEVEL 
       m2: CLOSEDVERBPPROPrec2.voice = passive
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: VERBPPROPVARrec1 = COPYT_verbppropTOvar(CLOSEDVERBPPROPrec2) 
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: VERBPPROPVARrec1 := COPYT_verbppropTOvar(CLOSEDVERBPPROPrec2);
              VERBPPROPVARrec1.index := LEVEL
         >
&

\end{verbatim}
