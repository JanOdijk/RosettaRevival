SPANISH 96
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Tinversion1   (* wh, relative *)
< m1:I3::SENTENCE{SENTENCErec1}
             [ mu1,
               I4:shiftrel/T1,
               I1:sig1,
               subjrel/T2,
               I2:mu2,
               head/VERB{VERBrec1}[mu3],
               mu4
             ]
>

< m :I3::SENTENCE{SENTENCErec1}
             [ mu1,
               I4:shiftrel/T1,
               I1:sig1,
               I2:mu2,
               head/VERB{VERBrec1}[mu3],
               subjrel/T2,
               mu4
             ]

>

   MATCHCONDITIONS
      <
       I1: ALL(sig1, conjrel/..)
       I2: NOT EXIST(mu2, [conjrel/..])
       I3: SENTENCErec1.finiteness = finite
       I4: (T1.CAT IN [NP, PREPP, ADJP, ADVP, NPVAR, 
                       ADVPVAR, PREPPVAR, VARPREPP] WITH T1.REC.mood = wh) OR
           (T1.CAT IN [CNVAR])
      >


      COMP
         <
          C1: SENTENCErec1.mood IN [whinterrogative, relative, whmod] OR
              ( SENTENCErec1.mood = declarative              AND
                SENTENCErec1.senttype = subordinateclause
              )
          A1: @
         >
      DECOMP
         <
          C1: SENTENCErec1.mood IN [whinterrogative, relative, whmod] OR
              ( SENTENCErec1.mood = declarative              AND
                SENTENCErec1.senttype = subordinateclause
              )
          A1: @
         >


&

\end{verbatim}
