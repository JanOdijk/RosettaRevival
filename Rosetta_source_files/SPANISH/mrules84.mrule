\newpage
\begin{verbatim}
% TRANSFORMATION Twhshift1b
< m1:CLAUSE{CLAUSErec1}[I1:sig1, I2:mu1 ]
>

< m :CLAUSE{CLAUSErec2}[I1:sig1, I3:mu11]
>

   MATCHCONDITIONS
      <
       I1: ALL(sig1, leftdislocrel/..)
       I2: NOT EXIST(mu1,[I21:rel1/..])
           I21: rel1 IN [leftdislocrel, shiftrel]
       I3: NOT EXIST(mu11, [leftdislocrel/..])  AND
           QUOTE_FIRSTrel(mu11, shiftrel)         (* not really necessary *)
      >

<

   SUBRULE (* objrel *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:objrel/T1, I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/T1, mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [objrel/..])
           I61: QUOTE_VPrelprec(rel6, objrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [objrel/..])
           I71: QUOTE_VPrelprec(objrel, rel7)
       I8: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh, relativexpmood]) OR
           (T1.CAT IN [CNVAR] )
      >

      COMP
         <
          C1: (
               T1.CAT IN [NPVAR, CNVAR] WITH T1.REC.cases * [Accusative, 
                           Prepositive] <> [] 
              )                                           AND
              CLAUSErec1.synvpefs * AUX_objvps <> []
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: (
               T1.CAT IN [NPVAR, CNVAR] WITH 
                  T1.REC.cases * [Accusative, 
                           Prepositive] <> []
              )                                        AND
              CLAUSErec2.synvpefs * AUX_objvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_objvps ;
         >

   SUBRULE (* indobjrel *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:indobjrel/VARPREPP{VARPREPPrec1}[mu5], I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/VARPREPP{VARPREPPrec1}[mu5], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, indobjrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(indobjrel, rel7)
       I8: (VARPREPPrec1.mood = wh 
            OR EXIST(mu5,[I81:../T1]) 
           )                             AND 
           aio IN VARPREPPrec1.actsubcefs
            I81: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
                 (T1.CAT IN [CNVAR])
       I62: rel2 IN [indobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_indobjvps <> []
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_indobjvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_indobjvps ;
         >


   SUBRULE (* paraobjrel *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:paraobjrel/VARPREPP{VARPREPPrec1}[mu5], I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/VARPREPP{VARPREPPrec1}[mu5], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, paraobjrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(paraobjrel, rel7)
       I8: (VARPREPPrec1.mood = wh
            OR EXIST(mu5,[I81:../T1]) 
           )                                  AND 
            para IN VARPREPPrec1.actsubcefs
            I81: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
                 (T1.CAT IN [CNVAR])
       I62: rel2 IN [paraobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_paraobjvps <> []
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_paraobjvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_paraobjvps ;
         >



   SUBRULE (* porobjrel *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:porobjrel/VARPREPP{VARPREPPrec1}[mu5], I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/VARPREPP{VARPREPPrec1}[mu5], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [porobjrel/..])
           I61: QUOTE_VPrelprec(rel6, porobjrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [porobjrel/..])
           I71: QUOTE_VPrelprec(porobjrel, rel7)
       I8: (VARPREPPrec1.mood = wh  
            OR EXIST(mu5, [I81:../T1]) 
           )                                       AND 
           doorpor IN VARPREPPrec1.actsubcefs
           I81: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
                (T1.CAT IN [CNVAR])
      >

      COMP
         <
          C1: CLAUSErec1.voice IN [passive]
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.voice IN [Passive]
          A1: CLAUSErec1 := CLAUSErec2;
         >



   SUBRULE (* predrel, ADJP *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, predrel/I8::ADJP{ADJPrec1}[mu8], I7:mu7 ], mu12 ]>
      <mu11:[ shiftrel/I8::ADJP{ADJPrec1}[mu8], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(predrel,rel7 )
       I8: ADJPrec1.mood = wh
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_adjppredvps <> []
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_adjppredvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_adjppredvps ;
         >


   SUBRULE (* predrel, NP *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, predrel/I8::NP{NPrec1}[mu8], I7:mu7 ], mu12 ]>
      <mu11:[ shiftrel/I8::NP{NPrec1}[mu8], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(predrel, rel7)
       I8: NPrec1.mood = wh   
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel]
   >

      COMP
         <
          C1: NPrec1.cases * [Accusative, Nominative, 
                           Prepositive] <> [] AND
              CLAUSErec1.synvpefs * AUX_nppredvps <> []
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: NPrec1.cases * [Accusative, Nominative, 
                           Prepositive] <> [] AND
              CLAUSErec2.synvpefs * AUX_nppredvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_nppredvps ;
         >


   SUBRULE (* predrel, NPVAR *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:predrel/T1, I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/T1, mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(predrel, rel7)
       I8: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
           (T1.CAT IN [CNVAR])
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel]
   >

      COMP
         <
          C1: (T1.CAT IN [NPVAR, CNVAR] WITH 
                T1.REC.cases * [Accusative, 
                           Prepositive, Nominative] <> [] 
              )                                         AND
              CLAUSErec1.synvpefs * [synser,synestar] <> []
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: ( T1.CAT IN [NPVAR, CNVAR] WITH 
                 T1.REC.cases * [Accusative, 
                           Prepositive, Nominative] <> [] 
              )       AND
              CLAUSErec2.synvpefs * [synser,synestar] <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * [synser,synestar];
         >


   SUBRULE (* locargrel, VARPREPP *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:locargrel/VARPREPP{VARPREPPrec1}[mu10], I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/VARPREPP{VARPREPPrec1}[mu10], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, locargrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(locargrel, rel7)
       I8: (VARPREPPrec1.mood = wh 
            OR EXIST(mu10,[I81:../T1]) 
           )                        AND 
           loc IN VARPREPPrec1.actsubcefs
            I81: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
                 (T1.CAT IN [CNVAR])
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_locargvps <> [] 
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_locargvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_locargvps ;
         >



   SUBRULE (* dirargrel, VARPREPP *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:dirargrel/VARPREPP{VARPREPPrec1}[mu10], I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/VARPREPP{VARPREPPrec1}[mu10], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, dirargrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(dirargrel, rel7)
       I8: (VARPREPPrec1.mood = wh 
            OR EXIST(mu10,[I81:../T1]) 
           )                        AND 
           dir IN VARPREPPrec1.actsubcefs
            I81: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
                 (T1.CAT IN [CNVAR])
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_dirargvps <> [] 
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_dirargvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_dirargvps ;
         >


   SUBRULE (* prepobjrel, VARPREPP *)
      <mu1 :[ mu9, predrel/VERBP{VERBPrec1}
                     [I6:mu6, I8:prepobjrel/VARPREPP{VARPREPPrec1}[mu10], I7:mu7 ], mu12 ]>
      <mu11:[ I8:shiftrel/VARPREPP{VARPREPPrec1}[mu10], mu9, 
               predrel/VERBP{VERBPrec1}[ I6:mu6, I7:mu7], mu12 ]>

   MATCHCONDITIONS
      <
       I6: ALL(mu6, I61:rel6/..) AND NOT EXIST(mu6, [I62:rel2/..])
           I61: QUOTE_VPrelprec(rel6, prepobjrel)
       I7: ALL(mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/..])
           I71: QUOTE_VPrelprec(prepobjrel, rel7)
       I8: (VARPREPPrec1.mood = wh) 
            OR EXIST(mu10,[I81:../T1]) 
            I81: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood]) OR
                 (T1.CAT IN [CNVAR])
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_prepobjvps <> [] 
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_prepobjvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_prepobjvps ;
         >


>
&

\end{verbatim}
