                     futuro  : sifuturo
                    };
         >


   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.tiempo IN [futuro, omegatiempo])
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    }
              )

             )

             C11:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A11:CLAUSErec2 := CLAUSErec1;
             

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo)
             )
              C11: (CLAUSErec2.supertiempo = pasado) (* switch *)
              A11: CLAUSErec1 := CLAUSErec2;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              VERBrec3 :=
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    };

         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjtiempo IN [futuro, omegatiempo]) AND
           (SENTENCErec1.temporal = true)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    }
              )
             )

             C11:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A11:CLAUSErec2 := CLAUSErec1;
             

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo)
             )
              C11: (CLAUSErec2.supertiempo = pasado) (* switch *)
              A11: CLAUSErec1 := CLAUSErec2;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              VERBrec3 :=
                   {
                     numero  : omeganumero
                     persona : 3
                     modo    : omegamodo
                     tiempo  : omegatiempo
                     aspecto : omegaaspecto
                     status  : bareV
                     futuro  : sifuturo
                    };

         >


