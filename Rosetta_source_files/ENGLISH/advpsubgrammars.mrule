  Rstartadvpprop120/3  )
.
   (* TC_AdvPatterns *)
( TadvPattern0/4   | TadvPattern1/5 )  
.
   (* RC_AdvTempVar *)
   (* RC_AdvSentAdvVar *)
   (* RC_AdvLocAdvVar *)
{ RAdvRefvarInsertion/7   |  RAdvConjsentVar/10 | 
  RAdvFinalConjsentVar/12 |  RAdvSentAdvVar/11  |
  RAdvLocAdvVar/8         |  RAdvLocPreppVar/9 }
.
   (* RC_AdvVoiceRules *)
( RadvppropVoice/6 )



