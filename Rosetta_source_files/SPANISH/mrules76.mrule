\newpage
\begin{verbatim}
% RULE RSUBNOUNtoNOUN1                 (* count singular/onlyplur  *)
< m1: SUBNOUN{SUBNOUNrec1}[mu1]
>

< m : NOUN{NOUNrec1}[head/SUBNOUN{SUBNOUNrec1}[mu1]
                    ]
>

      COMP
         <
          C1: count IN SUBNOUNrec1.posscomas
            C11: SUBNOUNrec1.pluralforma <> nosingular 
            A11: NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
                 NOUNrec1.numero := singular;
                 NOUNrec1.posscomas := [count];
                 (* oneigenlijk gebruik van inherent attribuut *)
            C12: SUBNOUNrec1.pluralforma = nosingular 
            A12: NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
                 NOUNrec1.numero := plural;
          A1: @

         >

      DECOMP
         < 
          C1: NOUNrec1 = COPYT_SUBNOUNtoNOUN(SUBNOUNrec1) AND
              count IN SUBNOUNrec1.posscomas 
             C11: SUBNOUNrec1.pluralforma <> nosingular AND
                  NOUNrec1.numero = singular
             A11: @ 
             C12: SUBNOUNrec1.pluralforma = nosingular AND
                  NOUNrec1.numero = plural
             A12: @ 
          A1:  @
         >

 
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] SUBNOUNtoNOUN1
\item[* relevant examples:] 
\item[* language:]  Spanish 
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) NPformationrules
(?)
\item[* date of creation:] 05-AUG-1988 11:52:44  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] determining the 'number' of count NOUNs (singular):
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item 

Onlyplurals are accepted both by this rule and by Rsubnountonoun2. 
That is: {\em tijeras } $\rightarrow$ {\em een schaar}, 
but also: {\em tijeras} $\rightarrow$ {\em scharen}. 
\item
There may be examples where there is no singular count noun available
where this is incorrect. 
\item
To be checked: gaat tijeras in combinatie met tres ook met deze regel??

\item
In its present form this rule assign to an inherent attribute of NOUNrec1.
\item modifications:\\

\end{enumerate}
\end{description}
\newpage
\begin{verbatim}
% RULE RSUBNOUNtoNOUN2    (* mass/plural *)
< m1: SUBNOUN{SUBNOUNrec1}[mu1]
>

< m : NOUN{NOUNrec1}[head/SUBNOUN{SUBNOUNrec1}[mu1]
                    ]
>

   PARAMETERS
      <
       numberpar:numerotype
      >

      COMP
         <
          C1: true
        C11: numberpar = singular AND
             mass IN SUBNOUNrec1.posscomas AND
             SUBNOUNrec1.pluralforma <>  nosingular
        A11: NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
             NOUNrec1.numero := singular;
             NOUNrec1.posscomas := [mass];
             (* cf. remarks at A14 *)
         C12: numberpar = singular AND
             ((SUBNOUNrec1.pluralforma = nosingular) OR
             (SUBNOUNrec1.posscomas  = [count]))
        A12: NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
             NOUNrec1.numero := plural;
        C13: numberpar = plural AND
             count IN SUBNOUNrec1.posscomas  AND
             SUBNOUNrec1.pluralforma <> NoPlural
        A13: NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
             NOUNrec1.numero := plural;
        C14: numberpar = plural AND
             SUBNOUNrec1.posscomas  = [mass] 
        A14: NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
             NOUNrec1.numero := singular;
             NOUNrec1.posscomas := [mass];
             (* oneigenlijk gebruik van inherent attribuut; 
                het lijkt verdedigbaar om het niveau van NOUN 
                actcomas ipv poscomas te hebben *)
      A1: @
         >

      DECOMP
         <
          C1: NOUNrec1 = COPYT_SUBNOUNtoNOUN(SUBNOUNrec1)
            C11: NOUNrec1.numero = singular AND
                 mass IN SUBNOUNrec1.posscomas 
            A11: numberpar := singular;
            C13: NOUNrec1.numero = plural AND
                 (SUBNOUNrec1.pluralforma = nosingular OR
                  (SUBNOUNrec1.pluralforma <> nosingular AND
                   count IN SUBNOUNrec1.posscomas )
                 )
            A13: numberpar := plural;
          A1: @
         >
&

\end{verbatim}
