\newpage
\begin{verbatim}
% FILTER FNoTopic
< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              predrel/VERBP{VERBPrec1}[mu2], 
              mu3 
            ]
>
  
   MATCHCONDITIONS
      <
       m: ( (EXIST (mu1, [I11:../T1]) OR
             EXIST (mu1, [../VARPREPP{VARPREPPrec1}
                            [mu4, 
                             I11:../T1,
                             mu5]
                         ]) 
             ) AND
             (NOT EXIST (mu1, [I11:shiftrel/T1]) OR 
              NOT EXIST (mu1, [I12: ../VERB{VERBrec1}[mu6]])
             )
          )
          OR
          EXIST (mu2, [I11:../T1]) OR
          EXIST (mu2, [../VARPREPP{VARPREPPrec1}
                                  [mu4, 
                                   I11:../T1,
                                   mu5]
                      ])    OR
          EXIST (mu3, [I11:../T1]) OR
          EXIST (mu3, [../VARPREPP{VARPREPPrec1}
                                  [mu4, 
                                   I11:../T1,
                                   mu5]
                      ]) 
       I11: ( T1.CAT IN [NPVAR, ADVPVAR] 
                  WITH T1.REC.mood IN [topicmood, relativexpmood] )
            OR
            ( T1.CAT IN [PREPPVAR] 
                  WITH T1.REC.mood IN [topicmood] )
       I12: VERBrec1.subc = modalverb
      >



         <
          C1: true
          A1: @
         >

&

\end{verbatim}
