% TRANSFORMATION TNoControl5
                             (* CLOSEDPREPPPROP, predrel *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I2:rel1/CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}
                             [ subjrel/T1,
                               predrel/VARPREPP{VARPREPPrec1}[mu3] 
                             ],
                      mu4 
                    ],
             mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      objrel/T1,
                      I2:rel1/VARPREPP{VARPREPPrec1}[mu3],
                      mu4 
                    ],
             mu5
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2,[objrel/..])
       I2: rel1 IN [locargrel, dirargrel]
      >


<
   SUBRULE
      <T1: NP{NPrec1}[mu6] >
      <T1: NP{NPrec1}[mu6] >

      COMP
         <
          C1: (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synEMPTY_OTHERCLOSEDPREPPPROP,
                                      synANP_OTHERCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP,
                                      synOTHERCLOSEDPREPPPROP] <> []) AND
              CLOSEDPREPPPROPrec1 =
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : false
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synEMPTY_OTHERCLOSEDPREPPPROP,
                                      synANP_OTHERCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP,
                                      synOTHERCLOSEDPREPPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs *
                                    [synDIRCLOSEDPREPPPROP,
                                     synEMPTY_OTHERCLOSEDPREPPPROP,
                                     synANP_OTHERCLOSEDPREPPPROP,
                                     synLOCCLOSEDPREPPPROP,
                                     synOTHERCLOSEDPREPPPROP];
              CLOSEDPREPPPROPrec1 :=
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : false
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
         >


   SUBRULE
      <T1: T2 >
      <T1: T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR, CNVAR]
      >

      COMP
         <
          C1: (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synEMPTY_OTHERCLOSEDPREPPPROP,
                                      synANP_OTHERCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP,
                                      synOTHERCLOSEDPREPPPROP] <> []) AND
              CLOSEDPREPPPROPrec1 =
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : false
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synEMPTY_OTHERCLOSEDPREPPPROP,
                                      synANP_OTHERCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP,
                                      synOTHERCLOSEDPREPPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs *
                                    [synDIRCLOSEDPREPPPROP,
                                     synEMPTY_OTHERCLOSEDPREPPPROP,
                                     synANP_OTHERCLOSEDPREPPPROP,
                                     synLOCCLOSEDPREPPPROP,
                                     synOTHERCLOSEDPREPPPROP];
              CLOSEDPREPPPROPrec1 :=
		   {
