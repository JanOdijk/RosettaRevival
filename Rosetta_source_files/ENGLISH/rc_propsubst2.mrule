\newpage
\begin{verbatim}

% RULE RConjSentSubst
< m1:     I3::N1
               [ leftdislocrel/I1::SENTENCEVAR{SENTENCEVARrec1},
                 mu2,
                 I4:rel1/N2[mu3],
                 mu4
               ] 
  SUBST:
  m2: SENTENCE{SENTENCErec1}[I5:mu5]
>

< m :     I3::N1
               [ leftdislocrel/SENTENCE{SENTENCErec1}[I5:mu5,
                                                      I2:sig1],
                 mu2,
                 I4:rel1/N2[mu3],
                 mu4
               ] 
>

   MATCHCONDITIONS
      <
       m : NOT EXIST(mu2, [I11:../T1]) AND
           NOT EXIST(mu3, [I11:../T1]) AND
           NOT EXIST(mu4, [I11:../T1])
         I11: T1.CAT IN AUX_propvarcats OR
              ( T1.CAT IN [NPVAR] WITH 
                T1.REC.NPhead IN [sentNP, openIngNP] )
       I1: SENTENCEVARrec1.index = LEVEL
       I2: ALL (sig1, puncrel/PUNC(KEY_commaPUNCkey){PUNCrec2})
       I3: N1.CAT IN [VERBPPROP, ADJPPROP, NPPROP, PREPPPROP, ADVPPROP]
       I4: ( rel1 = predrel AND 
             N2.CAT IN [VERBP, ADJP, NP, PREPP, ADVP] ) 
           OR 
           ( rel1 = idrel AND N2.CAT IN [NPVAR, SENTENCEVAR] ) OR
           ( rel1 = objrel AND N2.CAT IN [NPVAR] )
       I5: EXIST (mu5, [conjrel/I51::CONJ{CONJrec1}]) OR
           EXIST (mu5, [conjrel/PREP{PREPrec2}])
         I51: initial IN CONJrec1.distri
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* 1. no comma *)
      < >
      < sig1: [] >

      DECOMP
         <
          C1: SENTENCErec1.adverbial= true AND
              SENTENCErec1.temporal = false AND
              SENTENCErec1.mood = declarative 
          A1: SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL
         >

   SUBRULE (* 2. comma *)
      < >
      < sig1: [puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1}] >

      COMP
         <
          C1: SENTENCErec1.adverbial = true AND
              SENTENCErec1.temporal = false AND
              SENTENCErec1.mood = declarative AND
              SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)
          A1: @
         >
      DECOMP
         <
          C1: SENTENCErec1.adverbial= true AND
              SENTENCErec1.temporal = false AND
              SENTENCErec1.mood = declarative 
          A1: SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL
         >
>
&

\end{verbatim}
