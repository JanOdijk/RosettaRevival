      <mu7: [I11:mu11, tresCLrel/T5]>                                       
      <mu8: [I11:mu11, rel3/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(KEY_vosotrasBPERSPROkey){BPERSPROrec1}]
            ]                                        
      >       
 

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
       I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]      
      >

      COMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.numero := plural;
              PERSPROrec1.persona := 2;
              PERSPROrec1.genero := fem;
              PERSPROrec1.forma := acusCL;
              rel3 := dosCLrel
         >

      DECOMP
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)            AND
              (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                            AND
              (PERSPROrec1.numero = plural)   AND
              (PERSPROrec1.persona = 2)       AND
              (PERSPROrec1.genero = fem)      AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = dosCLrel)
          A1:  @
         >

>
 
&

\end{verbatim}
