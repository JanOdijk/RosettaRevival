Reciprocalspelling:

\newpage
\begin{verbatim}
% RULE Rreciprocalsubst1
< m1:CLAUSE{CLAUSErec1}
            [ mu2, I3:subjrel/NPVAR{NPVARrec1}, mu6,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       cliticrel/CLITIC{CLITICrec1}
                         [ I8:sig1,
                           I9:sig2,
                           I10:sig3,
                           I11:sig4 
                         ],
                       mu7,
                       I2:rel2/I4::NPVAR{NPVARrec2},
                       mu4 
                     ],
              mu5
            ] 
SUBST:
 m2: NP{NPrec1}[head/RECIPRO(KEY4){RECIPROrec1}]
>

< m :CLAUSE{CLAUSErec1}
            [ mu2, subjrel/NPVAR{NPVARrec1}, mu6,
              predrel/VERBP{VERBPrec1}
                  I7:[ mu3,
                       cliticrel/CLITIC{CLITICrec1}
                         [ I12:sig5,
                           I13:sig6,
                           I14:sig7,
                           I15:sig8 
                         ],
                       mu7,
                       modrel/NP{NPrec3}
                             [ detrel/DETP{DETPrec1}[head/ART(KEY1){ARTrec1} ],
                               head/CN{CNrec1}[ modrel/NUM(KEY2){NUMrec1}]
                             ],
                       I2:rel2/NP{NPrec2}
                             [ detrel/DETP{DETPrec2}[head/ART(KEY3){ARTrec2} ],
                               head/CN{CNrec2}
                                 [modrel/ADJP{ADJPrec1}
                                    [head/ADJ{ADJrec1}
                                       [head/SUBADJ{SUBADJrec1}
                                          [head/BADJ(KEY_otroBADJkey){BADJrec1} ] 
                                       ] 
                                    ] 
                                 ]
                             ],
                       mu4 
                     ],
              mu5
            ] 
 
>



   MATCHCONDITIONS
      <
       I3 : NPVARrec1.index = antecedent
       I2 : rel2 IN [objrel, indobjrel]      
       I4 : NPVARrec2.index = LEVEL
       I7 : RIGHTTOLEFT (* intentionally absent in generation *)
       I8 : ALL(sig1, reflrel/..)
       I9 : ALL(sig2, dosCLrel/..)
       I10: ALL(sig3, unoCLrel/..)
       I11: ALL(sig4, tresCLrel/..)
       I12: ALL(sig5, reflrel/..)
       I13: ALL(sig6, dosCLrel/..)
       I14: ALL(sig7, unoCLrel/..)
       I15: ALL(sig8, tresCLrel/..)
      >

   PARAMETERS
      <
       LEVEL
       antecedent     : indextype
       numeropar      : numerotype
      >

<

   SUBRULE   (* nos ... los unos a los otros/ las unas a las otras*)
      < sig3: [] >
      < sig5: [sig1] sig6:[sig2] sig8:[sig4] 
        sig7:[unoCLrel/REFLPRO(KEY_nosREFLPROkey){REFLPROrec1}]
      >

      COMP
         <
          C1: NPVARrec1 =  {
                             persona : 1 
                             numero  : plural
                           }                          AND
              NPrec1.genero = NPVARrec1.genero        AND
              NPVARrec2 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.generic = nogeneric AND
              NPrec1.cases = []  AND
              QUOTE_tiempomax(CLAUSErec1.tiempo, CLAUSErec1.supertiempo,
                            NPrec1.supertiempo) 
              C11: numeropar = singular AND
                   KEY4 = KEY_mascreciprokey AND
                   NPrec1 = AUX_NPonmascrecipro EXCEPT FOR [supertiempo]
              A11: KEY1 := KEY_elARTkey;
                   KEY3 := KEY_elartkey;
                   KEY2 := KEY_unoNUMkey;
                   DETPrec1 := AUX_DETPonelART;
                   DETPrec2 := AUX_DETPonelART;
              C12: numeropar = plural AND
                   KEY4 = KEY_mascreciprokey AND
                   NPrec1 = AUX_NPonmascrecipro EXCEPT FOR [supertiempo]
              A12: KEY1 := KEY_losARTkey;
                   KEY3 := KEY_losartkey;
                   KEY2 := KEY_unosNUMkey;
                   DETPrec1 := AUX_DETPonlosART;
                   DETPrec2 := AUX_DETPonlosART;
              C13: numeropar = singular AND
                   KEY4 = KEY_femreciprokey AND
                   NPrec1 = AUX_NPonfemrecipro EXCEPT FOR [supertiempo]
              A13: KEY1 := KEY_laARTkey;
                   KEY3 := KEY_laartkey;
                   KEY2 := KEY_unaNUMkey;
                   DETPrec1 := AUX_DETPonlaART;
                   DETPrec2 := AUX_DETPonlaART;
              C14: numeropar = plural AND
                   KEY4 = KEY_femreciprokey AND
                   NPrec1 = AUX_NPonfemrecipro EXCEPT FOR [supertiempo]
              A14: KEY1 := KEY_lasARTkey;
                   KEY3 := KEY_lasartkey;
                   KEY2 := KEY_unasNUMkey;
                   DETPrec1 := AUX_DETPonlasART;
                   DETPrec2 := AUX_DETPonlasART;
          A1: NPrec3 := AUX_NPoneluno;
              NPrec3 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                  cases  : [Accusative]
                };
              NPrec2 := AUX_NPonelotro;
              NPrec2 := 
                {
                  numero : numeropar
                  genero : NPrec1.genero
                  cases  : [Prepositive]
                };
              SUBADJrec1 := AUX_subadjONotro;
              ADJrec1    := AUX_adjonotro;
              ADJPrec1   := AUX_adjponotro;
              ADJrec1 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                };
              ADJPrec1 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                };
              CNrec1 := AUX_CNonnohead;
              CNrec1 :=
                {
                  numero  : numeropar
                  generos : [NPrec1.genero]
                };
              CNrec2 := AUX_CNonnohead;
              CNrec2 :=
                {
                  numero  : numeropar
                  generos : [NPrec1.genero]
                };

         >
      DECOMP
         <
          C1: true
          A1: @
         >

   
   SUBRULE   (* os ... los unos a los otros/las unas a las otras*)
      < sig3: [] >
      < sig5: [sig1] sig6:[sig2] sig8:[sig4] 
        sig7:[unoCLrel/REFLPRO(KEY_osREFLPROkey){REFLPROrec1}]
      >

      COMP
         <
          C1: NPVARrec1 =  {
                             persona : 2 
                             numero  : plural
                           }                          AND
              NPrec1.genero = NPVARrec1.genero        AND
              NPVARrec2 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.generic = nogeneric AND
              NPrec1.cases = []  AND
              QUOTE_tiempomax(CLAUSErec1.tiempo, CLAUSErec1.supertiempo,
                            NPrec1.supertiempo) 
              C11: numeropar = singular AND
                   KEY4 = KEY_mascreciprokey AND
                   NPrec1 = AUX_NPonmascrecipro EXCEPT FOR [supertiempo]
              A11: KEY1 := KEY_elARTkey;
                   KEY3 := KEY_elartkey;
                   KEY2 := KEY_unoNUMkey;
                   DETPrec1 := AUX_DETPonelART;
                   DETPrec2 := AUX_DETPonelART;
              C12: numeropar = plural AND
                   KEY4 = KEY_mascreciprokey AND
                   NPrec1 = AUX_NPonmascrecipro EXCEPT FOR [supertiempo]
              A12: KEY1 := KEY_losARTkey;
                   KEY3 := KEY_losartkey;
                   KEY2 := KEY_unosNUMkey;
                   DETPrec1 := AUX_DETPonlosART;
                   DETPrec2 := AUX_DETPonlosART;
              C13: numeropar = singular AND
                   KEY4 = KEY_femreciprokey AND
                   NPrec1 = AUX_NPonfemrecipro EXCEPT FOR [supertiempo]
              A13: KEY1 := KEY_laARTkey;
                   KEY3 := KEY_laartkey;
                   KEY2 := KEY_unaNUMkey;
                   DETPrec1 := AUX_DETPonlaART;
                   DETPrec2 := AUX_DETPonlaART;
              C14: numeropar = plural AND
                   KEY4 = KEY_femreciprokey AND
                   NPrec1 = AUX_NPonfemrecipro EXCEPT FOR [supertiempo]
              A14: KEY1 := KEY_lasARTkey;
                   KEY3 := KEY_lasartkey;
                   KEY2 := KEY_unasNUMkey;
                   DETPrec1 := AUX_DETPonlasART;
                   DETPrec2 := AUX_DETPonlasART;
          A1: NPrec3 := AUX_NPoneluno;
              NPrec3 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                  cases  : [Accusative]
                };
              NPrec2 := AUX_NPonelotro;
              NPrec2 := 
                {
                  numero : numeropar
                  genero : NPrec1.genero
                  cases  : [Prepositive]
                };
              SUBADJrec1 := AUX_subadjONotro;
              ADJrec1    := AUX_adjonotro;
              ADJPrec1   := AUX_adjponotro;
              ADJrec1 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                };
              ADJPrec1 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                };
              CNrec1 := AUX_CNonnohead;
              CNrec1 :=
                {
                  numero  : numeropar
                  generos : [NPrec1.genero]
                };
              CNrec2 := AUX_CNonnohead;
              CNrec2 :=
                {
                  numero  : numeropar
                  generos : [NPrec1.genero]
                };

         >
      DECOMP
         <
          C1: true
          A1: @
         >
   


   SUBRULE   (* se ... los unos a los otros, las unas a los otras*)
      < sig3: [] >
      < sig5: [sig1] sig6:[sig2] sig8:[sig4] 
        sig7:[unoCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1}]
      >

      COMP
         <
          C1: NPVARrec1 =  {
                             persona : 3 
                             numero  : plural
                           }                          AND
              NPrec1.genero = NPVARrec1.genero        AND
              NPVARrec2 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.generic = nogeneric AND
              NPrec1.cases = []  AND
              QUOTE_tiempomax(CLAUSErec1.tiempo, CLAUSErec1.supertiempo,
                            NPrec1.supertiempo) 
              C11: numeropar = singular AND
                   KEY4 = KEY_mascreciprokey AND
                   NPrec1 = AUX_NPonmascrecipro EXCEPT FOR [supertiempo]
              A11: KEY1 := KEY_elARTkey;
                   KEY3 := KEY_elartkey;
                   KEY2 := KEY_unoNUMkey;
                   DETPrec1 := AUX_DETPonelART;
                   DETPrec2 := AUX_DETPonelART;
              C12: numeropar = plural AND
                   KEY4 = KEY_mascreciprokey AND
                   NPrec1 = AUX_NPonmascrecipro EXCEPT FOR [supertiempo]
              A12: KEY1 := KEY_losARTkey;
                   KEY3 := KEY_losartkey;
                   KEY2 := KEY_unosNUMkey;
                   DETPrec1 := AUX_DETPonlosART;
                   DETPrec2 := AUX_DETPonlosART;
              C13: numeropar = singular AND
                   KEY4 = KEY_femreciprokey AND
                   NPrec1 = AUX_NPonfemrecipro EXCEPT FOR [supertiempo]
              A13: KEY1 := KEY_laARTkey;
                   KEY3 := KEY_laartkey;
                   KEY2 := KEY_unaNUMkey;
                   DETPrec1 := AUX_DETPonlaART;
                   DETPrec2 := AUX_DETPonlaART;
              C14: numeropar = plural AND
                   KEY4 = KEY_femreciprokey AND
                   NPrec1 = AUX_NPonfemrecipro EXCEPT FOR [supertiempo]
              A14: KEY1 := KEY_lasARTkey;
                   KEY3 := KEY_lasartkey;
                   KEY2 := KEY_unasNUMkey;
                   DETPrec1 := AUX_DETPonlasART;
                   DETPrec2 := AUX_DETPonlasART;
          A1: NPrec3 := AUX_NPoneluno;
              NPrec3 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                  cases  : [Accusative]
                };
              NPrec2 := AUX_NPonelotro;
              NPrec2 := 
                {
                  numero : numeropar
                  genero : NPrec1.genero
                  cases  : [Prepositive]
                };
              SUBADJrec1 := AUX_subadjONotro;
              ADJrec1    := AUX_adjonotro;
              ADJPrec1   := AUX_adjponotro;
              ADJrec1 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                };
              ADJPrec1 :=
                {
                  numero : numeropar
                  genero : NPrec1.genero
                };
              CNrec1 := AUX_CNonnohead;
              CNrec1 :=
                {
                  numero  : numeropar
                  generos : [NPrec1.genero]
                };
              CNrec2 := AUX_CNonnohead;
              CNrec2 :=
                {
                  numero  : numeropar
                  generos : [NPrec1.genero]
                };

         >
      DECOMP
         <
          C1: true
          A1: @
         >


>
&

\end{verbatim}
