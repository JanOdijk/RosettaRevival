pragma C_include('oldtree.pf');
pragma C_include('drawtree.pf');
pragma C_include('superdtree.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE DrawSuperDtree;
WITH OLDTREE, DRAWTREE, SUPERDTREE;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawSuperDtree_GenerateTree
 *  Description     : Prints the super D-tree in a newly created window on the screen.
 *                    The user can walk through the tree by means of the cursor
 *                    keys. He furthermore can enlarge a node by hitting the 
 *                    "DO" key. Before returning control to the calling program
 *                    the window is closed.
 *                    Actually the set of Dtrees contained in the SuperDtree is
 *                    printed.
 *  Parameters      : OldNode: SuperDtree_pSuperDtree; The D-tree that is to be printed
 *  Precondition    : Oldnode contains a correct superD-tree
 *  Postcondition   : None
 *  Side Effects    : The D-tree is printed on the screen
 *
 *EMP:::===================================================================*)

PROCEDURE DrawSuperDtree_GenerateTree(OldNode : SuperDtree_pSuperDtree);
EXTERNAL;


END {DrawSuperDtree};
