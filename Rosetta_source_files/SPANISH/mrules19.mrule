\begin{verbatim}
% TRANSFORMATION TADJagr

  (* agreement for (ser/estar +) ADJ; *)

< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ predrel/ADJP{ADJPrec1}[mu5,
                                             head/ADJ{ADJrec1}[mu8],
                                             mu9
                                             ],
                      mu6
                   ],
             mu7
            ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec2}
                    [ predrel/ADJP{ADJPrec2}[mu5,
                                             head/ADJ{ADJrec2}[mu8],
                                             mu9
                                             ],
                      mu6
                   ],
             mu7
            ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.synvpefs * [synSER, synESTAR] <> []
      >

<
   SUBRULE        (* 1 : NPVAR *)
      <T1:NPVAR{NPVARrec1}>
      <T1:NPVAR{NPVARrec1}>
      

      COMP
         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2 :=
                  { genero : NPVARrec1.genero
                    numero : NPVARrec1.numero
                  };

              ADJrec2 := ADJrec1;
              ADJrec2 :=
                  { genero : NPVARrec1.genero
                    numero : NPVARrec1.numero
                  }
         >

      DECOMP
         <
          C1: (ADJPrec2.genero = NPVARrec1.genero)    AND
              (ADJPrec2.numero = NPVARrec1.numero)    AND

              (ADJrec2.genero = NPVARrec1.genero)    AND
              (ADJrec2.numero = NPVARrec1.numero)

          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  };

              ADJrec1 := ADJrec2;
              ADJrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  }
         >


   SUBRULE        (* 2a : CNVAR, masc *)
      <T1:CNVAR{CNVARrec1}>
      <T1:CNVAR{CNVARrec1}>
      

      COMP
         <
          C1: 
              (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (masc IN CNVARrec1.generos)

          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.numero := CNVARrec1.numero;
              ADJPrec2.genero := masc;

              ADJrec2 := ADJrec1;
              ADJrec2.numero := CNVARrec1.numero;
              ADJrec2.genero := masc
         >

      DECOMP
         <
          C1: (masc IN CNVARrec1.generos)                         AND
              (ADJPrec2.numero = CNVARrec1.numero)                AND
              (ADJPrec2.genero = masc)                            AND

              (ADJrec2.numero = CNVARrec1.numero)                AND
              (ADJrec2.genero = masc)

          A1: ADJPrec1 := ADJPrec2;
               ADJPrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  };

               ADJrec1 := ADJrec2;
               ADJrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  }
         >


   SUBRULE        (* 2b : CNVAR, fem *)
      <T1:CNVAR{CNVARrec1}>
      <T1:CNVAR{CNVARrec1}>
      

      COMP
         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })
                                            AND
               (fem IN CNVARrec1.generos)

          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.numero := CNVARrec1.numero;
              ADJPrec2.genero := fem;

              ADJrec2 := ADJrec1;
              ADJrec2.numero := CNVARrec1.numero;
              ADJrec2.genero := fem
         >

      DECOMP
         <
          C1: (fem IN CNVARrec1.generos)                             AND
                                 
              (ADJPrec2.numero = CNVARrec1.numero)                   AND
              (ADJPrec2.genero = fem)                                AND

              (ADJrec2.numero = CNVARrec1.numero)                   AND
              (ADJrec2.genero = fem)

          A1: ADJPrec1 := ADJPrec2;
               ADJPrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  };

               ADJrec1 := ADJrec2;
               ADJrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  }
         >


   SUBRULE        (* 3 : PRONP *)
      <T1:PRONP{PRONPrec1}[mu10]>
      <T1:PRONP{PRONPrec1}[mu10]>
      

      COMP
         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                         AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2 :=
                  { genero : PRONPrec1.genero
                    numero : PRONPrec1.numero
                  };

              ADJrec2 := ADJrec1;
              ADJrec2 :=
                  { genero : PRONPrec1.genero
                    numero : PRONPrec1.numero
                  }

         >

      DECOMP
         <
          C1: (ADJPrec2.genero = PRONPrec1.genero)                AND
              (ADJPrec2.numero = PRONPrec1.numero)                AND

              (ADJrec2.genero = PRONPrec1.genero)                AND
              (ADJrec2.numero = PRONPrec1.numero)

          A1: ADJPrec1 := ADJPrec2;
               ADJPrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  };

               ADJrec1 := ADJrec2;
               ADJrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  }
         >


   SUBRULE     (* 4 : NP *)
      <T1:I4::NP{NPrec1}[mu11]>
      <T1:I4::NP{NPrec1}[mu11]>
      

   MATCHCONDITIONS
      <
       I4: NPrec1.NPhead IN [ redelloNP, redellosNP, eseNP, esteNP, aquelNP]
      >

      COMP
         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                         AND
               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2 :=
                  { genero : NPrec1.genero
                    numero : NPrec1.numero
                  };

              ADJrec2 := ADJrec1;
              ADJrec2 :=
                  { genero : NPrec1.genero
                    numero : NPrec1.numero
                  }
         >

      DECOMP
         <
          C1: (ADJPrec2.genero = NPrec1.genero)                 AND
              (ADJPrec2.numero = NPrec1.numero)                 AND

             (ADJrec2.genero = NPrec1.genero)                 AND
              (ADJrec2.numero = NPrec1.numero)


          A1: ADJPrec1 := ADJPrec2; 
               ADJPrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  };

               ADJrec1 := ADJrec2; 
               ADJrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  }

         >


   SUBRULE        (* 5 : PRONPVAR *)
      <T1:PRONPVAR{PRONPVARrec1}>
      <T1:PRONPVAR{PRONPVARrec1}>
      

      COMP
         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2 :=
                  { genero : PRONPVARrec1.genero
                    numero : PRONPVARrec1.numero
                  };

              ADJrec2 := ADJrec1;
              ADJrec2 :=
                  { genero : PRONPVARrec1.genero
                    numero : PRONPVARrec1.numero
                  }

         >

      DECOMP
         <
          C1: (ADJPrec2.genero = PRONPVARrec1.genero)        AND
              (ADJPrec2.numero = PRONPVARrec1.numero)        AND

              (ADJrec2.genero = PRONPVARrec1.genero)        AND
              (ADJrec2.numero = PRONPVARrec1.numero) 


          A1: ADJPrec1 := ADJPrec2;     
               ADJPrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  };

               ADJrec1 := ADJrec2;     
               ADJrec1 :=
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  }

         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TADJagr
\item[* relevant examples:]
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPTOCLAUSE
\item[* class:] TC:TSVagr
\item[* date of creation:] 26-JAN-1989 
\item[* author:] Lisette Appelo
\item[* copied from:] TSVagr2
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] 
To make the ADJ in a clause with ser/estar agree in "persona" and "genero" 
with the subject.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
Ren\'{e} made it possible to use {\bf variable keys}. In the model 
(KEY1) is given, and in the matchcondition: \\
(KEY1 = serBVERBkey) OR (KEY1 = estarBVERBkey)\\
However, since the attribute synvpefs  of CLAUSE can give the same information
in this case, I decided to use this, instead of 
embedding to the BVERB-level.
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]none
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

