% RULE RMood3     (*wh main clause, finite, indicative *)
< m1:I6::CLAUSE{CLAUSErec1}
           [ I3:shiftrel/T1,
             mu1,
             head/VERB{VERBrec1}
                 [ I1:rel1/VERB{VERBrec2}[mu3],
                   mu4
                 ],
             mu5
           ] 
>

< m :I7::SENTENCE{SENTENCErec1}
             [ I3:shiftrel/T1,
               mu1,
               head/VERB{VERBrec1}
                   [ I1:rel1/VERB{VERBrec3}[mu3],
                     mu4
                   ],
               mu5
             ] 
>

   MATCHCONDITIONS
      <
       I1 : rel1 IN [head, auxrel]
       I3 : T1.CAT IN [NP, PREPP, ADJP, ADVP]
       I6 : CLAUSErec1.finiteness = finite  AND
            CLAUSErec1.tiempo <> omegatiempo AND
            CLAUSErec1.modo = omegamodo
       I7 : SENTENCErec1.tiempo <> omegatiempo AND
            SENTENCErec1 =
		   {
                    modo       : indicativo
                    finiteness : finite
 		    mood       : whinterrogative
		    senttype   : mainclause
                    conjkey    : 0
                    adverbial  : false
                    temporal   : false
		    conjclass  : omegaTimeAdvClass
		    conjtiempo : omegatiempo
		    conjaspecto : omegaaspecto
		    conjretro  : false
		   }
      >


      COMP
         <
          C1: T1.REC.mood = wh AND 
              VERBrec2.modo = omegamodo AND
              (((VERBrec2.tiempo = pasado) AND
                (VERBrec2.futuro = nofuturo)
               ) -> 
               VERBrec2.aspecto <> omegaaspecto
              )
          A1: VERBrec3 := VERBrec2;
              VERBrec3.modo := indicativo;
              SENTENCErec1 := COPYT_clausetosentence(CLAUSErec1);
              SENTENCErec1 :=
		   {
 		    mood     : whinterrogative
		    senttype : mainclause
                    modo    : indicativo
		   }
            (* other attributes retain default values *)
         >

      DECOMP
         <
          C1: T1.REC.mood = wh AND
              VERBrec3.modo  = indicativo AND
              (((VERBrec3.tiempo = pasado) AND 
                (VERBrec3.futuro = nofuturo)
               ) ->
               VERBrec3.aspecto <> omegaaspecto
              )
          A1: VERBrec2 := VERBrec3;
              VERBrec2.modo := omegamodo;
              CLAUSErec1 := COPYT_sentencetoclause(sentencerec1);
              CLAUSErec1.modo := omegamodo;
         >


&

\end{verbatim}

