% RULE RNPformation14
< m1:  RECIPRO{RECIPROrec1}
>

< m : NP{NPrec1}[head/RECIPRO{RECIPROrec1}]
>

      COMP
         <
          C1: true
          A1: NPrec1 := {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaaspecto
		  retro         : false
		  definite      : def
		  persona       : 3
		  numero        : RECIPROrec1.numero
		  cases         : []
		  genero        : RECIPROrec1.genero 
		  actsubcs      : [othernoun]
		  temporal      : false
                  actcomas      : [count]
		  animate       : omegaanimate
		  human         : Omegahuman
		  mood          : declxpmood
		  generic       : nogeneric
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : false
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : nogeneric
		  syntquant     : omegaquant
		  NPhead        : othernp   (* moet worden: recipronp *)
		  specQ         : yesspec
                  defSpec       : true
                         
                        }
         >

      DECOMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = 
	         {req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaaspecto
		  retro         : false
		  definite      : def
		  persona       : 3
		  numero        : RECIPROrec1.numero
		  cases         : []
		  genero        : RECIPROrec1.genero 
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : omegaanimate
		  human         : Omegahuman
		  mood          : declxpmood
		  generic       : nogeneric
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : false
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : nogeneric
		  syntquant     : omegaquant
		  NPhead        : othernp   (* moet worden: recipronp *)
		  specQ         : yesspec
                  defSpec       : true
                         
                        }
          A1: @
                       
         >


&

\end{verbatim}
