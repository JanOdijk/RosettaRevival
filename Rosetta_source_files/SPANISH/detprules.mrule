\newpage
\begin{verbatim}
% RULE DETPformation2
< m1: NUM{NUMrec1} 
>

< m : DETP{DETPrec1}[head/NUM{NUMrec1}
                    ]
>

      COMP
         <
          C1: true
              C11: NUMrec1.key <>  KEY_'s_algunas_num_1' 
              A11: DETPrec1.genero := masc;
              C12: NUMrec1.key <>  KEY_'s_algunos_num_1' 
              A11: DETPrec1.genero := fem;
          A1: DETPrec1.numero      := NUMrec1.numero;
              DETPrec1.definite    := indef;
              DETPrec1.posspred    := true;
              DETPrec1.mood        := declxpmood;
              DETPrec1.posscomas   := [count];
              DETPrec1.syntquant   := omegaquant;    (* the distinction between 
                                                    omgequant and equant has 
                                                    become irrelevant; 26/5/88;
                                                  *)                    
                          
         >

      DECOMP
         <
          C1: (DETPrec1.numero = NUMrec1.numero) AND
              (DETPrec1.definite    = indef) AND
              (DETPrec1.posspred    = true) AND
              (DETPrec1.posscomas   = [count]) AND
              (DETPrec1.mood   = declxpmood) AND
              (DETPrec1.syntquant   = omegaquant)    (* see COMP *)
              C11: DETPrec1.genero = masc AND  
                   NUMrec1.key <>  KEY_'s_algunas_num_1' 
              A11: @
              C12: DETPrec1.genero = fem AND
                   NUMrec1.key <>  KEY_'s_algunos_num_1' 
              A12: @
           A1:  @
         >
&

\end{verbatim}
