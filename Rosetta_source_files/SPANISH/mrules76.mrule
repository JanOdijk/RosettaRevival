


SPANISH 76
&
\begin{verbatim}
%
% RULE BNOUNtoSUBNOUN   
< m1: BNOUN{BNOUNrec1} 
>

< m : SUBNOUN{SUBNOUNrec1}[head/BNOUN{BNOUNrec1}]
>                       

      COMP
         <
          C1:  true
          A1:  SUBNOUNrec1 := COPYT_bTOsubnoun(BNOUNrec1);
         >

      DECOMP
         <
          C1:  SUBNOUNrec1 = COPYT_bTOsubnoun(BNOUNrec1)
          A1:  @
         >
&

\end{verbatim}
