\begin{verbatim}

% RULE RNPpartitiveformation2    (* DETP + () + NOUN + posrel --> 
                                    DETP van POSSADJ + [() + NOUN] *)
                                 (* dos +  libros yo --> dos de mis libros *)

< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec3}[mu6],
                 mu7,
                 posrel/NP{NPrec1}
                          [
                          head/PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}]
                          ]
                ]
  m2: DETP{DETPrec1}[mu9]
>

< m : NP{NPrec2}[detrel/DETP{DETPrec3}[modrel/DETP{DETPrec2}[mu9],
                                       partrel/PREP(KEY_deprepkey){PREPrec1},
                                       head/POSSADJ{POSSADJrec1}
                                            [head/BPERSPRO{BPERSPROrec1}] 

                                      ],
                 mu1,
                 head/CN{CNrec1}[mu1,
                                 head/NOUN{NOUNrec3}[mu6],
                                 mu7
                                 ]
                ]
>


      COMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaAspecto
		  retro         : false
		  definite      : def
		  persona       : PERSPROrec1.persona
		  numero        : PERSPROrec1.numero
		  cases         : []
		  genero        : PERSPROrec1.genero
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : omegageneric
		  syntquant     : omegaquant
		  NPhead        : PERSPROrec1.NPhead
		  specQ         : yesspec
		  } AND
              PERSPROrec1 = COPYT_BTOPERSPRO(BPERSPROrec1) AND
              (DETPrec1.supertiempo= CNrec1.supertiempo) AND
              DETPrec1.genero IN NOUNrec3.generos AND
              DETPrec1.numero = NOUNrec3.numero


             C11: masc IN NOUNrec3.generos AND DETPrec1.genero = masc
                  C111: NOUNrec3.numero = singular
                  A111: POSSADJrec1.concordnumero := sing;
                  C112: NOUNrec3.numero = plural
                  A112: POSSADJrec1.concordnumero := plur;
             A11: NPrec2.genero := masc;

             C12: fem IN NOUNrec3.generos AND DETPrec1.genero = fem
                  C121: NOUNrec3.numero = singular
                  A121: POSSADJrec1.concordnumero := sing;
                  C122: NOUNrec3.numero = plural
                  A122: POSSADJrec1.concordnumero := plur;
             A12: NPrec2.genero := fem ;

          A1: DETPrec2 := DETPrec1;
              DETPrec2.supertiempo:= omegatiempo;
              DETPrec3 := 
                         { (* possnietnp  :  DETPrec1.possnietnp *)
                           definite    :  adef
                           posspred    :  DETPrec2.posspred
                           numero      :  DETPrec2.numero
                                            (* om uno de mis aan te kunnen 
                                               is extra atribuut nodig *)
                           genero      :  DETPrec2.genero
                           posscomas   :  DETPrec2.posscomas
                           mood        :  DETPrec2.mood
                           supertiempo:  omegatiempo
                           }; 
              NPrec2 :=  { posspred          : DETPrec3.posspred
                          definite          : adef
                          (* possnietnp        : DETPrec3.possnietnp *)
                          mood              : DETPrec3.mood

                          numero            : NOUNrec3.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         } ;
         >

      DECOMP
         <
          C1: POSSADJrec1.antecedent = noant AND
              DETPrec2.supertiempo= omegatiempo AND
              DETPrec1.genero IN NOUNrec3.generos AND
              DETPrec1.numero = NOUNrec3.numero AND
              DETPrec3 = 
                         { (* possnietnp  :  DETPrec2.possnietnp*) 
                           definite    :  adef
                           posspred    :  DETPrec2.posspred
                           numero      :  DETPrec2.numero
                                            (* om een van mijn aan te kunnen 
                                               is extra atribuut nodig *)
                           genero      :  DETPrec2.genero
                           posscomas   :  DETPrec2.posscomas
                           mood        :  DETPrec2.mood
                           } AND
               NPrec2 =  { posspred          : DETPrec3.posspred
                          definite          : adef
                          (* possnietnp        : DETPrec3.possnietnp*)
                          mood              : DETPrec3.mood

                          numero            : NOUNrec3.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         } 
             C11: masc IN NOUNrec3.generos AND 
                  DETPrec2.genero = masc AND
                  NPrec2.genero = masc
                  C111: NOUNrec3.numero = singular AND
                        POSSADJrec1.concordnumero = sing
                  A111: @
                  C112: NOUNrec3.numero = plural AND
                        POSSADJrec1.concordnumero = plur
                  A112: @
             A11: @
             C12: fem IN NOUNrec3.generos AND DETPrec2.genero =fem AND
                  NPrec2.genero = fem 
                  C121: NOUNrec3.numero = singular AND
                        POSSADJrec1.concordnumero = sing
                  A121: @
                  C122: NOUNrec3.numero = plural AND
                        POSSADJrec1.concordnumero = plur
                  A122: @
             A12: @

          A1: PERSPROrec1 := COPYT_BTOPERSPRO(BPERSPROrec1);
              NPrec1 := 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaAspecto
		  retro         : false
		  definite      : def
		  persona       : PERSPROrec1.persona
		  numero        : PERSPROrec1.numero
		  cases         : []
		  genero        : PERSPROrec1.genero
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  actcomas      : [count]
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : omegageneric
		  syntquant     : omegaquant
		  NPhead        : PERSPROrec1.NPhead
		  specQ         : yesspec
		  };
           DETPrec1 := DETPrec2;
           DETPrec1.supertiempo := CNrec1.supertiempo;
         >

&

\end{verbatim}
