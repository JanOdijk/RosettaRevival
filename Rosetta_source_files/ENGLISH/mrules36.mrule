                  (CLAUSErec1.aspect = imperfective)
                 ) OR
                 (PREPPrec1.aspect = imperfective)
                )
               )
              )
              C11: CLAUSErec1.deixis <> omegadeixis AND
                   PREPPrec1.superdeixis = CLAUSErec1.deixis
              A11: @
              C12: CLAUSErec1.superdeixis <> omegadeixis AND
                   PREPPrec1.superdeixis = CLAUSErec1.superdeixis
              A12: @
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: temp IN PREPPrec2.actsubcefs AND
              (((PREPPrec2.class = reference) AND
                (PREPPrec2.retro = false)
               ) OR
               (PREPPrec2.class = frequential) OR
               ((PREPPrec2.class = duration) AND
                ((PREPPrec2.aspect = perfective) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((PREPPrec2.aspect = imperfective) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               ) OR
               (((PREPPrec2.class = reference) AND
                 (PREPPrec2.retro = true) 
                ) AND
                (((PREPPrec2.aspect = perfective) AND
                  (CLAUSErec1.aspect = imperfective)
                 ) OR
                 (PREPPrec2.aspect = imperfective)
                )
               )
              )
              C11: CLAUSErec1.deixis <> omegadeixis
              A11: PREPPrec1 := PREPPrec2;
                   PREPPrec1.superdeixis := CLAUSErec1.deixis;
              C12: CLAUSErec1.superdeixis <> omegadeixis
              A12: PREPPrec1 := PREPPrec2;
                   PREPPrec1.superdeixis := CLAUSErec1.superdeixis
          A1: PREPPVARrec1 := COPYT_prepptovar(PREPPrec1);
              PREPPVARrec1.index := LEVEL;
         >

   SUBRULE (* 2. VARPREPP *)
      < T1: VARPREPP{VARPREPPrec1}[mu5] >
      < T2: VARPREPP{VARPREPPrec2}[mu5] >

      COMP
         <
          C1: temp IN VARPREPPrec1.actsubcefs AND
              PREPPVARrec1 = COPYT_prepptovar(VARPREPPrec1) AND
              (((VARPREPPrec1.class = reference) AND
                (VARPREPPrec1.retro = false)
               ) OR
               (VARPREPPrec1.class = frequential) OR
               ((VARPREPPrec1.class = duration) AND
                ((VARPREPPrec1.aspect = perfective) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((VARPREPPrec1.aspect = imperfective) AND
                 (CLAUSErec1.aktionsarts * 
                            [accomplishment, achievement] <> [])
                )
               ) OR
               (((VARPREPPrec1.class = reference) AND
                 (VARPREPPrec1.retro = true) 
                ) AND
                (((VARPREPPrec1.aspect = perfective) AND
                  (CLAUSErec1.aspect = imperfective)
                 ) OR
                 (VARPREPPrec1.aspect = imperfective)
                )
               )
              )
              C11: CLAUSErec1.deixis <> omegadeixis AND
                   VARPREPPrec1.superdeixis = CLAUSErec1.deixis
              A11: @
              C12: CLAUSErec1.superdeixis <> omegadeixis AND
                   VARPREPPrec1.superdeixis = CLAUSErec1.superdeixis
              A12: @
          A1: VARPREPPrec2 := VARPREPPrec1;
              VARPREPPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: temp IN VARPREPPrec2.actsubcefs AND
              (((VARPREPPrec2.class = reference) AND
                (VARPREPPrec2.retro = false)
               ) OR
               (VARPREPPrec2.class = frequential) OR
               ((VARPREPPrec2.class = duration) AND
                ((VARPREPPrec2.aspect = perfective) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((VARPREPPrec2.aspect = imperfective) AND
                 (CLAUSErec1.aktionsarts * 
                            [accomplishment, achievement] <> [])
                )
               ) OR
               (((VARPREPPrec2.class = reference) AND
                 (VARPREPPrec2.retro = true) 
                ) AND
                (((VARPREPPrec2.aspect = perfective) AND
                  (CLAUSErec1.aspect = imperfective)
                 ) OR
                 (VARPREPPrec2.aspect = imperfective)
                )
               )
              )
              C11: CLAUSErec1.deixis <> omegadeixis
              A11: VARPREPPrec1 := VARPREPPrec2;
                   VARPREPPrec1.superdeixis := CLAUSErec1.deixis;
              C12: CLAUSErec1.superdeixis <> omegadeixis
              A12: VARPREPPrec1 := VARPREPPrec2;
                   VARPREPPrec1.superdeixis := CLAUSErec1.superdeixis
          A1: PREPPVARrec1 := COPYT_prepptovar(VARPREPPrec1);
              PREPPVARrec1.index := LEVEL;
         >

>

&

\end{verbatim}

