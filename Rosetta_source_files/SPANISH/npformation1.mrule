\begin{verbatim}

% RULE RNPformation8
< m1:PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}[]]
>

< m :NP{NPrec1}[head/PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}[]]
               ]
>
   MATCHCONDITIONS
      <
        m: NPrec1 = { 
                      persona   : 3
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }

      >

      COMP
         <
          C1: true
              C11: BPERSPROrec1.key <> KEY_redellosbpersprokey
              A11: NPrec1.NPhead := persproNP;
                   NPrec1.generic := nogeneric          
              C12: BPERSPROrec1.key = KEY_redellosbpersprokey
              A12: NPrec1.NPhead := redellosNP;
                   NPrec1.generic := yesgeneric 
          A1: NPrec1:=
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaaspecto
		  retro         : false
		  definite      : def
		  persona       : PERSPROrec1.persona
		  numero        : PERSPROrec1.numero
		  cases         : []
		  genero        : PERSPROrec1.genero 
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  actcomas      : [count]
		  mood          : declxpmood
		  generic       : nogeneric
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : declxpmood
		  syntquant     : omegaquant
		  specQ         : yesspec
                  defSpec       : false
		  }

         >
      DECOMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  supertiempo   : omegatiempo
		  tiempo        : omegatiempo
		  aspecto       : omegaaspecto
		  retro         : false
		  definite      : def
		  persona       : PERSPROrec1.persona
		  numero        : PERSPROrec1.numero
		  cases         : []
		  genero        : PERSPROrec1.genero 
		  actsubcs      : [othernoun]
		  temporal      : false
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  mood          : declxpmood
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : declxpmood
		  generic       : nogeneric
		  syntquant     : omegaquant
		  specQ         : yesspec
                  defSpec       : false
		  }
              C11: BPERSPROrec1.key <> KEY_redellosbpersprokey AND
                   NPrec1.NPhead = perspronp AND
                   NPrec1.generic = nogeneric
              A11: @
              C12: BPERSPROrec1.key = KEY_redellosbpersprokey AND
                   NPrec1.NPhead = redellosNP AND
                   NPrec1.generic = yesgeneric
              A12: @
          A1: @
         >

&


\end{verbatim}
