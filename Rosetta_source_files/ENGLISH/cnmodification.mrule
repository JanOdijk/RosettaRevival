\begin{verbatim}
% RULE RCNmodADVP2

<  m1: CN{CNrec1}[mu1,
                 I1:head/NOUN{NOUNrec1}[mu2],
                 I3:mu3
                 ]

  m2: I2::ADVP{ADVPrec1}[mu4]
>

< m : CN{CNrec1}[mu1,
                 I1:head/NOUN{NOUNrec1}[mu2],
                 I3:mu3,
                 postmodrel/I2::ADVP{ADVPrec1}[mu4]
                ]
>

   MATCHCONDITIONS
      <
       I1: NOUNrec1.subcs * [monthnoun, daynoun] <> []
       I2: tempadv IN ADVPrec1.actsubcefs AND
           ADVPrec1.mood = nowh
       I3: NOT EXIST(mu3,[postmodrel/SENTENCE{SENTENCErec1}[mu9] ]) 
      >


      COMP
         <
          C1: ADVPrec1.superdeixis = CNrec1.superdeixis 
          A1: CNrec1.poss := false;
         >

      DECOMP
         <
          C1: CNrec1.poss = false
          A1: ADVPrec1.superdeixis := CNrec1.superdeixis;
              
         >
&


\end{verbatim}
