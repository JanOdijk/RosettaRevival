\newpage
\begin{verbatim}
% TRANSFORMATION TNOControl1  
                              (* CLOSEDADJJPPROP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      complrel/CLOSEDADJPPROP{CLOSEDADJPPROPrec1}
                             [ subjrel/T1,
                               predrel/ADJP{ADJPrec1}[mu3]
                             ],
                      mu4
                    ],
             mu5 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      objrel/T1,
                      predrel/ADJP{ADJPrec1}[mu3],
                      mu4
                    ],
             mu5 
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [objrel/..])
      >

<
   SUBRULE
      <T1:NP{NPrec1}[mu6] >
      <T1:NP{NPrec1}[mu6] >


      COMP
         <
          C1: ( CLOSEDADJPPROPrec1 =
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
              )        AND
                (CLAUSErec1.synvpefs * [synCLOSEDADJPPROP,
                                        synEMPTY_CLOSEDADJPPROP,
                                        synANP_CLOSEDADJPPROP] <> [])

          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synCLOSEDADJPPROP,
                                      synEMPTY_CLOSEDADJPPROP,
                                      synANP_CLOSEDADJPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLOSEDADJPPROPrec1 :=
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
         >


   SUBRULE
      <T1: T2 >
      <T1: T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [ NPVAR, CNVAR]
      >


      COMP
         <
          C1: ( CLOSEDADJPPROPrec1 =
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
              )        AND
                (CLAUSErec1.synvpefs * [synCLOSEDADJPPROP,
                                        synEMPTY_CLOSEDADJPPROP,
                                        synANP_CLOSEDADJPPROP] <> [])
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synCLOSEDADJPPROP,
                                      synEMPTY_CLOSEDADJPPROP,
                                      synANP_CLOSEDADJPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLOSEDADJPPROPrec1 :=
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
         >
>
&

\end{verbatim}
