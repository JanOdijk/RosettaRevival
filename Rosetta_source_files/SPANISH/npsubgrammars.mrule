% RULE RCLOSEDNPPROPformation

< m1: NPPROP{NPPROPrec1}[mu1]
>

< m : CLOSEDNPPROP{CLOSEDNPPROPrec1}[mu1]
>

      COMP
         <
          C1: NPPROPrec1.PROsubject = false
          A1: CLOSEDNPPROPrec1 := NPPROPrec1;
         >

      DECOMP
         <
          C1: CLOSEDNPPROPrec1.PROsubject = false
          A1: NPPROPrec1 := CLOSEDNPPROPrec1;
         >

&

\end{verbatim}
