

LANGUAGE : SPANISH

PARAMETER TRANSLATION
   <
     adjunctpar:adjuncttype <-> adjunctpar:adjuncttype =
     (resAP      <-> ilResAP,
      resPP      <-> ilResPP, 
      SubjComit  <-> ilComit, 
      ObjComit   <-> ilComit, 
      BenfactNP  <-> ilBenfactNP,
      BenfactPP  <-> ilBenfactPP, 
      Locadjunct <-> ilLocAdjunct, 
      DirAdjunct <-> ilDirAdjunct, 
      resNP      <-> ilResNP
    )
     numberpar:numerotype <-> numberpar:numbertype =
    (singular <-> ILsingular, plural <-> ILplural)
     
     superpar:tiempotype <-> superpar:deixistype =     
     (presente <-> ilpresentdeixis, pasado <-> ilpastdeixis)
   
   >


