\begin{verbatim}
% TRANSFORMATION TPrepExceptCaseAssign
< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu5],
                           prepobjrel/PREPP{PREPPrec1}
                                     [ mu4,
                                       objrel/I2::SENTENCE
                                                  {SENTENCErec1}[mu3]
                                     ],
                           mu6
                         ],
                  mu7
                ]
>

< m : I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu5],
                           prepobjrel/PREPP{PREPPrec1}
                                     [ mu4,
                                       objrel/I2::SENTENCE
                                                  {SENTENCErec1}[mu8]
                                     ],
                           mu6
                         ],
                  mu7
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.voice <> passive 
       I2: SENTENCErec1.PROsubject = false
       I3: VERBrec1.Caseassigner = true AND 
           VERBrec1.thetavp IN [vp120, vp123] 
      >

(* \end{verbatim}
   \newpage
   \begin{verbatim}
*)

<
   SUBRULE  (* 1. the embedded subject has not been shifted *)
      < mu3: [I4:subjrel/T1, mu9] >
      < mu8: [I5:subjrel/T2, mu9] >

      MATCHCONDITIONS
         <
          I4: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [] 
          I5: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
         >

   <
     SUBRULE (* 1a. NPVAR *)
         < T1:NPVAR{NPVARrec1} >
         < T2:NPVAR{NPVARrec2} >

         COMP
            <
             C1: true
             A1: NPVARrec2 := NPVARrec1;
                 NPVARrec2.cases := [Accusative]
            >
         DECOMP
            <
             C1: true
             A1: NPVARrec1 := NPVARrec2;
                 NPVARrec1.cases := [] 
            >

      SUBRULE (* 1b. CNVAR *)
         < T1:CNVAR{CNVARrec1} >
         < T2:CNVAR{CNVARrec2} >

         COMP
            <
             C1: true
             A1: CNVARrec2 := CNVARrec1;
                 CNVARrec2.cases := [Accusative]
            >
         DECOMP
            <
             C1: true
             A1: CNVARrec1 := CNVARrec2;
                 CNVARrec1.cases := [] 
            >

      SUBRULE (* 1c. NP *)
         < T1:NP{NPrec1}[mu10] >
         < T2:NP{NPrec2}[mu11] >

         COMP
            <
             C1: true
             A1: QUOTE_assigncase(NPrec1, mu10, NPrec2, mu11, [Accusative])
            >
         DECOMP
            <
             C1: true
             A1: QUOTE_assigncase(NPrec2, mu11, NPrec1, mu10, [] )
            >
      >
   
(* \end{verbatim}
   \newpage
   \begin{verbatim}
*)

   SUBRULE  (* 2. the embedded subject has been shifted *)
      < mu3: [I5:shiftrel/T1, I6:mu9] >
      < mu8: [I7:shiftrel/T2, I6:mu9] >

      MATCHCONDITIONS
         <
          I5: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [] 
          I6: NOT EXIST(mu9, [subjrel/..])
          I7: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
         >

      <
       SUBRULE (* 2a. NPVAR *)
          < T1:NPVAR{NPVARrec1} >
          < T2:NPVAR{NPVARrec2} >

          COMP
             <
              C1: true
              A1: NPVARrec2 := NPVARrec1;
                  NPVARrec2.cases := [Accusative]
             >
          DECOMP
             <
              C1: true
              A1: NPVARrec1 := NPVARrec2;
                  NPVARrec1.cases := [] 
             >

       SUBRULE (* 2b. CNVAR *)
          < T1:CNVAR{CNVARrec1} >
          < T2:CNVAR{CNVARrec2} >

          COMP
             <
              C1: true
              A1: CNVARrec2 := CNVARrec1;
                  CNVARrec2.cases := [Accusative]
             >
          DECOMP
             <
              C1: true
              A1: CNVARrec1 := CNVARrec2;
                  CNVARrec1.cases := [] 
             >

       SUBRULE (* 2c. NP *)
          < T1:NP{NPrec1}[mu10] >
          < T2:NP{NPrec2}[mu11] >

          COMP
             <
              C1: true
              A1: QUOTE_assigncase(NPrec1, mu10, NPrec2, mu11, [Accusative])
             >
          DECOMP
             <
              C1: true
              A1: QUOTE_assigncase(NPrec2, mu11, NPrec1, mu10, [] )
             >
      >
>

&
\end{verbatim}
