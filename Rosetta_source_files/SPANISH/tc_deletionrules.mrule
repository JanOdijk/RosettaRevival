                          [ mu4,
                            objrel/I2::NP{NPrec1}[mu5],
                            mu6
                          ],
                     mu7
                   ]
>


   MATCHCONDITIONS
      <
       I1: SENTENCErec1.voice = SEpassive
       I2: (NPrec1.NPhead = persproNP)    AND
           (NPrec1.animate = NoAnimate)   AND
           (Accusative IN NPrec1.cases)
      >

         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
