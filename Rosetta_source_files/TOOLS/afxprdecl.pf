pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('afxprlangspec.pf');

PACKAGE afxprDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     afxprLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   afxprDECL_Surfrulemode = (loccond, globcond);
   afxprDECL_psyntcat     = ^afxprLANGSPEC_Category;
   afxprDECL_syntcatset   = SET OF afxprLANGSPEC_Category;
   afxprDECL_nodeid         = HINIT..HFINAL;
   afxprDECL_plonodeid      = ^afxprDECL_lonodeid;
   afxprDECL_lonodeid       = RECORD
   			          next: afxprDECL_plonodeid;
   			          arg : afxprDECL_nodeid
   	 	               END;
   afxprDECL_pSnode       = ^afxprDECL_Snode;
   afxprDECL_pRsnode      = ^afxprDECL_Rsnode;
   afxprDECL_Rsnode       = RECORD
                                sonnumber:afxprDECL_nodeid;
                                node    : afxprDECL_pSnode;
                                brother : afxprDECL_pRsnode
                             END;
   afxprDECL_Snode        = RECORD
                                sonlist : afxprDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : afxprLANGSPEC_Category;
                                ldfield : afxprLANGSPEC_FieldDef
                             END;
   afxprDECL_pLostree     = ^afxprDECL_Lostree;
   afxprDECL_Lostree      = RECORD
                                next    : afxprDECL_pLostree;
                                arg     : afxprDECL_pSnode
                             END;
   afxprDECL_pConnectionnode
                           = ^afxprDECL_Connectionnode;
   afxprDECL_pSingleSegmList
                           = ^afxprDECL_SingleSegmList;
   afxprDECL_Connectionnode 
                           = RECORD
                                list    : afxprDECL_pSingleSegmList;
                                next,
                                prev    : afxprDECL_pConnectionnode;
                                idnr    : integer
                             END;
   afxprDECL_SingleSegmList
                           = RECORD
                                next    : afxprDECL_pSingleSegmlist;
                                rn      : afxprDECL_pConnectionnode;
                                stree   : afxprDECL_pSnode
                             END;
   afxprDECL_psurfgraph     = ^afxprDECL_surfgraphtype;
   afxprDECL_psurfgraphnode = ^afxprDECL_surfgraphnode;
   afxprDECL_surfgraphtype  = RECORD
   			          first,
   			          last: afxprDECL_psurfgraphnode
   		               END;
   afxprDECL_plossurfgraphnode 
                             = ^afxprDECL_lossurfgraphnode;
   afxprDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : afxprDECL_plossurfgraphnode;
   			       END;
   afxprDECL_lossurfgraphnode 
                             = RECORD
   				   next :  afxprDECL_plossurfgraphnode;
   				   arg  :  afxprDECL_psurfgraphnode
   			       END;
   afxprDECL_surfgraphnode  = RECORD
      			          left,
   			          right: afxprDECL_psurfgraphnode;
   			          n    : afxprDECL_nodeid;
   			          cat  : afxprDECL_psyntcat;
   			          nextnodes: afxprDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : afxprDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

