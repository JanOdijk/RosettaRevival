pragma C_include('windows.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE Help;
WITH WINDOWS;

(*MPT:::===================================================================*
 *
 *  Type name      : Help_Windows
 *  Description    : Unique names for windows used in the Rosetta system
 *
 *EMP:::===================================================================*)

TYPE
   Help_Windows = (Help_Input, Help_Output, Help_MainMenu, Help_Control,
                   Help_InteractionMain, Help_Interaction, Help_Edit, 
                   Help_Options);



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Help_Init
 *  Description     : Initializes all help windows.
 *  Parameters      : None 
 *  Preconditions   : GlobDef_SetDevice has been called
 *EMP:::===================================================================*)

PROCEDURE Help_Init;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Help_Connect
 *  Description     : Connects help window to specified window
 *  Parameters      : hw: Help_Windows;
 *                    w : Windows_Window
 *  Precondition    : Help_Init has been called
 *
 *EMP:::===================================================================*)

PROCEDURE Help_Connect(hw: Help_Windows;
                                  VAR w : Windows_Window);
EXTERNAL;


END {Help};
