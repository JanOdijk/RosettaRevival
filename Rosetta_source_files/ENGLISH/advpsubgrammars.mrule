\newpage
\begin{verbatim}
% RULE RadvppSuperdeixis
< m1: ADVPFORMULA{ADVPFORMULArec1}[mu1] 
>

< m : ADVPFORMULA{ADVPFORMULArec2}[mu1] 
>

   PARAMETERS
      <
       super : deixistype
      >

      COMP
         <
          C1: ADVPFORMULArec1.superdeixis = omegadeixis AND
              super IN [presentdeixis, pastdeixis]
          A1: ADVPFORMULArec2 := ADVPFORMULArec1;
              ADVPFORMULArec2.superdeixis := super;
         >
      DECOMP
         <
          C1: ADVPFORMULArec2.superdeixis IN [presentdeixis, pastdeixis]
          A1: ADVPFORMULArec1 := ADVPFORMULArec2;
              ADVPFORMULArec1.superdeixis := omegadeixis;
              super := ADVPFORMULArec2.superdeixis;
         >
&

\end{verbatim}
