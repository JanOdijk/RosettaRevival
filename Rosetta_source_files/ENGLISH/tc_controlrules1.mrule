>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: NOT EXIST (mu3, [objrel/..])
       I4: NOT EXIST (mu2, [I41:auxrel/VERB{VERBrec1}[mu11]])
         I41: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec2 = NPVARrec1 AND
              (* including cases, which should be Nominative *)
              CLAUSErec1.synvpefs * AUX_openxppvps <> [] AND
              OPENNPPROPrec1 = { superdeixis    : omegadeixis
                                 aktionsarts    : [stative]
                                 PROsubject     : true 
                                 thetanp        : NPrec1.thetanp
                                 nounpatternefs : NPrec1.nounpatternefs }
              (* no test on req and env *)
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [resNP] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
              C11:  CLAUSErec2.synvpefs * AUX_openxppvps <> []
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs := 
                       CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [resNP] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: OPENNPPROPrec1 := { thetanp        : NPrec1.thetanp
                                  nounpatternefs : NPrec1.nounpatternefs
                                  PROsubject     : true 
                                  aktionsarts    : [stative] }
              (* superdeixis retains default value *);
              NPVARrec2 := NPVARrec1;
               >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec2 = CNVARrec1 AND
              (* including cases, which should be Nominative *)
              OPENNPPROPrec1 = { superdeixis    : omegadeixis
                                 aktionsarts    : [stative]
                                 PROsubject     : true 
                                 thetanp        : NPrec1.thetanp
                                 nounpatternefs : NPrec1.nounpatternefs }
              (* no test on req and env *)
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> []
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [resNP] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
              C11:CLAUSErec2.synvpefs * AUX_openxppvps <> []
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs := 
                       CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [resNP] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: OPENNPPROPrec1 := { thetanp        : NPrec1.thetanp
                                  nounpatternefs : NPrec1.nounpatternefs
                                  PROsubject     : true 
                                  aktionsarts    : [stative] }
              (* superdeixis retains default value *);
              CNVARrec2 := CNVARrec1;
         >
>
&

\end{verbatim}
