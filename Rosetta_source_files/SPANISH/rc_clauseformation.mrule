\newpage
\begin{verbatim}
% RULE RClauseformation6a (* predicative, NPPROP, ser *)
< m1: NPPROP{NPPROPrec1}
            [ I2:mu1,
              predrel/NP{NPrec1}[mu2],
              mu3 
            ]
>

< m : I1::CLAUSE{CLAUSErec1}
            [ I2:mu1,
              predrel/VERBP{VERBPrec1}
                     [ head/VERB{VERBrec1}
                           [ head/SUBVERB{SUBVERBrec1}
                                 [head/BVERB(AUX_serbverbkey){BVERBrec1} ] 
                           ],
                       cliticrel/CLITIC{}[],
                       predrel/NP{NPrec1}[mu2] 
                     ],
              mu3 
            ]
>

   MATCHCONDITIONS
      <
        I1: (CLAUSErec1.voice = active ) AND
            (synSER IN CLAUSErec1.synvpefs )
        I2: NOT EXIST(mu1,[I21:subjrel/T1])
            I21: T1.CAT IN [NP,NPVAR] 
                      WITH T1.REC.NPhead IN [redelloNP,eseNP,esteNP,aquelNP]
      >


      COMP
         <
          C1: NPPROPrec1 =
		     { 
		      thetanp        : NPrec1.thetanp
		      nounpatternefs : NPrec1.nounpatternefs
		      PROsubject     : false
		     }

          A1: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
              (* all other attributes of verb retain their default values *)
              CLAUSErec1 :=
		     { 
		      req         : NPPROPrec1.req
		      voice       : Active
		      synvpefs    : [synSER]
		      aktionsarts : NPPROPrec1.aktionsarts
		      supertiempo : NPPROPrec1.supertiempo
		     }
         >

      DECOMP
         <
          C1: (CLAUSErec1 = CLAUSErecdef EXCEPT FOR [ req, voice, synvpefs,
                          aktionsarts, supertiempo ]) AND
              ( VERBrec1 =
		  { 
		   numero       : omeganumero   
		   persona      : 3  
		   modo         : infinitivo  
		   tiempo       : omegatiempo  
		   status       : bareV
		  }
              )
              (* the default values *) AND
              ( VERBrec1 = COPYT_subtoverb(SUBVERBrec1) ) AND
              ( SUBVERBrec1 = COPYT_btosubverb(BVERBrec1) )
          A1: NPPROPrec1 :=
		     { 
		      req            : CLAUSErec1.req
		      supertiempo    : CLAUSErec1.supertiempo
		      aktionsarts    : CLAUSErec1.aktionsarts
		      thetanp        : NPrec1.thetanp (*het is winter vs. 
                                                       hij is koning *)
		      nounpatternefs : NPrec1.nounpatternefs
		      PROsubject     : false
		     }
         >
&

\end{verbatim}
