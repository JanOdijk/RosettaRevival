\newpage
\begin{verbatim}
% TRANSFORMATION Tdeixisretroadaptation1
< m1: SENTENCE{SENTENCErec1}
            [mu1,
             head/VERB{VERBrec3}
                     [mu2,
                      rel2/VERB{VERBrec2}
                          [head/SUBVERB{SUBVERBrec1}
                              [head/BVERB(AUX_haberbverbkey){BVERBrec1}]
                          ],
                      rel1/VERB{VERBrec1}[mu3],
                      mu4
                     ],
             mu5
            ] 
>

< m : SENTENCE{SENTENCErec2}
            [mu1,
             head/VERB{VERBrec3}
                    [mu2,
                     rel2/VERB{VERBrec2}
                         [head/SUBVERB{SUBVERBrec1}
                              [head/BVERB(AUX_haberbverbkey){BVERBrec1}]
                         ],
                     rel1/VERB{VERBrec1}[mu3],
                     mu4
                    ],
               mu5
            ] 

>
   MATCHCONDITIONS
      <
      >

      COMP
         <
          C1: ((SENTENCErec1.aspecto = perfectivo) AND
               (SENTENCErec1.retro = false) AND
               (VERBrec1.modo = ptcpas)
              )
              C11: (SENTENCErec1.supertiempo = omegatiempo) AND
                   (SENTENCErec1.tiempo = pasado) AND
                   (SENTENCErec1.finiteness = infinite) AND
                   (VERBrec2.tiempo = omegatiempo)
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.tiempo := omegatiempo;

              C12: (SENTENCErec1.supertiempo = pasado) AND
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.finiteness = infinite) AND
                   (VERBrec2.tiempo = omegatiempo)
              A12: SENTENCErec2 := SENTENCErec1;

          A1: SENTENCErec2.retro := true;
         >
      DECOMP
         <
          C1: ((SENTENCErec2.retro = true) AND
               (SENTENCErec2.aspecto = perfectivo) AND
               (VERBrec1.modo = ptcpas)
              ) 
              C11: (SENTENCErec2.supertiempo = omegatiempo) AND
                   (SENTENCErec2.tiempo = omegatiempo) AND
                   (SENTENCErec2.finiteness = infinite) AND
                   (VERBrec2.tiempo = omegatiempo)
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.tiempo := pasado;

              C12: (SENTENCErec2.supertiempo = pasado) AND
                   (SENTENCErec2.tiempo = omegatiempo) AND
                   (SENTENCErec2.finiteness = infinite) AND
                   (VERBrec2.tiempo = omegatiempo)
              A12: SENTENCErec1 := SENTENCErec2;

          A1: SENTENCErec1.retro := false;
         >

&
\end{verbatim}
