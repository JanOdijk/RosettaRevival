SPANISH 63
&
\begin{verbatim}
%
% TRANSFORMATION TADJPATTERN0   (* hace frio,
                                   es importante que venga (via extrapositie),
                                   el que venga es importante *)

< m1:  ADJPPROP{ADJPPROPrec1}
               [mu1,
                predrel/ADJP{ADJPrec1}
                             [head/ADJ{ADJrec1}[mu2] 
                             ] 
                ]
>
< m :  ADJPPROP{ADJPPROPrec2}
               [mu1,
                predrel/ADJP{ADJPrec2}
                             [head/ADJ{ADJrec1}[mu2] 
                             ] 
                ]
>

      COMP
         <
          C1: (ADJrec1.adjpatterns = [synnoadjpargs]) AND
              (ADJPrec1.adjpatternefs = [])  AND
              (ADJPPROPrec1.adjpatternefs = []) 
          A1: ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synnoadjpargs];
              ADJPPROPrec2.adjpatternefs := [synnoadjpargs];
         >
      DECOMP
         <
          C1: (ADJrec1.adjpatterns = [synnoadjpargs]) AND 
              (ADJPrec2.adjpatternefs = [synnoadjpargs]) AND
              (ADJPPROPrec2.adjpatternefs = [synnoadjpargs] )
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []  
         >
&

\end{verbatim}
