\newpage
\begin{verbatim}
% TRANSFORMATION TCNapocope

< m1 : CN{CNrec1}[modrel/I2::ADJP{ADJPrec1}
                                  [head/I3::ADJ{ADJrec1} [mu2]],
                  I1:mu1            
                 ]
>
<
   m : CN{CNrec1}[modrel/I5::ADJP{ADJPrec2}
                                 [ head/I4::ADJ{ADJrec2}[mu2] ],
                     I1:mu1            
                 ]
>
   
      MATCHCONDITIONS
       <     
       I1: EXIST (mu1,[I11:head/T1])
       I11: T1.CAT = NOUN
       I2: ADJPrec1.genero = masc AND
           ADJPrec1.numero = singular AND
           ADJPrec1.apocope = FALSE
       I5:ADJPrec2.genero = masc AND
          ADJPrec2.numero = singular
       I3: ADJrec1.possapocope = si AND
           ADJrec1.apocope = FALSE
       I4: ADJrec2.possapocope = si 
       >

      COMP
        <
        C1:true 
        A1:ADJrec2 := ADJrec1;
           ADJPrec2 := ADJPrec1;
           ADJrec2.apocope := TRUE;
           ADJPrec2.apocope := TRUE 
        >
      
      DECOMP
         <
          C1: ADJrec2.apocope = TRUE AND
              ADJPrec2.apocope = TRUE
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.apocope := FALSE;
              ADJrec1 := ADJrec2;
              ADJrec1.apocope := FALSE
         >

&

\end{verbatim}
