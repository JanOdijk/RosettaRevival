\begin{verbatim}

% TRANSFORMATION TOblByobjControlComplSent   (* complrel/SENT,
                                                byobj ant. *)
< m1:CLAUSE{CLAUSErec1}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/I2::VERB{VERBrec1}[mu6],
                      mu3,
                      complrel/I1::SENTENCE{SENTENCErec1}
                              [I3:sig1,
                               subjrel/T2,
                               I5:mu5
                              ],
                      mu7,
                      byobjrel/VARPREPP{VARPREPPrec1}
                              [head/PREP{PREPrec1},
                               objrel/T1
                              ]
                    ],
             mu8
            ]
>

< m :CLAUSE{CLAUSErec1}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/I2::VERB{VERBrec1}[mu6],
                      mu3,
                      complrel/I1::SENTENCE{SENTENCErec1}
                              [I3:sig1,
                               I5:mu5
                              ],
                      mu7,
                      byobjrel/VARPREPP{VARPREPPrec1}
                              [head/PREP{PREPrec1},
                               objrel/T1
                              ]
                    ],
             mu8
           ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCErec1.PROsubject = true
       I2: VERBrec1 = { controller : subject
                        oblcontrol : nooblcontrol }
       I3: ALL (sig1, shiftrel/..)
       I4: NOT EXIST (mu1, [I41:auxrel/VERB{VERBrec2}[mu9]])
         I41: VERBrec2.subc = modalverb
       I5: NOT EXIST (mu5, [shiftrel/..]) 
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 
              (* including cases, which is nominative *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is nominative *)
         >

   SUBRULE (* CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 
              (* including cases, which is nominative *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which is nominative *)
         >
>
&

\end{verbatim}
