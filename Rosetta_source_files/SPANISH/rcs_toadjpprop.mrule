\newpage
\begin{verbatim}
% RULE RADJSubstitution2

< m1: ADJPFORMULA{ADJPFORMULArec1}
                 [mu1,
                  predrel/ADJP{ADJPrec1}
                          [mu2,
                           I1:rel1/VARPREPP{VARPREPPrec1}
                                   [mu4,
                                    objrel/I3::NPVAR{NPVARrec1}
                                   ],
                           mu3
                          ]
                 ] 
SUBST:
  m2: NP{NPrec1}[mu5]
>

< m : ADJPFORMULA{ADJPFORMULArec1}
                 [mu1,
                  predrel/ADJP{ADJPrec1}
                          [mu2,
                           I2:rel1/PREPP{PREPPrec1}
                                   [mu4,
                                    objrel/NP{NPrec2}[mu6]
                                   ],
                           mu3
                          ]
                 ] 

>

   MATCHCONDITIONS
      <m1 : NOT EXIST(mu3, [I11:../T1])
       I11: (T1.cat IN AUX_VARCATSET) OR
            (T1.cat IN AUX_CTVARCATS)
       m : NOT EXIST(mu3, [I13:../T3])
       I13: (T3.cat IN AUX_VARCATSET) OR
            (T3.cat IN AUX_CTVARCATS)
       I1: (rel1 IN [prepobjrel, indobjrel, paraobjrel, tempadvrel])
       I2: (rel1 IN [prepobjrel, indobjrel, paraobjrel, tempadvrel])
       I3: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
             NPrec1.cases = [] AND
             NPrec1.generic = nogeneric
              C11: ADJPFORMULArec1.tiempo = omegatiempo AND
                   NPrec1.supertiempo  = ADJPFORMULArec1.supertiempo 
              A11: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo  := omegatiempo 
              C12: ADJPFORMULArec1.tiempo  <> omegatiempo              AND
                   NPrec1.supertiempo  = ADJPFORMULArec1.tiempo 
              A12: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
                   NPrec2.supertiempo  := omegatiempo   
          A1:PREPPrec1 := VARPREPPrec1;
             NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric 
              C11: ADJPFORMULArec1.tiempo  = omegatiempo  AND
                   NPrec2.supertiempo  = omegatiempo 
              A11: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[Nominative]); 
                   NPrec1.supertiempo  := ADJPFORMULArec1.supertiempo ;
              C12: ADJPFORMULArec1.tiempo  <> omegatiempo  AND
                   NPrec2.supertiempo  = omegatiempo   
              A12: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[Nominative]); 
                   NPrec1.supertiempo  := ADJPFORMULArec1.tiempo ;
          A1:VARPREPPrec1 := PREPPrec1;
             NPVARrec1 := COPYT_nptovar(NPrec2);
             NPVARrec1.index := LEVEL;
             NPrec1.generic := nogeneric
         >
&

\end{verbatim}
