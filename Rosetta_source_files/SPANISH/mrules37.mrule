SPANISH 37
&
\newpage
\begin{verbatim}
%
% RULE Raspectimperfective
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [rel1/VERB{VERBrec1}[mu3],
                    mu2
                   ],
            I1: mu4
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [rel1/VERB {VERBrec2}[mu3],
                    mu2
                   ],
            I1: mu4
            ]
>
   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu4)
      >

      COMP
         <
          C1: CLAUSErec1.aspecto = omegaaspecto

              C11: (VERBrec1.aspecto = omegaaspecto)
              A11: VERBrec2 := VERBrec1;
                   VERBrec2.aspecto := imperfectivo;

              C12: (VERBrec1.aspecto = omegaaspecto)
              A12: VERBrec2 := VERBrec1;
 
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aspecto:= imperfectivo;
         >

      DECOMP
         <
          C1: CLAUSErec2.aspecto= imperfectivo

              C11: (VERBrec2.aspecto = imperfectivo)
              A11: VERBrec1 := VERBrec2;
                   VERBrec1.aspecto := omegaaspecto;

              C12: (VERBrec2.aspecto = omegaaspecto)
              A12: VERBrec1 := VERBrec2;
     
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.aspecto:= omegaaspecto;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Raspectimperfective
\item[* relevant examples:] 
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Aspectrules
\item[* date of creation:] 14-MAR-1988
\item[* author:] Lisette Appelo
\item[* copied from:] Raspectimperfective DUTCH
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] imperfective aspect relation between the interval E and a 
reference interval R
\item[\ \ strategy:] In this rule is checked if a duration adverbial is absent. 
Presence of a duration adverbial makes the aspect of an event perfective.
The verb is made imperfectivo form (for past tense forms later) or not changed
(omegaaspecto).
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application? (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: \\

\item in other languages: in English and Dutch aspect rules can have other
form effects. These languages do not always make a distinction between 
perfective and 
imperfective aspect forms.\\

\end{enumerate}
\item[* relevant literature/documents:] doc. 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

