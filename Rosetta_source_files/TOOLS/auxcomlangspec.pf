pragma c_include('tstring.pf');
package auxcomlangspec;
with tstring;
const
     auxcomlangspec_nrow = 12 ;
type setofchar = set of char;
type
     auxcomlangspec_int=integer;
     auxcomlangspec_bool=boolean;
     auxcomlangspec_leesteken = (haakopen,haaksluit,rechtopen,rechtsluit,rondopen,rondsluit,acculadeopen,acculadesluit,quoterechts,
quotelinks,dubbelequote,is,min,sterretje,apestaartje,hekje,dollarteken,uitroepteken,procent,dakje,en,onderstreepje,dubbelepunt,punt,
komma,puntcomma,vraagteken,terugslash,vooruitslash,verticaleslash,plusteken,invvraagteken,invuitroepteken,GeenLeesteken);
plosstring = ^losstring;
losstring = record
   next:plosstring;
   carriage:boolean;
   arg:tstring_string
 end; 
localfile = record 
first,last:plosstring
 end; 
auxcomlangspec_KEY = record 
string:TSTRING_string;
number:TSTRING_string;
stringlength:auxcomlangspec_int;

 end; 
plosKEY = ^losKEY;
losKEY = record
   next:plosKEY;
   arg:auxcomlangspec_KEY
 end; 
auxcomlangspec_setofKEYs = record 
first,last:plosKEY
 end; 
auxcomlangspec_ident = record 
str:TSTRING_string;

 end; 
plosident = ^losident;
losident = record
   next:plosident;
   arg:auxcomlangspec_ident
 end; 
auxcomlangspec_setofidents = record 
first,last:plosident
 end; 
     auxcomlangspec_pterminal = ^auxcomlangspec_terminal;
     auxcomlangspec_terminal = 
         record
                       str:tstring_string
           end;
     auxcomlangspec_puttrecord = ^auxcomlangspec_uttrecord;
     auxcomlangspec_uttrecord = 
         record
                      basetypes:auxcomlangspec_setofidents;
                     newentries:auxcomlangspec_bool;
           end;
     auxcomlangspec_plangrecord = ^auxcomlangspec_langrecord;
     auxcomlangspec_langrecord = 
         record
           end;
     auxcomlangspec_pkeyrecord = ^auxcomlangspec_keyrecord;
     auxcomlangspec_keyrecord = 
         record
                     newentries:auxcomlangspec_bool;
           end;
     auxcomlangspec_pargrecord = ^auxcomlangspec_argrecord;
     auxcomlangspec_argrecord = 
         record
                       oldentry:auxcomlangspec_bool;
           end;
     auxcomlangspec_parglistrecord = ^auxcomlangspec_arglistrecord;
     auxcomlangspec_arglistrecord = 
         record
           end;
     auxcomlangspec_ptermrecord = ^auxcomlangspec_termrecord;
     auxcomlangspec_termrecord = 
         record
           end;
     auxcomlangspec_ppunctrecord = ^auxcomlangspec_punctrecord;
     auxcomlangspec_punctrecord = 
         record
           end;
     auxcomlangspec_pnumrecord = ^auxcomlangspec_numrecord;
     auxcomlangspec_numrecord = 
         record
           end;
     auxcomlangspec_precrecord = ^auxcomlangspec_recrecord;
     auxcomlangspec_recrecord = 
         record
           end;
     auxcomlangspec_pnumrecrecord = ^auxcomlangspec_numrecrecord;
     auxcomlangspec_numrecrecord = 
         record
           end;
     auxcomlangspec_ptyperecord = ^auxcomlangspec_typerecord;
     auxcomlangspec_typerecord = 
         record
           end;
     auxcomlangspec_pfldlstrecord = ^auxcomlangspec_fldlstrecord;
     auxcomlangspec_fldlstrecord = 
         record
                  RecFieldCount:auxcomlangspec_INT;
           end;
     auxcomlangspec_pfldvalrecord = ^auxcomlangspec_fldvalrecord;
     auxcomlangspec_fldvalrecord = 
         record
           end;
     auxcomlangspec_pabbrrecord = ^auxcomlangspec_abbrrecord;
     auxcomlangspec_abbrrecord = 
         record
                    AbbrCounter:auxcomlangspec_INT;
                      basetypes:auxcomlangspec_setofidents;
           end;
     auxcomlangspec_pvarcatrecord = ^auxcomlangspec_varcatrecord;
     auxcomlangspec_varcatrecord = 
         record
           end;
     auxcomlangspec_pablstrecord = ^auxcomlangspec_ablstrecord;
     auxcomlangspec_ablstrecord = 
         record
           end;
     auxcomlangspec_pnumabbrecord = ^auxcomlangspec_numabbrecord;
     auxcomlangspec_numabbrecord = 
         record
                      typeident:TSTRING_string;
                  basementioned:auxcomlangspec_bool;
           end;
     auxcomlangspec_category = (comment,identifier,UTT,LANGVERSION,KEYSECTION,ARGUMENTS,ARGLIST,NUMBER,TERMARGUMENT,PUNCTUATION,
RECSECTION,NUMRECORDS,TYPESECTION,FIELDLIST,FIELDVALUE,VARCATSECTION,ABBRSECTION,ABBRLIST,NUMABBRS,LEFTARROW,RIGHTARROW,SQUAREOPEN,
SQUARECLOSE,ROUNDOPEN,ROUNDCLOSE,CURLYOPEN,CURLYCLOSE,DOUBLEQUOTE,RIGHTQUOTE,PLUS,MINUS,ASTERISK,EQUIVALENT,EXCLAMATION,QUARY,COLON,
COMMA,SEMICOLON,DOT,MONKEYTAIL,RAILING,DOLLAR,PERCENT,ROOF,ANDSIGN,UNDERSCORE,BACKSLASH,UPSLASH,FORWARDSLASH,INVQUARY,INVEXCLAMATION
,BASETYPE,SETTYPE,ABBRSETS,ABSTRACT,CATEGORY,KEYtje,KEYS,LANGUAGE,RECORDS,STANDARD,TERM,VARCATS);

auxcomlangspec_pfielddef = ^auxcomlangspec_fielddef;
auxcomlangspec_fielddef =
         record
      case cat:auxcomlangspec_category of
                  UTT:
                     (UTTfield:auxcomlangspec_puttrecord);
                  LANGVERSION:
                     (LANGVERSIONfield:auxcomlangspec_plangrecord);
                  KEYSECTION:
                     (KEYSECTIONfield:auxcomlangspec_pkeyrecord);
                  ARGUMENTS:
                     (ARGUMENTSfield:auxcomlangspec_pargrecord);
                  ARGLIST:
                     (ARGLISTfield:auxcomlangspec_parglistrecord);
                  NUMBER:
                     (NUMBERfield:auxcomlangspec_pnumrecord);
                  TERMARGUMENT:
                     (TERMARGUMENTfield:auxcomlangspec_ptermrecord);
                  PUNCTUATION:
                     (PUNCTUATIONfield:auxcomlangspec_ppunctrecord);
                  RECSECTION:
                     (RECSECTIONfield:auxcomlangspec_precrecord);
                  NUMRECORDS:
                     (NUMRECORDSfield:auxcomlangspec_pnumrecrecord);
                  TYPESECTION:
                     (TYPESECTIONfield:auxcomlangspec_ptyperecord);
                  FIELDLIST:
                     (FIELDLISTfield:auxcomlangspec_pfldlstrecord);
                  FIELDVALUE:
                     (FIELDVALUEfield:auxcomlangspec_pfldvalrecord);
                  VARCATSECTION:
                     (VARCATSECTIONfield:auxcomlangspec_pvarcatrecord);
                  ABBRSECTION:
                     (ABBRSECTIONfield:auxcomlangspec_pabbrrecord);
                  ABBRLIST:
                     (ABBRLISTfield:auxcomlangspec_pablstrecord);
                  NUMABBRS:
                     (NUMABBRSfield:auxcomlangspec_pnumabbrecord);
identifier,                  LEFTARROW,
                  RIGHTARROW,
                  SQUAREOPEN,
                  SQUARECLOSE,
                  ROUNDOPEN,
                  ROUNDCLOSE,
                  CURLYOPEN,
                  CURLYCLOSE,
                  DOUBLEQUOTE,
                  RIGHTQUOTE,
                  PLUS,
                  MINUS,
                  ASTERISK,
                  EQUIVALENT,
                  EXCLAMATION,
                  QUARY,
                  COLON,
                  COMMA,
                  SEMICOLON,
                  DOT,
                  MONKEYTAIL,
                  RAILING,
                  DOLLAR,
                  PERCENT,
                  ROOF,
                  ANDSIGN,
                  UNDERSCORE,
                  BACKSLASH,
                  UPSLASH,
                  FORWARDSLASH,
                  INVQUARY,
                  INVEXCLAMATION,
                  BASETYPE,
                  SETTYPE,
                  ABBRSETS,
                  ABSTRACT,
                  CATEGORY,
                  KEYtje,
                  KEYS,
                  LANGUAGE,
                  RECORDS,
                  STANDARD,
                  TERM,
                  VARCATS:
                     (      terminal:auxcomlangspec_pterminal);
           end;

procedure initint(var s:integer);external;
procedure initbool(var s:boolean);external;
procedure initsetofKEYs(var s:auxcomlangspec_setofKEYs); external;
function stillKEYs(var s:auxcomlangspec_setofKEYs):boolean; external;
procedure takeKEY(var KEY1:auxcomlangspec_KEY
        ;var s:auxcomlangspec_setofKEYs); external;
procedure appendKEY(KEY1:auxcomlangspec_KEY
        ;var s:auxcomlangspec_setofKEYs); external;
procedure initsetofidents(var s:auxcomlangspec_setofidents); external;
function stillidents(var s:auxcomlangspec_setofidents):boolean; external;
procedure takeident(var ident1:auxcomlangspec_ident
        ;var s:auxcomlangspec_setofidents); external;
procedure appendident(ident1:auxcomlangspec_ident
        ;var s:auxcomlangspec_setofidents); external;
 function auxcomlangspec_scanchars:setofchar;
         external;
 procedure auxcomlangspec_init; external;
 procedure auxcomlangspec_word(i:integer;var s:tstring_string);
         external;
 function auxcomlangspec_wcat(i:integer):auxcomlangspec_category;
         external;
 function auxcomlangspec_scat(c:char):auxcomlangspec_category;
         external;
 procedure auxcomlangspec_createterm(s:auxcomlangspec_category;
           w:tstring_string;var f:auxcomlangspec_fielddef);
         external;
end{langspec};
