 *  Remarks         : Implementation of the abstract datatype MDICT.
 *                    The module provides I/O functions for accessing
 *                    AMDICT and GMDICT.
 *
 *EMP:::===================================================================*)


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
pragma C_include('interface1.pf');
pragma C_include('string.pf');
pragma C_include('cisam.pf');
pragma C_include('limorfdef.pf');


PACKAGE LDMDICT;
WITH INTERFACE1, STRNG, CISAM, LIMORFDEF;


(*MPC:::===================================================================*
 *
 *  Constant name  : LDMDICT_MAXSTEM
 *  Description    : Maximum number of chars in a MDICT entry
 *
 *EMP:::===================================================================*)
CONST
   LDMDICT_MAXSTEM = 40;


(*MPT:::===================================================================*
 *
 *  Type name      : LDMDICT_StemType
 *  Description    : type of the stem in an MDICT entry.
 *
 *EMP:::===================================================================*)
TYPE
   LDMDICT_StemType  = PACKED ARRAY[1..LDMDICT_MAXSTEM] OF CHAR;


(*MPT:::===================================================================*
 *
 *  Type name      : LDMDICT_WhereType
 *  Description    : Determines whether the entry is relevant for analysis,
 *                   generation or for both.
 *
 *EMP:::===================================================================*)

   LDMDICT_WhereType = ( OnlyAn, OnlyGen, BothAnGen );



(*MPT:::===================================================================*
 *
 *  Type name      : LDMDICT_pMdictStruct
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LDMDICT_pMdictStruct = ^INTEGER;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMDICT_OpenMDict
 *  Description     : Open MDict for Read access
 *  Parameters      : none
 *  Precondition    : MDict is not yet open
 *  Postcondition   : MDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LDMDICT_OpenMdict;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMDICT_OpenMDictWrite
 *  Description     : Open MDict for Write access
 *  Parameters      : none
 *  Precondition    : MDict is not yet open
 *  Postcondition   : MDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LDMDICT_OpenMdictWrite;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMDICT_OpenMDictUpdate
 *  Description     : Open MDict for Update access
 *  Parameters      : none
 *  Precondition    : MDict is not yet open
 *  Postcondition   : MDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LDMDICT_OpenMdictUpdate;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_GetAMDict
 *  Description    : 
 *  Parameters     : stem     : STRING_String
 *                   VAR kind : INTERFACE1_KeyType;
 *                   VAR CC   : LIMORFDEF_ContextConds;
 *                   VAR FON  : LIMORFDEF_pPhonInfo;
 *                   VAR KEY  : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   stem
 *  Precondition   : MDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_GetAMdict(stem     : STRING_String;
                                      VAR kind : INTERFACE1_KeyType;
                                      VAR CC   : LIMORFDEF_ContextConds;
                                      VAR FON  : LIMORFDEF_pPhonInfo;
                                      VAR Where: LDMDICT_WhereType;
                                      VAR KEY  : INTEGER)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_GetNextAMDict
 *  Description    : 
 *  Parameters     : stem     : STRING_String
 *                   VAR kind : INTERFACE1_KeyType;
 *                   VAR CC   : LIMORFDEF_ContextConds;
 *                   VAR FON  : LIMORFDEF_pPhonInfo;
 *                   VAR KEY  : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   stem
 *  Precondition   : MDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_GetNextAMDict(stem     : STRING_String;
                                          VAR kind : INTERFACE1_KeyType;
                                          VAR CC   : LIMORFDEF_ContextConds;
                                          VAR FON  : LIMORFDEF_pPhonInfo;
                                          VAR Where: LDMDICT_WhereType;
                                          VAR KEY  : INTEGER)
                                          : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_GetGMDict
 *  Description    : 
 *  Parameters     : VAR stem : STRING_String
 *                   kind     : INTERFACE1_KeyType;
 *                   VAR CC   : LIMORFDEF_ContextConds;
 *                   VAR FON  : LIMORFDEF_pPhonInfo;
 *                   KEY      : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   stem
 *  Precondition   : MDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_GetGMDict(VAR stem : STRING_String;
                                      kind     : INTERFACE1_KeyType;
                                      VAR CC   : LIMORFDEF_ContextConds;
                                      VAR FON  : LIMORFDEF_pPhonInfo;
                                      VAR Where: LDMDICT_WhereType;
                                      KEY  : INTEGER)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_GetNextGMDict
 *  Description    : 
 *  Parameters     : VAR stem : STRING_String
 *                   kind     : INTERFACE1_KeyType;
 *                   VAR CC   : LIMORFDEF_ContextConds;
 *                   VAR FON  : LIMORFDEF_pPhonInfo;
 *                   KEY  : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   stem
 *  Precondition   : MDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_GetNextGMDict(VAR stem : STRING_String;
                                          kind     : INTERFACE1_KeyType;
                                          VAR CC   : LIMORFDEF_ContextConds;
                                          VAR FON  : LIMORFDEF_pPhonInfo;
                                          VAR Where: LDMDICT_WhereType;
                                          KEY  : INTEGER)
                                          : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMDICT_Release
 *  Description     : Unlock MDict 
 *  Parameters      : none
 *  Precondition    : MDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LDMDICT_Release;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMDICT_Reset
 *  Description     : Reset MDict 
 *  Parameters      : none
 *  Precondition    : MDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LDMDICT_Reset;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMDICT_CloseMDict
 *  Description     : Close MDict 
 *  Parameters      : none
 *  Precondition    : MDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LDMDICT_CloseMDict;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_WriteSequential
 *  Description    : Writes the record to the MDICT file
 *  Parameters     : rec: LDMDICT_pMDictStruct;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_WriteSequential(rec: LDMDICT_pMdictStruct): BOOLEAN;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_Update
 *  Description    : Updates the current record of the MDICT file
 *  Parameters     : rec: LDMDICT_pMDictStruct;
 *  Result         : VMSRMS_Statustype;
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_Update(rec: LDMDICT_pMdictStruct): CISAM_StatusType;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Function Name  : LDMDICT_Delete
 *  Description    : Deletes the current record of the MDICT file
 *  Parameters     : rec: LDMDICT_pMDictStruct;
 *  Result         : VMSRMS_Statustype;
 *
 *EMP:::===================================================================*)

FUNCTION LDMDICT_Delete: CISAM_StatusType;
EXTERNAL;

PROCEDURE LDMDICT_ReadRegardless(b: BOOLEAN);
EXTERNAL;

FUNCTION LDMDICT_GetNextMDict(VAR KEY  : INTEGER): BOOLEAN; 
EXTERNAL;

END {LDMDICT};
