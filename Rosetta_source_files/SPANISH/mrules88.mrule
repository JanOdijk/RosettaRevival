\begin{verbatim}
% RULE RPropsubst14       (* "toevallig" - happen; probably not necessary
                                                    for Spanish  *)
< m1: I1::ADVPPROP{ADVPPROPrec1}
              [ I4:mu18,
                I3:mu1,
                predrel/ADVP{ADVPrec1}
                       [ mu2,
                         head/ADV{ADVrec1}[mu3],
                         complrel/SENTENCEVAR{SENTENCEVARrec1},
                         mu4
                       ]
              ]
SUBST:
  m2: SENTENCE{SENTENCErec1}     (* substituent *)
                   [ subjrel/T1,
                     mu5,
                     predrel/VERBP{VERBPrec1}
                            [mu6,
                             rel2/VERB{VERBrec1}[mu7],
                             mu8],
                     mu9
                   ]
>
<
  m : VERBPPROP{VERBPPROPrec2}
               [ I4:mu18,
                 subjrel/T1,
                 mu5,
                 predrel/VERBP{VERBPrec1}
                        [mu6,
                         rel2/VERB{VERBrec2}[mu7],
                         mu8],
                 mu9,
                 I3:mu1,
                 rel1/I2::ADVP{ADVPrec1}
                          [ mu2,
                            head/ADV{ADVrec1}[mu3],
                            mu4
                          ]
               ]
>
   MATCHCONDITIONS
      <
       I1: ADVPPROPrec1.advpatternefs = [synCLOSEDINFSENT] 
       I2: synCLOSEDINFSENT IN ADVPrec1.advpatternefs
       I3: NOT EXIST(mu1, [I31:rel3/T2] )
           I31: rel3 IN [subjrel, leftdislocrel]
       I4: ALL(mu18, leftdislocrel/..)
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: (SENTENCEVARrec1.index = LEVEL) AND
              (SENTENCEVARrec1 = COPYT_SENTENCEtovar(SENTENCErec1)) 
                                                                           AND
              ( ADVPPROPrec1 = COPYT_ADVPtoPROP(ADVPrec1) EXCEPT FOR 
                  [ aktionsarts, supertiempo, PROsubject ] ) AND
              ( ADVPPROPrec1 =
		  {
		   aktionsarts   : [stative] 
		  } 
              )                                AND

              VERBrec1.status = bareV AND
              VERBrec1.modo = infinitivo AND
              ( SENTENCErec1 = 
                      {
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
                      }

              )                                

              C11: SentAdv IN ADVPrec1.actsubcefs 
              A11: rel1 := SentAdvrel
          A1: VERBPPROPrec2 :=
		     { 
		      supertiempo : SENTENCErec1.supertiempo
		      PROsubject  : false
		      voice       : SENTENCErec1.voice 
		      synvpefs    : SENTENCErec1.synvpefs
		      thetavp     : SENTENCErec1.thetavp
		      aktionsarts : SENTENCErec1.aktionsarts
		     };

               VERBrec2 := VERBrec1;
               VERBrec2.modo := omegamodo; 
         >

      DECOMP
         <
          C1: VERBPPROPrec2.supertiempo <> omegatiempo AND
              VERBrec2.modo = omegamodo AND
              VERBrec2.status = bareV 

              C11: (SentAdv IN ADVPrec1.actsubcefs) AND
                   ( rel1 = sentadvrel )
              A11: @
 
          A1: SENTENCErec1 :=
		     { 
                       req : [pospol,negpol,omegapol]
                       env : [pospol,negpol,omegapol]
                       mood : declarative
                       senttype : subordinateclause
                       PROsubject : false
                       modo : infinitivo
                       finiteness : infinite
                       VRcompl : true
                       Restructuring : false
                       conjkey : 0
                       adverbial : false
                       temporal : false
                       conjclass : omegaTimeAdvClass
                       conjtiempo : omegatiempo
                       conjaspecto : omegaAspecto
                       conjretro : false
		       supertiempo : VERBPPROPrec2.supertiempo
          	       voice       : VERBPPROPrec2.voice
		       synvpefs    : VERBPPROPrec2.synvpefs
		       thetavp     : VERBPPROPrec2.thetavp
		       aktionsarts : VERBPPROPrec2.aktionsarts
		     };
             (* polarity still to be accounted for *)
              VERBrec1 := VERBrec2;
              VERBrec1.modo := infinitivo;
                            
              SENTENCEVARrec1 := COPYT_SENTENCEtovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
              ADVPPROPrec1 := COPYT_ADVPtoPROP(ADVPrec1);
              ADVPPROPrec1 :=
                 {
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                 };
                
         >


&

\end{verbatim}

