\newpage
\begin{verbatim}
% RULE DETPformation4         

< m1: BDEMADJ{BDEMADJrec1}
>

< m : DETP{DETPrec1}[head/DEMADJ{DEMADJrec1}[head/BDEMADJ{BDEMADJrec1}]]
>

      COMP
         <
          C1: true
             C11: true
             A11: DEMADJrec1.numero := singular;
                  DEMADJrec1.genero := masc
             C12: true
             A12: DEMADJrec1.numero := singular;
                  DEMADJrec1.genero := fem
             C13: true
             A13: DEMADJrec1.numero := plural;
                  DEMADJrec1.genero := masc
             C14: true
             A14: DEMADJrec1.numero := plural;
                  DEMADJrec1.genero := fem

          A1: DETPrec1.genero := DEMADJrec1.genero;
              DETPrec1.numero := DEMADJrec1.numero;
              DETPrec1.definite := def;
              DETPrec1.posspred := true;
              DETPrec1.posscomas := [count, mass];
              DETPrec1.mood := declxpmood;
         >

      DECOMP
         <
          C1: (DETPrec1.genero = DEMADJrec1.genero) AND
              (DETPrec1.numero = DEMADJrec1.numero) AND
              (DETPrec1.definite = def) AND
              (DETPrec1.posspred = true) AND
              (DETPrec1.posscomas = [count, mass]) AND
              (DETPrec1.mood = declxpmood)
             C11: DEMADJrec1.numero = singular AND
                  DEMADJrec1.genero = masc
             A11: @
             C12: DEMADJrec1.numero = singular AND
                  DEMADJrec1.genero = fem
             A12: @
             C13: DEMADJrec1.numero = plural AND
                  DEMADJrec1.genero = masc
             A13: @
             C14: DEMADJrec1.numero = plural AND
                  DEMADJrec1.genero = fem
             A14: @

          A1:  @
         >
&


\end{verbatim}
