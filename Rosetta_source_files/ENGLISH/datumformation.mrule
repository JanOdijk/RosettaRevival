\newpage
\begin{verbatim}
% RULE RCARD1
< m1:DIGIT{DIGITrec1}
>

< m :CARD{CARDrec1}
             [head/DIGIT{DIGITrec1}]
>
      COMP
         <
          C1:TRUE
             C11:DIGITrec1.valeu = 1
             A11:CARDrec1.possnumbers := [singular];
             C12:DIGITrec1.valeu <> 1
             A12:CARDrec1.possnumbers := [plural];
          A1:@
         >
      DECOMP
         <
          C1:TRUE
             C11:DIGITrec1.valeu = 1 AND
                 CARDrec1.possnumbers = [singular]
             A11:@
             C12:DIGITrec1.valeu <> 1 AND
                 CARDrec1.possnumbers = [plural]
             A12:@
          A1:@
         >

&

\end{verbatim}
