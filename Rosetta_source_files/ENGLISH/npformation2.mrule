\newpage
\begin{verbatim}

% RULE RNPINDEFmodposs
< m1: NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}]


  m2: NP{NPrec2}[mu1, 
                 head/T1,
                 mu2
                ]
>

< m : NP{NPrec1} [head/INDEFPRO{INDEFPROrec1},
                  posrel/PREPP{PREPPrec1}[head/PREP(KEY_ofprepkey){PREPrec1},
                                           objrel/NP{NPrec3}[mu1,
                                                             head/T2,
                                                             mu2
                                                            ]
                                          ]     
                 ]
>

<
(* 1 *) 
SUBRULE          (*  something of my neighbour (??mjs) *)

<T1: CN{CNrec1}[mu3]>
<T2: CN{CNrec2}[mu3]>

      COMP
         <
          C1:  NPrec2.superdeixis = NPrec1.superdeixis AND
               NPrec2.cases = [] AND
               CNrec1.cases = [] AND
               NPrec2.generic = nogeneric
          A1:  NPrec3:= NPrec2;
               NPrec3.superdeixis := omegadeixis;
               NPrec3.cases := [accusative];
               NPrec3.generic := omegageneric;
               CNrec2 := CNrec1;
               CNrec2.cases := [accusative]
         >

      DECOMP
         <
          C1: NPrec3.superdeixis = omegadeixis AND
              accusative IN NPrec3.cases AND
              accusative IN CNrec2.cases AND
              NPrec3.generic = omegageneric
          A1: NPrec2 := NPrec3;
              NPrec2.superdeixis := NPrec1.superdeixis; 
              NPrec2.cases := [];
              NPrec2.generic := nogeneric;
              CNrec1 := CNrec2;
              CNrec1.cases := []
         >
 
(* 2 *) 
SUBRULE            (* something of General Linguistics *)

<T1: PROPERNOUN{PROPERNOUNrec1}[mu4]>
<T2: PROPERNOUN{PROPERNOUNrec1}[mu4]>

      COMP
         <
          C1:  NPrec2.superdeixis = NPrec1.superdeixis AND
               NPrec2.cases = [] AND
               NPrec2.generic = nogeneric
          A1:  NPrec3:= NPrec2;
               NPrec3.superdeixis := omegadeixis;
               NPrec3.cases := [accusative];
               NPrec3.generic := omegageneric;
         >

      DECOMP
         <
          C1: NPrec3.superdeixis = omegadeixis AND
              accusative IN NPrec3.cases AND
              NPrec3.generic = omegageneric
          A1: NPrec2 := NPrec3;
              NPrec2.superdeixis := NPrec1.superdeixis;
              NPrec2.cases := [];
              NPrec2.generic := nogeneric
         >

(* 3 *) 
SUBRULE            (* something of us (?? mjs) *)

<T1: PERSPRO{PERSPROrec1}[mu5]>
<T2: PERSPRO{PERSPROrec2}[mu5]>

      COMP
         <
          C1:  NPrec2.superdeixis = NPrec1.superdeixis AND
               PERSPROrec1.persprocase = omegacase AND
               NPrec2.cases = [] AND
               NPrec2.generic = nogeneric
          A1:  NPrec3:= NPrec2;
               NPrec3.superdeixis := omegadeixis;
               NPrec3.cases := [accusative];
               NPrec3.generic := omegageneric;
               PERSPROrec2 := PERSPROrec1;
               PERSPROrec2.persprocase := accusative;
         >

      DECOMP
         <
          C1: NPrec3.superdeixis = omegadeixis AND
              PERSPROrec2.persprocase = accusative AND
              accusative IN NPrec3.cases AND
              NPrec3.generic = omegageneric
          A1: NPrec2 := NPrec3;
              NPrec2.superdeixis := NPrec1.superdeixis;
              NPrec2.cases := [];
              NPrec2.generic := nogeneric;
              PERSPROrec1 := PERSPROrec2;
              PERSPROrec1.persprocase := omegacase
         >
>
&

\end{verbatim}
