ENGLISH 93

&
\newpage
\begin{verbatim}
%
% RULE RVPAdv
< SUBST: 
  m1: CLAUSE{CLAUSErec1}                  
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [I2:mu2,
                        I3:sig1
                       ],
                mu3 
              ] 

  m2: I1::OPENADVPPROP{OPENADVPPROPrec1}
                      [ subjrel/I4::CLAUSEVAR{CLAUSEVARrec1},
                        predrel/ADVP{ADVPrec1}[mu4] 
                      ]
>

< m : CLAUSE{CLAUSErec1}                  
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ I2:mu2,
                         vpadvrel/ADVP{ADVPrec1}[mu4],
                         I3:sig1
                       ],
                mu3 
              ] 
>

   MATCHCONDITIONS
      <
       I1: vpadv IN OPENADVPPROPrec1.actsubcefs
       I2: NOT EXIST (mu2, [byobjrel/..])
       I3: ALL (sig1, byobjrel/..)
       I4: CLAUSEVARrec1.index = LEVEL 
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: CLAUSEVARrec1 = COPYT_clauseTOvar(CLAUSErec1) AND
              vpadv IN ADVPrec1.actsubcefs AND
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                 EXCEPT FOR [superdeixis, PROsubject, aktionsarts] AND
              OPENADVPPROPrec1 = { aktionsarts : [stative]
                                   PROsubject  : true } AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis)
          A1: @
         >

      DECOMP
         <
          C1: vpadv IN ADVPrec1.actsubcefs 
          A1: CLAUSEVARrec1 := COPYT_clauseTOvar(CLAUSErec1); 
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advpTOprop(ADVPrec1);
              OPENADVPPROPrec1 := { aktionsarts : [stative]
                                    PROsubject  : true };
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis)
         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* relevant examples:] I was hit hard by my mother, He talked to his son 
slowly (!)
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) RC\_VPAdv
\item[* date of creation:] 16-NOV-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch Rvpadv
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to `insert' a vp modifying adverb, by substituting the clause 
in an open ADVPPROP which has a clauseVAR as its subject
\item[\ \ strategy:] (also: deviations from accepted proposals) No VAR in the 
main clause is used.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
