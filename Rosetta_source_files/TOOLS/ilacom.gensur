PROCEDURAL PART
VAR parametertype,converttype:LOCALFILE;
    str:TSTRING_string;
BEGIN
INIT: BEGIN initlocalfile(parametertype);
            initlocalfile(converttype);
      END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%TYPENAME.str;
                     \parametertype.\LOCAL.
                     "LIILrules_" ""str"" "=BOOLEAN;"\\
                     \converttype.\LOCAL.
                     "PROCEDURE conv" ""str"" "("
                     "valeu:LIILRULES_" ""str"" ";"
                      "VAR str:string;"
                      "VAR len:INTEGER);"\\
                     "BEGIN"\\
                     "STR_BooleanTostr(valeu,str,len);"\\
                     "END;"\\
               END
   *>
*>
FINAL:BEGIN $$BOOLEANDEF.parametertype:=parametertype;
            $$BOOLEANDEF.converttype:=converttype;
      END
END;
&

%SETDEF
BASIS RULE
  SETDEF = TYPENAME/2.EQUIVALENT/1.SETtje/1.OFtje/1.IDENTIFIER/3.SEMICOLON/1
SURFACE PART
VAR typespec::typespec;

<*
 INIT:BEGIN
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN typespec.typename:=%TYPENAME.str;
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN typespec.typekind:=setkind;
                                typespec.basetype:=%.str;
                                TSTRING_constantempty(typespec.basefirst);
                                TSTRING_constantempty(typespec.baselast);
                                appendtypespec(typespec,typestable);
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_SETDEF;
                END
*>
END;

PROCEDURAL PART
VAR parametertype,converttype:LOCALFILE;
    str:TSTRING_string; 
BEGIN
INIT: BEGIN initlocalfile(parametertype);
            initlocalfile(converttype);
      END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%TYPENAME.str;
                     \parametertype.\LOCAL.
                     "LIILrules_" ""str"" " = SET OF LIILRULES_"
               END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN str:=%.str;
                     \parametertype.\LOCAL.
                     ""str"" ";"\\
               END
   *>
*>
FINAL:BEGIN $$SETDEF.parametertype:=parametertype;
            $$SETDEF.converttype:=converttype;
      END
END;
