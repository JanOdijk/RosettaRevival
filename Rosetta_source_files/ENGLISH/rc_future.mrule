      <mu5: [I6:mu6, I5: tempadvrel/SENTENCE{SENTENCErec1}[mu11], I7:mu7]>
      <mu5: [I6:mu6, I5: tempadvrel/SENTENCE{SENTENCErec1}[mu11], I7:mu7]>

   MATCHCONDITIONS
      <
       I5: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            ((SENTENCErec1.conjdeixis = futuredeixis) OR
             (SENTENCErec1.conjdeixis = omegadeixis)
            )
           )
       I6: QUOTE_temprefnotfound(mu6)
