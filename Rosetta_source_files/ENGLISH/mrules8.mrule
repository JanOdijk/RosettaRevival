\newpage
\begin{verbatim}
%
% TRANSFORMATION TSnegAdapt
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              meltnegrel/NEG(KEY_notNEGkey){NEGrec1},
              I1:rel1/T1,
              mu2 
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I2:rel1/T2,
              mu2 
            ]
>

   MATCHCONDITIONS
      <
       I1: QUOTE_PossNietXp(T1)
       I2: T2.CAT IN [NP,ADVP] AND
           NOT QUOTE_PossNietXp(T2)
      >

<
   SUBRULE (* 1. somebody *)
      < T1: NP{NPrec1}
              [head/INDEFPRO(KEY_somebodyINDEFPROkey){INDEFPROrec1}] 
      >
      < T2: NP{NPrec2}
              [head/INDEFPRO(KEY_nobodyINDEFPROkey){INDEFPROrec2}] 
      >

      COMP
         <
          C1: INDEFPROrec1.possnietnp = true AND
              NPrec1 = { definite   : INDEFPROrec1.definite
                         number     : INDEFPROrec1.number
                         poss       : INDEFPROrec1.poss
                         possnietNP : INDEFPROrec1.possnietNP
                         syntquant  : INDEFPROrec1.syntquant
                         animate    : INDEFPROrec1.animate
                         NPhead     : INDEFPROrec1.NPhead }

          A1: NPrec2 := NPrec1;
              NPrec2 := { definite   : INDEFPROrec2.definite
                          number     : INDEFPROrec2.number
                          poss       : INDEFPROrec2.poss
                          possnietNP : INDEFPROrec2.possnietNP
                          syntquant  : INDEFPROrec2.syntquant
                          animate    : INDEFPROrec2.animate
                          NPhead     : INDEFPROrec2.NPhead }
         >
      DECOMP
         <
          C1: INDEFPROrec2.possnietNP = false AND
              NPrec2 = { definite   : INDEFPROrec2.definite
                         number     : INDEFPROrec2.number
                         poss       : INDEFPROrec2.poss
                         possnietNP : INDEFPROrec2.possnietNP
                         syntquant  : INDEFPROrec2.syntquant
                         animate    : INDEFPROrec2.animate
                         NPhead     : INDEFPROrec2.NPhead }

          A1: NPrec1 := NPrec2;
              NPrec1 := { definite   : INDEFPROrec1.definite
                          number     : INDEFPROrec1.number
                          poss       : INDEFPROrec1.poss
                          possnietNP : INDEFPROrec1.possnietNP
                          syntquant  : INDEFPROrec1.syntquant
                          animate    : INDEFPROrec1.animate
                          NPhead     : INDEFPROrec1.NPhead }
         >

   SUBRULE (* 2. someone *)
      < T1: NP{NPrec1}
              [head/INDEFPRO(KEY_someoneINDEFPROkey){INDEFPROrec1}] 
      >
      < T2: NP{NPrec2}
              [head/INDEFPRO(KEY_nooneINDEFPROkey){INDEFPROrec2}] 
      >

      COMP
         <
          C1: INDEFPROrec1.possnietnp = true AND
              NPrec1 = { definite   : INDEFPROrec1.definite
                         number     : INDEFPROrec1.number
                         poss       : INDEFPROrec1.poss
                         possnietNP : INDEFPROrec1.possnietNP
                         syntquant  : INDEFPROrec1.syntquant
                         animate    : INDEFPROrec1.animate
                         NPhead     : INDEFPROrec1.NPhead }
          A1: NPrec2 := NPrec1;
              NPrec2 := { definite   : INDEFPROrec2.definite
                          number     : INDEFPROrec2.number
                          poss       : INDEFPROrec2.poss
                          possnietNP : INDEFPROrec2.possnietNP
                          syntquant  : INDEFPROrec2.syntquant
                          animate    : INDEFPROrec2.animate
                          NPhead     : INDEFPROrec2.NPhead }
         >
      DECOMP 
         <
          C1: INDEFPROrec2.possnietNP = false AND
              NPrec2 = { definite   : INDEFPROrec2.definite
                         number     : INDEFPROrec2.number
                         poss       : INDEFPROrec2.poss
                         possnietNP : INDEFPROrec2.possnietNP
                         syntquant  : INDEFPROrec2.syntquant
                         animate    : INDEFPROrec2.animate
                         NPhead     : INDEFPROrec2.NPhead }
          A1: NPrec1 := NPrec2;
              NPrec1 := { definite   : INDEFPROrec1.definite
                          number     : INDEFPROrec1.number
                          poss       : INDEFPROrec1.poss
                          possnietNP : INDEFPROrec1.possnietNP
                          syntquant  : INDEFPROrec1.syntquant
                          animate    : INDEFPROrec1.animate
                          NPhead     : INDEFPROrec1.NPhead }
         >

   SUBRULE (* 3. something *)
      < T1: NP{NPrec1}
              [head/INDEFPRO(KEY_somethingINDEFPROkey){INDEFPROrec1}] 
      >
      < T2: NP{NPrec2}
              [head/INDEFPRO(KEY_nothingINDEFPROkey){INDEFPROrec2}] 
      >

      COMP
         <
          C1: INDEFPROrec1.possnietnp = true AND
              NPrec1 = { definite   : INDEFPROrec1.definite
                         number     : INDEFPROrec1.number
                         poss       : INDEFPROrec1.poss
                         possnietNP : INDEFPROrec1.possnietNP
                         syntquant  : INDEFPROrec1.syntquant
                         animate    : INDEFPROrec1.animate
                         NPhead     : INDEFPROrec1.NPhead }
          A1: NPrec2 := NPrec1;
              NPrec2 := { definite   : INDEFPROrec2.definite
                          number     : INDEFPROrec2.number
                          poss       : INDEFPROrec2.poss
                          possnietNP : INDEFPROrec2.possnietNP
                          syntquant  : INDEFPROrec2.syntquant
                          animate    : INDEFPROrec2.animate
                          NPhead     : INDEFPROrec2.NPhead }
         >
      DECOMP
         <
          C1: INDEFPROrec2.possnietNP = false AND
              NPrec2 = { definite   : INDEFPROrec2.definite
                         number     : INDEFPROrec2.number
                         poss       : INDEFPROrec2.poss
                         possnietNP : INDEFPROrec2.possnietNP
                         syntquant  : INDEFPROrec2.syntquant
                         animate    : INDEFPROrec2.animate
                         NPhead     : INDEFPROrec2.NPhead }
          A1: NPrec1 := NPrec2;
              NPrec1 := { definite   : INDEFPROrec1.definite
                          number     : INDEFPROrec1.number
                          poss       : INDEFPROrec1.poss
                          possnietNP : INDEFPROrec1.possnietNP
                          syntquant  : INDEFPROrec1.syntquant
                          animate    : INDEFPROrec1.animate
                          NPhead     : INDEFPROrec1.NPhead }
         >

   SUBRULE (* 4. somewhere *)
      < T1: ADVP{ADVPrec1}
                [head/ADV{ADVrec1}
                     [head/SUBADV{SUBADVrec1}
                          [head/BADV(KEY_somewhereBADVkey){BADVrec1}]
                     ]
                ] 
      >
      < T2: ADVP{ADVPrec2}
                [head/ADV{ADVrec2}
                     [head/SUBADV{SUBADVrec2}
                          [head/BADV(KEY_nowhereBADVkey){BADVrec2}]
                     ]
                ] 
     >

      COMP
         <
          C1: BADVrec1.possnietnp = true AND
              SUBADVrec1 = COPYT_badvTOsubadv(BADVrec1) AND
              SUBADVrec1.affix = noaffix AND
              ADVrec1 = COPYT_subadvTOadv(SUBADVrec1) AND
              ADVrec1.compform = basic AND
              ADVPrec1 = COPYT_advTOadvp(ADVrec1)
                           EXCEPT FOR [superdeixis, actsubcefs,
                                       advpatternefs, thanascompl]
          A1: SUBADVrec2 := COPYT_badvTOsubadv(BADVrec2);
              SUBADVrec2.affix := noaffix;
              ADVrec2 := COPYT_subadvTOadv(SUBADVrec2);
              ADVrec2.compform := basic;
              ADVPrec2 := COPYT_advTOadvp(ADVrec2);
              ADVPrec2 := { superdeixis   : ADVPrec1.superdeixis
                            actsubcefs    : ADVPrec1.actsubcefs
                            advpatternefs : ADVPrec1.advpatternefs
                            thanascompl   : ADVPrec1.thanascompl }
         >
      DECOMP
         <
          C1: BADVrec2.possnietnp = false AND
              SUBADVrec2 = COPYT_badvTOsubadv(BADVrec2) AND
              SUBADVrec2.affix = noaffix AND
              ADVrec2 = COPYT_subadvTOadv(SUBADVrec2) AND
              ADVrec2.compform = basic AND
              ADVPrec2 = COPYT_advTOadvp(ADVrec2)
                           EXCEPT FOR [superdeixis, actsubcefs,
                                       advpatternefs, thanascompl]
          A1: SUBADVrec1 := COPYT_badvTOsubadv(BADVrec1);
              SUBADVrec1.affix := noaffix;
              ADVrec1 := COPYT_subadvTOadv(SUBADVrec1);
              ADVrec1.compform := basic;
              ADVPrec1 := COPYT_advTOadvp(ADVrec1);
              ADVPrec1 := { superdeixis   : ADVPrec2.superdeixis
                            actsubcefs    : ADVPrec2.actsubcefs
                            advpatternefs : ADVPrec2.advpatternefs
                            thanascompl   : ADVPrec2.thanascompl }
         >

   SUBRULE (* 5. ever *)
      < T1: ADVP{ADVPrec1}
                [head/ADV{ADVrec1}
                     [head/SUBADV{SUBADVrec1}
                          [head/BADV(KEY_everBADVkey){BADVrec1}]
                     ] 
                ] 
      >
      < T2: ADVP{ADVPrec2}
                [head/ADV{ADVrec2}
                     [head/SUBADV{SUBADVrec2}
                          [head/BADV(KEY_neverBADVkey){BADVrec2}]
                     ] 
                ] 
      >

      COMP
         <
          C1: BADVrec1.possnietnp = true AND
              SUBADVrec1 = COPYT_badvTOsubadv(BADVrec1) AND
              SUBADVrec1.affix = noaffix AND
              ADVrec1 = COPYT_subadvTOadv(SUBADVrec1) AND
              ADVrec1.compform = basic AND
              ADVPrec1 = COPYT_advTOadvp(ADVrec1)
                           EXCEPT FOR [superdeixis, actsubcefs,
                                       advpatternefs, thanascompl]
          A1: SUBADVrec2 := COPYT_badvTOsubadv(BADVrec2);
              SUBADVrec2.affix := noaffix;
              ADVrec2 := COPYT_subadvTOadv(SUBADVrec2);
              ADVrec2.compform := basic;
              ADVPrec2 := COPYT_advTOadvp(ADVrec2);
              ADVPrec2 := { superdeixis   : ADVPrec1.superdeixis
                            actsubcefs    : ADVPrec1.actsubcefs
                            advpatternefs : ADVPrec1.advpatternefs
                            thanascompl   : ADVPrec1.thanascompl }
         >
      DECOMP
         <
          C1: BADVrec2.possnietnp = false AND
              SUBADVrec2 = COPYT_badvTOsubadv(BADVrec2) AND
              SUBADVrec2.affix = noaffix AND
              ADVrec2 = COPYT_subadvTOadv(SUBADVrec2) AND
              ADVrec2.compform = basic AND
              ADVPrec2 = COPYT_advTOadvp(ADVrec2)
                           EXCEPT FOR [superdeixis, actsubcefs,
                                       advpatternefs, thanascompl]
          A1: SUBADVrec1 := COPYT_badvTOsubadv(BADVrec1);
              SUBADVrec1.affix := noaffix;
              ADVrec1 := COPYT_subadvTOadv(SUBADVrec1);
              ADVrec1.compform := basic;
              ADVPrec1 := COPYT_advTOadvp(ADVrec1);
              ADVPrec1 := { superdeixis   : ADVPrec2.superdeixis
                            actsubcefs    : ADVPrec2.actsubcefs
                            advpatternefs : ADVPrec2.advpatternefs
                            thanascompl   : ADVPrec2.thanascompl }
         >
>

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TSNegAdapt
\item[* relevant examples:] \mbox{}\\
1. not somebody saw me $\rightarrow$ nobody saw me \\
2. not someone saw me $\rightarrow$ noone saw me\\
3. not something was too much for him $\rightarrow$ nothing was too much for 
him\\
4. I could get flowers not somewhere $\rightarrow$ I could get flowers nowhere 
\\
5. Not ever had I seen such a mess $\rightarrow$ Never had I seen such a mess
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] ClauseToSentence
\item[* class:] (name of rule, transformation or filter class) TC\_
NegAdaptation
\item[* date of creation:] 22-SEP-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch TNegAdapt1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 06/03/89\ \ \ \ \ author: margreet sanders.\\
The attributes {\em req\/} and {\em env\/} should not be copied to the higher 
record, since they are dealt with by a special polarity function in RUtt...
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to let {\em not\/} melt with an immediately following word allowing 
this
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One subrule for 
every word
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

