\newpage
\begin{verbatim}
% TRANSFORMATION TOblSubjControlExtrapSent  (* extraposrel/SENT,
                                             subject antecedent *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             I6:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/I1::VERB{VERBrec1}[mu4],
                      mu5
                    ],
             mu6,
             extraposrel/I4::SENTENCE{SENTENCErec1}
                        [ I2:sig1,
                          I5:sig2,
                          subjrel/T2,
                          I3:mu7 
                        ]
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             I6:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/I1::VERB{VERBrec1}[mu4],
                      mu5
                    ],
             mu6,
             extraposrel/I4::SENTENCE{SENTENCErec1}
                        [ I2:sig1,
                          I5:sig2,
                          I3:mu7 
                        ]
           ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.controller = subject OR 
           synBE IN VERBrec1.synvps
       I2: ALL (sig1, shiftrel/..)
       I3: NOT EXIST (mu7, [shiftrel/..]) AND 
           NOT EXIST (mu7, [conjrel/..]) 
       I4: SENTENCErec1.PROsubject = true
       I5: ALL (sig2, conjrel/..)
       I6: NOT EXIST (mu2, [I61:auxrel/VERB{VERBrec2}[mu9]])
         I61: VERBrec2.subc = modalverb
       m1: synBE IN VERBrec1.synvps ->
           ( synBE IN CLAUSErec1.synvpefs AND
             EXIST (mu5, [I11:predrel/N1[mu8]]) )
       m : synBE IN VERBrec1.synvps ->
           ( synBE IN CLAUSErec1.synvpefs AND
             EXIST (mu5, [I11:predrel/N1[mu8]]) )
       I11: N1.CAT IN [ADJP, PREPP, NP, ADVP]
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 
              (* including cases, which should be [] *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which should be [] *)
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 
              (* including cases, which should be [] *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which should be [] *)
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TOblSubjControlExtrapSent
\item[* relevant examples:] (in analysis only)\\
\begin{enumerate}
\item OPENTOSENT:\\
(vp123): x1 promised x2 yesterday [ x1 to read the book before next Christmas ] 
$\rightarrow$ x1 promised x2 [ to read the book ... ] (x2 = indobj)\\
(vp120): x1 decide yesterday [ x1 to go the States next year] $\rightarrow$
x1 decided yesterday [ to go to the States next year]\\
(adjp): x1 was able yesterday [x1 to read this book] $\rightarrow$ x1 was able 
yesterday [to read this book]
\item QSENT:\\
(vp120): x1 asked x1 yesterday [where x1 to go] $\rightarrow$ x1 asked x1 
yesterday [where to go] (Or is this a case of NOC?)\\
(vp120): x1 hesitated yesterday [whether x1 to go there] $\rightarrow$ x1 
hesitated yesterday [whether to go there]
\end{enumerate}
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_Controlrules
\item[* date of creation:]  4-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:]  Dutch TNOC2
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 30/03/89\ \ \ \ \ author: margreet sanders\\
Adapted for sentences extraposed from a predrel/XP
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To interpret the subject of extraposed complement sentences as
identical to the subject of the CLAUSE, and to delete it. The subject may only 
be a VAR, not some kind of EMPTY. Note that the extraposition rules have 
allowed extraposition of infinite (open) sentences only in analysis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One for NPVAR, one 
for CNVAR.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
