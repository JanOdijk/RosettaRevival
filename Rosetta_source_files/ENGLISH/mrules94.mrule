\begin{verbatim}
% TRANSFORMATION TSubjControlFinalConjSent
< m1: CLAUSE{CLAUSErec1}
            [ mu1, 
              I1:subjrel/T1,
              mu2,
              I2:rel1/I5::SENTENCE{SENTENCErec1}
                     [ conjrel/T3,
                       subjrel/T2,
                       I4:mu4 
                     ],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              I1:subjrel/T1,
              mu2,
              I2:rel1/I5::SENTENCE{SENTENCErec1}
                     [ conjrel/T3,
                       I4:mu4 
                     ],
              mu5
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: rel1 IN [postsentadvrel, tempadvrel]
       I4: ALL (mu4, I41:rel4/..) 
         I41: QUOTE_Srelprec(subjrel, rel4) AND rel4 <> subjrel
       I5: SENTENCErec1.adverbial = true AND
           SENTENCErec1.finiteness = infinite
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} 
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = []
              (* no cases for subject of infinitives *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [];
              (* no cases for subject of infinitives *)
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1} 
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = []
              (* no cases for subject of infinitives *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [];
              (* no cases for subject of infinitives *)
         >
>

&

\end{verbatim}
