 *  Copyright (c) 1986, by Nederlandse Philips Bedrijven BV.
 *
 *  Remarks         : To be used for error or warning messages meant
 *                    for users of the ROSETTA system. Each error message
 *                    has a unique key, specified by a constant of the
 *                    enumeration type ERROR_Msg.
 *
 *EMP:::===================================================================*)



(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE ERROR;


(*MPT:::===================================================================*
 *
 *  Type name      : ERROR_Msg
 *  Description    : Defines constants for errors that can occur in the
 *                   Rosetta system
 *
 *EMP:::===================================================================*)

TYPE
   ERROR_Msg = ( ERROR_ASegm,      { No correct segmentation found }
                 ERROR_ALextree,    { Incorrect segmentation        }
                 ERROR_InCorrectRuleName,
                 ERROR_UnknownStreeSpec,
                 ERROR_CorrectNode,
                 ERROR_InCorrectNode,
                 ERROR_NoTreesFound,
                 ERROR_NoLastRule,
                 ERROR_NoNodeSelected,
                 ERROR_NoAttrSelected,
                 ERROR_NoExtraInfo,
                 ERROR_NoAttributes,
                 ERROR_MaxNrScreens
               );


(*MPT:::===================================================================*
 *
 *  Type name      : QUESTION_Msg
 *  Description    : Defines constants for questions that can occur in the
 *                   Rosetta system
 *
 *EMP:::===================================================================*)

TYPE
   QUESTION_Msg = ( QUESTION_Exit,
                    QUESTION_ZeroMeanings
                  );

(*MPF:::===================================================================*
 *
 *  Procedure Name  : ERROR_Write
 *  Description     : Creates a window on the lower part of the screen
 *                    ( line 24-25 ) and puts the error message on the screen.
 *                    The function returns control to the calling program as
 *                    soon as the user has typed a CR.
 *  Parameters      : msg: ERROR_Msg; unique identification of the error message
 *  Precondition    : WINDOWS_Init has been called.
 *  Postcondition   : TRUE
 *  Side Effects    : The corresponding error message has been put on the
 *                    screen.
 *
 *EMP:::===================================================================*)

PROCEDURE ERROR_Write(msg: ERROR_Msg);
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name   : ERROR_QuestionWrite
 *  Description     : Creates a window and puts the question on the screen.
 *  Parameters      : msg: QUESTION_Msg; unique identification of the question
 *  Result          : returns true if the question was responded to positively
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : The corresponding error message has been put on the
 *                    screen.
 *
 *EMP:::===================================================================*)

FUNCTION ERROR_QuestionWrite(msg: QUESTION_Msg): Boolean;
EXTERNAL;

END {ERROR};
