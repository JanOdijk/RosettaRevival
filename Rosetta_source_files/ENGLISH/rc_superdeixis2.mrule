\begin{verbatim}
%
% RULE Rinfinpresentsuperdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
             mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
             mu5
           ] 

>
   MATCHCONDITIONS
      <
      >

<
   SUBRULE (* 1: no adverbials *)
      <mu5: [I1: mu6]>
      <mu5: [I1: mu6]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec1.finiteness = infinite)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis) 
             A12: CLAUSErec2 := CLAUSErec1;

          A1: @
         >
      DECOMP
         <
          C1:((VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec2.finiteness = infinite) AND
              (CLAUSErec2.deixis = omegadeixis)
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = presentdeixis)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: @
         >


   SUBRULE (* 2: ADVPVAR *)
      <mu5: [I1: mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            (ADVPVARrec1.deixis IN [omegadeixis, futuredeixis])
           )
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec1.finiteness = infinite)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: @
         >
      DECOMP
         <
          C1:((VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec2.finiteness = infinite) AND
              (CLAUSErec2.deixis = omegadeixis)
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = presentdeixis)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: @
         >


   SUBRULE (* 3: PREPPVAR *)
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            (PREPPVARrec1.deixis IN [omegadeixis, futuredeixis])
           )
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec1.finiteness = infinite)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis) 
             A12: CLAUSErec2 := CLAUSErec1;

          A1: @
         >
      DECOMP
         <
          C1:((VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec2.finiteness = infinite) AND
              (CLAUSErec2.deixis = omegadeixis)
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = presentdeixis)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: @
         >


   SUBRULE (* 4: SENTENCE *)
      <mu5: [I1:mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3:mu7]>
      <mu5: [I1:mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3:mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            (SENTENCErec1.conjdeixis IN [omegadeixis, futuredeixis]) AND
            (SENTENCErec1.temporal = true)
           )
       I3: QUOTE_temprefnotfound(mu7)

      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec1.finiteness = infinite)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;
             
             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = presentdeixis) 
             A12: CLAUSErec2 := CLAUSErec1;

          A1: @
         >
      DECOMP
         <
          C1:((VERBrec1.tense = omegatense) AND
              (VERBrec1.conjclasses * [12, 13, 14] = []) AND
              (CLAUSErec2.finiteness = infinite) AND
              (CLAUSErec2.deixis = omegadeixis)
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

             (* modal + dependent clause *)
              C12: (CLAUSErec2.superdeixis = presentdeixis)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: @
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rinfinpresentsuperdeixis
\item[* relevant examples:] he likes to work,
he likes to be working,
*he likes to can ...,
he likes to be ill,
* he likes to use to....
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 28-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentsuperdeixis 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 19/05/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on futuredeixis adverbial 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT.
               This rule is for a infinite dependent clause.
               The deixis 
value of the possible reference adverbial is checked for 
               omega or future.
               The clause is marked for present superdeixis.
\item[\ \ strategy:] The match is left to right. The rule is not applicable to 
modal verbs (conjclasses 12, 13, 14; no infinite forms).
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be presentdeixis in the case 
this sentence is a sentence with adverbs such as {\em graag} in Dutch. 
In English this may be 
the case in cases in which e.g. a verb is a semantic head but behaves as an  
auxiliary verb (e.g. some modal verbs)\\

\end{enumerate}
\end{description}

