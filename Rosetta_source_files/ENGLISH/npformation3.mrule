\begin{verbatim}
% RULE RNPformation13   
< m1: I1::DEMPRO{DEMPROrec1}
>

< m : NP{NPrec1}[head/I1::DEMPRO{DEMPROrec1}
 
                ]
>
   MATCHCONDITIONS
      <I1: DEMPROrec1.key = KEY_thisDEMPROkey OR 
                      DEMPROrec1.key = KEY_thatDEMPROkey
      >


      COMP
         <
          C1: true 
             C11: DEMPROrec1.key = KEY_thatDEMPROkey
             A11: NPrec1.NPhead    := thatNP;
             C12: DEMPROrec1.key = KEY_thisDEMPROkey
             A12: NPrec1.NPhead    := thisNP;

          A1: NPrec1 := { number    : DEMPROrec1.number
                          sexes     : []
                          definite  : def
                          genders   : [omegagender]
                          actcomas  : []
                          posspred  : false
                          generic   : nogeneric
                          superdeixis : omegadeixis
                          poss      : false
                          specQ     : yesspec  }
         >

      DECOMP
         <
          C1: NPrec1 = { number    : DEMPROrec1.number 
                         sexes     : [] 
                         definite  : def 
                         genders   : [omegagender] 
                         actcomas  : [] 
                         posspred  : false 
                         generic   : nogeneric 
                         superdeixis : omegadeixis 
                         poss      : false  
                         specQ     : yesspec  }
            C11: NPrec1.NPhead = thatNP AND 
                 DEMPROrec1.key = KEY_thatDEMPROkey
            A11: @
            C12: NPrec1.NPhead = thisNP AND 
                 DEMPROrec1.key = KEY_thisDEMPROkey
            A12: @
          A1: @
         >
&


\end{verbatim}
