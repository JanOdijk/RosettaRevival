% FILTER Fcannegincorp
< m : SENTENCE{SENTENCErec1}
              [ mu1,
                I1:auxrel/VERB{VERBrec1}[mu2],
                negrel/NEG(KEY_notNEGkey){NEGrec1},
                mu3
              ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.subc IN [modalverb] AND 
           EXIST (mu2, [head/SUBVERB{SUBVERBrec1}
                            [I11:head/BVERB(KEY1){BVERBrec1}] ])
         I11: KEY1 = KEY_can1BVERBkey OR
              KEY1 = KEY_can2BVERBkey
      >

         <
          C1: VERBrec1.tense = presenttense
          A1: @
         >

&
