\newpage
\begin{verbatim}
% TRANSFORMATION TComplWhShift
< m1: CLAUSE{CLAUSErec1}[mu8]
>

< m : CLAUSE{CLAUSErec1}[mu9]
>

<
   SUBRULE (* 1. shift from shiftrel *)
      < mu8: [ I1:mu2,
               predrel/VERBP{VERBPrec1}
                      [ mu1,
                        complrel/I2::SENTENCE{SENTENCErec1}
                                [ I3:shiftrel/T1,
                                  I4:mu7
                                ],
                        mu4
                      ],
               mu5
             ]
      >

      < mu9: [ I3:shiftrel/T1,
               I1:mu2,
               predrel/VERBP{VERBPrec1}
                      [ mu1,
                        complrel/I2::SENTENCE{SENTENCErec1}
                                [ I4:mu7 ],
                        mu4
                      ],
               mu5
             ]
      >

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11:rel1/..])
       I2: SENTENCErec1.mood = declarative
       I3: (T1.CAT IN [PREPP, VARPREPP, PREPPVAR, ADJP, ADVP, 
                       ADVPVAR, NPVAR]
              WITH T1.REC.mood IN [wh, relativexpmood, topicmood]) OR
           (T1.CAT IN [CNVAR])
       I4: NOT EXIST (mu7, [I11:rel1/..])
         I11: rel1 IN [shiftrel, leftdislocrel]
      >

         COMP
            <
             C1: true
             A1: @
            >
         DECOMP
            <
             C1: true
             A1: @
            >

   SUBRULE (* 2. shift from subjrel *)
      < mu8: [ I1:mu2,
               predrel/VERBP{VERBPrec1}
                      [ mu1,
                        complrel/I2::SENTENCE{SENTENCErec1}
                                [ I3:subjrel/T1,
                                  I4:mu7
                                ],
                        mu4
                      ],
               mu5
             ]
      >

      < mu9: [ I3:shiftrel/T1,
               I1:mu2,
               predrel/VERBP{VERBPrec1}
                      [ mu1,
                        complrel/I2::SENTENCE{SENTENCErec1}
                                [ I4:mu7 ],
                        mu4
                      ],
               mu5
             ]
      >

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11:rel1/..])
       I2: SENTENCErec1.mood = declarative AND
           SENTENCErec1.finiteness = infinite AND
           SENTENCErec1.PROsubject = false
       I3: ( T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh,relativexpmood])
           OR ( T1.CAT IN [CNVAR] )
       I4: NOT EXIST (mu7, [I11:rel1/..])
         I11: rel1 IN [shiftrel, leftdislocrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_ClosedInfComplVps <> [] AND
              CLAUSErec1.thetavp = vp120
          A1: @
         >
      DECOMP
         <
          C1: CLAUSErec1.synvpefs * AUX_ClosedInfComplVps <> [] AND
              CLAUSErec1.thetavp = vp120
          A1: @
         >
>
&

\end{verbatim}
