%RULE RIDALTNPFORMATION1

<m1: T1
>

< m: T2
>
PARAMETERS
<vpid:synpatternSETtype
>
<
   SUBRULE  (* 1 *)
      <T1: T3
      >
      <T2: IDFORMATION/RIDNPFORMATION2[BLEX/T3]
      >

COMP
 <
   C1: vpid21 IN vpid
   A1: @
 >
DECOMP
 <
   C1: TRUE
   A1: vpid := [vpid21]
 >

   SUBRULE  (* 2 *)
      <T1: T3
      >
      <T2: NPFORMATION/RNPFORMATION4[BLEX/T3]
      >

COMP
 <
   C1: vpid1 IN vpid
   A1: @
 >
DECOMP
 <
   C1: TRUE
   A1: vpid := [vpid1]
 >

   SUBRULE  (* 3 *)
      <T1: T3
      >
      <T2: NPFORMATION/RNPFORMATION4A[BLEX/T3]
      >

COMP
 <
   C1: vpid33 IN vpid
   A1: @
 >
DECOMP
 <
   C1: TRUE
   A1: vpid := [vpid33]
 >

   SUBRULE  (* 4 *)
      <T1: T3
      >
