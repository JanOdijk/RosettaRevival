                    headkey    : PREPrec2.key
                    class      : PREPrec2.class
                    tiempo     : PREPrec2.tiempo
                    aspecto    : PREPrec2.aspecto
                    retro      : PREPrec2.retro
                    SpecQ      : yesspec
                  }
                         (* mood default *)
         >

   SUBRULE (*2a*)
      <T1:EMPTYVAR{EMPTYVARrec1}
       T2:NPVAR{NPVARrec2}>

      <T1:EMPTYVAR{EMPTYVARrec1}
       T2:NPVAR{NPVARrec2}>

      COMP
         <
          C1: synPREPEMPTY_PREPNP IN VERBrec1.synvps AND
