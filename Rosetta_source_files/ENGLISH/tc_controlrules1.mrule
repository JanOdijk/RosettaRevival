% TRANSFORMATION TOblObjControlPrepNP  (* prepobj OPENNPPROP, 
                                          object control  *)
< m1:CLAUSE{CLAUSErec1}      
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I1:objrel/T1,
                      mu3,
                      prepobjrel/PREPP{PREPPrec1}
                                [ head/PREP{PREPrec1},
                                  objrel/OPENNPPROP{OPENNPPROPrec1}
                                        [ I2:subjrel/T2,
                                          predrel/NP{NPrec1}[mu5]
                                        ]
                                ],
                      mu7
                    ],
             mu8 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I1:objrel/T1,
                      mu3,
                      prepobjrel/PREPP{PREPPrec1}
                                [ head/PREP{PREPrec1},
                                  objrel/NP{NPrec1}[mu5]
                                ],
                      mu7
                    ],
             mu8 
           ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: NOT EXIST (mu1, [I31:auxrel/VERB{VERBrec1}[mu11]])
         I31: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec2 = NPVARrec1 AND 
              (* including cases, which should be nominative *)
              CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              AND
              OPENNPPROPrec1 = { superdeixis    : omegadeixis
                                 aktionsarts    : [stative] 
                                 PROsubject     : true 
                                 thetanp        : NPrec1.thetanp
                                 nounpatternefs : NPrec1.nounpatternefs }
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_openxppvps <> []
          A1: OPENNPPROPrec1 := { thetanp        : NPrec1.thetanp
                                  nounpatternefs : NPrec1.nounpatternefs 
                                  PROsubject     : true 
                                  aktionsarts    : [stative] }
              (* superdeixis retains default value *);
              NPVARrec2 := NPVARrec1;
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                CLAUSErec2.synvpefs * AUX_openxppvps
         >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec2 = CNVARrec1 AND 
              (* including cases, which should be nominative *)
              CLAUSErec1.synvpefs * AUX_openxppvps <> [] AND
              OPENNPPROPrec1 = { superdeixis    : omegadeixis
                                 aktionsarts    : [stative] 
                                 PROsubject     : true 
                                 thetanp        : NPrec1.thetanp
                                 nounpatternefs : NPrec1.nounpatternefs }
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_openxppvps <> []
          A1: OPENNPPROPrec1 := { thetanp        : NPrec1.thetanp
                                  nounpatternefs : NPrec1.nounpatternefs 
                                  PROsubject     : true 
                                  aktionsarts    : [stative] }
              (* superdeixis retains default value *);
              CNVARrec2 := CNVARrec1;
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                CLAUSErec2.synvpefs * AUX_openxppvps
         >
>
&

\end{verbatim}
