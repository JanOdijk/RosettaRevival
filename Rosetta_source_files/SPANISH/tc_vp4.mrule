   (* Hablo con Pedro sobre el tiempo (vp123) *)
<
   SUBRULE (*a*)
      <T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}>

      <T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}>

      COMP
         <
          C1: synPREPNP_PREPNP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_PREPNP];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.SpecQ
                  };

              VARPREPPrec2 := PREPPrecdef;
              VARPREPPrec2 :=
                  { mood       : NPVARrec2.mood
                    actsubcefs : PREPrec2.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : PREPrec2.key
                    class      : PREPrec2.class
                    tiempo     : PREPrec2.tiempo
                    aspecto    : PREPrec2.aspecto
                    retro      : PREPrec2.retro
                    SpecQ      : NPVARrec2.SpecQ
                  }
         >

