%RULE RSTARTVPPROP132

<m1: I1::SUBVERB{SUBVERBrec1}[ mu1]
 m2: T1
 m3: T2
 m4: T3
>
<m: I5::VERBPPROP{VERBPPROPrec1}
                 [ I2:subjrel/T1, 
                   predrel/VERBP{VERBPrec1}
                          [head/I6::VERB{VERBrec1}
                                [head/I1::SUBVERB{SUBVERBrec1}[ mu1]],
                           I4:argrel/T3,
                           I3:argrel/T2
                          ]
                 ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBrec1.thetavp = vp132 
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
       I3: T2.CAT IN AUX_VARCATSET 
       m3: T2.CAT IN AUX_VARCATSET 
       I4: T3.CAT IN AUX_VARCATSET 
       m4: T3.CAT IN AUX_VARCATSET 
       I5: VERBPPROPrec1 =
		  { 
                   thetavp     : vp132
		   req         : [pospol, negpol, omegapol]
		   env         : [pospol, negpol, omegapol]
		   supertiempo : omegatiempo
		   PROsubject  : false
		   voice       : omegavoice
		   synvpefs    : []
		   aktionsarts : []
		  }
       I6: VERBrec1 =
		  {
		   numero       : omeganumero  
		   persona      : 3
                   genero       : omegagenero
		   modo         : omegamodo
		   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
		   status       : bareV
                   foundauxes   : []
		  }
      >


COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
       (* the other attributes retain their default values *)
       VERBPPROPrec1.thetavp := vp132
       (* the other attributes retain their default values *)
 >
&


\end{verbatim}
