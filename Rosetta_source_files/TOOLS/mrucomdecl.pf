pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('mrucomlangspec.pf');

PACKAGE mrucomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     mrucomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   mrucomDECL_Surfrulemode = (loccond, globcond);
   mrucomDECL_psyntcat     = ^mrucomLANGSPEC_Category;
   mrucomDECL_syntcatset   = SET OF mrucomLANGSPEC_Category;
   mrucomDECL_nodeid         = HINIT..HFINAL;
   mrucomDECL_plonodeid      = ^mrucomDECL_lonodeid;
   mrucomDECL_lonodeid       = RECORD
   			          next: mrucomDECL_plonodeid;
   			          arg : mrucomDECL_nodeid
   	 	               END;
   mrucomDECL_pSnode       = ^mrucomDECL_Snode;
   mrucomDECL_pRsnode      = ^mrucomDECL_Rsnode;
   mrucomDECL_Rsnode       = RECORD
                                sonnumber:mrucomDECL_nodeid;
                                node    : mrucomDECL_pSnode;
                                brother : mrucomDECL_pRsnode
                             END;
   mrucomDECL_Snode        = RECORD
                                sonlist : mrucomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : mrucomLANGSPEC_Category;
                                ldfield : mrucomLANGSPEC_FieldDef
                             END;
   mrucomDECL_pLostree     = ^mrucomDECL_Lostree;
   mrucomDECL_Lostree      = RECORD
                                next    : mrucomDECL_pLostree;
                                arg     : mrucomDECL_pSnode
                             END;
   mrucomDECL_pConnectionnode
                           = ^mrucomDECL_Connectionnode;
   mrucomDECL_pSingleSegmList
                           = ^mrucomDECL_SingleSegmList;
   mrucomDECL_Connectionnode 
                           = RECORD
                                list    : mrucomDECL_pSingleSegmList;
                                next,
                                prev    : mrucomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   mrucomDECL_SingleSegmList
                           = RECORD
                                next    : mrucomDECL_pSingleSegmlist;
                                rn      : mrucomDECL_pConnectionnode;
                                stree   : mrucomDECL_pSnode
                             END;
   mrucomDECL_psurfgraph     = ^mrucomDECL_surfgraphtype;
   mrucomDECL_psurfgraphnode = ^mrucomDECL_surfgraphnode;
   mrucomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: mrucomDECL_psurfgraphnode
   		               END;
   mrucomDECL_plossurfgraphnode 
                             = ^mrucomDECL_lossurfgraphnode;
   mrucomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : mrucomDECL_plossurfgraphnode;
   			       END;
   mrucomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  mrucomDECL_plossurfgraphnode;
   				   arg  :  mrucomDECL_psurfgraphnode
   			       END;
   mrucomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: mrucomDECL_psurfgraphnode;
   			          n    : mrucomDECL_nodeid;
   			          cat  : mrucomDECL_psyntcat;
   			          nextnodes: mrucomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : mrucomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

