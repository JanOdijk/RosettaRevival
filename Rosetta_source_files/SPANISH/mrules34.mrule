\begin{verbatim}
% RULE Rtempadvsubstitution2           (* temporal PREPP under S *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}[mu3],
             mu2,
             tempadvrel/I1::PREPPVAR{PREPPVARrec1},
             mu4
           ] 
SUBST:
  m2: PREPP{PREPPrec1}[mu5]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}[mu3],
             mu2,
             tempadvrel/PREPP{PREPPrec2}[mu5],
             mu4
           ] 
>

   MATCHCONDITIONS
      <
       m1 : QUOTE_gsubstordercondition1(mu4)
       m  : QUOTE_substordercondition1(mu4) 
       I1 : PREPPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: (temp IN PREPPrec1.actsubcefs) AND
              (PREPPVARrec1 = COPYT_prepptovar(PREPPrec1)) AND
              ((PREPPrec1.class = reference) OR
               (PREPPrec1.class = frequential) OR
               ((PREPPrec1.class = duration) AND
                ((PREPPrec1.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((PREPPrec1.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )
              C11: CLAUSErec1.tiempo <> omegatiempo AND
                   PREPPrec1.supertiempo = CLAUSErec1.tiempo
              A11: @
              C12: CLAUSErec1.supertiempo <> omegatiempo AND
                   PREPPrec1.supertiempo = CLAUSErec1.supertiempo
              A12: @
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.supertiempo := omegatiempo;

         >
      DECOMP
         <
          C1: (temp IN PREPPrec2.actsubcefs) AND
              ((PREPPrec2.class = reference) OR
               (PREPPrec2.class = frequential) OR
               ((PREPPrec2.class = duration) AND
                ((PREPPrec2.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((PREPPrec2.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )
              C11: CLAUSErec1.tiempo <> omegatiempo
              A11: PREPPrec1 := PREPPrec2;
                   PREPPrec1.supertiempo := CLAUSErec1.tiempo;
              C12: CLAUSErec1.supertiempo <> omegatiempo
              A12: PREPPrec1 := PREPPrec2;
                   PREPPrec1.supertiempo := CLAUSErec1.supertiempo;
          A1: PREPPVARrec1 := COPYT_prepptovar(PREPPrec1);
              PREPPVARrec1.index := LEVEL;

         >


&

\end{verbatim}

