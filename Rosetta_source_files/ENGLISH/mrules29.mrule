\newpage
\begin{verbatim}
% TRANSFORMATION TObjToSubjRaising
< m1:CLAUSE{CLAUSErec1}
           [ I1:mu1,
             I2:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/I3::VERB{VERBrec1}[mu5],
                      mu4
                    ],
             mu7 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I1:mu1,
             I5:subjrel/T1,
             I2:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/I3::VERB{VERBrec1}[mu5],
                      mu8
                    ],
             mu7 
           ]
>

   MATCHCONDITIONS
      <
       I1: ALL (mu1, I11:rel1/..)
       I2: NOT EXIST (mu2, [ I11:rel1/..]) AND 
           NOT EXIST (mu2, [subjrel/..])
           I11: rel1 IN AUX_preSubjRels
       I3: VERBrec1.subc <> beVerb
       I5: T1.CAT IN [NPVAR, CNVAR, NP]
      >

<
   SUBRULE (* 1. normal verbs *)
      < mu4: [ I4:sig1,
               I5:objrel/T1,
               I6:mu6 ]  >
      < mu8: [ I4:sig1,
               I6:mu6 ] >

   MATCHCONDITIONS
      <
       I4: ALL (sig1, partrel/..)
       I5: T1.CAT IN [NPVAR, CNVAR, NP]
       I6: NOT EXIST (mu6, [I61:rel2/..]) AND
           NOT EXIST (mu6, [objrel/..])
         I61: rel2 IN AUX_preobjVPrels
      >

      COMP
         <
          C1: CLAUSErec1.voice = Passive
          A1: @
         >
      DECOMP
         <
          C1: CLAUSErec1.voice = Passive 
          A1: @
         >

   SUBRULE (* 2. ergatives *)
      < mu4: [ I9:mu9,
               I5:objrel/T1,
               I6:mu6 ]
      >
      < mu8: [ I9:mu9,
               I6:mu6 ] 
      >

   MATCHCONDITIONS
      <
       I5: T1.CAT IN [NPVAR, CNVAR, NP]
       I6: NOT EXIST (mu6, [I61:rel2/..]) AND
           NOT EXIST (mu6, [objrel/..])
         I61: rel2 IN AUX_preobjVPrels
       I9: ALL (mu9, I91:rel3/..)
         I91: rel3 IN [partrel, indobjrel]
      >

      COMP
         <
          C1: CLAUSErec1.thetavp IN [vp010, vp012] AND
              VERBrec1.Caseassigner = false
          A1: @
         >
      DECOMP
         <
          C1: CLAUSErec1.thetavp IN [vp010, vp012] AND
              VERBrec1.Caseassigner = false
          A1: @
         >
>

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TObjToSubjRaising
\item[* relevant examples:] \mbox{}\\
\begin{enumerate}
\item vp010: melt x1 $\rightarrow$ x1 melt\\
\item vp012: escape x2 x1 $\rightarrow$ x1 escape x2; strike x2 x1 as pompous 
$\rightarrow$ x1 strike x2 as pompous 
\item passive: was killed x2 by x1 $\rightarrow$ x2 was killed by x1
\end{enumerate}
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_ObjectOKrules
\item[* date of creation:] 18-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch TObjectOk1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 01/09/88\ \ \ \ \ author: margreet sanders, jan odijk: Addition of 
a separate subrule for ergatives. Needed because ergatives may have an indirect 
object preceding the direct object, while ordinary verbs in the passive may not
 ( see below under strategy).
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To turn the object into a subject if the verb is passive, or
ergative and not a caseassigner. In contrast with Dutch, there are no 
restrictions on the definiteness or genericity of the object.
\item[\ \ strategy:] (also: deviations from accepted proposals) indirect 
objects have been excluded from subrule 1 on purpose, to prevent
constructions like `the book was given me'. 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:]
