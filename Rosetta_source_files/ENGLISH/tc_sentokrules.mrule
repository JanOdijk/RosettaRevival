\begin{verbatim}

% TRANSFORMATION TExtraposition2
< m1: CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [mu2,
                     prepobjrel/PREPP{PREPPrec1}
                               [head/PREP{PREPrec1},
                                objrel/I1::SENTENCE{SENTENCErec1}[mu3]
                               ],
                     mu4
                    ],
             mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [mu2,
                     prepobjrel/PREPP{PREPPrec1}
                               [head/PREP{PREPrec1},
                                objrel/NP{NPrec1}
                                      [head/PERSPRO{PERSPROrec1}
                                           [head/BPERSPRO(KEY_itbpersprokey)
                                                         {BPERSPROrec1}
                                           ]
                                      ]
                               ],
                     mu4
                    ],
             mu5,
             extraposrel/I1::SENTENCE{SENTENCErec1}[mu3]
            ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCErec1 =  { finiteness : finite
                             senttype   : subordinateclause 
                             mood       : declarative
                             conjkey    : KEY_thatconjkey } 
      >

      COMP
         <
          C1: true
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              (* persprocase remains omegacase *)
              NPrec1 := AUX_NPONitPRSPR
         >
      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = omegacase AND
              NPrec1 = AUX_NPONitPRSPR 
          A1: @
         >
&

\end{verbatim}
