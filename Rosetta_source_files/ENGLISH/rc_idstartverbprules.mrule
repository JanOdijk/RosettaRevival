\newpage
\begin{verbatim}

% RULE RIDNPFORMATION
< m1: CN{CNREC1}[mu1]
  m2: T1
>

< m : NP{NPREC1}[I2:detrel/T1,
                 head/CN{CNrec1}[mu1]
                ]
>
   MATCHCONDITIONS
      <
       I2: T1.CAT IN [NPVAR, CNVAR]
       m2: T1.CAT IN [NPVAR, CNVAR]
      >
COMP
 <
   C1: T1.CAT IN [NPVAR]
   A1: NPREC1 := COPYT_CNtoNP(CNREC1);
       NPREC1.actcomas := CNREC1.posscomas;
       NPREC1.definite := T1.REC.definite;
       NPREC1.posspred := true;
       NPREC1.generic := nogeneric;
       NPREC1.cases := [ ];
       NPREC1.specQ := yesspec;
       NPREC1.mood := T1.REC.mood;
   C1: T1.CAT IN [CNVAR]
   A1: NPREC1 := COPYT_CNtoNP(CNREC1);
       NPREC1.actcomas := CNREC1.posscomas;
       NPREC1.definite := def;
       NPREC1.posspred := true;
       NPREC1.generic := nogeneric;
       NPREC1.cases := [ ];
       NPREC1.specQ := yesspec;
       NPREC1.mood := nowh;
 >
DECOMP
 <
   C1: NPREC1 = COPYT_CNtoNP(CNREC1)
         EXCEPT FOR [specQ, NPhead, syntquant, possRform, generic,
                     mood, possnietnp, posspred, definite, actcomas]
                                            AND
       NPREC1.actcomas = CNREC1.posscomas   AND
       NPREC1.definite = T1.REC.definite    AND
       NPREC1.posspred = true               AND
       NPREC1.generic = nogeneric           AND
       NPREC1.cases = [ ]                   AND
       NPREC1.specQ = yesspec               AND
       (T1.CAT IN [NPVAR] WITH
           T1.REC.mood = NPREC1.mood)
   A1: @
   C1: T1.CAT IN [CNVAR]                    AND
       NPREC1 = COPYT_CNtoNP(CNREC1)
         EXCEPT FOR [specQ, NPhead, syntquant, possRform, generic,
                     mood, possnietnp, posspred, definite, actcomas]
                                            AND
       NPREC1.actcomas = CNREC1.posscomas   AND
       NPREC1.definite = def                AND
       NPREC1.posspred = true               AND
       NPREC1.generic = nogeneric           AND
       NPREC1.cases = [ ]                   AND
       NPREC1.specQ = yesspec               AND
       NPrec1.mood = nowh
   A1: @
 >

&
\end{verbatim}
