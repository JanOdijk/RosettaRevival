\newpage           
\begin{verbatim}
% TRANSFORMATION TCaseAssignment6
< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/I3::VERB{VERBrec1}[mu5],
                      mu4,
                      complrel/I2::SENTENCE{SENTENCErec1}[mu3],
                      mu6
                    ],
             mu7
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/I3::VERB{VERBrec1}[mu5],
                      mu4,
                      complrel/I2::SENTENCE{SENTENCErec1}[mu8],
                      mu6
                    ],
             mu7
           ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.voice <> passive 
       I2: SENTENCErec1.PROsubject = false
       I3: VERBrec1.Caseassigner = true AND 
           VERBrec1.thetavp IN [ vp120, vp123] 
      >


<
   SUBRULE  (* the embedded subject has not been shifted *)
      <mu3:[I4:sig1, subjrel/T1, mu9] >
      <mu8:[I4:sig1, subjrel/T2, mu9] >

   MATCHCONDITIONS
      <
       I4: ALL(sig1, shiftrel/..)
      >
   <
	 SUBRULE
	    <T1:NPVAR{NPVARrec1} >
	    <T2:NPVAR{NPVARrec2} >

	    COMP
	       <
		C1: NPVARrec1.cases = []
		A1: NPVARrec2 := NPVARrec1;
                    NPVARrec2.cases := [Accusative]
	       >

	    DECOMP
	       <
		C1: Accusative IN NPVARrec2.cases
		A1: NPVARrec1 := NPVARrec2;
                    NPVARrec1.cases := []
	       >


	 SUBRULE
	    <T1:CNVAR{CNVARrec1} >
	    <T2:CNVAR{CNVARrec2} >

	    COMP
	       <
		C1: CNVARrec1.cases = []
		A1: CNVARrec2 := CNVARrec1;
                    CNVARrec2.cases := [Accusative]
	       >

	    DECOMP
	       <
		C1: Accusative IN CNVARrec2.cases
		A1: CNVARrec1 := CNVARrec2;
                    CNVARrec1.cases := []
	       >


	 SUBRULE
	    <T1:NP{NPrec1}[mu10] >
	    <T2:NP{NPrec2}[mu11] >

	    COMP
	       <
		C1: NPrec1.cases = []
		A1: QUOTE_assigncase ( NPrec1, mu10, 
                                       NPrec2, mu11, [Accusative]
                                     )
	       >

	    DECOMP
	       <
		C1: Accusative IN NPrec2.cases
		A1: QUOTE_assigncase ( NPrec2, mu11, 
                                       NPrec1, mu10, []
                                     )
	       >
   >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TCaseAssignment6
\item[* relevant examples:] le[acc] ve venir
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] TC\_CA
\item[* date of creation:] 12-SEP-1988 08:45:00  
\item[* author:] Elly van Munster
\item[* copied from:] Jan Odijk (TCaseAssignment4)
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] 
To assign accusative case to the embedded subject of a
closed infinitival clause if the governing verb is transitive, assigns Case
and the voice of its clause is not passive. If the embedded subject has been
shifted already, this case must be assigned to the relevant constituent in
shiftrel/... 
