SPANISH 83

&
%
%SUBGRAMMAR Preppformulatopreppprop


( TpppNoPROsubj/3 | TpppPROsubj/8 )

.
{Rpppsubstitution1/1 | Rpppsubstitution3/6 | 
 Rpppsubstitution4/7 | Rpppsubstitution5/10
}

.
TpppAspectNeutralization/9
.
(Rpppmood1/4 | Rpppmood2/5)
.
RpppNoPunc/2



HEAD:
<
PREPPFORMULA     FROM (PREPPPROPtoPREPPFORMULA)
>


(* IMPORT: *)
<
>


EXPORT:
<
OPENPREPPPROP
CLOSEDPREPPPROP
>
&


\begin{verbatim}
% TRANSFORMATION TpppNoPROsubj
< m1: I1::PREPPFORMULA{PREPPFORMULArec1}[mu1]
>
  
< m : I1::PREPPFORMULA{PREPPFORMULArec1}[mu1]
>
  
   MATCHCONDITIONS
      <
       I1: PREPPFORMULArec1.PROsubject = false
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TpppNoPROsubj
\item[* relevant examples:]
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] preppformulaTOprop
\item[* class:] TC\_pppPROstatus
