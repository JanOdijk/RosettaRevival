(*MPF:::===================================================================*
 *
 *  Function Name  : LSMATCHES_Matchlistsigma
 *  Description    : matches a sigma item
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

PROCEDURE LSMATCHES_Matchlistsigma(L        : LSSTREE_prelNode;
                                              first    : BOOLEAN;
                                              VAR match: BOOLEAN;
                                             PROCEDURE itemfun(
                                                Lfirst,Llast:LSSTREE_prelNode;
                                                first       :BOOLEAN;
                                                VAR match   :BOOLEAN
                                                              );
                                             PROCEDURE listfun(
                                                Lrest        :LSSTREE_prelNode;
                                                first        :BOOLEAN;
                                                VAR listmatch:BOOLEAN
                                                              );
                                             VAR Llast,Lfirst,Lrest:LSSTREE_prelNode;
                                             VAR nomoretrees:BOOLEAN;
                                             VAR i:INTEGER
                                            );
EXTERNAL;


