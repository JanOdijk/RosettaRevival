\newpage
\begin{verbatim}
% TRANSFORMATION TOblSubjControlOpenIngNP
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I7:mu3,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/I6::VERB{VERBrec1}[mu8],
                       I2:mu2,
                       complrel/I3::NP{NPrec1}
                               [head/SENTENCE{SENTENCErec1}
                                    [ I4:subjrel/T2,
                                      I5:mu5
                                    ]
                               ],
                       mu4
                     ],
              mu6
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I7:mu3,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/I6::VERB{VERBrec1}[mu8],
                       I2:mu2,
                       complrel/I3::NP{NPrec1}
                               [head/SENTENCE{SENTENCErec1}
                                    [I5:mu5]
                               ],
                       mu4
                     ],
              mu6
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: NOT EXIST (mu2, [objrel/..])
       I3: NPrec1.NPhead = openIngNP
       I4: T2.CAT IN [NPVAR, CNVAR]
       I5: NOT EXIST (mu5, [subjrel/..])
       I6: VERBrec1.controller = subject
       I7: NOT EXIST (mu3, [I71:auxrel/VERB{VERBrec2}[mu9]])
         I71: VERBrec2.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1
         >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1
         >
>
&

\end{verbatim}
