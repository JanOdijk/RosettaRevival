% RULE RNPretrovarinsertion
< m1: NPPROP{NPPROPrec1}[mu3,
                         predrel/NP{NPrec1}[mu2],
                         I1:mu1
                        ]

  m2: T1
>

< m : NPPROP{NPPROPrec1}[mu3,
                         predrel/NP{NPrec1}[mu2],
                         I1:mu1,
                         tempadvrel/T1
                        ]
>

   MATCHCONDITIONS
      <
       I1: (QUOTE_tempretronotfound(mu1)) AND
