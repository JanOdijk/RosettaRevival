\begin{verbatim}
% TRANSFORMATION Tsuperdeixisadaptation8
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            I1:rel1/SENTENCE{SENTENCErec1}[mu2], 
            mu3
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            I2:rel1/SENTENCE{SENTENCErec2}[mu2], 
            mu3
           ]

>
   MATCHCONDITIONS
      <
       I1: (rel1 = leftdislocrel OR SENTENCErec1.adverbial = true) AND
           (SENTENCErec1.temporal = false)
       I2: (rel1 = leftdislocrel OR SENTENCErec2.adverbial = true) AND
           (SENTENCErec2.temporal = false)
      >
<
   SUBRULE (* no haber *)
      <mu2: [I2: mu4] >
      <mu2: [I2: mu4] >

   MATCHCONDITIONS
      <
       I2: (NOT EXIST(mu4, [auxrel/I21:: VERB{VERBrec1}[mu5]])) AND
           (NOT EXIST(mu4, [I22:rel1/VERB{VERBrec2}[I221:mu6]])) AND
           (NOT EXIST(mu4, [predrel/VERBP{VERBPrec1}[I23:mu8]]))

       I21: (VERBrec1.status = bareV) AND
            (VERBrec1.subc IN [haberaux])
       I22: rel1 IN [head, auxrel, progauxrel] AND 
            VERBrec2.status = VV 
       I221: EXIST(mu6, [auxrel/I222::VERB{VERBrec3}[mu7]])
       I222: VERBrec3.subc IN [haberaux]
       I23: EXIST (mu8, [auxrel/I231::VERB{VERBrec4}[mu9]])
       I231: VERBrec4.subc IN [haberaux]
 
      >

      COMP
         <
          C1:true

             C12: true  (* dependent complement clauses *)
                       (* present *)                
                 C121: (SENTENCErec1.supertiempo = presente) AND
                       (SENTENCErec1.tiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := presente;

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: SENTENCErec2 := SENTENCErec1;

                 A121: SENTENCErec2.supertiempo := omegatiempo;

                 C122:  (* past *)
                      (SENTENCErec1.tiempo = omegatiempo) AND
                      (SENTENCErec1.supertiempo = pasado) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := pasado;

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: SENTENCErec2 := SENTENCErec1;


                 A122: SENTENCErec2.supertiempo := omegatiempo;
                       

              A12: @

          A1: @
         >

      DECOMP
         <
          C1:true

             C12:true  
                       (* dependent complement clauses *)

                       (* present *)
                 C121: (SENTENCErec2.supertiempo = omegatiempo) AND
                       (SENTENCErec2.tiempo = presente) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec2.tiempo = presente) AND
                              (SENTENCErec2.finiteness = finite)
                       A1211: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1212: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1212: SENTENCErec1 := SENTENCErec2;

                 A121: SENTENCErec1.supertiempo := presente;

                 C122: (* past *)
                      (SENTENCErec2.tiempo = pasado) AND
                      (SENTENCErec2.supertiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )
                       C1221: (SENTENCErec2.tiempo = pasado) AND
                              (SENTENCErec2.finiteness = finite)
                       A1221: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1222: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1222: SENTENCErec1 := SENTENCErec2;

                 A122: SENTENCErec1.supertiempo := pasado;


              A12: @

          A1: @
         >

   SUBRULE (* haber *)
      <mu2: [I2: mu4] >
      <mu2: [I2: mu4] >

   MATCHCONDITIONS
      <
       I2: (EXIST(mu4, [auxrel/I21:: VERB{VERBrec1}[mu5]])) OR
           (EXIST(mu4, [I22:rel1/VERB{VERBrec2}[I221:mu6]])) OR
           (EXIST(mu4, [predrel/VERBP{VERBPrec1}[I23:mu8]]))

       I21: (VERBrec1.status = bareV) AND
            (VERBrec1.subc IN [haberaux])
       I22: rel1 IN [head, auxrel, progauxrel] AND 
            VERBrec2.status = VV 
       I221: EXIST(mu6, [auxrel/I222::VERB{VERBrec3}[mu7]])
       I222: VERBrec3.subc IN [haberaux]
       I23: EXIST(mu8, [auxrel/I231::VERB{VERBrec4}[mu9]])
       I231: VERBrec4.subc IN [haberaux]
 
      >

      COMP
         <
          C1:true

             C12: true  (* dependent complement clauses *)
                       (* present *)                
                 C121: (SENTENCErec1.supertiempo = presente) AND
                       (SENTENCErec1.tiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := presente;

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: SENTENCErec2 := SENTENCErec1;

                 A121: SENTENCErec2.supertiempo := omegatiempo;

                 C122:  (* past *)
                      (SENTENCErec1.tiempo = omegatiempo) AND
                      (SENTENCErec1.supertiempo = pasado) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )
                       C1221: (SENTENCErec1.finiteness = finite)
                       A1221: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := pasado;

                       C1222: (SENTENCErec1.finiteness = infinite)
                       A1222: SENTENCErec2 := SENTENCErec1;


                 A122: SENTENCErec2.supertiempo := omegatiempo;
                       

              A12: @

          A1: @
         >

      DECOMP
         <
          C1:true

             C12:true  
                       (* dependent complement clauses *)

                       (* present *)
                 C121: (SENTENCErec2.supertiempo = omegatiempo) AND
                       (SENTENCErec2.tiempo = presente) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec2.tiempo = presente) AND
                              (SENTENCErec2.finiteness = finite)
                       A1211: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1212: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1212: SENTENCErec1 := SENTENCErec2;

                 A121: SENTENCErec1.supertiempo := presente;

                 C122: (* past *)
                      (SENTENCErec2.tiempo = pasado) AND
                      (SENTENCErec2.supertiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )
                       C1221: (SENTENCErec2.tiempo = pasado) AND
                              (SENTENCErec2.finiteness = finite)
                       A1221: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1222: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1222: SENTENCErec1 := SENTENCErec2;

                 A122: SENTENCErec1.supertiempo := pasado;


              A12: @

          A1: @
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tsuperdeixisadaptation8
\item[* relevant examples:]
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:]  XPPROPtoCLAUSE
\item[* class:] TC: Superdeixisadaptation
\item[* date of creation:] 24-FEB-1989
\item[* author:] Lisette Appelo
\item[* copied from:] Tsuperdeixisadaptation1 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 02/03/89\ \ \ \ \ author: Lisette Appelo\\
Deleted indpendent sentences part.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Check superdeixis of a sentence in leftdislocrel or an adverbial 
sentence except for temporal sentences with superdeixis or 
deixis of the higher clause in case of temporally dependent complement 
sentences. The superdeixis of the complement sentence is set omega/given a 
value present or past and the deixis value is given a value present or past/ 
set omega in cases necessary. (This is needed for efficiency 
reasons of the surface parser.) For temporally independent sentences this rule 
does nothing. 
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]  A complement 
sentence with infinitive {\em haber} may be independent, while other infinitive 
complement sentences are considered to be dependent. subrule 1 is for all 
complement clauses without {\em haber}. Subrule 2 is for complement clauses 
with {\em haber}.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc. nr 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The combination of an independent presentdeixis complement 
clause with a present (super)deixis higher clause is ruled out. It is supposed 
that these cases are always dependent. The rule is split up into two subruels. 
Only infinitive complement sentences with {\em haber} may be independent.\\

\end{enumerate}
\end{description}

