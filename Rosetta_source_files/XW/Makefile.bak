###########################################################################
# start of Imakefile

SYSLIBS=  -lMrm -lXs -lXm -lXt -lXext -lX11

# Include base DIRectory

PIDIR = /home/leermake/archive/rosetta3

CDEBUGFLAGS = -g -DDEVELOPMENT
EXTRA_INCLUDES = -I$(PIDIR)/unix -I$(PIDIR)/Xw
LINTOPTS = -abcxz

EXTRA_LOAD_FLAGS =

LOCAL_LIBRARIES =

AR = ar

PFLAGS =  -I. -I$(PIDIR)/general -I$(PIDIR)/tools \
	  -Hpro=$(PIDIR)/actions/pp.pro

PC = pp
COMPILE.p = $(PC) $(PFLAGS) -c
LINK.p = $(PC) $(LDFLAGS) $(EXTRA_LOAD_FLAGS)

.SUFFIXES: .p .p~.pf .pf~ .uil .uil~ .uid

.uil.uid:
	       $(CPP) -P -I$(PIDIR)/Xw $< > /tmp/$<
	       $(UIL) -o $@ /tmp/$< ; $(RM) /tmp/$<

.KEEP_STATE:

all:: xw

UOBJ = /home/leermake/archive/rosetta3/unix/

SRCS1 = Xw.c Xwa.c Xwb.c Xwd.c Xwh.c Xwl.c Xwm.c Xwr.c Xwt.c Xwu.c Tree.c Attr.c

OBJS1 = $(SRCS1:.c=.o) $(UOBJ)wch.o $(UOBJ)wipc.o $(UOBJ)sockipc.o $(UOBJ)mkkey.o \
	$(UOBJ)paspar.o $(UOBJ)logc.o  $(UOBJ)mb.o

DEPLIBS1 = $(LOCAL_LIBRARIES)

DEPLIBS2 = $(LOCAL_LIBRARIES)

xw:: Xw windows.uid

 OBJS = $(OBJS1) $(OBJS2) $(OBJS3)
 SRCS = $(SRCS1) $(SRCS2) $(SRCS3)

all:: $(PROGRAMS)

Xw: $(OBJS1) $(DEPLIBS1)
	$(RM) $@
	$(CC) -o $@ $(LDOPTIONS) $(OBJS1) $(LOCAL_LIBRARIES) $(LDLIBS) $(SYSLIBS) $(EXTRA_LOAD_FLAGS)

install:: Xw
	$(INSTALL) -c $(INSTPGMFLAGS)   Xw $(BINDIR)

install.man:: Xw.man
	$(INSTALL) -c $(INSTMANFLAGS) Xw.man $(MANDIR)/Xw.n

saber_Xw:
	#load $(ALLDEFINES) $(SRCS1) $(LOCAL_LIBRARIES) $(SYS_LIBRARIES) $(EXTRA_LIBRARIES) $(SYSLIBS)

osaber_Xw:
	#load $(ALLDEFINES) $(OBJS1) $(LOCAL_LIBRARIES) $(SYS_LIBRARIES) $(EXTRA_LIBRARIES) $(SYSLIBS)

depend::
	$(DEPEND) -s "# DO NOT DELETE" -- $(ALLDEFINES) -- $(SRCS)

lint:
	$(LINT) $(LINTFLAGS) $(SRCS) $(LINTLIBS)
lint1:
	$(LINT) $(LINTFLAGS) $(FILE) $(LINTLIBS)

clean::
	$(RM) $(PROGRAMS)

install::
	$(MKDIRHIER)  $(BINDIR) $(UIDDIR)

clean::
	       $(RM) -f *.uid

UILS1 = windows.uil mw.uil Xwuil.h dbgset.uil env.uil amb1.uil mp.uil mg.uil \
	dialogs.uil dbg.uil tree.uil trees.uil attr.uil help.uil amb2.uil \
	amb3.uil hn.uil

windows.uid: $(UILS1)

Xid.h : Xid.def
	stripdef <Xid.def >Xid.h

Sid.h : Sid.def
	stripdef <Sid.def >Sid.h

###########################################################################
# common rules for all Makefiles - do not edit

emptyrule::

clean::
	$(RM_CMD) \#*

Makefile::
	-@if [ -f Makefile ]; then \
	echo "	$(RM) Makefile.bak; $(MV) Makefile Makefile.bak"; \
	$(RM) Makefile.bak; $(MV) Makefile Makefile.bak; \
	else exit 0; fi
	$(IMAKE_CMD) -DTOPDIR=$(TOP) -DCURDIR=$(CURRENT_DIR)

tags::
	$(TAGS) -w *.[ch]
	$(TAGS) -xw *.[ch] > TAGS

saber:
	#load $(ALLDEFINES) $(SRCS)

osaber:
	#load $(ALLDEFINES) $(OBJS)

