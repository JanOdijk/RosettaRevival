\begin{verbatim}
% RULE RCNmodposs3 
     

< m1: CN{CNrec1}[I1:mu1]

  m2: NP{NPrec1}[mu2, head/PERSPRO{PERSPROrec1}[mu4]]
>

< m : CN{CNrec1}[I1:mu1,
                 posrel/NP{NPrec2}[mu2, head/PERSPRO{PERSPROrec1}[mu4]]
                ]
>

   MATCHCONDITIONS
      <I1: ( EXIST (mu1,[head/NOUN{NOUNrec1}[mu7]]) ) AND
           ( NOT EXIST (mu1,[posrel/..]) )
      >


      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo 
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
(*              PERSPROrec1.persprocases := [nominative]; *)
              NPrec2.generic := omegageneric;              
         >

      DECOMP
         <
          C1: (* PERSPROrec1.persprocases * [nominative] <> [] AND *)
               NPrec2.supertiempo = omegatiempo
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := CNrec1.supertiempo;
              NPrec1.generic := nogeneric;
         >

&

\end{verbatim}
