\newpage
\begin{verbatim}
%
% TRANSFORMATION TADJmoreTOer                           (* regel1: longer *)

< m1: ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      degreemodrel/QP{QPrec1}
                                         [mu3,
                                          head/Q(KEY_moreQkey){Qrec1}
                                         ],
                                      head/I1::ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                              ]
>

< m : ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [I2:mu2,
                                      I3:mu3, (* much/a bit/ 3 METER *)
                                      head/I4::ADJ{ADJrec2}[mu4],
                                      mu5
                                     ]
                            ]
>
   MATCHCONDITIONS
      <
       I1: ADJrec1.compformations <> [noComp] AND
           ADJrec1.compformations <> [moreComp] 
       I2: NOT EXIST(mu2, [premodrel/..])
       I3: ALL(mu3, premodrel/..)
       I4: ADJrec2.compform = compar AND
           ADJrec2.compformations <> [noComp] AND
           ADJrec2.compformations <> [moreComp] 
      >

      COMP
         <
          C1: ADJrec1.compform = basic
          A1: ADJrec2 := ADjrec1;
              ADJrec2.compform := compar
         >
      DECOMP
         <
          C1: true
          A1: ADJrec1 := ADjrec2;
              ADJrec1.compform := basic;
              QPrec1 := COPYT_qTOqp(Qrec1) (* QPrec1.thanascompl ??? *)
         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TADJmoreTOer
\item[* relevant examples:] more long $\rightarrow$  longer 
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] AdjpProptoAdjpFormula
\item[* class:] TC:MORPHADAP
\item[* date of creation:] 17-FEB-1988 11:22:26  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 17/04/89\ \ \ \ \ author: margreet sanders\\
1) Extended working of the rule to all ADJs that are not [noComp] or [moreComp]
(in the previous formulation, all irrComp and cdComp ADJs were excluded).\\
2) Added condition C1\\
3) Extended matchcond I4 with same restrictions as under I1\\
(Both 2 and 3 are reversibility demands)
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] morphological incorporation of the comparative expression `more'
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
mu2 for all kinds of arguments and modifiers (not degreemodifiers),
mu3 for modifiers of {\em more}
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
