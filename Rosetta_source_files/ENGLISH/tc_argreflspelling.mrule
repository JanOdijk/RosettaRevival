         <
          C1: NPrec1 = AUX_NPONherRFLPR EXCEPT FOR [cases] AND
              CNVARrec1.numbers = [singular] AND
              ( feminine IN CNVARrec1.sexes OR
                CNVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3c. itself *)
      < >
      < T1: REFLPRO(AUX_itselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: CNVARrec1.numbers = [singular] AND
              CNVARrec1.genders = [omegagender] AND
              CNVARrec1.sexes = [] 
          A1: NPrec1 := AUX_NPONitRFLPR;
              NPrec1.cases := CNVARrec2.cases
         >

