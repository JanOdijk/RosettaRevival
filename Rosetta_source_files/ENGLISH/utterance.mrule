\newpage
\begin{verbatim}
% RULE RaddExclam
< m1:UTT{UTTrec1}[head/SENTENCE{SENTENCErec1}[mu1]] 
  m2:EXCLAM{EXCLAMrec1}
>

< m :UTT{UTTrec1}
        [ modrel/EXCLAM{EXCLAMrec1},
          puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1},
          head/SENTENCE{SENTENCErec1}[mu1]
        ] 
>

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
