\begin{verbatim}
%
% RULE Rretro
< m1: CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I3: mu2,
                     I1: rel1/VERB{VERBrec1}[mu3],
                     mu4
                    ],
             I2: mu5
            ] 
>

< m : CLAUSE{CLAUSErec2}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I3: mu2,
                     auxrel/VERB{VERBrec3}
                           [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(AUX_havebverbkey){BVERBrec1}]
                           ],
                     I1: rel1/VERB{VERBrec2}[mu3],
                     mu4
                    ],
             I2: mu5
            ] 

>
   MATCHCONDITIONS
      <
       I1: (rel1 IN [head, passauxrel, progauxrel])
       I2: EXIST(mu5, [tempadvrel/..])
       I3: NOT EXIST (mu2, [I4: rel2/..])
       I4: rel2 IN [auxrel, progauxrel, passauxrel]
      >

<
   SUBRULE

      < mu5: [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7] >
      < mu5: [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7] >

   MATCHCONDITIONS
      <
       I3: (ADVPVARrec1.retro = true)

      >

      COMP
         <
          C1: (VERBrec1.modus = omegamodus) AND
              (CLAUSErec1.retro = false)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other attributes retain their default values *)
              VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
         >
      DECOMP
         <
          C1: (CLAUSErec2.retro = true) AND
              (VERBrec2.modus = participle) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec3 =
                { 
                 numbers      : []
                 persons      : []   
                 modus        : omegamodus
                 tense        : omegatense  
                }
                 ) AND
              (SUBVERBrec1.affix = noaffix)    
             (* the default values for these attributes *)
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;              
         >

   SUBRULE
      < mu5: [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7] >
      < mu5: [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7] >

   MATCHCONDITIONS
      <
       I3: (PREPPVARrec1.retro = true) 

      >

      COMP
         <
          C1: (VERBrec1.modus = omegamodus) AND
              (CLAUSErec1.retro = false)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other attributes retain their default values *)
              VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
         >
      DECOMP
         <
          C1: (CLAUSErec2.retro = true) AND
              (VERBrec2.modus = participle) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec3 =
                { 
                 numbers      : []
                 persons      : []   
                 modus        : omegamodus
                 tense        : omegatense  
                }
                 ) AND
              (SUBVERBrec1.affix = noaffix)    
             (* the default values for these attributes *)
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;              
         >


   SUBRULE
      < mu5: [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7] >
      < mu5: [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7] >

   MATCHCONDITIONS
      <
       I3: (SENTENCErec1.conjretro = true) 

      >

      COMP
         <
          C1: (VERBrec1.modus = omegamodus) AND
              (CLAUSErec1.retro = false)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other attributes retain their default values *)
              VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
         >
      DECOMP
         <
          C1: (CLAUSErec2.retro = true) AND
              (VERBrec2.modus = participle) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec3 =
                { 
                 numbers      : []
                 persons      : []   
                 modus        : omegamodus
                 tense        : omegatense  
                }
                 ) AND
              (SUBVERBrec1.affix = noaffix)    
             (* the default values for these attributes *)
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;              
         >

>
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rretroperfective
\item[* relevant examples:]  CL(..... have worked since 1972) (head),
CL(......have been working for three hours) (progaux),
CL(......have been hit) (passaux),
CL(..... have been ill) (head),
CL(..... have had a book) (head),
*CL(.....have had worked) (aux),
*CL(.....have `canned' work) (aux),
*CL(.....have `willed' work) (aux),
*CL(.....have done work) (aux)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Retrospectivity rules
\item[* date of creation:] 25-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rretroperfective Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Between the reference interval Re and the reference Rs holds a
relation "until".\\ 
The clause must
contain a reference adverbial variable
that has for its attribute retro the value true \\
The resulting clause is
marked for retrospectivity and the auxiliary verb {\em have} is introduced. 
The main verb gets modus {\em participle} if possible(!). 
\item[\ \ strategy:] deviation from accepted proposal of doc. 53. The reference 
time adverbial variables are no longer introduced by the retrospectivity rules 
but in a separate rule class following the retrospectivity rule class.\\
Auxiliary verbs are 
assumed not to combine with {\em have} except for {\em be}.\\
Auxiliary verbs such as modal verbs and {\em do} can exist to the left of {\em 
have}, but then the rule is not applicable here, but in the next cycle as {\em 
have} belongs in that case to the complement of the modal verb and the 
existence of {\em do} is wrong here. {\em Be} (progauxrel or passauxrel) are 
not allowed to the left of {\em have}

\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] T1 stands for a reference time adverbial 
variable of category ADVP, PREPP or SENTENCE.
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see also task)\\
This rule has the same semantics as Rretroperfective of SPANISH
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ 

\item rules:\\ A rule introducing a variable for a 
retrospective time adverbial and substitution rules for retrospective 
adverbials that also check for aspect!

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\
\item in other languages:\\
This rule corresponds to the Rretro rules in other grammars
\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: CONJSENT has been substituted by SENTENCE. Therefore, the 
generalisation over the time attribute {\em retro} is not possible anymore. the 
rule had to be split up in 3 subrules.\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rretrospec
< m1: CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I3: mu2,
                     I1: rel1/VERB{VERBrec1}
                             [head/SUBVERB{SUBVERBrec1}
                                  [I5: head/BVERB(KEY1){BVERBrec1}]
                             ],
                     I6: rel3/VERB{VERbrec3}[mu7],
                     mu3
                    ],
             I2: mu4
            ] 
>

< m : CLAUSE{CLAUSErec2}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I3: mu2,
                     auxrel/VERB{VERBrec2}
                           [head/SUBVERB{SUBVERBrec2}
                               [head/BVERB(KEY_havebverbkey){BVERBrec2}]
                           ],
                     I1: rel1/VERB{VERBrec1}
                             [head/SUBVERB{SUBVERBrec1}
                                  [I5: head/BVERB(KEY1){BVERBrec1}]
                             ],
                     I6: rel3/VERB{VERbrec4}[mu7],
                     mu3
                    ],
             I2: mu4
            ] 

>
   MATCHCONDITIONS
      <
       I1: (rel1 = auxrel)
       I2: EXIST(mu4, [tempadvrel/..])
       I3: NOT EXIST (mu2, [I4: rel2/..])
       I4: rel2 IN [auxrel, progauxrel, passauxrel]
       I5: KEY1 = KEY_must1BVERBkey OR
           KEY1 = KEY_must2BVERBkey OR
           KEY1 = KEY_can1BVERBkey OR
           KEY1 = KEY_can2BVERBkey OR
           KEY1 = KEY_may1BVERBkey
       I6: rel3 IN [progauxrel, passauxrel, head]
      >

<
   SUBRULE

      < mu4: [mu5, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu6] >
      < mu4: [mu5, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu6] >

   MATCHCONDITIONS
      <
       I3: (ADVPVARrec1.retro = true)

      >

      COMP
         <
          C1: (VERBrec1.modus = omegamodus) AND
              (VERBrec3.modus = infinitive) AND
              (CLAUSErec1.retro = false)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec2);
              VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
              VERBrec4 := VERBrec3;
              VERBrec4.modus := participle;
              (* other attributes retain their default values *)
              
         >
      DECOMP
         <
          C1: (CLAUSErec2.retro = true) AND
              (VERBrec4.modus = participle) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec2)) AND
              (SUBVERBrec2 = COPYT_bverbtosubverb(BVERBrec2)) AND
              (VERBrec2 =
               {              
                 numbers      : []
                 persons      : []   
                 modus        : omegamodus
                 tense        : omegatense  
                }
                 ) AND
              (SUBVERBrec2.affix = noaffix)    
             (* the default values for these attributes *)
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec3 := VERBrec4;
              VERBrec3.modus := infinitive;
         >

   SUBRULE
      < mu4: [mu5, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu6] >
      < mu4: [mu5, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu6] >

   MATCHCONDITIONS
      <
       I3: (PREPPVARrec1.retro = true) 

      >

      COMP
         <
          C1: (VERBrec1.modus = omegamodus) AND
              (VERBrec3.modus = infinitive) AND
              (CLAUSErec1.retro = false)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec2);
              VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
              VERBrec4 := VERBrec3;
              VERBrec4.modus := participle;
              (* other attributes retain their default values *)
              
         >
      DECOMP
         <
          C1: (CLAUSErec2.retro = true) AND
              (VERBrec4.modus = participle) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec2)) AND
              (SUBVERBrec2 = COPYT_bverbtosubverb(BVERBrec2)) AND
              (VERBrec2 =
               {              
                 numbers      : []
                 persons      : []   
                 modus        : omegamodus
                 tense        : omegatense  
                }
                 ) AND
              (SUBVERBrec2.affix = noaffix)    
             (* the default values for these attributes *)
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec3 := VERBrec4;
              VERBrec3.modus := infinitive;
         >


   SUBRULE
      < mu4: [mu5, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu6] >
      < mu4: [mu5, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu6] >

   MATCHCONDITIONS
      <
       I3: (SENTENCErec1.conjretro = true) 

      >

      COMP
         <
          C1: (VERBrec1.modus = omegamodus) AND
              (VERBrec3.modus = infinitive) AND
              (CLAUSErec1.retro = false)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              SUBVERBrec2 := COPYT_bverbtosubverb(BVERBrec2);
              VERBrec2 := COPYT_subverbtoverb(SUBVERBrec2);
              VERBrec4 := VERBrec3;
              VERBrec4.modus := participle;
              (* other attributes retain their default values *)
              
         >
      DECOMP
         <
          C1: (CLAUSErec2.retro = true) AND
              (VERBrec4.modus = participle) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec2)) AND
              (SUBVERBrec2 = COPYT_bverbtosubverb(BVERBrec2)) AND
              (VERBrec2 =
               {              
                 numbers      : []
                 persons      : []   
                 modus        : omegamodus
                 tense        : omegatense  
                }
                 ) AND
              (SUBVERBrec2.affix = noaffix)    
             (* the default values for these attributes *)
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec3 := VERBrec4;
              VERBrec3.modus := infinitive;
         >

>
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rretrospec
\item[* relevant examples:]  CL(..... have can) 
CL(......have must,
CL(......have may
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Retrospectivity rules
\item[* date of creation:] 10-OCT-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rretro
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Between the reference interval Re and the reference Rs holds a
relation "until".\\ 
The clause must
contain a reference adverbial variable
that has for its attribute retro the value true \\
The resulting clause is
marked for retrospectivity and the auxiliary verb {\em have} is introduced. 
\item[\ \ strategy:] deviation from accepted proposal of doc. 53. The reference 
time adverbial variables are no longer introduced by the retrospectivity rules 
but in a separate rule class following the retrospectivity rule class.\\
This rule is a special rule for {\em can, must} and {\em may}. It will be 
followed by a past deixis rule and then {\em had} is made {\em have} again and 
placed behind {\em can, must} and {\em may} that are turned into their past 
tense forms {\em could, should} and {\em might} respectively in the 
modalhaveadaptation rules.\\
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:] Each subrule is for 
a different category of a time adverbial.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see also task)\\
This rule has the same semantics as other retro rules.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ 

\item rules:\\ A rule introducing a variable for a 
retrospective time adverbial and substitution rules for retrospective 
adverbials that also check for aspect!

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\
\item in other languages:\\
This rule corresponds to the Rretro rules in other grammars
\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: CONJSENT has been substituted by SENTENCE. Therefore, the 
generalisation over the time attribute {\em retro} is not possible anymore. the 
rule had to be split up in 3 subrules.\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% TRANSFORMATION Thavemodaladaptation (* bonus -1 *)
< m1 : CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I1: mu2,
                     auxrel/VERB{VERBrec2}
                           [head/SUBVERB{SUBVERBrec2}
                               [head/BVERB(KEY_havebverbkey){BVERBrec2}]
                           ],
                     auxrel/VERB{VERBrec1}
                           [head/SUBVERB{SUBVERBrec1}
                                [I3: head/BVERB(KEY1){BVERBrec1}]
                           ],
                     mu3
                    ],
             mu4
            ] 
>

< m : CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I1: mu2,
                     auxrel/VERB{VERBrec3}
                            [head/SUBVERB{SUBVERBrec3}
                                 [I4: head/BVERB(KEY2){BVERBrec3}]
                            ],
                     auxrel/VERB{VERBrec4}
                           [head/SUBVERB{SUBVERBrec2}
                               [head/BVERB(KEY_havebverbkey){BVERBrec2}]
                           ],
                     mu3
                    ],
             mu4
            ] 

>

   MATCHCONDITIONS
      <m1: CLAUSErec1.finiteness = finite 
       m : CLAUSErec1.finiteness = finite
       I1: NOT EXIST (mu2, [I2: rel2/..])
       I2: rel2 IN [auxrel, progauxrel, passauxrel]
       I3: KEY1 = KEY_must1BVERBkey OR
           KEY1 = KEY_must2BVERBkey OR
           KEY1 = KEY_can1BVERBkey OR
           KEY1 = KEY_can2BVERBkey OR
           KEY1 = KEY_may1BVERBkey
       I4: KEY2 = KEY_shallbverbkey OR
           KEY2 = KEY_should2BVERBkey OR
           KEY2 = KEY_can1BVERBkey OR
           KEY2 = KEY_can2BVERBkey OR
           KEY2 = KEY_may1BVERBkey
      >

      COMP
         <
          C1: VERBrec2.tense = pasttense AND
              VERBrec1.tense = omegatense
              C11: KEY1 = KEY_can1BVERBkey OR
                   KEY1 = KEY_can2BVERBkey OR
                   KEY1 = KEY_may1BVERBkey
              A11: KEY2 := KEY1;
                   BVERBrec3 := BVERBrec1;
                   SUBVERBrec3 := SUBVERBrec1;
                   VERBrec3 := VERBrec1;
              C12: KEY1 = KEY_must1BVERBkey 
              A12: KEY2 := KEY_shallbverbkey;
                   SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
                   VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
              C13: KEY1 = KEY_must2BVERBkey
              A13: KEY2 := KEY_should2BVERBkey;
                   SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
                   VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);

          A1: VERbrec3.tense := pasttense;
              VERBrec4 := VERBrec2;
              VERBrec4.tense := omegatense;
              VERbrec4.modus := infinitive;
         >
      DECOMP
         <
          C1: VERBrec3.tense = pasttense AND
              VERBrec4.tense = omegatense AND
              VERBrec4.modus = infinitive

              C11: KEY2 = KEY_can1BVERBkey OR
                   KEY2 = KEY_can2BVERBkey OR
                   KEY2 = KEY_may1BVERBkey
              A11: KEY1 := KEY2;
                   BVERBrec1 := BVERBrec3;
                   SUBVERBrec1 := SUBVERBrec3;
                   VERBrec1 := VERBrec3;
              C12: KEY2 = KEY_shallbverbkey 
              A12: KEY1 := KEY_must1BVERBkey;
                   SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
              C13: KEY2 = KEY_should2BVERBkey
              A13: KEY1 := KEY_must2BVERBkey;
                   SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);

          A1: VERBrec2 := VERBrec4;
              VERBrec2.tense := pasttense;
              VERBrec2.modus := omegamodus;
              VERBrec1.tense := omegatense;
            
         >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] Thavemodaladaptation
\item[* relevant examples:] had `can' $rightarrow$ could have\\
had `must' $rightarrow$ should have\\
had `may' $rightarrow$ might have\\
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoclause
\item[* class:] TC:havemodaladaptation
\item[* date of creation:] 11-OCT-1988 09:00:38  
\item[* author:] Lisette Appelo
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Reverse order of `had' and the modals `can', `must' and `may', 
and 
make `had', `have' and the modals `could', `should' and `might' respectivily. 
\item[\ \ strategy:] This is a special, very ad hoc rule that takes care of the 
possibility to translate e.g. `he could have come' into `hij had kunnen komen'.
It presupposes a special Retro rule: Rretrospec.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] 
(e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\ \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: Rretrospec\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages: this rule is necessary to be able to translate `he 
should have come' into `hij had moeten komen' in Dutch.\\

\end{enumerate}
\item[* relevant literature/documents:] Minutes of linguist meetings sept/oct. 
1988.
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% FILTER Fhavemodaladaptation 
< m : CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [I1: mu2,
                     auxrel/VERB{VERBrec2}
                           [head/SUBVERB{SUBVERBrec2}
                               [head/BVERB(KEY_havebverbkey){BVERBrec2}]
                           ],
                     auxrel/VERB{VERBrec1}
                           [head/SUBVERB{SUBVERBrec1}
                                [I3: head/BVERB(KEY1){BVERBrec1}]
                           ],
                     mu3
                    ],
             mu4
            ] 
>

   MATCHCONDITIONS
      <
       m:  CLAUSErec1.finiteness = finite
       I1: NOT EXIST (mu2, [I2: rel2/..])
       I2: rel2 IN [auxrel, progauxrel, passauxrel]
       I3: KEY1 = KEY_must1BVERBkey OR
           KEY1 = KEY_must2BVERBkey OR
           KEY1 = KEY_can1BVERBkey OR
           KEY1 = KEY_can2BVERBkey OR
           KEY1 = KEY_may1BVERBkey
      >



         <
          C1: VERBrec2.tense = pasttense AND
              VERBrec1.tense = omegatense
              C11: KEY1 = KEY_can1BVERBkey OR
                   KEY1 = KEY_can2BVERBkey OR
                   KEY1 = KEY_may1BVERBkey
              A11: @
              C12: KEY1 = KEY_must1BVERBkey 
              A12: @
              C13: KEY1 = KEY_must2BVERBkey
              A13: @
          A1: @
         >
&
\end{verbatim}
