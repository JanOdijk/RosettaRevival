                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      }
                   )
              A12: @
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: true
              C11: true
              A11: OPENNPPROPrec1 :=
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      };
                   rel1 := predrel                  
              C12: true
              A12: OPENNPPROPrec1 :=
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      };
                    rel1 := idrel              
          A1:  CLAUSErec1 := CLAUSErec2;
               NPVARrec2 := NPVARrec1;
               OPENNPPROPrec1 :=
		   { 
		    PROsubject     : true
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >


   SUBRULE (* 2 *)
      <
       T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1 = CNVARrec2) AND 
              ( OPENNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative]
		    thetanp        : NPrec1.thetanp
		    nounpatternefs : NPrec1.nounpatternefs
		    PROsubject     : true
		   }
              )
              C11: (rel1 = predrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      }
                   )
              A11: @
              C12: (rel1 = idrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      }
                   )
              A12: @
          A1: @
         >

      DECOMP
         <
          C1: true
              C11: true
              A11: OPENNPPROPrec1 :=
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      };
                   rel1 := predrel                  
              C12: true
              A12: OPENNPPROPrec1 :=
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      };
                    rel1 := idrel              
          A1: CNVARrec2 := CNVARrec1;
               OPENNPPROPrec1 :=
		   { 
		    thetanp        : NPrec1.thetanp
		    nounpatternefs : NPrec1.nounpatternefs
		    PROsubject     : true
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >

>
&

\end{verbatim}
