\newpage
\begin{verbatim}
% FILTER FpostADJQPhopping
< m:  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [mu2,
                       degreemodrel/QP{QPrec1}
                                    [I1:modrel/T1,
                                     head/I2::Q{Qrec1}
                                    ],
                       head/ADJ{ADJrec1}[mu5],
                       mu6
                      ],
                 mu7
                ]
>
   MATCHCONDITIONS
      < 
        I1: T1.cat IN [ADVP] WITH T1.REC.actsubcefs * [degreeadv] <> []
        I2: QPrec1.hop =  true
      >

      COMP
         <
          C1: true
          A1: @
         >
      (* No DECOMP *) 


 
&
\end{verbatim}
