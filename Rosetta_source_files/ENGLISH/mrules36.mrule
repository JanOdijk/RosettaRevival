\newpage
\begin{verbatim}
%
% RULE Rrefvarinsertion
< m1: VERBPPROP{VERBPPROPrec1}
            [mu1,
             predrel/VERBP{VERBPrec1}[mu3],
             I4: mu6,
             I1: mu2
            ] 

  m2: T1 
>

< m : VERBPPROP{VERBPPROPrec1}
            [mu1,
             predrel/VERBP{VERBPrec1}[mu3],
             I4: mu6,
             tempadvrel/T1,
             I1: mu2
            ] 
>
   MATCHCONDITIONS
      <
       I1: (QUOTE_temprefnotfound(mu2)) AND
           (QUOTE_tempretronotfound(mu2)) AND
           (QUOTE_tempdurnotfound(mu2)) AND 
           NOT EXIST (mu2, [locadvrel/..])
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       I4: ALL (mu6, locadvrel/..)
      >

<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1} >
      < T1: ADVPVAR{ADVPVARrec1} >

      COMP
         <
          C1: (ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false)
          A1: @
         >

   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1} >
      < T1: PREPPVAR{PREPPVARrec1} >

      COMP
         <
          C1: (PREPPVARrec1.class = reference) AND
              (PREPPVARrec1.retro = false)
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.class = reference) AND
              (PREPPVARrec1.retro = false)
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <

          C1: (SENTENCEVARrec1.conjclass = reference) AND
              (SENTENCEVARrec1.conjretro = false)
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjclass = reference) AND
              (SENTENCEVARrec1.conjretro = false)
          A1: @
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rrefvarinsertion
\item[* relevant examples:] \mbox{}\\
\begin{itemize}
  \item he work (locadvVAR) refVAR (for: {\em yesterday, 
tomorrow, at 3 o'clock } etc.) 
\end{itemize}
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] VERBPPROPformation
\item[* class:] Tempadvvarinsertion rules
\item[* date of creation:] 25-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rrefvarinsertion Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/03/88\ \ \ \ \ author: Lisette Appelo 
\item date: 25/09/89\ \ \ \ \ author: Margreet Sanders \\
Added conditions on occurrence of locadvrels. Needed because all advvar rules 
(loc, temp, sent) are collapsed into one large iterative class.
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] Introduction of variables for referential time adverbials that 
are not retrospective. These time adverbials are supposed to be of category 
ADVP, PREPP or SENTENCE. They will be substituted in the substitution rules.
\item[\ \ strategy:] deviation from accepted proposal of doc 53: the variables 
for referential time adverbials are no longer introduced by the aspect or 
retrospectivity rules, but by rules in a separate rule class preceding these 
rules in the VERBPPROPformation subgrammar. 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application?
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: Only one rule for non retrospective referential time adverbials 
will be applied. Complex time adverbials such as e.g. {\em yesterday at 3 o'
clock} can 
form one constituent, but also appear disjunctive as e.g. in {\em yesterday he 
arrived at 3 o'clock}. How should we treat this case? Introduction at once followed 
by a syntactic transformation or separate introduction?\\

\item modifications: CONJSENT has been substituted by SENTENCE\\
Because of this change the rule had to be split up into 3 subrules, bcause the 
generalization over the time attributes is not longer possible now. The 
introduction of the variables is moved to the VERBPPROPformation subgrammar.\\
The adverbial variables are inserted in a
fixed order (generatively): reference, 
retro, duration.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rdurvarinsertion
< m1: VERBPPROP{VERBPPROPrec1}
            [mu1,
             predrel/VERBP{VERBPrec1} 
                    [mu3,
                     head/I2::VERB{VERBrec1}[mu4],
                     mu5
                    ],
             I4: mu6,
             I1: mu2
            ] 

  m2: T1 
>

< m : VERBPPROP{VERBPPROPrec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [mu3,
                     head/I2::VERB{VERBrec1}[mu4],
                     mu5
                    ],
             I4: mu6,
             tempadvrel/T1,
             I1: mu2
            ] 
>
   MATCHCONDITIONS
      <
       I1: (QUOTE_tempdurnotfound(mu2)) AND 
           NOT EXIST (mu2, [locadvrel/..])
       I2: (VERBrec1.subc <> modalverb)
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       I4: ALL (mu6, locadvrel/..)
      >

<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1} >
      < T1: ADVPVAR{ADVPVARrec1}>

      COMP
         <
          C1: (ADVPVARrec1.class = duration) AND
              (ADVPVARrec1.retro = false)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.class = duration) AND
              (ADVPVARrec1.retro = false) 
          A1: @
         >

   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1} >
      < T1: PREPPVAR{PREPPVARrec1}>

      COMP
         <
          C1: (PREPPVARrec1.class = duration) AND
              (PREPPVARrec1.retro = false) 
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.class = duration) AND
              (PREPPVARrec1.retro = false) 
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: (SENTENCEVARrec1.conjclass = duration) AND
              (SENTENCEVARrec1.conjretro = false) 
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjclass = duration) AND
              (SENTENCEVARrec1.conjretro = false) 
          A1: @
         >
>
&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Rdurvarinsertion
\item[* relevant examples:] \mbox{} \\
\begin{itemize}
  \item he work (locadvVAR) durVAR (for {\em for 3 hours, during 3 hours,
as long a he wanted} etc.), he write a letter VAR (for {\em in three
hours} etc.) 
\end{itemize}
\item[* language:] english
\item[* kind of rule:] M-rule
\item[* subgrammar:] VERBPPROPformation
\item[* class:] tempadvvarinsertion rules
\item[* date of creation:] 25-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rdurvarinsertion Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/03/88\ \ \ \ \ author: Lisette Appelo 
\item date: 25/09/89\ \ \ \ \ author: Margreet Sanders \\
Added conditions on occurrence of locadvrels. Needed because all advvar rules 
(loc, temp, sent) are collapsed into one large iterative class.
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] Introduction of variables for durative time adverbials.
These time adverbials are supposed to be of category 
ADVP, PREPP or SENTENCE. They will be substituted in the substitution rules.
(Perfective (i.e. inaccessible) adverbials combine with stative and activity 
Aktionsart; imperfective (i.e. accessible) adverbials combine with 
accomplishment and achievement Aktionsart, but this is not checked here but in 
the substitution rules for durative time adverbials).
\item[\ \ strategy:] 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application?
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: substitution rules for time 
adverbials will follow.\\
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: 
\item modifications: The check with Aktionsart has been postponed to the 
substitution rules, because of the insertion of an negative element into the 
clause, which takes place in the substitution rules and makes the Aktionsart of 
a clause stative.\\
CONJSENT has been substituted by SENTENCE.\\
Because of this change, the generalisation over the time attributes was no 
longer possible. Therefore, the rule has been split up into 3 subrules.
The place of this rule has been moved to the VERBPPROPformation subgrammar.\\
The adverbial variables are inserted in a
fixed order (generatively): reference, 
retro, duration.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rretrovarinsertion
< m1: VERBPPROP{VERBPPROPrec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [mu3,
                     head/VERB{VERBrec1}
                         [head/SUBVERB{SUBVERBrec1}
                              [I2:head/BVERB(KEY1){BVERBrec1}]
                         ],
                     mu5
                    ],
             I4: mu6,
             I1: mu2
            ] 

  m2: T1 
>

< m : VERBPPROP{VERBPPROPrec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [mu3,
                     head/VERB{VERBrec1}
                         [head/SUBVERB{SUBVERBrec1}
                              [I2:head/BVERB(KEY1){BVERBrec1}]
                         ],
                     mu5
                    ],
             I4: mu6,
             tempadvrel/T1,
             I1: mu2
            ] 
>
   MATCHCONDITIONS
      <
       I1: (QUOTE_tempretronotfound(mu2)) AND
           (QUOTE_tempdurnotfound(mu2)) AND 
           NOT EXIST (mu2, [locadvrel/..])
       I2: (KEY1 <> KEY_willBVERBkey)
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       I4: ALL (mu6, locadvrel/..)
      >

<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1}>
      < T1: ADVPVAR{ADVPVARrec1}>

      COMP
         <
          C1: (ADVPVARrec1.retro = true)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.retro = true)
          A1: @
         >
   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1}>
      < T1: PREPPVAR{PREPPVARrec1}>

      COMP
         <
          C1: (PREPPVARrec1.retro = true)
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.retro = true)
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: (SENTENCEVARrec1.conjretro = true)
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjretro = true)
          A1: @
         >
>
&

\end{verbatim}
