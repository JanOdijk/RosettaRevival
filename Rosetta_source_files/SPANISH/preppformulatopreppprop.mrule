\begin{verbatim}
% RULE rpppsubstitution3       (* PREPP *)
< m1: PREPPFORMULA{PREPPFORMULArec1}
            [ mu1,
              predrel/PREPP{PREPPrec2}
                     [ mu2,
                       objrel/PREPPVAR{PREPPVARrec1},
                       mu3 
                     ]
            ]
  SUBST:
  m2: PREPP{PREPPrec1}[mu4]
>

< m : PREPPFORMULA{PREPPFORMULArec1}
            [ mu1,
              predrel/PREPP{PREPPrec2}
                     [ mu2,
                       objrel/PREPP{PREPPrec3}[mu4],
                       mu3 
                     ]
            ]
>

   MATCHCONDITIONS
      <
       I1: PREPPVARrec1.index = LEVEL
      >


   PARAMETERS
      <
       LEVEL
      >



      COMP
         <
          C1: PREPPVARrec1 = COPYT_prepptovar(PREPPrec1) AND
              PREPPrec1.supertiempo = PREPPFORMULArec1.supertiempo
          A1: PREPPrec3 := PREPPrec1;
              PREPPrec3.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: PREPPrec3.supertiempo = omegatiempo
          A1: PREPPrec1 := PREPPrec3;
              PREPPrec1.supertiempo := PREPPFORMULArec1.supertiempo;
              PREPPVARrec1 := COPYT_prepptovar(PREPPrec3);
              PREPPVARRec1.index := LEVEL;
         >



&

\end{verbatim}
