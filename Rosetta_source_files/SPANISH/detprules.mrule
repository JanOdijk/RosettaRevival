% RULE detpformation1
< m1: DET{DETrec1}[head/I1::BDET{BDETrec1}]
>

< m : DETP{DETPrec1}[head/DET{DETrec1}[head/I1::BDET{BDETrec1}]
                    ]
>

   MATCHCONDITIONS
      <
       I1: BDETrec1.key <> KEY_todoBDETkey
      >

      COMP
         <
          C1: true
          A1: DETPrec1 := 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
         >

      DECOMP
         <
          C1: DETPrec1 = 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
          A1:  @
         >
&

