\begin{verbatim}

% RULE RCNformation1
< m1: NOUN{NOUNrec1}[mu1]
>

< m : CN{CNrec1}[head/NOUN{NOUNrec1}[mu1]
                ]
>

      COMP
         <
          C1: true
          A1: CNrec1 := COPYT_NOUNtoCN(NOUNrec1);
              CNrec1.numbers := NOUNrec1.numbers;
              CNrec1.actsubcs := NOUNrec1.subcs;
              CNrec1.nounpatternefs := NOUNrec1.nounpatterns; 
              (* .req hasn't been determined yet;
                 other attributes have default value *)     
         >

      DECOMP
         <
          C1: (* CNrec1 = COPYT_NOUNtoCN(NOUNrec1) *) 
               CNrec1 = 
                  {                 
                   class:         NOUNrec1.class
                   deixis:        NOUNrec1.deixis
                   aspect:        NOUNrec1.aspect
                   retro:         NOUNrec1.retro
                   genders:       NOUNrec1.genders
                   sexes:         NOUNrec1.sexes
                   temporal:      NOUNrec1.temporal
                   poss:          NOUNrec1.poss
                   animate:       NOUNrec1.animate
                   human:         NOUNrec1.human
                   posscomas:     NOUNrec1.posscomas
                   thetanp:       NOUNrec1.thetanp
                  } AND
              (CNrec1.numbers =  NOUNrec1.numbers) AND
              (CNrec1.actsubcs * NOUNrec1.subcs <> []) AND
              (CNrec1.nounpatternefs * NOUNrec1.nounpatterns <> [] OR 
               NOUNrec1.nounpatterns = []) AND
              (CNrec1.superdeixis = omegadeixis) AND
              (CNrec1.definite       = omegadef) AND
              (CNrec1.cases          = []) 
          A1:  @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] CNformation1
\item[* relevant examples:]
