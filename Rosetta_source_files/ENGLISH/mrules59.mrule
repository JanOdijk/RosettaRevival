ENGLISH 59
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TADJCaseAssignment1

< m1:ADJPFORMULA{ADJPFORMULArec1}
           [ mu1,
             predrel/ADJP{ADJPrec1}
                    [ mu2,
                      rel1/T1,
                      mu3
                    ],
             mu4
           ]
>

< m :ADJPFORMULA{ADJPFORMULArec1}
           [ mu1,
             predrel/ADJP{ADJPrec1}
                    [ mu2,
                      rel1/T2,
                      mu3
                    ],
             mu4
           ]
>


<
   SUBRULE  (* 1 *)
      <T1:NPVAR{NPVARrec1} >
      <T2:NPVAR{NPVARrec2} >

      COMP
         <
          C1: NPVARrec1.cases = []
	      C13: rel1 = objrel
	      A13: NPVARrec2 := NPVARrec1;
	           NPVARrec2.cases := [Accusative]
	      C14: rel1 = indobjrel
	      A14: NPVARrec2 := NPVARrec1;
	           NPVARrec2.cases := [Accusative]
          A1: @
         >
      DECOMP
         <
          C1: true
     	      C13: rel1 = objrel AND
                   Accusative IN NPVARrec2.cases
	      A13: NPVARrec1 := NPVARrec2;
     	      C14: rel1 = indobjrel AND
                   [Accusative] * NPVARrec2.cases <> []
	      A14: NPVARrec1 := NPVARrec2;
          A1: NPVARrec1.cases := []
         >

   SUBRULE  (* 2 *)

      <T1:CNVAR{CNVARrec1} >
      <T2:CNVAR{CNVARrec2} >

      COMP
         <
          C1: CNVARrec1.cases = []
	      C13: rel1 = objrel
	      A13: CNVARrec2 := CNVARrec1;
	           CNVARrec2.cases := [Accusative]
	      C14: rel1 = indobjrel
	      A14: CNVARrec2 := CNVARrec1;
	           CNVARrec2.cases := [Accusative]
          A1: @
         >
      DECOMP
         <
          C1: true
     	      C13: rel1 = objrel AND
                   Accusative IN CNVARrec2.cases
	      A13: CNVARrec1 := CNVARrec2;
     	      C14: rel1 = indobjrel AND
                   [Accusative] * CNVARrec2.cases <> []
	      A14: CNVARrec1 := CNVARrec2;
          A1: CNVARrec1.cases := []
         >

   SUBRULE  (* 3 *)
      <T1:NP{NPrec1}[mu7] >
      <T2:NP{NPrec2}[mu8] >

      COMP
         <
          C1: NPrec1.cases = [] 
              C13: rel1 = objrel
              A13: QUOTE_AssignCase(NPrec1, mu7, NPrec2, mu8, [accusative])
	      C14: rel1 = indobjrel
              A14: QUOTE_AssignCase(NPrec1, mu7, NPrec2, mu8, [accusative])
          A1: @
         >
      DECOMP
         <
          C1: true
     	      C13: rel1 = objrel AND
                   Accusative IN NPrec2.cases
	      A13: @
     	      C14: rel1 = indobjrel AND
                   [Accusative] * NPrec2.cases <> []
	      A14: @
          A1: QUOTE_AssignCase(NPrec2, mu8, NPrec1, mu7, [])
         >
> 
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TADJCaseAssignment1
\item[* relevant examples:]
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
