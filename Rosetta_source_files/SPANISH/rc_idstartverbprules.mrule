        [CLAUSETOSENTENCE/RSUBSTITUTION2{LEVEL:X1 
                                         SUBST:2}
           [IDFORMATION/TIDVPPROPTOCLAUSE
              [VERBPPROPFORMATION/TVERBPATTERN6
                 [VERBPPROPFORMATION/RSTARTVPPROP123
                    [VERBDERIVATION/RBVERBTOSUB
                       [BLEX/BVERB(KEY2)],
                  BLEX/I2:T1,
                  BLEX/NPVAR(X1){NPVARrec1},
                  BLEX/I3:T2
                    ]
                 ]
              ],
            NPFORMATION/RNPFORMATION10
              [CNFORMATION/RCNFORMATION1
                 [CNFORMATION/RSUBNOUNTONOUN2{numberpar:singular}
                    [NPDERIVATION/BNOUNTOSUBNOUN
                       [BLEX/BNOUN(KEY3)]
                    ]
                 ]
              ]
           ]
        ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBREC1.thetavp = vp123
