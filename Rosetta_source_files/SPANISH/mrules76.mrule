\newpage
\begin{verbatim}

% RULE RCNformation1
< m1: NOUN{NOUNrec1}[mu1]
>

< m : CN{CNrec1}[head/NOUN{NOUNrec1}[mu1]
                ]
>

      COMP
         <
          C1: true
          A1: CNrec1 := COPYT_NOUNtoCN(NOUNrec1);
              CNrec1.numero := NOUNrec1.numero;
              CNrec1.actsubcs := NOUNrec1.subcs;
              CNrec1.nounpatternefs := NOUNrec1.nounpatterns; 
              (* .req hasn't been determined yet;
                 .superdeixis/.definite have default value *)     
         >

      DECOMP
         <
          C1: (CNrec1 = COPYT_NOUNtoCN(NOUNrec1)) AND
              (CNrec1.numero =  NOUNrec1.numero) AND
              (CNrec1.actsubcs * NOUNrec1.subcs <> []) AND
              (CNrec1.nounpatternefs * NOUNrec1.nounpatterns <> []) AND
              (CNrec1.supertiempo = omegatiempo) AND
              (CNrec1.definite       = omegadef) AND
              (CNrec1.cases          = []) 
          A1:  @
         >
&

\end{verbatim}
