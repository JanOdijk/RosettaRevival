\begin{verbatim}
% RULE RVPRelMarking
< m1: CLAUSE{CLAUSErec1}
            [ mu1, 
              predrel/VERBP{VERBPrec1}
                     [ mu2, 
                       I1:rel1/T1, 
                       mu3
                     ], 
              mu4 
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              predrel/VERBP{VERBPrec1}
                     [ mu2, 
                       I2:rel1/T2, 
                       mu3
                     ], 
              mu4 
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, PREPPVAR, ADVPVAR] 
                     WITH T1.REC.index = indexpar
       I2: T2.CAT IN [NPVAR, PREPPVAR, ADVPVAR] 
                     WITH T2.REC.mood IN [relativexpmood, topicmood]
      >

   PARAMETERS
      <
       indexpar   : indextype
       xpmoodpar  : xpmoodtype
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1} >
      < T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: [NPVARrec1.NPhead] * [itNP] = [] AND
              NPVARrec1.mood = nowh AND
              xpmoodpar IN [relativexpmood, topicmood]
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.mood := xpmoodpar
         >

      DECOMP
         <
          C1: [NPVARrec1.NPhead] * [itNP] = [] 
            C11: NPVARrec2.mood = relativexpmood
            A11: @
            C12: NPVARrec2.mood = topicmood
            A12: WBONUS -10;
                 @
          A1: indexpar  := NPVARrec2.index; 
              xpmoodpar := NPVARrec2.mood;
              NPVARrec1 := NPVARrec2;
              NPVARrec1.mood := nowh
         >

   SUBRULE (* 2. PREPPVAR *)
      < T1: PREPPVAR{PREPPVARrec1} >
      < T2: PREPPVAR{PREPPVARrec2} >

      COMP
         <
          C1: true 
            C11: PREPPVARrec1.mood = relativexpmood AND
                 xpmoodpar = relativexpmood
            A11: @
            C12: PREPPVARrec1.mood = nowh AND
                 xpmoodpar = relativexpmood
            A12: @
            C13: PREPPVARrec1.mood = nowh AND
                 xpmoodpar = topicmood
            A13: @
          A1: PREPPVARrec2 := PREPPVARrec1;
              PREPPVARrec2.mood := xpmoodpar
         >

      DECOMP
         <
          C1: true
            C11: PREPPVARrec2.mood = relativexpmood
            A11: PREPPVARrec1 := PREPPVARrec2;
            C12: PREPPVARrec2.mood = relativexpmood
            A12: PREPPVARrec1 := PREPPVARrec2;
                 PREPPVARrec1.mood := nowh;
            C13: PREPPVARrec2.mood = topicmood
            A13: WBONUS -1;
                 PREPPVARrec1 := PREPPVARrec2;
                 PREPPVARrec1.mood := nowh;
          A1: indexpar  := PREPPVARrec2.index; 
              xpmoodpar := PREPPVARrec2.mood;
         >

   SUBRULE (* 3. ADVPVAR *)
      < T1: ADVPVAR{ADVPVARrec1} >
      < T2: ADVPVAR{ADVPVARrec2} >

      COMP
         <
          C1: ADVPVARrec1.mood = nowh AND
              xpmoodpar IN [relativexpmood, topicmood] 
          A1: ADVPVARrec2 := ADVPVARrec1;
              ADVPVARrec2.mood := xpmoodpar;
         >

      DECOMP
         <
          C1: true
            C11: ADVPVARrec2.mood = relativexpmood
            A11: @
            C12: ADVPVARrec2.mood = topicmood
            A12: WBONUS -1;
                 @
          A1: indexpar  := ADVPVARrec2.index; 
              xpmoodpar := ADVPVARrec2.mood;
              ADVPVARrec1 := ADVPVARrec2;
              ADVPVARrec1.mood := nowh;
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RVPRelMarking
\item[* relevant examples:] \mbox{}\\
NPVAR: (I gave him a book) he already had x1=which; she gave x1=her father a 
book ($\rightarrow$ Her father she gave a book, and her mother a watch)\\
PREPPVAR: (the hammer) he hit him x1=with which (it is assumed that instradvs
(and manner advs) are within the VP, together with vpadvs). For comment on the 
two subrules for relatives, see RSRelMarking\\
ADVPVAR: perhaps topic: you should do it x1=thus (Thus you should do it); but 
probably non-occurrent; (see remarks in previous rule, 
RSRelMarking; note that there is no CN/NPVAR in the ADVP, so it will be hard to 
make a relative adverb without analysing it as a PREPP first)
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
