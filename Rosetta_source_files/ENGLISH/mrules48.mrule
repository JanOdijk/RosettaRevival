\begin{verbatim}
% TRANSFORMATION TVerbpattern3

< m1: I1::VERBPPROP{VERBPPROPrec1}
                    [mu1,
                     predrel/VERBP{VERBPrec1}
                            [head/VERB{VERBrec1}[mu2], 
                             argrel/T1
                            ] 
                    ]
>

< m : VERBPPROP{VERBPPROPrec2}
                [mu1,
                 I2:predrel/VERBP{VERBPrec1}
                            [head/VERB{VERBrec1}[mu2], 
                             I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                          [head/PREP(VERBrec1.prepkey1)
                                                             {PREPrec1}, 
                                           objrel/T1
                                          ]
                            ] 
                ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR 
                   [headkey, actsubcefs, synppefs, mood, thetapp,
                    specQ, retro, aspect, deixis, class] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key 
                            retro      : PREPrec1.retro
                            aspect     : PREPrec1.aspect
                            deixis     : PREPrec1.deixis
                            class      : PREPrec1.class } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >

<
   SUBRULE (* 1a. x1 count on x2 *)
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synPREPNP IN VERBrec1.synvps AND
              NPVARrec1.NPhead <> openIngNP
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : NPVARrec1.mood
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPNP IN VERBPPROPrec2.synvpefs AND
              synPREPNP IN VERBrec1.synvps AND
              NPVARrec1.NPhead <> OpenIngNP AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec1.mood 
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. x1 count on x2 *)
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: synPREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : relativexpmood
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPNP IN VERBPPROPrec2.synvpefs AND
              synPREPNP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : relativexpmood
                               specQ     : yesspec
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2a. ? *)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synPREPCLOSEDNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPCLOSEDNPPROP];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPCLOSEDNPPROP IN VERBPPROPrec2.synvpefs AND
              synPREPCLOSEDNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = false AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b1. x1 serve as/come across as x2 *)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synPREPOPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPOPENNPPROP];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPOPENNPPROP IN VERBPPROPrec2.synvpefs AND
              synPREPOPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b2. x1 amounts to x2 *)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synPREPMEASUREPHRASE IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPMEASUREPHRASE];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPMEASUREPHRASE IN VERBPPROPrec2.synvpefs AND
              synPREPMEASUREPHRASE IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 3a. x1 count on x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synPREPCLOSEDGERUND IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : accing        
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPCLOSEDGERUND];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPCLOSEDGERUND IN VERBPPROPrec2.synvpefs AND
              synPREPCLOSEDGERUND IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : accing        
                                }(*not all attributes*)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 3b. x1 count on x2 *)
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synPREPOPENGERUND IN VERBrec1.synvps AND
              NPVARrec1.NPhead = openIngNP
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPOPENGERUND];
              VARPREPPrec1 := { synppefs   : [synOPENGERUND]
                                mood       : nowh
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPOPENGERUND IN VERBPPROPrec2.synvpefs AND
              synPREPOPENGERUND IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synOPENGERUND 
                               mood      : nowh 
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 } AND
              NPVARrec1.NPhead = openIngNP
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 4. x1 count on x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synPREPCLOSEDTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : toinf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPCLOSEDTOSENT];
              VARPREPPrec1 := { synppefs   : [synCLOSEDTOSENT]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPCLOSEDTOSENT IN VERBPPROPrec2.synvpefs AND
              synPREPCLOSEDTOSENT IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synCLOSEDTOSENT 
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : toinf
                                }(*not all attributes*)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 5. ? *)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synPREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPCLOSEDADJPPROP];
              VARPREPPrec1 := { synppefs   : [synCLOSEDADJPPROP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPCLOSEDADJPPROP IN VERBPPROPrec2.synvpefs AND
              synPREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synCLOSEDADJPPROP 
                               mood      : nowh
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 6. x1 talk about x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synPREPQSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
              SENTENCEVARrec1.mood IN [yesnointerrogative, whinterrogative]
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPQSENT];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPQSENT IN VERBPPROPrec2.synvpefs AND
              synPREPQSENT IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              SENTENCEVARrec1.senttype = subordinateclause AND
              SENTENCEVARrec1.mood IN [yesnointerrogative, whinterrogative]
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 7. ? *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synPREPOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPOTHERCLOSEDPREPPPROP];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPOTHERCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs 
              AND
              synPREPOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

    SUBRULE (* 8. x1 count on x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synPREPTHATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  PROsubject : false
                                  finiteness : finite }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPTHATSENT];
              VARPREPPrec1 := { synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs 
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPTHATSENT IN VERBPPROPrec2.synvpefs AND
              synPREPTHATSENT IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : nowh
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  PROsubject : false
                                  finiteness : finite }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* language:] English
\item[* name:] TVerbpattern3
\item[* kind of rule:] M-rule
\item[* subgrammar:] verbppropformation
\item[* class:] TC: Verbpatternrules
\item[* date of creation:] 12-DEC-1986 11:57:15  
\item[* author:] Agnes Mijnhout, margreet sanders
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 31/08/88\ \ \ \ \ author: margreet sanders, Jan Odijk: added: specQ
, aspect, deixis, class and retro. For comment see Verbpattern 6.
\item date: 01/06/90\ \ \ \ \ author: Petra de Wit
added subrule 2b1 (For comment see below)
\end{enumerate}
\item[* task:] Checks whether the category of the variable is compatible with 
the category of the variable that the verb expects. These subrules are for 
prepositional verbs. The preposition is introduced syncategorematically.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] Each subrule 
handles a specific value of the attribute synvps.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] 
\item[\  \ suggested semantics:] none
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ value(s) for the attributes synvps(verbs) and synpps(preps)
in the dictionary. It is also assumed that prepositions have a wide range of 
possible synpps (perhaps the total set of possible patterns?), which they pass 
on to the PREPP.synppefs. In the auxdomain, a 
set of possible patterns resulting in a surface direct object must be defined.
\item rules:\\ these transformations follow the startrules.

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc.\ nr.\ 108 (Verbpatterns in Rosetta3) 
and doc.\ nr.\ 144 (Longman's grammatical codes for verbs).
\item[* relevant examples:] \mbox{}
\begin{description}
\item [subrule 1a/b] PREPNP/CN\\
\ \ (vp120): x1 count (up)on x2 (I count (up)on John; upon his finishing the 
job)
\item [subrule 2a] PREPCLOSEDNPPROP\\
\ \ (vp120): ? (originally for `regard as')
\item [subrule 2b1] PREPOPENNPPROP\\
\ \ (vp120): x1 come across as x2 (He comes across as a nice person)\\
Or is this an ergative verb (vp012) ?
\item [subrule 2b2] PREPMEASUREPHRASE\\
\ \ (vp120): x1 amount to x2 (His debts amount to $5000)
\item [subrule 3a] PREPCLOSEDGERUND\\
\ \ (vp120): x1 count on x2 (You can't count on the weather being fine)
\item [subrule 3b] PREPOPENGERUND\\
\ \ (vp120): x1 hesitate about x2 (I'm hesitating about joining the expedition)
\item [subrule 4] PREPCLOSEDTOSENT\\
\ \ (vp120): x1 count on x2 (I count on you to help)
\item [subrule 5] PREPCLOSEDADJPPROP\\
\ \ (vp120): ? (originally for `regard as')
\item [subrule 6] PREPQSENT\\
\ \ (vp120): x1 talk about x2 (We all talked about how to prevent an accident 
(from) happening; - why he would have murdered her; - whether we should all 
leave early)\\
\ \ (vp120): x1 hesitate about x2 (I'm hesitating about what to do next)\\
\ \ (vp120): x1 hesitate over x2 (I'm hesitating over whether to join the 
expedition)
\item [subrule 7] PREPOTHERCLOSEDPREPPPROP\\
\ \ (vp120): ? (originally for `regard as')
\item [subrule 8] PREPTHATSENT\\
\ \ (vp120): x1 count on x2 (I count on it that you'll be there)
\end{description}
\item[\ \ remarks:]\mbox{} 
\begin{enumerate}
\item real remarks: The verb `regard as' is now considered a 3-place verb, thus 
making subrules 2a, 5 and 7 superfluous.
\item problems:\\
For the moment it is assumed that a PREPTHATSENT will be extraposed in a later 
rule, 
after which the bperspro `it' is inserted. Verbs which allow this 
construction should have the synvp [PREPTHATSENT] ({\em I count on it that 
you'll be there\/}). \\
When no extraposition takes place, the prep cannot be realised.
Verbs allowing this construction should have a [THATSENT] synvp. ({\em I 
hope that you'll be there - I hope for it\/}). (Note that these verbs have 
already been dealt with in TVerbpattern1, where no check on any obligatory PREP 
was performed for verbs taking a THATSENT as argument). \\
Verbs taking both these 
constructions must have both synvps: {\em I insist (on it) that you'll be there
\/}. Verbs taking both these constructions but in a different meaning should be 
separated: {\em object to it that = er tegen zijn dat: [synPREPTHATSENT]; object 
that = tegenwerpen dat: [synTHATSENT]\/}.\\
Note that it is assumed that the PREP has [THATSENT] in its preppatterns, even 
though the sequence PREP - THATSENT will never occur because of extraposition.
\\
Finally note that this kind of problem also occurs for verbalised adjectives: 
be proud that - be proud of; be concerned about - be concerned that.

\item modifications:\\

\end{enumerate}
\end{description}

