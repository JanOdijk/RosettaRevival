\newpage
\begin{verbatim}

% TRANSFORMATION TADJQPhopping1          (* long enough *)

< m1:  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [mu2,
                       degreemodrel/QP{QPrec1}
                                    [I1:mu3],
                       head/ADJ{ADJrec1}[mu5],
                       mu6
                      ],
                 mu7
                ]
>

< m :  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [mu2,
                       head/ADJ{ADJrec1}[mu5],
                       hoprel/QP{QPrec1}[mu3],
                       mu6
                      ],
                 mu7
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3, [degreemodrel/..])
      >

      COMP
         <
          C1: QPrec1.hop = true  
          A1: @
         >
      DECOMP
         <
          C1: QPrec1.hop = true  
          A1: @
         >


&

\end{verbatim}
