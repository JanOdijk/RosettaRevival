 *                    LDSUCC_FirstItems.
 *
 *EMP:::===================================================================*)



(*=========================================================================*
 *  Imported modules
 *=========================================================================*)



PACKAGE LDSUCC;




(*MPC:::===================================================================*
 *
 *  Constant name  : LDSUCC_FirstAffix, LDSUCC_TrailerAffix
 *  Description    : First and last node of the reg. expr. graph
 *
 *EMP:::===================================================================*)

CONST
   LDSUCC_FirstAffix = MAXINT;
   LDSUCC_TrailerAffix = -MAXINT;


(*MPT:::===================================================================*
 *
 *  Type name      : LDSUCC_pItemType
 *  Description    : An item contains a unique id of one node in the reg.
 *                   expression.
 *
 *EMP:::===================================================================*)

TYPE
   LDSUCC_pItemType = ^LDSUCC_ItemType;
   LDSUCC_ItemType  = RECORD
                         afxkey,
                         afxnode : INTEGER;
                         nxt     : LDSUCC_pItemType
                      END;


(*MPT:::===================================================================*
 *
 *  Type name      : LDSUCC_ItemSetType
 *  Description    : Implementation of a set of items
 *
 *EMP:::===================================================================*)

TYPE
   LDSUCC_ItemSetType = RECORD
                           first,
                           last  : LDSUCC_pItemType
                        END;



PROCEDURE LDSUCC_INITSETOFItems(VAR items:LDSUCC_ItemSetType);
EXTERNAL;

FUNCTION LDSUCC_STILLItems(items:LDSUCC_ItemSetType): BOOLEAN;
EXTERNAL;

PROCEDURE LDSUCC_APPENDItem(afx, afxid: INTEGER; 
                         VAR items:LDSUCC_ItemSetType);
EXTERNAL;

PROCEDURE LDSUCC_TAKEItem(VAR afx, afxid: INTEGER; 
                         VAR items:LDSUCC_ItemSetType);
EXTERNAL;

FUNCTION LDSUCC_UNIONItems(items1, items2: LDSUCC_ItemSetType):
                         LDSUCC_ItemSetType;
EXTERNAL;

FUNCTION LDSUCC_Succ(afx: INTEGER): LDSUCC_ItemSetType;
EXTERNAL;

PROCEDURE LDSUCC_ReduceItems(afx: INTEGER; S1: LDSUCC_ItemSetType;
                             VAR S2: LDSUCC_ItemSetType); 
EXTERNAL;

PROCEDURE LDSUCC_PredictItems(S1: LDSUCC_ItemSetType;
                       VAR S2: LDSUCC_ItemSetType); 
EXTERNAL;

PROCEDURE LDSUCC_Init; 
EXTERNAL;

FUNCTION LDSUCC_FirstItems: LDSUCC_ItemSetType;
EXTERNAL;

END {LDSUCC};
