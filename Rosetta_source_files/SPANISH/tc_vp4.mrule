         >

   SUBRULE (*3b*)
      <T1:CNVAR{CNVARrec1}
       T2:EMPTYVAR{EMPTYVARrec2}>

      <T1:CNVAR{CNVARrec1}
       T2:EMPTYVAR{EMPTYVARrec2}>

      COMP
         <
          C1: synPREPNP_PREPEMPTY IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_PREPEMPTY];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
