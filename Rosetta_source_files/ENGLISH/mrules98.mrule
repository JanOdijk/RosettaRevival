\newpage
\begin{verbatim}
% RULE RSentIdent
< m1: I1::SENTENCEVAR{SENTENCEVARrec1}
  m2: I2::NPVAR{NPVARrec1}
>

< m : NPPROP{NPPROPrec1}
            [ subjrel/I2::NPVAR{NPVARrec1},
              idrel/I1::SENTENCEVAR{SENTENCEVARrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCEVARrec1.senttype = subordinateclause AND
           ( SENTENCEVARrec1.mood IN 
             [declarative, whinterrogative, yesnointerrogative] ) AND
           SENTENCEVARrec1.infsort <> inf
       I2: NPVARrec1.definite = def
      >

      COMP
         <
          C1: true
          A1: NPPROPrec1.aktionsarts := [stative]
              (* rest of NPPROP remains default *)
         >
      DECOMP
         <
          C1: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts] AND
              NPPROPrec1.aktionsarts = [stative]
          A1: @
         >
&

\end{verbatim}
