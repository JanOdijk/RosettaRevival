\newpage
\begin{verbatim}
% RULE RPPSRelMarking
< m1: CLAUSE{CLAUSErec1}
            [ mu1, 
              rel2/T3,
              mu4 
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              rel2/T4,
              mu4 
            ]
>

   PARAMETERS
      <
       indexpar   :keytype
      >

<
   SUBRULE (* 1. VARPREPP *)
      < T3: VARPREPP{VARPREPPrec1}
                    [ mu2, 
                      I1:rel1/NPVAR{NPVARrec1},
                      mu3
                    ] >
      < T4: VARPREPP{VARPREPPrec2}
                    [ mu2, 
                      I2:rel1/NPVAR{NPVARrec2},
                      mu3
                    ] >

   MATCHCONDITIONS
      <
       I1: NPVARrec1.index = indexpar
       I2: NPVARrec2.mood = relativexpmood
      >

      COMP
         <
          C1: NPVARrec1.mood = nowh AND
              VARPREPPrec1.mood = nowh
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.mood := relativexpmood; 
              VARPREPPrec2 := VARPREPPrec1;
              VARPREPPrec2.mood := relativexpmood;
         >
      DECOMP
         <
          C1: VARPREPPrec2.mood = relativexpmood
          A1: indexpar := NPVARrec2.index; 
              NPVARrec1 := NPVARrec2;
              NPVARrec1.mood := nowh;
              VARPREPPrec1 := VARPREPPrec2;
              VARPREPPrec1.mood := nowh
         >

   SUBRULE (* 2. PREPP *)
      < T3: PREPP{PREPPrec1}
                 [ mu2, 
                   I1:rel1/NPVAR{NPVARrec1},
                   mu3
                 ] >
      < T4: PREPP{PREPPrec2}
                 [ mu2, 
                   I2:rel1/NPVAR{NPVARrec2},
                   mu3
                 ] >

   MATCHCONDITIONS
      <
       I1: NPVARrec1.index = indexpar
       I2: NPVARrec2.mood = relativexpmood
      >

      COMP
         <
          C1: NPVARrec1.mood = nowh AND
              PREPPrec1.mood = nowh
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.mood := relativexpmood; 
              PREPPrec2 := PREPPrec1;
              PREPPrec2.mood := relativexpmood;
         >
      DECOMP
         <
          C1: PREPPrec2.mood = relativexpmood
          A1: indexpar := NPVARrec2.index; 
              NPVARrec1 := NPVARrec2;
              NPVARrec1.mood := nowh;
              PREPPrec1 := PREPPrec2;
              PREPPrec1.mood := nowh
         >
>
&

\end{verbatim}
