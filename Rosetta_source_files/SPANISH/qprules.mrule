\newpage
\begin{verbatim}
% RULE RQPCOMPARATIVEcomplmod1 (* NB decomplrel, ondanks thanas-value *)

< m1: QP{QPrec1}[head/Q{Qrec1}]
  m2: T1
>

< m : QP{QPrec1}[head/Q{Qrec1},
                     decomplrel/PREPP{PREPPrec1}
                           [head/PREP(KEY_dePREPkey){PREPrec1},
                            I2:complrel/T2
                           ]
                    ]

>


   MATCHCONDITIONS
      <m1: QPrec1.thanas = quecompl
       m: QPrec1.thanas = quecompl 
       I2: (T2.cat IN [ NPVAR, CNVAR] WITH T2.REC.cases = []) OR
           (T2.cat IN [QP, DETP] )
       m2: T1.cat IN [ NPVAR, CNVAR, QP, DETP]
      >
<

   SUBRULE (* 1: QP *)
      <T1: QP{QPrec3}[mu1] >
      <t2: QP{QPrec4}[mu1] >

      COMP
         <
          C1: QPrec3.supertiempo = QPrec1.supertiempo
          A1: QPrec4 := QPrec3;
              QPrec4.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: QPrec4.supertiempo = omegatiempo
          A1: QPrec3 := QPrec4;
              QPrec3.supertiempo := QPrec1.supertiempo;
         >

   SUBRULE (* 2 NPVAR *)
      <T1: NPVAR{NPVARrec1}>
      <t2: NPVAR{NPVARrec2}>


      COMP
         <
          C1: NPVARrec1.supertiempo = QPrec1.supertiempo AND
              NPVARrec1.definite = indef
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.supertiempo := omegatiempo;
         >

      DECOMP
         <
          C1: NPVARrec2.supertiempo = omegatiempo AND
              NPVARrec2.definite =  indef 
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.supertiempo := QPrec1.supertiempo;
         >

   SUBRULE (* 3 CNVAR *)
      <T1: CNVAR{CNVARrec1}>
      <T2: CNVAR{CNVARrec2}>

      COMP
         <
          C1: CNVARrec1.supertiempo = QPrec1.supertiempo 
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: CNVARrec2.supertiempo = omegatiempo 
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.supertiempo := QPrec1.supertiempo;
         >

SUBRULE (* 7 *) (* menos de tres ; provisional account to be replaced by
                   a rule that modifies a NUM that is the head of DETP (within
                   subgrammar DETPformation)  *)

      <T1: DETP{DETPrec1}[mu9]>
      <T2: DETP{DETPrec2}[mu9]>
 
      COMP
         <
          C1: DETPrec1.supertiempo = QPrec1.supertiempo AND
              DETPrec1.definite = indef
          A1: DETPrec2 := DETPrec1;
              DETPrec2.supertiempo := omegatiempo ;
         >
      DECOMP
         <
          C1: DETPrec2.supertiempo = omegatiempo AND
              DETPrec2.definite = indef
          A1: DETPrec1 := DETPrec2;
              DETPrec1.supertiempo := QPrec1.supertiempo;
         >
>
&

\end{verbatim}
