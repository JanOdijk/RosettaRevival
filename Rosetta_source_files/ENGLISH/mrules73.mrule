                                           mu9
                                          ],
            mu3
           ]
>


   MATCHCONDITIONS
      <
       I1: (SENTENCErec1.adverbial = true) AND
           (SENTENCErec1.temporal = true) AND
           (SENTENCErec1.conjclass IN [duration, frequential] OR
            (SENTENCErec1.conjclass = reference AND
             SENTENCERec1.conjretro = true
