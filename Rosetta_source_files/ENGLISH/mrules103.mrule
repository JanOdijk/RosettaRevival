ENGLISH 103
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TprogbeTobe1
< m1:SENTENCE{SENTENCErec1}
            [ mu1,
              auxrel/VERB{VERBrec1}
                    [head/SUBVERB{SUBVERBrec1}
                       [ head/BVERB(KEY_progbeBVERBkey){BVERBrec1}] 
                    ], 
              mu2,
              predrel/VERBP{VERBPrec1}
                   [ complrel/SENTENCE{SENTENCErec2}
                         [ predrel/VERBP{VERBPrec2}
                                 [ I3:mu3,
                                   rel1/VERB{VERBrec2}[mu4],
                                   mu5 
                                 ]
                         ]
                   ],
              mu6
            ]
               
>

< m :SENTENCE{SENTENCErec1'}
            [ mu1,
              auxrel/VERB{VERBrec3}
                    [head/SUBVERB{SUBVERBrec3}
                       [ head/BVERB(KEY_beBVERBkey){BVERBrec3}] 
                    ],
              mu2,
              predrel/VERBP{VERBPrec1}
                     [ I3:mu3,
                       rel1/VERB{VERBrec2}[mu4],
                       mu5 
                     ],
              mu6
            ]
     
>

   MATCHCONDITIONS
      <
       I3: NOT EXIST(mu3,[../VERB{}[mu7]])
      >



      COMP
         <
          C1: VERBrec2.modus = ingform AND
              VERBrec1 = COPYT_SUBVERBtoVERB(SUBVERBrec1) AND
              SUBVERBrec1 = COPYT_BVERBtoSUBVERB(BVERBrec1) AND
              SENTENCErec2.aktionsarts * [achievement] = [] AND
              SENTENCErec2.aktionsarts <> [stative] AND
              SENTENCErec2 =
                 {
                   mood:              declarative
                   senttype:          subordinateclause
                   superdeixis:       omegadeixis
                   PROsubject:        false
                   modus:             ingform
                   aspect:            omegaaspect
                   deixis:            omegadeixis 
                   retro:             false
                   finiteness:        infinite
                   infsort:           accing
                   conjkey:           0
                   adverbial:         false 
                   temporal:          false
                   conjclass:         omegatimeadvclass
                   conjdeixis:        omegadeixis 
                   conjaspect:        omegaaspect 
                   conjretro:         false       
                   coord:             nocoord     
                 }                                         AND
              SENTENCErec1 =
                 {
                   voice:             active
                   synvpefs:          [synCLOSEDGERUND]
                   thetavp:           vp010
                   adjuncts:          []
                   aktionsarts:       [stative]
                 }       
          A1: SUBVERBrec3 := COPYT_BVERBtoSUBVERB(BVERBrec3);
              VERBrec3    := COPYT_SUBVERBtoVERB(SUBVERBrec3);
              SUBVERBrec3.affix := SUBVERBrec1.affix;
              VERBrec3    :=
                 {
                  modus     : VERBrec1.modus
                  tense     : VERBrec1.tense
                  persons   : VERBrec1.persons
                  numbers   : VERBrec1.numbers
                 };
              SENTENCErec1' := SENTENCErec1;
              SENTENCErec1' := 
                 {
                   voice:             SENTENCErec2.voice
                   synvpefs:          SENTENCErec2.synvpefs
                   thetavp:           SENTENCErec2.thetavp
                   adjuncts:          SENTENCErec2.adjuncts
                   aktionsarts:       SENTENCErec2.aktionsarts
                 };
         >
      DECOMP
         <
          C1: VERBrec2.modus = ingform   AND
              SUBVERBrec3 = COPYT_BVERBtoSUBVERB(BVERBrec3) AND
              VERBrec3    = COPYT_SUBVERBtoVERB(SUBVERBrec3) AND
              SENTENCErec1'.aktionsarts * [achievement] = [] AND
              SENTENCErec1'.aktionsarts <> [stative]
          A1: WBONUS -1
              SUBVERBrec1 := COPYT_BVERBtoSUBVERB(BVERBrec1);   
              VERBrec1    := COPYT_SUBVERBtoVERB(SUBVERBrec1);
              SUBVERBrec1.affix := SUBVERBrec3.affix;
              VERBrec1    :=
                 {
                  modus     : VERBrec3.modus
                  tense     : VERBrec3.tense
                  persons   : VERBrec3.persons
                  numbers   : VERBrec3.numbers
                 };
              SENTENCErec2 :=
                 {
                   mood:              declarative
                   senttype:          subordinateclause
                   PROsubject:        false
                   superdeixis:       omegadeixis
                   modus:             ingform
                   aspect:            omegaaspect
                   deixis:            omegadeixis 
                   retro:             false
                   finiteness:        infinite
                   infsort:           accing
                   conjkey:           0
                   adverbial:         false 
                   temporal:          false
                   conjclass:         omegatimeadvclass
                   conjdeixis:        omegadeixis 
                   conjaspect:        omegaaspect 
                   conjretro:         false       
                   coord:             nocoord     
                 };                                         
              SENTENCErec2 := 
                 {
                   voice:             SENTENCErec1'.voice
                   synvpefs:          SENTENCErec1'.synvpefs
                   thetavp:           SENTENCErec1'.thetavp
                   adjuncts:          SENTENCErec1'.adjuncts
                   aktionsarts:       SENTENCErec1'.aktionsarts
                 };
              SENTENCErec1 := SENTENCErec1';
              SENTENCErec1 :=
                 {
                   voice:             active
                   synvpefs:          [synCLOSEDGERUND]
                   thetavp:           vp010
                   adjuncts:          []
                   aktionsarts:       [stative]
                 };       
               
         >

&

\end{verbatim}
