% TRANSFORMATION Tsuperdeixisadaptation6
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    predrel/ADJP{ADJPrec1}
                              [mu5,
                               I1: rel1/T1,
                               mu6], 
                    mu3
                   ],
            mu4
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2, 
                    predrel/ADJP{ADJPrec1}
                              [mu5,
                               I2: rel1/T2,
                               mu6], 
                    mu3
                   ],
            mu4
           ]

>
   MATCHCONDITIONS
      <
       I1: (T1.CAT IN [ADVP, PREPP, NP, QP] AND
            rel1 IN [degreemodrel, paraobjrel])
           OR 
           (T1.CAT IN [SENTENCE] AND
            rel1 IN AUX_sentencerels)
       I2: (T2.CAT IN [ADVP, PREPP, NP, QP] AND
            rel1 IN [degreemodrel, paraobjrel])
           OR 
           (T2.CAT IN [SENTENCE] AND
            rel1 IN AUX_sentencerels)
      >


<
   SUBRULE
      < T1: ADVP{ADVPrec1}[mu7] >
      < T2: ADVP{ADVPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (ADVPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = presente)
                   )
                  )
             A12: ADVPrec2:= ADVPrec1;
                  ADVPrec2.supertiempo := omegatiempo;

             C12:(ADVPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: ADVPrec2:= ADVPrec1;
                   ADVPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(ADVPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: ADVPrec1:= ADVPrec2;
                   ADVPrec1.supertiempo := presente;
            
              C12: (ADVPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )                    
               A12: ADVPrec1 := ADVPrec2;
                    ADVPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE
      < T1: PREPP{PREPPrec1}[mu7] >
      < T2: PREPP{PREPPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (PREPPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: PREPPrec2:= PREPPrec1;
                  PREPPrec2.supertiempo := omegatiempo;

             C12:(PREPPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )
              A12: PREPPrec2:= PREPPrec1;
                   PREPPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(PREPPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: PREPPrec1:= PREPPrec2;
                   PREPPrec1.supertiempo := presente;
            
              C12: (PREPPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )                    
               A12: PREPPrec1 := PREPPrec2;
                    PREPPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE
      < T1: NP{NPrec1}[mu7] >
      < T2: NP{NPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (NPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: NPrec2:= NPrec1;
                  NPrec2.supertiempo := omegatiempo;

             C12:(NPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )
              A12: NPrec2:= NPrec1;
                   NPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(NPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: NPrec1:= NPrec2;
                   NPrec1.supertiempo := presente;
            
              C12: (NPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )                    
               A12: NPrec1 := NPrec2;
                    NPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE
      < T1: QP{QPrec1}[mu7] >
      < T2: QP{QPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (QPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: QPrec2:= QPrec1;
                  QPrec2.supertiempo := omegatiempo;

             C12:(QPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )
              A12: QPrec2:= QPrec1;
                   QPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(QPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: QPrec1:= QPrec2;
                   QPrec1.supertiempo := presente;
            
              C12: (QPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )                    
               A12: QPrec1 := QPrec2;
                    QPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 5. SENTENCE *)
      < T1: SENTENCE{SENTENCErec1}[mu7] >
      < T2: SENTENCE{SENTENCErec2}[mu7] >

      COMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec1.supertiempo = omegatiempo) AND
                  (((SENTENCErec1.tiempo = presente) AND
                    (CLAUSErec1.tiempo <> presente) AND
                    (CLAUSErec1.supertiempo <> presente) 
                   ) OR
                   ((SENTENCErec1.tiempo = pasado) AND
                    ((QUOTE_temprefnotfound(mu7)) AND
                     (CLAUSErec1.tiempo <> pasado) AND
                     (CLAUSErec1.supertiempo <> pasado)
                    ) OR
                    (NOT (QUOTE_temprefnotfound(mu7))
                    )
                   )
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

                  (* dependent clause present *)
             C12: (SENTENCErec1.supertiempo = presente) AND
                  (SENTENCErec1.tiempo = omegatiempo) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = presente)
                   )
                  )

                 C121: (SENTENCErec1.finiteness = finite)
                 A121: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.tiempo := presente;

                 C122: (SENTENCErec1.finiteness = infinite)
                 A122: SENTENCErec2 := SENTENCErec1;

             A12: SENTENCErec2.supertiempo := omegatiempo;

                  (* dependent clause past *)
             C13: (SENTENCErec1.tiempo = omegatiempo) AND
                  (SENTENCErec1.supertiempo = pasado) AND
                   (
                    (
                     (CLAUSErec1.tiempo = pasado) AND
                     (CLAUSErec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = pasado)
                    )
                   )

                 C131: (SENTENCErec1.finiteness = finite)
                 A131: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.tiempo := pasado;

                 C132: (SENTENCErec1.finiteness = infinite)
                 A132: SENTENCErec2 := SENTENCErec1;

             A13: SENTENCErec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec2.supertiempo = omegatiempo) AND
                  (((SENTENCErec2.tiempo = presente) AND
                    (CLAUSErec1.tiempo <> presente) AND
                    (CLAUSErec1.supertiempo <> presente) 
                   ) OR
                   ((SENTENCErec2.tiempo = pasado) AND
                    ((QUOTE_temprefnotfound(mu7)) AND
                     (CLAUSErec1.tiempo <> pasado) AND
                     (CLAUSErec1.supertiempo <> pasado)
                    ) OR
                    (NOT (QUOTE_temprefnotfound(mu7))
                    )
                   )
                  )
                 )
             A11: SENTENCErec1 := SENTENCErec2;

                 (* dependent clause present *)
             C12:(SENTENCErec2.supertiempo = omegatiempo) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = presente)
                   )
                  )

                 C121: (SENTENCErec2.tiempo = presente) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.tiempo := omegatiempo;

                 C122: (SENTENCErec2.tiempo = omegatiempo) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.supertiempo := presente;

                  (* dependent clause past *)
              C13:(SENTENCErec2.supertiempo = omegatiempo) AND
                   (
                    (
                     (CLAUSErec1.tiempo = pasado) AND
                     (CLAUSErec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = pasado)
                    )
                   )

                 C131: (SENTENCErec2.tiempo = pasado) AND
                       (SENTENCErec2.finiteness = finite)
                 A131: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.tiempo := omegatiempo;

                 C132: (SENTENCErec2.tiempo = omegatiempo) AND
                       (SENTENCErec2.finiteness = infinite)
                 A132: SENTENCErec1 := SENTENCErec2;

              A13: SENTENCErec1.supertiempo := pasado;

          A1: @
        >

>

&

\end{verbatim}
