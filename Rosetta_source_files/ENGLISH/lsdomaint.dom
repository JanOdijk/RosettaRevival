               DET, EXCLAM, GEN, BIGPRO,
               GLUE, INDEFPRO, NEG, NOUN, NUM, ORDINAL, PART,
	       PERSPRO, POSSADJ, POSSPRO, PREP, PROPERNOUN, PROSENT,  {17-05-88}
               PUNC, Q, RECIPRO,
	       REFLPRO, RELPRO, THANAS, THERE,                        {17-05-88}
               TOCAT, VERB, WHPRO 
