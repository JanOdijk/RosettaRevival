
SPANISH 59
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TAcase
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}
                            [head/SUBVERB{SUBVERBrec1}
                                 [head/I1::BVERB{BVERBrec1}]
                            ],
                      mu3,
                      I2:objrel/T1,
                      mu5 
                    ],
             mu7 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}
                            [head/SUBVERB{SUBVERBrec1}
                                 [head/I1::BVERB{BVERBrec1}]
                            ],
                      mu3,
                      I3:objrel/T2,
                      mu5 
                    ],
             mu7 
           ]
>


   MATCHCONDITIONS
      <
       I1: (BVERBrec1.key <> KEY_haberBVERBkey)  AND
           (BVERBrec1.key <> KEY_tenerBVERBkey)  AND
           (BVERBrec1.intensV = notintens)
       I2: T1.CAT IN [NP, NPVAR, CNVAR]
       I3: T2.CAT IN [NP, NPVAR, CNVAR] 
      >


<
   SUBRULE  (* NP *)
      <T1: NP{NPrec1}[mu6] >
      <T2: NP{NPrec2}[mu6] >


      COMP
         <
          C1: (Accusative IN NPrec1.cases)   AND
              (NPrec1.animate = yesAnimate)  AND
              (NPrec1.definite = def)        AND 
              ((NPrec1.human = YesHuman) OR
               ((NPrec1.human = omegahuman) AND
                (NPrec1.NPhead = persproNP) AND
                (NPrec1.genero <> neutro)
               )
              )
          A1: NPrec2 := NPrec1;
              NPrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: (Prepositive IN NPrec2.cases)  AND
              (NPrec2.animate = yesAnimate)  AND
              (NPrec2.definite = def)        AND 
              ((NPrec2.human = YesHuman) OR
               ((NPrec2.human = omegahuman) AND
                (NPrec2.NPhead = persproNP) AND
                (NPrec2.genero <> neutro)
               )
              )
          A1: NPrec1 := NPrec2;
              NPrec1.cases := [Accusative]
         >


   SUBRULE  (* NPVAR *)
      <T1: NPVAR{NPVARrec1}[mu6] >
      <T2: NPVAR{NPVARrec2}[mu6] >


      COMP
         <
          C1: (Accusative IN NPVARrec1.cases)   AND
              (NPVARrec1.animate = yesAnimate)  AND
              (NPVARrec1.definite = def)        AND 
              ((NPVARrec1.human = YesHuman) OR
               ((NPVARrec1.human = omegahuman) AND
                (NPVARrec1.NPhead = persproNP) AND
                (NPVARrec1.genero <> neutro)
               )
              )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: (Prepositive IN NPVARrec2.cases)  AND
              (NPVARrec2.animate = yesAnimate)  AND
              (NPVARrec2.definite = def)        AND 
              ((NPVARrec2.human = YesHuman) OR
               ((NPVARrec2.human = omegahuman) AND
                (NPVARrec2.NPhead = persproNP) AND
                (NPVARrec2.genero <> neutro)
               )
              )
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [Accusative]
         >


   SUBRULE  (* CNVAR *)
      <T1: CNVAR{CNVARrec1}[mu6] >
      <T2: CNVAR{CNVARrec2}[mu6] >


      COMP
         <
          C1: (Accusative IN CNVARrec1.cases)   AND    
              (CNVARrec1.animate = yesAnimate)  AND
              (CNVARrec1.definite = def)        AND              
              (CNVARrec1.human = YesHuman) 

          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: (Prepositive IN CNVARrec2.cases)  AND
              (CNVARrec2.animate = yesAnimate)  AND
              (CNVARrec2.definite = def)        AND 
              (CNVARrec2.human = YesHuman)
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [Accusative]
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TAcase
\item[* relevant examples:] Veo a Juan, Veo a un chico,
Busco al chico, Busco a un chico (only buscar = "intens" !! see remarks)
\item[* language:] Spanish 
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] TC\_Acase
\item[* date of creation:] 20-SEP-1988 11:11:52  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 07/11/88\ \ \ \ \ author: Elly van Munster\\
NPVAR and CNVAR added.
\item date: 07/12/88\ \ \ \ \ author: Elly van Munster\\
Condition "YesHuman" added.
\item date: 12/01/89\ \ \ \ \ author: Lisette Appelo\\
Conditions for perspro added. Perspro = omegahuman!!!
\end{enumerate}
\item[* task:] To change Case into Prepositive in case the object
(of a verb other than haber/tener!) has Accusative case and is Animate and 
Human.\\
Furthermore the VERB has to be "notintens".
Later on, after substitution, an A-insertion rule inserts "a"
before an object which has Prepositive case.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\item e.g. BUSCAR has two entries in the lexicon: "intens" and "notintens"\\
QUERER1 (Dutch willen) is "intens"\\
QUERER2 (Dutch houden van) is "notintens" (with a PREPNP argument !!)\\
NB. haber/tener are mentioned in the rule since they always take an object 
without "a", eventhough they are not intensional.
\end{description}


