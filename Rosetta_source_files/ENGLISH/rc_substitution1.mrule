  SUBST:
  m2: T3=I1::ADVP{ADVPrec1}[mu5]
>

< m : CLAUSE{CLAUSErec1}
            [ I8:leftdislocrel/T4=I2::ADVP{ADVPrec2}[mu5],
              puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1},
              mu1,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4 
            ] 
>

   MATCHCONDITIONS
      <
