                                 [ mu3,
                                   I2:rel1/N1
                                          [ mu9, 
                                            I4:objrel/T2, 
                                            mu10
                                          ],
                                   mu4 
                                 ],
                          mu5 
                        ],
                mu6  
              ]

>


   MATCHCONDITIONS
      <
       I1: synBE IN CLAUSErec1.synvpefs
       I2: rel1 IN [prepobjrel, toobjrel, forobjrel, locargrel]  AND
           N1.CAT IN [PREPP, VARPREPP]
       I3: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = []
       I4: T2.CAT IN [NPVAR, CNVAR, NP] 
              WITH T2.REC.cases * [Accusative] <> []
       I5: N2.CAT IN [NP, ADJP, PREPP, ADVP]
      >

<
