\begin{verbatim}
%TRANSFORMATION TREFLspelling2b   (* reflexive, object antecedent, NPVAR *)

< m1:I1::VERBPPROP{VERBPPROPrec1}
                      [ mu1,
                        predrel/VERBP{VERBPrec1}
                            [ mu11,
                              head/I2::VERB{VERBrec1}[mu6],
                              cliticrel/CLITIC{CLITICrec1}[mu4],
                              mu2,
                              I3:objrel/T3,
                              mu3
                            ],
                        mu8
                      ]
>

< m :I1::VERBPPROP{VERBPPROPrec1}
                      [ mu1,
                        predrel/VERBP{VERBPrec1}
                            [ mu11,
                              head/I2::VERB{VERBrec1}[mu6],
                              cliticrel/CLITIC{CLITICrec1}[mu5],
                              mu2,
                              I3:objrel/T3,
                              mu3
                            ],
                        mu8
                      ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.thetavp IN [vp010, vp012, vp021]
       I2: ( VERBrec1.Caseassigner = true ) AND
           ( VERBrec1.reflexivity = reflexive )
       I3: T3.CAT IN [NP, NPVAR]
      >
<
   SUBRULE (*Me*)
      <mu4: [I3: mu7] >
      <mu5: [rel2/REFLPRO(AUX_Mereflprokey){REFLPROrec1}] >

   MATCHCONDITIONS
      <
       I3: EXIST (mu7, [dosclrel/..])
      >

      COMP
         <
          C1: (T3.REC.numero = singular) AND
              (T3.REC.persona = 1)              
          A1: rel2 := unoclrel
         >


   SUBRULE (*Nos*)
      <mu4: [I3: mu7] >
      <mu5: [rel2/REFLPRO(AUX_Nosreflprokey){REFLPROrec1}] >

   MATCHCONDITIONS
      <
       I3: EXIST (mu7, [dosclrel/..])
      >

      COMP
         <
          C1: (T3.REC.numero = plural) AND
              (T3.REC.persona = 1)
          A1: rel2 := unoclrel
         >
>
&

\end{verbatim}
