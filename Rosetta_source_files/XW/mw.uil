object mw_message_window : XmFrame {
    controls {
        XmRowColumn {
            arguments {
        	XmNorientation      = XmHORIZONTAL;
                XmNbackgroundPixmap = xbitmapfile ('zz');
!               XmNforeground       = color('white');
            };
            controls {
	        XmLabel mw_message_label;
                XmLabel mw_message_text;
            };
        };
    };
};

object mw_message_label : XmLabel {
    arguments {
        XmNfontList         = bold;
	XmNlabelString      = N_mw_message_text;
    };
};

object mw_message_text : XmLabel {
    arguments {
        XmNfontList         = bold;
	XmNlabelString      = N_startup_text;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_message_text);
    };
};
