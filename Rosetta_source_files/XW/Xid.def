! The WND_Xid has the following layout:
!
!     X_<prefix>_<name>_<type>
!
!
!     <prefix> is the prefix of the window the Xid takes part of; it can be one
!              of the following:
!                  mw, question, err, file, startup, help, amb1, amb2, amb3, dbg,
!                  tree, trees, attr, dbgset, env, mp, mg, mps
!              A sub-window can be indicated by extending the prefix; it can be
!              one of the following:
!                  mp_rule, mp_trans, mg_rule, mg_trans
!
!     <name> is the identifying free-format text of the Xid; if no
!            identification is needed, this part may be left out. <name> may not
!            contain underscores.
!
!     <type> is the type of the Xid being:
!            window : this is a whole window (; the <name> is always left blank
!                     because the prefix already defines the window uniquely).
!            area   : this is a multi-line text-edit area or a free-format area
!                     (e.g. for trees)
!            button : this is a push-button or an entry in the menu-bar
!            text   : this is a single-line text-edit area (text + frame) or a
!                     label (text only)
!            toggle : this is a toggle-button that can be set on or off (;this
!                     is displayed with either a diamond- or a box sign)
!            list   : this is a list of strings
!            frame  : this is a frame around something



#define MAX_SCREENS      10
#define SCREEN_OFFSET    ( SCREEN_END - SCREEN_START )
#define X_LAST           ( SCREEN_START + MAX_SCREENS * SCREEN_OFFSET )

#0

