% RULE RExistLocpreppVar
< m1: NPPROP{NPPROPrec1}
               [ mu1,
                 objrel/NPVAR{NPVARrec1},
                 I4:mu4,
                 I3:mu3 
               ]

  m2: I1::PREPPVAR{PREPPVARrec1}                 
>

< m : NPPROP{NPPROPrec1}
               [ mu1,
                 objrel/NPVAR{NPVARrec1},
                 I4:mu4,
                 locadvrel/I1::PREPPVAR{PREPPVARrec1},
                 I5:mu3
               ]
>

   MATCHCONDITIONS
      <
       I1: loc IN PREPPVARrec1.actsubcefs
       I4: ALL(mu4, locadvrel/..)
       I3: NOT EXIST (mu3, [locadvrel/..])
       I5: NOT EXIST(mu3, [I51:rel5/..])
           I51: rel5 IN [locadvrel, tempadvrel, sentadvrel]
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
