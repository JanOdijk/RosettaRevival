\begin{verbatim}
% TRANSFORMATION TADVPpattern0
< m1: ADVP{ADVPrec1}[ head/ADV{ADVrec1}[mu1]]
>

< m : ADVP{ADVPrec2}[ head/ADV{ADVrec1}[mu1]]
>

      COMP
         <
          C1: synnoVPargs IN ADVrec1.advpatterns AND
              ADVPrec1.advpatternefs = []        
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synnoVPargs];
         >
      DECOMP
         <
          C1: synnoVPargs IN ADVrec1.advpatterns AND
              synnoVPargs IN ADVPrec2.advpatternefs
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
         >

&

\end{verbatim}
