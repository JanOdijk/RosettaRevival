pragma C_include('tstring.pf');


PACKAGE TldSTRtoSTR;
WITH tstring;

(*MPF:::===================================================================*
 *
 *  Function Name  : TldSTRtoSTR_CATtoRECTYPE
 *  Description    : converts a string denoting a category to the
 *                   string denoting the name of the record type
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION TldSTRtostr_CATtoRECTYPE(cat:TSTRING_string)
                    :TSTRING_string;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name : TldSTRtoSTR_typeinfo
 *  Description    : gives type information about Typestr
 *  Parameters     : kind=1 -> integer type
 *                   kind=2 -> boolean type
 *                   kind=3 -> enumeration type
 *                   kind=4 -> subrange type
 *                   kind=5 -> set type
 *                   if kind=5 then min and max are the minimum and maximum
 *                   values of the basetype
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 PROCEDURE TldSTRtostr_typeinfo(Typestr:TSTRING_string;
   VAR kind:INTEGER;VAR basetype,min,max:TSTRING_string);
EXTERNAL;

END {TldSTRtoSTR};
