(* aanpassen aan de vaste volgorde: ref, retro, dur (generatief) *)
\begin{verbatim}
%
% RULE RADJrefvarinsertion
< m1: ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I1:mu3
                    ],
             mu6
            ] 

  m2: T1 
>

< m : ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I1:mu3,
                     tempadvrel/T1
                    ],
             mu6
            ] 

>
   MATCHCONDITIONS
      <
       I1: (NOT EXIST (mu3, [tempadvrel/..])) AND
           (QUOTE_temprefnotfound (mu3))
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
      >
<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1} >
      < T1: ADVPVAR{ADVPVARrec1} >

      COMP
         <
          C1: (ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false)
          A1: @
         >

   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1} >
      < T1: PREPPVAR{PREPPVARrec1} >

      COMP
         <
          C1: (PREPPVARrec1.class = reference) AND
              (PREPPVARrec1.retro = false)
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.class = reference) AND
              (PREPPVARrec1.retro = false)
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <

          C1: (SENTENCEVARrec1.conjclass = reference) AND
              (SENTENCEVARrec1.conjretro = false)
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjclass = reference) AND
              (SENTENCEVARrec1.conjretro = false)
          A1: @
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RADJrefvarinsertion
\item[* relevant examples:]
\begin{itemize}
  \item `the man' (ill VAR (`yesterday')) later: $\rightarrow$ `the man (who
was ill yesterday)'
\end{itemize}
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] ADJPPROPformation
\item[* class:] ADJrefadvvarinsertion rules
\item[* date of creation:] 28-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Radjrefvarinsertion Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 06/04/89\ \ \ \ \ author: Lisette Appelo\\
Adapted to fixed (generative) order ref, retro, dur.\\
The temporal adverbials are always the last adverbials (source: MJS). 
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] Introduction of variables for referential time adverbials that 
are not retrospective. These time adverbials are supposed to be of category 
ADVP, PREPP or SENTENCE. They will be substituted in the substitution rules.
\item[\ \ strategy:] deviation from accepted proposal of doc 53: the variables 
for referential time adverbials are no longer introduced by the aspect or 
retrospectivity rules, but by rules in a separate rule class preceding these 
rules in the ADJPPROPformation subgrammar. 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application?
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: Only one rule for non retrospective referential time adverbials 
will be applied. Complex time adverbials such as e.g. {\em tomorrow at 3 o'
clock} can 
form one constituent, but also appear disjunctive as e.g. in {\em tomorrow he
will come at 3 o'clock}. How should we treat this case? Introduction at once followed 
by a syntactic transformation or separate introduction?\\

\item modifications: CONJSENT has been substituted by SENTENCE\\
Because of this change the rule had to be split up into 3 subrules, bcause the 
generalization over the time attributes is not longer possible now. The 
introduction of the variables is moved to the ADJPPROPformation subgrammar.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RADJdurvarinsertion
< m1: ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I1:mu3,
                     I2:mu5
                    ],
             mu6
            ] 

  m2: T1 
>

< m : ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I1:mu3,
                     tempadvrel/T1,
                     I2:mu5
                    ],
             mu6
            ] 

>
   MATCHCONDITIONS
      <
       I1: (NOT EXIST(mu3, [tempadvrel/..])) 
       I2: (ALL(mu5, tempadvrel/..)) AND
           (QUOTE_tempdurnotfound(mu5))
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
      >
<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1} >
      < T1: ADVPVAR{ADVPVARrec1}>

      COMP
         <
          C1: (ADVPVARrec1.class = duration) AND
              (ADVPVARrec1.retro = false)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.class = duration) AND
              (ADVPVARrec1.retro = false) 
          A1: @
         >

   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1} >
      < T1: PREPPVAR{PREPPVARrec1}>

      COMP
         <
          C1: (PREPPVARrec1.class = duration) AND
              (PREPPVARrec1.retro = false) 
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.class = duration) AND
              (PREPPVARrec1.retro = false) 
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: (SENTENCEVARrec1.conjclass = duration) AND
              (SENTENCEVARrec1.conjretro = false) 
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjclass = duration) AND
              (SENTENCEVARrec1.conjretro = false) 
          A1: @
         >
>
&

\end{verbatim}

