< EMPTYVAR        : EMPTYVARrecord >
< VERBPPROPVAR    : VERBPPROPVARrecord >
< PRONPVAR        : NPVARrecord >        {* 28/1/88  "little pro" *}

< BVERBSUFF       : BVERBrecord >
< BVERB		  : BVERBrecord >
