\newpage
\begin{verbatim}

% TRANSFORMATION TADJCaseAssignment2
< m1:ADJPFORMULA{ADJPFORMULArec1}
           [ mu1,
             predrel/ADJP{ADJPrec1}
                    [ mu2,
                      rel1/PREPP{PREPPrec1}
                           [ mu3,
                             objrel/T1,
                             mu4 
                           ],
                      mu5
                    ],
             mu6
           ]
>
< m :ADJPFORMULA{ADJPFORMULArec1}
           [ mu1,
             predrel/ADJP{ADJPrec1}
                    [ mu2,
                      I1:rel1/PREPP{PREPPrec1}
                           [ mu3,
                             objrel/T2,
                             mu4 
                           ],
                      mu5
                    ],
             mu6
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [prepobjrel, toobjrel, forobjrel]
      >
    
<
   SUBRULE  (* 1 *)
      <T1:NPVAR{NPVARrec1} >
      <T2:NPVAR{NPVARrec2} >

      COMP
         <
          C1: NPVARrec1.cases = []
	  A1: NPVARrec2 := NPVARrec1;
	      NPVARrec2.cases := [Accusative]
         >
      DECOMP
         <
          C1: [Accusative] * NPVARrec2.cases <> []
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := []
         >

   SUBRULE  (* 2 *)

      <T1:CNVAR{CNVARrec1} >
      <T2:CNVAR{CNVARrec2} >

      COMP
         <
          C1: CNVARrec1.cases = []
	  A1: CNVARrec2 := CNVARrec1;
	      CNVARrec2.cases := [Accusative]
         >
      DECOMP
         <
          C1: [Accusative] * CNVARrec2.cases <> []
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := []
         >

   SUBRULE  (* 3 *)
      <T1:NP{NPrec1}[mu7] >
      <T2:NP{NPrec2}[mu8] >

      COMP
         <
          C1: NPrec1.cases = []
	  A1: QUOTE_AssignCase(NPrec1, mu7, NPrec2, mu8, [accusative])
         >
      DECOMP
         <
          C1: [Accusative] * NPrec2.cases <> []
          A1: QUOTE_AssignCase(NPrec2, mu8, NPrec1, mu7, [])
         >
>
&

\end{verbatim}
