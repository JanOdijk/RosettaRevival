3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_SETVALUENAME;
                      $SETVALUENAME.copy:=copy;
                END
*>
END;
