\begin{verbatim}

% RULE ROtherClosedPrepPPropSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/I1::PREPPPROPVAR{PREPPPROPVARrec1},
                        mu3 
                       ],
                mu5
               ]
  
  SUBST:
  m2: CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}[mu4]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}[mu4],
                        mu3 
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: PREPPPROPVARrec1.index = LEVEL 
       m2: AUX_otherprepsubcs * 
                         CLOSEDPREPPPROPrec1.actsubcefs  <> []

      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: PREPPPROPVARrec1 = COPYT_prepppropTOvar(CLOSEDPREPPPROPrec1) 
                                 EXCEPT FOR [actsubcefs]   AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: PREPPPROPVARrec1 := COPYT_prepppropTOvar(CLOSEDPREPPPROPrec1);
              PREPPPROPVARrec1.index := LEVEL;
              PREPPPROPVARrec1.actsubcefs := 
                  CLOSEDPREPPPROPrec1.actsubcefs * AUX_otherprepsubcs
         >
&

\end{verbatim}
