\newpage
\begin{verbatim}
% RULE Rinfinpastsuperdeixisspec
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    auxrel/VERB{VERBrec3}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(AUX_haberbverbkey){BVERBrec1}
                               ] 
                          ],
                    rel1/VERB{VERBrec2}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST (mu5, [tempadvrel/..])
      >

<
   SUBRULE (*1: ADVPVAR *)
      <mu5 : [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I3: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.tiempo IN [omegatiempo, pasado])
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.modo = omegamodo)
            )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;

             (* modal + dependent clause *)
             C12:(CLAUSErec1.supertiempo = pasado)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modo = ptcpas) AND
              (VERBrec2.tiempo = omegatiempo) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                     {
                      numero    : omeganumero
                      persona   : 3
                      modo      : omegamodo
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      futuro    : nofuturo
                      status    : bareV
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.supertiempo = pasado)
             A11: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := omegatiempo;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.supertiempo = pasado)
             A12: CLAUSErec1 := CLAUSErec2;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;
         >

   SUBRULE (*2: PREPPVAR*)
      <mu5 : [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I3: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.tiempo IN [omegatiempo, pasado])
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.modo = omegamodo)
            )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;

              (* modal + dependent clause *)
             C12:(CLAUSErec1.supertiempo = pasado)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modo = ptcpas) AND
              (VERBrec2.tiempo = omegatiempo) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                     {
                      numero    : omeganumero
                      persona   : 3
                      modo      : omegamodo
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      futuro    : nofuturo
                      status    : bareV
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.supertiempo = pasado)
             A11: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := omegatiempo;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.supertiempo = pasado)
             A12: CLAUSErec1 := CLAUSErec2;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;
         >


   SUBRULE (*3: SENTENCE*)
      <mu5 : [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5 : [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I3: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjtiempo IN [omegatiempo, pasado])
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.modo = omegamodo)
            )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;

             (* modal + dependent clause *)
             C12:(CLAUSErec1.supertiempo = pasado) 
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modo = ptcpas) AND
              (VERBrec2.tiempo = omegatiempo) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                     {
                      numero    : omeganumero
                      persona   : 3
                      modo      : omegamodo
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      futuro    : nofuturo
                      status    : bareV
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.supertiempo = pasado)
             A11: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := omegatiempo;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.supertiempo = pasado)
             A12: CLAUSErec1 := CLAUSErec2;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;
         >

>
&
\end{verbatim}

\newpage
\begin{description}
\item[* name:] Rinfinpastsuperdeixisspec
\item[* relevant examples:] lamentaba (haberlo hecho a las tres/ayer))
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 23-JUN-1989 
\item[* author:] Lisette Appelo
\item[* copied from:]Rinfinpastsuperdeixisspec English 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a infinite dependent clause. This
               is a special rule,because past is expressed by the auxiliary 
               verb {\em have}. 
               The most left verb in the clause (input generative rule)
gets modus past particle.
The auxiliary verb {\em haber
} is introduced with a omega tense.
               The deixis 
value of the reference adverbial is checked for 
               omega or past.
               The clause is marked for past superdeixis.
\item[\ \ strategy:] 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different variable categories for the reference 
adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial, perfective aspect rule \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: This rule has the same semantics as 
Rfinpastsuperdeixis2.\\

\item in other languages: \\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be pastdeixis in the case 
this sentence is a sentence with something like {\em graag} in Dutch or an 
auxiliary verb that is semantically a head and treated as a basic expression.\\

\end{enumerate}
\end{description}


