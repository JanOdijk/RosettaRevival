\begin{verbatim}
% RULE RQPSUPERLATIVEcomplmod
< m1: QP{QPrec1}[mu1, head/Q{Qrec1}]
  m2: T1
>


< m : QP{QPrec1}[mu1,
                 head/Q{Qrec1},
                 ofcomplrel/PREPP{PREPPrec1}
                           [head/PREP(KEY_ofPREPkey){PREPrec1},
                            I2:complrel/T2
                           ]
                    ]

>


   MATCHCONDITIONS
      < m1: QPrec1.thanas = ofcompl
        m:  QPrec1.thanas = ofcompl
        I2: T2.CAT IN [NPVAR]
        m2: T1.CAT IN [NPVAR]
       >

<

   SUBRULE
      <T1: NPVAR{NPVARrec1}>
      <T2: NPVAR{NPVARrec2}>

      COMP
         <
          C1: NPVARrec1.superdeixis = QPrec1.superdeixis
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec1.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: NPVARrec1.superdeixis = omegadeixis
          A1: QPrec1.thanas := ofcompl;
              NPVARrec1 := NPVARrec2;
              NPVARrec1.superdeixis := QPrec1.superdeixis;

         >
>
&

\end{verbatim}
