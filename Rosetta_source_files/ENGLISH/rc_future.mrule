\begin{verbatim}
% RULE Rfinpastfutsuperdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I1: mu2,
                    I3: mu3
                   ],
            I6: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I1: mu2,
                    I4: mu4
                   ],
            I6: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I2: rel2/..])
       I2: rel2 IN [auxrel, passauxrel, progauxrel, head]
       I3: EXIST (mu3, [rel1/VERB{VERBrec3}[mu8]])
       I4: EXIST (mu4, [rel1/VERB{VERBrec3}[mu8]])
       I6: EXIST(mu5, [tempadvrel/..])
      >

<
   SUBRULE (* 1 first verb is not do *)
      <mu3: [I7:rel3/VERB{VERBrec1}[mu9], mu10] >
      <mu4: [auxrel/VERB{VERBrec2}
                   [head/SUBVERB{SUBVERBrec1}
                        [head/BVERB(KEY_willbverbkey){BVERBrec1}]
                   ],
             I8:rel3/VERB{VERBrec5}[mu9], mu10
            ] 
      >

   MATCHCONDITIONS
      <
        I7: (rel3 IN [passauxrel, head, progauxrel]) OR
            ((rel3 IN [auxrel]) AND
            (VERBrec1.subc = haveverb))
        I8: (rel3 IN [passauxrel, head, progauxrel]) OR
            ((rel3 IN [auxrel]) AND
            (VERBrec1.subc = haveverb))
        mu3: VERBrec1.subc = haveverb ->
             NOT EXIST (mu10, [auxrel/..])
        mu4: VERBrec5.subc = haveverb ->
             NOT EXIST (mu10, [auxrel/..])

      >

<
   SUBRULE (* 1a *)
      <mu5: [I6: mu6, I5:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I7: mu7]>
      <mu5: [I6: mu6, I5:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I7: mu7]>

   MATCHCONDITIONS
      <
       I5: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            ((ADVPVARrec1.deixis = futuredeixis) OR
             (ADVPVARrec1.deixis = omegadeixis) 
            )
           )
       I6: QUOTE_temprefnotfound(mu6)
       I7: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus) AND
              (CLAUSErec1.finiteness = finite) AND
              (ADVPVARrec1.deixis = omegadeixis ->
               CLAUSErec1.retro = false) 
             )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := pastdeixis;

             C12: (CLAUSErec1.superdeixis = pastdeixis) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec2 := COPYT_subverbtoverb(SUBVERBrec1);
              VERBrec2 :=
                {
                  numbers     : []
                  persons     : []
                  modus       : omegamodus
                  tense       : pasttense
                };
              VERBrec5 := VERBrec1;
              VERBrec5.modus := infinitive;

         >
      DECOMP
         <
          C1:((VERBrec5.tense = omegatense) AND
              (VERBrec5.modus = infinitive) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.superdeixis = pastdeixis) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (VERBrec2 =
                {
                  numbers     : []
                  persons     : []
                  modus       : omegamodus
                  tense       : pasttense
                }
              ) AND
              (SUBVERBrec1.affix = noaffix) AND
              (ADVPVARrec1.deixis = omegadeixis ->
               CLAUSErec2.retro = false) 
             )
              C11: true
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

              C12: true                          (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec5;
              VERBrec1.modus := omegamodus;
         >

   SUBRULE (* 1b *)
      <mu5: [I6:mu6, I5: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I7:mu7]>
      <mu5: [I6:mu6, I5: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I7:mu7]>

   MATCHCONDITIONS
      <
       I5: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            ((PREPPVARrec1.deixis = futuredeixis) OR
             (PREPPVARrec1.deixis = omegadeixis) 
            ) 
           )
       I6: QUOTE_temprefnotfound(mu6)
       I7: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus) AND
              (CLAUSErec1.finiteness = finite) AND
               (PREPPVARrec1.deixis = omegadeixis ->
                CLAUSErec1.retro = false) 
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := pastdeixis;

             C12: (CLAUSErec1.superdeixis = pastdeixis) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec2 := COPYT_subverbtoverb(SUBVERBrec1);
              VERBrec2 :=
                {
                  numbers     : []
                  persons     : []
                  modus       : omegamodus
                  tense       : pasttense
                };
              VERBrec5 := VERBrec1;
              VERBrec5.modus := infinitive;

         >
      DECOMP
         <
          C1:((VERBrec5.tense = omegatense) AND
              (VERBrec5.modus = infinitive) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.superdeixis = pastdeixis) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (VERBrec2 =
                {
                  numbers     : []
                  persons     : []
                  modus       : omegamodus
                  tense       : pasttense
                }
              ) AND
              (SUBVERBrec1.affix = noaffix) AND
              (PREPPVARrec1.deixis = omegadeixis ->
               CLAUSErec2.retro = false) 
             )
              C11: true
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

              C12: true                          (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec1 := VERBrec5;
              VERBrec1.modus := omegamodus;
         >

