ENGLISH 20

&


\noindent

\begin{description}
\item[TWhShift] for the actual shifting
\end{description}

\newpage
\begin{verbatim}

%
% TRANSFORMATION TWhShift
< m1: CLAUSE{CLAUSErec1}
            [ I1:sig1, 
              I2:mu1 ]
>

< m : CLAUSE{CLAUSErec2}
            [ I1:sig1, 
              I3:mu2 ]
>

   MATCHCONDITIONS
      <
       I1: ALL (sig1, leftdislocrel/..)
       I2: NOT EXIST (mu1, [I21:rel1/..])
           I21: rel1 IN [leftdislocrel, shiftrel]
       I3: NOT EXIST (mu2, [leftdislocrel/..])  AND
           QUOTE_FIRSTrel(mu2, shiftrel)         
           (* not really necessary *)
      >

<
   SUBRULE  (* 1. subjrel *)
      < mu1: [I6:mu6, 
              I8:subjrel/T1,
              I7:mu7] 
      >
      < mu2: [I8:shiftrel/T1,
              I6:mu6, 
              I7:mu7] 
      >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [subjrel/..])
           I61: QUOTE_Srelprec(rel6, subjrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [subjrel/..])
           I71: QUOTE_Srelprec(Subjrel, rel7)
       I8: (T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh, relativexpmood])
           OR (T1.CAT IN [CNVAR])              OR
           (T1.CAT IN [NP] WITH
            ((T1.REC.mood = wh)    AND
             (QUOTE_VARinNP(T1)
             )
            )
           )
      >

      COMP
         <
          C1: CLAUSErec1.finiteness = finite AND
              ( T1.CAT IN [NPVAR, CNVAR, NP] WITH 
                       nominative IN T1.REC.cases )
          A1: CLAUSErec2 := CLAUSErec1
          >
      DECOMP
         <
          C1: CLAUSErec1.finiteness = finite AND
              ( T1.CAT IN [NPVAR, CNVAR, NP] WITH 
                       nominative IN T1.REC.cases )
          A1: CLAUSErec1 := CLAUSErec2
         >

   SUBRULE (* 2. objrel *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:objrel/T1,
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/T1,
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [objrel/..])
           I61: QUOTE_VPrelprec(rel6, objrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [objrel/..])
           I71: QUOTE_VPrelprec(objrel, rel7)
       I8: (T1.CAT IN [NPVAR] WITH 
                       T1.REC.mood IN [wh, relativexpmood, topicmood])
           OR (T1.CAT IN [CNVAR])              OR
           (T1.CAT IN [NP] WITH
            ((T1.REC.mood = wh)    AND
             (QUOTE_VARinNP(T1)
             )
            )
           )
      >

      COMP
         <
          C1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH 
                       T1.REC.cases <> [] ) AND
              CLAUSErec1.synvpefs * AUX_objvps <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH 
                       T1.REC.cases <> [] ) AND
              CLAUSErec2.synvpefs * AUX_objvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  CLAUSErec2.synvpefs * AUX_objvps
         >

   SUBRULE (* 3. indobjrel *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:indobjrel/T1, 
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/T1, 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [indobjrel/..])
           I61: QUOTE_VPrelprec(rel6, indobjrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [indobjrel/..])
           I71: QUOTE_VPrelprec(indobjrel, rel7)
       I8: (T1.CAT IN [NPVAR] WITH 
                      T1.REC.mood IN [wh, relativexpmood, topicmood])
           OR (T1.CAT IN [CNVAR])              OR
           (T1.CAT IN [NP] WITH
            ((T1.REC.mood = wh)    AND
             (QUOTE_VARinNP(T1)
             )
            )
           )
      >

      COMP
         <
          C1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH 
                       T1.REC.cases <> [] ) AND
              CLAUSErec1.synvpefs * AUX_indobjvps <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH 
                       T1.REC.cases <> [] ) AND
              CLAUSErec2.synvpefs * AUX_indobjvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                      ( CLAUSErec2.synvpefs * AUX_indobjvps )
         >

   SUBRULE (* 4. predrel, ADJP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      predrel/I8::ADJP{ADJPrec1}[mu8], 
                      I7:mu7], 
              mu12] >
      < mu2: [shiftrel/I8::ADJP{ADJPrec1}[mu8], 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(predrel,rel7 )
       I8: ADJPrec1.mood = wh
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_adjppredvps <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_adjppredvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  
                    (CLAUSErec2.synvpefs * AUX_adjppredvps)
         >

   SUBRULE (* 5a. predrel, NP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      predrel/I8::NP{NPrec1}[mu8],
                      I7:mu7], 
              mu12] >
      < mu2: [shiftrel/I8::NP{NPrec1}[mu8],
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(predrel, rel7)
       I8: NPrec1.mood = wh   
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >

      COMP
         <
          C1: NPrec1.cases <> [] AND
              CLAUSErec1.synvpefs * AUX_nppredvps <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: NPrec1.cases <> [] AND
              CLAUSErec2.synvpefs * AUX_nppredvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                          ( CLAUSErec2.synvpefs * AUX_nppredvps )
         >

   SUBRULE (* 5b. predrel, NPVAR (ident.) *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      predrel/I8::NPVAR{NPVARrec1},
                      I7:mu7], 
              mu12] >
      < mu2: [shiftrel/I8::NPVAR{NPVARrec1},
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(predrel, rel7)
       I8: NPVARrec1.mood = wh   
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
   >

      COMP
         <
          C1: NPVARrec1.cases <> [] AND
              CLAUSErec1.synvpefs * AUX_nppredvps <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: NPVARrec1.cases <> [] AND
              CLAUSErec2.synvpefs * AUX_nppredvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                          ( CLAUSErec2.synvpefs * AUX_nppredvps )
         >

   SUBRULE (* 6. predrel, PREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      predrel/I8::PREPP{PREPPrec1}[mu8], 
                      I7:mu7], 
              mu12] >
      < mu2: [shiftrel/I8::PREPP{PREPPrec1}[mu8], 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, predrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST(mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(predrel, rel7)
       I8: PREPPrec1.mood = wh   
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
   >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_prepppredvps <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_prepppredvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                          ( CLAUSErec2.synvpefs * AUX_prepppredvps )
         >

   SUBRULE (* 7a. locargrel, PREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:locargrel/PREPP{PREPPrec1}[mu8],
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/PREPP{PREPPrec1}[mu8],
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, locargrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(locargrel, rel7)
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
       I8: PREPPrec1.mood IN [wh, relativexpmood, topicmood] AND
           loc IN PREPPrec1.actsubcefs
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_locargvps <> [] OR
              CLAUSErec1.adjuncts * [locadjunct] <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_locargvps <> [] OR
              CLAUSErec2.adjuncts * [locadjunct] <> []
                C11: CLAUSErec2.synvpefs * AUX_locargvps <> []
                A11: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_locargvps);
                C12: CLAUSErec2.adjuncts * [locadjunct] <> []
                A12: CLAUSErec1 := CLAUSErec2;
          A1: @
         >

   SUBRULE (* 7b. locargrel, ADVP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      locargrel/I8::ADVP{ADVPrec1}[mu8],
                      I7:mu7], 
              mu12] >
      < mu2: [shiftrel/I8::ADVP{ADVPrec1}[mu8],
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, locargrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(locargrel, rel7)
       I8: ADVPrec1.mood = wh AND
           locadv IN ADVPrec1.actsubcefs
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_locargvps <> [] OR
              CLAUSErec1.adjuncts * [locadjunct] <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_locargvps <> [] OR
              CLAUSErec2.adjuncts * [locadjunct] <> []
                C11: CLAUSErec2.synvpefs * AUX_locargvps <> []
                A11: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_locargvps);
                C12: CLAUSErec2.adjuncts * [locadjunct] <> []
                A12: CLAUSErec1 := CLAUSErec2;
          A1: @
         >

   SUBRULE (* 8a. dirargrel, PREPP  *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:dirargrel/PREPP{PREPPrec1}[mu8],
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/PREPP{PREPPrec1}[mu8],
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, dirargrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(dirargrel, rel7)
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
       I8: PREPPrec1.mood IN [wh, relativexpmood, topicmood] AND
           dir IN PREPPrec1.actsubcefs
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_dirargvps <> [] OR
              CLAUSErec1.adjuncts * [diradjunct] <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_dirargvps <> [] OR
              CLAUSErec2.adjuncts * [diradjunct] <> []
                C11: CLAUSErec2.synvpefs * AUX_dirargvps <> []
                A11: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                             (CLAUSErec2.synvpefs * AUX_dirargvps);
                C12: CLAUSErec2.adjuncts * [diradjunct] <> []
                A12: CLAUSErec1 := CLAUSErec2;
          A1: @
         >

   SUBRULE (* 8b. dirargrel, ADVP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      dirargrel/I8::ADVP{ADVPrec1}[mu8],
                      I7:mu7], 
              mu12] >
      < mu2: [shiftrel/I8::ADVP{ADVPrec1}[mu8],
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, dirargrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(dirargrel, rel7)
       I8: ADVPrec1.mood = wh AND
           diradv IN ADVPrec1.actsubcefs
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >
      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_dirargvps <> [] OR
              CLAUSErec1.adjuncts * [diradjunct] <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_dirargvps <> [] OR
              CLAUSErec2.adjuncts * [diradjunct] <> []
                C11: CLAUSErec2.synvpefs * AUX_dirargvps <> []
                A11: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                             (CLAUSErec2.synvpefs * AUX_dirargvps);
                C12: CLAUSErec2.adjuncts * [diradjunct] <> []
                A12: CLAUSErec1 := CLAUSErec2;
          A1: @
         >

   SUBRULE (* 9. complrel, VARPREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:complrel/PREPP{PREPPrec1}[mu10], 
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/PREPP{PREPPrec1}[mu10], 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND NOT EXIST (mu6, [I62:rel2/T3])
           I61: QUOTE_VPrelprec(rel6, complrel)
       I7: ALL (mu7, I71:rel7/..) AND NOT EXIST (mu7, [I62:rel2/T3])
           I71: QUOTE_VPrelprec(complrel, rel7)
       I62: rel2 IN [predrel, locargrel, dirargrel, prepobjrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
       I8: PREPPrec1.mood IN [wh, relativexpmood, topicmood] AND
           other IN PREPPrec1.actsubcefs
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_complvps <> [] 
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_complvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  
                            ( CLAUSErec2.synvpefs * AUX_complvps )
         >

   SUBRULE (* 10a. first prepobjrel, VARPREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:prepobjrel/VARPREPP{VARPREPPrec1}[mu10], 
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/VARPREPP{VARPREPPrec1}[mu10], 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND 
           NOT EXIST (mu6, [I62:rel2/T3]) AND
           NOT EXIST (mu6, [prepobjrel/..]) 
         I61: QUOTE_VPrelprec(rel6, prepobjrel)
       I7: ALL (mu7, I71:rel7/..) AND 
           NOT EXIST (mu7, [I62:rel2/T3])
         I71: QUOTE_VPrelprec(prepobjrel, rel7)
         I62: rel2 IN [predrel, locargrel, dirargrel] OR
              ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
       I8: VARPREPPrec1.mood IN [wh, relativexpmood, topicmood]
       mu1: EXIST (mu6, [head/I91::VERB{VERBrec1}[mu13]])
       mu2: EXIST (mu6, [head/I91::VERB{VERBrec1}[mu13]])
         I91: VERBrec1.prepkey1 = VARPREPPrec1.headkey
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_prepobjvps <> [] OR
              CLAUSErec1.adjuncts * [benfactPP] <> []
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_prepobjvps <> [] OR
              CLAUSErec2.adjuncts * [benfactPP] <> []
               C11: CLAUSErec2.synvpefs * AUX_prepobjvps <> []
               A11: CLAUSErec1 := CLAUSErec2;
                    CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_prepobjvps);
               C12: CLAUSErec2.adjuncts * [benfactPP] <> []
               A12: CLAUSErec1 := CLAUSErec2;
          A1: @
         >

   SUBRULE (* 10b. second prepobjrel, VARPREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:prepobjrel/VARPREPP{VARPREPPrec1}[mu10], 
                      I7:mu7], 
              mu12] >
      < mu2: [I8:shiftrel/VARPREPP{VARPREPPrec1}[mu10], 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND 
           NOT EXIST (mu6, [I62:rel2/T3]) AND
           EXIST (mu6, [prepobjrel/..])
         I61: QUOTE_VPrelprec(rel6, prepobjrel)
       I7: ALL (mu7, I71:rel7/..) AND 
           NOT EXIST (mu7, [prepobjrel/..]) AND
           NOT EXIST (mu7, [I62:rel2/T3])
         I71: QUOTE_VPrelprec(prepobjrel, rel7)
         I62: rel2 IN [predrel, locargrel, dirargrel] OR
              ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
       I8: VARPREPPrec1.mood IN [wh, relativexpmood, topicmood]
       mu1: EXIST (mu6, [head/I91::VERB{VERBrec1}[mu13]])
       mu2: EXIST (mu6, [head/I91::VERB{VERBrec1}[mu13]])
         I91: VERBrec1.prepkey2 = VARPREPPrec1.headkey
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_prepobjvps <> [] 
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_prepobjvps <> []
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_prepobjvps)
         >

   SUBRULE (* 11. byobjrel, VARPREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:byobjrel/VARPREPP{VARPREPPrec1}[mu10]
                     ], 
              mu12] >
      < mu2: [I8:shiftrel/VARPREPP{VARPREPPrec1}[mu10], 
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6], 
              mu12] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..) AND 
           NOT EXIST (mu6, [byobjrel/..])
         I61: QUOTE_VPrelprec(rel6, byobjrel)
       I8: VARPREPPrec1.mood IN [wh,relativexpmood, topicmood] AND
           doorby IN VARPREPPrec1.actsubcefs
      >

      COMP
         <
          C1: CLAUSErec1.voice = passive 
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: CLAUSErec2.voice = passive 
          A1: CLAUSErec1 := CLAUSErec2
         >

   SUBRULE  (* 12a. tempadvrel, PREPPVAR *)
      < mu1: [I6:mu6, 
              I8:tempadvrel/PREPPVAR{PREPPVARrec1},
              I7:mu7] >
      < mu2: [I8:shiftrel/PREPPVAR{PREPPVARrec1},
              I6:mu6, 
              I7:mu7] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, tempadvrel)
       I7: ALL (mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(tempadvrel, rel7 )
       I8: PREPPVARrec1.mood IN [wh,relativexpmood, topicmood] AND
           temp IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2
         >

   SUBRULE  (* 12b. tempadvrel, ADVPVAR *)
      < mu1: [I6:mu6, 
              I8:tempadvrel/ADVPVAR{ADVPVARrec1},
              I7:mu7] >
      < mu2: [I8:shiftrel/ADVPVAR{ADVPVARrec1},
              I6:mu6, 
              I7:mu7] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, tempadvrel)
       I7: ALL (mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(tempadvrel, rel7 )
       I8: ADVPVARrec1.mood IN [wh, topicmood] AND
           tempadv IN ADVPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2
         >

   SUBRULE  (* 13a. locadvrel, PREPPVAR *)
      < mu1: [I6:mu6, 
              I8:locadvrel/PREPPVAR{PREPPVARrec1},
              I7:mu7] >
      < mu2: [I8:shiftrel/PREPPVAR{PREPPVARrec1},
              I6:mu6, 
              I7:mu7] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, locadvrel)
       I7: ALL (mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(locadvrel, rel7)
       I8: PREPPVARrec1.mood IN [wh, relativexpmood, topicmood] AND
           loc IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2
         >

   SUBRULE  (* 13b. locadvrel, ADVPVAR *)
      < mu1: [I6:mu6, 
              I8:locadvrel/ADVPVAR{ADVPVARrec1},
              I7:mu7] >
      < mu2: [I8:shiftrel/ADVPVAR{ADVPVARrec1},
              I6:mu6, 
              I7:mu7] >

   MATCHCONDITIONS
      <
       I6: ALL (mu6, I61:rel6/..)
           I61: QUOTE_Srelprec(rel6, locadvrel)
       I7: ALL (mu7, I71:rel7/..)
           I71: QUOTE_Srelprec(locadvrel, rel7)
       I8: ADVPVARrec1.mood IN [wh, topicmood] AND
           locadv IN ADVPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TWhShift
\item[* relevant examples:]\mbox{}\\
\begin{description}
    \item[1. subjrel]  Who has seen him; .. who has seen him
    \item[2. objrel] What has he bought; .. which he has bought
    \item[3. indobjrel] Whom has he given a kiss; .. whom he has given a kiss
    \item[4. predrel, ADJP] How ill is he
    \item[5a. predrel, NP] What did they elect him, What did it cost you
    \item[5b. predrel, ident NPVAR] What is this
    \item[6. predrel, PREPP] Against what are you
    \item[7a/b. locargrel] In what did you put him / Where did you put him;
       .. in which you put it 
    \item[8a/b. dirargrel] Off what did he jump / Where did he go; .. off which 
          he jumped
    \item[9. complrel] ?? (With what did she seem); ( .. with which she seemed)
    \item[10a. first prepobjrel] To whom did you talk - about your new car;
       .. to whom you talked about your new car
    \item[10b. second prepobjrel] About what did you talk to my parents - ; .. 
          about which you talked to my parents//
     Note that a condition has been formulated that a preceding prepobj must 
exist. In the startrules it is assumed that even an empty (first) prepobj 
receives a prepobjrel, although the prep itself is not spelled out.
    \item[11. byobjrel] By whom were you hit, By whom were you given this book;
       .. by whom you were given this book
    \item[12a/b. tempadvrel] When has he bought it / In which week will you be 
absent; .. in which week you will be absent
    \item[13a/b. locadvrel] Where has he bought it / In which shop have you bought 
it; .. in which shop I have bought several books
\end{description}
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) TC\_WhShift
\item[* date of creation:] 14-JUN-1988
\item[* author:] Margreet Sanders
\item[* copied from:] Dutch TWhShift1a and TWhShift1b
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/9/88\ \ \ \ \ author: margreet sanders\\
Adapted for shift of relativexpmood-NPVARs and for shift of CNVARs
\item date: 14/2/89\ \ \ \ \ author: margreet sanders\\
Adapted to allow for non-accusative (ind)objrel NP(VAR)s and CNVARs; needed 
because in TBeCaseAssign and TErgCaseAssign nominative (ind)objs are created.
\item date: 03/10/89\ \ \ \ \ author: margreet sanders\\
Adapted to allow for shifting of topicmood
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to move a wh-element or a relative to the beginning of the 
sentence, and put it in shiftrel
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] one subrule for 
every position the shifted element must be put back in (analysis)
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] In analysis the synvpefs
of the CLAUSE is reduced in accordance with the relation/cat introduced. 
In generation this reduction is not necessary, since there is only one element 
in the set to begin with.
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed that for (VAR)PREPPs, the mood has been copied from the object 
under it, or (in case of CNVAR objects) has been set to relativexpmood. The 
appropriate rules have been written for PREPP and PPPROP subgrammars, 
startrules (prepobjrel/VARPREPP) and for byobjs (voice rules).
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
Subrules 10 of TWhShift and 1 of TStrandedWhShift now both 
work in generation, so both {\em To whom did you talk about our new car\/} and 
{\em Whom did you talk to about our new car\/} are produced. A decision still 
has to be taken which of this two rules should get a lower bonus.

\item modifications:\\

\end{enumerate}
\end{description}

