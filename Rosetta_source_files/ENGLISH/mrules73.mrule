
ENGLISH 73
(* superdeixisadaptation voor complement clauses and adverbial sentences *)
&
\newpage
\begin{verbatim}
%
   % TRANSFORMATION Tnosuperdeixisadaptation
< m1:CLAUSE{CLAUSErec1}
           [I1: mu1]
>

< m :CLAUSE{CLAUSErec1}
           [I1: mu1]

>
   MATCHCONDITIONS
      <
       I1: (NOT EXIST(mu1, [I11: rel1/T1])) AND
           (NOT EXIST(mu1, [predrel/VERBP{VERBPrec1}[I12: mu2]])) AND
           (NOT EXIST(mu1, [I13: subjrel/NP{NPrec2}[mu7]]))
       I11: (rel1 IN [subjrel, complrel, prepobjrel, extraposrel]) AND
             (T1.CAT = SENTENCE)
       I12: (EXIST (mu2, [I121: rel2/T2])) OR
            (EXIST (mu2, [prepobjrel/PREPP{PREPPrec1}[I122: mu3]])) OR
            (EXIST (mu2, [predrel/ADJP{ADJPrec1}[I123: mu4]])) OR
            (EXIST (mu2, [I124: rel5/NP{NPrec1}[mu5]]))
       I121: ((rel2 IN [complrel, prepobjrel]) AND
              (T2.CAT = SENTENCE)
             ) OR
             ((rel2 IN [complrel, dirargrel, locargrel, predrel]) AND
              (T2.CAT IN [OPENADJPPROP, CLOSEDADJPPROP, OPENNPPROP,
                          CLOSEDNPPROP, OPENADVPPROP, CLOSEDADVPPROP, 
                          OPENVERBPPROP, CLOSEDVERBPPROP, OPENPREPPPROP,
                          CLOSEDPREPPPROP]
              )
             )
       I122: EXIST(mu3, [I1221: rel3/T3]) OR
             EXIST(mu3, [I1222: objrel/NP{NPrec1}[mu6]])
       I1221:(rel3 IN [complrel, objrel]) AND
              (T3.CAT IN [OPENADJPPROP, CLOSEDADJPPROP, OPENNPPROP,
                          CLOSEDNPPROP, OPENADVPPROP, CLOSEDADVPPROP, 
                          OPENVERBPPROP, CLOSEDVERBPPROP, OPENPREPPPROP,
                          CLOSEDPREPPPROP, SENTENCE]
              )
       I1222: NPrec1.NPhead IN [SentNP, OpenIngNp]
       I123:  EXIST(mu4, [I1231: rel4/T4])
       I1231: (rel4 IN [degreemodrel, forobjrel, hoprel] AND
               T4.CAT IN [ADVP, PREPP, NP, QP]) 
              OR
              (rel4 IN AUX_sentencerels AND
               T4.CAT IN [SENTENCE])
       I124: rel5 IN [subjrel, indobjrel, objrel] AND
             NPrec1.NPhead IN [SentNP, OpeningNP]
       I13: NPrec2.NPhead IN [SentNP, OpeningNP]

      >

      COMP
         <
          C1:true
          A1: @
         >

      DECOMP
         <
          C1:true
          A1: @
         >

&

\end{verbatim}
