% TRANSFORMATION TNPposTOpostmod
< m1:NP{NPrec1}[ mu1, 
                 head/CN{CNrec1}
                     [ mu2,
                       posrel/PREPP{PREPPrec1}[mu5],
                       mu3 
                     ],
                 mu4 
               ]
>

< m :NP{NPrec1}[ mu1, 
                 head/CN{CNrec1}
                     [ mu2,
                       postmodrel/PREPP{PREPPrec1}[mu5],
                       mu3 
                     ],
                 mu4 
               ]

>

      COMP
         <
          C1: PREPPrec1.headkey = KEY_ofprepkey
          A1: @
         >
      DECOMP
         <
          C1: PREPPrec1.headkey = KEY_ofprepkey
          A1: @
         >

&

\end{verbatim}
