%FIELDVALUE
BASIS RULE
  FIELDVALUE = IDENTIFIER/1 | (SQUAREOPEN/2 . (SQUARECLOSE/3 |
                              (IDENTIFIER/1 . {COMMA/4 . IDENTIFIER/1} .
                                              SQUARECLOSE/3)))
SURFACE PART

<*
 INIT:BEGIN
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
4:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_FIELDVALUE;
                END
*>
END;

PROCEDURAL PART
VAR field_value,
    fieldId,
    string     : TSTRING_string;
    NumberOfFields : INTEGER;
    recassign:LOCALFILE;
BEGIN
INIT: BEGIN
        INITLOCALFILE(recassign);
        field_value:='';
        fieldId:=$$FIELDVALUE.fieldId;
        NumberOfFields:=$$FIELDVALUE.NumberOfFieldsInh;
      END;
<*
1: <* SEND: BEGIN
              string:=%.str;
              IF TSTRING_comparebegin(string,'KEY_')=0 THEN
                BEGIN
                TSTRING_extractend(string,string,5);
                TSTRING_Append(field_value,'auxkey(''');
                TSTRING_Append(field_value,string);
                TSTRING_Append(field_value,''')');
                END
              ELSE TSTRING_Append(field_value,string);
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN 
              TSTRING_Append(field_value,'[');
            END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN
              TSTRING_Append(field_value,']');
            END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN 
              TSTRING_Append(field_value,',');
            END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN
        BEGIN
         \of2.\GLOBAL.
          "IF  (" ""fieldId"" " = " ""field_value"" 
             " ) THEN"\\
        END;
        IF NumberOfFields = 1 THEN
        BEGIN
          \of2.\GLOBAL.
           TAB(of2,6);
           "Bool:=TRUE;"\\
        END;
         \recassign.\LOCAL.
         ""fieldId"" " := " ""field_value"" 
                      ";"\\
        $$FIELDVALUE.recassign:=recassign;
        $$FIELDVALUE.NumberOfFieldsSyn:=NumberOfFields-1; 
      END;
END;
&


%ABBRSECTION
BASIS RULE
   ABBRSECTION = ABBRSETS/1 . LEFTARROW/2 . {NUMABBRS/3} . RIGHTARROW/2

SURFACE PART
VAR AbbrCounter :: INT;
    ident::ident;
    basetypes :: setofidents;
HELP FUNCTION present(ident::ident;S1::setofidents):BOOLEAN;
    VAR ident1::ident;
        result:boolean;
    begin
    result:=false;
    while stillidents(S1) and not(result) do
      begin
      takeident(ident1,S1);
      result := (ident1.str=ident.str)
      end;
    present:=result
    end;


<*
 INIT:BEGIN
        AbbrCounter:=0;
        INITsetofidents(basetypes);
      END;
1:      <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
3:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                           IF %NUMABBRS.basementioned THEN
                             BEGIN
                             ident.str:=%NUMABBRS.typeident;
                             IF NOT(present(ident,basetypes)) THEN 
                                       appendident(ident,basetypes);
                             END;
                           AbbrCounter:=AbbrCounter + 1; 
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_ABBRSECTION;
                  $ABBRSECTION.basetypes:=basetypes;
                  $ABBRSECTION.AbbrCounter:=AbbrCounter;
                END
*>
END;

PROCEDURAL PART
VAR NumOfAbbrs ::INT;
BEGIN
INIT: BEGIN 
        NumOfAbbrs:=$ABBRSECTION.AbbrCounter;
        BEGIN
        END;
      END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN
              %%NUMABBRS.NumOfAbbrsInh:=NumOfAbbrs;
            END
      !NUMABBRS.
      RECEIVE: BEGIN
                 NumOfAbbrs:=%%NUMABBRS.NumOfAbbrsSyn;
               END
   *>
*>
FINAL:BEGIN
      END;
END;
&


%NUMABBRS
BASIS RULE
  NUMABBRS = (SETTYPE/4.IDENTIFIER/5|BASETYPE/6.IDENTIFIER/5).IDENTIFIER/1.
             EQUIVALENT/2 . ABBRLIST/3

SURFACE PART
VAR typeident:TSTRING_string;
    basementioned:BOOLEAN;

<*
 INIT:BEGIN basementioned:=FALSE;
            TSTRING_constantempty(typeident);
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
3:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
4:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
5:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN typeident:=%.str
                         END
       *>
6:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN basementioned:=TRUE
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_NUMABBRS;
                  $NUMABBRS.typeident:=typeident;
                  $NUMABBRS.basementioned:=basementioned;
                END
*>
END;

PROCEDURAL PART
VAR  tempabbr     : TSTRING_string;
     NumOfAbbrs  :: INT;
     typeident: TSTRING_string;
     basementioned::bool;
BEGIN
INIT: BEGIN 
        typeident:=$NUMABBRS.typeident;
        basementioned:=$NUMABBRS.basementioned;
        NumOfAbbrs:=$$NUMABBRS.NumOfAbbrsInh;
      END;
<*
1: <* SEND: BEGIN
              tempabbr:=%.str;
              \of1.\GLOBAL.
               " FUNCTION LSAUXDOM_" ""tempabbr""
               IF basementioned then
                 BEGIN ":SETOF" END
               ELSE BEGIN ":LSDOMAINT_" END;
               ""typeident"" ";EXTERNAL;"\\
              \of2.\GLOBAL.
               " FUNCTION LSAUXDOM_" ""tempabbr""
               IF basementioned then
                 BEGIN ":SETOF" END
               ELSE BEGIN ":LSDOMAINT_" END;
               ""typeident"" ";"\\
               "BEGIN"\\
               "LSAUXDOM_" ""tempabbr"" ":="\\
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN
              %%ABBRLIST.NumOfAbbrsInh:=NumOfAbbrs;
            END
      !ABBRLIST.
      RECEIVE: BEGIN 
                 NumOfAbbrs:=%%ABBRLIST.NumOfAbbrsSyn;
               END
   *>
4: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN 
               END
   *>
5: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN 
               END
   *>
6: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN 
               END
   *>
*>
FINAL:BEGIN
        \of2.\GLOBAL. "END;"\\
        $$NUMABBRS.NumOfAbbrsSyn:=NumOfAbbrs;
      END 
END;
&


%ABBRLIST
BASIS RULE 
  ABBRLIST = SQUAREOPEN/1 . [ {IDENTIFIER/2 . COMMA/3} .
                             IDENTIFIER/2 ] . SQUARECLOSE/4

