\begin{verbatim}
% FILTER FpreNPENdeletion

< m : NP{NPrec1}[I1:mu1,
                 head/CN{CNrec1}
                         [I2:mu2,
                          I3:mu3
                         ],
                 mu4
                ]
>
   MATCHCONDITIONS
      <
       I1: ALL(mu1, I11:rel1/..)
       I11: rel1 IN [detrel, artrel]
       I2: ALL(mu2, modrel/..)
       I3: ALL(mu3, I13:rel3/..)
       I13: rel3 IN [postmodrel, posrel]
      >

(* NO COMP *)

      DECOMP
         <
          C1: true
          A1: @
         >
  
&
\end{verbatim}
