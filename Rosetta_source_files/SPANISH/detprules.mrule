\begin{verbatim}
% RULE RDETPsuperdeixis
< m1:DETP{DETPrec1}[mu1] 
>

< m :DETP{DETPrec2}[mu1] 
>

   PARAMETERS
      <
       super : tiempotype
      >

      COMP
         <
          C1: DETPrec1.supertiempo = omegatiempo AND
              super IN [presente, pasado]
          A1: DETPrec2 := DETPrec1;
              DETPrec2.supertiempo := super;
         >
      DECOMP
         <
          C1: DETPrec2.supertiempo IN [presente, pasado]
          A1: DETPrec1 := DETPrec2;
              DETPrec1.supertiempo := omegatiempo;
              super := DETPrec2.supertiempo;
         >

&

\end{verbatim}
