% RULE RNPformation5    (* ..+NOUN + posrel --> detrel + ..+NOUN *)
< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec3}[mu6],
                 mu7,
                 posrel/T1
                ]
>

< m : NP{NPrec2}[detrel/T2,
                 head/CN{CNrec1}[mu1,
                                 head/NOUN{NOUNrec3}[mu6],
                                 mu7
                                ]
                ]
>

   MATCHCONDITIONS
      <
        m: NPrec2 = { NPhead    : otherNP
                      person    : 3
                      class     : CNrec1.class
                      aspect    : CNrec1.aspect
                      deixis    : CNrec1.deixis
                      retro     : CNrec1.retro
                    }
      >

<
   SUBRULE (* 1. book my father --> my father's book *)
   
      < T1:NP{NPrec1}[mu2, 
                      head/CN{CNrec2}[mu3,
                                      head/NOUN{NOUNrec1}[mu4]] 
                     ]
      >

      < T2:NP{NPrec3}[mu2,
                      head/CN{CNrec3}[mu3,
                                      head/NOUN{NOUNrec1}[mu4]
                                     ],
                      gluerel/GLUE{},
                      modrel/GEN(KEY_genGENkey){GENrec1}
                     ] 
      >

      COMP
         <
          C1: CNrec2.poss = true AND
              NPrec1.poss = true AND
              NPrec1.cases = [] AND
              CNrec2.cases = [] 
              C11: singular IN NOUNrec3.numbers
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers
              A12: NPrec2.number := plural
          A1: NPrec2 := { posspred          : true
                          definite          : def
                          possnietnp        : NPrec1.possnietnp
                          mood              : NPrec1.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : false 
                                              (* *my father's book's color*)
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases

                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         } ;
               NPrec3 := NPrec1;
               NPrec3.actcomas  := CNrec1.posscomas;
              (* The other attributes have default values *)
              CNrec3 := CNrec2;
              CNrec3.cases := [nominative, accusative];
         >

      DECOMP
         <
           C1: CNrec3.poss = true AND
               NPrec3.poss = true AND
               NPrec3.cases = [] AND
               CNrec3.cases <> [] AND
               NPrec2 = { posspred          : true
                          definite          : def 
                          possnietnp        : NPrec3.possnietnp
                          mood              : NPrec3.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : false
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases

                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  AND
                NPrec2.actcomas * CNrec1.posscomas <> []

              C11: singular IN NOUNrec3.numbers AND
                   NPrec2.number  = singular
              A11: @
              C12: plural IN NOUNrec3.numbers AND
                   NPrec2.number = plural
              A12: @
          A1: NPrec1 := NPrec3;
              CNrec2 := CNrec3;
              CNrec2.cases := [];
         >

   SUBRULE (* 2. book I --> my book *)

      < T1:NP{NPrec1}[head/PERSPRO{PERSPROrec1}
                               [head/BPERSPRO{BPERSPROrec1}] ]
      >

      < T2:POSSADJ{POSSADJrec1}[head/BPERSPRO{BPERSPROrec1}] 
      >

      COMP
         <
          C1: PERSPROrec1 = COPYT_BPERSPROTOPERSPRO(BPERSPROrec1) AND
              PERSPROrec1.persprocase = omegacase AND
              NPrec1.actcomas * [count] <> [] AND
              NPrec1 = { req           : [pospol,negpol,omegapol]
                         env           : [pospol,negpol,omegapol]
                         superdeixis   : omegadeixis
                         class         : omegaTimeAdvClass
                         deixis        : omegadeixis
                         aspect        : omegaAspect
                         retro         : false
                         definite      : def
                         person        : PERSPROrec1.person
                         number        : PERSPROrec1.number
                         cases         : []
                         genders       : [PERSPROrec1.gender]
                         sexes         : []
                         actsubcs      : [othernoun]
                         temporal      : false
                         poss          : false 
                         animate       : PERSPROrec1.animate
                         human         : Omegahuman
                         thetanp       : omegathetanp
                         nounpatternefs: []
                         posspred      : true
                         possnietnp    : false
                         mood          : nowh
                         generic       : omegageneric
                         syntquant     : omegaquant
                         NPhead        : PERSPROrec1.NPhead
                         specQ         : yesspec
                        }

              C11: singular IN NOUNrec3.numbers
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers
              A12: NPrec2.number := plural

          A1: NPrec2 := { posspred          : true
                          definite          : def 
                          possnietnp        : false
                          mood              : POSSADJrec1.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  
 
              (* the POSSADJ happens to have default values only *)
         >

      DECOMP
         <
          C1: POSSADJrec1.antecedent = noant AND
              POSSADJrec1.mood = nowh AND
              (* both default values *)
              NPrec2 =  { posspred          : true
                          definite          : def 
                          possnietnp        : false
                          mood              : POSSADJrec1.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         } AND
                NPrec2.actcomas  * CNrec1.posscomas <> [] 
 
                 C11: singular IN NOUNrec3.numbers AND
                      NPrec2.number  = singular
                 A11: @
                 C12: plural IN NOUNrec3.numbers AND
                      NPrec2.number = plural
                 A12: @

          A1: PERSPROrec1 := COPYT_BPERSPROTOPERSPRO(BPERSPROrec1);
              NPrec1 := { req           : [pospol,negpol,omegapol]
                          env           : [pospol,negpol,omegapol]
                          superdeixis   : omegadeixis
                          class         : omegaTimeAdvClass
                          deixis        : omegadeixis
                          aspect        : omegaAspect
                          retro         : false
                          definite      : def
                          person        : PERSPROrec1.person
                          number        : PERSPROrec1.number
                          cases         : []
                          genders       : [PERSPROrec1.gender] 
                          sexes         : []
                          actsubcs      : [othernoun]
                          temporal      : false
                          poss          : false
                          animate       : PERSPROrec1.animate
                          human         : Omegahuman
                          actcomas      : [count]
                          thetanp       : omegathetanp
                          nounpatternefs: []
                          posspred      : true
                          possnietnp    : false
                          mood          : nowh
                          generic       : omegageneric
                          syntquant     : omegaquant
                          NPhead        : PERSPROrec1.NPhead
                          specQ         : yesspec
                         }
         >

   SUBRULE  (* 3. book everybody --> everybody's book *)

      < T1:NP{NPrec1}[mu2, 
                      head/INDEFPRO{INDEFPROrec1}[mu8] ]
      >

      < T2:NP{NPrec3}[mu2, 
                      head/INDEFPRO{INDEFPROrec1}[mu8],
                      gluerel/GLUE{},
                      modrel/GEN(KEY_genGENkey){GENrec1}
                     ] 
      >

      COMP
         <
          C1: INDEFPROrec1.poss = true
              C11: singular IN NOUNrec3.numbers
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers
              A12: NPrec2.number := plural
          A1: NPrec3 := NPrec1;
              NPrec2 := { posspred          : true
                          definite          : def 
                          possnietnp        : NPrec1.possnietnp
                          mood              : NPrec1.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : false
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : NPrec1.syntquant 
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  
         >

      DECOMP
         <
          C1: INDEFPROrec1.poss = true AND
              NPrec2 =  { posspred          : true
                          definite          : def 
                          possnietnp        : NPrec3.possnietnp
                          mood              : NPrec3.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : false
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : NPrec3.syntquant 
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         } AND
                 NPrec2.actcomas  * CNrec1.posscomas <> []
  
                 C11: singular IN NOUNrec3.numbers AND
                      NPrec2.number  = singular
                 A11: @
                 C12: plural IN NOUNrec3.numbers AND
                      NPrec2.number = plural
                 A12: @
          A1:  NPrec1 := NPrec3;
         >


   SUBRULE (* 4. book John --> John's book *) 

      < T1: NP{NPrec1}[mu2, head/PROPERNOUN{PROPERNOUNrec1}[mu9]]
      >

      < T2: NP{NPrec3}[mu2, head/PROPERNOUN{PROPERNOUNrec1}[mu9],
                            gluerel/GLUE{},
                            modrel/GEN(KEY_genGENkey){GENrec1}
                      ] 
      >

      COMP
         <
          C1: PROPERNOUNrec1.poss = true
              C11: singular IN NOUNrec3.numbers
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers
              A12: NPrec2.number := plural
          A1: NPrec3 := NPrec1;
              NPrec2 := { posspred          : true
                          definite          : def 
                          possnietnp        : NPrec1.possnietnp
                          mood              : nowh
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : false
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : NPrec1.syntquant 
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  
         >

      DECOMP
         <
          C1: PROPERNOUNrec1.poss = true AND
              NPrec2 =  { posspred          : true
                          definite          : def 
                          possnietnp        : NPrec3.possnietnp
                          mood              : nowh
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : false
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : NPrec3.syntquant 
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         } AND
               NPrec2.actcomas  * CNrec1.posscomas <> [] 
  
                 C11: singular IN NOUNrec3.numbers AND
                      NPrec2.number  = singular
                 A11: @
                 C12: plural IN NOUNrec3.numbers AND
                      NPrec2.number = plural
                 A12: @
          A1:  NPrec1 := NPrec3;
         >

   SUBRULE (* 5. book who --> whose book *) 

      < T1:NP{NPrec1}[head/WHPRO{WHPROrec1}[head/BWHPRO{BWHPROrec1}]]
      >

      < T2:POSSADJ{POSSADJrec1}[head/BWHPRO{BWHPROrec1}]
      >

      COMP
         <
          C1: WHPROrec1 = COPYT_BWHPROTOWHPRO(BWHPROrec1) AND
              WHPROrec1.cases = [] AND
              WHPROrec1.poss = true AND
              NPrec1 = NPrecdef EXCEPT FOR [definite, number, sexes,
                       animate, poss, human, mood, specQ, posspred] AND
              NPrec1 = { definite      : indef
                         number        : WHPROrec1.number
                         sexes         : WHPROrec1.sexes
                         animate       : WHPROrec1.animate
                         poss          : WHPROrec1.poss
                         human         : yeshuman
                         mood          : wh
                         specQ         : yesspec
                         posspred      : true
                        }
              C11: singular IN NOUNrec3.numbers
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers
              A12: NPrec2.number := plural
          A1: POSSADJrec1.mood := wh;
              NPrec2  := { posspred          : true
                           definite          : indef 
                           possnietnp        : false
                           mood              : POSSADJrec1.mood 
                           nounpatternefs    : CNrec1.nounpatternefs
                           thetanp           : CNrec1.thetanp
                           actcomas          : CNrec1.posscomas
                           human             : CNrec1.human
                           animate           : CNrec1.animate
                           poss              : CNrec1.poss
                           temporal          : CNrec1.temporal
                           actsubcs          : CNrec1.actsubcs
                           sexes             : CNrec1.sexes
                           genders           : CNrec1.genders
                           cases             : CNrec1.cases
                          
                           specQ      : yesspec (* auxiliary *)
                           syntquant  : omegaquant (* auxiliary *)
                           generic    : nogeneric
                           superdeixis: omegadeixis
                          }  
         >

      DECOMP
         <
          C1: POSSADJrec1.antecedent = noant AND
              POSSADJrec1.mood = wh AND
              BWHPROrec1.poss = true AND 
              NPrec2 =  { posspred          : true
                          definite          : indef 
                          possnietnp        : false
                          mood              : POSSADJrec1.mood 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         } AND
               NPrec2.actcomas  * CNrec1.posscomas <> []
  
                 C11: singular IN NOUNrec3.numbers AND
                      NPrec2.number  = singular
                 A11: @
                 C12: plural IN NOUNrec3.numbers AND
                      NPrec2.number = plural
                 A12: @
          A1: WHPROrec1 := COPYT_BWHPROTOWHPRO(BWHPROrec1);
              WHPROrec1.cases := [];
              NPrec1 := { definite      : indef
                          number        : WHPROrec1.number
                          sexes         : WHPROrec1.sexes
                          poss          : WHPROrec1.poss
                          animate       : WHPROrec1.animate
                          human         : yeshuman
                          mood          : wh
                          specQ         : yesspec

                          req           : [pospol,negpol,omegapol]
                          env           : [pospol,negpol,omegapol]
                          superdeixis   : omegadeixis
                          class         : omegaTimeAdvClass
                          deixis        : omegadeixis
                          aspect        : omegaAspect
                          retro         : false
                          person        : 3
                          cases         : []
                          genders       : [omegagender] 
                          actsubcs      : [othernoun]
                          temporal      : false
                          actcomas      : [count]
                          thetanp       : omegathetanp
                          nounpatternefs: []
                          posspred      : true
                          possnietnp    : false
                          generic       : omegageneric
                          syntquant     : omegaquant
                          NPhead        : otherNP
                         }
              (* these bottom attributes have default values *)
         >
>

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] RNPformation5
\item[* relevant examples:] \mbox{}
\begin{enumerate}
\item (SUBRULE 1) book my father $\rightarrow$ my father's book 
\item (SUBRULE 2) book I $\rightarrow$ my book 
\item (SUBRULE 3) book everyone $\rightarrow$ everyone's book
\item (SUBRULE 4) book John $\rightarrow$ John's book
\item (SUBRULE 5) book who $\rightarrow$ whose book
\end{enumerate}
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) NPformationrules
\item[* date of creation:] 21-JUN-1988 16:05:19  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/02/89\ \ \ \ \ author: Margreet Sanders. See below.
\item date: 27/07/89\ \ \ \ \ author: Margreet Sanders\\
Added a check on CN copy of class, aspect, deixis, retro, and default
NPhead, person. Added a copy of CN cases to NP. In subrule 1: made possnietnp 
copy of NP.
\item date: 01/08/89\ \ \ \ \ author: Margreet Sanders. See below.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Changing a postnominal `posrel' (modification of a CN 
containing a NOUN) into a prenominal `detrel' (book I $\rightarrow$ my book, etc.)
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
`my father's book' is semantically equivalent to `the book of my father',
`my book' to `the book of mine', etc.
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
Ad SUBRULE 3, A1:  NPrec2.definite := def\\
It is assumed that `somebody's book' is def, considering the Dutch 
*{\em Er} ligt iemands boek op tafel.
If this sentence turns out to be grammatical though, `definite := def'  can
be changed into:   `NPrec2.definite := INDEFPRO.definite'
\item modifications:\\
28-02-89: \\
1. The rules have been adapted to harbour a genitive {\em 's\/} where 
necessary. \\
2. Also, NPrec1[mu1,..] has been removed from the left model and has been 
incorporated in the T1 of the Subrules, since in subrules 3 and 4 assignments 
were made to NPrec1, while they were not needed. Incorporation in the 
subrule model makes this clear. The assignments have been removed.\\
3. In subrules 1, 3 and 4 the (inherent) attribute {\em poss\/} of the head of 
T1 now remains the same; hence the need to copy this record also does not exist 
anymore. Probably, changing the attribute `poss' was caused by a 
misunderstanding of its meaning: contrary to Dutch, it merely indicates whether 
a certain category may take a genitive {\em 's\/}, not whether this genitive 
has also been realised (there is no attribute indicating that, since the 
genitive is present as a category in the tree). Moreover, in subrule 2 the 
attribute {\em poss\/} of the NP over a PERSPRO is set to {\em false\/}, in 
accordance with NPformation8. \\
01-08-89: \\
Subrule 1: made empty cases percolate in analysis (needed because RCNmodposs 
expects an empty case NP, and NPformation expects that cases of NP and CN are 
the same); in generation, the set of 
all possible cases is assigned to CN, since there is no way to know 
which cases there originally were in analysis. This means that the subrule is 
not fully reversible! The rule would work as well if 
there was no such assignment in generation (CN may remain caseless), but the 
current assignment makes the rule at least partly reversible.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RNPformation10
< m1: I2::CN{CNrec1}[I1:mu1]
>

< m : NP{NPrec1}[head/I2::CN{CNrec1}[I1:mu1]]
>

   MATCHCONDITIONS             
   (* meant to block the formation of NP out of EN 
      plus an numerical modifier or a postmodifier
      while there is no ADJP or SENTENCE  *)
      < 
        I1: ( EXIST(mu1, [head/NOUN{NOUNrec1}[mu8]]) OR
              EXIST(mu1, [I11:modrel/T1])) AND
            NOT EXIST(mu1, [posrel/NP{NPrec2}[mu9]])

        I11: T1.CAT IN  [ADJP, SENTENCE]
         m: NPrec1 = { NPhead            : otherNP
                       person            : 3
                       class             : CNrec1.class
                       deixis            : CNrec1.deixis
                       aspect            : CNrec1.aspect
                       retro             : CNrec1.retro
                     }
        I2: (CNrec1.definite <> def )
              (* in order to prevent the definite CN 'three books'
                 to become an NP *) 
            AND
             ((mass IN CNrec1.posscomas) OR 
              (plural IN CNrec1.numbers))
               (* to exclude `king' and `yellow book';
                  NB. `he is king' is formed IN the NPPROP-subgrammar *)

      >

      COMP
         <
          C1: true
             C11: singular IN CNrec1.numbers AND
                  mass IN CNrec1.posscomas
             A11: NPrec1.number := singular;
                  NPrec1.actcomas := [mass]
             C12: plural IN CNrec1.numbers AND
                  count IN CNrec1.posscomas
             A12: NPrec1.number := plural;
                  NPrec1.actcomas := [count]

           A1: NPrec1 := { nounpatternefs    : CNrec1.nounpatternefs
                           thetanp           : CNrec1.thetanp
                           human             : CNrec1.human
                           animate           : CNrec1.animate
                           poss              : CNrec1.poss
                           temporal          : CNrec1.temporal
                           actsubcs          : CNrec1.actsubcs
                           sexes             : CNrec1.sexes
                           genders           : CNrec1.genders
                           cases             : CNrec1.cases
                          
                           specQ      : yesspec (* auxiliary *)
                           syntquant  : omegaquant (* auxiliary *)
                           generic    : nogeneric
                           superdeixis: omegadeixis
                         } ;
               NPrec1.definite := indef;
               NPrec1.posspred := true;
               NPrec1.possnietnp := false
         >

      DECOMP
         <
          C1: NPrec1.definite = indef AND
              NPrec1.posspred =  true AND
              NPrec1.possnietnp = false AND
              NPrec1  = { nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis }

              C11: NPrec1.actcomas * [mass] <> [] AND
                   NPrec1.number = singular  AND
                   CNrec1.posscomas * [mass] <> [] AND
                   singular IN CNrec1.numbers

              A11: @
              C12: NPrec1.actcomas * [count] <> [] AND
                   NPrec1.number = plural AND
                   CNrec1.posscomas * [count] <> [] AND
                   plural IN CNrec1.numbers
              A12: @

           A1: @
         >
&

\end{verbatim}
