SPANISH 39
&
\newpage
\begin{verbatim}
%
% RULE Rfinpresentdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu5, [tempadvrel/..])
      >

<
   SUBRULE
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            (ADVPVARrec1.tiempo = presente) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto <> perfectivo) OR
               ((CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = presente) (* switch*)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := presente;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo= presente) AND
              ((CLAUSErec2.aspecto <> perfectivo) OR
               ((CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro =false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.supertiempo = omegatiempo) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := presente;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              CLAUSErec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            (PREPPVARrec1.tiempo = presente) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto <> perfectivo) OR
               ((CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = presente)  (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := presente;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo= presente) AND
              ((CLAUSErec2.aspecto <> perfectivo) OR
               ((CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.supertiempo = omegatiempo) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := presente;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              CLAUSErec1.tiempo := omegatiempo;

         >


   SUBRULE
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            (SENTENCErec1.conjtiempo = presente) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              ((CLAUSErec1.aspecto <> perfectivo) OR
               ((CLAUSErec1.aspecto = perfectivo) AND
                (CLAUSErec1.retro = false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = presente)  (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := presente;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := presente;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = presente) AND
              (VERBrec2.futuro = nofuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo= presente) AND
              ((CLAUSErec2.aspecto <> perfectivo) OR
               ((CLAUSErec2.aspecto = perfectivo) AND
                (CLAUSErec2.retro =false ->
                 QUOTE_tempdurnotfound(mu5))
               )
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.supertiempo = omegatiempo) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := presente;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              CLAUSErec1.tiempo := omegatiempo;

         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpresentdeixis
\item[* relevant examples:] duerme
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 17-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresentdeixis dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 31/01/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on retro. 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT.
               This rule is for a finite independent clause.
               The most left verb in the clause gets a present tense.
               The deixis 
value of the reference adverbial is checked for 
               present or omega.
               The clause is marked for present deixis.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be presentdeixis in the case 
this sentence is a sentence with adverbs such as {\em graag} in Dutch. 
In Spanish this may be 
the case in cases in which e.g. a verb is a semantic head but behaves as an  
auxiliary verb (e.g. some perifrasis verbales or may be modal verbs)\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rfinpastdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu5, [tempadvrel/..])
      >

<
   SUBRULE
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            ((ADVPVARrec1.tiempo = pasado) OR
             (ADVPVARrec1.tiempo = omegatiempo)
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              (
               (VERBrec1.aspecto = omegaaspecto) OR   (* voor subjuntivo pasado *) 
               (VERBrec1.aspecto = perfectivo) OR 
               (VERBrec1.aspecto = imperfectivo)
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado)  (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (
               (VERBrec1.aspecto = omegaaspecto) OR   (* voor subjuntivo pasado *) 
               (VERBrec1.aspecto = perfectivo) OR 
               (VERBrec1.aspecto = imperfectivo) 
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.supertiempo = omegatiempo) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := pasado;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              CLAUSErec1.tiempo := omegatiempo;

         >

   SUBRULE
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I2: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            ((PREPPVARrec1.tiempo = pasado) OR
             (PREPPVARrec1.tiempo = omegatiempo)
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              (
               (VERBrec1.aspecto = omegaaspecto) OR   (* voor subjuntivo pasado *) 
               (VERBrec1.aspecto = perfectivo) OR 
               (VERBrec1.aspecto = imperfectivo) 
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado)  (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (
               (VERBrec1.aspecto = omegaaspecto) OR   (* voor subjuntivo pasado *) 
               (VERBrec1.aspecto = perfectivo) OR 
               (VERBrec1.aspecto = imperfectivo) 
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.supertiempo = omegatiempo) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := pasado;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              CLAUSErec1.tiempo := omegatiempo;

         >


   SUBRULE
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5: [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I2: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            ((SENTENCErec1.conjtiempo = pasado) OR
             (SENTENCErec1.conjtiempo = omegatiempo)
            )
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo= omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.finiteness = finite) AND
              (
               (VERBrec1.aspecto = omegaaspecto) OR   (* voor subjuntivo pasado *) 
               (VERBrec1.aspecto = perfectivo) OR 
               (VERBrec1.aspecto = imperfectivo) 
              )
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado)  (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;

         >
      DECOMP
         <
          C1:((VERBrec2.tiempo = pasado) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = pasado) AND
              (VERBrec2.futuro = nofuturo) AND
              (
               (VERBrec1.aspecto = omegaaspecto) OR   (* voor subjuntivo pasado *) 
               (VERBrec1.aspecto = perfectivo) OR 
               (VERBrec1.aspecto = imperfectivo) 
              )
             )
              C11: (CLAUSErec2.supertiempo = omegatiempo)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.supertiempo = omegatiempo) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := pasado;
 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              CLAUSErec1.tiempo := omegatiempo;

         >

>
&

\end{verbatim}
