object mp_toggle_frame : XmFrame {
    arguments {
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmFrame mp_rule_frame;
        XmNleftAttachment    = XmATTACH_FORM;
        XmNrightAttachment   = XmATTACH_FORM;
    };
    controls {
        XmRowColumn mp_toggles;
    };    
};

object mp_toggles : XmRowColumn {
    arguments {
        XmNorientation = XmVERTICAL;
    };
    controls {
        XmToggleButton {
            arguments {
                XmNlabelString = N_mp_tree_toggle;
                XmNfontList    = big;
            };
            callbacks {
                MrmNcreateCallback = procedure
                                         XwuCreateWidget (X_mp_tree_toggle);
            };
        };
        XmToggleButton {
            arguments {
                XmNlabelString = N_mp_trace_toggle;
                XmNfontList    = big;
            };
            callbacks {
                MrmNcreateCallback = procedure
                                         XwuCreateWidget (X_mp_trace_toggle);
            };
        };
    };
};

object mp_button_box : XmRowColumn {
    arguments {
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame mp_toggle_frame;
        XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;

        arguments button_box_args;
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton mp_start_button;
        XmPushButton mp_step_button;
        XmPushButton mp_stop_button;
        XmPushButton mp_treein_button;
        XmPushButton mp_treeout_button;
        XmPushButton mp_help_button;
    };
};

object mp_start_button : XmPushButton {
    arguments {
	arguments button_args;
        XmNlabelString       = N_mp_start_button;
        XmNsensitive         = false;
    };
    callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_mp_start_button);
        XmNactivateCallback = procedure
            XwbAction(X_mp_start_button);
    };
};

