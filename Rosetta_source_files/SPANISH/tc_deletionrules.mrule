\begin{verbatim}
%
% TRANSFORMATION TPROSUBJdel
< m1: I2::SENTENCE{SENTENCErec1}[ I1:mu1,
                              subjrel/NP{NPrec1}
                                     [head/PERSPRO{PERSPROrec1}[head/T1]
                                     ],
                              mu5,
                              head/VERB{VERBrec1}[mu3],
                              mu4
                            ]
>

< m : I2::SENTENCE{SENTENCErec1}[ I1:mu1,
                              mu5,
                              head/VERB{VERBrec1}[mu3],
                              mu4
                            ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [subjrel/..])
       I2: SENTENCErec1.finiteness = finite AND
           SENTENCErec1.restructuring = false AND
           SENTENCErec1.mood <> imperativemood    (* JO  1-SEP-1988 16:34:56 *)
      >

<
   SUBRULE
      < T1:BPERSPRO(KEY_yomascBPERSPROkey){BPERSPROrec1}>
      < >

      COMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 1)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                  EXCEPT FOR [numero, persona, genero]) AND
              (NPrec1.numero = singular)                                AND
              (NPrec1.persona = 1)                                      AND
              (NPrec1.genero = masc)
          A1:  @
         >

      DECOMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 1)
 
          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);

              NPrec1 := AUX_NPONnomBPRSPR;                     
              NPrec1.numero := singular;                     
              NPrec1.persona := 1;
              NPrec1.genero := masc
         >


   SUBRULE
      < T1:BPERSPRO(KEY_yofemBPERSPROkey){BPERSPROrec1}>
      < >

      COMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 1)       AND

              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                  EXCEPT FOR [numero, persona,genero]) AND
              (NPrec1.numero = singular)                                AND
              (NPrec1.persona = 1)                                      AND
              (NPrec1.genero = fem)
          A1:  @
         >

      DECOMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 1)
 
          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);

              NPrec1 := AUX_NPONnomBPRSPR;                     
              NPrec1.numero := singular;                     
              NPrec1.persona := 1;
              NPrec1.genero := fem
         >


   SUBRULE
      < T1:BPERSPRO(KEY_tumascBPERSPROkey){BPERSPROrec1}>
      < >

      COMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 2)       AND
 
              (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))  AND

              (NPrec1 = AUX_NPONnomBPRSPR 
                                   EXCEPT FOR [numero, persona, genero]) AND
              (NPrec1.numero = singular)                                AND
              (NPrec1.persona = 2)                                      AND
              (NPrec1.genero = masc)
          A1:  @
         >

      DECOMP
         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 2)
  
          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);

              NPrec1 := AUX_NPONnomBPRSPR;                     
              NPrec1.numero := singular;                     
              NPrec1.persona := 2;
              NPrec1.genero := masc
         >


   SUBRULE
      < T1:BPERSPRO(KEY_tufemBPERSPROkey){BPERSPROrec1}>
