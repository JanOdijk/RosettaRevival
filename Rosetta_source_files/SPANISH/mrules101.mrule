\begin{verbatim}
% RULE Rconjsent5
< m1:SENTENCE{SENTENCErec1}[ I1:mu1 ] 
  m2:CONJ(KEY_gerCONJkey){CONJrec2}
>

< m : SENTENCE{SENTENCErec2}[I1:mu1 ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[I11:rel1/..])
           I11: rel1 IN [shiftrel, conjrel]
      >

      COMP
         <
          C1: synOPENGERSENT IN CONJrec2.conjpatterns          AND
              CONJrec2.adverbial = true                     AND
              SENTENCErec1 =                  
		  {
		  senttype   : subordinateclause
                  finiteness : infinite
                  infsort    : omegainf
                  modo       : gerundio
		  conjkey    : 0
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
                  PROsubject : true
                  restructuring : false
		  }
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2 :=                  
		  {
		  adverbial  : true
		  temporal   : false
		  conjclass  : omegatimeadvclass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
		  };
         >
      DECOMP
         <
          C1: SENTENCErec2 =                  
		  {
		  senttype   : subordinateclause
                  finiteness : infinite
                  infsort    : omegainf
                  modo       : gerundio
		  conjkey    : 0
		  adverbial  : true
		  temporal   : false
		  conjclass  : omegatimeadvclass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
                  restructuring : false
		  }

          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1 :=                  
		  {
		  conjkey    : 0
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
		  }
         >


&

\end{verbatim}
