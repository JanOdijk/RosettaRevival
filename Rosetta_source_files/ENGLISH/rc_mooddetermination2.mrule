\newpage
\begin{verbatim}
% RULE RAnterelIngMood
< m1: I3::CLAUSE{CLAUSErec1}
                [ I1:subjrel/T1,
                  mu1,
                  predrel/VERBP{VERBPrec1}
                         [ I5:mu2,
                           sig1,
                           I21: rel1/VERB{VERBrec1}[mu3],
                           I6: mu4
                         ],
                  mu5
                ] 
>

< m : I4::SENTENCE{SENTENCErec1}
                  [ I1:subjrel/T1,
                    mu1,
                    predrel/VERBP{VERBPrec1}
                           [ I5:mu2,
                             sig2,
                             I22: rel1/VERB{VERBrec2}[mu3], 
                             I6: mu4
                           ],
                    mu5
                  ] 
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I21:((rel1 IN [head, passauxrel]) OR
            ((rel1 = auxrel) AND (VERBrec1.subc = haveverb))
           ) AND
           (VERBrec1.ingform <> noing)
       I22:((rel1 IN [head, passauxrel]) OR
            ((rel1 = auxrel) AND (VERBrec2.subc = haveverb))
           ) AND
           (VERBrec2.ingform <> noing)
       I3: CLAUSErec1.PROsubject = true AND
           CLAUSErec1.finiteness = infinite AND
           CLAUSErec1.infsort = omegainf AND
           CLAUSErec1.modus = omegamodus
       I4: SENTENCErec1 = { mood       : anterelative
                            senttype   : subordinateclause
                            modus      : ingform
                            finiteness : infinite
                            PROsubject : true
                            infsort    : opening
                            conjkey    : 0
                            adverbial  : false
                            temporal   : false
                            conjclass  : omegaTimeadvClass
                            conjdeixis : omegadeixis
                            conjaspect : omegaAspect
                            conjretro  : false } 
       I5: NOT EXIST (mu2, [../VERB{VERBrec3}[mu6]])
       I6: NOT EXIST (mu4, [../I7::VERB{VERBrec4}[mu7]])
       I7: VERBrec4.modus = ingform
      >
<
   SUBRULE (* swimming, eating *)
      <sig1: [progauxrel/VERB{VERBrec5}
                        [head/SUBVERB{SUBVERBrec1}
                             [head/BVERB(KEY_bebverbkey){BVERBrec1}]
                        ]
             ] >
      <sig2: [ ] >

      COMP
         <
          C1: VERBrec1.modus = ingform AND
              CLAUSErec1.aspect = imperfective AND
              SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix AND
              VERBrec5 = COPYT_subverbtoverb(SUBVERBrec1) AND
              VERBrec5 =
                        { modus   : omegamodus
                          tense   : omegatense
                          persons : []
                          numbers : []
                        }
          A1: VERBrec2 := VERBrec1;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood       : anterelative
                                senttype   : subordinateclause
                                modus      : ingform
                                finiteness : infinite
                                infsort    : opening }
         >

      DECOMP
         <
          C1: VERBrec2.modus = ingform AND
              SENTENCErec1.aspect = imperfective 
          A1: VERBrec1 := VERBrec2;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.infsort := omegainf;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1) ;
              VERBrec5 := COPYT_subverbtoverb(SUBVERBrec1);
         >

   SUBRULE (* being ill, having eaten an apple *)
      <sig1: [ ] >
      <sig2: [ ] >

      COMP
         <
          C1: VERBrec1.modus = omegamodus 
             C11:CLAUSErec1.aspect = imperfective AND
                 rel1 <> auxrel AND
                 CLAUSErec1.aktionsarts * [stative] <> []
             A11: @ 
             C12: (rel1 = auxrel)
             A12: @

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := ingform;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood       : anterelative
                                senttype   : subordinateclause
                                modus      : ingform
                                finiteness : infinite
                                infsort    : opening }

         >

      DECOMP
         <
          C1: VERBrec2.modus = ingform 
              C11: SENTENCErec1.aspect = imperfective AND
                   rel1 <> auxrel AND
                   SENTENCErec1.aktionsarts * [stative] <> []
              A11: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
                   CLAUSErec1.aktionsarts := [stative];
              C12: (rel1 = auxrel)
              A12: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
          A1: VERBrec1 := VERBrec2;
              VERBRec1.modus := omegamodus;
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.infsort := omegainf
         >
>
&

\end{verbatim}
