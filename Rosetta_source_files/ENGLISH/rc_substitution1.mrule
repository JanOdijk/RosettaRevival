            [ mu1,
              shiftrel/PREPP{PREPPrec1}
                      [ mu3,
                        I5:rel2/T4=I4::NP{NPrec2}[I8:mu8],
                        mu4
                      ],
              mu2,
              predrel/VERBP{VERBPrec1}[mu5],
              mu6 
            ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_Gsubstordercondition(mu2, mu5, mu6, T3, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T3)
       m : QUOTE_substordercondition(mu2, mu5, mu6, CLAUSErec1.prosubject)
       I1: NPVARrec1.index = LEVEL 
       I3: NOT (NPrec1.NPhead IN [reflNP, reciproNP, sentNP, openIngNP])
       I4: NOT (NPrec2.NPhead IN [reflNP, reciproNP, sentNP, openIngNP])
       I5: NOT QUOTE_NegPhrase(T4)
       I7: NOT EXIST (mu7, [head/BIGPRO{}[mu10]])
       I8: NOT EXIST (mu8, [head/BIGPRO{}[mu11]])
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) 
                                EXCEPT FOR [cases,mood] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
