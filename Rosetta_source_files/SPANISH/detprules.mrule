SPANISH 74
&
\begin{verbatim}
%
% RULE DETderivation1
< m1: BDET{BDETrec1} 
>

< m : DET{DETrec1}[head/BDET{BDETrec1}]
>


      COMP
         <
          C1: true
              C11: BDETrec1.flection = true  OR
                   BDETrec1.key <> KEY_ningunBDETkey OR
                   BDETrec1.key <> KEY_ningunaBDETkey OR
                   BDETrec1.key <> KEY_ningunoBDETkey 
                   C111: singular IN BDETrec1.possnumbers 
                   A111: DETrec1.numero := singular;
                         DETrec1.genero := masc;
                   C112: singular IN BDETrec1.possnumbers 
                   A112: DETrec1.numero := singular;
                         DETrec1.genero := fem;
                   C113: plural IN BDETrec1.possnumbers 
                   A113: DETrec1.numero := plural;
                         DETrec1.genero := masc;
                   C114: plural IN BDETrec1.possnumbers 
                   A114: DETrec1.numero := plural;
                         DETrec1.genero := fem;
              A11: @
              (* geen C12/A12 *)
              C13: BDETrec1.flection = false AND
                   (BDETrec1.key = KEY_ningunBDETkey OR
                   BDETrec1.key = KEY_ningunaBDETkey OR
                   BDETrec1.key = KEY_ningunoBDETkey )
                   C131: BDETrec1.key = KEY_ningunBDETKEY
                   A131: DETrec1.numero := singular;
                         DETrec1.genero := masc;
                   C132: BDETrec1.key = KEY_ningunaBDETKEY
                   A132: DETrec1.numero := singular;
                         DETrec1.genero := fem;
                   C131: BDETrec1.key = KEY_ningunoBDETKEY
                   A132: DETrec1.numero := singular;
                         DETrec1.genero := neutro;
              A13: @
          A1: DETrec1 := 
                         {
                          definite    : BDETrec1.definite
                          posspred    : BDETrec1.posspred
                          posscomas   : BDETrec1.posscomas
                          mood        : BDETrec1.mood
                         }
         >

      DECOMP
         <
          C1: DETrec1 = 
                         {
                          definite    : BDETrec1.definite
                          posspred    : BDETrec1.posspred
                          posscomas   : BDETrec1.posscomas
                          mood        : BDETrec1.mood
                         }
              C11: BDETrec1.flection = true  OR
                   BDETrec1.key <> KEY_ningunBDETkey OR
                   BDETrec1.key <> KEY_ningunaBDETkey OR
                   BDETrec1.key <> KEY_ningunoBDETkey 
                C111: singular IN BDETrec1.possnumbers AND
                      DETrec1.genero = masc AND
                      DETrec1.numero = singular
                A111: @
                C112: singular IN BDETrec1.possnumbers AND
                      DETrec1.genero = fem AND
                      DETrec1.numero = singular
                A112: @
                C113: plural IN BDETrec1.possnumbers AND
                      DETrec1.genero = masc AND
                      DETrec1.numero = plural
                A113: @
                C114: plural IN BDETrec1.possnumbers AND
                      DETrec1.genero = fem AND
                      DETrec1.numero = plural
                A114: @
              A11: @
              C13: BDETrec1.flection = false AND
                   (BDETrec1.key = KEY_ningunBDETkey OR
                   BDETrec1.key = KEY_ningunaBDETkey OR
                   BDETrec1.key = KEY_ningunoBDETkey )
                   C131: BDETrec1.key = KEY_ningunBDETKEY AND
                         DETrec1.genero = masc AND
                         DETrec1.numero = singular
                        
                   A131: @
                   C132: BDETrec1.key = KEY_ningunaBDETKEY AND
                         DETrec1.genero = fem AND
                         DETrec1.numero = singular
                        
                   A132: @
                   C133: BDETrec1.key = KEY_ningunoBDETKEY AND
                         DETrec1.genero = neutro AND
                         DETrec1.numero = singular
                   A133: @
              A13: @
          A1: @
         >

&

\end{verbatim}
