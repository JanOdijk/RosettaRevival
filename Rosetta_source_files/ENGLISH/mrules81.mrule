\newpage
\begin{verbatim}
% TRANSFORMATION taktaccomplishment2
< m1:VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu6], 
                       mu3,
                       I1: rel1/T1,
                       mu4,
                       dirargrel/PREPPPROPVAR{PREPPPROPVARrec1}[],
                       mu5
                      ],
               mu7
              ]
>

< m :VERBPPROP{VERBPPROPrec2}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu6], 
                       mu3,
                       I1: rel1/T1,
                       mu4,
                       dirargrel/PREPPPROPVAR{PREPPPROPVARrec1}[],
                       mu5
                      ],
               mu7
              ]

>
   MATCHCONDITIONS
      < I1: (rel1 IN [objrel, prepobjrel])  AND
            ((T1.CAT IN [NPVAR, VARPREPP] WITH T1.REC.specq= yesspec) OR
             (T1.CAT = CNVAR)
            )
      >
      COMP
         <
          C1: 
              (movementclass IN VERBrec1.classes) AND
              (VERBrec1.thetavp IN [vp123] OR
               (VERBrec1.thetavp IN [vp120] AND VERBrec1.adjuncts <> [])
              ) AND
              (PREPPPROPVARrec1.specq = yesspec) AND
              (VERBPPROPrec1.aktionsarts = [])
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.aktionsarts := [accomplishment];
