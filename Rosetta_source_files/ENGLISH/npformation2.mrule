\newpage
\begin{verbatim}
% RULE RNPPresentSuperdeixis2
< m1: NP{NPrec1}[mu1,
                 I1:head/N1[mu4],
                 mu2
                 ] 
>

< m: NP{NPrec2}[mu1,
                 I1:head/N1[mu4],
                 mu2
                 ] 
>

   MATCHCONDITIONS
      <
       m1: NPrec1.superdeixis = omegadeixis
       m: NPrec2.superdeixis = presentdeixis
       I1: N1.cat IN [PERSPRO, WHPRO, INDEFPRO, PROPERNOUN, 
                      DEMPRO, RECIPRO, CARD, BIGPRO]
      >


      COMP
         <
          C1: true
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := presentdeixis;
         >
      DECOMP
         <
          C1: true
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := omegadeixis;
         >
&

\end{verbatim}
