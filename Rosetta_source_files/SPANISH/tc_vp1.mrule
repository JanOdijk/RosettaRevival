          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHEROPENPREPPPROP];
              rel1 := complrel
         >

   SUBRULE (*25*)
      <T1: EMPTYVAR{EMPTYVARrec1} >
      <T1: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synDIREMPTY IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIREMPTY];
              rel1 := dirargrel
         >


>
&

\end{verbatim}
