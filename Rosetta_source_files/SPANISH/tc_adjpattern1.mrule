\newpage
\begin{verbatim}
% TRANSFORMATION TADJPATTERN12a      (* non-empty non-sententional
                                       prepositional object: 
                                       enamorado de, seguro de, destinado a/ 
                                       para, acostumbrado a*)

< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                       predrel/ADJP{ADJPrec1}
                              [
                               head/ADJ{ADJrec1}[mu2],
                               argrel/T1
                              ]
                       ]
>

< m : ADJPPROP{ADJPPROPrec2}[mu1,
                       predrel/ADJP{ADJPrec2}
                              [head/ADJ{ADJrec1}[mu2],
                               prepobjrel/VARPREPP{VARPREPPrec1}
                                          [head/PREP(ADJrec1.prepkey){PREPrec1},
                                           objrel/T1
                                          ]
                              ]
                       ]
>
<
   SUBRULE (* 1 *)      
      <T1: NPVAR{NPVARrec1}>
      <T1: NPVAR{NPVARrec1}>

      COMP
         <
          C1: (synPREPNP IN ADJrec1.adjpatterns) AND
              (ADJPrec1.adjpatternefs = []) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synPREPNP];
              ADJPPROPrec2.adjpatternefs := [synPREPNP];
              VARPREPPrec1 := VARPREPPRECDEF;
              VARPREPPrec1.specQ := NPVARrec1.specQ;
              VARPREPPrec1.actsubcefs:= PREPrec1.subcs;
              VARPREPPrec1.headkey := PREPrec1.key;
              VARPREPPrec1.synppefs := [synNP];
              VARPREPPrec1.thetapp := pp120

         >

      DECOMP
         <
          C1: (synPREPNP IN ADJPPROPrec2.adjpatternefs) AND
              (synPREPNP IN ADJPrec2.adjpatternefs) AND
              (synPREPNP IN ADJrec1.adjpatterns) AND
              (PREPrec1.key = ADJrec1.prepkey) AND 
              (VARPREPPrec1 = VARPREPPRECDEF 
                EXCEPT FOR [synppefs, headkey, thetapp, actsubcefs, specQ]) AND
              (synNP IN VARPREPPrec1.synppefs) AND
              (VARPREPPrec1.specQ = NPVARrec1.specQ) AND
              (VARPREPPrec1.actsubcefs = PREPrec1.subcs) AND
              (VARPREPPrec1.headkey = PREPrec1.key) AND
              (VARPREPPrec1.thetapp = pp120)

          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []


         >

   SUBRULE (* 2 *)
      <T1: CNVAR{CNVARrec1}>
      <T1: CNVAR{CNVARrec1}>


      COMP
         <
          C1: (synPREPNP IN ADJrec1.adjpatterns) AND
              (ADJPrec1.adjpatternefs = []) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synPREPNP];
              ADJPPROPrec2.adjpatternefs := [synPREPNP];
              VARPREPPrec1 := VARPREPPRECDEF;
              VARPREPPrec1.specQ := NPVARrec1.specQ;
              VARPREPPrec1.actsubcefs:= PREPrec1.subcs;
              VARPREPPrec1.headkey := PREPrec1.key;
              VARPREPPrec1.synppefs := [synNP];
              VARPREPPrec1.thetapp := pp120

         >

      DECOMP
         <
          C1: (synPREPNP IN ADJPPROPrec2.adjpatternefs) AND
              (synPREPNP IN ADJPrec2.adjpatternefs) AND
              (synPREPNP IN ADJrec1.adjpatterns) AND
              (PREPrec1.key = ADJrec1.prepkey) AND 
              (VARPREPPrec1 = VARPREPPRECDEF 
                EXCEPT FOR [synppefs, headkey, thetapp, actsubcefs, specQ]) AND
              (synNP IN VARPREPPrec1.synppefs) AND
              (VARPREPPrec1.specQ = NPVARrec1.specQ) AND
              (VARPREPPrec1.actsubcefs = PREPrec1.subcs) AND
              (VARPREPPrec1.headkey = PREPrec1.key) AND
              (VARPREPPrec1.thetapp = pp120)

          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []


         >
>
&

\end{verbatim}
