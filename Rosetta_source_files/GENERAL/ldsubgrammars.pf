 *
 *EMP:::===================================================================*)

PROCEDURE ldsubgrammars_Init;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : ldsubgrammars_TheCtrlExpr
 *  Description     : 
 *  Precondition    : 
