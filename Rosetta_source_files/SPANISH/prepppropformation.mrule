\newpage
\begin{verbatim}
% TRANSFORMATION tpreppattern1
< m1:PREPPPROP{PREPPPROPrec1}
        [ mu1,
          predrel/PREPP{PREPPrec1}
              [ head/PREP{PREPrec1},
                argrel/T1,
                mu2
              ]
        ]
>

< m :PREPPPROP{PREPPPROPrec2}
        [ mu1,
          predrel/PREPP{PREPPrec2}
              [ head/PREP{PREPrec1},
                rel1/T1,
                mu2
              ]
        ]
>

<
   SUBRULE
      <T1:T2 >
      <T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR,CNVAR]
      >

      COMP
         <
          C1: synNP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  AND
              PREPPPROPrec1.synppefs = []  
          A1: rel1 := objrel;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synNP];
              PREPPPROPrec2 := PREPPPROPrec1;
              PREPPPROPrec2.synppefs := [synNP];
         >
      DECOMP
         <
          C1:  synNP IN PREPrec1.synpps AND
               rel1 = objrel            AND
               synNP IN PREPPrec2.synppefs AND
               synNP IN PREPPPROPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
              PREPPPROPrec1 := PREPPPROPrec2;
              PREPPPROPrec1.synppefs := [];
         >


   SUBRULE         (* de antes de la guerra *)
      <T1:T2 >
      <T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [PREPPVAR]
      >

      COMP
         <
          C1: synLOCPREPP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  AND
              PREPPPROPrec1.synppefs = []  
          A1: rel1 := objrel;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synLOCPREPP];
              PREPPPROPrec2 := PREPPPROPrec1;
              PREPPPROPrec2.synppefs := [synLOCPREPP];
         >
      DECOMP
         <
          C1:  synLOCPREPP IN PREPrec1.synpps AND
               rel1 = objrel            AND
               synLOCPREPP IN PREPPrec2.synppefs AND
               synLOCPREPP IN PREPPPROPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
              PREPPPROPrec1 := PREPPPROPrec2;
              PREPPPROPrec1.synppefs := [];
         >



   SUBRULE       (* tot morgen, sinds gisteren *)
      <T1:T2 >
      <T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [ADVPVAR]
      >

      COMP
         <
          C1: synLOCPREPP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  AND
              PREPPPROPrec1.synppefs = []  
          A1: rel1 := objrel;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synLOCPREPP];
              PREPPPROPrec2 := PREPPPROPrec1;
              PREPPPROPrec2.synppefs := [synLOCPREPP];
         >
      DECOMP
         <
          C1:  synLOCPREPP IN PREPrec1.synpps AND
               rel1 = objrel            AND
               synLOCPREPP IN PREPPrec2.synppefs AND
               synLOCPREPP IN PREPPPROPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
              PREPPPROPrec1 := PREPPPROPrec2;
              PREPPPROPrec1.synppefs := [];
         >


>


&

\end{verbatim}
