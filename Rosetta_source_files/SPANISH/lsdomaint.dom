< UTT             : NOrecord >

< ADJPPROPVAR     : ADJPPROPVARrecord >
< ADVPPROPVAR     : ADVPPROPVARrecord >
< CLAUSEVAR       : CLAUSEVARrecord >
< CNVAR           : CNVARrecord >
< NPPROPVAR       : NPPROPVARrecord >
< PREPPVAR        : PREPPVARrecord >
< PREPPPROPVAR    : PREPPPROPVARrecord >
