\newpage
\begin{verbatim}
% RULE RADJaspectimperfective
< m1:ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [mu2,
                    head/ADJ{ADJrec1}[mu3],
                    I1: mu4
                   ],
            mu5
           ] 
>

< m :ADJPFORMULA{ADJPFORMULArec2}
           [mu1,
            predrel/ADJP{ADJPrec2}
                   [mu2,
                    head/ADJ{ADJrec1}[mu3],
                    I1: mu4
                   ],
            mu5
           ] 
>
   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu4) AND
           QUOTE_temprefnotfound(mu4) AND
           QUOTE_tempretronotfound(mu4)
      >

      COMP
         <
          C1: ADJPFORMULArec1.aspect = ADJrec1.aspect AND
              ADJPrec1.aspect = ADJrec1.aspect
          A1: ADJPFORMULArec2 := ADJPFORMULArec1;
              ADJPFORMULArec2.aspect := imperfective;
              ADJPrec2 := ADJPrec1;
              ADJPrec2.aspect := imperfective;
         >

      DECOMP
         <
          C1: ADJPFORMULArec2.aspect = imperfective AND
              ADJPrec2.aspect = imperfective
          A1: ADJPFORMULArec1 := ADJPFORMULArec2;
              ADJPFORMULArec1.aspect := ADJrec1.aspect;
              ADJPrec1 := ADJPrec2;
              ADJPrec1.aspect := ADJrec1.aspect;
         >

&

\end{verbatim}

