\newpage
\begin{verbatim}
% RULE RADVPdegreemod1

< m1: I3::ADVP{ADVPrec1}
                    [head/ADV{ADVrec1}[mu2],
                     mu3
                    ]

  m2: T2
>

< m: I4::ADVP{ADVPrec2}
                   [I1:degreemodrel/T2,
                    head/ADV{ADVrec1}[mu2],
                    mu3
                    ]

>

   MATCHCONDITIONS
      <I1: T2.cat IN [QP, ADVP]
       m2: T2.cat IN [QP, ADVP]
       I3: ADVPrec1.temporal = true
       I4: ADVPrec2.temporal = true
      >

<

   SUBRULE (* 1 *) (* *)

      <T2: QP{QPrec1}[I2:mu7]>
      <T2: QP{QPrec2}[I2:mu7]>

   MATCHCONDITIONS
      <
       I2: ALL(mu7, I12:rel1/..)
       I12: rel1 IN [head, degreemodrel]
      >

      COMP
         <
          C1: QPrec1.supertiempo = ADVPrec1.supertiempo
          A1: QPrec2 := QPrec1;
              QPrec2.supertiempo := omegatiempo;
              ADVPrec2 := ADVPrec1;
              ADVPrec2.mood := QPrec2.mood  (* m.h.o. op een WH-QP *)

         >
      DECOMP
         <
          C1: QPrec2.supertiempo = omegatiempo AND
              ADVPrec2.mood = QPrec2.mood
          A1: QPrec1 := QPrec2;
              QPrec1.supertiempo := ADVPrec2.supertiempo;
              ADVPrec1 := ADVPrec2;
              ADVPrec1.mood := declxpmood          
>

   SUBRULE  (* 2 *) (* *)

      <T2: ADVP{ADVPrec3}[I2:mu6]>
      <T2: ADVP{ADVPrec4}[I2:mu6]>

   MATCHCONDITIONS
      <
       I2: ALL(mu6, I12:rel1/..)
       I12: rel1 IN [head, degreemodrel]
      >

      COMP
         <
          C1: degreeadv IN ADVPrec3.actsubcefs AND
              ADVPrec1.supertiempo = ADVPrec3.supertiempo
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec4 := ADVPrec3;
              ADVPrec4.supertiempo := omegatiempo;
              ADVPrec2.mood := ADVPrec4.mood;  (* m.h.o. op een WH-ADV *)
         >
      DECOMP
         <
          C1: degreeadv IN ADVPrec3.actsubcefs  AND
              ADVPrec4.supertiempo = omegatiempo AND
              ADVPrec2.mood = ADVPrec4.mood  
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec3 := ADVPrec4;
              ADVPrec3.supertiempo := ADVPrec1.supertiempo;
              ADVPrec1.mood := declxpmood          
         >
>

&

\end{verbatim}
