SPANISH 100
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TArgreflspelling1
< m1:CLAUSE{CLAUSErec1}
        I1:[ mu1,
             rel1/NPVAR{NPVARrec1},
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      cliticrel/CLITIC{CLITICrec1}
                               [ I4:sig1,
                                 I5:sig2,
                                 I6:sig3,
                                 I7:sig4
                               ],
                      mu3,
                      rel2/NPVAR{NPVARrec2},
                      mu4
                    ],
             mu5
           ]
>

< m :CLAUSE{CLAUSErec1}
        I1:[ mu1,
             rel1/NPVAR{NPVARrec1},
             mu2,
             predrel/VERBP{VERBPrec1}
                 I2:[ mu6,
                      cliticrel/CLITIC{CLITICrec1}
                               [ I8:sig5,
                                 I9:sig6,
                                 I10:sig7,
                                 I11:sig8
                               ],
                      mu3,
                      rel2/NP{NPrec1}[ head/PERSPRO{PERSPROrec1}[head/T1], 
                                       modrel/ADJP{ADJPrec1}
                                         [ head/ADJ{ADJrec1}
                                            [ head/SUBADJ{SUBADJrec1}
                                               [head/BADJ(KEY_mismoBADJkey){BADJrec1} ] 
                                            ] 
                                         ]
                                     ],
                      mu4
                    ],
             mu5
           ]
>

   MATCHCONDITIONS
      <
       m1 : NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
            NOT EXIST (mu3, [../I13::NPVAR{NPVARrec3}]) AND
            NOT EXIST (mu4, [../I14::NPVAR{NPVARrec4}]) AND
            NOT EXIST (mu4, [../VARPREPP{}[mu7,../I15::NPVAR{NPVARrec5},mu8]]) 
       I1 : RIGHTTOLEFT
       I2 : RIGHTTOLEFT
(*       I3 : NPrec1.NPhead = zichzelfNP *)
       I13: NPVARrec3 = NPVARrec1 EXCEPT FOR [cases] 
       I14: NPVARrec4 = NPVARrec1 EXCEPT FOR [cases] 
       I15: NPVARrec5 = NPVARrec1 EXCEPT FOR [cases]
(*       m  : NOT EXIST (mu3, [../I16::NP{NPrec2}[mu6]]) *)
(*       I16: NPrec2.NPhead = zichzelfNP *)
       I4: ALL(sig1, reflrel/..)
       I5: ALL(sig2, dosCLrel/..)
       I6: ALL(sig3, unoCLrel/..)
       I7: ALL(sig4, tresCLrel/..)
       I8: ALL(sig5, reflrel/..)
       I9: ALL(sig6, dosCLrel/..)
       I10: ALL(sig7, unoCLrel/..)
       I11: ALL(sig8, tresCLrel/..)

      >
<
   SUBRULE   (* me ... a mí mismo *)
      < sig3: [] >
      < sig5: [sig1] sig6:[sig2] sig8:[sig4] 
        sig7:[unoCLrel/REFLPRO(KEY_meREFLPROkey){REFLPROrec1}]
        T1: BPERSPRO(KEY_yomascBPERSPROkey){BPERSPROrec1}
     >

      COMP
         <
          C1: NPVARrec1 =  {
                             persona : 1 
                             numero  : singular
                             genero  : masc
                           }
              C11: NPVARrec1.human <>  nohuman AND
                   Prepositive IN NPVARrec2.cases
              A11: @ 
              C11: NPVARrec1.human = nohuman AND
                   Accusative IN NPVARrec2.cases
              A11: @ 
          A1: PERSPROrec1 := COPYT_bTOperspro(BPERSPROrec1);
              PERSPROrec1.forma := prepfuerte; 
              NPrec1 := AUX_NPONmismo;
              NPrec1.cases := [Prepositive];
              NPrec1 := 
                           {
                             persona : 1 
                             numero  : singular
                             genero  : masc
                           };
              SUBADJrec1 := AUX_SUBADJonmismo;
              ADJrec1 := AUX_ADJonmismo;
              ADJrec1.genero := masc;
              ADJrec1.numero := singular;
              ADJPrec1 := AUX_ADJPonmismo;
              ADJPrec1.genero := masc;
              ADJPrec1.numero := singular;
         >
      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bTOperspro(BPERSPROrec1) 
                      EXCEPT FOR [forma] AND
              PERSPROrec1.forma = prepfuerte AND
              SUBADJrec1 = AUX_SUBADJonmismo AND
              ADJrec1 = AUX_ADJonmismo EXCEPT FOR [genero, numero] AND
              ADJrec1.genero = masc AND
              ADJrec1.numero = singular AND
              ADJPrec1 = AUX_ADJPonmismo EXCEPT FOR [genero, numero] AND
              ADJPrec1.genero = masc AND
              ADJPrec1.numero = singular AND
              NPVARrec1 =  {
                             persona : 1 
                             numero  : singular
                             genero  : masc
                           }                     AND
               NPrec1 = AUX_NPONmismo EXCEPT FOR 
                  [cases, persona, numero, genero] AND
               NPrec1 = 
                           {
                             persona : 1 
                             numero  : singular
                             genero  : masc
                           } AND
               Prepositive IN  NPrec1.cases
               C11: NPVARrec1.human <> nohuman 
               A11: NPVARrec2 := NPVARrec1;
                    NPVARrec2.cases := [Prepositive] 
               C12: NPVARrec1.human = nohuman 
               A12: NPVARrec2 := NPVARrec1;
                    NPVARrec2.cases := [Accusative] 
          A1:  NPVARrec2 := NPVARrec1;
               NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE   (* me ... a mí misma *)
      < sig3: [] >
      < sig5: [sig1] sig6:[sig2] sig8:[sig4] 
        sig7:[unoCLrel/REFLPRO(KEY_meREFLPROkey){REFLPROrec1}]
        T1: BPERSPRO(KEY_yofemBPERSPROkey){BPERSPROrec1}
