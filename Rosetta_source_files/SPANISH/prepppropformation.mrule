\newpage
\begin{verbatim}
% RULE rstartpreppprop120   (* en la casa *)
< m1:SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1} ] 
  m2:T1
  m3:T2
>

< m :PREPPPROP{PREPPPROPrec1}
         [ I1:subjrel/T1,
           predrel/PREPP{PREPPrec1}
                  [ head/PREP{PREPrec1},
                    I2:argrel/T2
                  ]
         ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN AUX_VARCATSET
       I2: T2.CAT IN AUX_VARCATSET
       m2: T1.CAT IN AUX_VARCATSET
       m3: T2.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: PREPrec1.thetapp = pp120 AND
              SUBPREPrec1 = PREPrec1   
              C11: T2.CAT IN [NPVAR] WITH T2.REC.specq = nospec
              A11: PREPPrec1   := PREPPrecdef;
                   PREPPrec1.specq := nospec;
              C12: (T2.CAT <> NPVAR) OR
                   (T2.CAT IN [NPVAR] WITH T2.REC.specq = yesspec)
              A12: PREPPrec1   := PREPPrecdef;
                   PREPPrec1.specq := nospec;
          A1: PREPPrec1.thetapp := pp120;
              PREPPrec1.headkey := PREPrec1.key;
	      PREPPrec1.actsubcefs := PREPrec1.subcs;
	      PREPPrec1.class := PREPrec1.class;
	      PREPPrec1.tiempo := PREPrec1.tiempo;
	      PREPPrec1.aspecto:= PREPrec1.aspecto;
	      PREPPrec1.retro := PREPrec1.retro;
              PREPPPROPrec1 := COPYT_prepptopreppprop(PREPPrec1);
              PREPPPROPrec1.aktionsarts := [stative];
         >
      DECOMP
         <
          C1: PREPrec1.thetapp = pp120                              AND
              PREPPrec1   = PREPPrecdef                  
                   EXCEPT FOR [thetapp, headkey, actsubcefs, class,
                                tiempo, aspecto, retro, specq]       AND
              PREPPrec1.thetapp = pp120                             AND
              PREPPrec1.headkey = PREPrec1.key                      AND
	      PREPPrec1.actsubcefs = PREPrec1.subcs                 AND
	      PREPPrec1.class = PREPrec1.class                      AND
	      PREPPrec1.tiempo = PREPrec1.tiempo                    AND
	      PREPPrec1.aspecto= PREPrec1.aspecto                   AND
	      PREPPrec1.retro = PREPrec1.retro                      AND
              PREPPPROPrec1 = COPYT_PREPPtoPREPPPROP(PREPPrec1)     AND
              PREPPPROPrec1 =
		  {
		  PROsubject : false
		  aktionsarts : [stative]
		  }
              C11: (T2.CAT IN [NPVAR] WITH T2.REC.specq = nospec) AND
                   PREPPrec1.specq = nospec
              A11: @
              C12: (T2.CAT <> NPVAR) OR
                   (T2.CAT IN [NPVAR] WITH T2.REC.specq = yesspec) AND
                   PREPPrec1.specq = yesspec
              A12: @
          A1: SUBPREPrec1 := PREPrec1;
         >

&

\end{verbatim}
