\newpage
\begin{verbatim}
% RULE RCNmodanterel1    
< SUBST:
  m1:CN{CNrec1}[I1:mu1] 
  m2:I2::SENTENCE{SENTENCErec1}
                 [ subjrel/CNVAR{CNVARrec1},
                   mu2,
                   predrel/VERBP{VERBPrec1}
                         [ mu3,
                           head/VERB{VERBrec1}[mu4] 
                         ] 
                 ]
>

< m :CN{CNrec1}
       [ modrel/I3::SENTENCE{SENTENCErec2}
               [ mu2,
                 predrel/VERBP{VERBPrec1}
                        [ mu3,
                          head/VERB{VERBrec1}[mu4] 
                        ] 
               ],
         I1:mu1 
       ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [head/EN{ENrec1}])
       I2: SENTENCErec1 = 
               { mood       : anterelative
                 PROsubject : true
                 modus      : ingform
               }
       I3: SENTENCErec2 = 
               { mood       : anterelative
                 PROsubject : true
                 modus      : ingform
               }
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: CNVARrec1.index = LEVEL AND
              CNVARrec1 =  COPYT_CNtoVAR(CNrec1) EXCEPT FOR [cases] AND
              CNVARrec1.cases = [] AND
              (* req and env still to be accounted for *)
              SENTENCErec1.superdeixis = CNrec1.superdeixis AND
              SENTENCErec1.deixis = omegadeixis
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.superdeixis := omegadeixis;
         >

      DECOMP
         <
          C1: SENTENCErec2.superdeixis = omegadeixis AND
              SENTENCErec2.deixis = omegadeixis
          A1: CNVARrec1 := COPYT_CNtoVAR(CNrec1);
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [];
              SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.superdeixis := CNrec1.superdeixis;
              (* req and env still to be accounted for *)
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] CNmodanterel1
\item[* relevant examples:]
child + [x1 walking] $\rightarrow$ [walking child]
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) Modrules
\item[* date of creation:] 18-MAR-1988 15:27:48  
\item[* author:] Franciska de Jong
\item[* copied from:] DUTCH
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 22/03/88\ \ \ \ \ author: Franciska de Jong
\item date: 28/10/88\ \ \ \ \ author: Lisette Appelo
\end{enumerate}
\item[* task:] To modify a CN by an anterelative sentence containing
a present participle.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
The participle must crucially be the last element in the SENTENCE for
its functioning as an anterelsent to be possible. Hence there are no
variables behind the verb.
\item[\ \ clarification of the splitting up into subrules:] dna
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: 28/10/88: Superdeixis conditions/actions added. ONly 
temporally dependent anterelclauses are allowed, because temporally independent 
clauses would require a  referential adverbial to the right of the VERBP which 
is not allowed here. Maybe an abstract non-overt referential adverbial that 
would be interpreted in the context would be possible, but it is left out for 
Rosetta3 that only translates isolated sentences. \\

\end{enumerate}
\end{description}
\newpage
\begin{verbatim}
% RULE RCNmodbareNP
< m1: I3::CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2]
                ] 
               
  m2: NP{NPrec1}[I1:mu3,
                 head/I4::CN{CNrec2}[I2:mu4]
                ]
>

< m: I3::CN{CNrec1}[mu1,
                    head/NOUN{NOUNrec1}[mu2],
                    modrel/PREPP{PREPPrec1}
                              [head/PREP(KEY_ofprepkey){PREPrec1},
                               objrel/I5::NP{NPrec2}[I1:mu3,
                                                     head/I4::CN{CNrec3}[I2:mu4]
                                                     ]
                              ]
                   ]

>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu3, [detrel/..])
       I2: EXIST(mu4, [head/NOUN{NOUNrec8}[mu8]])
       I3: count IN CNrec1.posscomas AND
           CNrec1.thetanp = omegathetanp AND
           CNrec1.animate = noanimate
       I4: CNrec2.definite <> def AND
           ((mass IN CNrec2.posscomas) OR
            (plural IN CNrec2.numbers)) 
       I5:  NPrec2.definite = indef
      >

      COMP
         <
          C1: NPrec1.superdeixis = CNrec1.superdeixis AND
              NPrec1.generic = nogeneric
          A1: NPrec2:= NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              CNrec3: = CNrec2;
              NPrec2.cases := [nominative];
              CNrec3.cases := [nominative];
         >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis AND
              NPrec2.generic = omegageneric AND
              nominative IN NPrec2.cases AND
              nominative IN CNrec3.cases 
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := CNrec1.superdeixis;
              NPrec1.cases := [];
              NPrec1.generic := nogeneric;
              CNrec2 := CNrec3;
              CNrec2.cases := [];
         >


&

\end{verbatim}
