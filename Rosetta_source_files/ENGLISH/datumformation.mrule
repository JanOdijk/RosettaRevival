\newpage
\begin{verbatim}
% RULE RNPDayOrd
< m1: NP{NPrec1}[head/PROPERNOUN{PROPERNOUNrec1}[mu1],
                 mu2
                 ]

  m2: DETP{DETPrec1}[head/CARD{CARDrec1}[mu3]]

>

< m : NP{NPrec1}[premodrel/ADJ{ADJrec1}
                          [head/SUBADJ{SUBADJrec1}
                               [modrel/CARD{CARDrec1}[mu3],
                                head/BADJSUFF(KEY_ordBADJSUFFkey){BADJSUFFrec1} 
                               ]
                           ],
                 head/PROPERNOUN{PROPERNOUNrec1}[mu1],
                 mu2
                ] 
>

      COMP
         <
          C1:NPrec1.actsubcs = [monthnoun] AND
             DETprec1.superdeixis = NPrec1.superdeixis
          A1:SUBADJrec1 := COPYT_badjtosubadj(BADJSUFFrec1);
             SUBADJrec1.affix := ordaffix;
             ADJrec1 := COPYT_subadjtoadj(SUBADJrec1);

         >
      DECOMP
         <
          C1:monthnoun IN NPrec1.actsubcs AND
             ADJrec1 = COPYT_subadjtoadj(SUBADJrec1) AND
             SUBADJrec1 = COPYT_badjtosubadj(BADJSUFFrec1) 
                                        EXCEPT FOR [affix] AND
             SUBADJrec1.affix = ordaffix
          A1:DETPrec1.superdeixis := NPrec1.superdeixis;
         >

&

\end{verbatim}
