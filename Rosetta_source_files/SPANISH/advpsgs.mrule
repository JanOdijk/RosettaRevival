\begin{verbatim}
% RULE RADVaspectimperfective
< m1:ADVPFORMULA{ADVPFORMULArec1}
           [mu1,
            predrel/ADVP{ADVPrec1}
                   [mu2,
                    head/ADV{ADVrec1}[mu3],
                    I1: mu4
                   ],
            mu5
           ] 
>

< m :ADVPFORMULA{ADVPFORMULArec2}
           [mu1,
            predrel/ADVP{ADVPrec1}
                   [mu2,
                    head/ADV{ADVrec1}[mu3],
                    I1: mu4
                   ],
            mu5
           ] 
>
   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu4) AND
           QUOTE_temprefnotfound(mu4) AND
           QUOTE_tempretronotfound(mu4)
      >

      COMP
         <
          C1: ADVPFORMULArec1.aspecto = omegaaspecto
          A1: ADVPFORMULArec2 := ADVPFORMULArec1;
              ADVPFORMULArec2.aspecto := imperfectivo;
         >

      DECOMP
         <
          C1: ADVPFORMULArec2.aspecto = imperfectivo
          A1: ADVPFORMULArec1 := ADVPFORMULArec2;
              ADVPFORMULArec1.aspecto := omegaaspecto;
         >
&

\end{verbatim}

