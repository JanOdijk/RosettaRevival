Sid_strings                 	: exported asciz_string_table (

/* 0      : empty string
   1 - 19 : message strings
   20 ... : error strings

   the last string is empty
*/

"",							! S_empty

"Found ambiguous words, select meanings with inspect",	! S_AmbiguousWords
"Please enter a sentence",				! S_Enter_sentence
"Please change the input window",			! S_Change_input
"Creating and initializing subprocesses....",		! S_Start_message
"Enter ----------- -------- NEXT STOP NEW OPTIONS",	! S_Menu_next
"Enter ----------- NEXT-LEX ---- STOP NEW OPTIONS",	! S_Menu_next_lex
"Enter NEXT-STRUCT -------- ---- STOP NEW OPTIONS",	! S_Menu_next_struct
"Enter ----------- NEXT-LEX NEXT STOP NEW OPTIONS",	! S_Menu_next_lex_next
"Enter NEXT-STRUCT -------- NEXT STOP NEW OPTIONS",	! S_Menu_next_struct_next
"Enter NEXT-STRUCT NEXT-LEX NEXT STOP NEW OPTIONS",	! S_Menu_all_next
"Enter NEXT-STRUCT NEXT-LEX ---- STOP NEW OPTIONS",	! S_Menu_next_struct_lex
"Enter ----------- -------- ---- STOP NEW OPTIONS",	! S_Menu_stop_new
"",
"",
"",
"",
"",
"",
"",

"The marked words are unknown or misspelt, please change them",
							! S_ERROR_ASegm
"The marked words are unknown or misspelt, please change them.",
							! S_ERROR_ALextree
"Unknown Rulename",					! S_ERROR_InCorrectRuleName
"Wrong S-tree specification ",				! S_ERROR_UnknownStreeSpec
"Incorrect set of attribute - value pairs",		! S_ERROR_InCorrectNode
"The set of trees is empty",				! S_ERROR_NoTreesFound
"No rule or transformation has been executed yet",	! S_ERROR_NoLastRule     
"No node was selected in the tree",                     ! S_ERROR_NoNodeSelected
"No line was selected to expand",                       ! S_ERROR_NoAttrSelected
"No extra information",                                 ! S_ERROR_NoExtraInfo
"No attributes to this node",                           ! S_ERROR_NoAttributes
"Reached the maximum number of screens",                ! S_ERROR_MaxNrScreens

"Do you really want to exit ?",                         ! S_QUESTION_Exit
"No meanings were selected, is this ok ?",              ! S_QUESTION_ZeroMeanings
"" );
