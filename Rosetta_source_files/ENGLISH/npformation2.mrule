         <
          C1: CNrec1.superdeixis = pastdeixis
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := pastdeixis;
              CNrec2 := CNrec1;
              CNrec2.superdeixis := omegadeixis;
         >
      DECOMP
