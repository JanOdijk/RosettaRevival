         >
      DECOMP
         <
          C1:((CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.superdeixis = presentdeixis) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (VERBrec2 =
                {
                  numbers     : []
                  persons     : []
                  modus       : omegamodus
                  tense       : presenttense
                }
              ) AND
              (SUBVERBrec1.affix = noaffix) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false)
             )
              C11: true
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

              C12: true                          (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
              VERBrec1 :=
                {
                  numbers     : []
                  persons     : []
                  modus       : omegamodus
                  tense       : omegatense
                };

         >

>
   SUBRULE (* 3 first verb is will *)
      <mu3: [auxrel/VERB{VERBrec2}
                   [head/SUBVERB{SUBVERBrec1}
                        [head/BVERB(KEY_willbverbkey){BVERBrec1}]
                   ],
            I7:rel3/VERB{VERBrec1}[mu9], mu10
            ] 
      >
      <mu4: [auxrel/VERB{VERBrec5}
                   [head/SUBVERB{SUBVERBrec1}
                        [head/BVERB(KEY_willbverbkey){BVERBrec1}]
                   ],
             I7:rel3/VERB{VERBrec1}[mu9], mu10
            ]
      >

   MATCHCONDITIONS
      <
       I7: (rel3 IN [passauxrel, head, progauxrel]) OR
           ((rel3 IN [auxrel]) AND
           (VERBrec1.subc = haveverb))
      >


<
   SUBRULE (* 3a *)
      <mu5: [mu6, I9:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I9:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I9: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            (ADVPVARrec1.deixis = futuredeixis) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec2.tense = omegatense) AND
              (CLAUSErec1.finiteness = finite)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;

             C12: (CLAUSErec1.superdeixis = presentdeixis) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec5 := VERBrec2;
              VERBrec5.tense := presenttense;

         >
      DECOMP
         <
          C1:((VERBrec5.tense = presenttense) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = omegadeixis) 
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

              C12: (CLAUSErec2.superdeixis = presentdeixis) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec2 := VERBrec5;
              VERBrec2.tense := omegatense;

         >

   SUBRULE (* 3b *)
      <mu5: [mu6, I9: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5: [mu6, I9: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I9: ((PREPPVARrec1.class = reference) AND
            (PREPPVARrec1.retro = false) AND
            (PREPPVARrec1.deixis = futuredeixis) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec2.tense = omegatense) AND
              (CLAUSErec1.finiteness = finite) 
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;

             C12: (CLAUSErec1.superdeixis = presentdeixis) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec5 := VERBrec2;
              VERBrec5.tense:= presenttense;

         >
      DECOMP
         <
          C1:((VERBrec5.tense = presenttense) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = omegadeixis) 
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

              C12: (CLAUSErec2.superdeixis = presentdeixis) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec2 := VERBrec5;
              VERBrec2.tense := omegatense;

         >

   SUBRULE (* 3c *)
      <mu5: [mu6, I9: tempadvrel/SENTENCE{SENTENCErec1}[mu11], mu7]>
      <mu5: [mu6, I9: tempadvrel/SENTENCE{SENTENCErec1}[mu11], mu7]>

   MATCHCONDITIONS
      <
       I9: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            (SENTENCErec1.conjdeixis = futuredeixis) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec2.tense = omegatense) AND
              (CLAUSErec1.finiteness = finite) 
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := presentdeixis;

             C12: (CLAUSErec1.superdeixis = presentdeixis) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec5 := VERBrec2;
              VERBrec5.tense := presenttense;

         >
      DECOMP
         <
          C1:((VERBrec5.tense = omegatense) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = omegadeixis) 
             )
              C11: (CLAUSErec2.superdeixis = presentdeixis)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := omegadeixis;

              C12: (CLAUSErec2.superdeixis = presentdeixis) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
 
          A1: VERBrec2 := VERBrec5;
              VERBrec2.tense := omegatense;

         >

>
>
