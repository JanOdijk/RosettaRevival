*o(OE)(MED1)(MED2)(MED3)(UU)en+(B)+(A3) :: *ó(OE)(MED1)(MED2)(MED3)(UU)en(B)(A3) ;



*aen+(B)+(A3) :: *áen(B)(A3) ;

*een+(B)+(A3) :: *éen(B)(A3) ;

*oen+(B)+(A3) :: *óen(B)(A3) ;


*a(MED1)(UU)en+(B)+(A3) :: *á(MED1)(UU)en(B)(A3) ;

*e(MED1)(UU)en+(B)+(A3) :: *é(MED1)(UU)en(B)(A3) ;

*i(MED1)(UU)en+(B)+(A3) :: *í(MED1)(UU)en(B)(A3) ;

*o(MED1)(UU)en+(B)+(A3) :: *ó(MED1)(UU)en(B)(A3) ;

*u(MED1)(UU)en+(B)+(A3) :: *ú(MED1)(UU)en(B)(A3) ;



*a(MED1)(MED2)(UU)en+(B)+(A3) :: *á(MED1)(MED2)(UU)en(B)(A3) ;

*e(MED1)(MED2)(UU)en+(B)+(A3) :: *é(MED1)(MED2)(UU)en(B)(A3) ;

*i(MED1)(MED2)(UU)en+(B)+(A3) :: *í(MED1)(MED2)(UU)en(B)(A3) ;

*o(MED1)(MED2)(UU)en+(B)+(A3) :: *ó(MED1)(MED2)(UU)en(B)(A3) ;

*u(MED1)(MED2)(UU)en+(B)+(A3) :: *ú(MED1)(MED2)(UU)en(B)(A3) ;


*a(MED1)(MED2)(MED3)(UU)en+(B)+(A3) :: *á(MED1)(MED2)(MED3)(UU)en(B)(A3) ;

*e(MED1)(MED2)(MED3)(UU)en+(B)+(A3) :: *é(MED1)(MED2)(MED3)(UU)en(B)(A3) ;

*i(MED1)(MED2)(MED3)(UU)en+(B)+(A3) :: *í(MED1)(MED2)(MED3)(UU)en(B)(A3) ;

*o(MED1)(MED2)(MED3)(UU)en+(B)+(A3) :: *ó(MED1)(MED2)(MED3)(UU)en(B)(A3) ;

*u(MED1)(MED2)(MED3)(UU)en+(B)+(A3) :: *ú(MED1)(MED2)(MED3)(UU)en(B)(A3) ;



{ 1st person pl. + se; compremos - comprémoselo }

*amos + se + (A3) :: *ámose(A3) ;

*emos + se + (A3) :: *émose(A3) ;


{ irregular Imperativo-forms }

*pón +  (B) + (A3) :: *pón(B)(A3) ;

*haz +  (B) + (A3) :: *ház(B)(A3) ;

*sal +  (B) + (A3) :: *sál(B)(A3) ;

*val +  (B) + (A3) :: *vál(B)(A3) ;

*está + (B) + (A3) :: *está(B)(A3) ;

*esté + (B) + (A3) :: *esté(B)(A3) ;

*dé   + (B) + (A3) :: *dé(B)(A3) ;

*da   + (B) + (A3) :: *dá(B)(A3) ;     { e.g. dámelo  21/4/89  EvM }


{ ********************************************************** }

{ dividing a word into four segments }

{ infinitivo; comprar - comprártemelo }

*ar + (D) + (E) + (F)  ::  *ár(D)(E)(F) ;

*er + (D) + (E) + (F)  ::  *ér(D)(E)(F) ;

*ir + (D) + (E) + (F)  ::  *ír(D)(E)(F) ;


{ gerundio; comprando - comprándosemelo } 

*ando + (D) + (E) + (F)  ::  *ándo(D)(E)(F) ;

*endo + (D) + (E) + (F)  ::  *éndo(D)(E)(F) ;


{ Imperativo }

{ forms ending on -a; coma - cómasemelo }


*a(OE)(MED1)a+(D)+(E)+(F) :: *á(OE)(MED1)a(D)(E)(F) ;

*e(OE)(MED1)a+(D)+(E)+(F) :: *é(OE)(MED1)a(D)(E)(F) ;

*o(OE)(MED1)a+(D)+(E)+(F) :: *ó(OE)(MED1)a(D)(E)(F) ;


*a(OE)(MED1)(MED2)a+(D)+(E)+(F) :: *á(OE)(MED1)(MED2)a(D)(E)(F) ;

*e(OE)(MED1)(MED2)a+(D)+(E)+(F) :: *é(OE)(MED1)(MED2)a(D)(E)(F) ;

*o(OE)(MED1)(MED2)a+(D)+(E)+(F) :: *ó(OE)(MED1)(MED2)a(D)(E)(F) ;


*a(OE)(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *á(OE)(MED1)(MED2)(MED3)a(D)(E)(F) ;

*e(OE)(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *é(OE)(MED1)(MED2)(MED3)a(D)(E)(F) ;

*o(OE)(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *ó(OE)(MED1)(MED2)(MED3)a(D)(E)(F) ;


*aa+(D)+(E)+(F) :: *áa(D)(E)(F) ;

*ea+(D)+(E)+(F) :: *éa(D)(E)(F) ;

*oa+(D)+(E)+(F) :: *óa(D)(E)(F) ;


*a(MED1)a+(D)+(E)+(F) :: *á(MED1)a(D)(E)(F) ;

*e(MED1)a+(D)+(E)+(F) :: *é(MED1)a(D)(E)(F) ;

*i(MED1)a+(D)+(E)+(F) :: *í(MED1)a(D)(E)(F) ;

*o(MED1)a+(D)+(E)+(F) :: *ó(MED1)a(D)(E)(F) ;

*u(MED1)a+(D)+(E)+(F) :: *ú(MED1)a(D)(E)(F) ;



*a(MED1)(MED2)a+(D)+(E)+(F) :: *á(MED1)(MED2)a(D)(E)(F) ;

*e(MED1)(MED2)a+(D)+(E)+(F) :: *é(MED1)(MED2)a(D)(E)(F) ;

*i(MED1)(MED2)a+(D)+(E)+(F) :: *í(MED1)(MED2)a(D)(E)(F) ;

*o(MED1)(MED2)a+(D)+(E)+(F) :: *ó(MED1)(MED2)a(D)(E)(F) ;

*u(MED1)(MED2)a+(D)+(E)+(F) :: *ú(MED1)(MED2)a(D)(E)(F) ;


*a(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *á(MED1)(MED2)(MED3)a(D)(E)(F) ;

*e(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *é(MED1)(MED2)(MED3)a(D)(E)(F) ;

*i(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *í(MED1)(MED2)(MED3)a(D)(E)(F) ;

*o(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *ó(MED1)(MED2)(MED3)a(D)(E)(F) ;

*u(MED1)(MED2)(MED3)a+(D)+(E)+(F) :: *ú(MED1)(MED2)(MED3)a(D)(E)(F) ;



{ forms ending on -e; recibe - recíbesemelo }


*a(OE)(MED1)(UU)e+(D)+(E)+(F)::*á(OE)(MED1)(UU)e(D)(E)(F) ;

*e(OE)(MED1)(UU)e+(D)+(E)+(F)::*é(OE)(MED1)(UU)e(D)(E)(F) ;

*o(OE)(MED1)(UU)e+(D)+(E)+(F)::*ó(OE)(MED1)(UU)e(D)(E)(F) ;


*a(OE)(MED1)(MED2)(UU)e+(D)+(E)+(F)::*á(OE)(MED1)(MED2)(UU)e(D)(E)(F) ;

*e(OE)(MED1)(MED2)(UU)e+(D)+(E)+(F)::*é(OE)(MED1)(MED2)(UU)e(D)(E)(F) ;

*o(OE)(MED1)(MED2)(UU)e+(D)+(E)+(F)::*ó(OE)(MED1)(MED2)(UU)e(D)(E)(F) ;


*a(OE)(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*á(OE)(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;

*e(OE)(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*é(OE)(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;

*o(OE)(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*ó(OE)(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;



*ae+(D)+(E)+(F)::*áe(D)(E)(F) ;

*ee+(D)+(E)+(F)::*ée(D)(E)(F) ;

*oe+(D)+(E)+(F)::*óe(D)(E)(F) ;



*a(MED1)(UU)e+(D)+(E)+(F)::*á(MED1)(UU)e(D)(E)(F) ;

*e(MED1)(UU)e+(D)+(E)+(F)::*é(MED1)(UU)e(D)(E)(F) ;

*i(MED1)(UU)e+(D)+(E)+(F)::*í(MED1)(UU)e(D)(E)(F) ;

*o(MED1)(UU)e+(D)+(E)+(F)::*ó(MED1)(UU)e(D)(E)(F) ;

*u(MED1)(UU)e+(D)+(E)+(F)::*ú(MED1)(UU)e(D)(E)(F) ;



*a(MED1)(MED2)(UU)e+(D)+(E)+(F)::*á(MED1)(MED2)(UU)e(D)(E)(F) ;

*e(MED1)(MED2)(UU)e+(D)+(E)+(F)::*é(MED1)(MED2)(UU)e(D)(E)(F) ;

*i(MED1)(MED2)(UU)e+(D)+(E)+(F)::*í(MED1)(MED2)(UU)e(D)(E)(F) ;

*o(MED1)(MED2)(UU)e+(D)+(E)+(F)::*ó(MED1)(MED2)(UU)e(D)(E)(F) ;

*u(MED1)(MED2)(UU)e+(D)+(E)+(F)::*ú(MED1)(MED2)(UU)e(D)(E)(F) ;


*a(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*á(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;

*e(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*é(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;

*i(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*í(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;

*o(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*ó(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;

*u(MED1)(MED2)(MED3)(UU)e+(D)+(E)+(F)::*ú(MED1)(MED2)(MED3)(UU)e(D)(E)(F) ;



{ 1st person pl.; demos - démostemelo }

*emos + (D1) + (E) + (F)  ::  *émos(D1)(E)(F) ;

*amos + (D1) + (E) + (F)  ::  *ámos(D1)(E)(F) ;


{ Added 23/4/90 }

*emos + (D1) + (F)  ::  *émos(D1)(F) ;

*amos + (D1) + (F)  ::  *ámos(D1)(F) ;


{ 1st person pl. + se; demos - démosemelo }

*amos + se + (E) + (F)  ::  *ámose(E)(F) ;

*emos + se + (E) + (F)  ::  *émose(E)(F) ;


{ 2nd person pl. } 

*ad + (D2) + (E) + (F)  ::  *ád(D2)(E)(F) ;

*ed + (D2) + (E) + (F)  ::  *éd(D2)(E)(F) ;

*id + (D2) + (E) + (F)  ::  *íd(D2)(E)(F) ;


*ad + os + (H) + (G)  ::  *áos(H)(G) ;

*ed + os + (H) + (G)  ::  *éos(H)(G) ;

*id + os + (H) + (G)  ::  *íos(H)(G) ;


{ irregular Imperativo-forms }

*pón  + (D) + (E) + (F)  ::  *pón(D)(E)(F) ;

*haz  + (D) + (E) + (F)  ::  *ház(D)(E)(F) ; 

*sal  + (D) + (E) + (F)  ::  *sál(D)(E)(F) ;

*val  + (D) + (E) + (F)  ::  *vál(D)(E)(F) ;

*está + (D) + (E) + (F)  ::  *está(D)(E)(F) ;

*esté + (D) + (E) + (F)  ::  *esté(D)(E)(F) ;

*dé   + (D) + (E) + (F)  ::  *dé(D)(E)(F) ;

*da   + (D) + (E) + (F)  ::  *dá(D)(E)(F) ;  { e.g. dámelo  21/4/89  EvM }


{ For idiomatic prepositionals; EvM  1 Sept.1989 }

*_de  +  el       ::   *_del ;

*_a   +  el       ::   *_al ;

*_con +  mí       ::   *_conmigo ;

*_con +  ti       ::   *_contigo ;

END
