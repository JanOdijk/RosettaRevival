\newpage
\begin{verbatim}
% TRANSFORMATION TPREPPca1
< m1:PREPP{PREPPrec1}[mu2,
                      I1:head/PREP{PREPrec1}[mu3],
                      objrel/T1
                     ] 
>

< m :PREPP{PREPPrec1}[mu2,
                      I1:head/PREP{PREPrec1}[mu3],
                      objrel/T2
                     ] 
>

   MATCHCONDITIONS
      <
       I1:PREPrec1.key <> KEY_'s_prep1242103'
      >


<
   SUBRULE
      <T1:NPVAR{NPVARrec1} >
      <T2:NPVAR{NPVARrec2} >


      COMP
         <
          C1: NPVARrec1.cases = []
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [prepositive];
         >
      DECOMP
         <
          C1: prepositive IN NPVARrec2.cases
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [];
         >

   SUBRULE
      <T1:CNVAR{CNVARrec1} >
      <T2:CNVAR{CNVARrec2} >


      COMP
         <
          C1: CNVARrec1.cases = []
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [prepositive];
         >
      DECOMP
         <
          C1: prepositive IN CNVARrec2.cases
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [];
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TPREPPca1
\item[* relevant examples:]
\item[* language:] (Dutch, English, Spanish) Spanish
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Preppproptopreppformula ?? preppformation (EA)
