\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:
5/1/89: Changed default value for cases from [nominatve] to [],
        Changed value for cases from accusative to prepositive\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION TPREPPca2
< m1:PREPP{PREPPrec1}[mu2,
                      I1:head/PREP{PREPrec1}[mu3],
                      objrel/T1
                     ] 
>

< m :PREPP{PREPPrec1}[mu2,
                      I1:head/PREP{PREPrec1}[mu3],
                      objrel/T2
                     ] 
>

   MATCHCONDITIONS
      <
       I1:PREPrec1.key = KEY_'s_prep1242103'
      >


<
   SUBRULE
      <T1:NPVAR{NPVARrec1} >
      <T2:NPVAR{NPVARrec2} >


      COMP
         <
          C1: NPVARrec1.cases = []
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [nominative];
         >
      DECOMP
         <
          C1: nominative IN NPVARrec2.cases
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [];
         >

   SUBRULE
      <T1:CNVAR{CNVARrec1} >
      <T2:CNVAR{CNVARrec2} >


      COMP
         <
          C1: CNVARrec1.cases = []
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [nominative];
         >
      DECOMP
         <
          C1: nominative IN CNVARrec2.cases
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [];
         >

>

&

\end{verbatim}
