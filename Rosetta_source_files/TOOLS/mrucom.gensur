           WHILE stillitemids(itemids1) DO BEGIN
              takeitemid(itemid,itemids1);
              ",item" """i""" ",Lfirst" ""itemid.levelid""
                ",Llast" ""itemid.levelid""\\
              i:=i+1;
              END;
           itemids1:=itemids;takeitemid(itemid,itemids1);
           ") ELSE match_" ""itemid.str""
              "(Lfirst" ""itemid.levelid"" ",Lfirst" ""itemid.levelid""
           ",FALSE,match) END;"\\
           END;
       IF MR THEN BEGIN
           "BEGIN IF first THEN LSMATCHES_MRfirst(L,match"
           itemids1:=itemids;
           i:=1;
           WHILE stillitemids(itemids1) DO BEGIN
