% RULE RcardNP
< m1:CARD{CARDrec1}[mu1] 
>

< m :NP{NPrec1}[head/CARD{CARDrec1}[mu1]]
>
      COMP
         <
          C1:TRUE
          A1:NPrec1 := NPrecdef;
             NPrec1 :=
                      {   
                       class:            reference
                       aspect:           perfective
                       definite:         def
                       temporal:         true
                       animate:          noanimate
                       human:            nohuman
                       generic:          nogeneric
                       posspred:         true
                       NPhead:           cardNP
                       specQ:            yesspec
                       poss:             false 
                      }

          
         >
      DECOMP
         <
          C1:NPrec1 = NPrecdef EXCEPT FOR [class, aspect, definite,temporal,
                      animate, human, generic, posspred, NPhead, specQ, poss] 
             AND
             NPrec1 =
                      {   
                       class:            reference
                       aspect:           perfective
                       definite:         def
                       temporal:         true
                       animate:          noanimate
                       human:            nohuman
                       generic:          nogeneric
                       posspred:         true
                       NPhead:           cardNP
                       specQ:            yesspec
                       poss:             false 
                      }

          A1:@
         >

&

\end{verbatim}
