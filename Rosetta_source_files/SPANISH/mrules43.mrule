\begin{verbatim}
% FILTER Fsuperdeixisadaptation8
< m:CLAUSE{CLAUSErec1}
           [mu1,
            I1:rel1/SENTENCE{SENTENCErec1}[mu2], 
            mu3
           ]
>

   MATCHCONDITIONS
      <
       I1: (rel1 = leftdislocrel OR SENTENCErec1.adverbial = true) AND
           (SENTENCErec1.temporal = false)
      >
<
   SUBRULE (* no haber *)
      <mu2: [I2: mu4] >

   MATCHCONDITIONS
      <
       I2: (NOT EXIST(mu4, [auxrel/I21:: VERB{VERBrec1}[mu5]])) AND
           (NOT EXIST(mu4, [I22:rel1/VERB{VERBrec2}[I221:mu6]])) AND
           (NOT EXIST(mu4, [predrel/VERBP{VERBPrec1}[I23:mu8]]))

       I21: (VERBrec1.status = bareV) AND
            (VERBrec1.subc IN [haberaux])
       I22: rel1 IN [head, auxrel, progauxrel] AND 
            VERBrec2.status = VV 
       I221: EXIST(mu6, [auxrel/I222::VERB{VERBrec3}[mu7]])
       I222: VERBrec3.subc IN [haberaux]
       I23: EXIST (mu8, [auxrel/I231::VERB{VERBrec4}[mu9]])
       I231: VERBrec4.subc IN [haberaux]
 
      >

         <
          C1:true

             C12: true  (* dependent complement clauses *)
                       (* present *)                
                 C121: (SENTENCErec1.supertiempo = presente) AND
                       (SENTENCErec1.tiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: @

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: @

                 A121: @

                 C122:  (* past *)
                      (SENTENCErec1.tiempo = omegatiempo) AND
                      (SENTENCErec1.supertiempo = pasado) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: @

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: @


                 A122: @                       

              A12: @

          A1: @
         >


   SUBRULE (* haber *)
      <mu2: [I2: mu4] >

   MATCHCONDITIONS
      <
       I2: (EXIST(mu4, [auxrel/I21:: VERB{VERBrec1}[mu5]])) OR
           (EXIST(mu4, [I22:rel1/VERB{VERBrec2}[I221:mu6]])) OR
           (EXIST(mu4, [predrel/VERBP{VERBPrec1}[I23:mu8]]))

       I21: (VERBrec1.status = bareV) AND
            (VERBrec1.subc IN [haberaux])
       I22: rel1 IN [head, auxrel, progauxrel] AND 
            VERBrec2.status = VV 
       I221: EXIST(mu6, [auxrel/I222::VERB{VERBrec3}[mu7]])
       I222: VERBrec3.subc IN [haberaux]
       I23: EXIST(mu8, [auxrel/I231::VERB{VERBrec4}[mu9]])
       I231: VERBrec4.subc IN [haberaux]
 
      >

         <
          C1:true

             C12: true  (* dependent complement clauses *)
                       (* present *)                
                 C121: (SENTENCErec1.supertiempo = presente) AND
                       (SENTENCErec1.tiempo = omegatiempo) AND
                       (
                        (
                         (CLAUSErec1.tiempo = presente) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: @

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: @

                 A121: @

                 C122:  (* past *)
                      (SENTENCErec1.tiempo = omegatiempo) AND
                      (SENTENCErec1.supertiempo = pasado) AND
                       (
                        (
                         (CLAUSErec1.tiempo = pasado) AND
                         (CLAUSErec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (CLAUSErec1.tiempo = omegatiempo) AND
                         (CLAUSErec1.supertiempo = pasado)
                        )
                       )
                       C1221: (SENTENCErec1.finiteness = finite)
                       A1221: @

                       C1222: (SENTENCErec1.finiteness = infinite)
                       A1222: @


                 A122: @                       

              A12: @

          A1: @
         >


>
&

