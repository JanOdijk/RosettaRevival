SPANISH 68
&
\begin{verbatim}
%
% RULE RADJSENTENCESUBSTITUTION1
< m1: ADJPPROP{ADJPPROPrec1}
               [mu1,
                predrel/ADJP{ADJPrec1}
                       [mu2,
                        I1:rel1/SENTENCEVAR{SENTENCEVARrec1},
                        mu3
                       ] 
               ]
SUBST:
m2: SENTENCE{SENTENCErec1}[mu6]          (* substituent *)
>

< m : ADJPPROP{ADJPPROPrec1}
               [mu1,
                predrel/ADJP{ADJPrec1}
                       [mu2,
                        I1:rel1/SENTENCE{SENTENCErec1}[mu6],
                        mu3
                       ] 
               ]
>
   MATCHCONDITIONS
      <
       I1: rel1 IN [complrel,  tempadvrel,
                    causadvrel, resultrel, paramodrel, paracomplrel]
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: SENTENCEVARrec1.index = LEVEL
              C11: SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)
              A11: @
          A1: @
         >
      DECOMP
         <
          C1: true
              C11: true
              A11: SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1)
          A1: SENTENCEVARrec1.index := LEVEL;
         >


&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RADJSENTENCESUBSTITUTION1
\item[* relevant examples:] 
Alle gevallen waarvoor argrel na TC:adjpattern 
als complrel binnen de ADJP gerealiseerd is, 
met SENTENCEVAR als treevar. Plus alle complementen van graadmodificatoren, en
alle sententiele modificatoren.
