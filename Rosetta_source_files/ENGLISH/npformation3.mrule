\begin{verbatim}
% RULE RbigproNP
< m1:BIGPRO{BIGPROrec1}[mu1] 
>

< m :NP{NPrec1}[head/BIGPRO{BIGPROrec2}[mu1] ]
>

   PARAMETERS
      <
       controllerpar: indextype
      >


      COMP
         <
          C1: true
          A1: NPrec1 :=
		  {
		  req         : [pospol,negpol,omegapol]
		  env         : [pospol,negpol,omegapol]
		  superdeixis : omegadeixis
		  class       : omegaTimeAdvClass
		  deixis      : omegadeixis
		  aspect      : omegaAspect
		  retro       : false
		  definite    : def
		  person      : BIGPROrec1.person
		  number      : BIGPROrec1.number
		  cases       : []
		  genders     : [BIGPROrec1.gender]
		  sexes       : []
		  actsubcs    : [othernoun]
		  temporal    : false
		  animate     : BIGPROrec1.animate
                  human       : omegahuman
		  actcomas    : [count]
		  thetanp     : omegathetanp
		  nounpatternefs : []
		  mood        : nowh
		  generic     : nogeneric
		  posspred    : true
		  possnietnp  : false
		  syntquant   : omegaquant
		  NPhead      : BIGPROrec1.NPhead
		  specQ       : yesspec
		  poss        : false
                  coord       : nocoord
		  };
               BIGPROrec2 := BIGPROrec1;
               BIGPROrec2.antecedent := controllerpar;

         >
      DECOMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 =
		  {
		  req         : [pospol,negpol,omegapol]
		  env         : [pospol,negpol,omegapol]
		  superdeixis : omegadeixis
		  class       : omegaTimeAdvClass
		  deixis      : omegadeixis
		  aspect      : omegaAspect
		  retro       : false
		  definite    : def
		  person      : BIGPROrec1.person
		  number      : BIGPROrec1.number
		  cases       : []
		  genders     : [BIGPROrec1.gender]
		  sexes       : []
		  actsubcs    : [othernoun]
		  temporal    : false
		  animate     : BIGPROrec1.animate
                  human       : omegahuman
		  actcomas    : [count]
		  thetanp     : omegathetanp
		  nounpatternefs : []
		  mood        : nowh
		  generic     : nogeneric
		  posspred    : true
		  possnietnp  : false
		  syntquant   : omegaquant
		  NPhead      : BIGPROrec1.NPhead
		  specQ       : yesspec
		  poss        : false
                  coord       : nocoord
		  } 
             A1: BIGPROrec1 := BIGPROrec2;
                 BIGPROrec1.antecedent := 0;
                 controllerpar := BIGPROrec2.antecedent;
         >


&

\end{verbatim}
