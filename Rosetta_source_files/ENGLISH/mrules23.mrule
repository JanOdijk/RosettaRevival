< m1:CLAUSE{CLAUSErec1}
           [ I6:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I1:rel1/T1,
                      mu5
                    ],
             mu6,
             extraposrel/I5::SENTENCE{SENTENCErec1}
                        [ I2:sig1,
                          I3:sig2,
                          subjrel/T2,
                          I4:mu7 
                        ]
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I6:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I1:rel1/T1,
                      mu5
                    ],
             mu6,
             extraposrel/I5::SENTENCE{SENTENCErec1}
                        [ I2:sig1,
                          I3:sig2,
                          I4:mu7 
                        ]
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [objrel, indobjrel]
       I2: ALL (sig1, shiftrel/..)
       I3: ALL (sig2, conjrel/..)
       I4: NOT EXIST (mu7, [shiftrel/..]) AND
           NOT EXIST (mu7, [conjrel/..])
       I5: SENTENCErec1.PROsubject = true
       I6: NOT EXIST (mu1, [I61:auxrel/VERB{VERBrec2}[mu9]])
         I61: VERBrec2.subc = modalverb
      >

<
   SUBRULE (* NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: ((rel1 = objrel AND VERBrec1.Controller = object) OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
              AND
              NPVARrec1 = NPVARrec2 
              (* including cases, which is [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: ((rel1 = objrel AND VERBrec1.Controller = object) OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is [omegacase] *)
         >

   SUBRULE (* CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: ((rel1 = objrel AND VERBrec1.Controller = object) OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
              AND
              CNVARrec1 = CNVARrec2 
              (* including cases, which is [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: ((rel1 = objrel AND VERBrec1.Controller = object) OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which is [omegacase] *)
         >
>
