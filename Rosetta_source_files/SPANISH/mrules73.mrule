\begin{verbatim}
RULE RNPINDEFmodposs
< m1: NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}]


  m2: NP{NPrec2}[mu1, 
                 head/T1,
                 mu2
                ]
>

< m : NP{NPrec1} [head/INDEFPRO{INDEFPROrec1},
                  posrel/PREPP{PREPPrec1}[head/PREP(AUX_vanprepkey){PREPrec1},
                                           complrel/NP{NPrec1}[mu1,
                                                               head/T1,
                                                               mu2
                                                              ]
                                          ]     
                 ]
>

<
(* 1 *) 
SUBRULE          (*  iets van de buren *)

<T1: CN{CNrec1}[mu3]>
<T1: CN{CNrec1}[mu3]>

      COMP
         <
          C1:  true
          A1:   @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
 
(* 2 *) 
SUBRULE            (* iets van ATW *)

<T1: PROPERNOUN{PROPERNOUNrec1}[mu4]>
<T1: PROPERNOUN{PROPERNOUNrec1}[mu4]>

      COMP
         <
          C1:  true
          A1:   @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >

(* 3 *) 
SUBRULE            (* iets van ons *)

<T1: PERSPRO{PERSPROrec1}[mu5]>
<T1: PERSPRO{PERSPROrec1}[mu5]>

      COMP
         <
          C1:  true
          A1:  PERSPROrec1.persprocases := [accusative];
         >

      DECOMP
         <
          C1: PERSPROrec1.persprocases * [accusative, dative] <>[]
          A1:  @
         >
>
&


\end{verbatim}
