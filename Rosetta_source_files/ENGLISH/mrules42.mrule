
ENGLISH 42

&


\newpage
\begin{verbatim}
%
% TRANSFORMATION TObjReciproInsertion1
< m1: VERBPPROP{VERBPPROPrec1}
               [mu6,
                I4:subjrel/T1,
                mu1,
                predrel/VERBP{VERBPrec1}
                       [mu4,
                        head/I1::VERB{VERBrec1}[mu3],
                        I3:sig1,
                        I2:mu2
                       ],
                mu5
               ]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu6,
                I4:subjrel/T1,
                mu1,
                predrel/VERBP{VERBPrec1}
                       [mu4,
                        head/I1::VERB{VERBrec1}[mu3],
                        I3:sig1,
                        objrel/NP{NPrec1}[head/T2],
                        I2:mu2
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.reflexivity = reciprocal
       I2: NOT EXIST (mu2, [objrel/..]) AND
           NOT EXIST (mu2, [partrel/..])
       I3: ALL (sig1, partrel/..)
       I4: T1.CAT IN [NPVAR, CNVAR] AND
           QUOTE_reciproant(T1)
      >

<
   SUBRULE (* 1. each other *)
      < >
      < T2: RECIPRO(KEY_eachotherkey){RECIPROrec1} >

      COMP
         <
          C1: TRUE
          A1: NPrec1 := AUX_NPONRECIPRO
         >
      DECOMP
         <
          C1: NPrec1 = AUX_NPONRECIPRO
          A1: @
         >

   SUBRULE (* 2. one another *)
      < >
      < T2: RECIPRO(KEY_oneanotherkey){RECIPROrec1} >

      COMP
         <
          C1: TRUE
          A1: NPrec1 := AUX_NPONRECIPRO
         >
      DECOMP
         <
          C1: NPrec1 = AUX_NPONRECIPRO
          A1: @
         >
>
&

\end{verbatim}
