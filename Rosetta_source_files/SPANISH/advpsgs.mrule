% TRANSFORMATION TADVPNomCaseAssignment  

< m1 : ADVP{ADVPrec2}[head/ADV{ADVrec1}[mu8],
                      thanascomplrel/THANP{THANPrec1}
                         [mu1,
                          I1:complrel/T1
                         ]
                      ]

>
< m : ADVP{ADVPrec2}[head/ADV{ADVrec1}[mu8],
                     thanascomplrel/THANP{THANPrec1}
                         [mu1,
                          I2:complrel/T2
                         ]
                     ]
>
   MATCHCONDITIONS
      <
       I2:T2.cat IN [NP, NPVAR, CNVAR] WITH Nominative IN T2.REC.cases
       I1:T1.CAT IN [NP, NPVAR, CNVAR] WITH T1.REC.cases = []
      >
<
   SUBRULE (* 1. *)
      <T1: NPVAR{NPVARrec1} >
      <T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Nominative]
         >

      DECOMP
         <
          C1: true
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := []
         >

   SUBRULE (* 2. *)
      <T1: NP{NPrec1}[mu2] >
      <T2: NP{NPrec2}[mu3] >

      COMP
         <
          C1: true
          A1: QUOTE_AssignCase(NPrec1, mu2, NPrec2, mu3, [Nominative])
         >
      DECOMP
         <
          C1: true
          A1: QUOTE_AssignCase(NPrec2, mu3, NPrec1, mu2, [])
         >

   SUBRULE (* 3. *)
      <T1: CNVAR{CNVARrec1} >
      <T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Nominative]
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := []
         >
>

&

\end{verbatim}
