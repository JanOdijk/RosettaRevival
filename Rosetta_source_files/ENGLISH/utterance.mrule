\newpage
\begin{verbatim}

% RULE RUttADJP
< m1: T1
>

< m : UTT{UTTrec1}[head/T2]
>

<
   SUBRULE
      < T1: ADJP{ADJPrec1}[mu1] >
      < T2: ADJP{ADJPrec1}[mu1] >

      COMP
         <
          C1: QUOTE_polarityOK(T1) AND
              (NOT QUOTE_varsintree(T1))
          A1: @
         >
      DECOMP
         <
          C1: QUOTE_polarityOK(T2)
          A1: @
         >
>
&

\end{verbatim}
