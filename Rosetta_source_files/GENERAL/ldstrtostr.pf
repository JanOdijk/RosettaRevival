pragma C_include('string.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE ldSTRtoSTR;
WITH STRNG;


(*MPF:::===================================================================*
 *
 *  Function Name  : ldSTRtoSTR_CATtoRECTYPE
 *  Description    : converts a string denoting a category to the
 *                   string denoting the name of the record type
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION ldstrtostr_CATtoRECTYPE(cat:STRING_string)
                    :STRING_string;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name : ldSTRtoSTR_typeinfo
 *  Description    : gives type information about Typestr
 *  Parameters     : kind=1 -> integer type
 *                   kind=2 -> boolean type
 *                   kind=3 -> enumeration type
 *                   kind=4 -> subrange type
 *                   kind=5 -> set type
 *                   if kind=5 then min and max are the minimum and maximum
 *                   values of the basetype
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

PROCEDURE ldstrtostr_typeinfo(Typestr:STRING_string;
   VAR kind:INTEGER;VAR basetype,min,max:STRING_string);
EXTERNAL;

END {ldSTRtoSTR};
