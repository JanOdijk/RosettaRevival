\newpage
\begin{verbatim}
% TRANSFORMATION TNoArgReflSpelling
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}[I1:mu3],
              mu4
            ]
>
                    
< m : CLAUSE{CLAUSErec1}
            [ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}[I2:mu3],
              mu4
            ]
                    
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu3, [../I11::NPVAR{NPVARrec2}])
         I11: NPVARrec2 = NPVARrec1 EXCEPT FOR [cases]
       I2: NOT EXIST (mu3, [../I21::NP{NPrec1}[mu5]])
         I21: NPVARrec1 = COPYT_npTOvar(NPrec1) EXCEPT FOR [cases]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
