SPANISH 61
&
\begin{verbatim}
%
% RULE RADJPARAOBJMOD

< m1: I4::ADJPPROP{ADJPPROPrec1}
                            [mu1,
                             predrel/I5::ADJP{ADJPrec1},
                                     [
                                      mu2,
                                      head/ADJ{ADJrec1}[mu5],
                                      I2:mu3,
                                      I3:mu4 
                                     ]
                            ]  
  m2: T2
>

< m : I4::ADJPPROP{ADJPPROPrec1}
              [mu1,
               predrel/I5::ADJP{ADJPrec1}
                       [mu2,
                        head/ADJ{ADJrec1}[mu5],
                        I2:mu3,
                        paraobjrel/VARPREPP{VARPREPPrec1}
                                  [head/PREP(KEY_paraioprepkey){PREPrec1},
                                   I1:objrel/T2
                                  ],
                        I3:mu4
                       ]
              ]
>

   MATCHCONDITIONS
      <m2: T2.cat IN [NPVAR, CNVAR]
       I1: T2.cat IN [NPVAR, CNVAR]
       I2: NOT EXIST (mu3, [rel1/..])
       I12: rel1 IN [indobjrel, paraobjrel]    (* may need extension *)
       I3: NOT EXIST (mu4, [I13:rel2/..])
       I13: rel2 IN [paraobjrel, indobjrel]    (* may need extension *)
       I4: NOT (synPARANP IN ADJPPROPrec1.adjpatternefs) 
       I5: subjectiveadj IN ADJPrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
