% TRANSFORMATION tretrodeletion
< m1: SENTENCE{SENTENCErec1}
              I1: [I2: mu1,
                   tempadvrel/ADVP{ADVPrec1}
                             [head/ADV{ADVrec1}
                                  [head/SUBADV{SUBADVrec1}
                                       [head/BADV(AUX_retrorefemptykey){BADVrec1}]
                                  ] 
                              ],
                    I3: mu2 
                   ]
>

< m : SENTENCE{SENTENCErec1}
              I1: [I2: mu1,
                   I3: mu2
                  ]
>
   MATCHCONDITIONS
      <
       I1: RIGHTTOLEFT
       I2: (ALL(mu1, I4: rel1/..)) AND
           (QUOTE_temprefnotfound(mu1)) AND
           (QUOTE_tempretronotfound(mu1))
       I3: (NOT EXIST (mu2, [I5: rel2/..])) AND
           (QUOTE_tempdurnotfound(mu2)) AND
           (QUOTE_tempretronotfound(mu2))
       I4: rel1 IN [head, leftdislocrel, shiftrel, subjrel, predrel,
           locadvrel, tempadvrel, cliticrel, conjrel, meltnegrel, 
           negrel, posrel, vpadvrel]
       I5: rel2 IN [head, leftdislocrel, shiftrel, subjrel, cliticrel, predrel,
                    conjrel, meltnegrel, negrel, posrel, vpadvrel]
      >


      COMP
         <
          C1: (ADVPrec1 = AUX_advpONrtrrfempty) AND
              (SUBADVrec1 = COPYT_btosubadv(BADVrec1)) AND
              (SENTENCErec1.retro= true) AND
              (SENTENCErec1.aspecto = perfectivo OR
               (SENTENCErec1.aspecto = imperfectivo AND
                SENTENCErec1.conjretro = true)
               )
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCErec1.retro= true) AND
              (SENTENCErec1.aspecto = perfectivo OR
               (SENTENCErec1.aspecto = imperfectivo AND
                SENTENCErec1.conjretro = true)
               )
          A1: ADVPrec1 := AUX_advpONrtrrfempty;
              ADVrec1 := AUX_advONrtrrfempty;
              SUBADVrec1 := COPYT_btosubadv(BADVrec1);

         >

&

\end{verbatim}
