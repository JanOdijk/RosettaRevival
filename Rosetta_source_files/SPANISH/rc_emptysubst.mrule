\newpage
\begin{verbatim}
% RULE Rprepemptysubst1
< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ I6:mu2,
                     head/VERB{VERBrec1}[mu3],
                     cliticrel/CLITIC{}[mu8],
                     I2:mu6,
                     prepobjrel/VARPREPP{VARPREPPrec1}
                               [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                 objrel/I3::EMPTYVAR{EMPTYVARrec1} 
                               ],
                     I5:mu4
                   ],
             mu5
           ] 
SUBST:
m2: EMPTY(AUX_emptyEMPTYkey){EMPTYrec1}
>

< m :I4::CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ I6:mu2,
                     head/VERB{VERBrec1}[mu3],
                     cliticrel/CLITIC{}[mu8],
                     I2:mu6,
                     I5:mu4
                   ],
             mu5
           ] 

>

   MATCHCONDITIONS
      <
       I1: [synDONP_PREPEMPTY, synPREPEMPTY, synLOCPREPEMPTY,
            synEMPTY_PREPEMPTY, synPREPEMPTY_PREPNP, synPREPNP_PREPEMPTY
           ] * CLAUSErec1.synvpefs <> []
       I2: NOT EXIST(mu6,[prepobjrel/..])
       I3: EMPTYVARrec1.index = LEVEL
       I4: [synDONP_PREPEMPTY, synPREPEMPTY, synLOCPREPEMPTY,
            synEMPTY_PREPEMPTY, synPREPEMPTY_PREPNP, synPREPNP_PREPEMPTY
           ] * CLAUSErec2.synvpefs <> []
       I5: NOT EXIST(mu4, [../EMPTYVAR{}]) AND
           NOT EXIST(mu4, [../VARPREPP{}[I51:mu7]])
       I51:EXIST(mu7, [../EMPTYVAR{}])
       I6: NOT EXIST(mu2,[prepobjrel/..])
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: EMPTYVARrec1 =
               { 
                 persona :  3
                 numero  :  omeganumero
                 genero  :  omegagenero
               }                         AND
              VARPREPPrec1 =
		  {
		  mood         : declxpmood
		  actsubcefs   : PREPrec1.subcs
		  synppefs     : [synNP]
		  thetapp      : PREPrec1.thetapp
		  headkey      : PREPrec1.key
		  class        : PREPrec1.class
		  tiempo       : PREPrec1.tiempo
		  aspecto      : PREPrec1.aspecto
		  retro        : PREPrec1.retro
		  supertiempo  : omegatiempo
                  specq        : yesspec
		  }                        AND
              PREPrec1.key = VERBrec1.prepkey1 AND
              VERBrec1.prepkey1 <> 0
          A1: CLAUSErec2 := CLAUSErec1;
         >

      DECOMP
         <
          C1: VERBrec1.prepkey1 <> 0
          A1: EMPTYVARrec1.index := LEVEL;
              EMPTYVARrec1 :=
               { 
                 persona :  3
                 numero  :  omeganumero
                 genero  :  omegagenero
               };
              VARPREPPrec1 :=
		  {
		  mood         : declxpmood
		  actsubcefs   : PREPrec1.subcs
		  synppefs     : [synNP]
		  thetapp      : PREPrec1.thetapp
		  headkey      : PREPrec1.key
		  class        : PREPrec1.class
		  tiempo       : PREPrec1.tiempo
		  aspecto      : PREPrec1.aspecto
		  retro        : PREPrec1.retro
		  supertiempo  : omegatiempo
                  specq        : yesspec
		  };
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := [synDONP_PREPEMPTY, synPREPEMPTY, 
                     synLOCPREPEMPTY, synEMPTY_PREPEMPTY, synPREPEMPTY_PREPNP,
                     synPREPNP_PREPEMPTY] * CLAUSErec1.synvpefs 
         >
&

\end{verbatim}
