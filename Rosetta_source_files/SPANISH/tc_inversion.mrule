\newpage
\begin{verbatim}
% TRANSFORMATION Tinversion4   (* No inversion though there is a subject *)
< m1:SENTENCE{SENTENCErec1}[I1:mu1]
>

< m :SENTENCE{SENTENCErec1}[I1:mu1]
>

   MATCHCONDITIONS
      <
       m1: (SENTENCErec1.mood = yesnointerrogative AND 
            SENTENCErec1.senttype = subordinateclause
           )                                                   OR
           (SENTENCErec1.mood = declarative AND
            NOT EXIST(mu1, [I11:shiftrel/T1])
           )                                                   OR
           SENTENCErec1.finiteness = infinite
            I11: (T1.CAT IN [NP, ADJP, ADVP, PREPP, NPVAR, 
                       ADVPVAR, PREPPVAR, VARPREPP] WITH T1.REC.mood = wh) OR
                 (T1.CAT IN [CNVAR]) 
       I1 : EXIST(mu1, [subjrel/..]) 
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
