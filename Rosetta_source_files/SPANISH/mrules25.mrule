\newpage
\begin{verbatim}
% TRANSFORMATION Tclinfptcpasclimbing
< m1:  I1::CLAUSE{CLAUSErec1}
                 [ mu1,
                   predrel/VERBP{VERBPrec1}
                                [ mu3,
                                  rel5/VERB{VERBrec1}[mu5],
                                  I4:head/VERB{VERBrec2}[mu6],
                                  cliticrel/CLITIC{}[I2:mu7],
                                  mu4
                                ],
                   mu2
                 ]
       
               
>

< m : I1::CLAUSE{CLAUSErec1}
                 [ mu1,
                   predrel/VERBP{VERBPrec2}
                                [ mu3,
                                  rel5/VERB{VERBrec1}[mu5],
                                  cliticrel/CLITIC{}[I2:mu7],
                                  I4:head/VERB{VERBrec2}[mu6],
                                  mu4
                                ],
                   mu2
                 ]
       
>


   MATCHCONDITIONS
      <
       I1:CLAUSErec1.finiteness = infinite
       I2:EXIST (mu7, [I21:rel1/T1])
                I21:rel1 IN [seCLrel, unoCLrel, dosCLrel, tresCLrel]
       I4:VERBrec2.modo = ptcpas 
      >

      COMP
         <
          C1:True
          A1:@
         >
      DECOMP
         <
          C1:True
          A1:@
         >


&

\end{v
erbatim}
