\begin{verbatim}
% RULE RADVPdegreemod2
< m1: I3::ADVP{ADVPrec1}
                    [head/ADV{ADVrec1}[mu2]
                    ]

  m2: QP{QPrec1}[mu1,
                 I1:head/T1,
                 I5:thanascomplrel/T3
                ]
>

< m: I4::ADVP{ADVPrec2}
                   [degreemodrel/QP{QPrec2}[mu1,
                                            I1:head/T1
                                           ],
                    head/ADV{ADVrec1}[mu2],
                    I5:postmodrel/T3
                    ]

>

   MATCHCONDITIONS
      <I1: T1.cat IN [Q] WITH T1.REC.HOP = false
       I3: ADVPrec1.temporal = true
       I4: ADVPrec2.temporal = true
       I5: T3.cat IN [THANP]
      >


      COMP
         <
          C1: QPrec1.superdeixis = ADVPrec1.superdeixis
          A1: QPrec2 := QPrec1;
              QPrec2.superdeixis := omegadeixis;
              ADVPrec2 := ADVPrec1;
              ADVPrec2.mood := QPrec2.mood;  (* m.h.o. op een WH-modifier *)
         >
      DECOMP
         <
          C1: QPrec2.superdeixis = omegadeixis AND
              ADVPrec2.mood = QPrec2.mood
          A1: QPrec1 := QPrec2;
              QPrec1.superdeixis := ADVPrec2.superdeixis;
              ADVPrec1 := ADVPrec2;
              ADVPrec1.mood := nowh;          
        >

&

\end{verbatim}
