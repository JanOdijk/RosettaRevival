\begin{verbatim}
%


%SUBGRAMMAR Coordination

 (RCoordS/1 | RsimplePPcoord/3 | RsimpleOpenPPPcoord/5)
.{RCoorditS/2 | RitskPPcoord/4}




HEAD:
<
COORD BASIC EXPRESSION
>


(* IMPORT: *)
<
  1: < 
       ARGUMENT 1   SENTENCE         FROM (CLAUSETOSENTENCE)
       ARGUMENT 2   SENTENCE         FROM (CLAUSETOSENTENCE)
     >
>


EXPORT:
<
SENTENCE
PREPP
NP
ADVP
OPENPREPPPROP
CLOSEDPREPPPROP
OPENNPPROP
CLOSEDNPPROP
OPENADJPPROP
CLOSEDADJPPROP
OPENADVPPROP
CLOSEDADVPPROP
>
&


\newpage
\begin{verbatim}
% RULE RsimpleopenPPPcoord
< m1:COORD{COORDrec1}
  m2:OPENPREPPPROP{OPENPREPPPROPrec1}
         [ subjrel/NPVAR{NPVARrec1},
           predrel/PREPP{PREPPREC1}[mu1]
         ]
  m3:OPENPREPPPROP{OPENPREPPPROPrec2}
         [ subjrel/NPVAR{NPVARrec2},
           predrel/PREPP{PREPPREC2}[mu2]
         ]
>

< m :OPENPREPPPROP{OPENPREPPPROPrec3}
         [ subjrel/NPVAR{NPVARrec3},
           predrel/PREPP{PREPPrec3}
	       [ argrel/PREPP{PREPPrec5}[mu1],
                 conjrel/COORD{COORDrec1},
                 argrel/PREPP{PREPPrec6}[mu2] 
               ]
         ]
>

      COMP
         <
          C1: ppc IN COORDrec1.patterns                         AND
              simple IN COORDrec1.kinds                         AND
              PREPPrec1.mood = PREPPrec2.mood                   AND
              PREPPrec1.actsubcefs * PREPPrec2.actsubcefs <> [] AND
              PREPPrec1.class = PREPPrec2.class                 AND
              PREPPrec1.aspect = PREPPrec2.aspect               AND
              PREPPrec1.retro = PREPPrec2.retro                 AND
              PREPPrec1.superdeixis = PREPPrec2.superdeixis     AND
              PREPPrec1.stranded = false                        AND
              PREPPrec2.stranded = false                        AND
              PREPPrec1.coord = nocoord                         AND
              PREPPrec2.coord = nocoord                         AND
              (PREPPrec1.deixis = PREPPrec2.deixis OR
               PREPPrec1.deixis = omegadeixis      OR
               PREPPrec2.deixis = omegadeixis
              )                                                 AND
              OPENPREPPPROPrec1.mood = OPENPREPPPROPrec2.mood                   AND
              OPENPREPPPROPrec1.actsubcefs * OPENPREPPPROPrec2.actsubcefs <> [] AND
              OPENPREPPPROPrec1.class = OPENPREPPPROPrec2.class                 AND
              OPENPREPPPROPrec1.aspect = OPENPREPPPROPrec2.aspect               AND
              OPENPREPPPROPrec1.retro = OPENPREPPPROPrec2.retro                 AND
              OPENPREPPPROPrec1.superdeixis = OPENPREPPPROPrec2.superdeixis     AND
              (OPENPREPPPROPrec1.deixis = OPENPREPPPROPrec2.deixis OR
               OPENPREPPPROPrec1.deixis = omegadeixis      OR
               OPENPREPPPROPrec2.deixis = omegadeixis
              )                                                 AND
              NPVARrec1 = NPVARrec2                             AND
              OPENPREPPPROPrec1.synppefs = PREPPrec1.synppefs   AND
              OPENPREPPPROPrec2.synppefs = PREPPrec2.synppefs   AND
              OPENPREPPPROPrec1.thetapp = PREPPrec1.thetapp     AND
              OPENPREPPPROPrec2.thetapp = PREPPrec2.thetapp
              C11: PREPPrec1.headkey = PREPPrec2.headkey
              A11: PREPPrec3.headkey := PREPPrec1.headkey;
                   OPENPREPPPROPrec3 := OPENPREPPPROPrec1;
                   OPENPREPPPROPrec3.headkey := PREPPrec1.headkey;
              C12: PREPPrec1.headkey <> PREPPrec2.headkey
              A12: PREPPrec3.headkey := 0;
                   OPENPREPPPROPrec3 := OPENPREPPPROPrec1;
                   OPENPREPPPROPrec3.headkey := 0;
          A1: PREPPrec5 := PREPPrec1;
              PREPPrec6 := PREPPrec2;
              PREPPrec5.superdeixis := omegadeixis; 
              PREPPrec6.superdeixis := omegadeixis; 
              PREPPrec3 :=
                  {
                   req:               [pospol, negpol, omegapol]
                   env:               [pospol, negpol, omegapol]
                   mood:              PREPPrec1.mood
                   synppefs:          []
                   thetapp:           omegathetapp   

                   class:             PREPPrec1.Class
                   aspect:            PREPPrec1.aspect
                   retro:             PREPPrec1.retro
                   superdeixis:       PREPPrec1.superdeixis

                   stranded:          PREPPrec1.stranded
                   coord:             simplecoord 
                  };
              PREPPrec3.actsubcefs  := PREPPrec1.actsubcefs * 
                                              PREPPrec2.actsubcefs;
              QUOTE_AssSpecmax(PREPPrec1.specq, 
                                              PREPPrec2.specq,PREPPrec3.specq);
              QUOTE_assdeixismax(PREPPrec1.deixis, PREPPrec2.deixis, 
                    PREPPrec3.deixis);
              OPENPREPPPROPrec3.actsubcefs  := OPENPREPPPROPrec1.actsubcefs * 
                                              OPENPREPPPROPrec2.actsubcefs;
              OPENPREPPPROPrec3.synppefs := [];
              OPENPREPPPROPrec3.thetapp := omegathetapp;
              QUOTE_AssSpecmax(OPENPREPPPROPrec1.specq, 
                               OPENPREPPPROPrec2.specq,OPENPREPPPROPrec3.specq);
              QUOTE_assdeixismax(OPENPREPPPROPrec1.deixis, 
                        OPENPREPPPROPrec2.deixis, OPENPREPPPROPrec3.deixis);
              NPVARrec3 := NPVARrec1;
         >
      DECOMP
         <
          C1: ppc IN COORDrec1.patterns       AND
              simple IN COORDrec1.kinds       AND
              PREPPrec5.mood = PREPPrec6.mood AND
              PREPPrec5.actsubcefs * PREPPrec6.actsubcefs <> [] AND
              PREPPrec5.class = PREPPrec6.class                 AND
              PREPPrec5.aspect = PREPPrec6.aspect               AND
              PREPPrec5.retro = PREPPrec6.retro                 AND
              PREPPrec5.superdeixis = omegadeixis               AND
              PREPPrec6.superdeixis = omegadeixis               AND
              PREPPrec5.stranded = false                        AND
              PREPPrec6.stranded = false                        AND
              PREPPrec5.coord = nocoord                         AND
              PREPPrec6.coord = nocoord                         AND
              (PREPPrec5.deixis = PREPPrec6.deixis OR
               PREPPrec5.deixis = omegadeixis      OR
               PREPPrec6.deixis = omegadeixis
              )                                                 AND
              PREPPrec3 =
                  {
                   req:               [pospol, negpol, omegapol]
                   env:               [pospol, negpol, omegapol]
                   mood:              PREPPrec5.mood
                   synppefs:          []
                   thetapp:           omegathetapp   

                   class:             PREPPrec5.Class
                   aspect:            PREPPrec5.aspect
                   retro:             PREPPrec5.retro

                   stranded:          PREPPrec5.stranded
                   coord:             simplecoord 
                  }                                                    AND
              PREPPrec3.actsubcefs  = PREPPrec5.actsubcefs * 
                                              PREPPrec6.actsubcefs     AND
              QUOTE_specmax(PREPPrec5.specq, 
                     PREPPrec6.specq, PREPPrec3.specq)                 AND
              QUOTE_deixismax(PREPPrec5.deixis, PREPPrec6.deixis, 
                    PREPPrec3.deixis)                                  AND
              OPENPREPPPROPrec3 =
                  {
                   req:               [pospol, negpol, omegapol]
                   env:               [pospol, negpol, omegapol]
                   mood:              PREPPrec3.mood
                   synppefs:          []
                   thetapp:           omegathetapp   

                   class:             PREPPrec3.Class
                   aspect:            PREPPrec3.aspect
                   retro:             PREPPrec3.retro

                  }                                                    AND
              OPENPREPPPROPrec3.actsubcefs * PREPPrec5.actsubcefs <> [] AND
              QUOTE_specmax(PREPPrec5.specq, 
                     PREPPrec6.specq, OPENPREPPPROPrec3.specq)         AND
              QUOTE_deixismax(PREPPrec5.deixis, PREPPrec6.deixis, 
                    OPENPREPPPROPrec3.deixis)
              C11: PREPPrec5.headkey = PREPPrec6.headkey AND
                   PREPPrec3.headkey = PREPPrec5.headkey AND
                   OPENPREPPPROPrec3.headkey = PREPPREC5.headkey
              A11: @
              C12: PREPPrec5.headkey <> PREPPrec6.headkey AND
                   PREPPrec3.headkey = 0                  AND
                   OPENPREPPPROPrec3.headkey = 0
              A12: @
          A1: PREPPrec1 := PREPPrec5;
              PREPPrec2 := PREPPrec6;
              PREPPrec1.superdeixis := PREPPrec3.superdeixis;
              PREPPrec2.superdeixis := PREPPrec3.superdeixis;
              NPVARrec1 := NPVARrec3;
              NPVARrec2 := NPVARrec3;
              OPENPREPPPROPrec1 := OPENPREPPPROPrec3;
              OPENPREPPPROPrec2 := OPENPREPPPROPrec3;
              OPENPREPPPROPrec1.synppefs := PREPPrec5.synppefs;
              OPENPREPPPROPrec2.synppefs := PREPPrec6.synppefs;
              OPENPREPPPROPrec1.headkey := PREPPrec5.headkey;
              OPENPREPPPROPrec2.headkey := PREPPrec6.headkey;
              OPENPREPPPROPrec1.thetapp := PREPPrec5.thetapp;
              OPENPREPPPROPrec2.thetapp := PREPPrec6.thetapp;
         >


&

\end{verbatim}
