\begin{verbatim}
% RULE RADJretrovarinsertion
< m1: ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I1:mu3,
                     I2:mu5
                    ],
             mu6
            ] 

  m2: T1 
>

< m : ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I1:mu3,
                     tempadvrel/T1,
                     I2:mu5
                    ],
             mu6
            ] 

>
   MATCHCONDITIONS
      <
       I1: (QUOTE_tempretronotfound(mu3)) AND
           (QUOTE_temprefnotfound (mu3)) AND
           (QUOTE_tempdurnotfound(mu3))
       I2: (ALL (mu5, tempadvrel/..)) AND
           (QUOTE_tempretronotfound(mu5)) AND
           (QUOTE_tempdurnotfound(mu5))
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
      >
<
   SUBRULE
      < T1: ADVPVAR{ADVPVARrec1}>
      < T1: ADVPVAR{ADVPVARrec1}>

      COMP
         <
          C1: (ADVPVARrec1.retro = true)
          A1: @
         >
      DECOMP
         <
          C1: (ADVPVARrec1.retro = true)
          A1: @
         >
   SUBRULE
      < T1: PREPPVAR{PREPPVARrec1}>
      < T1: PREPPVAR{PREPPVARrec1}>

      COMP
         <
          C1: (PREPPVARrec1.retro = true)
          A1: @
         >
      DECOMP
         <
          C1: (PREPPVARrec1.retro = true)
          A1: @
         >

   SUBRULE
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: (SENTENCEVARrec1.conjretro = true)
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCEVARrec1.conjretro = true)
          A1: @
         >
>
&

\end{verbatim}
