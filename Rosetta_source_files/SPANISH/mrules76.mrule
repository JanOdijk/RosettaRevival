% RULE RCNformation4

< m1:  EN(KEY_countenkey){ENrec1} 
>

< m :  CN{CNrec1}[head/EN(KEY_countENkey){ENrec1}]
>

      COMP
         <
          C1: true
            C11: true
            A11: CNrec1.generos := [masc];
            C12: true
            A12: CNrec1.generos := [fem];
          A1: CNrec1.numero  := plural;
              CNrec1.posscomas := [count]
             (* .req hasn't been determined yet;
                the other attributes have default value *)
         >

      DECOMP
         <
          C1: (CNrec1 = CNRECDEF EXCEPT FOR [numero, posscomas, 
               generos]) AND
              (CNrec1.numero = plural) AND
              (count IN CNrec1.posscomas  ) 
            C11: masc IN CNrec1.generos
            A11: @
            C12: fem IN CNrec1.generos 
            A12: @
          A1:  @               
         >
&

\end{verbatim}
