\begin{verbatim}
% TRANSFORMATION TOblObjControlNP  (* open NPPROP, obj antecedent *)
< m1: CLAUSE{CLAUSErec1}
            [ I3:mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I1:objrel/T1,
                       mu3,
                       complrel/OPENNPPROP{OPENNPPROPrec1}
                               [ I2:subjrel/T2,
                                 predrel/NP{NPrec1}[mu4] 
                               ],
                       mu5 
                     ],
              mu6 
            ]
>

< m : CLAUSE{CLAUSErec2}
            [ I3:mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I1:objrel/T1,
                       mu3,
                       predrel/NP{NPrec1}[mu4],
                       mu5 
                     ],
              mu6 
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: NOT EXIST (mu1, [I31:auxrel/VERB{VERBrec1}[mu11]])
         I31: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1} 
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec2 = NPVARrec1 AND
              (* including cases, which should be nominative *) 
              OPENNPPROPrec1 = { superdeixis    : omegadeixis
                                 aktionsarts    : [stative]
                                 PROsubject     : true 
                                 thetanp        : NPrec1.thetanp
                                 nounpatternefs : NPrec1.nounpatternefs }
              (* no test on req and env *)
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [resNP] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: @
         >
      DECOMP
         <
          C1: true
              C11:CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs := 
                       CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [resNP] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: OPENNPPROPrec1 := { thetanp        : NPrec1.thetanp
                                  nounpatternefs : NPrec1.nounpatternefs 
                                  PROsubject     : true 
                                  aktionsarts    : [stative] }
              (* superdeixis retains default value *);
              NPVARrec2 := NPVARrec1;
         >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1} 
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec2 = CNVARrec1 AND
              (* including cases, which should be nominative *) 
              OPENNPPROPrec1 = { superdeixis    : omegadeixis
                                 aktionsarts    : [stative]
                                 PROsubject     : true 
                                 thetanp        : NPrec1.thetanp
                                 nounpatternefs : NPrec1.nounpatternefs }
              (* no test on req and env *)
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [resNP] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: @
         >
      DECOMP
         <
          C1: true
              C11:CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs := 
                       CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [resNP] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: OPENNPPROPrec1 := { thetanp        : NPrec1.thetanp
                                  nounpatternefs : NPrec1.nounpatternefs 
                                  PROsubject     : true 
                                  aktionsarts    : [stative] }
              (* superdeixis retains default value *);
              CNVARrec2 := CNVARrec1;
         >
>
&

\end{verbatim}
