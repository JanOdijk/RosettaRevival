% RULE RHELPEMPTYsubjSUBST  (* for the testing of ADJPs without clausal 
                               or nominal context *)

< m1:  OPENADJPPROP{OPENADJPPROPrec1}
                             [subjrel/EMPTYVAR{EMPTYVARrec1},
                              predrel/ADJP{ADJPrec1}[mu2,
                                                     head/ADJ{ADJrec1}[mu1],
                                                     mu3
                                                    ]
                             ]
SUBST:
  m2:  EMPTY(KEY_emptyEMPTYkey){EMPTYrec1}
> 


< m : ADJP{ADJPrec2}[mu2,
                     head/ADJ{ADJrec2}[mu1],
                     mu3
                    ]
>
   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: EMPTYVARrec1.index = LEVEL
          A1: ADJPrec2 := ADJPrec1;
              ADJrec2 := ADJrec1;
              ADJrec2.numero := singular;
              ADJrec2.genero := masc;            (* other forms are not needed
                                                    for testing of ADJphrases *)
              ADJPrec2.genero := ADJrec2.genero;
              ADJPrec2.numero := ADJrec2.numero; (*probably superluous *)
              
         >
      DECOMP
         <
          C1: ADJPrec2.genero =ADJrec2.genero AND
              ADJPrec2.numero =ADJrec2.numero
          A1: EMPTYVARrec1.index := LEVEL;
              ADJPrec1 := ADJPrec2;
              ADJrec1 := ADJrec2;
              OPENADJPPROPrec1 := COPYT_ADJPtoADJPPROP(ADJPrec1);
              OPENADJPPROPrec1.aktionsarts := [stative];
              OPENADJPPROPrec1.prosubject := true
         >

&

\end{verbatim}
