\begin{verbatim}

% RULE RADVPFOROBJMOD     (* also TO as preposition is possible:
                             you are too kind to me;
                             choice between TO and FOR dependent of 
                             subc of ADJ/ADV *)

< m1: I2::ADVP{ADVPrec1}[I1:mu1,
                         head/ADV{ADVrec1}[mu2],
                         mu3
                        ]  
  m2: T1
>

< m : I2::ADVP{ADVPrec1}
              [forobjrel/PREPP{PREPPrec1}
                                      [head/PREP(AUX_forprepkey){PREPrec1},
                                       I1:objrel/T1
                                      ],
               mu1,
               head/ADV{ADVrec1}[mu2],
               mu3
              ]
>

   MATCHCONDITIONS
      <I1: NOT EXIST(mu1, [forobjrel/..])
       m2: T1.cat IN [NPVAR,CNVAR]
       I2: ADVPrec1.thanas = tocompl  (* too *)
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
