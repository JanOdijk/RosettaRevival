pragma C_include('interfaces.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LASTACTIVE;
WITH INTERFACES;


CONST LASTACTIVE_AnalysisMaxLevel    = 4;
CONST LASTACTIVE_GenerationMaxLevel  = 8;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LASTACTIVE_GetLastActive
 *  Parameters      : level : actual value of last active level
 *  Description     : return last active level
 *                    when in batch mode return input parameter level as result
 *                    when in interactive mode query which last active level
 *                       is on
 *
 *EMP:::===================================================================*)

FUNCTION LASTACTIVE_GetLastActive ( level : INTERFACES_LevelType ):
INTERFACES_LevelType;
EXTERNAL;

END {LASTACTIVE};
