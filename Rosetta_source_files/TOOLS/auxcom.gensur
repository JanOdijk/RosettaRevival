        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                           RecFieldCount:=RecFieldCount + 1;
                         END
       *>
4:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_FIELDLIST;
                  $FIELDLIST.RecFieldCount:=RecFieldCount;
