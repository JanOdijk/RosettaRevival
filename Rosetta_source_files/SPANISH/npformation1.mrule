\begin{verbatim}
% RULE RNPformation7

< m1: SUBINDEFPRO{SUBINDEFPROrec1}[head/INDEFPRO{INDEFPROrec1}]
>

< m: NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}] 
>
   MATCHCONDITIONS
      <
        m: NPrec1 = { 
                      persona   : 3
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }

      >

      COMP
         <
          C1: SUBINDEFPROrec1 = INDEFPROrec1

              C11: INDEFPROrec1.key <> KEY_unoindefprokey AND
                   INDEFPROrec1.key <> KEY_seindefprokey
              A11: NPrec1.generic := nogeneric

              C12: INDEFPROrec1.key = KEY_unoindefprokey
              A12: NPrec1.generic:= yesgeneric; 
                   NPrec1.human := yeshuman;
                   NPrec1.Nphead:= unoNP;
                   NPrec1.genero := masc;

              C13: INDEFPROrec1.key = KEY_seindefprokey
              A13: NPrec1.generic:= nogeneric; (* should be yesgeneric *)
                   NPrec1.human := yeshuman;
                   NPrec1.Nphead:= seimpershead;
                   NPrec1.genero := masc;

          A1: (* NPrec1 := COPYT_INDEFPROtoNP(INDEFPROrec1); *)
               NPrec1.definite := INDEFPROrec1.definite;
               NPrec1.numero := INDEFPROrec1.numero ;
               NPrec1.mood := INDEFPROrec1.mood;
               NPrec1.specQ := yesspec;

(* domein en dict moeten  aangepast!!
               NPrec1.syntquant = INDEFPROrec1.syntquant AND
               NPrec1.animate = INDEFPROrec1.animate AND
               NPrec1.NPhead = INDEFPROrec1.NPhead AND
               NPrec1.possnietnp  = INDEFPROrec1.possnietnp AND
               NPrec1.human := INDEFPROrec1.human AND  (EA)  
               NPrec1.genero := INDEFPROrec1.genero AND  (EA)
               NPrec1.generic := INDEFPROrec1.generic  (EA)
*)
               NPrec1.animate := yesanimate (* provisionally *);
               NPrec1.possnietnp  := true;
               NPrec1.posspred    := true;
               NPrec1.supertiempo := omegatiempo;
                        >

      DECOMP
         <
          C1: 
               NPrec1.definite = INDEFPROrec1.definite AND
               NPrec1.numero = INDEFPROrec1.numero AND
               NPrec1.mood = INDEFPROrec1.mood AND
               NPRec1.specQ = yesspec AND
(* domein en dict moeten  aangepast!!
               NPrec1.syntquant = INDEFPROrec1.syntquant AND
               NPrec1.animate = INDEFPROrec1.animate AND
               NPrec1.NPhead = INDEFPROrec1.NPhead AND
               NPrec1.possnietnp  = INDEFPROrec1.possnietnp
               NPrec1.human = INDEFPROrec1.human AND  (EA)  
               NPrec1.genero = INDEFPROrec1.genero AND  (EA)
               NPrec1.generic = INDEFPROrec1.generic  (EA)
*)
              (NPrec1.posspred   = true) AND
              (NPrec1.possnietnp = true) AND
              (NPrec1.supertiempo = omegatiempo) AND
              (NPrec1.generic = nogeneric)
              C11: INDEFPROrec1.key <> KEY_unoindefprokey AND
                   INDEFPROrec1.key <> KEY_seindefprokey AND
                    NPrec1.generic = nogeneric
              A11: @
              C12: INDEFPROrec1.key = KEY_unoindefprokey AND
                   NPrec1.generic = yesgeneric AND 
                   NPrec1.human  = yeshuman AND
                   NPrec1.Nphead = unoNP AND
                   NPrec1.genero = masc 
              A12: @
              C13: INDEFPROrec1.key = KEY_seindefprokey AND
                   NPrec1.generic = nogeneric AND (* should be yesgeneric *)
                   NPrec1.human = yeshuman AND
                   NPrec1.Nphead = seimpershead AND
                   NPrec1.genero = masc
              A13: @
          A1:  SUBINDEFPROrec1 := INDEFPROrec1
         >
&


\end{verbatim}
