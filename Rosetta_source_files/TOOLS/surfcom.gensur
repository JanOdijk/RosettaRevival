       *>
10:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
11:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_PSTOSTARRIGHT;
                END
*>
END;

PROCEDURAL PART
VAR copy,result:LOCALFILE;
    writebracket,writekey,writefield,writeextra::bool;
    str,str1:TSTRING_string;
    write,dontlook:BOOLEAN;
    parameters1,parameters::setofidents;
    id::ident;
BEGIN 
INIT:BEGIN \result.\LOCAL.
           parameters:=$$PSTOSTARRIGHT.parameters;
           initlocalfile(result);
           "BEGIN"\\
           write:=FALSE;
           dontlook:=FALSE;
           writeextra:=FALSE;
           writekey:=FALSE;
           writebracket:=FALSE;
           writefield:=FALSE;
           initlocalfile(copy);
           \copy.\LOCAL.
     END;
<*
1: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN parameters1:=parameters;
                     IF NOT(dontlook) THEN WHILE stillidents(parameters1) DO BEGIN
                       takeident(id,parameters1);
                       IF id.str=str THEN write:=TRUE
                       END;
                     IF TSTRING_comparechars(str,'IN',2)=0 THEN " "
                     TSTRING_constant(str1,'END',3);
                     IF TSTRING_comparebegin(str1,str)=0 THEN \\
                     IF TSTRING_comparechars(str,'ELSE',4)=0 THEN \\
                     IF TSTRING_comparechars(str,'THEN',4)=0 THEN 
                       BEGIN \\ dontlook:=FALSE END;
                     IF TSTRING_comparechars(str,'NOT',3)=0 THEN " "
                     IF TSTRING_comparechars(str,'IF',2)=0 THEN 
                       BEGIN " " dontlook:=TRUE END;
                     IF TSTRING_comparechars(str,'OR',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'AND',3)=0 THEN " "
                     IF writekey THEN IF str[STRING_length(str)]=')' THEN BEGIN
                     TSTRING_extractbegin(str,str,STRING_length(str)-1);
                     writeextra:=TRUE;
                       END;
                     ""str""
                     IF TSTRING_comparechars(str,'IN',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'BEGIN',5)=0 THEN \\
                     IF TSTRING_comparechars(str,'ELSE',4)=0 THEN \\
                     IF TSTRING_comparechars(str,'THEN',4)=0 THEN \\
                     TSTRING_constant(str1,'NOT',3);
                     IF TSTRING_compareend(str,str1)=0 THEN " "
                     IF TSTRING_comparechars(str,'IF',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'OR',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'END',3)=0 THEN " "
                     IF TSTRING_comparechars(str,'AND',3)=0 THEN " "
                     IF writekey THEN BEGIN
                       "')"
                       IF writeextra THEN ")"
                       writeextra:=FALSE;
                       writekey:=FALSE;
                       END;
                     IF writebracket THEN BEGIN ");"\\
                       "LISTREE_appendstree(top::LISTREE_pstree,topset);"
                       writebracket:=FALSE;
                       END;
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"b^.ls^."
                     writefield:=TRUE;
               END
   *>
3: <* SEND: BEGIN writekey:=TRUE END
      !.
      RECEIVE: BEGIN "auxkey('"
               END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF writefield THEN BEGIN
                     "field^"
                     writefield:=FALSE;
                     END;
                     "."
               END
   *>
5: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN ""str""\\
                     IF write THEN appendlocfile(copy,result);
                     initlocalfile(copy);
                     write:=FALSE;
                     dontlook:=FALSE;
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"LSAUXDOM"
               END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                     IF write THEN appendlocfile(copy,result);
               END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF NOT (writekey OR writebracket) THEN "_"
               END
   *>
9: <* SEND: BEGIN writebracket:=TRUE END
      !.
      RECEIVE: BEGIN "top:=MAKET_stree("
               END
   *>
10: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"top^.ls^."
                     writefield:=TRUE;
               END
   *>
11: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN dontlook:=TRUE; "="
               END
   *>
*>
FINAL: BEGIN \result.\LOCAL. IF not write THEN "END;" \\
              $$PSTOSTARRIGHT.copy:=result
       END
END;
&

 
%PASCALTOEND
BASIS RULE
  PASCALTOEND = {IDENTIFIER/9.COLON/7.[COLON/8].ISCAT/1|PROCENT/2|AUX/4|KEYtje/5|
                COLON/1|DOT/1|SEMICOLON/3|UNDERSCORE/1|IDENTIFIER/1|
                ROUNDOPEN/1|ROUNDCLOSE/1|COMMA/1}

SURFACE PART
VAR str:TSTRING_string;

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN str:=%.str;
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
7:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
8:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
9:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
FINAL: #CONDITION: (TSTRING_compare(str,'END')=0) 
       #ACTION: BEGIN
                  SEND_PASCALTOEND;
                END
*>
END;

PROCEDURAL PART
VAR copy:LOCALFILE;
    write,writekey::bool;
    str:TSTRING_string;
    parameters1,parameters::setofidents;
    id::ident;
BEGIN 
INIT:BEGIN initlocalfile(copy);\copy.\LOCAL.
           writekey:=FALSE;write:=FALSE;
           parameters:=$$PASCALTOEND.parameters;
     END;
<*
1: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN IF write THEN BEGIN
                       IF TSTRING_comparechars(str,'END',3)=0 THEN \\
                       IF TSTRING_comparechars(str,'END',3)<>0 THEN ""str""
                       IF writekey THEN BEGIN writekey:=FALSE; ")" END;
                       IF TSTRING_comparechars(str,'BEGIN',5)=0 THEN \\
                       END;
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
3: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN IF write THEN BEGIN ""str""\\ write:=FALSE END;
               END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF write THEN BEGIN \\"LSAUXDOM_" END;
               END
   *>
5: <* SEND: BEGIN writekey:=TRUE END
      !.
      RECEIVE: BEGIN IF write THEN "auxkey("
               END
   *>
7: <* SEND: BEGIN {str:=%.str} END
      !.
      RECEIVE: BEGIN {""str""}
               parameters1:=parameters;
               WHILE stillidents(parameters1) DO BEGIN
                 takeident(id,parameters1);
                 IF id.str=str THEN BEGIN
                   write:=TRUE;
                   ""str"" ":"
                   END;
                 END;                 
               END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN ""str"" ":"
               write:=TRUE;
               END
   *>
9: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN write:=FALSE;
               END
   *>
*>
FINAL: BEGIN $$PASCALTOEND.copy:=copy 
       END
END;
&
