SPANISH 80
&
\begin{verbatim}
%
% TRANSFORMATION TADJSETprosubject
< m1: ADJPFORMULA{ADJPFORMULArec1}
                 [mu1,
                  predrel/ADJP{ADJPrec1}[mu2]
                 ] 

>

< m : ADJPFORMULA{ADJPFORMULArec2}
                 [mu1,
                  predrel/ADJP{ADJPrec1}[mu2]
                 ] 

>

      COMP
         <
          C1: ADJPFORMULArec1.prosubject = false
          A1: ADJPFORMULArec2 := ADJPFORMULArec1;
              ADJPFORMULArec2.prosubject := true;
              
         >
      DECOMP
         <
          C1: ADJPFORMULArec2.prosubject = true
          A1: ADJPFORMULArec1 := ADJPFORMULArec2;
              ADJPFORMULArec1.prosubject := false
         >

&

\end{verbatim}
