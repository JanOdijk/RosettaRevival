PACKAGE LDSUBSTTOVAR;
WITH LISTREE;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDSUBSTTOVAR_copy
 *  Description    : gives for an stree t1 a corresponding stree t2 with a VAR
 *                   category that corresponds to the category t1.cat and
 *                   with identical corresponding attributes.
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

PROCEDURE LDSUBSTTOVAR_copy(t1:LISTREE_pstree;
                                       VAR t2:LISTREE_pstree;
                                       ind:INTEGER
                                      );
EXTERNAL;


END {LDSUBSTTOVAR};

