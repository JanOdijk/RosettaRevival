\newpage
\begin{verbatim}
% RULE Rsubstennp1
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             I1:rel1/I2::NPVAR{NPVARrec1},
             mu2,
             predrel/VERBP{VERBPrec1}[mu3],
             mu4 
           ] 

SUBST:
  m2:NP{NPrec1}
       [ detrel/T1,
          head/CN{CNrec1}[head/EN(KEY_countenkey){ENrec1} ] ,
          mu5
        ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             I1:rel1/NP{NPrec2}
	          [ detrel/T1,
		    I5:mu5
		  ],
             mu2,
             predrel/VERBP{VERBPrec1}[mu3],
             mu4 
           ] 

>

   MATCHCONDITIONS
      <
       m : QUOTE_Substordercondition(mu2, mu3, mu4) 
       m1: QUOTE_Gsubstordercondition(mu2, mu3, mu4) 
       I1: rel1 IN [shiftrel, subjrel, preadvrel, postsubjrel]
       I2: NPVARrec1.index = LEVEL
       I5: NOT EXIST(mu5, [head/..])
      >

   PARAMETERS
      <
       LEVEL
      >

       COMP
         <
          C1: NPrec1.cases = []   AND
              NPrec1.generic = nogeneric AND
              NPrec1.NPhead = enNP AND
              CNrec1 = AUX_CNonNoHead EXCEPT FOR [numero, generos] AND
              NPrec1.numero = CNrec1.numero AND
              (NPrec1.genero IN [masc, fem] AND
              NPrec1.genero IN CNrec1.generos) AND
              QUOTE_tiempomax(CLAUSErec1.tiempo, 
                  CLAUSErec1.supertiempo, NPrec1.supertiempo) AND
              NPVARrec1 = COPYT_nptovar(NPrec1) 
                         EXCEPT FOR [cases, mood] 
              C11: rel1 = shiftrel AND
                   NPVARrec1.mood = topicxpmood AND
                   NPrec1.mood = declxpmood
              A11: @
              C12: rel1 <> shiftrel AND
                   NPrec1.mood = declxpmood
              A12: @
              C13: NPrec1.mood = wh
              A13: @
          A1: NPrec2 := NPrec1;
              NPrec2.cases := NPVARrec1.cases;
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo := omegatiempo;  

         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo AND
              NPrec2.NPhead = enNP AND
              NPrec2.genero IN  [masc, fem] 
              C11: rel1 = shiftrel AND
                   NPrec2.mood = declxpmood
              A11: NPrec1 := NPrec2;
                   NPrec1.cases := []; 
                   NPVARrec1 := COPYT_nptovar(NPrec2);
                   NPVARrec1.mood := topicxpmood;
              C12: rel1 <> shiftrel AND
                   NPrec2.mood = declxpmood
              A12: NPrec1 := NPrec2;
                   NPrec1.cases := []; 
                   NPVARrec1 := COPYT_nptovar(NPrec2);
              C13: NPrec2.mood = wh
              A13: NPrec1 := NPrec2;
                   NPrec1.cases := []; 
                   NPVARrec1 := COPYT_nptovar(NPrec2);
          A1: QUOTE_asstiempomax(CLAUSErec1.tiempo, 
                           CLAUSErec1.supertiempo, NPrec1.supertiempo); 
              NPVARrec1.cases := NPrec2.cases;
              NPVARrec1.index := LEVEL;
              NPVARrec1.generic := nogeneric;
              NPrec1.generic := nogeneric;
              CNrec1 := AUX_CNonNoHead;
              CNrec1.numero := NPrec2.numero;
              CNrec1.generos := [NPrec2.genero];

>
&

\end{verbatim}
