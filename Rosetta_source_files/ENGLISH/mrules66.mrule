% RULE RNPformation4a            (* () + NOUN  --> a + () + NOUN *)
< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2],
                 I1:mu3]
>

< m: I2::NP{NPrec1}[detrel/DETP{DETPrec1}[head/ART(KEY_aartkey){ARTrec1}],
                    head/CN{CNrec2}[mu1,
                                    head/NOUN{NOUNrec2}[mu2],
                                    I1:mu3]
                   ]
>
   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3, [posrel/NP{NPrec2}[mu8]])
       I2: NPrec1 = { NPhead    : otherNP
                      person    : 3 }
      >

      COMP
         <
          C1: singular IN NOUNrec1.numbers AND
              count IN CNrec1.posscomas 
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              DETPrec1.possnietnp := true;
              DETPrec1.mood := nowh;  
              (* syntquant remains default *)
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          number            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : [count]
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders

      (* added mjs *)     cases             : CNrec1.cases
                          class             : CNrec1.class
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }; 
                  CNrec2 := CNrec1;
                  NOUNrec2 := NOUNrec1;
         >

      DECOMP
         <
          C1: singular IN NOUNrec2.numbers AND
              count IN CNrec2.posscomas AND
              DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
              DETPrec1.posspred = true AND
              DETPrec1.possnietnp = true AND
              DETPrec1.mood = nowh AND
              DETPrec1.syntquant = omegaquant AND
              count IN NPrec1.actcomas AND
              NPrec1  = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          number            : singular
                          nounpatternefs    : CNrec2.nounpatternefs
                          thetanp           : CNrec2.thetanp
                          human             : CNrec2.human
                          animate           : CNrec2.animate
                          poss              : CNrec2.poss
                          temporal          : CNrec2.temporal
                          actsubcs          : CNrec2.actsubcs
                          sexes             : CNrec2.sexes
                          genders           : CNrec2.genders
                          
      (* added mjs *)     cases             : CNrec2.cases
                          class             : CNrec2.class
                          deixis            : CNrec2.deixis
                          aspect            : CNrec2.aspect
                          retro             : CNrec2.retro
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  

          A1:  CNrec1 := CNrec2;
               NOUNrec1 := NOUNrec2;
               CNrec1.posscomas := [count];
               NOUNrec1.posscomas := [count];
               (* posscomas zou hier eigenlijk 2 keer actcomas 
                  moeten zijn: cf. Rsubnountonoun3  *)
         >
&

\end{verbatim}
