*e(MED1)(MED2)(MED3)a + (B) + (A3) :: *é(MED1)(MED2)(MED3)a(B)(A3) ;

*i(MED1)(MED2)(MED3)a + (B) + (A3) :: *í(MED1)(MED2)(MED3)a(B)(A3) ;

*o(MED1)(MED2)(MED3)a + (B) + (A3) :: *ó(MED1)(MED2)(MED3)a(B)(A3) ;

*u(MED1)(MED2)(MED3)a + (B) + (A3) :: *ú(MED1)(MED2)(MED3)a(B)(A3) ;


{ forms ending on -e; come - cómemelo }


*a(OE)(MED1)(UU)e + (B) + (A3) :: *á(OE)(MED1)(UU)e(B)(A3) ;

*e(OE)(MED1)(UU)e + (B) + (A3) :: *é(OE)(MED1)(UU)e(B)(A3) ;

