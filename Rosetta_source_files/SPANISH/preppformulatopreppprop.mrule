\newpage
\begin{verbatim}
% RULE Rpppmood1
< m1:PREPPFORMULA{PREPPFORMULArec1}[mu1, predrel/T1] 
>

< m :OPENPREPPPROP{OPENPREPPPROPrec1}[mu1, predrel/T2 ]
>

<
   SUBRULE
      <T1: PREPP{PREPPrec1}[I1:mu2 ] >
      <T2: PREPP{PREPPrec1}[I1:mu2 ] >

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [I11:../T3])
       I11: T3.CAT IN AUX_VARCATSET
      >


      COMP
         <
          C1: PREPPFORMULArec1.prosubject = true
          A1: OPENPREPPPROPrec1 := PREPPFORMULArec1
         >
      DECOMP
         <
          C1: OPENPREPPPROPrec1.prosubject = true
          A1: PREPPFORMULArec1 := OPENPREPPPROPrec1
         >


   SUBRULE
      <T1: PREPP{PREPPrec1}[I1:mu2 ] >
      <T2: VARPREPP{VARPREPPrec1}[I1:mu2 ] >

   MATCHCONDITIONS
      <
       I1: EXIST(mu2, [I11:../T3])
       I11: T3.CAT IN AUX_VARCATSET
      >


      COMP
         <
          C1: PREPPFORMULArec1.prosubject = true
          A1: OPENPREPPPROPrec1 := PREPPFORMULArec1;
              VARPREPPrec1 := PREPPrec1;
         >
      DECOMP
         <
          C1: OPENPREPPPROPrec1.prosubject = true
          A1: PREPPFORMULArec1 := OPENPREPPPROPrec1;
              PREPPrec1 := VARPREPPrec1;
         >

>
&

\end{verbatim}
