\newpage
\begin{verbatim}
% TRANSFORMATION TADJPATTERN15       
                          (* sentential prepositional object 
                             he is happy about ...........
                             he is curious about who is going to win *)

< m1: ADJPPROP{ADJPPROPrec1}
                      [mu1,
                       predrel/ADJP{ADJPrec1}
                              [head/ADJ{ADJrec1}[mu2],
                               argrel/SENTENCEVAR{SENTENCEVARrec1}
                              ]
                       ]
>

< m : ADJPPROP{ADJPPROPrec2}
         [mu1,
          predrel/ADJP{ADJPrec2}
                  [head/ADJ{ADJrec1}[mu2],
                   prepobjrel/PREPP{PREPPrec1}
                             [head/PREP(ADJrec1.prepkey){PREPrec1},
                              complrel/SENTENCEVAR{SENTENCEVARrec1}
                             ]
                  ]
         ]
>


      COMP
         <
          C1: (ADJrec1.adjpatterns * [synPREPOPENTOSENT,  
                                        synPREPTHATSENT,
                                        synPREPQSENT
                                         ]  <> [])       AND
              (ADJPPROPrec1.adjpatternefs = []) AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                  }
              )

             C11: (*  he is curious about ?the right answer to give? *)
                  (synPREPOPENTOSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { PROsubject  : true                    
                                       finiteness  : infinite
                                       infsort     : toinf
                                       mood        : declarative
                                      }
                   )
             A11: 
                  ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPOPENTOSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPOPENTOSENT];


             C13: (*  no examples found *)
                  (synPREPTHATSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { finiteness  : finite
                                       mood        : declarative
                                      }
                  )
             A13: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPTHATSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPTHATSENT];

             C14: (* he is curious about when it will be going to rain *)
                  (synPREPQSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { finiteness  : finite
                                       mood        : WHinterrogative
                                      }
                  )
             A14: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPQSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPQSENT];

          A1: PREPPrec1 := PREPPRECDEF;
              PREPPrec1.headkey := PREPrec1.key;
              PREPPrec1.synppefs := [synNP];
 
         >

      DECOMP
         <
          C1: 
              (PREPrec1.key = ADJrec1.prepkey) AND   (* ???? *)
              (PREPPrec1 = PREPPRECDEF 
                           EXCEPT FOR [synppefs, headkey]) AND
              (synNP IN PREPPrec1.synppefs) AND
              (PREPPrec1.headkey = PREPrec1.key) AND
              (ADJrec1.adjpatterns * [synPREPOPENTOSENT,  
                                        synPREPTHATSENT,
                                        synPREPQSENT
                                        ]  <> [])       AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                  }
              )

              C11: (synPREPOPENTOSENT IN ADJrec1.adjpatterns) AND
                   (synPREPOPENTOSENT IN ADJPrec2.adjpatternefs) AND
                   (synPREPOPENTOSENT IN ADJPPROPrec2.adjpatternefs) 
                    AND
                   (SENTENCEVARrec1 = { PROsubject  : true                    
                                        finiteness  : infinite
                                        mood        : declarative
                                        infsort     : toinf
                                      }
                    )
              A11: @


              C13: (synPREPTHATSENT IN ADJrec1.adjpatterns) AND
                   (synPREPTHATSENT IN ADJPrec2.adjpatternefs) AND
                   (synPREPTHATSENT IN ADJPPROPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1 = { finiteness  : finite
                                        mood        : declarative
                                      }
                   )
              A13: @

              C14: (synPREPQSENT IN ADJrec1.adjpatterns) AND
                   (synPREPQSENT IN ADJPrec2.adjpatternefs) AND
                   (synPREPQSENT IN ADJPPROPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1 = { finiteness  : finite
                                        mood        : WHinterrogative
                                      }
                   )
              A14: @


          A1: ADJPPROPrec1 := ADJPPROPrec2;
              ADJPPROPrec1.adjpatternefs := [];
              ADJPrec1 := ADJPrec2;
              ADJPrec1.adjpatternefs := [];

         >

&

\end{verbatim}
