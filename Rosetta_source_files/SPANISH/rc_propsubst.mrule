\begin{verbatim}
% RULE RSENTENCEextrapos

< m1: VERBPPROP{VERBPPROPrec1}[ mu12,
                                subjrel/SENTENCEVAR{SENTENCEVARrec1},
                                mu1,
                                predrel/VERBP{VERBPrec1}
                                       [ head/VERB{VERBrec1}[mu4],
                                         I1:mu2
                                       ],
                                mu7
                              ]
SUBST:
  m2: SENTENCE{SENTENCErec1}[mu3]   (*substituent*) 
>

< m : VERBPPROP{VERBPPROPrec1}
          [ mu12,
            subjrel/NP{NPrec1}
                    [head/PERSPRO{PERSPROrec1}
                          [head/BPERSPRO(AUX_redellobpersprokey){BPERSPROrec1}] 
                    ],
            mu1,
            predrel/VERBP{VERBPrec1}
                    [ complrel/SENTENCE{SENTENCErec1}
                              [head/VERB{VERBrec1} [mu4]],
                      I1:mu2
                    ],
            mu7
          ]
>

   MATCHCONDITIONS
      <
       I1: ( NOT EXIST(mu2,[complrel/T1]) ) AND
           ( NOT EXIST(mu2,[objrel/T1]) )
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: SENTENCEVARrec1.index = LEVEL
	      C11: SENTENCEVARrec1 =
                        COPYT_sentencetovar(SENTENCErec1)
	      A11: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);
                   NPrec1 := AUX_NPONredelloBPRSPR
          A1: @
         >

      DECOMP
         <
          C1: true
	      C11: (NPrec1 = AUX_NPONredelloBPRSPR) AND
                   (PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1))
	      A11: SENTENCEVARrec1.index := LEVEL;
                   SENTENCEVARrec1 := 
                        COPYT_sentencetovar(SENTENCErec1);
          A1: @
         >

&

\end{verbatim}
