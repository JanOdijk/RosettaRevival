% TRANSFORMATION TOblSubjControlADJP   (* openadjpprop, subj control *)
< m1: CLAUSE{CLAUSErec1}
            [ mu6,
              I1:subjrel/T1,
              I4:mu1,
              predrel/VERBP{VERBPrec1}
                     [ I2:mu2,
                       complrel/OPENADJPPROP{OPENADJPPROPrec1}
                               [ I3:subjrel/T2,
                                 predrel/ADJP{ADJPrec1}[mu3] 
                               ],
                        mu4
                     ],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec2}
            [ mu6,
              I1:subjrel/T1,
              I4:mu1,
              predrel/VERBP{VERBPrec1}
                     [ I2:mu2,
                       predrel/ADJP{ADJPrec1}[mu3], 
                       mu4
                     ],
              mu5
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: NOT EXIST (mu2, [objrel/..])
       I3: T2.CAT IN [NPVAR, CNVAR]
       I4: NOT EXIST (mu1, [I41:auxrel/VERB{VERBrec1}[mu11]])
         I41: VERBrec1.subc = modalverb
      >
<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 AND
              OPENADJPPROPrec1 = COPYT_adjpTOadjpprop(ADJPrec1) 
                EXCEPT FOR [aktionsarts, superdeixis, PROsubject]
              AND
              OPENADJPPROPrec1 = { aktionsarts   : [stative] 
                                   superdeixis   : omegadeixis
                                   PROsubject    : true }
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [resAP] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
              C11:CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs := 
                       CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [resAP] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: NPVARrec2 := NPVARrec1;
              OPENADJPPROPrec1 := COPYT_adjpTOadjpprop(ADJPrec1); 
              OPENADJPPROPrec1 := { aktionsarts   : [stative ]
                                    superdeixis   : omegadeixis
                                    PROsubject    : true }
         >

   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 AND
              OPENADJPPROPrec1 = COPYT_adjpTOadjpprop(ADJPrec1) 
                EXCEPT FOR [aktionsarts, superdeixis, PROsubject]
              AND
              OPENADJPPROPrec1 = { aktionsarts   : [stative] 
                                   superdeixis   : omegadeixis
                                   PROsubject    : true }
              C11: CLAUSErec1.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec2 := CLAUSErec1;
              C12: CLAUSErec1.adjuncts * [resAP] <> []
              A12: CLAUSErec2 := CLAUSErec1;
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: true
              C11:CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.synvpefs := 
                       CLAUSErec2.synvpefs * AUX_openxppvps;
              C12: CLAUSErec2.adjuncts * [resAP] <> []
              A12: CLAUSErec1 := CLAUSErec2;
          A1: CNVARrec2 := CNVARrec1;
              OPENADJPPROPrec1 := COPYT_adjpTOadjpprop(ADJPrec1); 
              OPENADJPPROPrec1 := { aktionsarts   : [stative ]
                                    superdeixis   : omegadeixis
                                    PROsubject    : true }
         >
>
&

