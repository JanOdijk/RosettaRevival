% RULE Rfinfutpressuperdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    auxrel/VERB{VERBrec3}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(KEY_futurobverbkey){BVERBrec1}]
                          ],
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            mu5
