\newpage
\begin{verbatim}
% TRANSFORMATION Tpolite5b (* must, have to --> should *)
< m1:SENTENCE{SENTENCErec1}
           [mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/T1]
                  ],
            mu2
           ] 
>

< m :SENTENCE{SENTENCErec2}
           [mu1,
            I4:auxrel/VERB{VERBrec3}
                  [head/SUBVERB{SUBVERBrec3}
                        [head/T2]
                  ],
            mu2
           ] 

>
   MATCHCONDITIONS
      <
       I3: VERBrec1.tense = presenttense
       I4: VERBrec3.tense = pasttense
       m1: SENTENCErec1.mood = yesnointerrogative
       m : SENTENCErec2.mood = yesnointerrogative

      >

<
   SUBRULE (* 1 moeten1 *)
      <T1: BVERB(KEY1){BVERBrec1} >
      <T2: BVERB(KEY_shallbverbkey){BVERBrec3} >

   MATCHCONDITIONS
      <
       T1: KEY1 = KEY_must1BVERBkey OR
           KEY1 = KEY_'s_haveto1BVERBkey'

      >
       

      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) 
              C11: SENTENCErec1.deixis = presentdeixis 
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.deixis := pastdeixis;
              C12: SENTENCErec1.superdeixis = presentdeixis                  
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.superdeixis := pastdeixis;

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
                   VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
                   VERBrec3 :=
                     {
                      numbers     : VERBrec1.numbers
                      persons     : VERBrec1.persons
                      modus       : VERBrec1.modus
                      tense       : pasttense
                     };

         >
      DECOMP
         <
          C1:(SENTENCErec2.finiteness = finite) AND
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3)) AND
              (SUBVERBrec3.affix = noaffix)  
              C11: SENTENCErec2.deixis = pastdeixis 
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.deixis := presentdeixis;
              C12: SENTENCErec2.superdeixis = pastdeixis                  
              A12: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.superdeixis := presentdeixis;

          A1: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                     {
                      numbers     : VERBrec3.numbers
                      persons     : VERBrec3.persons
                      modus       : VERBrec3.modus
                      tense       : pasttense
                     };

              
         >

   SUBRULE (* 1 moeten1 *)
      <T1: BVERB(KEY1){BVERBrec1} >
      <T2: BVERB(KEY_should2BVERbkey){BVERBrec3} >

   MATCHCONDITIONS
      <
       T1: KEY1 = KEY_must2BVERBkey OR
           KEY1 = KEY_'s_haveto2BVERBkey'

      >
       

      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) 
              C11: SENTENCErec1.deixis = presentdeixis 
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.deixis := pastdeixis;
              C12: SENTENCErec1.superdeixis = presentdeixis                  
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.superdeixis := pastdeixis;

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
                   VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
                   VERBrec3 :=
                     {
                      numbers     : VERBrec1.numbers
                      persons     : VERBrec1.persons
                      modus       : VERBrec1.modus
                      tense       : pasttense
                     };

         >
      DECOMP
         <
          C1:(SENTENCErec2.finiteness = finite) AND
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3)) AND
              (SUBVERBrec3.affix = noaffix)  
              C11: SENTENCErec2.deixis = pastdeixis 
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.deixis := presentdeixis;
              C12: SENTENCErec2.superdeixis = pastdeixis                  
              A12: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.superdeixis := presentdeixis;

          A1: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                     {
                      numbers     : VERBrec3.numbers
                      persons     : VERBrec3.persons
                      modus       : VERBrec3.modus
                      tense       : pasttense
                     };

              
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tpolite5a
\item[* relevant examples:] I can swim (' can I swim?') 
$\rightarrow$ I could swim ('could I swim?')\\
You can come(' can you come?') 
$\rightarrow$ You could come ('could you come?')
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_polite
\item[* date of creation:] 20-FEB-1990
\item[* author:] Lisette Appelo
\item[* copied from:] Tpolite1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] To change {\em can} into {\em could}
 to express politeness. For finite 
yesnointerrogative main SENTENCEs with presentdeixis and first or second
person subject only.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task) 
