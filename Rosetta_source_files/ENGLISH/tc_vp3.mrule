              PROSENTVARrec1.so = false 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PROSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
