% RULE Rstartadvpprop120              (* graag, opzettelijk, enthousiast *)
< m1:SUBADV{SUBADVrec1}[mu1] 
  m2:T1
  m3:T2
>

< m : ADVPPROP{ADVPPROPrec1}[ I1:subjrel/T1,
                              predrel/ADVP{ADVPrec1}
                                         [head/ADV{ADVrec1}
                                              [head/SUBADV{SUBADVrec1}[mu1] ] ,
                                          I2:argrel/T2
                                         ]
                            ]
>

   MATCHCONDITIONS
      <
       m2: T1.CAT IN AUX_VARCATSET
       I1: T1.CAT IN AUX_VARCATSET
       m3: T2.CAT IN AUX_VARCATSET
       I2: T2.CAT IN AUX_VARCATSET
      >


      COMP
         <
          C1: SUBADVrec1.thetaadv = thetaadv120
          A1: ADVrec1 := COPYT_subadvtoadv(SUBADVrec1);
              (* rest default *)
              ADVPrec1 := COPYT_advTOadvp(ADVrec1);
              ADVPrec1 :=
		  {
		  supertiempo : omegatiempo
		  actsubcefs   : ADVrec1.subcs
		  advpatternefs : []
		  thanascompl : false
		  };
              ADVPPROPrec1 := COPYT_ADVPtoPROP(ADVPrec1);
              ADVPPROPrec1 := 
		  {
		  aktionsarts : [stative]
		  PROsubject  : false
		  };
         >
      DECOMP
         <
          C1: SUBADVrec1.thetaadv = thetaadv120           AND
              ADVrec1 = COPYT_subadvtoadv(SUBADVrec1) AND
              ADVprec1 = COPYT_advTOadvp(ADVrec1)     AND
              ADVPrec1 =
		  {
		  supertiempo   : omegatiempo
		  actsubcefs    : ADVrec1.subcs
		  advpatternefs : []
		  thanascompl   : false
		  }                                         AND
              ADVPPROPrec1 = COPYT_ADVPtoPROP(ADVPrec1) AND
              ADVPPROPrec1 = 
		  {
		  aktionsarts : [stative]
		  PROsubject  : false
		  }
          A1: @
         >

&

\end{verbatim}
