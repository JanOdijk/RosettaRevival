\begin{verbatim}
% TRANSFORMATION TOblObjControlPrepPREPP    (* prepobj/OPENPREPPPROP *)
< m1:CLAUSE{CLAUSErec1}
           [ I1:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      prepobjrel/PREPP{PREPPrec1}
                                [ head/PREP{PREPrec1},
                                  objrel/OPENPREPPPROP{OPENPREPPPROPrec1}
                                       [ subjrel/T2,
                                         predrel/PREPP{PREPPrec2}[mu4] 
                                       ]
                                ],
                      mu5
                    ],
             mu6
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I1:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      prepobjrel/PREPP{PREPPrec1}
                                [ head/PREP{PREPrec1},
                                  predrel/PREPP{PREPPrec2}[mu4]
                                ],
                      mu5
                    ],
             mu6
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [I11:auxrel/VERB{VERBrec1}[mu11]])
         I11: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} 
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_openxppvps <> [] AND
              NPVARrec1 = NPVARrec2  AND
              (* including cases, which should be [] *)
              OPENPREPPPROPrec1 = COPYT_preppTOpreppprop(PREPPrec1)
                EXCEPT FOR [ req, env, PROsubject, 
                             aktionsarts, superdeixis] AND
              OPENPREPPPROPrec1 = { PROsubject  : true
                                    aktionsarts : [stative] 
                                    superdeixis : omegadeixis }
              (* no test on req, env *)
          A1: CLAUSErec2 := CLAUSErec1;
         >
              
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                 CLAUSErec2.synvpefs * AUX_openxppvps;
              NPVARrec2 := NPVARrec1;
              (* including cases, which should be [] *)
              OPENPREPPPROPrec1 := COPYT_preppTOpreppprop(PREPPrec1);
              OPENPREPPPROPrec1 := { PROsubject  : true
                                     aktionsarts : [stative] 
                                     superdeixis : omegadeixis }
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1} 
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_openxppvps <> [] AND
              CNVARrec1 = CNVARrec2 AND
              OPENPREPPPROPrec1 = COPYT_preppTOpreppprop(PREPPrec1)
                EXCEPT FOR [req, env, PROsubject, 
                   aktionsarts, superdeixis] AND
              OPENPREPPPROPrec1 = { PROsubject  : true
                                    aktionsarts : [stative] 
                                    superdeixis : omegadeixis }
              (* no test on req, env *)
          A1: CLAUSErec2 := CLAUSErec1;
         >
              
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_openxppvps <> [] 
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                 CLAUSErec2.synvpefs * AUX_openxppvps;
              CNVARrec2 := CNVARrec1;
              OPENPREPPPROPrec1 := COPYT_preppTOpreppprop(PREPPrec1);
              OPENPREPPPROPrec1 := { PROsubject  : true
                                     aktionsarts : [stative] 
                                     superdeixis : omegadeixis }
         >
>

&
\end{verbatim}
