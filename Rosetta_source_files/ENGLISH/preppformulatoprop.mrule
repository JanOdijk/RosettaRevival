\newpage
\begin{verbatim}

% RULE RpppSubjSubst
< m1: I1::PREPPFORMULA{PREPPFORMULArec1}
                 [mu1,
                  subjrel/I2::NPVAR{NPVARrec1},
                  mu2,
                  predrel/PREPP{PREPPrec1}[mu3],
                  mu4
                 ] 
  SUBST:
  m2: T1=NP{NPrec1}[mu5]
>

< m : I1::PREPPFORMULA{PREPPFORMULArec1}
                 [mu1,
                  subjrel/NP{NPrec2}[mu6],
                  mu2,
                  predrel/PREPP{PREPPrec1}[mu3],
                  mu4
                 ] 

>

   MATCHCONDITIONS
      < m2: QUOTE_Gsubstordercondition(mu2, mu3, mu4, T1, PREPPFORMULArec1.
prosubject) 
        m : QUOTE_substordercondition(mu2, mu3, mu4, PREPPFORMULArec1.
prosubject)
        I1: PREPPFORMULArec1.PROsubject = false
        I2: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = [ ] AND
              NPrec1.generic = nogeneric AND
              NPrec1.superdeixis = PREPPFORMULArec1.superdeixis
          A1: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases); 
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
          A1: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []); 
              NPrec1.superdeixis := PREPPFORMULArec1.superdeixis;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
