ENGLISH 60
&

\noindent Subgrammars Cardinalformation and Datumformation

\begin{description}
  \item [RCard1:] 6,3
  \item [RCard2:] 16,160 
\\
  \item [RDaytoNP:] Tuesday
  \item [RMonthToNP:] January
  \item [RNPyear:] January 1920
  \item [RNPday:] 6 January 1920
  \item [RNPdayord:] 6th January 1920
  \item [RNPday1:] January 6 (,1920)
  \item [RNPday1ord:] January 6th (,1920)
\end{description}

\noindent Related rules in other subgrammars
\begin {description}
  \item [RCardNP:] 1980 \rightarrow npformation subgrammar 
  \item [RCardToDetP:] 6, 31 \rightarrow detpformation subgrammar 
  \item Monday, 7 ..  \rightarrow apposition subgrammar
\end {description}
