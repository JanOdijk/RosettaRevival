/* debug: attribute debug window */

procedure AttrCreate ();

object attr_window : XmFormDialog {
    arguments {
	XmNdialogTitle	= N_attr_window;
        arguments form_dialog_args;
    };
    controls {
	XmRowColumn      attr_button_box;
        XmScrolledWindow attr_output_window;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_attr_window + DEFAULT_BUTTON_OFFSET*X_attr_ok_button);
    };
};

object attr_button_box : XmRowColumn {
    arguments {
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_attr_ok_button;
                XmNsensitive    = false;
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_attr_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_attr_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_attr_tofile_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_attr_tofile_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_attr_tofile_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_attr_confirm_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_attr_confirm_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_attr_confirm_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_attr_help_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_attr_help_button);
		XmNactivateCallback = procedure XwhAction (X_attr_help_button);
	    };
	};
    };
};

object attr_output_window : XmScrolledWindow {
    arguments {
	XmNtopAttachment	= XmATTACH_FORM;
	XmNleftAttachment       = XmATTACH_FORM;
	XmNrightAttachment	= XmATTACH_FORM;
	XmNbottomAttachment	= XmATTACH_WIDGET;
	XmNbottomWidget		= XmRowColumn attr_button_box;

	XmNscrollingPolicy      = XmAUTOMATIC;
	XmNworkWindow		= user_defined attr_area;
        XmNheight	        = 400;
	XmNwidth	        = 200;
    };
    controls {
        user_defined attr_area;
    };
};

object attr_area : user_defined procedure AttrCreate () {
    arguments {
	XmNverticalSpace	= 1;
	XmNhorizontalSpace	= 20;
        XmNborderWidth          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_attr_area);
    };
};
