\begin{verbatim}
% TRANSFORMATION TVerbpattern4
< m1:VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ head/VERB{VERBrec1}[mu2],
                         argrel/T1,
                         argrel/T2
                       ] 
              ]
>

< m :VERBPPROP{VERBPPROPrec2}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ head/VERB{VERBrec1}[mu2],
                         rel1/T2,
                         rel2/T1
                       ] 
              ]
>


<
   (*  No satisfacen estas telas (vp012);\\
       Juan dio el libro (vp123)      *)

   SUBRULE (*2*)
      <T2: EMPTYVAR{EMPTYVARrec1} >
      <T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synEMPTY_DONP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synEMPTY_DONP];
                rel1 := indobjrel;
                rel2 := objrel
          A1:  @
         >


   (* ?LLam\'{o} la atenci\'{o}n que ...    (vp012)   *)

   SUBRULE (*4a*)
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      COMP
         <
          C1: synEMPTY_QUESENTind IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                modo        : Indicativo
                                senttype    : subordinateclause
                                finiteness  : finite
                                adverbial   : false
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_QUESENTind];
              rel1 := indobjrel;
              rel2 := complrel
         >


   (* ?LLam\'{o} la atenci\'{o}n que ...(subj.)   (vp012)   *)

   SUBRULE (*4b*)
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      COMP
         <
          C1: synEMPTY_QUESENTsubj IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                modo        : Subjuntivo
                                senttype    : subordinateclause
                                finiteness  : finite
                                 adverbial   : false
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_QUESENTsubj];
              rel1 := indobjrel;
              rel2 := complrel
         >


   (*  (\'{E}l prometi\'{o} venir (vp123)  *)

   SUBRULE (*8a*)
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      COMP
         <
          C1: synEMPTY_OPENINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                modo        : Infinitivo
                                senttype    : subordinateclause
                                PROsubject  : true
                                finiteness  : infinite
                                infsort     : inf
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_OPENINFSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >

   SUBRULE (*8b*)
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      COMP
         <
          C1: synEMPTY_CLOSEDINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                modo        : Infinitivo
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : infinite
                                infsort     : inf
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_CLOSEDINFSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >


   (*  Esto cuesta seis florines (vp123)  *)

   SUBRULE (*10*)
      <T1: NPPROPVAR{NPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      COMP
         <
          C1: synEMPTY_MEASUREPHRASE IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_MEASUREPHRASE];
              rel1 := indobjrel;
              rel2 := complrel
         >


   (*  Juan parece el mejor (vp012)  *)

   SUBRULE (*14*)
      <T1: NPPROPVAR{NPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_CLOSEDNPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_CLOSEDNPPROP];
              rel1 := indobjrel;
              rel2 := complrel
         >


   (*  Juan parece mejor (vp012)  *)

   SUBRULE (*15*)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} 
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} 
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_CLOSEDADJPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_CLOSEDADJPPROP];
              rel1 := indobjrel;
              rel2 := complrel
         >


   (*  Teresia parece contra la propuesta (vp012)  *)

   SUBRULE (*16a*)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_OTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              PREPPPROPVARrec1.actsubcefs * [loc,dir] = [] AND
              PREPPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_OTHERCLOSEDPREPPPROP];
              rel1 := indobjrel;
              rel2 := complrel
         >


   SUBRULE (*16b*)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_OTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.actsubcefs * [locadv,diradv] = [] AND
              ADVPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_OTHERCLOSEDPREPPPROP];
              rel1 := indobjrel;
              rel2 := complrel
         >


      (*  No dijo si podr\'{\i}a venir (vp123) *)


   SUBRULE (*18*)
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1}
       T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_QSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1.mood IN [yesnointerrogative, whinterrogative ] AND
              SENTENCEVARrec1.senttype = subordinateclause  AND
              SENTENCEVARrec1.modo = Indicativo
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_QSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
>
&


\end{verbatim}
