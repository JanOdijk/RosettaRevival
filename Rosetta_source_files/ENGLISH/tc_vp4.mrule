              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : inf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_OPENINFSENT];
              rel1 := objrel;
              rel2 := complrel;
         >
      DECOMP
         <
          C1: synDONP_OPENINFSENT IN VERBPPROPrec2.synvpefs AND
              synDONP_OPENINFSENT IN VERBrec1.synvps AND
              rel1 = objrel AND
              rel2 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
