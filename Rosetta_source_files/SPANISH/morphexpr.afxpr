(* begin of verbs with ALO *)

(* pres. sing. ind.: *)
  ( ( SFKo ) [ ( SFKdiftong | SFKirrMedek | SFKeiouHeel | 
                  SFKve ) ] )
 | ( ( SFKas | SFKes | SFKe1s ) [ ( SFKdiftong | SFKeiouHeel | SFKyPlusPres | 
