       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
17: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                       catpresent:=TSTRING_comparechars(%VARNAME.str2,'CAT',3)=0;
                       IF catpresent THEN str1:=%VARNAME.str1
                        END
    *>
18: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN IF catpresent AND inpresent THEN
                                cattable:= %SETVALUENAME.valuetable;
                        END
    *>
19: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                        END
    *>
