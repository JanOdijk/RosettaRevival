\begin{verbatim}

% RULE ROtherClosedAdvPPropSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/I1::ADVPPROPVAR{ADVPPROPVARrec1},
                        mu3 
                       ],
                mu5
               ]
  
  SUBST:
  m2: CLOSEDADVPPROP{CLOSEDADVPPROPrec1}[mu4]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [mu2,
                        complrel/CLOSEDADVPPROP{CLOSEDADVPPROPrec1}[mu4],
                        mu3 
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: ADVPPROPVARrec1.index = LEVEL 
       m2: CLOSEDADVPPROPrec1.actsubcefs * AUX_otheradvsubcs <> []
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: ADVPPROPVARrec1 = COPYT_advppropTOvar(CLOSEDADVPPROPrec1) 
                                EXCEPT FOR [actsubcefs] AND
              ADVPPROPVARrec1.actsubcefs * AUX_otheradvsubcs <> []
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: ADVPPROPVARrec1 := COPYT_advppropTOvar(CLOSEDADVPPROPrec1);
              ADVPPROPVARrec1.index := LEVEL;
              ADVPPROPVARrec1.actsubcefs := 
                      CLOSEDADVPPROPrec1.actsubcefs * AUX_otheradvsubcs
         >
&

\end{verbatim}
