PACKAGE LIFIXIDDICT;
WITH STRNG, INTERFACE0;


(*MPC:::===================================================================*
 *
 *  Constant name  : LIFIXIDDICT_MaxStr
 *  Description    : Maximum number of chars in String
 *
 *EMP:::===================================================================*)
CONST
   LIFIXIDDICT_MaxStr = STRING_Max;


(*MPC:::===================================================================*
 *
 *  Constant name  : LIFIXIDDICT_MaxIdList
 *  Description    : Maximum number of entries in FIXIDDICT
 *
 *EMP:::===================================================================*)
CONST
   LIFIXIDDICT_MaxIdList = 10000;


(*MPT:::===================================================================*
 *
 *  Type name      : LIFIXIDDICT_RecordDef
 *  Description    : Type of and entry in FIXIDICT.
 *
 *EMP:::===================================================================*)
TYPE
   LIFIXIDDICT_RecordDef = RECORD
                             nxtchar : INTEGER;
                             nxtlevel: INTEGER;
                             ch      : CHAR;
                             mark    : BOOLEAN
                       END;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIFIXIDDICT_Open
 *  Description     : Open FIXIDDICT for Read access
 *  Parameters      : none
 *  Precondition    : FIXIDDICT is not yet open
 *  Postcondition   : FIXIDDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIFIXIDDICT_Open;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name : LIFIXIDDICT_AddIds
 *  Description    : Tries to find idioms in the input datastructure starting
 *                   at node s. If an idiom is found the corresponding node
 *                   is connected to s by means of the "nxtamb" pointer. 
 *                   The "rn" pointer will be equal to the "rn" pointer of the
 *                   right-most word of the idiom. All
 *                   idioms found in this way are considered to be of type
 *                   "InputWord".
 *  Parameters     : VAR s   : INTERFACE0_pSeqWords;
 *                   trailer : INTERFACE0_pSeqWords;
 *  Precondition   : FIXIDDICT has been opened
 *
 *EMP:::===================================================================*)

PROCEDURE LIFIXIDDICT_AddIds(VAR s   : INTERFACE0_pSeqWords;
                                        trailer : INTERFACE0_pSeqWords);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIFIXIDDICT_Close
 *  Description     : Close FIXIDDICT 
 *  Parameters      : none
 *  Precondition    : FIXIDDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIFIXIDDICT_Close;
EXTERNAL;

END {LIFIXIDDICT};
 s: INTERFACE0_pSeqWords;
                                      trailer: INTERFACE0_pSeqWords);
VAR 
   idiom        : STRING_String;
   Match,
   StillCorrect : BOOLEAN;
   NrChar,
   ContinueAt   : INTEGER;
   newlist,
   cur          :INTERFACE0_pSeqWords;
BEGIN
   DEBUG_WriteStr('-> FIXID_Find',DEBUG_MaxIO,0,TRUE);
   Debug_WriteLine(TRUE);
   cur := s;
   ContinueAt := 1; NewList := NIL; StillCorrect := TRUE; NrChar := 0;
   STRING_ConstantEmpty(idiom);
   WHILE (cur <> trailer) AND StillCorrect DO BEGIN
      Match := FALSE;
      IF STRING_Length(idiom) > 0 THEN STRING_AppendChar(idiom, idiom, ' ');
      STRING_Concat(idiom, idiom, cur^.word);
      FindWord(idiom, STRING_Length(idiom), NrChar,
               ContinueAt, StillCorrect, Match);
      IF Match THEN BEGIN
         NewList := INTERFACE0_MakeSeqWords(idiom, NewList);
         WITH NewList^ DO BEGIN
            kind := InputWord;
            X    := s^.X;
            Y    := s^.Y;
            len  := (cur^.Y-s^.Y)*ALAYOUT_WindowWidth + (cur^.x-s^.X) + 
                    cur^.len;
            rn   := cur^.rn
         END
      END;
      IF StillCorrect THEN BEGIN
         cur := cur^.nxt
      END
   END;
   s^.nxtamb := NewList;

   DEBUG_WriteStr('<- FIXID',DEBUG_MaxIO,0,TRUE);
   Debug_WriteLine(TRUE);

END {LIFIXIDDICT_AddIds};


PROCEDURE LIFIXIDDICT_Close;
BEGIN
   CISAM_Close(IdDict);
END {LIFIXIDDICT_Close};

