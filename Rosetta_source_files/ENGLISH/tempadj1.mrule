\begin{verbatim}
% TRANSFORMATION tADJaktstative1
< m1:ADJPPROP{ADJPPROPrec1}[mu1]
>

< m :ADJPPROP{ADJPPROPrec2}[mu1]
>
      COMP
         <
          C1: (ADJPPROPrec1.aktionsarts = [])
          A1: ADJPPROPrec2 := ADJPPROPrec1;
              ADJPPROPrec2.aktionsarts := [stative];
         >
      DECOMP
         <
          C1: (stative IN ADJPPROPrec2.aktionsarts)
          A1: ADJPPROPrec1 := ADJPPROPrec2;
              ADJPPROPrec1.aktionsarts := [];

         >

&
\end{verbatim}
