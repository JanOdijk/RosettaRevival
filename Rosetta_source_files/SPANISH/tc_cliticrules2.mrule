              (PERSPROrec1.genero = masc)     AND
              (PERSPROrec1.forma = acusCL)    AND
              (rel3 = unoCLrel)
          A1:  @
         >

   SUBRULE  (* me + deletion of mí; fem. *)
      <mu7: [I11:mu11]>                                       
