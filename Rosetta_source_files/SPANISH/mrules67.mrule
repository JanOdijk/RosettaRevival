% RULE RADJvoicedefault
< m1: ADJPPROP{ADJPPROPrec1}
                           [ mu1,
                             predrel/ADJP{ADJPrec1}
                                    [ mu2,
                                      head/ADJ{ADJrec1}[ mu3 ],
                                      mu4
                                    ] 
                           ]
>

< m : ADJPPROP{ADJPPROPrec1}
                           [ mu1,
                             predrel/ADJP{ADJPrec1}
                                    [ mu2,
                                      head/ADJ{ADJrec1}[ mu3 ],
                                      mu4
                                    ] 
                           ]
>


      COMP
         <
          C1: true
          A1: @
          >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
