\begin{verbatim}
% RULE Rlocpreppvar
< m1: VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  mu3 
                ]

  m2: I1::PREPPVAR{PREPPVARrec1}                 
>

< m :VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  locadvrel/I1::PREPPVAR{PREPPVARrec1},
                  mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: loc IN PREPPVARrec1.actsubcefs 
      >

      COMP
         <
          C1: true
          A1:  @
         >

&

\end{verbatim}

