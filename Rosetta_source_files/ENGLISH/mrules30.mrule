                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu7,
                           head/VERB{VERBrec1}[mu6],
                           I2:mu2,
                           I6:prepobjrel/T1,
                           I5:mu3
                         ],
                  mu4
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.synvpefs * AUX_emptyPrepobjVps <> []
       I2: ALL (mu2, I21:rel1/..)
         I21: rel1 IN AUX_prePrepobjVPrels AND 
              rel1 <> prepobjrel
       I3: ALL (mu3, I31:rel2/..)
       I4: EMPTYVARrec1.index = LEVEL
       I5: ALL (mu3, I31:rel2/..) AND
           NOT EXIST (mu3, [../EMPTYVAR{}]) AND
           NOT EXIST (mu3, [../VARPREPP{} [ I51:mu5] ]) 
         I31: rel2 IN AUX_postPrepobjVPrels AND
              rel2 <> prepobjrel
         I51: EXIST (mu5, [../EMPTYVAR{}])
       I6: T1.CAT <> EMPTYVAR
       I9: CLAUSErec2.synvpefs * AUX_emptyPrepobjVps <> []
