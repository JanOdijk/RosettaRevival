\newpage
\begin{verbatim}
% TRANSFORMATION TADJPATTERN16   
                    (* sentential object (NB. NO omitted preposition )
                       esta acostumbrado a que llueve siempre en Holanda,
                       estoy contento de verle,
                       estamos inseguras de si va a llover *)


< m1: ADJPPROP{ADJPPROPrec1}
                      [mu1,
                       predrel/ADJP{ADJPrec1}
                              [head/ADJ{ADJrec1}[mu2],
                               argrel/SENTENCEVAR{SENTENCEVARrec1}
                              ]
                       ]
>

< m : ADJPPROP{ADJPPROPrec2}
         [mu1,
          predrel/ADJP{ADJPrec2}
                  [head/ADJ{ADJrec1}[mu2],
                           prepobjrel/VARPREPP{VARPREPPrec1}
		                 [ head/PREP(ADJrec1.prepkey){PREPrec1}, 
			           objrel/SENTENCEVAR{SENTENCEVARrec1}
		                 ]
                  ]
         ]
>


      COMP 
         <
          C1: (ADJrec1.adjpatterns * [synPREPOPENINFSENT,  
                                        synPREPQUESENTind,
                                        synPREPQUESENTsubj,
                                        synPREPQSENT
                                        ]  <> [])       AND
              (ADJPPROPrec1.adjpatternefs = []) AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                  }
              )

             C11: (* estoy contento de verle *)
                  (synPREPOPENINFSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { PROsubject  : true                    
                                       finiteness  : infinite
                                       mood        : declarative
                                      }
                   )
             A11: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPOPENINFSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPOPENINFSENT]

             C12: (* esta acostumbrado a que llueve siempre en Holanda *)
                  (synPREPQUESENTind IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { finiteness  : finite
                                       mood        : declarative
                                       modo        : indicativo
                                      }
                   )
             A12: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPQUESENTind];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPQUESENTind]

             C13: (* no example found yet*)
                  (synPREPQUESENTsubj IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { finiteness  : finite
                                       mood        : declarative
                                       modo        : subjuntivo
                                      }
                  )
             A13: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPQUESENTsubj];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPQUESENTsubj]

             C14: (* estamos inseguras de si va a llover *)
                  (synPREPQSENT IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1.finiteness = finite) AND
                  (SENTENCEVARrec1.mood IN 
                   [WHinterrogative, YesNointerrogative])
                                       
             A14: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synPREPQSENT];
                  ADJPrec2 := ADJPrec1;
                  ADJPrec2.adjpatternefs := [synPREPQSENT];
                  VARPREPPrec1 := VARPREPPRECDEF;
                  VARPREPPrec1.specQ := yesspec;
                  VARPREPPrec1.actsubcefs:= PREPrec1.subcs;
                  VARPREPPrec1.headkey := PREPrec1.key;
                  VARPREPPrec1.synppefs := [synNP];
                  VARPREPPrec1.thetapp := pp120


          A1: @
 
         >

      DECOMP
         <
          C1: (ADJrec1.adjpatterns * [synPREPOPENINFSENT,  
                                        synPREPQUESENTind,
                                        synPREPQUESENTsubj,
                                        synPREPQSENT
                                        ]  <> [])       AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                  }
              ) AND
              (PREPrec1.key = ADJrec1.prepkey) AND 
              (VARPREPPrec1 = VARPREPPRECDEF 
                EXCEPT FOR [synppefs, headkey, thetapp, actsubcefs, specQ]) AND
              (synNP IN VARPREPPrec1.synppefs) AND
              (VARPREPPrec1.specQ = yesspec) AND
              (VARPREPPrec1.actsubcefs = PREPrec1.subcs) AND
              (VARPREPPrec1.headkey = PREPrec1.key) AND
              (VARPREPPrec1.thetapp = pp120)


              C11: (synPREPOPENINFSENT IN ADJrec1.adjpatterns) AND
                   (synPREPOPENINFSENT IN ADJPPROPrec2.adjpatternefs)
                    AND
                   (synPREPOPENINFSENT IN ADJPrec2.adjpatternefs)
                    AND
                   (SENTENCEVARrec1 = { PROsubject  : true                    
                                        finiteness  : infinite
                                        mood        : declarative
                                      }
                    )
              A11: @

              C12: (synPREPQUESENTind IN ADJrec1.adjpatterns) AND
                   (synPREPQUESENTind IN ADJPPROPrec2.adjpatternefs) AND
                   (synPREPQUESENTind IN ADJPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1 = { finiteness  : infinite
                                        mood        : declarative
                                        modo        : indicativo
                                      }
                    )
              A12: @

              C13: (synPREPQUESENTsubj IN ADJrec1.adjpatterns) AND
                   (synPREPQUESENTsubj IN ADJPPROPrec2.adjpatternefs) AND
                   (synPREPQUESENTsubj IN ADJPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1 = { finiteness  : infinite
                                        mood        : declarative
                                        modo        : subjuntivo
                                      }
                    )
              A13: @

              C14: (synPREPQSENT IN ADJrec1.adjpatterns) AND
                   (synPREPQSENT IN ADJPrec2.adjpatternefs) AND
                   (synPREPQSENT IN ADJPPROPrec2.adjpatternefs) AND
                   (SENTENCEVARrec1.finiteness = finite) AND
                   (SENTENCEVARrec1.mood IN 
                   [WHinterrogative, YesNointerrogative])
                                       
              A14: @
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []  

         >

&

\end{verbatim}
