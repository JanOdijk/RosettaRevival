pragma C_include ('auxcomlangspec.pf');
pragma C_include ('auxcomdecl.pf');

PACKAGE auxcomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH auxcomDECL,
     auxcomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: auxcomLANGSPEC_Category;
                          b: auxcomDECL_nodeid): auxcomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: auxcomDECL_psurfgraph): auxcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: auxcomDECL_psurfgraph): auxcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: auxcomDECL_psurfgraph): auxcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: auxcomDECL_psurfgraph): auxcomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: auxcomLANGSPEC_Category; 
                          c: auxcomDECL_psurfgraph); EXTERNAL;
 
END {auxcomGRAPH};
