\newpage
\begin{verbatim}
% TRANSFORMATION TADJnosuperdeixisadaptation
< m1:ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [I1: mu2],
            mu3
           ]
>

< m :ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [I1: mu2 ],
            mu3
           ]

>
   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11: rel1/T1])
       I11:((rel1 IN AUX_sentencerels) AND
            (T1.CAT = SENTENCE)
           ) OR
           ((rel1 = complrel) AND
            (T1.CAT IN [OPENADJPPROP, CLOSEDADJPPROP,OPENNPPROP, CLOSEDNPPROP,
                        OPENADVPPROP, CLOSEDADVPPROP, OPENVERBPPROP, 
                        CLOSEDVERBPPROP, OPENPREPPPROP, CLOSEDPREPPPROP])
           ) OR
           ((rel1 IN [degreemodrel, paraobjrel]) AND
            (T1.CAT IN [NP, ADVP, QP, PREPP])
           )
      >
      COMP
         <
          C1:true
          A1: @
         >

      DECOMP
         <
          C1:true
          A1: @
         >


&

\end{verbatim}
