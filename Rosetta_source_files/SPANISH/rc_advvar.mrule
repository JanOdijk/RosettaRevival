\newpage
\begin{verbatim}
% RULE Rlocadvvar
< m1: VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  I4:mu4,
                  I3:mu3 
                ]

  m2: I1::ADVPVAR{ADVPVARrec1}                 
>

< m :VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  I4:mu4,
                  locadvrel/I1::ADVPVAR{ADVPVARrec1},
                  I5:mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: locadv IN ADVPVARrec1.actsubcefs 
       I4: ALL(mu4, locadvrel/..)
       I3: NOT EXIST (mu3, [locadvrel/..])
       I5: NOT EXIST(mu3,[I51:rel5/..])
           I51: rel5 IN [locadvrel, tempadvrel, sentadvrel]
      >

      COMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
