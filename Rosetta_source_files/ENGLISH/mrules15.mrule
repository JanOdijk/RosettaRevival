\newpage
\begin{verbatim}
% RULE RvpadvPPsubst
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                 [ mu2,
                   I1:rel1/PREPPVAR{PREPPVARrec1},
                   mu3
                 ],
              mu6 
            ] 

  SUBST:
  m2: T2=VARPREPP{VARPREPPrec1}[mu4]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                   [ mu2,
                     I2:rel1/T3=VARPREPP{VARPREPPrec2}[mu4],
                     mu3
                   ],
              mu6 
            ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_Gsubstordercondition2(mu3,mu6, T2, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T2) 
       m : QUOTE_substordercondition2(mu3,mu6, CLAUSErec1.prosubject)
       I1: PREPPVARrec1.index = LEVEL AND
           rel1 IN [vpadvrel]
       I2: NOT QUOTE_NegPhrase(T3)           AND
           rel1 IN [vpadvrel]
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_preppTOvar(VARPREPPrec1) AND
              VARPREPPrec1.mood <> topicmood AND
              [instrum] * VARPREPPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              VARPREPPrec1.superdeixis)
          A1: VARPREPPrec2 := VARPREPPrec1;
              VARPREPPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: [instrum] * VARPREPPrec2.actsubcefs  <> [] AND
              VARPREPPrec2.superdeixis = omegadeixis AND
              VARPREPPrec2.mood <> topicmood
          A1: PREPPVARrec1 := COPYT_preppTOvar(VARPREPPrec2);
              PREPPVARrec1.index := LEVEL;
              VARPREPPrec1 := VARPREPPrec2;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 VARPREPPrec1.superdeixis)
         >

&

\end{verbatim}
