\newpage
\begin{verbatim}


% RULE rpppsubstitution5
< m1: I1::PREPPFORMULA{PREPPFORMULArec1}
                 [mu1,
                  subjrel/I2::NPVAR{NPVARrec1},
                  mu2,
                  predrel/PREPP{PREPPrec1}[mu3],
                  mu4
                 ] 
  SUBST:
  m2: NP{NPrec1}[mu5]
>

< m : I1::PREPPFORMULA{PREPPFORMULArec1}
                 [mu1,
                  subjrel/NP{NPrec2}[mu6],
                  mu2,
                  predrel/PREPP{PREPPrec1}[mu3],
                  mu4
                 ] 

>

   MATCHCONDITIONS
      < m1: QUOTE_Gsubstordercondition(mu2, mu3, mu4) 
        m : QUOTE_substordercondition(mu2, mu3, mu4)
        I1: PREPPFORMULArec1.PROsubject = false
        I2: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = [ ] AND
              NPrec1.generic = nogeneric AND
              NPrec1.supertiempo = PREPPFORMULArec1.supertiempo
          A1: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases); 
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric
         >

      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []); 
              NPrec1.supertiempo := PREPPFORMULArec1.supertiempo;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] rpppsubstitution5
\item[* relevant examples:] Parece contra el an\'{a}lisis
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] preppproptoformula
\item[* class:] RC\_pppSubst
\item[* date of creation:] 13-APR-1989
\item[* author:] Elly van Munster
\item[* copied from:] English RpppSubjSubst
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Substitution of subject NPs. Needed because in Spanish some 
structures do not take a subject in the main clause (the Spanish variant of 
`Hij bleek een dokter' does not exist; there only is `Het bleek dat hij een 
dokter is')
