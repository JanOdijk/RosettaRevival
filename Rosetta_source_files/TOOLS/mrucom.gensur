       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          APPENDSETS(%ITEM.records,otherrecords);
                          APPENDSETS(%ITEM.MuVarList,MuVarList);
                          APPENDSETS(%ITEM.SigmaVarList,SigmaVarList);
                          APPENDSETS(%ITEM.TreeVarList,TreeVarList);
                          APPENDSETS(%ITEM.NodeVarList,NodeVarList);
                          APPENDSETS(%ITEM.RelVarList,RelVarList);
                        END
    *>
9 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
10 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                          APPENDSETS(%LD.records,otherrecords);
                          APPENDSETS(%LD.MuVarList,MuVarList);
                          APPENDSETS(%LD.SigmaVarList,SigmaVarList);
