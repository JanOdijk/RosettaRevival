\newpage
\begin{verbatim}
% RULE Rfinpresfutdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I1: mu2,
                    I3: mu3
                   ],
            I6: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I1: mu2,
                    I4: mu4
                   ],
            I6: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I2: rel2/..])
       I2: rel2 IN [auxrel, passauxrel, progauxrel, head]
       I3: EXIST (mu3, [rel1/VERB{VERBrec3}[mu8]])
       I4: EXIST (mu4, [rel1/VERB{VERBrec3}[mu8]])
       I6: EXIST(mu5, [tempadvrel/..])

      >
<
   SUBRULE (* 1 first verb is not do or modal *)
      <mu3: [I7:rel3/VERB{VERBrec1}[mu9], mu10] >
      <mu4: [auxrel/VERB{VERBrec2}
                   [head/SUBVERB{SUBVERBrec1}
                        [head/BVERB(KEY_willbverbkey){BVERBrec1}]
                   ],
                I8:rel3/VERB{VERBrec5}[mu9], mu10
            ]
      >

   MATCHCONDITIONS
      <
       I7: (rel3 IN [passauxrel, head, progauxrel]) OR
           ((rel3 IN [auxrel]) AND
           (VERBrec1.subc = haveverb))
       I8: (rel3 IN [passauxrel, head, progauxrel]) OR
           ((rel3 IN [auxrel]) AND
           (VERBrec1.subc = haveverb))
       mu3: VERBrec1.subc = haveverb ->
            NOT EXIST (mu10, [auxrel/..])
       mu4: VERBrec5.subc = haveverb ->
            NOT EXIST (mu10, [auxrel/..])

      >


<
   SUBRULE (* 1a *)
      <mu5: [mu6, I9:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5: [mu6, I9:tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I9: ((ADVPVARrec1.class = reference) AND
            (ADVPVARrec1.retro = false) AND
            ((ADVPVARrec1.deixis = futuredeixis) OR
             (ADVPVARrec1.deixis = omegadeixis) OR
             (ADVPVARrec1.deixis = presentdeixis)
            ) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus) AND
              (CLAUSErec1.finiteness = finite) AND
              (((ADVPVARrec1.deixis <> presentdeixis)
               ) OR
               ((ADVPVARrec1.deixis = presentdeixis) AND
                (CLAUSErec1.aspect = perfective) AND
                (CLAUSErec1.retro = false) AND
