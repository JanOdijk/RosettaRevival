ENGLISH 47

&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TVerbpattern4
< m1: I1::VERBPPROP{VERBPPROPrec1}[mu1,
                                   predrel/VERBP{VERBPrec1}
                                          [head/VERB{VERBrec1}[mu2],
                                           argrel/T1,
                                           argrel/T2 
                                          ] 
                                  ] 
>

< m : VERBPPROP{VERBPPROPrec2}[mu1,
                               predrel/VERBP{VERBPrec1}             
                                      [head/VERB{VERBrec1}[mu2],
                                       rel1/T2,
                                       rel2/T1 
                                      ] 
                              ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
      >

<
   SUBRULE (* 1a. x1 give x2 x3 *)
      < T1: NPVAR{NPVARrec1} 
        T2: NPVAR{NPVARrec2} >

      < T1: NPVAR{NPVARrec1} 
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synIONP_DONP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_DONP];
              rel1 := indobjrel;
              rel2 := objrel
         >
      DECOMP
         <
          C1: synIONP_DONP IN VERBPPROPrec2.synvpefs AND
              synIONP_DONP IN VERBrec1.synvps AND
              rel1 = indobjrel AND
              rel2 = objrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. x1 give x2 x3 *)
      < T1: CNVAR{CNVARrec1} 
        T2: NPVAR{NPVARrec2} >

      < T1: CNVAR{CNVARrec1} 
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synIONP_DONP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_DONP];
              rel1 := indobjrel;
              rel2 := objrel
         >
      DECOMP
         <
          C1: synIONP_DONP IN VERBPPROPrec2.synvpefs AND
              synIONP_DONP IN VERBrec1.synvps AND
              rel1 = indobjrel AND
              rel2 = objrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1c. x1 give x2 x3 *)
      < T1: NPVAR{NPVARrec1} 
        T2: CNVAR{CNVARrec2} >

      < T1: NPVAR{NPVARrec1} 
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synIONP_DONP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_DONP];
              rel1 := indobjrel;
              rel2 := objrel
         >
      DECOMP
         <
          C1: synIONP_DONP IN VERBPPROPrec2.synvpefs AND
              synIONP_DONP IN VERBrec1.synvps AND
              rel1 = indobjrel AND
              rel2 = objrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1d. x1 give x2 x3 *)
      < T1: CNVAR{CNVARrec1} 
        T2: CNVAR{CNVARrec2} >

      < T1: CNVAR{CNVARrec1} 
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synIONP_DONP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_DONP];
              rel1 := indobjrel;
              rel2 := objrel
         >
      DECOMP
         <
          C1: synIONP_DONP IN VERBPPROPrec2.synvpefs AND
              synIONP_DONP IN VERBrec1.synvps AND
              rel1 = indobjrel AND
              rel2 = objrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2a. x1 refuse x2 x3 *)
      < T1: NPVAR{NPVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      < T1: NPVAR{NPVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_DONP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_DONP];
              rel1 := indobjrel;
              rel2 := objrel
         >
      DECOMP
         <
          C1: synEMPTY_DONP IN VERBPPROPrec2.synvpefs AND
              synEMPTY_DONP IN VERBrec1.synvps AND
              rel1 = indobjrel AND
              rel2 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b. x1 refuse x2 x3 *)
      < T1: CNVAR{CNVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      < T1: CNVAR{CNVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_DONP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_DONP];
              rel1 := indobjrel;
              rel2 := objrel
         >
      DECOMP
         <
          C1: synEMPTY_DONP IN VERBPPROPrec2.synvpefs AND
              synEMPTY_DONP IN VERBrec1.synvps AND
              rel1 = indobjrel AND
              rel2 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3a. x1 tell x2 x3*)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synIONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : finite
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_THATSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_THATSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                } AND (*not all attributes*)
              rel1 = indobjrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3b. x1 tell x2 x3*)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synIONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : finite
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_THATSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_THATSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                } AND (*not all attributes*)
              rel1 = indobjrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4. x1 promise EMPTY x2 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                mood        : declarative
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : finite
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_THATSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synEMPTY_THATSENT IN VERBPPROPrec2.synvpefs AND
              synEMPTY_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                } (*not all attributes*)
              AND 
              rel1 = indobjrel AND
              rel2 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5a. x1 tell x2 so *)
      < T1: PROSENTVAR{PROSENTVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: PROSENTVAR{PROSENTVARrec1}
        T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synIONP_SOPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_SOPROSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_SOPROSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_SOPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true AND
              rel1 = indobjrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5b. x1 tell x2 so *)
      < T1: PROSENTVAR{PROSENTVARrec1}
        T2: CNVAR{CNVARrec1} >

      < T1: PROSENTVAR{PROSENTVARrec1}
        T2: CNVAR{CNVARrec1} >

      COMP
         <
          C1: synIONP_SOPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_SOPROSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_SOPROSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_SOPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true AND
              rel1 = indobjrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 6a. x1 ask x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synIONP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative) 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_QSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_QSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative) AND
              rel1 = indobjrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 6b. x1 ask x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      COMP
         <
          C1: synIONP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative) 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_QSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_QSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative) AND
              rel1 = indobjrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7a. x1 promise x2 x3, x1 persuade x2 x3 *)

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synIONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                senttype    : subordinateclause
                                PROsubject  : true
                                finiteness  : infinite
                                infsort     : toinf        
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_OPENTOSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_OPENTOSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf        
                                } (*not all attributes*)
              AND 
              rel1 = indobjrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7b. x1 promise x2 x3, x1 persuade x2 x3 *)

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec1} >

      COMP
         <
          C1: synIONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 ={
                                senttype    : subordinateclause
                                PROsubject  : true
                                finiteness  : infinite
                                infsort     : toinf        
                               } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_OPENTOSENT];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_OPENTOSENT IN VERBPPROPrec2.synvpefs AND
              synIONP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : true
