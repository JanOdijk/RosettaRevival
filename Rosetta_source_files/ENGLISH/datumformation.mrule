\newpage
\begin{verbatim}
% RULE RNPyear
< m1: NP{NPrec1}[head/PROPERNOUN{PROPERNOUNrec1}[mu1]]
  m2: NP{NPrec2}[mu2]
>

< m : NP{NPrec1}[
                 head/PROPERNOUN{PROPERNOUNrec1}[mu1],
                 postmodrel/NP{NPrec3}[mu2]
                 ]
>
      COMP
         <
          C1: monthnoun IN NPrec1.actsubcs AND
              NPrec2.NPhead = CardNP AND
              NPrec2.superdeixis = NPrec1.superdeixis AND
              NPrec2.generic = nogeneric
          A1: NPrec3 := NPrec2;
              NPrec3.generic := omegageneric;
              NPrec3.superdeixis := omegadeixis;
              (*NPrec1.class := NPrec3.class;*)
              (*NPrec1.aspect := NPrec3.aspect;*)

         >
      DECOMP
         <
          C1: monthnoun IN NPrec1.actsubcs AND
              NPrec3.NPhead = CardNP AND
              NPrec3.superdeixis = omegadeixis AND
              NPrec3.generic = omegageneric
              (*NPrec1.class = NPrec3.class AND*)
              (*NPrec1.aspect = NPrec3.aspect AND*)
          A1: NPrec2 := NPrec3;
              NPrec2.generic := nogeneric;
              NPrec2.superdeixis := NPrec1.superdeixis;
         >

&

\end{verbatim}
