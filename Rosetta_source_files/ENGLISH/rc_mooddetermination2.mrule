\newpage
\begin{verbatim}

% RULE RPastPartMood
< m1:I1::CLAUSE{CLAUSErec1}
               [ I2:subjrel/T1, 
                 mu1,
                 predrel/VERBP{VERBPrec1}
                        [ I4:mu2,
                          sig1,
                          sig2,
                          head/VERB{VERBrec1}[mu3],
                          mu4
                        ],
                 mu5
               ] 
>

< m :I3::SENTENCE{SENTENCErec1}
               [ I2:subjrel/T1, 
                 mu1,
                 predrel/VERBP{VERBPrec1}
                        [ I4:mu2,
                          head/VERB{VERBrec4}[mu3],
                          mu4
                        ],
                 mu5
               ] 
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.PROsubject = true AND
           CLAUSErec1.finiteness = infinite AND
           CLAUSErec1.infsort = omegainf AND
           CLAUSErec1.modus = omegamodus  AND
           CLAUSErec1.aspect = perfective
       I2: T1.CAT IN [NPVAR, CNVAR]
       I3: SENTENCErec1 = { mood       : anterelative
                            senttype   : subordinateclause
                            modus      : participle
                            finiteness : infinite
                            aspect     : perfective
                            PROsubject : true
                            infsort    : omegainf
                            conjkey    : 0
                            adverbial  : false
                            temporal   : false
                            conjclass  : omegaTimeadvClass
                            conjdeixis : omegadeixis
                            conjaspect : omegaAspect
                            conjretro  : false }
       I4: NOT EXIST (mu2, [../VERB{VERBrec5}[mu6]])
      >

<
   SUBRULE (* 1a. bare passive *)
      < sig1: []
        sig2: [ passauxrel/VERB{VERBrec2}
                          [head/SUBVERB{SUBVERBrec2}
                               [head/BVERB(KEY_beBVERBkey){BVERBrec2}]
                          ]
              ] >
      < >

      COMP
         <
          C1: CLAUSErec1.voice = passive AND
              VERBrec1.modus = participle  AND
              SUBVERBrec2 = COPYT_bverbTOsubverb(BVERBrec2) AND
              VERBrec2 = COPYT_subverbTOverb(SUBVERBrec2) AND
              VERBrec2 = { modus    : omegamodus
                           tense    : omegatense
                           persons  : []
                           numbers  : [] } 
          A1: SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : anterelative
                                senttype : subordinateclause
                                modus    : participle } ;
             (* other attributes specific to sentence 
                retain default values *)
              VERBrec4 := VERBrec1
         >

      DECOMP
         <
          C1: SENTENCErec1.voice = passive AND
              VERBrec4.modus = participle
          A1: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              SUBVERBrec2 := COPYT_bverbTOsubverb(BVERBrec2);
              VERBrec2 := COPYT_subverbTOverb(SUBVERBrec2);
              VERBrec2 := { modus    : omegamodus
                            tense    : omegatense
                            persons  : []
                            numbers  : [] } ;
              VERBrec1 := VERBrec4
         >

   SUBRULE (* 1b. have + passive *)
      < sig1: [ auxrel/VERB{VERBrec3}
                      [head/SUBVERB{SUBVERBrec3}
                           [head/BVERB(KEY_haveBVERBkey){BVERBrec3} ]
                          ]
              ]
        sig2: [ passauxrel/VERB{VERBrec2}
                          [head/SUBVERB{SUBVERBrec2}
                               [head/BVERB(KEY_beBVERBkey){BVERBrec2}]
                          ]
              ] >
      < >

      COMP
         <
          C1: CLAUSErec1.voice = passive AND
              VERBrec1.modus = participle  AND
              SUBVERBrec2 = COPYT_bverbTOsubverb(BVERBrec2) AND
              VERBrec2 = COPYT_subverbTOverb(SUBVERBrec2) AND
              VERBrec2 = { modus    : participle
                           tense    : omegatense
                           persons  : []
                           numbers  : [] } AND
              SUBVERBrec3 = COPYT_bverbTOsubverb(BVERBrec3) AND
              VERBrec3 = COPYT_subverbTOverb(SUBVERBrec3) AND
              VERBrec3 = { modus    : omegamodus
                           tense    : omegatense
                           persons  : []
                           numbers  : [] }
          A1: SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : anterelative
                                senttype : subordinateclause
                                modus    : participle } ;
             (* other attributes specific to sentence 
                retain default values *)
              VERBrec4 := VERBrec1
         >

      DECOMP
         <
          C1: SENTENCErec1.voice = passive AND
              VERBrec4.modus = participle
          A1: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              SUBVERBrec2 := COPYT_bverbTOsubverb(BVERBrec2);
              VERBrec2 := COPYT_subverbTOverb(SUBVERBrec2);
              VERBrec2 := { modus    : participle
                            tense    : omegatense
                            persons  : []
                            numbers  : [] };
              SUBVERBrec3 := COPYT_bverbTOsubverb(BVERBrec3);
              VERBrec3 := COPYT_subverbTOverb(SUBVERBrec3);
              VERBrec3 := { modus    : omegamodus
                            tense    : omegatense
                            persons  : []
                            numbers  : [] } ;
              VERBrec1 := VERBrec4
         >

   SUBRULE (* 2a. bare ergative *)
      < sig1: [] 
        sig2: [] >
      < >

      COMP
         <
          C1: CLAUSErec1.thetavp IN [vp010, vp012] AND
              VERBrec1.modus = omegamodus
          A1: SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : anterelative
                                senttype : subordinateclause
                                modus    : participle } ;
             (* other attributes specific to sentence 
                retain default values *)
              VERBrec4 := VERBrec1;
              VERBrec4.modus := participle
         >

      DECOMP
         <
          C1: SENTENCErec1.thetavp IN [vp010, vp012] AND
              VERBrec4.modus = participle
          A1: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              VERBrec1 := VERBrec4;
              VERBrec1.modus := omegamodus
         >

   SUBRULE (* 2b. have + ergative *)
      < sig1: [ auxrel/VERB{VERBrec3}
                      [head/SUBVERB{SUBVERBrec3}
                           [head/BVERB(KEY_haveBVERBkey){BVERBrec3} ]
                      ]
              ]
        sig2: [] >
      < >

      COMP
         <
          C1: CLAUSErec1.thetavp IN [vp010, vp012] AND
              VERBrec1.modus = participle AND
              SUBVERBrec3 = COPYT_bverbTOsubverb(BVERBrec3) AND
              VERBrec3 = COPYT_subverbTOverb(SUBVERBrec3) AND
              VERBrec3 = { modus    : omegamodus
                           tense    : omegatense
                           persons  : []
                           numbers  : [] }
          A1: SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : anterelative
                                senttype : subordinateclause
                                modus    : participle } ;
             (* other attributes specific to sentence 
                retain default values *)
              VERBrec4 := VERBrec1
         >

      DECOMP
         <
          C1: SENTENCErec1.thetavp IN [vp010, vp012] AND
              VERBrec4.modus = participle
          A1: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              SUBVERBrec3 := COPYT_bverbTOsubverb(BVERBrec3);
              VERBrec3 := COPYT_subverbTOverb(SUBVERBrec3);
              VERBrec3 := { modus    : omegamodus
                            tense    : omegatense
                            persons  : []
                            numbers  : [] };
              VERBrec1 := VERBrec4
         >
>
&

\end{verbatim}
