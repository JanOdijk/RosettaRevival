%UTT
BASIS RULE
  UTT = LANGVERSION/1. [KEYSECTION/2].[RECSECTION/3].[ABBRSECTION/4].
                       [VARCATSECTION/5]

SURFACE PART
VAR basetypes::setofidents;
    newentries:BOOLEAN;

<*
 INIT:BEGIN newentries:=FALSE;
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN newentries:=%KEYSECTION.newentries
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN basetypes:=%ABBRSECTION.basetypes
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_UTT;
                  $UTT.newentries:=newentries;
                  $UTT.basetypes:=basetypes;
                END
*>
END;

PROCEDURAL PART
VAR 
    basetypes::setofidents;
    ident::ident;
    newentries:BOOLEAN;
BEGIN
INIT:BEGIN basetypes:=$UTT.basetypes;
           newentries:=$UTT.newentries;
     END;
<*
1: <* SEND: BEGIN END
      !LANGVERSION.
      RECEIVE: BEGIN 
                 TFILES_open(of1,'auxenv',6,3);
                 BEGIN
                   \of1.\GLOBAL.\\
                   TAB(of1,5);"pragma C_include('string.pf');"\\
                   TAB(of1,5);"pragma C_include('files.pf');"\\
                   TAB(of1,5);"pragma C_include('lsdomaint.pf');"\\\\
                   "PACKAGE LSAUXDOM;"\\\\
                   "WITH strng,files,lsdomaint;"\\
                   IF stillidents(basetypes) THEN BEGIN "TYPE "\\ END;
                   WHILE stillidents(basetypes) DO
                     BEGIN
                     takeident(ident,basetypes);
                     "SETOF" ""ident.str"" "=SET OF LSDOMAINT_"
                       ""ident.str"" ";"\\
                     END;
                 END;
                 TFILES_open(of2,'auxpas',6,3);
                 BEGIN
                   \of2.\GLOBAL.\\
                   "EXPORT(lsauxdom);"\\
              IF newentries THEN
                    BEGIN TAB(of2,5);"pragma C_include('constfile.pf');"\\ END;
                   TAB(of2,5);"pragma C_include('lsauxdom.pf');"\\
                   TAB(of2,5);"pragma C_include('string.pf');"\\
                   TAB(of2,5);"pragma C_include('files.pf');"\\
                   TAB(of2,5);"pragma C_include('lsdomaint.pf');"\\   
                   TAB(of2,5);"pragma C_include('strtokey.pf');"\\
     
                   "PROGRAM LSAUXDOM;"\\\\
                   "WITH strng,files,lsdomaint,strtokey;"\\
                              "FUNCTION auxkey(strkey:STRING_string):INTEGER;"\\
                              "VAR int:INTEGER;"\\
                              "BEGIN"\\
                              " STRTOKEY_getSkey(strkey,int); auxkey:=int;"\\
                              "END;"\\
                 END;
                 TFILES_open(of3,'substpas',8,3);
                 BEGIN
                   \of3.\GLOBAL.\\
                   "EXPORT(ldsubsttovar);"\\
                   TAB(of3,5);"pragma C_include('ldsubsttovar.pf');"\\    
                   TAB(of3,5);"pragma C_include('lsdomaint.pf');"\\      
                   TAB(of3,5);"pragma C_include('listree.pf');"\\    
                   TAB(of3,5);"pragma C_include('lsstree.pf');"\\
                   TAB(of3,5);"pragma C_include('maket.pf');"\\  
                   "PROGRAM LDSUBSTTOVAR;"\\\\
                   "WITH lsdomaint,listree,lsstree,maket;"\\
                 END;
               END
   *>
2: <* SEND: BEGIN END
      !KEYSECTION.
      RECEIVE: BEGIN 
               END
   *>
3: <* SEND: BEGIN END
      !RECSECTION.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN END
      !ABBRSECTION.
      RECEIVE: BEGIN END
   *>
5: <* SEND: BEGIN END
      !VARCATSECTION.
      RECEIVE: BEGIN END
   *>
*>
FINAL: BEGIN
         BEGIN
           \of1.\GLOBAL.\\\\
           "END; {LSAUXDOM}"
         END;
         BEGIN
           \of2.\GLOBAL.\\\\
         END;
         BEGIN
           \of3.\GLOBAL.\\\\
         END
       END
END;
&


