            XmNlabelString = 'Delete lemma'; 
          };
          callbacks {
            MrmNcreateCallback = procedure
                  XwuCreateWidget (X_le_delete_lemma_button);
            XmNactivateCallback = procedure 
                  XwbAction (X_le_delete_lemma_button);
          };
        };
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Insert'; 
          };
          controls { 
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments { 
                    arguments cascade_args;
                    XmNlabelString = 'Meaning'; 
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
                        XwuCreateWidget (X_le_insert_meaning_button);
                    XmNactivateCallback = procedure 
                        XwbAction (X_le_insert_meaning_button);
                  };
                };
                XmPushButton {
                  arguments { 
                    arguments cascade_args;
                    XmNlabelString = 'Particle'; 
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
                        XwuCreateWidget (X_le_insert_particle_button);
                    XmNactivateCallback = procedure 
                        XwbAction (X_le_insert_particle_button);
                  };
                };
                XmPushButton {
                  arguments { 
                    arguments cascade_args;
                    XmNlabelString = 'Idiom'; 
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
                        XwuCreateWidget (X_le_insert_idiom_button);
                    XmNactivateCallback = procedure 
                        XwbAction (X_le_insert_idiom_button);
                  };
                };
                XmPushButton {
                  arguments { 
                    arguments cascade_args;
                    XmNlabelString = 'Semi-Idiom'; 
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
                        XwuCreateWidget (X_le_insert_semi_idiom_button);
                    XmNactivateCallback = procedure 
                        XwbAction (X_le_insert_semi_idiom_button);
                  };
                };
              };
            };
          };
        };
      };
    };
  };
};

