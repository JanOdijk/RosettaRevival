% RULE RMood7a         (*imperativemood sg main clause, finite, imperative, masc*)
< m1:I6::CLAUSE{CLAUSErec1}
           [ subjrel/NP{NPrec1}
                    [head/PERSPRO{PERSPROrec1}
                          [head/BPERSPRO(KEY_tumascbpersprokey){BPERSPROrec1}] 
                    ],
             I3:mu1,
             head/VERB{VERBrec1}
                 [ I1:rel1/VERB{VERBrec2}[mu3],
                   mu4
                 ],
             mu5
           ] 
>

< m :I7::SENTENCE{SENTENCErec1}
             [ I3:mu1,
               head/VERB{VERBrec1}
                   [ I1:rel1/VERB{VERBrec3}[mu3],
                     mu4
                   ],
               mu5
             ] 
>

   MATCHCONDITIONS
      <
       I1 : rel1 IN [head, auxrel]
       I3 : NOT EXIST(mu1, [subjrel/..])
       I6 : CLAUSErec1.finiteness = finite  AND
            CLAUSErec1.tiempo = presente AND
            CLAUSErec1.modo = imperativo
       I7 : SENTENCErec1.tiempo = presente AND
            SENTENCErec1 =
		   {
                    finiteness : finite
 		    mood       : imperativemood
		    senttype   : mainclause
                    conjkey    : 0
                    adverbial  : false
                    temporal   : false
		    conjclass  : omegaTimeAdvClass
		    conjtiempo : omegatiempo
		    conjaspecto : omegaaspecto
		    conjretro  : false
		   }

      >


      COMP
         <
          C1: VERBrec2.modo = omegamodo AND
              VERBrec2.persona = 2       AND
              VERBrec2.numero = singular  AND
              NPrec1 = AUX_NPONtumascbprspr  AND
              PERSPROrec1 = COPYT_BtoPERSPRO(BPERSPROrec1) AND
              PERSPROrec1 =
                 {
                   forma         : Nomfuerte
                 }

              C11: NOT EXIST(mu1, [negrel/..])
              A11: VERBrec3 := VERBrec2;
                   VERBrec3.modo := imperativo;
                   SENTENCErec1 := COPYT_clausetosentence(CLAUSErec1);
                   SENTENCErec1 :=
		      {
		       mood     : imperativemood
		       senttype : mainclause
		       modo     : imperativo
		      }
                  (* other attributes retain default values *)
              C12: EXIST(mu1, [negrel/..]) AND
                   VERBrec2.tiempo = omegatiempo 
              A12: VERBrec3 := VERBrec2;
                   VERBrec3.modo := subjuntivo;
                   VERBrec3.tiempo := presente;
                   SENTENCErec1 := COPYT_clausetosentence(CLAUSErec1);
                   SENTENCErec1 :=
		      {
		       mood     : imperativemood
		       senttype : mainclause
		       modo     : subjuntivo
		      }
                  (* other attributes retain default values *)
          A1: @
         >

      DECOMP
         <
          C1: VERBrec3.persona = 2 AND
              VERBrec3.numero = singular
              C11: NOT EXIST(mu1,[negrel/..]) AND
                   VERBrec3.modo = imperativo AND
                   SENTENCErec1.modo = imperativo 
              A11: VERBrec2 := VERBrec3;
                   CLAUSErec1 := COPYT_sentencetoclause(sentencerec1);
              C12: NOT EXIST(mu1,[negrel/..]) AND
                   VERBrec3.modo = subjuntivo AND
                   VERBrec3.tiempo = presente AND
                   SENTENCErec1.modo = subjuntivo
              A12: VERBrec2 := VERBrec3;
                   VERBrec2.tiempo := omegatiempo;
                   CLAUSErec1 := COPYT_sentencetoclause(sentencerec1);
          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);
              PERSPROrec1 :=
                 {
                   forma         : Nomfuerte
                 };
              NPrec1 := AUX_NPONtumascbprspr;
              VERBrec2.modo := omegamodo;
     
         >


&

\end{verbatim}

