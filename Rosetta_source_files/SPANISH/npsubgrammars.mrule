% FILTER Fesoesto
< m :NPPROP{NPPROPrec1}[subjrel/T1,mu1 ]
>
  
   MATCHCONDITIONS
      <
       m : T1.CAT IN [NPVAR] WITH T1.REC.NPhead IN 
              [redelloNP, esteNP, eseNP, aquelNP] AND
           EXIST(mu1,[predrel/..])
      >


         <
          C1: NPPROPrec1.prosubject = false 
          A1: @
         >


&

