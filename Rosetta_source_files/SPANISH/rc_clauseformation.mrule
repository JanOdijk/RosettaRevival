\begin{verbatim}
% RULE RClauseformation5 (* identificational, NPPROP *)
< m1:NPPROP{NPPROPrec1}
           [ mu12,
             subjrel/T1,
             mu1,
             idrel/T2,
             mu2 
           ] 
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu12,
             subjrel/T1,
             mu1,
             predrel/VERBP{VERBPrec1}
                    [ head/VERB{VERBrec1}
                          [ head/SUBVERB{SUBVERBrec1}
                                [ head/BVERB(AUX_serbverbkey){BVERBrec1} ] 
                          ],
                      cliticrel/CLITIC{}[],
                      predrel/T2                        
                    ],
             mu2 
           ]
>

   MATCHCONDITIONS
      <
       I1:  (CLAUSErec1.voice = active ) AND
            ( synSER IN CLAUSErec1.synvpefs ) 
      >


      COMP
         <
          C1: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts, req]
          A1: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
              (* all other attributes of VERBrec1  retain the default values *)
              (* VERBPrec1 retains all default values *)
              CLAUSErec1 := COPYT_npproptoclause(NPPROPrec1);
              CLAUSErec1 :=
	       { 
		voice       : active
		synvpefs    : [synSER]
	       }
              (* all others retain the default values *)
         >

      DECOMP
         <
          C1:( CLAUSErec1 = CLAUSErecdef EXCEPT FOR [ voice, synvpefs,
               req, aktionsarts ] ) AND
              ( VERBPrec1 = VERBPrecdef ) AND
              ( SUBVERBrec1 = COPYT_btosubverb(BVERBrec1) ) AND
              ( VERBrec1 = COPYT_subtoverb(SUBVERBrec1) ) AND
              ( VERBrec1 =
		  { 
		   numero       : omeganumero   
		   persona      : 3  
		   modo         : infinitivo  
		   tiempo       : omegatiempo
		   status       : bareV
		  }
              )
             (* the default values for these attributes *)
          A1: (* NPPROPrec1 := NPPROPrecdef; automatically *)
              NPPROPrec1 := 
               {
                 req         : CLAUSErec1.req             
                 aktionsarts : CLAUSErec1.aktionsarts
               }
         >
&

