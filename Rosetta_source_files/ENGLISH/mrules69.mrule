\newpage
\begin{verbatim}
% RULE RCNformation2

< m1:  EN(KEY_massENkey){ENrec1} 
>

< m :  CN{CNrec1}[head/EN(KEY_massENkey){ENrec1}]
>

      COMP
         <
          C1: true
          A1: CNrec1.numbers   := [singular];
              CNrec1.posscomas := [mass]
             (* .req hasn't been determined yet;
                the other attributes have default value *)
         >

      DECOMP
         <
          C1: CNrec1 = CNRECDEF EXCEPT FOR [numbers, posscomas] AND
              (CNrec1.numbers        = [singular]) AND
              (CNrec1.posscomas      = [mass])
          A1:  @               
         >
&

\end{verbatim}
