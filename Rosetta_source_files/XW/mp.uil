object mp_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
        XmNdialogTitle = N_mp_window;
        XmNnoResize    = true;
    };
    controls {
        XmFrame mp_rule_frame;
        XmFrame mp_trans_frame;
        XmFrame mp_toggle_frame;
        XmRowColumn mp_button_box;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_mp_window + DEFAULT_BUTTON_OFFSET*X_mp_start_button);
    };
};

object mp_rule_frame : XmFrame {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_FORM;
    };
    controls {
        XmForm {
            arguments {
                arguments form_args;
                XmNbackgroundPixmap = xbitmapfile ('zz');
            };
            controls {
                XmLabel mp_rule_sel_title;
                XmScrolledList mp_rule_sel_list;
                XmLabel mp_rule_info_title;
                XmScrolledList mp_rule_info_list;
                XmRowColumn mp_rule_text;
                XmRowColumn mp_rule_button_box;
            };
        };
    };    
};

object mp_rule_sel_title : XmLabel {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
!	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;

        XmNlabelString      = N_mp_rule_sel_list;
        XmNfontList         = bold;
    };
};

object mp_rule_sel_list : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmLabel mp_rule_sel_title;

        arguments list_args;
        XmNvisibleItemCount = 5;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;
        XmNspacing          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(X_mp_rule_sel_list);
    };    
};

object mp_rule_info_title : XmLabel {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
!	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmScrolledList mp_rule_sel_list;

        XmNlabelString      = N_mp_rule_info_list;
        XmNfontList         = bold;
    };
};

object mp_rule_info_list : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmLabel mp_rule_info_title;

        arguments list_args;
        XmNvisibleItemCount = 5;
        XmNselectionPolicy  = XmSINGLE_SELECT;
        XmNspacing          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(X_mp_rule_info_list);
        XmNsingleSelectionCallback =
                  procedure XwlAction (X_mp_rule_info_list);
    };
};

object mp_rule_text : XmRowColumn {
    arguments {
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmScrolledList mp_rule_info_list;
        XmNleftAttachment    = XmATTACH_FORM;

        XmNbackgroundPixmap = xbitmapfile ('zz');
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                XmNlabelString       = N_mp_rule_text;
                XmNfontList          = bold;
            };
        };
        XmText {
            arguments {
                arguments text_args;
                XmNcolumns           = 23;
            };
            callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_mp_rule_scroll_text);
                XmNactivateCallback = procedure
                    XwlAction(X_mp_rule_add_text);
                XmNvalueChangedCallback = procedure
                    XwlAction(X_mp_rule_scroll_text);
    	    };    
        };
    };
};

object mp_rule_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmRowColumn mp_rule_text;

        arguments button_box_args;
        XmNbackgroundPixmap = xbitmapfile ('zz');
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString       = N_mp_rule_remove_button;
            };
            callbacks {
                XmNactivateCallback = procedure
                    XwlAction(X_mp_rule_remove_button);
            };    
        };
        XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString       = N_mp_rule_clear_button;
            };
            callbacks {
                XmNactivateCallback = procedure
                    XwlAction(X_mp_rule_clear_button);
            };    
        };
    };
};

object mp_trans_frame : XmFrame {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_WIDGET;
        XmNleftWidget        = XmFrame mp_rule_frame;
        XmNleftOffset        = 2 * spacing_h;
        XmNrightAttachment   = XmATTACH_FORM;
    };
    controls {
        XmForm {
            arguments {
                arguments form_args;
                XmNbackgroundPixmap = xbitmapfile ('zz');
            };
            controls {
                XmLabel mp_trans_sel_title;
                XmScrolledList mp_trans_sel_list;
                XmLabel mp_trans_info_title;
                XmScrolledList mp_trans_info_list;
                XmRowColumn mp_trans_text;
                XmRowColumn mp_trans_button_box;
            };
        };
    };    
};

