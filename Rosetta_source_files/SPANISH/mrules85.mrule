% TRANSFORMATION TPREPPca0
< m1:PREPP{PREPPrec1}[I1:mu2] 
>

< m :PREPP{PREPPrec1}[I1:mu2] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [I11:objrel/T1])
       I11: T1.CAT IN [NPVAR, CNVAR]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
