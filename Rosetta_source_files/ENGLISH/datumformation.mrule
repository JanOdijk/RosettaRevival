% RULE RCARD2
< m1:CARD{CARDrec1}[mu1]
  m2:DIGIT{DIGITrec1} 
>

< m :CARD{CARDrec2}
             [head/CARD{CARDrec1}[mu1],
              postmodrel/DIGIT{DIGITrec1}       
