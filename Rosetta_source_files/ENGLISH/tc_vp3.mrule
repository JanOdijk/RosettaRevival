   SUBRULE (* 8. x1 promise EMPTY x3 *)

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf        
                                } (*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
