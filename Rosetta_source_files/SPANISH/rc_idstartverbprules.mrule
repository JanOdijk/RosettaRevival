%RULE RIDCN1

<m1: NOUN{NOUNREC1}[head/SUBNOUN{SUBNOUNREC1}[head/BNOUN(KEY1){BNOUNREC1}]]
>

< m:  CNFORMATION/RCNMODPOSS1
        [CNFORMATION/RCNFORMATION1
           [BLEX/NOUN{NOUNREC1}[head/SUBNOUN{SUBNOUNREC1}
                                   [head/BNOUN(KEY2){BNOUNREC1}]
                               ]
           ],
         NPFORMATION/RNPFORMATION4
           [CNFORMATION/RCNFORMATION1
              [CNFORMATION/RSUBNOUNTONOUN1
                 [NPDERIVATION/BNOUNTOSUBNOUN
                    [BLEX/BNOUN(KEY3)]
                 ]
              ]
           ]
        ]
>

COMP
 <
   C1: COMPINIDDICT(KEY1, VPID40)
   A1: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID40);
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3>, VPID40)
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID40);
 >

&
\end{verbatim}

