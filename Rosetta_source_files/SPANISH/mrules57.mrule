SPANISH 57
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Tsuperdeixisadaptation3
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    I1: rel1/T1, 
                    mu3
                   ],
            mu4
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2, 
                    I2: rel1/T2, 
                    mu3
                   ],
            mu4
           ]

>
   MATCHCONDITIONS
      <
       I1: (rel1 IN [complrel, dirargrel, locargrel, predrel]) AND
           T1.CAT IN [OPENADJPPROP, CLOSEDADJPPROP, OPENPREPPPROP, 
                      CLOSEDPREPPPROP, OPENNPPROP, CLOSEDNPPROP,
                      OPENADVPPROP, CLOSEDADVPPROP]
       I2: (rel1 IN [complrel, dirargrel, locargrel, predrel]) AND
           T2.CAT IN [OPENADJPPROP, CLOSEDADJPPROP, OPENPREPPPROP, 
                      CLOSEDPREPPPROP, OPENNPPROP, CLOSEDNPPROP,
                      OPENADVPPROP, CLOSEDADVPPROP]
      >

<
   SUBRULE (* 1 *)
      < T1: OPENADJPPROP{OPENADJPPROPrec1}[mu5] >
      < T2: OPENADJPPROP{OPENADJPPROPrec2}[mu5] >

      COMP
         <
          C1:true

            C11: (OPENADJPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: OPENADJPPROPrec2 := OPENADJPPROPrec1;
                  OPENADJPPROPrec2.supertiempo := omegatiempo;

             C12:(OPENADJPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: OPENADJPPROPrec2 := OPENADJPPROPrec1;
                   OPENADJPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(OPENADJPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: OPENADJPPROPrec1 := OPENADJPPROPrec2;
                   OPENADJPPROPrec1.supertiempo := presente;
            
              C12: (OPENADJPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: OPENADJPPROPrec1 := OPENADJPPROPrec2;
                    OPENADJPPROPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 2 *)
      < T1: CLOSEDADJPPROP{CLOSEDADJPPROPrec1}[mu5] >
      < T2: CLOSEDADJPPROP{CLOSEDADJPPROPrec2}[mu5] >

      COMP
         <
          C1:true

            C11: (CLOSEDADJPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: CLOSEDADJPPROPrec2 := CLOSEDADJPPROPrec1;
                  CLOSEDADJPPROPrec2.supertiempo := omegatiempo;

             C12:(CLOSEDADJPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: CLOSEDADJPPROPrec2 := CLOSEDADJPPROPrec1;
                   CLOSEDADJPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(CLOSEDADJPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: CLOSEDADJPPROPrec1 := CLOSEDADJPPROPrec2;
                   CLOSEDADJPPROPrec1.supertiempo := presente;
            
              C12: (CLOSEDADJPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: CLOSEDADJPPROPrec1 := CLOSEDADJPPROPrec2;
                    CLOSEDADJPPROPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 3 *)
      < T1: OPENPREPPPROP{OPENPREPPPROPrec1}[mu5] >
      < T2: OPENPREPPPROP{OPENPREPPPROPrec2}[mu5] >

      COMP
         <
          C1:true

            C11: (OPENPREPPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: OPENPREPPPROPrec2 := OPENPREPPPROPrec1;
                  OPENPREPPPROPrec2.supertiempo := omegatiempo;

             C12:(OPENPREPPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: OPENPREPPPROPrec2 := OPENPREPPPROPrec1;
                   OPENPREPPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(OPENPREPPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: OPENPREPPPROPrec1 := OPENPREPPPROPrec2;
                   OPENPREPPPROPrec1.supertiempo := presente;
            
              C12: (OPENPREPPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: OPENPREPPPROPrec1 := OPENPREPPPROPrec2;
                    OPENPREPPPROPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 4 *)
      < T1: CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}[mu5] >
      < T2: CLOSEDPREPPPROP{CLOSEDPREPPPROPrec2}[mu5] >

      COMP
         <
          C1:true

            C11: (CLOSEDPREPPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: CLOSEDPREPPPROPrec2 := CLOSEDPREPPPROPrec1;
                  CLOSEDPREPPPROPrec2.supertiempo := omegatiempo;

             C12:(CLOSEDPREPPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: CLOSEDPREPPPROPrec2 := CLOSEDPREPPPROPrec1;
                   CLOSEDPREPPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(CLOSEDPREPPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: CLOSEDPREPPPROPrec1 := CLOSEDPREPPPROPrec2;
                   CLOSEDPREPPPROPrec1.supertiempo := presente;
            
              C12: (CLOSEDPREPPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: CLOSEDPREPPPROPrec1 := CLOSEDPREPPPROPrec2;
                    CLOSEDPREPPPROPrec1.supertiempo := pasado;

          A1: @
         >


   SUBRULE (* 5 *)
      < T1: OPENNPPROP{OPENNPPROPrec1}[mu5] >
      < T2: OPENNPPROP{OPENNPPROPrec2}[mu5] >

      COMP
         <
          C1:true

            C11: (OPENNPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: OPENNPPROPrec2 := OPENNPPROPrec1;
                  OPENNPPROPrec2.supertiempo := omegatiempo;

             C12:(OPENNPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: OPENNPPROPrec2 := OPENNPPROPrec1;
                   OPENNPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(OPENNPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: OPENNPPROPrec1 := OPENNPPROPrec2;
                   OPENNPPROPrec1.supertiempo := presente;
            
              C12: (OPENNPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: OPENNPPROPrec1 := OPENNPPROPrec2;
                    OPENNPPROPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 6 *)
      < T1: CLOSEDNPPROP{CLOSEDNPPROPrec1}[mu5] >
      < T2: CLOSEDNPPROP{CLOSEDNPPROPrec2}[mu5] >

      COMP
         <
          C1:true

            C11: (CLOSEDNPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: CLOSEDNPPROPrec2 := CLOSEDNPPROPrec1;
                  CLOSEDNPPROPrec2.supertiempo := omegatiempo;

             C12:(CLOSEDNPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: CLOSEDNPPROPrec2 := CLOSEDNPPROPrec1;
                   CLOSEDNPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(CLOSEDNPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: CLOSEDNPPROPrec1 := CLOSEDNPPROPrec2;
                   CLOSEDNPPROPrec1.supertiempo := presente;
            
              C12: (CLOSEDNPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: CLOSEDNPPROPrec1 := CLOSEDNPPROPrec2;
                    CLOSEDNPPROPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 7 *)
      < T1: OPENADVPPROP{OPENADVPPROPrec1}[mu5] >
      < T2: OPENADVPPROP{OPENADVPPROPrec2}[mu5] >

      COMP
         <
