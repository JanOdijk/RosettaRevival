 PROCEDURE SEGCOMDECL_assigndebug(valeu:boolean); EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : SEGCOMDECL_surfgraph
 *  Description    : 
 *  Parameters     :0<i<=maxrnr 
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION SEGCOMDECL_surfgraph(i:integer):SEGCOMDECL_psurfgraph; EXTERNAL;

(*MPF:::===================================================================*
