  ((subjfound                                   AND
    (%VERBP.modus IN [subjunctive, indicative]) AND
    (therenpfound)
   ) <=
     (3 IN %VERBP.persons)
  )                                                  AND
  (((NOT subjfound)    AND
    (%VERBP.modus IN [subjunctive, indicative])
   ) <=
     (3 IN %VERBP.persons
     )
  )
 )                                                   AND
 (((NOT subjfound) AND shiftfound)   <=
	(shiftnumbervar IN %VERBP.numbers
	)
 )                                            

)
END; subjandvpandauxok*)

FUNCTION subordcondsok:BOOLEAN;
BEGIN
 subordcondsok :=
   (senttypevar = subordinateclause)                        <= 
    ((NOT finalpuncfound)                           AND
     (NOT leftdislocfound)                          AND
     (shiftfound <= (RELPROfound OR
                     (shiftxpmoodvar <> nowh)
                    )
     )
    )
   
END;
!(* moved to lssurfquo:
FUNCTION svaok:BOOLEAN;
BEGIN
  svaok :=
	  ((subjfound                    AND
            (NOT therenpfound)
           )
                <=
		((subjpersonvar IN %VERB.persons) AND
		 (subjnumbervar IN %VERB.numbers) 
		)
	   )                                           AND
	  ((NOT subjfound) OR therenpfound) 
                          <= (3 IN %VERB.persons)      AND
	  (((NOT subjfound)  AND
             shiftfound
           )   <=
		(shiftnumbervar IN %VERB.numbers
		)
          )                                            AND
	  (((NOT subjfound) AND (NOT shiftfound)) <= 
