           IF MMUM THEN FOR relation:=lirel0 TO lirel80 DO BEGIN
              IF LDUNIQUERELS_body(relation) AND NOT(uniquerelseen) THEN BEGIN
                 LDTYPETOSTR_rel(str,len1,relation);
