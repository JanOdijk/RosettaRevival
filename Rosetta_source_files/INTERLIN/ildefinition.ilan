INTERLINGUA DEFINITION 

TYPES  
  < humantype = (ilyeshuman,ilnohuman,ilomegahuman); (*rene 22-6-88*)
    cattype   = (ilPP,ilNP,ilAdvP,ilOAdjPP,ilCAdjPP, ilOAdvPP, ilCAdvPP,
                 ilONPP,ilCNPP, ilOPPP, ilCPPP, ilSENTENCE, ilVP, ilAdjPP);
    kommatype = (yes,no);
    indextype = INTEGER;
    deixistype = (ilpresentdeixis, ilpastdeixis);
    adjuncttype =  (ilResAP, ilResPP, ilComit, ilBenfactNP,
                          ilBenfactPP, ilLocAdjunct, ilDirAdjunct, ilResNP);
    numbertype = (ILsingular, ILplural);
  >

