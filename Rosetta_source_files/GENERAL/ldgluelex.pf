pragma C_include('listree.pf');
pragma C_include('lidomaint.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE LDGLUELEX;
WITH LISTREE, LIDOMAINT;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDGLUELEX_Glue
 *  Description    : Makes an Stree for the GLUE
 *  Result         : LISTREE_pStree;
 *
 *EMP:::===================================================================*)

FUNCTION LDGLUELEX_Glue: LISTREE_pStree;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDGLUELEX_GlueCat
 *  Description    : Returns TRUE if the category is "GLUE", otherwise false
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LDGLUELEX_GlueCat(c: LIDOMAINT_syntcat): BOOLEAN;
EXTERNAL;

END {LDGLUELEX};
