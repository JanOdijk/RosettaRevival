\newpage
\begin{verbatim}
% RULE RpppAspectImperfective
< m1: PREPPFORMULA{PREPPFORMULArec1}
                  [ mu1,
                    predrel/PREPP{PREPPrec1}[ mu2 ],
                    I1: mu4
                  ] 
>

< m : PREPPFORMULA{PREPPFORMULArec2}
                  [ mu1,
                    predrel/PREPP{PREPPrec1}[ mu2 ],
                    I1: mu4
                  ] 
>

   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu4) AND
           QUOTE_temprefnotfound(mu4) AND
           QUOTE_tempretronotfound(mu4)
      >

      COMP
         <
          C1: PREPPFORMULArec1.aspecto = omegaaspecto
          A1: PREPPFORMULArec2 := PREPPFORMULArec1;
              PREPPFORMULArec2.aspecto := imperfectivo;
         >

      DECOMP
         <
          C1: PREPPFORMULArec2.aspecto = imperfectivo 
          A1: PREPPFORMULArec1 := PREPPFORMULArec2;
              PREPPFORMULArec1.aspecto := omegaaspecto;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] RpppAspectImperfective
\item[* relevant examples:] 
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] PREPPPROPtoFORMULA
\item[* class:] RC\_pppAspect
\item[* date of creation:] 14-MAR-1989
\item[* author:] Lisette Appelo, Margreet Sanders
\item[* copied from:] RpppAspectImperf English
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] imperfective aspect relation between the interval E and a 
reference interval R
\item[\ \ strategy:] In this rule it is checked that temporal adverbials are 
absent. PREPPs in Spanish cannot have temporal adverbials. This rule exists 
only for isomorphy reasons. In case there are temporal adverbials in the other 
languages, in Spanish the path that switches to the CLAUSE has to be chosen.
It is assumed that PREPPs in apposition are derived from infinite sentences; 
cf.\ English: the man, against the proposal last week,... $\leftarrow$ the man, 
being against the proposal last week,...
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application? (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: \\

\item in other languages: \\

\end{enumerate}
