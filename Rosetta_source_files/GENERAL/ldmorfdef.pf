pragma C_include('limorfdef.pf');
pragma C_include('interface0.pf');
pragma C_include('asegm.pf');
pragma C_include('string.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LDMORFDEF;
WITH LIMORFDEF,INTERFACE0,ASEGM,STRNG;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDMORFDEF_CCSwitch
 *  Description    : Checks the context condition for the specified
 *                   phonetical information
 *  Parameters     : CC: LIMORFDEF_ContextConds;
 *                   f : LIMORFDEF_pPhonInfo;
 *  Result         : boolean : true : context condition satisfied
 *                           : flase: context condition not satisfied
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION LDMORFDEF_CCSwitch( CC: LIMORFDEF_ContextConds;
                                        f : LIMORFDEF_pPhonInfo): BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDMORFDEF_FonSwitch
 *  Description    : Checks the phonetical condition for the specified
 *                   phonetical information and transforms it into new
 *                   information
 *  Parameters     : FON: LIMORFDEF_PhonMarker;
 *                   f  : LIMORFDEF_pPhonInfo;
 *  Result         : LIMORFDEF_pPhonInfo;
 *  PostCondition  : IF phonetical condition satisfied the function returns
 *                   the new phonetical information
 *                   OTHERWISE it returns the NIL pointer
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION LDMORFDEF_FonSwitch( FON: LIMORFDEF_PhonMarker;
                                         fonin  : LIMORFDEF_pPhonInfo): 
                                         LIMORFDEF_pPhonInfo;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Function Name  : LDMORFDEF_AWlayoutSwitch
 *  Description    : Tries to apply all the layout rules to the
 *                   input string
 *  Parameters     : w  : STRING_String;
 *                   f  : BOOLEAN;  True if w is first word of sentence
 *                   l  : BOOLEAN;  True if w is last word of sentence 
 *                   m  : ASEGM_LayoutRuleMode; Apply splitting rules or
 *                                              non splitting rules.
 *  Result         : INTERFACE0_pSeqWords; 
 *  Precondition   : TRUE
 *  Postcondition  : Returns datastructure containing all ambiguities
 *  Side Effects   : None
 *
 *EMP:::===================================================================*)

FUNCTION LDMORFDEF_AWlayoutSwitch( w: STRING_String;
                                              f,
                                              l : BOOLEAN;
                                              m: ASEGM_LayoutRuleMode)
                                            : INTERFACE0_pSeqWords; EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name : LDMORFDEF_GWlayoutSwitch
 *  Description    : Tries to apply all the layout rules to the
 *                   input string
 *  Parameters     : VAR w  : STRING_String;
 *                   f  : BOOLEAN;  True if w is first word of sentence
 *                   l  : BOOLEAN;  True if w is last word of sentence 
 *  Precondition   : TRUE
 *  Postcondition  : all layout rules have been applied to w
 *  Side Effects   :                "" 
 *
 *EMP:::===================================================================*)

PROCEDURE LDMORFDEF_GWlayoutSwitch( VAR w: STRING_String;
                                               VAR f: BOOLEAN;
                                               l : BOOLEAN); EXTERNAL;

END {LDMORFDEF};
