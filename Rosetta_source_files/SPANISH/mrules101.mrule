\newpage
\begin{verbatim}
% RULE Rconjsent2
< m1:SENTENCE{SENTENCErec1}[ I1:mu1 ] 
  m2:CONJ{CONJrec2}
>

< m : SENTENCE{SENTENCErec2}[conjrel/CONJ{CONJrec2}, I1:mu1 ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[I11:rel1/..])
           I11: rel1 IN [shiftrel, conjrel]
      >

      COMP
         <
          C1: synOPENINFSENT IN CONJrec2.conjpatterns          AND
              CONJrec2.adverbial = true                     AND
              SENTENCErec1 =                  
		  {
		  senttype   : subordinateclause
                  finiteness : infinite
                  infsort    : inf
		  conjkey    : 0
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
                  restructuring : false
		  }
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2 :=                  
		  {
		  conjkey    : CONJrec2.key
		  adverbial  : CONJrec2.adverbial
		  temporal   : CONJrec2.temporal
		  conjclass  : CONJrec2.class
		  conjtiempo : CONJrec2.tiempo
		  conjaspecto: CONJrec2.aspecto
		  conjretro  : CONJrec2.retro
		  };
         >
      DECOMP
         <
          C1: synOPENINFSENT IN CONJrec2.conjpatterns          AND
              CONJrec2.adverbial = true                       AND
              SENTENCErec2 =                  
		  {
		  senttype   : subordinateclause
                  finiteness : infinite
                  infsort    : inf
		  conjkey    : CONJrec2.key
		  adverbial  : CONJrec2.adverbial
		  temporal   : CONJrec2.temporal
		  conjclass  : CONJrec2.class
		  conjtiempo : CONJrec2.tiempo
		  conjaspecto: CONJrec2.aspecto
		  conjretro  : CONJrec2.retro
                  restructuring : false
		  }

          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1 :=                  
		  {
		  conjkey    : 0
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
		  }
         >

&

\end{verbatim}
