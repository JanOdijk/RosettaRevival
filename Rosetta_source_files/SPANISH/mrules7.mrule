\newpage
\begin{verbatim}
% RULE RCOMPOSEDcard
< m1:CARD{CARDrec1} [mu1]

  m2:DIGIT{DIGITrec1} 

>

< m :CARD{CARDrec2}
             [
              head/CARD{CARDrec1} [mu1],
              complrel/DIGIT{DIGITrec1}
             ] 
>
      COMP
         <
          C1:True
          A1:CARDrec2.numero:=plural
         >
      DECOMP
         <
          C1:CARDrec2.numero=plural
          A1:@
         >

&

\end{verbatim}
