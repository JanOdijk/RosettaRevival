\begin{verbatim}
 TRANSFORMATION TObjectok2c (* active, ergative, object (SE) -> subject *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             I4:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      objrel/NP{NPrec1}
                                 [head/EC{ECrec1}],
                      mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             subjrel/NP{NPrec1}
                      [head/EC{ECrec1}],
             I4:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.thetavp IN [vp010, vp012, vp021]) AND
           (CLAUSErec1.voice = Active)
       I3: ALL (mu1, I31:rel1/..)
       I31: rel1 IN AUX_presubjrels
       I4: NOT EXIST (mu8, [subjrel/..]) AND
           NOT EXIST (mu8, [I41:rel2/..])
       I41: rel2 IN AUX_presubjrels


      >


      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
