                                 [ mu3,
                                   I3:rel1/T2,
                                   mu4 
                                 ],
                          mu5 
                        ],
                 mu6  
               ]
>


   MATCHCONDITIONS
      <
       I1: synBE IN CLAUSErec1.synvpefs
       I3: rel1 IN [objrel, indobjrel] AND
           (T2.CAT IN [NPVAR, CNVAR, NP] WITH T2.REC.cases <> [])      
       I4: N1.CAT IN [NP, PREPP, ADJP, ADVP]
     >

         <
