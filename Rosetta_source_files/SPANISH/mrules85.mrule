\begin{verbatim}
% TRANSFORMATION tPPpreppattern0
< m1:PREPP{PREPPrec1}[ head/PREP{PREPrec1}]
>

< m :PREPP{PREPPrec2}[ head/PREP{PREPrec1}]
>

      COMP
         <
          C1: synnoVPargs IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []        
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synnoVPargs];
         >
      DECOMP
         <
          C1: synnoVPargs IN PREPrec1.synpps AND
              synnoVPargs IN PREPPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec2.synppefs := [];
         >


&

\end{verbatim}
