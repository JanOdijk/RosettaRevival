1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
3:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
4:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_NUMRECORDS;
                END
*>
END;

PROCEDURAL PART
VAR  ConcTypeId,
     functionId,
       recordId,
         typeId:TSTRING_string;
   recassign:LOCALFILE;
BEGIN
INIT: BEGIN INITLOCALFILE(recassign) END;
<*
1: <* SEND: BEGIN
              recordId:=%.str; 
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN 
            END
      !FIELDLIST.
      RECEIVE: BEGIN 
                     \recassign.\LOCAL.
                     " PROCEDURE LSAUXDOM_As" 
                                 ""recordId"" "(VAR rec:" ""ConctypeId""
                                              ");"\\
                     "BEGIN"\\
                     "WITH rec DO"\\
                     "BEGIN"\\
                     APPENDLOCFILE(%%FIELDLIST.recassign,recassign);
                     "END"\\
                     "END;"\\
               END
   *>
4: <* SEND: BEGIN 
            END
      !TYPESECTION.
      RECEIVE: BEGIN 
                 typeId:=%%TYPESECTION.typeId;
                 TSTRING_Concat(functionId,'LSAUXDOM_Cp',recordId);
                 TSTRING_Concat(ConcTypeId,'LSDOMAINT_',typeId);
                 BEGIN
                  \of1.\GLOBAL. \\
                   "  FUNCTION ";""functionId""\\
                   TAB(of1,25); "(rec:";""ConcTypeId"";"):BOOLEAN;"\\
                   TAB(of1,11);"EXTERNAL;"\\;
                   "  PROCEDURE LSAUXDOM_As" ""recordId""\\
                   TAB(of1,25); "(VAR rec:";""ConcTypeId"";");"\\
                   TAB(of1,11);"EXTERNAL;"\\;
                  \of2.\GLOBAL. \\
                   " FUNCTION ";""functionId""\\
                   TAB(of2,25); "(rec:";""ConcTypeId"";"):BOOLEAN;"\\
                   "VAR Bool : BOOLEAN;"\\
                   "BEGIN " \\
                   TAB(of2,2); 
                   "Bool := FALSE;"\\
                   TAB(of2,2); 
                   "WITH rec DO"\\
                   TAB(of2,2);
                   "BEGIN"\\
                   TAB(of2,4);
               END;
             END
   *>
*>
FINAL:BEGIN
        BEGIN
         \of2.\GLOBAL.
         TAB(of2,2);
         "END;{with}"\\
         TAB(of2,2);
         ""functionId"";":=Bool;"\\
         "END;{function}"\\
        END;
        APPENDFILE(recassign,of2);
      END;
END;
&


