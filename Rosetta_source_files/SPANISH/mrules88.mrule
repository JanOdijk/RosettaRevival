SPANISH 88
&
\newpage
\begin{verbatim}
%
% RULE RPropsubst13          (*  "graag" - like; probably not necessary
                                                       for Spanish   *)   
< m1: I1::ADVPPROP{ADVPPROPrec1}
              [ mu18,
                subjrel/T1,
                mu1,
                predrel/ADVP{ADVPrec1}
                       [ mu2,
                         head/ADV{ADVrec1}[mu3],
                         complrel/SENTENCEVAR{SENTENCEVARrec1},
                         mu4
                       ]
              ]
SUBST:
  m2: SENTENCE{SENTENCErec1}          (* substituent *)
                   [ subjrel/T2,
                     mu5,
                     predrel/VERBP{VERBPrec1}
                            [mu6, 
                             rel2/VERB{VERBrec1}[mu7],
                             mu8],
                     mu9
                   ]
>
<
  m : VERBPPROP{VERBPPROPrec2}
               [ mu18,
                 subjrel/T1,
                 mu5,
                 predrel/VERBP{VERBPrec1}
                        [mu6, 
                         rel2/VERB{VERBrec2}[mu7],
                         mu8],
                 mu9,
                 mu1,
                 rel1/I2::ADVP{ADVPrec1}
                          [ mu2,
                            head/ADV{ADVrec1}[mu3],
                            mu4
                          ]
               ]
>
   MATCHCONDITIONS
      <
       I1: ADVPPROPrec1.advpatternefs = [synOPENINFSENT] 
       I2: synOPENINFSENT IN ADVPrec1.advpatternefs
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE     (* NPVAR *)
      < 
        T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2}
      >
      <
        T1:  NPVAR{NPVARrec1} 
      >


      COMP
         <
          C1: (SENTENCEVARrec1.index = LEVEL) AND
              (SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1) ) AND
              ( NPVARrec2 = NPVARrec1 ) AND
              ( ADVPPROPrec1 = COPYT_ADVPtoPROP(ADVPrec1) EXCEPT FOR 
                  [ aktionsarts, supertiempo, PROsubject ] ) AND
              ( ADVPPROPrec1 =
		  {
		   aktionsarts    : [stative] 
		  } 
              )                                AND

              ( SENTENCErec1 =
                   {
                    req            : [pospol,negpol,omegapol]
                    env            : [pospol,negpol,omegapol]
                    mood           : declarative
                    modo           : Infinitivo
                    senttype       : subordinateclause
                    PROsubject     : true
                    finiteness     : infinite
                    VRcompl        : true
                    Restructuring  : false
                    conjkey        : 0
                    adverbial      : false
                    temporal       : false
                    conjclass      : omegaTimeAdvClass
                    conjtiempo     : omegatiempo
                    conjaspecto    : omegaAspecto
                    conjretro      : false
                   }
              ) AND                               
              (VERBrec1.status = bareV) AND
              (VERBrec1.modo = Infinitivo) 
              C11: subjvpadv IN ADVPrec1.actsubcefs 
              A11: rel1 := subjvpadvrel
              C12: agvpadv IN ADVPrec1.actsubcefs 
              A12: rel1 := agvpadvrel

          A1: VERBPPROPrec2 :=
		     { 
		      supertiempo : ADVPPROPrec1.supertiempo
		      PROsubject  : false
		      voice       : SENTENCErec1.voice
		      synvpefs    : SENTENCErec1.synvpefs
		      thetavp     : SENTENCErec1.thetavp
		      aktionsarts : SENTENCErec1.aktionsarts
		     };
               VERBrec2 := VERBrec1;
               VERBrec2.modo := omegamodo;

 
         >

      DECOMP
         <
          C1: VERBPPROPrec2.supertiempo <> omegatiempo AND
              VERBrec2.status = bareV AND
              VERBrec2.modo = omegamodo

              C11: (subjvpadv IN ADVPrec1.actsubcefs) AND
                   ( rel1 = subjvpadvrel )
              A11: @
              C12: (agvpadv IN ADVPrec1.actsubcefs) AND
                   ( rel1 = agvpadvrel )
              A12: @
 
          A1: SENTENCErec1 :=
                   {
                    req            : [pospol,negpol,omegapol]
                    env            : [pospol,negpol,omegapol]
                    mood           : declarative
                    modo           : Infinitivo
                    senttype       : subordinateclause
                    PROsubject     : true
                    finiteness     : infinite
                    VRcompl        : true
                    Restructuring  : false
                    conjkey        : 0
                    adverbial      : false
                    temporal       : false
                    conjclass      : omegaTimeAdvClass
                    conjtiempo     : omegatiempo
                    conjaspecto    : omegaAspecto
                    conjretro      : false
	            supertiempo    : VERBPPROPrec2.supertiempo
                    voice          : VERBPPROPrec2.voice
		    synvpefs       : VERBPPROPrec2.synvpefs
		    thetavp        : VERBPPROPrec2.thetavp
		    aktionsarts    : VERBPPROPrec2.aktionsarts
		     };

              VERBrec1 := VERBrec2;
              VERBrec1.modo := Infinitivo; 
              SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
              NPVARrec2 := NPVARrec1;
              ADVPPROPrec1 := COPYT_ADVPtoPROP(ADVPrec1);
              ADVPPROPrec1 :=
                 {
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                 };
                
         >

   SUBRULE   (* CNVAR *)
      < 
        T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2}
      >
      <
        T1:  CNVAR{CNVARrec1} 
      >


      COMP
         <
          C1: (SENTENCEVARrec1.index = LEVEL) AND
              (SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1))  AND
              ( CNVARrec2 = CNVARrec1 ) AND
              ( ADVPPROPrec1 = COPYT_ADVPtoPROP(ADVPrec1) EXCEPT FOR 
                  [ aktionsarts, supertiempo, PROsubject ] ) AND
              ( ADVPPROPrec1 =
		  {
		   aktionsarts    : [stative] 
		  } 
              )                                AND

              ( SENTENCErec1 =
                   {
                    req            : [pospol,negpol,omegapol]
                    env            : [pospol,negpol,omegapol]
                    mood           : declarative
                    modo           : Infinitivo
                    senttype       : subordinateclause
                    PROsubject     : true
                    finiteness     : infinite
                    VRcompl        : true
                    Restructuring  : false
                    conjkey        : 0
                    adverbial      : false
                    temporal       : false
                    conjclass      : omegaTimeAdvClass
                    conjtiempo     : omegatiempo
                    conjaspecto    : omegaAspecto
                    conjretro      : false
                   }
              )  AND                              
              (VERBrec1.status = bareV) AND
              (VERBrec1.modo = Infinitivo) 
              C11: subjvpadv IN ADVPrec1.actsubcefs 
              A11: rel1 := subjvpadvrel
              C12: agvpadv IN ADVPrec1.actsubcefs 
              A12: rel1 := agvpadvrel

          A1: VERBPPROPrec2 :=
		     { 
		      supertiempo : ADVPPROPrec1.supertiempo
		      PROsubject  : false
		      voice       : SENTENCErec1.voice
		      synvpefs    : SENTENCErec1.synvpefs
		      thetavp     : SENTENCErec1.thetavp
		      aktionsarts : SENTENCErec1.aktionsarts
		     };
               VERBrec2 := VERBrec1;
               VERBrec2.modo := omegamodo;

 
         >

      DECOMP
         <
          C1: VERBPPROPrec2.supertiempo <> omegatiempo AND
              VERBrec2.status = bareV AND
              VERBrec2.modo = omegamodo

              C11: (subjvpadv IN ADVPrec1.actsubcefs) AND
                   ( rel1 = subjvpadvrel )
              A11: @
              C12: (agvpadv IN ADVPrec1.actsubcefs) AND
                   ( rel1 = agvpadvrel )
              A12: @
 
          A1: SENTENCErec1 :=
                   {
                    req            : [pospol,negpol,omegapol]
                    env            : [pospol,negpol,omegapol]
                    mood           : declarative
                    modo           : Infinitivo
                    senttype       : subordinateclause
                    PROsubject     : true
                    finiteness     : infinite
                    VRcompl        : true
                    Restructuring  : false
                    conjkey        : 0
                    adverbial      : false
                    temporal       : false
                    conjclass      : omegaTimeAdvClass
                    conjtiempo     : omegatiempo
                    conjaspecto    : omegaAspecto
                    conjretro      : false
	            supertiempo    : VERBPPROPrec2.supertiempo
                    voice          : VERBPPROPrec2.voice
		    synvpefs       : VERBPPROPrec2.synvpefs
		    thetavp        : VERBPPROPrec2.thetavp
		    aktionsarts    : VERBPPROPrec2.aktionsarts
		     };

              VERBrec1 := VERBrec2;
              VERBrec1.modo := Infinitivo; 
              SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
              CNVARrec2 := CNVARrec1;
              ADVPPROPrec1 := COPYT_ADVPtoPROP(ADVPrec1);
              ADVPPROPrec1 :=
                 {
                   aktionsarts  : [stative]
                   PROsubject   : false
                   supertiempo  : omegatiempo
                 };
                
         >
>
&

\end{verbatim}
