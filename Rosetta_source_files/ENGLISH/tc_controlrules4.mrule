ENGLISH 102
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TNoFinControl
< m1: CLAUSE{CLAUSErec1}[I1:mu1]
>

< m : CLAUSE{CLAUSErec1}[I1:mu1]
>

   MATCHCONDITIONS
      <
       I1: EXIST (mu1, [I13:auxrel/VERB{VERBrec1}[mu2]]) 
           OR
           (
           NOT EXIST (mu1,[extraposrel/I12::SENTENCE{SENTENCErec1}
                                      [I11:mu2]]) 
           AND
           NOT EXIST (mu1,[postsentadvrel/I12::SENTENCE{SENTENCErec1}
                                      [I11:mu2]])
           AND
           NOT EXIST (mu1, [predrel/VERBP{VERBPrec1}
                                  [mu4, 
                                   complrel/I12::SENTENCE{SENTENCErec1}
                                           [I11:mu2],
                                   mu6 
                             ] ] )
           AND
           NOT EXIST (mu1, [predrel/VERBP{VERBPrec1}
                                 [mu5, 
                                  I3:rel1/N1
                                     [mu8,
                                      objrel/I12::SENTENCE{SENTENCErec1}
                                            [I11:mu2]
                                     ],
                                  mu6 
                              ] ] )
           AND
           NOT EXIST (mu1, [predrel/VERBP{VERBPrec1}
                                 [mu5, 
                                  predrel/I4::N2
                                     [mu8,
                                      I5:rel2/I12::SENTENCE{SENTENCErec1}
                                             [I11:mu2],
                                      mu9
                                     ],
                                  mu6 
                           ] ] )
           )
         I11: EXIST (mu2, [I111:subjrel/T1])
            I111: T1.CAT IN [NPVAR, CNVAR]
         I12: SENTENCErec1.finiteness = finite
         I13: VERBrec1.subc = modalverb
       I3: N1.CAT IN [PREPP, VARPREPP] AND
           rel1 IN [prepobjrel, byobjrel]
       I4: N2.CAT IN [ADJP, PREPP, NP, ADVP]
       I5: rel2 IN [complrel, toinfmodrel, postadjrel, causadvrel,
                    toinfcomplrel, resultrel]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TNoFinControl
\item[* relevant examples:] x1 said that they (explicit subject) had left, etc.
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_NOC
\item[* date of creation:] 24-JAN-1989 
\item[* author:] margreet sanders
\item[* copied from:] Dutch Tfincontrol0
