ENGLISH 25

&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TNoPartHop
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2, 
                       head/VERB{VERBrec1}[mu3],
                       [I1:sig1,
                        I3:sig3,
                        I4:mu4]
                     ],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2, 
                       head/VERB{VERBrec1}[mu3],
                      [I1:sig1,
                       I3:sig3,
                       I4:mu4]
                     ],
              mu5
            ]
>

   MATCHCONDITIONS
      <
       I1:ALL (sig1, partrel/..) 
       I3:ALL (sig3, objrel/..)
       I4:NOT EXIST (mu4, [partrel/..]) 
       m1: NOT EXIST (sig1, [partrel/..]) OR
           ( EXIST (sig1, [partrel/..]) AND 
             NOT EXIST (sig3, [I5:rel5/T5]) AND
             NOT EXIST (mu4, [objrel/..]))  
       m : NOT EXIST (sig1, [partrel/..]) OR
           ( EXIST (sig1, [partrel/..]) AND 
             NOT EXIST (sig3, [I5:rel5/T5]) AND
             NOT EXIST (mu4, [objrel/..]))  
       I5: T5.CAT IN [NP, NPVAR] WITH
                   T5.REC.NPhead IN [persproNP, reflNP, itNP]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TNoPartHop
\item[* relevant examples:] I gave up my ambitions, He was handing out all 
sorts of advice to everyone, Can't you move over?
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_ParticleHop
\item[* date of creation:] 7-APR-1988 13:10:47  
\item[* author:] margreet sanders
\item[* copied from:] TPartHop
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 3/5/89\ \ \ \ \ author: margreet sanders\\
Added condition on reflexives ($^{*}$He gave up himself).
\item date: 20/06/90\ \ \ \ \ author:Petra de Wit\\
Added explicit matchconditions
\item date: 27/08/90\ \ \ \ \ author:Petra de Wit\\
Added condition on itNP (see also oblparthop and optparthop)
\end{enumerate}
\item[* task:] To let clauses which do not have a particle and a personal 
pronoun or reflexive argument following the verb pass this tranformation class.
\item[\ \ strategy:] (also: deviations from accepted proposals)
