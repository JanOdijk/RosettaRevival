\newpage
\begin{verbatim}
% TRANSFORMATION TOblControl7a   (* OPENADVPPROP, object control *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     objrel/T1,
                     mu3,
                     I2:rel1/OPENADVPPROP{OPENADVPPROPrec1}
                            [ subjrel/T2,
                              predrel/ADVP{ADVPrec1}[mu4] 
                            ],
                     mu5 
                   ],
             mu6
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     objrel/T1,
                     mu3,
                     I3:rel2/ADVP{ADVPrec1}[mu4], 
                     mu5 
                   ],
             mu6
           ]
>

   MATCHCONDITIONS
      <
       I2: rel1 IN [locargrel,dirargrel,complrel]
       I3: rel2 IN [locargrel,dirargrel, predrel]
      >

<
   SUBRULE  (* 1 *)
      <
       T1: NPVAR{NPVARrec1} 
       T2: NPVAR{NPVARrec2}
      >
      < 
       T1: NPVAR{NPVARrec1} 
      >

      COMP
         <
          C1: ( NPVARrec1 = NPVARrec2 ) AND
              ( OPENADVPPROPrec1 =
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : omegaaspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : true
		   })
              C11: rel1 = locargrel
              A11: rel2 := locargrel;
              C12: rel1 = dirargrel
              A12: rel2 := dirargrel;
              C13: rel1 = complrel
              A13: rel2 := predrel;
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec2.synvpefs * [synDONP_DIROPENPREPPPROP,
                                      synDONP_LOCOPENPREPPPROP] <> [])
              C11: rel2 = locargrel
              A11: rel1 := locargrel;
              C12: rel2 = dirargrel
              A12: rel1 := dirargrel;
              C13: rel2 = predrel
              A13: rel1 := complrel;
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
              [synDONP_DIROPENPREPPPROP,
               synDONP_LOCOPENPREPPPROP];
              NPVARrec2 := NPVARrec1;
              OPENADVPPROPrec1 :=
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : omegaaspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : true
		   }
         >


   SUBRULE (* 2 *)
      <
       T1: CNVAR{CNVARrec1} 
       T2: CNVAR{CNVARrec2}
      >
      < 
       T1: CNVAR{CNVARrec1} 
      >

      COMP
         <
          C1: ( CNVARrec1 = CNVARrec2 ) AND
              ( OPENADVPPROPrec1 =
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : omegaaspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : true
		   }
              )
              C11: rel1 = locargrel
              A11: rel2 := locargrel;
              C12: rel1 = dirargrel
              A12: rel2 := dirargrel;
              C13: rel1 = complrel
              A13: rel2 := predrel;
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec2.synvpefs * [synDONP_DIROPENPREPPPROP,
                                      synDONP_LOCOPENPREPPPROP] <> [])
              C11: rel2 = locargrel
              A11: rel1 := locargrel;
              C12: rel2 = dirargrel
              A12: rel1 := dirargrel;
              C13: rel2 = predrel
              A13: rel1 := complrel;
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
              [synDONP_DIROPENPREPPPROP,
               synDONP_LOCOPENPREPPPROP];
              CNVARrec2 := CNVARrec1;
              OPENADVPPROPrec1 :=
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : omegaaspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : true
		   }
         >
>
&

\end{verbatim}
