\newpage
\begin{verbatim}
% TRANSFORMATION TconGLUEmiti
< m1:SENTENCE{SENTENCErec1}
          [mu1,
           predrel/VERBP{VERBPrec1}
                         [mu2,
                          rel1/PREPP{PREPPrec1}
                             [ head/I1::PREP{PREPrec1},
                               objrel/NP{NPrec1}
                                   [head/PERSPRO{PERSPROrec1}
                                         [head/BPERSPRO{BPERSPROrec1}]
                                   ],
                               mu3
                             ],
                          mu6
                         ],
           mu5
          ]
>

< m:SENTENCE{SENTENCErec1}
         [mu1,
          predrel/VERBP{VERBPrec1}
                          [mu2,
                           rel1/NP{NPrec1}
                              [ head/I1::PREP{PREPrec1},
                                gluerel/GLUE{},
                                objrel/NP{NPrec1}
                                     [head/PERSPRO{PERSPROrec1}
                                         [head/BPERSPRO{BPERSPROrec1}]
                                     ],
                                mu3
                              ],
                           mu6
                          ],
          mu5
         ]
>

   MATCHCONDITIONS
      <
       I1: PREPrec1.contraction = CONcontraction
      >


      COMP
         <
          C1: ((BPERSPROrec1.persona = 1) OR 
               (BPERSPROrec1.persona = 2))
                                                       AND
              ((BPERSPROrec1.genero = masc) OR 
               (BPERSPROrec1.genero = fem))            AND

              (BPERSPROrec1.numero = singular)
          A1:   @
         >
 
      DECOMP
         <
          C1: ((BPERSPROrec1.persona = 1) OR 
               (BPERSPROrec1.persona =2))
                                                       AND
              ((BPERSPROrec1.genero = masc) OR 
               (BPERSPROrec1.genero = fem))            AND

              (BPERSPROrec1.numero = singular)
          A1:   @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TconGLUEmiti
\item[* relevant examples:] con m\'{\i} $\rightarrow$ (habla) conmigo \\
                            con ti $\rightarrow$ (habla) contigo \\
