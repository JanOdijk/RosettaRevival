\begin{verbatim}
% RULE Rtempadvsubstshift1           (* shifted temporal ADVP or
                                           frequential NP under S *)
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              I1:shiftrel/T2,
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4
            ] 

SUBST:
  m2: T1
>

< m : CLAUSE{CLAUSErec2}
            [ mu1,
              I2:shiftrel/T3,
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4
            ] 
>

   MATCHCONDITIONS
      <
       I1: T2.CAT IN [ADVPVAR, NPVAR] WITH T2.REC.index = LEVEL 
       I2: T3.CAT IN [ADVP, NP]
       m2: T1.CAT IN [ADVP, NP] AND
           QUOTE_Gsubstordercondition(mu2, mu3, mu4, T1, CLAUSErec1.prosubject)
       m : QUOTE_substordercondition(mu2, mu3, mu4, CLAUSErec2.prosubject)
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* 1. ADVP *)
      <T1: ADVP{ADVPrec1}[mu5]
       T2: ADVPVAR{ADVPVARrec1}[] >
      <T3: ADVP{ADVPrec2}[mu5] >

      COMP
         <
          C1: (tempadv IN ADVPrec1.actsubcefs) AND
              (ADVPVARrec1 = COPYT_advptovar(ADVPrec1)) AND
              (((ADVPrec1.class = reference) AND
                (ADVPrec1.retro = false)
               ) OR
               (ADVPrec1.class = frequential) OR
               ((ADVPrec1.class = duration) AND
                ((ADVPrec1.aspect = perfective) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((ADVPrec1.aspect = imperfective) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               ) OR
               (((ADVPrec1.class = reference) AND
                 (ADVPrec1.retro = true) 
                ) AND
                (((ADVPrec1.aspect = perfective) AND
                  (CLAUSErec1.aspect = imperfective)
                 ) OR
                 (ADVPrec1.aspect = imperfective)
                )
               )
              )
              C11: CLAUSErec1.deixis <> omegadeixis AND
                   ADVPrec1.superdeixis = CLAUSErec1.deixis
              A11: @
              C12: CLAUSErec1.superdeixis <> omegadeixis AND
                   ADVPrec1.superdeixis = CLAUSErec1.superdeixis
              A12: @
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis;
              CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: (tempadv IN ADVPrec2.actsubcefs)
              C11: ((ADVPrec2.class = reference) AND
                    (ADVPrec2.retro = false)
                    ) OR
                    (ADVPrec2.class = frequential) 
                  C111: (CLAUSErec2.deixis <> omegadeixis)
                  A111: ADVPrec1 := ADVPrec2;
                        ADVPrec1.superdeixis := CLAUSErec2.deixis;
                  C112: CLAUSErec2.superdeixis <> omegadeixis
                  A112: ADVPrec1 := ADVPrec2;
                        ADVPrec1.superdeixis := CLAUSErec2.superdeixis;
               A11: CLAUSErec1 := CLAUSErec2;

               C12: (ADVPrec2.class = duration) 
                   C121: (ADVPrec2.aspect = perfective) 
                        C1211: stative IN CLAUSErec2.aktionsarts
                               C12111: (CLAUSErec2.deixis <> omegadeixis)
                               A12111: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.superdeixis := 
                                                        CLAUSErec2.deixis;
                               C12112: CLAUSErec2.superdeixis <> omegadeixis
                               A12112: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.superdeixis := 
                                                     CLAUSErec2.superdeixis;
                        A1211: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [stative];

                        C1212: activity IN CLAUSErec2.aktionsarts
                               C12121: (CLAUSErec2.deixis <> omegadeixis)
                               A12121: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.superdeixis := 
                                                        CLAUSErec2.deixis;
                               C12122: CLAUSErec2.superdeixis <> omegadeixis
                               A12122: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.superdeixis := 
                                                     CLAUSErec2.superdeixis;
                        A1212: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [activity];
                   A121: @

                   C122: (ADVPrec2.aspect = imperfective) 
                        C1221: accomplishment IN CLAUSErec2.aktionsarts
                               C12211: (CLAUSErec2.deixis <> omegadeixis)
                               A12211: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.superdeixis := 
                                                        CLAUSErec2.deixis;
                               C12212: CLAUSErec2.superdeixis <> omegadeixis
                               A12212: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.superdeixis := 
                                                     CLAUSErec2.superdeixis;
                        A1221: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [accomplishment];

                        C1222: achievement IN CLAUSErec2.aktionsarts
                               C12221: (CLAUSErec2.deixis <> omegadeixis)
                               A12221: ADVPrec1 := ADVPrec2;
                                       ADVPrec1.superdeixis := 
                                                        CLAUSErec2.deixis;
                               C12222: CLAUSErec2.superdeixis <> omegadeixis
                               A12222: ADVPrec1 := ADVPrec2;
                                        ADVPrec1.superdeixis := 
                                                     CLAUSErec2.superdeixis;
                        A1222: CLAUSErec1:= CLAUSErec2;
                               CLAUSErec1.aktionsarts := [achievement];
                   A122: @
              A12: @ 

              C13: ((ADVPrec2.class = reference) AND
                    (ADVPrec2.retro = true)
                    ) AND
                    (((ADVPrec2.aspect = perfective) AND
                      (CLAUSErec2.aspect = imperfective)
                     ) OR
                     (ADVPrec2.aspect = imperfective)
                    )
                  C131: (CLAUSErec2.deixis <> omegadeixis)
                  A131: ADVPrec1 := ADVPrec2;
                        ADVPrec1.superdeixis := CLAUSErec2.deixis;
                  C132: CLAUSErec2.superdeixis <> omegadeixis
                  A132: ADVPrec1 := ADVPrec2;
                        ADVPrec1.superdeixis := CLAUSErec2.superdeixis;
               A13: CLAUSErec1 := CLAUSErec2;

          A1: ADVPVARrec1 := COPYT_advptovar(ADVPrec1);
              ADVPVARrec1.index := LEVEL;
         >


   SUBRULE (* 2. frequential NP *)
      <T1: NP{NPrec1}[mu5]
       T2: NPVAR{NPVARrec1}[] >
      <T3: NP{NPrec2}[mu5] >

      COMP
         <
          C1: (unitnoun IN NPrec1.actsubcs) AND
              (NPVARrec1 = COPYT_Nptovar(NPrec1)) AND
              (NPrec1.class = frequential) 
              C11:(CLAUSErec1.deixis <> omegadeixis) AND
                  (NPrec1.superdeixis = CLAUSErec1.deixis)
              A11: @
              C12:(CLAUSErec1.superdeixis <> omegadeixis) AND
                  (NPrec1.superdeixis = CLAUSErec1.superdeixis) 
              A12: @
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              CLAUSErec2 := CLAUSErec1;
         >
      DECOMP
         <
          C1: (unitnoun IN NPrec2.actsubcs) AND
               (NPrec2.class = frequential) 
              C11: CLAUSErec2.deixis <> omegadeixis
              A12: NPrec1 := NPrec2;
                   NPrec1.superdeixis := CLAUSErec2.deixis;
              C12: CLAUSErec2.superdeixis <> omegadeixis
              A12: NPrec1 := NPrec2;
                   NPrec1.superdeixis := CLAUSErec2.superdeixis;
          A1: NPVARrec1 := COPYT_Nptovar(NPrec1);
              NPVARrec1.index := LEVEL;
              CLAUSErec1 := CLAUSErec2;
         >
>

&

\end{verbatim}

