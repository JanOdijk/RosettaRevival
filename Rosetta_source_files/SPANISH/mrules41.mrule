\begin{verbatim}
%
% RULE Rinfinpastdeixisspec
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    auxrel/VERB{VERBrec3}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/T2] 
                          ],
                    rel1/VERB{VERBrec2}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST (mu5, [tempadvrel/..])
      >

<
   SUBRULE (*1: ADVPVAR *)
      <mu5 : [mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]
       T2: BVERB(AUX_haberbverbkey){BVERBrec1}[ ]
      >

   MATCHCONDITIONS
      <
       I2: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.tiempo = pasado)
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.modo = omegamodo)
            )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.tiempo = pasado) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modo = ptcpas) AND
              (VERBrec2.tiempo = omegatiempo) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                     {
                      numero    : omeganumero
                      persona   : 3
                      modo      : omegamodo
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      futuro    : nofuturo
                      status    : bareV
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.supertiempo = omegatiempo)
             A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.supertiempo = omegatiempo)(* switch *)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := pasado;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;
              CLAUSErec1.tiempo := omegatiempo;
         >

   SUBRULE (*2: PREPPVAR*)
      <mu5 : [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]
       T2: BVERB(AUX_haberbverbkey){BVERBrec1}[ ]
      >

   MATCHCONDITIONS
      <
       I2: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.tiempo = pasado)
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.modo = omegamodo)
            )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.tiempo = pasado) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modo = ptcpas) AND
              (VERBrec2.tiempo = omegatiempo) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                     {
                      numero    : omeganumero
                      persona   : 3
                      modo      : omegamodo
                      aspecto   : omegaaspecto
                      tiempo    : omegatiempo
                      futuro    : nofuturo
                      status    : bareV
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.supertiempo = omegatiempo)
             A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.supertiempo = omegatiempo)(* switch *)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := pasado;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;
              CLAUSErec1.tiempo := omegatiempo;
         >

   SUBRULE (*3: SENTENCE*)
      <mu5 : [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5 : [mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]
       T2: BVERB(AUX_haberbverbkey){BVERBrec1}[ ]
      >

   MATCHCONDITIONS
      <
       I2: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjtiempo = pasado)
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.modo = omegamodo)
            )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.tiempo = pasado) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modo = ptcpas) AND
              (VERBrec2.tiempo = omegatiempo) AND
              (VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
              (VERBrec3 =
                     {
                      numero    : omeganumero
                      persona   : 3
                      modo      : omegamodo
                      aspecto   : omegaaspecto
                      tiempo    : omegatiempo
                      futuro    : nofuturo
                      status    : bareV
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.supertiempo = omegatiempo)
             A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.supertiempo = omegatiempo)(* switch *)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := pasado;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;
              CLAUSErec1.tiempo := omegatiempo;
         >

>
&
\end{verbatim}

\newpage
\begin{description}
\item[* name:] Rinfinpastdeixisspec
\item[* relevant examples:] lamento(haber dormido ayer)
\item[* language:] SPANISH
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 22-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:]Rinfinpastdeixisspec dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a infinite independent clause. This
               is a special rule,because past is expressed by the auxiliary 
               verb {\em haber}. 
               The most left verb in the clause (input generative rule)
gets modus past particle.
The auxiliary verb {\em haber
} is introduced with a omega tense.
               The deixis 
value of the reference adverbial is checked for 
               past.
               The clause is marked for past deixis.
\item[\ \ strategy:] the match is assumed to be left to right.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different variable categories for the reference 
adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial, perfective aspect rule \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: This rule has the same semantics as 
Rfinpastdeixis.\\

\item in other languages: \\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be pastdeixis in the case 
this sentence is a sentence with something like {\em graag} in Dutch\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rimpdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I2: mu2,
                    head/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I2: mu2,
                    head/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ] 

>
   MATCHCONDITIONS
      <
        I2: NOT EXIST (mu2, [rel1/VERB{VERBrec2}[mu8]])

      >


<
   SUBRULE
      <mu5: [I1: mu6]>
      <mu5: [I1: mu6]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.supertiempo = omegatiempo) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo) 
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.tiempo := presente;
              CLAUSErec2.modo := imperativo;
         >

      DECOMP
         <
          C1:((CLAUSErec2.tiempo = presente) AND
              (CLAUSErec2.supertiempo = omegatiempo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.tiempo := omegatiempo;
              CLAUSErec2.modo := imperativo;
         >

   SUBRULE
      <mu5:[mu6, I1: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5:[mu6, I1: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I1: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           ((ADVPVARrec1.tiempo = presente) OR
            (ADVPVARrec1.tiempo = omegatiempo) OR
            (ADVPVARrec1.tiempo = futuro)
           )

      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.supertiempo = omegatiempo) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.tiempo := presente;
              CLAUSErec2.modo := imperativo;

         >

      DECOMP
         <
          C1:((CLAUSErec2.tiempo = presente) AND
              (CLAUSErec2.supertiempo = omegatiempo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.tiempo := omegatiempo;
              CLAUSErec2.modo := imperativo;
          
         >

   SUBRULE
      <mu5:[mu6, I1: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5:[mu6, I1: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I1: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           ((PREPPVARrec1.tiempo = presente) OR
            (PREPPVARrec1.tiempo = omegatiempo) OR
            (PREPPVARrec1.tiempo = futuro)

           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.supertiempo = omegatiempo) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.tiempo := presente;
              CLAUSErec2.modo := imperativo;

         >

      DECOMP
         <
          C1:((CLAUSErec2.tiempo = presente) AND
              (CLAUSErec2.supertiempo = omegatiempo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.tiempo := omegatiempo;
              CLAUSErec2.modo := imperativo;
          
         >

   SUBRULE
      <mu5:[mu6, I1: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5:[mu6, I1: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I1: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           ((SENTENCErec1.conjtiempo = presente) OR
            (SENTENCErec1.conjtiempo = omegatiempo) OR
            (SENTENCErec1.tiempo = futuro)
           )
      >

      COMP
         <
          C1:((CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.supertiempo = omegatiempo) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )

          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.tiempo := presente;
              CLAUSErec2.modo := imperativo;

         >

      DECOMP
         <
          C1:((CLAUSErec2.tiempo = presente) AND
              (CLAUSErec2.supertiempo = omegatiempo) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (VERBrec1.modo = omegamodo) AND
              (VERBrec1.aspecto= omegaaspecto) AND
              (VERBrec1.tiempo = omegatiempo)
             )
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.tiempo := omegatiempo;
              CLAUSErec2.modo := imperativo;
          
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rimpdeixis
\item[* relevant examples:] Ven (ma\~{n}ana)
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 01-APR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rimpdeixis English
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 23/06/89\ \ \ \ \ author: Lisette Appelo\\
Added futuro for adverbial. 
\item date: 12/09/89\ \ \ \ \ author: Lisette Appelo\\
Added condition VERBrec1.aspecto = omegaaspecto to avoid double generation.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between S and Rs is not relevant.
               This rule is for a finite independent (main) clause that will 
get mood {\em imperativemood } in the mood rules..
               The deixis 
value of the reference adverbial is checked for 
               present or omega.
               The clause is not marked for deixis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of (the variables for) the 
possible reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: Maybe the deixis value of the reference value should not be 
presente in Spanish but `future deixis'. The same problems as with future 
tense.\\

\item modifications: \\
\end{enumerate}
\end{description}

% RULE Rfinirrmodaldeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                I1:[mu2,
                    rel1/VERB{VERBrec1}
                        [head/SUBVERB{SUBVERBrec1}
                             [I2:head/BVERB(KEY1){BVERBrec1}]
                        ],
                     mu3
                   ],
            mu4,
            tempadvrel/T1,
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
               I1:[mu2,
                    rel1/VERB{VERBrec2}
                        [head/SUBVERB{SUBVERBrec1}
                             [I2:head/BVERB(KEY1){BVERBrec1}]
                        ],
                     mu3
                   ],
            mu4,
            tempadvrel/T1,
            mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: LEFTTORIGHT
       I2: KEY1 = KEY_poder1BVERBkey OR
           KEY1 = KEY_poder2BVERBkey OR
           KEY1 = KEY_deber1BVERBkey OR
           KEY1 = KEY_deber2BVERBkey 
  
      >

<
   SUBRULE (*1: ADVPVAR*)
      <T1: ADVPVAR{ADVPVARrec1}[ ]>
      <T1: ADVPVAR{ADVPVARrec1}[ ]>

      COMP
         <
          C1:((ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false) AND
              (ADVPVARrec1.tiempo = pasado) AND
              (CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = finite) 
             )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* geval graag *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;
             
         >
      DECOMP
         <
          C1:((ADVPVARrec1.class = reference) AND
              (ADVPVARrec1.retro = false) AND
              (ADVPVARrec1.tiempo = pasado) AND
              (CLAUSErec2.tiempo = pasado) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = finite) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (VERBrec2.tiempo = pasado)
             )
              
              (* other values: default values *)
             C11: (CLAUSErec2.supertiempo = omegatiempo)
             A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.supertiempo = omegatiempo)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := pasado;

          A1: CLAUSErec1.tiempo := omegatiempo;
              VERBrec1 := VERBrec2;
              VERBrec1.futuro := nofuturo;
              VERBrec1.tiempo := omegatiempo;
        >


   SUBRULE (*2: PREPPVAR*)
      <T1: PREPPVAR{PREPPVARrec1}[ ]>
      <T1: PREPPVAR{PREPPVARrec1}[ ]>

      COMP
         <
          C1:((PREPPVARrec1.class = reference) AND
              (PREPPVARrec1.retro = false) AND
              (PREPPVARrec1.tiempo = pasado) AND
              (CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = finite) 
             )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* geval graag *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;
             
         >
      DECOMP
         <
          C1:((PREPPVARrec1.class = reference) AND
              (PREPPVARrec1.retro = false) AND
              (PREPPVARrec1.tiempo = pasado) AND
              (CLAUSErec2.tiempo = pasado) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = finite) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (VERBrec2.tiempo = pasado)
             )
              
              (* other values: default values *)
             C11: (CLAUSErec2.supertiempo = omegatiempo)
             A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.supertiempo = omegatiempo)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := pasado;

          A1: CLAUSErec1.tiempo := omegatiempo;
              VERBrec1 := VERBrec2;
              VERBrec1.futuro := nofuturo;
              VERBrec1.tiempo := omegatiempo;

         >


   SUBRULE (*3: SENTENCE*)
      <T1: SENTENCE{SENTENCErec1}[mu9]>
      <T1: SENTENCE{SENTENCErec1}[mu9]>

      COMP
         <
          C1:((SENTENCErec1.conjclass = reference) AND
              (SENTENCErec1.conjretro = false) AND
              (SENTENCErec1.conjtiempo = pasado) AND
              (CLAUSErec1.tiempo = omegatiempo) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (VERBrec1.futuro = nofuturo) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = finite) 
             )
             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
             
             C12:(CLAUSErec1.supertiempo = pasado) (* geval graag *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.supertiempo := omegatiempo;

          A1: CLAUSErec2.tiempo := pasado;
              VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;
             
         >

      DECOMP
         <
          C1:((SENTENCErec1.conjclass = reference) AND
              (SENTENCErec1.conjretro = false) AND
              (SENTENCErec1.conjtiempo = pasado) AND
              (CLAUSErec2.tiempo = pasado) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = finite) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (VERBrec2.tiempo = pasado) 
             )
              
             C11: (CLAUSErec2.supertiempo = omegatiempo)
             A11: CLAUSErec1 := CLAUSErec2;
 
             C12: (CLAUSErec2.supertiempo = omegatiempo)
             A12: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.supertiempo := pasado;

          A1: CLAUSErec1.tiempo := omegatiempo;
              VERBrec1 := VERBrec2;
              VERBrec1.futuro := nofuturo;
              VERBrec1.tiempo := omegatiempo;
         >


>
&
\end{verbatim}

