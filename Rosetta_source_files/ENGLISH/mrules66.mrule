\newpage
\begin{verbatim}
% RULE RNPformation2

< m1: CN{CNrec1}[mu1,
                 head/EN{ENrec1},
                 I3:mu2
                ]

  m2: DETP{DETPrec1}[I1:mu3]
>

< m : I4::NP{NPrec1}[detrel/DETP{DETPrec2}[I1:mu3],
                     head/CN{CNrec1}[mu1,
                                     head/EN{ENrec1},
                                     mu2
                                    ]
                    ]                       
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST( mu3, [head/ART{ARTrec1}])
       I3: NOT EXIST(mu2, [posrel/NP{NPrec2}[mu8]])
       I4: NPrec1 = { NPhead    : otherNP
                      person    : 3
                      class     : omegaTimeAdvclass
                      deixis    : omegadeixis
                      aspect    : omegaaspect
                      retro     : false }
      >


      COMP
         <
          C1: DETPrec1.posscomas * CNrec1.posscomas <> [] AND
              DETPrec1.superdeixis = CNrec1.superdeixis AND 
              DETPrec1.possnumbers * CNrec1.numbers <> []  

              C11: plural IN CNrec1.numbers
              A11: NPrec1.number := plural;
              C12: singular IN CNrec1.numbers
              A12: NPrec1.number := singular;


          A1: NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         } ;

              NPrec1.actcomas :=  CNrec1.posscomas * DETPrec1.posscomas;
              DETPrec2 := DETPrec1;
              DETprec2.superdeixis := omegadeixis;
          >

      DECOMP
         <
          C1: DETPrec2.posscomas * CNrec1.posscomas <> [] AND
              DETPrec2.superdeixis = omegadeixis AND
              DETPrec1.possnumbers * CNrec1.numbers <> []   AND
              NPrec1 = { posspred          : DETPrec2.posspred
                         definite          : DETPrec2.definite
                         possnietnp        : DETPrec2.possnietnp
                         mood              : DETPrec2.mood

                         nounpatternefs    : CNrec1.nounpatternefs
                         thetanp           : CNrec1.thetanp
                         human             : CNrec1.human
                         animate           : CNrec1.animate
                         poss              : CNrec1.poss
                         temporal          : CNrec1.temporal
                         actsubcs          : CNrec1.actsubcs
                         sexes             : CNrec1.sexes
                         genders           : CNrec1.genders
                         cases             : CNrec1.cases
                          
                         specQ      : yesspec (* auxiliary *)
                         syntquant  : omegaquant (* auxiliary *)
                         generic    : nogeneric
                         superdeixis: omegadeixis
                        }  AND

               NPrec1.actcomas = CNrec1.posscomas * DETPrec2.posscomas AND
               NPrec1.cases = []

              C11: plural IN CNrec1.numbers AND
                   NPrec1.number = plural
              A11: @
              C12: singular IN CNrec1.numbers AND
                   NPrec1.number = singular
              A12: @


           A1: DETPrec1 := DETPrec2;
               DETPrec1.superdeixis := CNrec1.superdeixis;
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RNPformation2
\item[* relevant examples:]\mbox{}\\
EN                 $\rightarrow$ three EN, some EN, most EN\\
yellow EN (ones)   $\rightarrow$ three yellow EN (ones), all yellow EN (ones)\\
hundred EN         $\rightarrow$ all hundred EN\\
EN with a straw    $\rightarrow$ three EN with a straw
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) NPformationrules
\item[* date of creation:] 21-JUN-1988 11:22:32  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/10/88\ \ \ \ \ author: Lisette Appelo
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:]
The formation of an NP out of a CN with an empty head (EN), and a DETP.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
This rule allows the formation of illformed NPs such as 
{\em every} as bare NP, (versus {\em each}) and {\em both with a string}.
The best solution will probably be to exclude the definite determiners
from this rule and two derive some of them as bare NPs via a separate rule
that combines a subset of the definite DETPs with a CN containing no 
modifiers. 
NB. one-substitution (TNPenTOone) may improve some of the illformed results.

It should be investigated whether bare demonstratives (always 
    definite!!) should be dealt with by this rule (which would possibly
    require an extra attribute), or by another one.
\item modifications: 28/10/88: Added superdeixis DETP\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RNPformation3        (* ADJ en/of NUM + EN --> the ADJ en/of NUM + EN *)

< m1: CN{CNrec1}[I1:mu1,
                 head/EN{ENrec1},
                 I3:mu2
                ]
>

< m: I2::NP{NPrec1}[detrel/DETP{DETPrec1}[head/ART(KEY_theartkey)
                                                      {ARTrec1}],
                    head/CN{CNrec1}[I1:mu1,
                                    head/EN{ENrec1},
                                    mu2
                                   ]                       
                   ]
>

   MATCHCONDITIONS
      <
       I1: EXIST(mu1, [modrel/DETP{DETPrec2}[mu3, head/NUM{NUMrec1}]]) OR 
           EXIST(mu1, [modrel/ADJP{ADJPrec1}[mu4]])                 
       I2: NPrec1 = { NPhead    : otherNP
                      person    : 3
                      class     : omegaTimeAdvclass
                      deixis    : omegadeixis
                      aspect    : omegaaspect
                      retro     : false }
       I3: NOT EXIST(mu2, [posrel/NP{NPrec2}[mu8]])
(* als NUM in mu1: CNrec1.definite = def *)
      >

      COMP
         <
          C1: true
             C11: singular IN CNrec1.numbers
             A11: NPrec1.number := singular;
             C12: plural IN CNrec1.numbers
             A12: NPrec1.number := plural;
          A1: DETPrec2 := COPYT_ARTtoDETP(ARTrec1);
              (* possnietnp, posspred, mood, syntquant 
                 remain default *)
              NPrec1 := { posspred          : DETPrec2.posspred
                          definite          : DETPrec2.definite
                          possnietnp        : DETPrec2.possnietnp
                          mood              : DETPrec2.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          cases             : CNrec1.cases
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         };
                   NPrec1.actcomas    := CNrec1.posscomas;
         >

      DECOMP
         <
          C1: NPrec1 = { posspred          : DETPrec2.posspred
                         definite          : DETPrec2.definite
                         possnietnp        : DETPrec2.possnietnp
                         mood              : DETPrec2.mood

                         nounpatternefs    : CNrec1.nounpatternefs
                         thetanp           : CNrec1.thetanp
                         human             : CNrec1.human
                         animate           : CNrec1.animate
                         poss              : CNrec1.poss
                         temporal          : CNrec1.temporal
                         actsubcs          : CNrec1.actsubcs
                         sexes             : CNrec1.sexes
                         genders           : CNrec1.genders
                         cases             : CNrec1.cases
                          
                         specQ      : yesspec (* auxiliary *)
                         syntquant  : omegaquant (* auxiliary *)
                         generic    : nogeneric
                         superdeixis: omegadeixis
                        }  AND
               NPrec1.actcomas  * CNrec1.posscomas <> [] AND
               DETPrec2  = COPYT_ARTtoDETP(ARTrec1) AND
               DETPrec2 = { possnietnp : false
                            posspred   : false
                            mood       : nowh
                            syntquant  : omegaquant }
               C11: singular IN CNrec1.numbers AND
                    NPrec1.number = singular
               A11: @
               C12: plural IN CNrec1.numbers AND
                    NPrec1.number = plural
               A12: @
            A1:  @    
         >
&
  
\end{verbatim}
