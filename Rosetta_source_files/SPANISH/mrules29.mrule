\newpage
\begin{verbatim}
%
% TRANSFORMATION TaGLUEel
< m1:SENTENCE{SENTENCErec1}
          [mu1,
           predrel/VERBP{VERBPrec1}
                           [mu2,
                            objrel/NP{NPrec1}
                               [ modrel/PREP(KEY_aPREPkey){PREPrec1},
                                 detrel/DETP{DETPrec1}
                                     [head/ART(KEY_elARTkey){ARTrec1}
                                 ],
                                 mu3
                               ],
                            mu5
                           ],
           mu4
          ]
>

< m:SENTENCE{SENTENCErec1}
         [mu1,
          predrel/VERBP{VERBPrec1}
                          [mu2,
                           objrel/NP{NPrec1}
                              [ modrel/PREP(KEY_aPREPkey){PREPrec1},
                                gluerel/GLUE{},
                                detrel/DETP{DETPrec1}
                                      [head/ART(KEY_elARTkey){ARTrec1}
                                      ],
                                mu3
                              ],
                           mu5
                          ],
          mu4
         ]
>

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
