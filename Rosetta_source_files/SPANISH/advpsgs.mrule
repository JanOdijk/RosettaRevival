       I3: ADVPrec1.temporal = true
       I4: ADVPrec2.temporal = true
       I5: T3.cat IN [THANP]
      >


      COMP
         <
          C1: ADVPrec3.supertiempo = ADVPrec1.supertiempo
          A1: ADVPrec4 := ADVPrec3;
              ADVPrec4.supertiempo := omegatiempo;
              ADVPrec2 := ADVPrec1;
              ADVPrec2.mood := ADVPrec4.mood;  (* m.h.o. op een WH-modifier *)
         >
      DECOMP
         < 
          C1: ADVPrec4.supertiempo = omegatiempo AND
              ADVPrec2.mood = ADVPrec4.mood
          A1: ADVPrec3 := ADVPrec4;
              ADVPrec3.supertiempo := ADVPrec2.supertiempo;
              ADVPrec1 := ADVPrec2;
              ADVPrec1.mood := declxpmood;          

        >

&

