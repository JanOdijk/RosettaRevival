 | ( SFK1SgIndPres | SFK2SgIndPres | SFK3SgIndPres )
 | ( SFK1PlIndPres | SFK2PlIndPres | SFK3PlIndPres )
 | ( SFK1Sg3SubjPres | SFK2SgSubjPres | SFK1Sg3SubjPres )
 | ( SFK1PlSubjPres | SFK2PlSubjPres | SFK3PlSubjPres )
