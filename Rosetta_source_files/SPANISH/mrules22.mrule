\begin{verbatim}
% TRANSFORMATION TCaseAssignment4
< m1:I3::CLAUSE{CLAUSErec1}
           [ mu1,
             I1:subjrel/T1,
             mu2 
           ]
>

< m :I3::CLAUSE{CLAUSErec1}
           [ mu1,
             I2:subjrel/T2,
             mu2 
           ]
>

   MATCHCONDITIONS
      <
       I1: (T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [])
       I2: (T2.CAT IN [NPVAR, CNVAR, NP] WITH T2.REC.cases = [Nominative])
       I3: CLAUSErec1.finiteness = finite
      >


<
   SUBRULE
      <T1:NPVAR{NPVARrec1} >
      <T2:NPVAR{NPVARrec2} >

      COMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Nominative] 
         >

      DECOMP
         <
          C1: true
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [] 
         >

   SUBRULE
      <T1:CNVAR{CNVARrec1} >
      <T2:CNVAR{CNVARrec2} >


      COMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Nominative] 
         >

      DECOMP
         <
          C1: true
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [] 
         >


   SUBRULE
      <T1:NP{NPrec1}[mu3] >
      <T2:NP{NPrec2}[mu4] >


      COMP
         <
          C1: true
          A1: QUOTE_assigncase ( NPrec1, mu3, 
                                 NPrec2, mu4, [Nominative] 
                               )
         >

      DECOMP
         <
          C1: true
          A1: QUOTE_assigncase ( NPrec2, mu4, 
                                 NPrec1, mu3, [] 
                               )
         >
>
&

\end{verbatim}
