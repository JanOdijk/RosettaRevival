\begin{verbatim}
% RULE RADJparamod1 (* vieja para verla, ( handig om mee te nemen ) *)

< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      head/I1::ADJ{ADJrec1}[mu3],
                                      I3:mu4
                                     ]
                            ] 

 m2:I4::SENTENCE{SENTENCErec1}[I2:shiftrel/T1,
                            conjrel/T2,
                            mu5
                           ]
>

< m : ADJPPROP{ADJPPROPrec2}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [mu2,
                                      head/I1::ADJ{ADJrec1}[mu3],
                                      I3:mu4,
                                      paramodrel/I4::SENTENCE{SENTENCErec1}
                                                 [I2:shiftrel/T1,
                                                  conjrel/T2,
                                                  mu5
                                                 ]
                                     ]
                            ] 
>
   MATCHCONDITIONS
      <
       I1:  subjectiveadj IN ADJrec1.subcs 
       I2:  T1.cat IN [NPVAR,CNVAR]
       I3:  EXIST(mu4, [indobjrel/EMPTYVAR{EMPTYVARrec1}])
       I4:  SENTENCErec1.infsort = parainf
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
