\begin{verbatim}
% RULE RADJtomod1 (* nice to look at *)
                       (* needs improvement *)
< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [I3:mu2,
                                      head/I1::ADJ{ADJrec1}[mu3],
                                      mu4
                                     ]
                            ] 

 m2: SENTENCE{SENTENCErec1}[conjrel/T2,
                             I2:shiftrel/T1,
                             mu5
                            ]
>

< m : ADJPPROP{ADJPPROPrec2}[I3:mu1,
                             predrel/ADJP{ADJPrec2}
                                     [mu2,
                                      head/I1::ADJ{ADJrec1}[mu3],
                                      mu4,
                                      toinfmodrel/SENTENCE{SENTENCErec1}
                                                 [conjrel/T2,
                                                  I2:shiftrel/T1,
                                                  mu5
                                                 ]
                                     ]
                            ] 
>
   MATCHCONDITIONS
      <
       I1:  subjectiveadj IN ADJrec1.subcs 
       I2:  T1.cat IN [NPVAR,CNVAR]
       I3:  EXIST(mu2, [indobjrel/EMPTYVAR{EMPTYVARrec1}])

      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
