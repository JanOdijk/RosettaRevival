\newpage
\begin{verbatim}
% RULE RsubstenNP2
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I1:rel1/I2::NPVAR{NPVARrec1},
                      mu3
                    ],         
             mu4 
           ] 

SUBST:
  m2: NP{NPrec1}
        [ detrel/T1,
          head/CN{CNrec1}[head/EN(KEY_countenkey){ENrec1} ] ,
          mu5
        ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     I1:rel1/NP{NPrec2}
			    [ detrel/T1,
			      I5:mu5
			    ],
                     mu3
                   ],
             mu4 
           ] 

>

   MATCHCONDITIONS
      <
       m1: QUOTE_Gsubstordercondition2(mu3, mu4)  
       m : QUOTE_Substordercondition2(mu3, mu4) 
       I1: rel1 IN [objrel]
       I2: NPVARrec1.index = LEVEL
       I5: NOT EXIST(mu5, [head/..])
      >

   PARAMETERS
      <
       LEVEL
      >

COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = []   AND
              NPrec1.generic = nogeneric AND
              NPrec1.NPhead = enNP AND
              CNrec1 = AUX_CNonNoHead EXCEPT FOR [numero, generos] AND
              NPrec1.numero = CNrec1.numero AND
              (NPrec1.genero IN [masc, fem] AND
              NPrec1.genero IN CNrec1.generos)
              C11: CLAUSErec1.tiempo = omegatiempo              AND
                   NPrec1.supertiempo = CLAUSErec1.supertiempo
              A11: @
              C12: CLAUSErec1.tiempo <> omegatiempo             AND
                   NPrec1.supertiempo = CLAUSErec1.tiempo
              A12: @
          A1: NPrec2 := NPrec1;
              NPrec2.cases := NPVARrec1.cases;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo AND
              NPrec2.generic = omegageneric AND 
              NPrec2.NPhead = enNP AND
              CNrec1.generos * [masc, fem] <> [] 
              C11: CLAUSErec1.tiempo = omegatiempo AND
                   NPrec2.supertiempo = omegatiempo
              A11: NPrec1 := NPrec2;
                   NPrec1.cases := []; 
                   NPrec1.supertiempo := CLAUSErec1.supertiempo;
              C12: CLAUSErec1.tiempo <> omegatiempo AND
                   NPrec2.supertiempo = omegatiempo  
              A12: NPrec1 := NPrec2;
                   NPrec1.cases := []; 
                   NPrec1.supertiempo := CLAUSErec1.tiempo;
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.cases := NPrec2.cases;
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric;
              NPVARrec1.generic := nogeneric;
              CNrec1 := AUX_CNonNoHead;
              CNrec1.numero := NPrec2.numero;
              CNrec1.generos := [NPrec2.genero];
         >



&

\end{verbatim}
