SPANISH 6
&
\newpage
\begin{verbatim}
%
% RULE Rlocadvvar
< m1: VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  mu3 
                ]

  m2: I1::ADVPVAR{ADVPVARrec1}                 
>

< m :VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  locadvrel/I1::ADVPVAR{ADVPVARrec1},
                  mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: locadv IN ADVPVARrec1.actsubcefs 
      >

      COMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
\newpage
