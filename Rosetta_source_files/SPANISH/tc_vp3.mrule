\begin{verbatim}
%
% TRANSFORMATION TVerbpattern5
< m1: VERBPPROP{VERBPPROPrec1}[ mu1, 
                                predrel/VERBP{VERBPrec1}
                                       [ head/VERB{VERBrec1}[mu2],
                                         argrel/T1,
                                         argrel/T2
                                       ] 
                              ]
>

< m : VERBPPROP{VERBPPROPrec2}[ mu1,
                                predrel/VERBP{VERBPrec1}
                                       [ head/VERB{VERBrec1}[mu2],
                                         objrel/T1,
                                         rel1/T2
                                       ] 
                              ]
>


<
   (*  Lo/Le fuerzo [hacer esto] (vp123)  *)
   
   SUBRULE (*1*)
       <T2: SENTENCEVAR{SENTENCEVARrec1} >
       <T2: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_OPENINFSENT IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1 = {
                                   mood        : declarative
                                   modo        : Infinitivo
                                   senttype    : subordinateclause
                                   PROsubject  : true
                                   infsort     : inf
                                   finiteness  : infinite
                                  } (*not all attributes*)
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_OPENINFSENT];
                rel1 := complrel
          A1:  @
         >


   (*  Llamaron Pedro al chico; Lo nombraron presidente (vp123)  *)

   SUBRULE (*2*)
       <T2: NPPROPVAR{NPPROPVARrec1} >
       <T2: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_OPENNPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                NPPROPVARrec1.PROsubject = true
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_OPENNPPROP];
                rel1 := complrel
          A1:  @
         >


   (* ???? (Zij verfden de deur groen) (vp123)  *)

   SUBRULE (*3*)
       <T2: ADJPPROPVAR{ADJPPROPVARrec1} >
       <T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_OPENADJPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                ADJPPROPVARrec1.PROsubject = true
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_OPENADJPPROP];
                rel1 := complrel
          A1:  @
         >


   (* Pongo el libro en la mesa (vp123)  *)

   SUBRULE (*4a*)
       <T2: PREPPPROPVAR{PREPPPROPVARrec1} >
       <T2: PREPPPROPVAR{PREPPPROPVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                PREPPPROPVARrec1.PROsubject = true AND
                loc IN PREPPPROPVARrec1.actsubcefs
            A2: PREPPPROPVARrec2 := PREPPPROPVARrec1;
                PREPPPROPVARrec2.actsubcefs := [loc];
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_LOCOPENPREPPPROP];
                rel1 := locargrel
          A1:  @
         >


   (* Pongo el libro aqu\'{\i} (vp123)  *)   
   SUBRULE (*4b*)
       <T2: ADVPPROPVAR{ADVPPROPVARrec1} >
       <T2: ADVPPROPVAR{ADVPPROPVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_LOCOPENPREPPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                ADVPPROPVARrec1.PROsubject = true AND
                locadv IN ADVPPROPVARrec1.actsubcefs
            A2: ADVPPROPVARrec2 := ADVPPROPVARrec1;
                ADVPPROPVARrec2.actsubcefs := [Locadv];
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_LOCOPENPREPPPROP];
                rel1 := locargrel
          A1:  @
         >


   (*  Entr\'{o} el coche en el garaje (vp012)
       Juan conduci\'{o} el coche en el garage (vp123) *)

   SUBRULE (*5a*)
       <T2: PREPPPROPVAR{PREPPPROPVARrec1} >
       <T2: PREPPPROPVAR{PREPPPROPVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                PREPPPROPVARrec1.PROsubject = true AND
                dir IN PREPPPROPVARrec1.actsubcefs
            A2: PREPPPROPVARrec2 := PREPPPROPVARrec1;
                PREPPPROPVARrec2.actsubcefs := [dir];
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_DIROPENPREPPPROP];
                rel1 := dirargrel
          A1:  @
         >


   (*  Entr\'{o} el coche all\'{i\} (vp012)
       Juan conduci\'{o} el coche all\'{\i} (vp123) *)

   SUBRULE (*5b*)
       <T2: ADVPPROPVAR{ADVPPROPVARrec1} >
       <T2: ADVPPROPVAR{ADVPPROPVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_DIROPENPREPPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                ADVPPROPVARrec1.PROsubject = true AND
                diradv IN ADVPPROPVARrec1.actsubcefs
            A2: ADVPPROPVARrec2 := ADVPPROPVARrec1;
                ADVPPROPVARrec1.actsubcefs := [DirAdv];
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_DIROPENPREPPPROP];
                rel1 := dirargrel
          A1:  @
         >

   (*  Trajeron el pastel (vp123) *)

   SUBRULE (*6*)
       <T2: EMPTYVAR{EMPTYVARrec1} >
       <T2: EMPTYVAR{EMPTYVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_DIREMPTY IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: EMPTYVARrec2 := EMPTYVARrec1;
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_DIREMPTY];
                rel1 := dirargrel
          A1:  @
         >

   SUBRULE (*7*)
       <T2: SENTENCEVAR{SENTENCEVARrec1} >
       <T2: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_OPENGERSENT IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1 = {
                                   mood        : declarative
                                   modo        : Gerundio
                                   senttype    : subordinateclause
                                   PROsubject  : true
                                   infsort     : inf
                                   finiteness  : infinite
                                  } (*not all attributes*)
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_OPENGERSENT];
                rel1 := complrel
          A1:  @
         >

   SUBRULE (*8a*)
       <T2: PREPPPROPVAR{PREPPPROPVARrec1} >
       <T2: PREPPPROPVAR{PREPPPROPVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_OTHEROPENPREPPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                PREPPPROPVARrec1.PROsubject = true 
            A2: PREPPPROPVARrec2 := PREPPPROPVARrec1;
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_OTHEROPENPREPPPROP];
                rel1 := complrel
          A1:  @
         >



   SUBRULE (*8b*)
       <T2: ADVPPROPVAR{ADVPPROPVARrec1} >
       <T2: ADVPPROPVAR{ADVPPROPVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_OTHEROPENPREPPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                ADVPPROPVARrec1.PROsubject = true 
            A2: ADVPPROPVARrec2 := ADVPPROPVARrec1;
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_OTHEROPENPREPPPROP];
                rel1 := complrel
          A1:  @
         >

   SUBRULE (*9a*)
       <T2: SENTENCEVAR{SENTENCEVARrec1} >
       <T2: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_QUESENTind IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1 = {
                                   mood        : declarative
                                   modo        : Indicativo
                                   senttype    : subordinateclause
                                   PROsubject  : false
                                   finiteness  : finite
                                  } (*not all attributes*)
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_QUESENTind];
                rel1 := complrel
          A1:  @
         >


   SUBRULE (*9b*)
       <T2: SENTENCEVAR{SENTENCEVARrec1} >
       <T2: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_QUESENTsubj IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                SENTENCEVARrec1 = {
                                   mood        : declarative
                                   modo        : Subjuntivo
                                   senttype    : subordinateclause
                                   PROsubject  : false
                                   finiteness  : finite
                                  } (*not all attributes*)
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_QUESENTsubj];
                rel1 := complrel
          A1:  @
         >

   SUBRULE (*10*)
       <T2: EMPTYVAR{EMPTYVARrec1} >
       <T2: EMPTYVAR{EMPTYVARrec2} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_RESULTEMPTY IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: EMPTYVARrec2 := EMPTYVARrec1;
                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_RESULTEMPTY];
                rel1 := complrel
          A1:  @
         >

>
&

\end{verbatim}
