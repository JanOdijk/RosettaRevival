ENGLISH 66
&
\begin{verbatim}
%
% RULE RNPformation1          (* NP uit DETP en CN met NOUN *)

< m1: CN{CNrec1}[I1:mu1]
  m2: DETP{DETPrec1}[mu2,
                     I2:head/T1 
                    ]
>

< m : I3::NP{NPrec1}[detrel/DETP{DETPrec2}[mu2,
                                           I2:head/T1
                                          ],
                     head/CN{CNrec1}[I1:mu1]
                    ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[head/EN{}]) AND
           NOT EXIST(mu1, [posrel/NP{NPrec2}[mu8]])
       I2: T1.CAT IN [NUM, DET, DEMADJ, QP, DETP, CARD]
       I3: NPrec1 = { NPhead    : otherNP
                      person    : 3
                    }
      >

      COMP
         <
            C1: DETPrec1.posscomas * CNrec1.posscomas <> [] AND
                DETPrec1.possnumbers * CNrec1.numbers <> [] AND
                DETPrec1.superdeixis = CNrec1.superdeixis AND
                ( (CNrec1.definite = DETPrec1.definite) OR
                  (CNrec1.definite = omegadef) OR
                  (CNrec1.definite = def AND DETPrec1.mood = wh) )
                 C11: plural IN CNrec1.numbers 
                 A11: NPrec1.actcomas := [count];
                      NPrec1.number := plural      
                 C12: singular IN CNrec1.numbers AND
                      mass IN CNrec1.posscomas
                 A12: NPrec1.actcomas := [mass];
                      NPrec1.number := singular    (* all sugar *)
                 C13: singular IN CNrec1.numbers  AND
                      count IN CNrec1.posscomas 
                 A13: NPrec1.actcomas := [count];
                      NPrec1.number := singular    (* each book; every man *)

         A1: NPrec1  := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders

    (* added mjs *)       cases             : CNrec1.cases
                          class             : CNrec1.class 
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         };
                DETPrec2 := DETPrec1;
                DETPrec2.superdeixis : = omegadeixis;
         >

      DECOMP
         <
           C1: NPrec1 = { posspred          : DETPrec2.posspred
                          definite          : DETPrec2.definite
                          possnietnp        : DETPrec2.possnietnp
                          mood              : DETPrec2.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders

                          cases             : CNrec1.cases
     (* added mjs *)      class             : CNrec1.class 
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  AND
         
              (  (CNrec1.definite = DETPrec2.definite )
              OR (CNrec1.definite = def AND DETPrec2.mood = wh)
              OR (CNrec1.definite = omegadef))     AND
              DETPrec2.posscomas * CNrec1.posscomas <> [] AND
              DETPrec2.possnumbers * CNrec1.numbers <> []  
                  (* problem: one of the *) AND
              DETPrec2.superdeixis = omegadeixis

                   C11: plural IN CNrec1.numbers AND
                        NPrec1.actcomas * [count] <> [] AND
                        NPrec1.number = plural
                   A11: @
                   C12: singular IN CNrec1.numbers AND
                        NPrec1.number = singular AND
                        mass IN CNrec1.posscomas AND
                        NPrec1.actcomas * [mass] <> []
                   A12: @
                   C13: singular IN CNrec1.numbers AND
                        NPrec1.actcomas * [count] <> [] AND
                        NPrec1.number = singular
                  A13:  @
           A1: DETPrec1 := DETPrec2;
               DETPrec1.superdeixis := CNrec1.superdeixis;
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RNPformation1
\item[* relevant examples:] \mbox{}\\
T1 = DET: that (nice) boy/sugar, this (beautiful) book/water, those 
(good) singers, these (silver) spoons\\
T1 = NUM: three (green) sweaters\\
T1 = DET: every (old) man, many a man, many/all/some men
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-formation
\item[* class:] (name of rule, transformation or filter class) NPformationrules
\item[* date of creation:] 20-JUN-1988 11:19:27  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/10/88\ \ \ \ \ author: Lisette Appelo
\item date: 27/07/89\ \ \ \ \ author: Margreet Sanders\\
added a copy of cases, class, aspect, deixis, and retro from CN to NP (perhaps 
the restrictions for the temporal attributes should be more detailed, also 
depending on the DETP?)
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:]
Making an NP out of a CN containing a NOUN, and a DETP containing a:
\begin{enumerate}
\item DEMADJ 
\item NUM
\item DET    
\end{enumerate}
