                         };
             DETPrec4 := DETprec1;
             DETPrec4.supertiempo := omegatiempo;
         >

      DECOMP
         <
          C1: masc  IN NOUNrec1.generos AND 
              NOUNrec1.numero = singular AND 
              DETPrec1.numero = singular AND
              DETPrec1.genero = masc AND
              DETPrec2  = COPYT_ARTtoDETP(ARTrec1)  AND
              DETPrec2.posspred = true AND
