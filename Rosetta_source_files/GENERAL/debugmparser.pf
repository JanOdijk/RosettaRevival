pragma C_include('listree.pf');
pragma C_include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE DebugMparser;
WITH LISTREE, WND;

PROCEDURE DebugMparser_Init; EXTERNAL;

PROCEDURE DebugMparser_Default; EXTERNAL;

PROCEDURE DebugMparser_StoreStree(t: LISTREE_pStree); EXTERNAL;

PROCEDURE DebugMparser_StoreRuleResult(t: LISTREE_SetOfTupleOfStrees); EXTERNAL;

FUNCTION DebugMparser_Trace: BOOLEAN; EXTERNAL;

FUNCTION DebugMparser_StopParse: BOOLEAN; EXTERNAL;

FUNCTION DebugMparser_Step: BOOLEAN; EXTERNAL;

FUNCTION DebugMparser_RuleBreakPoint(r: INTEGER): BOOLEAN; EXTERNAL;

FUNCTION DebugMparser_TransBreakPoint(r: INTEGER): BOOLEAN; EXTERNAL;

FUNCTION DebugMparser_PlusTrans: BOOLEAN; EXTERNAL;

PROCEDURE DebugMparser_Menu; EXTERNAL;

PROCEDURE DebugMparser_MenuInit; EXTERNAL;

PROCEDURE DebugMparser_MenuExit; EXTERNAL;

PROCEDURE DebugMParser_HandleKey ( key : WND_Xid ); EXTERNAL;

END {DebugMparser};
