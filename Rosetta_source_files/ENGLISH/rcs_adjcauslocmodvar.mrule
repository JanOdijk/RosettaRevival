\begin{verbatim}
% RULE RAdjLocpreppVar
< m1: ADJPPROP{ADJPPROPrec1}
               [ mu1,
                 predrel/ADJP{ADJPrec1}[mu2],
                 I4:mu4,
                 I3:mu3 
               ]

  m2: I1::PREPPVAR{PREPPVARrec1}                 
>

< m : ADJPPROP{ADJPPROPrec1}
               [ mu1,
                 predrel/ADJP{ADJPrec1}[I2:mu2],
                 I4:mu4,
                 locadvrel/I1::PREPPVAR{PREPPVARrec1},
                 I5:mu3
               ]
>

   MATCHCONDITIONS
      <
       I1: loc IN PREPPVARrec1.actsubcefs
       I2: NOT EXIST (mu2, [tempadvrel/..])
       I3: NOT EXIST (mu3, [locadvrel/..])
       I4: ALL (mu4, locadvrel/..)
       I5: NOT EXIST (mu3, [I51:rel1/..])
         I51: rel1 IN [locadvrel, tempadvrel]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
