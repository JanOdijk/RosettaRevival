\newpage
\begin{verbatim}
% TRANSFORMATION TNPCNdeletion2    
                                   (* massENkey *)
                                   (* Als deze regel geordend is na RNPmodADV
                                     dan twee regels nodig *)

< m1: NP{NPrec1}[detrel/DETP{DETPrec1}[mu3,
                                       head/QP{QPrec1}[mu4]
                                      ],
                 head/CN{CNrec1}
                         [head/EN(KEY_massENkey){ENrec1}
                         ],
                 mu1
                ]
>

< m : NP{NPrec1}[detrel/DETP{DETPrec1}[mu3,
                                       head/QP{QPrec1}[mu4]
                                      ],
                 I1:mu1
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [head/CN{CNrec2}[mu2]])
      >

      COMP
         <
          C1: mass IN NPrec1.actcomas AND
              NPrec1.NPhead = enNP AND
              NPrec1.numero = singular AND
              NPrec1.definite = indef AND
              CNrec1 = CNrecdef EXCEPT FOR [numero, posscomas, generos] AND
              CNrec1.numero = singular   AND
              mass IN CNrec1.posscomas
            C11: NPrec1.genero = masc AND
                 CNrec1 = {
                            numero : singular
                            generos: [masc]
                            posscomas : [mass]
                           }
            A11: @
            C12: NPrec1.genero = fem  AND
                 CNrec1 = {
                            numero : singular
                            generos: [fem]
                            posscomas : [mass]
                           }
            A12: @
          A1: @

         >
      DECOMP
         <
          C1: mass IN NPrec1.actcomas AND
              NPrec1.NPhead = enNP AND
              NPrec1.numero = singular AND
              NPrec1.definite = indef
            C11: NPrec1.genero = masc  
            A11: CNrec1 := CNrecdef;
                 CNrec1 := {
                            numero : singular
                            generos: [masc]
                            posscomas : [mass]
                                
                           }
            C12: NPrec1.genero = fem 
            A12: CNrec1 := CNrecdef;
                 CNrec1 := {
                            numero : singular
                            generos: [fem]
                            posscomas : [mass]
                           }
          A1: @
         >

&

\end{verbatim}
