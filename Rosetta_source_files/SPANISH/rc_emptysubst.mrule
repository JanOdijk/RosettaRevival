% RULE REmptysubstitution3

       (* substitution of an emptyEMPTY as indobjrel/.. *)

< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/VERB{VERBrec1}[mu3],
                           cliticrel/CLITIC{CLITICrec1}[mu4],
                           I5:mu7,
                           indobjrel/I3::EMPTYVAR{EMPTYVARrec1},
                           I4:mu5
                         ],
                  mu6
                ]
SUBST:
  m2: EMPTY(KEY_emptyemptykey){EMPTYrec1}            (*substituent*)
>

< m : I2::CLAUSE{CLAUSErec2}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/VERB{VERBrec1}[mu3],
                           cliticrel/CLITIC{CLITICrec1}[mu4],
                           I5:mu7,
                           I4:mu5
                         ],
                  mu6
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.synvpefs * AUX_emptyindobjvps <> []
       I2: CLAUSErec2.synvpefs * AUX_emptyindobjvps <> []
       I3: EMPTYVARrec1.index = LEVEL
       I4: NOT EXIST (mu5, [indobjrel/..])
       I5: NOT EXIST (mu7, [indobjrel/..])
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: EMPTYVARrec1 = 
                     { persona : 3
                       numero  : omeganumero
                       genero  : omegagenero
                     }
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.synvpefs := CLAUSErec1.synvpefs * AUX_emptyindobjvps
         >

      DECOMP
         <
          C1: true
          A1: EMPTYVARrec1 :=
                     { index   : LEVEL
                       persona : 3
                       numero  : omeganumero
                       genero  : omegagenero
                     };
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * AUX_emptyindobjvps
         >
&


\end{verbatim}
