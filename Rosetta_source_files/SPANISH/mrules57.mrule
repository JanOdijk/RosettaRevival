                  SENTENCErec1.tiempo = pasado AND
                  CLAUSErec1.retro = true AND
                  CLAUSErec1.tiempo <> pasado AND
                  CLAUSErec1.supertiempo <> pasado
             A11: @

                 (* dependent sentences *)
             C12: true
                  
                       (* present *)
