\begin{verbatim}
% RULE RNPpartitiveformation1    (* DETP + () + NOUN  --> 
                                    DETP de los/las/el/la + [() + NOUN] *)

< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2],
                 I1:mu3]

  m2: DETP{DETPrec1}[mu4]
>

< m:  NP{NPrec1}[detrel/DETP{DETPrec3}[modrel/DETP{DETPrec4}[mu4],
                                       partrel/PREP(KEY_deprepkey){PREPrec1},
                                       head/DETP{DETPrec2}[head/T1]
                                      ],
                 head/CN{CNrec1}[mu1,
                                 head/NOUN{NOUNrec1}[mu2],
                                 mu3]
                ]
>
   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3, [posrel/NP{NPrec2}[mu9]])
      >

<
(* 1 *)
SUBRULE
< >
<T1:ART(KEY_losartkey){ARTrec1}>

      COMP
         <
          C1: masc  IN NOUNrec1.generos AND 
              NOUNrec1.numero = plural AND
              DETPrec1.supertiempo = CNrec1.supertiempo AND
              DETPrec1.numero = plural AND
              DETPrec1.genero = masc
          A1: DETPrec2 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec2.posspred := true;
              DETPrec3 := 
                         {  (* possnietnp  :  DETPrec1.possnietnp *)
                           definite    :  adef
                           posspred    :  DETPrec1.posspred
                           numero      :  DETPrec2.numero 
                                            (* om 'uno de los' aan te kunnen 
                                               is extra atribuut nodig *)
                           genero      :  DETPrec2.genero 
                           posscomas   :  DETPrec1.posscomas
                           mood        :  DETPrec1.mood
                           supertiempo :  omegatiempo
                           };
              NPrec1 := { posspred          : DETPrec3.posspred
                          definite          : DETPrec3.definite
(*                           possnietnp        : DETPrec3.possnietnp *)
                          mood              : DETPrec3.mood

                          numero            : NOUNrec1.numero
                          genero            : masc
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         };
             DETPrec4 := DETprec1;
             DETPrec4.supertiempo := omegatiempo;
         >

      DECOMP
         <
          C1: masc  IN NOUNrec1.generos AND 
              NOUNrec1.numero = plural AND
              DETPrec1.numero = plural AND
              DETPrec1.genero = masc AND
              DETPrec2  = COPYT_ARTtoDETP(ARTrec1)  AND
              DETPrec2.posspred = true AND
              DETPrec3 = 
                         { (* possnietnp  :  DETPrec4.possnietnp *)
                           definite    :  adef
                           posspred    :  DETPrec4.posspred
                           numero  :  DETPrec2.numero
                                            (* om uno de los aan te kunnen 
                                               is extra atribuut nodig *)
                           genero      :  DETPrec2.genero 
                           posscomas   :  DETPrec4.posscomas
                           mood        :  DETPrec4.mood
                           supertiempo :  omegatiempo
                           }
               AND
               NPrec1 = { posspred          : DETPrec3.posspred
                          definite          : DETPrec3.definite
                          (* possnietnp        : DETPrec3.possnietnp *)
                          mood              : DETPrec3.mood

                          numero            : NOUNrec1.numero
                          genero            : masc
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         }   AND
              (DETPrec4.supertiempo = omegatiempo)
             
          A1:  DETPrec1 := DETPrec4;
               DETPrec1.supertiempo:= CNrec1.supertiempo;
         >
(* 2 *)
SUBRULE
< >
<T1:ART(KEY_lasartkey){ARTrec1}>

      COMP
         <
          C1: fem  IN NOUNrec1.generos AND 
              NOUNrec1.numero = plural AND
              DETPrec1.numero = plural AND
              DETPrec1.genero = fem AND
              DETPrec1.supertiempo = CNrec1.supertiempo
          A1: DETPrec2 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec2.posspred := true;
              DETPrec3 := 
                         { (* possnietnp  :  DETPrec1.possnietnp *)
                           definite    :  adef
                           posspred    :  DETPrec1.posspred
                           numero     :  DETPrec2.numero 
                                            (* om 'uno de las' aan te kunnen 
                                               is extra atribuut nodig *)
                           genero      :  DETPrec2.genero 
                           posscomas   :  DETPrec1.posscomas
                           mood        :  DETPrec1.mood
                           supertiempo :  omegatiempo
                           };
              NPrec1 := { posspred          : DETPrec3.posspred
                          definite          : DETPrec3.definite
                          (* possnietnp        : DETPrec3.possnietnp *)
                          mood              : DETPrec3.mood

                          numero            : NOUNrec1.numero
                          genero            : fem
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         };
             DETPrec4 := DETprec1;
             DETPrec4.supertiempo := omegatiempo;
         >

      DECOMP
         <
          C1: fem  IN NOUNrec1.generos AND 
              NOUNrec1.numero = plural AND
              DETPrec1.numero = plural AND
              DETPrec1.genero = fem  AND
              DETPrec2  = COPYT_ARTtoDETP(ARTrec1)  AND
              DETPrec2.posspred = true AND
              DETPrec3 = 
                         { (* possnietnp  :  DETPrec4.possnietnp *)
                           definite    :  adef
                           posspred    :  DETPrec4.posspred
                           numero      :  DETPrec2.numero
                           genero      :  DETPrec2.genero 
                           posscomas   :  DETPrec4.posscomas
                           mood        :  DETPrec4.mood
                           supertiempo :  omegatiempo
                           }
               AND
               NPrec1 = { posspred          : DETPrec3.posspred
                          definite          : DETPrec3.definite
                          (* possnietnp        : DETPrec3.possnietnp *)
                          mood              : DETPrec3.mood

                          numero            : NOUNrec1.numero
                          genero            : fem
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         }   AND
              (DETPrec4.supertiempo = omegatiempo)
             
          A1:  DETPrec1 := DETPrec4;
               DETPrec1.supertiempo:= CNrec1.supertiempo;
          >
(* 3 *)
SUBRULE
< >
<T1:ART(KEY_elartkey){ARTrec1}>

      COMP
         <
          C1: masc  IN NOUNrec1.generos AND 
