\newpage
\begin{verbatim}
% RULE Rweekdatum                  (* tijdelijk; splitsen voor en zonder ',' *)
< m1: NP{NPrec1}[I1:mu1]           (* zonder ',' verplicht zonder jaartal *)
  
  m2: NP{NPrec2}[mu2] 
>

< m : NP{NPrec1}
         [ 
           premodrel/NP{NPrec4}[mu2],
           I1:mu1
         ]
>

   MATCHCONDITIONS
      <
       I1: EXIST (mu1,[detrel/..])
      >

      COMP
         <
          C1:monthnoun IN NPrec1.actsubcs   AND
             daynoun IN NPrec2.actsubcs     AND
             NPrec2.supertiempo = NPrec1.supertiempo  AND
             NPrec2.generic = nogeneric
          A1:NPrec4 := NPrec2;
             NPrec4.supertiempo := omegatiempo;
             NPrec4.generic := omegageneric
             
         >
      DECOMP
         <
          C1:monthnoun IN NPrec1.actsubcs AND
             daynoun IN NPrec4.actsubcs AND
             NPrec4.supertiempo = omegatiempo AND
             NPrec4.generic = omegageneric
          A1:NPrec2 := NPrec4;
             NPrec2.generic := nogeneric;
             NPrec2.supertiempo := NPrec1.supertiempo
         >


&

\end{verbatim}
