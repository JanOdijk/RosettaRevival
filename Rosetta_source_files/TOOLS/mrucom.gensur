                           end;
                         END;
                   IF found THEN cattable:=vartype.cattable
                     ELSE writeln('ERROR, ',str1,'.REC not guarded');
                   END;
               END
   *>
16: <* SEND: BEGIN END
      !VALUENAME.
      RECEIVE: BEGIN 
                 string:=%%VALUENAME.string;
                 waarde:=string;
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   "(" ""string""
                   nogeenhaakje:=TRUE;
                 END;                 
               END
   *>
17: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN 
                 str3:=%VARNAME.str1;
                 str4:=%VARNAME.str2;
                 string:=%%VARNAME.string;
                 waarde:=string;
                 varkind1:=%VARNAME.varkind;
                 IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec) THEN
                   BEGIN
                   \commatchfile.\LOCAL.
                   "(" ""string""
                   nogeenhaakje:=TRUE;
                   END
                 ELSE
                   BEGIN
                   after:=true;
                   vartypes1:=vartypes;
                   found:=FALSE;
                   WHILE stillvartypes(vartypes1) DO
                         BEGIN
                         takevartype(vartype1,vartypes1);
                         found1:=TSTRING_compare(str3,vartype1.varname)=0;
                         if found1 then 
                           begin
                           found:=TRUE;
                           vartype:=vartype1
                           end;
                         END;
                   IF found THEN cattable:=vartype.cattable
                     ELSE writeln('ERROR, ',str3,'.REC not guarded');
                   END;
               END
   *>
18: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN
                 APPENDLOCFILE(%%SETVALUENAME.copy,commatchfile);
               END
   *>
19: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN 
                 str1:=%VARNAME.str1;
                 str2:=%VARNAME.str2;
                 string:=%%VARNAME.string;
                 varkind:=%VARNAME.varkind;
                 IF (%VARNAME.varkind<>noderec) AND (%VARNAME.varkind<>treerec) THEN
                   BEGIN
                   \commatchfile.\LOCAL.
                   ""string""
                   END
                 ELSE
                   BEGIN
                   uitgesteldhaakje:=nogeenhaakje;
                   nogeenhaakje:=FALSE;
                   before:=TRUE;
                   vartypes1:=vartypes;
                   found:=FALSE;
                   WHILE stillvartypes(vartypes1) DO
                         BEGIN
                         takevartype(vartype1,vartypes1);
                         found1:=TSTRING_compare(str1,vartype1.varname)=0;
                         if found1 then 
                           begin
                           found:=TRUE;
                           vartype:=vartype1
                           end;
                         END;
                   IF found THEN cattable:=vartype.cattable
                     ELSE writeln('ERROR, ',str1,'.REC not guarded');
                   END;
               END
   *>
20: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   " ="
                 END;                 
               END
   *>
21: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   "<"
                 END;                 
               END
   *>
22: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 notpresent:=TRUE;
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   " NOT("
                 END;                 
               END
   *>
23: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
24: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN IF inaanwezig THEN
                         BEGIN
                         IF NOT (haakjesopen=zoalsbijIN) THEN ")"
                         ") AND ((" ""waarde"" " IN "
                         haakjetoegevoegd:=TRUE;
                         If NOT (haakjesopen=zoalsbijIN) THEN "("
                         END
                       ELSE " *"
                 END;                 
               END
   *>
25: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN
                 APPENDLOCFILE(%%SETVALUENAME.copy,commatchfile);
                 If haakjetoegevoegd Then ")"
                 haakjetoegevoegd:=FALSE;
               END
   *>
26: <* SEND: BEGIN END
      !VARNAME.
      RECEIVE: BEGIN
                 string:=%%VARNAME.string;
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   ""string""
                 END;    
               If haakjetoegevoegd Then ")"
               haakjetoegevoegd:=FALSE;             
               END
   *>
27: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   " +"
                 END;                 
               END
   *>
28: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   " +"
                 END;                 
               END
   *>
