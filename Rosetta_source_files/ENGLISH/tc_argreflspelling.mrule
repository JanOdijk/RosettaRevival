          A1: NPrec1 := AUX_NPONhimRFLPR;
              NPrec1.cases := CNVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONhimRFLPR EXCEPT FOR [cases] AND
              CNVARrec1.numbers = [singular] AND
              ( masculine IN CNVARrec1.sexes OR
                CNVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := NPrec1.cases
