\begin{verbatim}
%TRANSFORMATION TreflCLOSEDCATprep3  (* reflexive, subject antecedent, CNVAR *)

< m1:VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                      [ mu15,
                        head/I1::VERB{VERBrec1}[mu3],
                        cliticrel/CLITIC{CLITICrec1}[mu4],
                        prepobjrel/VARPREPP{VARPREPPrec1}
                             [mu10,
                              objrel/I7::N1 [ subjrel/CNVAR{CNVARrec1},
                                              mu8
                                            ],
                              mu11
                             ],
                        mu2
                      ],
                mu5
              ]
>

< m :VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                      [ mu15,
                        head/I1::VERB{VERBrec1}[mu3],
                        cliticrel/CLITIC{CLITICrec1}
                             [seclrel/REFLPRO(AUX_Sereflprokey){REFLPROrec1},
                              mu4
                             ],
                        prepobjrel/VARPREPP{VARPREPPrec1}
                             [mu10,
                              objrel/I7::N1 [ subjrel/CNVAR{CNVARrec1},
                                              mu8
                                            ],
                              mu11
                             ],
                        mu2
                      ],
                mu5
              ]
>


   MATCHCONDITIONS
      <
       I1:VERBrec1.reflexivity = reflexive
       I7: N1.CAT IN [CLOSEDADJPPROP, CLOSEDNPPROP, CLOSEDPREPPPROP]
      >

      COMP
         <
          C1: true (* it is assumed that CNrecords do not have person *) 
          A1: @
         >
&

\end{verbatim}
