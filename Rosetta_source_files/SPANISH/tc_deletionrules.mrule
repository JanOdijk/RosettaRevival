\newpage
\begin{verbatim}
% TRANSFORMATION TPRONPVARdel
< m1:I2::SENTENCE{SENTENCErec1}
                        [ I1:mu1,
                          subjrel/PRONPVAR{PRONPVARrec1},
                          I3:mu2,

                          head/I4::VERB{VERBrec1}[mu4],
                          mu3
                        ]
>

< m:I2::SENTENCE{SENTENCErec1}
                        [ I1:mu1,
                          I3:mu2,
                          head/I4::VERB{VERBrec1}[mu4],
                          mu3
                        ]
>

   MATCHCONDITIONS
      <
       I1:  ALL (mu1, I11:rel1/..)
       I11: rel1 IN [shiftrel, conjrel, meltnegrel]
       I2:  (SENTENCErec1.finiteness = finite)      AND
            ((SENTENCErec1.thetavp IN [vp010, vp021, vp012]) OR
             (SENTENCErec1.voice = Passive)
            )
       I3:  ALL (mu2, I31:rel2/..)
       I31: rel2 IN [vpadvrel, negrel, cliticrel]
       I4:  (PRONPVARrec1.numero = VERBrec1.numero)   AND 
            (PRONPVARrec1.persona = VERBrec1.persona) AND
            (PRONPVARrec1.index = 0)
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1: PRONPVARrec1.numero := VERBrec1.numero;
              PRONPVARrec1.persona := VERBrec1.persona;
              PRONPVARrec1.index := 0
         >
&

\end{verbatim}
