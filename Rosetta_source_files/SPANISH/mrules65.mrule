\begin{verbatim}
% RULE Radjppfinconjsvar
< m1: ADJPPROP{ADJPPROPrec1}
                [ I2:mu1
                ]

  m2: I1::SENTENCEVAR{SENTENCEVARrec1}                 
>

< m :ADJPPROP{ADJPPROPrec1}
                [ 
                  leftdislocrel/I1::SENTENCEVAR{SENTENCEVARrec1},
                  I2:mu1
                ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCEVARrec1.adverbial =true
       I2: NOT EXIST(mu1, [leftdislocrel/..])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >



&

\end{verbatim}
