BASIS RULE 
  VARCATSECTION = VARCATS/1.COLON/1.
                             LEFTARROW/1 . {IDENTIFIER/2 . COLON/1 .
                             IDENTIFIER/3} . RIGHTARROW/1

SURFACE PART

<*
 INIT:BEGIN 
       END;
1 :    <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
