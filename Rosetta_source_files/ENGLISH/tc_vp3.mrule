   SUBRULE (* 9a. x1 cost x2 x3 *)
      < T1: NPPROPVAR{NPPROPVARrec1}
        T2: NPVAR{NPVARrec1} >

      < T1: NPPROPVAR{NPPROPVARrec1}
        T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synIONP_MEASUREPHRASE IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_MEASUREPHRASE];
              rel1 := indobjrel;
              rel2 := complrel
         >
      DECOMP
         <
          C1: synIONP_MEASUREPHRASE IN VERBPPROPrec2.synvpefs AND
              synIONP_MEASUREPHRASE IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND
              rel1 = indobjrel AND
              rel2 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 9b. x1 cost x2 x3 *)
      < T1: NPPROPVAR{NPPROPVARrec1}
