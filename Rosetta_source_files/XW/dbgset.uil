object dbgset_window : XmFormDialog {
    arguments {
	arguments form_dialog_args;
        XmNdialogTitle  = N_dbgset_window;
        XmNnoResize    = true;
    };
    controls {
        XmRowColumn dbgset_button_box;
        XmSeparator dbgset_separator1;
        XmForm dbgset_debug_form;
        XmSeparator dbgset_separator2;
        XmForm dbgset_print_form;
        XmSeparator dbgset_separator3;
        XmForm dbgset_interact_form;
        XmSeparator dbgset_separator4;
        XmForm dbgset_last_form; 
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_dbgset_window);
    };
};

object dbgset_button_box : XmRowColumn {
    arguments {
        XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;

	arguments button_box_args;
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton dbgset_ok_button;
        XmPushButton dbgset_reset_button;
        XmPushButton dbgset_help_button;
    };
};

object dbgset_ok_button : XmPushButton {
    arguments {
	arguments button_args;
        XmNlabelString       = N_dbgset_ok_button;
    };
    callbacks {
        XmNactivateCallback = procedure
            XwuUnmanageWidget (X_dbgset_window);
    };
};

object dbgset_reset_button : XmPushButton {
    arguments {
	arguments button_args;
        XmNlabelString       = N_dbgset_reset_button;
    };
    callbacks {
      	MrmNcreateCallback = procedure XwuCreateWidget(X_dbgset_reset_button);
        XmNactivateCallback = procedure
            XwdAction(X_dbgset_reset_button);
    };
};

object dbgset_help_button : XmPushButton {
    arguments {
	arguments button_args;
        XmNlabelString       = N_dbgset_help_button;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_dbgset_help_button);
        XmNactivateCallback = procedure XwhAction(X_dbgset_help_button);
    };
};

object dbgset_separator1 : XmSeparator {
    arguments {
        XmNleftAttachment    = XmATTACH_FORM;
        XmNrightAttachment   = XmATTACH_FORM;
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmRowColumn dbgset_button_box;

        XmNleftOffset        = 0;
        XmNrightOffset       = 0;
        XmNmargin            = 0;
    };
};

! the debug components menu

object dbgset_debug_form : XmForm {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;        
        XmNleftAttachment    = XmATTACH_FORM;
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmSeparator dbgset_separator1;

	arguments form_args;
    };
    controls {
        XmLabel dbgset_debug_label;
        XmRowColumn dbgset_debug_toggles;
    };
};

object dbgset_debug_label : XmLabel {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;        
        XmNleftAttachment    = XmATTACH_FORM;
        XmNlabelString       = N_dbgset_debug_title;
        XmNfontList          = bigbold;
    };
};

object dbgset_debug_toggles : XmRowColumn {
    arguments {
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmLabel dbgset_debug_label;
        XmNleftAttachment    = XmATTACH_FORM;
        XmNbottomAttachment  = XmATTACH_FORM;

        XmNorientation       = XmVERTICAL;

    };
    controls {
        XmToggleButton    dbgset_debug1_toggle;
        XmToggleButton    dbgset_debug2_toggle;
        XmToggleButton    dbgset_debug3_toggle;
        XmToggleButton    dbgset_debug4_toggle;
        XmToggleButton    dbgset_debug5_toggle;
        XmToggleButton    dbgset_debug6_toggle;
        XmToggleButton    dbgset_debug7_toggle;
        XmToggleButton    dbgset_debug8_toggle;
    };
};

