\newpage
\begin{verbatim}
% RULE ROPENADJPPROPSentenceSubst
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                subjrel/T3,
                mu9,
                predrel/VERBP{VERBPrec1}
                       [I2:mu2,
                        complrel/I1::ADJPPROPVAR{ADJPPROPVARrec1},
                        I3:mu3 
                       ],
                I6:mu6,
                I7:mu7
               ]
  
  SUBST:
  m2: OPENADJPPROP{OPENADJPPROPrec1}
                  [
                   subjrel/T1,
                   predrel/I8::ADJP{ADJPrec1}[mu5]
                  ]
>

< m : VERBPPROP{VERBPPROPrec1}
               [ mu1,
                 subjrel/T3,
                 mu9,
                 predrel/VERBP{VERBPrec1}
                        [I2:mu2,
                         I3:mu3 
                        ],
                 I6:mu6,
                 postsentadvrel/SENTENCE{SENTENCErec1}
                    [modrel/PREP(KEY_'s_prep1245705'){PREPrec1}[],
                     subjrel/T3,
                     predrel/VERBP{VERBPrec1}
                             [head/VERB{VERBrec1}
                               [head/SUBVERB{SUBVERBrec1}
                                 [head/BVERB(KEY_'s4121600V_4_a'){BVERBrec1}]
                               ], 
                              objrel/T2,
                              complrel/ADJP{ADJPrec1}[mu5]
                             ]
                     ],
                 I7:mu7
               ]

 >

   MATCHCONDITIONS
      <
       I1: ADJPPROPVARrec1.index = LEVEL 
       I2: ALL(mu2,I21:rel2/..)
                   I21: QUOTE_VPrelprec(rel2,complrel)
       I3: ALL(mu3,I31:rel3/..)
                   I31: QUOTE_VPrelprec(complrel,rel3)
       I6: ALL (mu6,I61:rel6/..) AND NOT EXIST (mu6,[postsentadvrel/..])
           I61: QUOTE_Srelprec (rel6,postsentadvrel)
       I7: ALL (mu7,postsentadvrel/..)
       I5: T3.CAT IN [NPVAR,CNVAR]
       I8: ADJPrec1.actsubcefs * [coloradj,measureadj] = []   
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE
      < T1:NPVAR{NPVARrec1}>
      < T2:NPVAR{NPVARrec2}>


      COMP
         <
          C1: AUX_adjppredvps * VERBPPROPrec1.synvpefs = [] AND
              [resAP] * VERBPPROPrec1.adjuncts = [] AND
              ADJPPROPVARrec1 = COPYT_adjppropTOvar(OPENADJPPROPrec1) 
          A1: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subTOverb(SUBVERBrec1);
                   VERBrec1.modo := infinitivo;
                   VERBrec1.tiempo := omegatiempo; 
                   VERBrec1.persona := 3;
                   VERBrec1.numero:= omeganumero;
                   NPVARrec2 := NPVARrec1;
                   NPVARrec2.cases := [accusative];
                   SENTENCErec1     := SENTENCErecdef;
                   SENTENCErec1     :=
                       {
                       mood:              declarative
                       senttype:          subordinateclause
                       voice:             active
                       synvpefs:          VERBrec1.synvps 
                       thetavp:           VERBrec1.thetavp 
                       adjuncts:          VERBrec1.adjuncts 
                       modo:              VERBrec1.modo
                       aktionsarts:       [stative]
                       finiteness:        infinite
                       adverbial:         true 
                                              
                       }


         >
   SUBRULE
      < T1:CNVAR{CNVARrec1} >
      < T2:CNVAR{CNVARrec2} >

      COMP
         <
          C1: AUX_adjppredvps * VERBPPROPrec1.synvpefs = [] AND
              [resAP] * VERBPPROPrec1.adjuncts = [] AND
              ADJPPROPVARrec1 = COPYT_adjppropTOvar(OPENADJPPROPrec1) 
          A1: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subTOverb(SUBVERBrec1);
                   VERBrec1.modo := infinitivo;
                   VERBrec1.tiempo := omegatiempo;
                   VERBrec1.persona := 3;
                   VERBrec1.numero := omeganumero; 
                   CNVARrec2 := CNVARrec1;
                   CNVARrec2.cases := [accusative];
                   SENTENCErec1     := SENTENCErecdef;
                   SENTENCErec1     :=
                       {
                       mood:              declarative
                       senttype:          subordinateclause
                       voice:             active
                       synvpefs:          VERBrec1.synvps 
                       thetavp:           VERBrec1.thetavp 
                       adjuncts:          VERBrec1.adjuncts 
                       modo:              VERBrec1.modo
                       aktionsarts:       [stative]
                       finiteness:        infinite
                       adverbial:         true
                       }
         >
>
&

\end{verbatim}
