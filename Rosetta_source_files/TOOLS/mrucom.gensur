PROCEDURAL PART
VAR nottest:Boolean;
    NumberOfItems:Integer;
    functionname,variable:TSTRING_string;
    commatchfile,decommatchfile,
    allexist:LOCALFILE;
    id::ident;
    levelids::setofidents;
    allexistcounter::int;
BEGIN
INIT: BEGIN 
        allexistcounter:=$$MATCHBOOLEAN.allexistcounter;
        nottest:=FALSE;
        INITLOCALFILE(commatchfile);
        INITLOCALFILE(decommatchfile);
        INITLOCALFILE(allexist);
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 nottest:=TRUE;
               END
   *>
3: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN END
      !MUVAR.
      RECEIVE: BEGIN
                 variable:=%%MUVAR.ident;
               END
   *>
5: <* SEND: BEGIN END
      !SIGMAVAR.
      RECEIVE: BEGIN 
                 variable:=%%SIGMAVAR.ident;
               END
   *>
6: <* SEND: BEGIN %%LD.inexist:=TRUE;
            END
      !LD.
      RECEIVE: BEGIN
              allexistcounter:=allexistcounter+1;
              NumberOfItems:=%%LD.NumberOfItems;
              BEGIN \allexist.\LOCAL. END;
              BEGIN
                "FUNCTION EXIST" """allexistcounter"""
                        "(mu:LSMRUQUO_ListOfStrees):Boolean;"\\
                LOCALTAB(allexist,2);
                "VAR next:LSSTREE_pRelNode;"\\
                 levelids:=%%LD.levelids;
                 WHILE stillidents(levelids) DO
                   BEGIN
                   takeident(id,levelids);
                   "Linit" ""id.str"" ",Lrest" ""id.str""
                   ",Lfirst" ""id.str"" ",Llast" ""id.str""
                   ":LSSTREE_prelnode;"\\
                   "i" ""id.str"" ":INTEGER;"\\
                   "nomoretrees" ""id.str"" ",lastmatch"
                                ""id.str"" ":BOOLEAN;"\\
                   END;
                LOCALTAB(allexist,6);
                "Lfinal:LSSTREE_prelnode;"\\
                "match:Boolean;"\\
             END;
              appendlocfile(%%LD.allexist,allexist);
              BEGIN \allexist.\LOCAL. END;
              BEGIN
              LOCALTAB(allexist,2);
                "BEGIN{Exist" """allexistcounter"""
                "}"\\
              LOCALTAB(allexist,4);
                  "next:=mu.first;match:=False;Lfinal:=mu.last;"\\
              LOCALTAB(allexist,4);
                  "IF next =NIL THEN"\\
              LOCALTAB(allexist,6);
                     "EXIST" """allexistcounter"""
                     ":=False"\\
              LOCALTAB(allexist,4);
                  "ELSE"\\
              LOCALTAB(allexist,4);
                  "BEGIN"\\
              LOCALTAB(allexist,6);
                    "WHILE (next<>mu.last) AND NOT(match) DO"\\
              LOCALTAB(allexist,6);
                    "BEGIN"\\
              LOCALTAB(allexist,8);
                      "matchlist" """NumberOfItems""" 
                                "items(next,TRUE,match);"\\
              LOCALTAB(allexist,8);
                      "next:=next^.brother;"\\
              LOCALTAB(allexist,6);
                    "END;"\\
              LOCALTAB(allexist,6);
                    "IF match = False THEN"\\
              LOCALTAB(allexist,8);
                      "matchlist" """NumberOfItems""" 
                                "items(next,TRUE,match);"\\
              LOCALTAB(allexist,6);
                    "EXIST" """allexistcounter"""
                    ":=match;"\\
              LOCALTAB(allexist,4);
                  "END;"\\
              LOCALTAB(allexist,2);
                "END;{Exist}"\\
              END;
              IF nottest THEN
              BEGIN
                BEGIN \commatchfile.\LOCAL. END;
                BEGIN
                  "NOT Exist" """allexistcounter"""
                  "(" ""variable"" ")"
                END;
              END
              ELSE  
              BEGIN
                BEGIN \commatchfile.\LOCAL. END;
                BEGIN
                  "Exist" """allexistcounter"""
                  "(" ""variable"" ")"
                END;
              END
               END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
8: <* SEND: BEGIN
              %%ITEM.indent:=0;
              TSTRING_constantempty(%%ITEM.name);
              TSTRING_constantempty(%%ITEM.root);
            END
      !ITEM.
      RECEIVE: BEGIN
                 allexistcounter:=allexistcounter+1;
                 functionname:=%%ITEM.identifier;
                 BEGIN \allexist.\LOCAL. END;
                 BEGIN
                   "FUNCTION ALL" """allexistcounter"""
                             "(mu:LSMRUQUO_ListOfStrees):Boolean;"\\
                   LOCALTAB(allexist,2);
                   "VAR next:LSSTREE_pRelNode;"\\
                   "lastmatch:BOOLEAN;"\\
                   LOCALTAB(allexist,6);
                 levelids:=%%ITEM.levelids;
                 WHILE stillidents(levelids) DO
                   BEGIN
                   takeident(id,levelids);
                   "Linit" ""id.str"" ",Lrest" ""id.str""
                   ",Lfirst" ""id.str"" ",Llast" ""id.str""
                   ":LSSTREE_prelnode;"\\
                   "i" ""id.str"" ":INTEGER;"\\
                    "nomoretrees" ""id.str"" ",lastmatch"
                                ""id.str"" ":BOOLEAN;"\\
                   END;
                      "match:Boolean;"\\
                  END;
                 appendlocfile(%%ITEM.leftcom,allexist);
                 BEGIN \allexist.\LOCAL. END;
                 BEGIN
                   LOCALTAB(allexist,2);
                   "BEGIN{All" """allexistcounter""" 
                        "}"\\
                   LOCALTAB(allexist,4);
                     "next:=mu.first;match:=TRUE;"\\
                   LOCALTAB(allexist,4);
                     "IF next =NIL THEN"\\
                   LOCALTAB(allexist,6);
                        "ALL" """allexistcounter""" 
                        ":=TRUE"\\
                   LOCALTAB(allexist,4);
                     "ELSE"\\
                   LOCALTAB(allexist,4);
                     "BEGIN"\\
                   LOCALTAB(allexist,6);
                       "WHILE (next<>mu.last) AND (match) DO"\\
                   LOCALTAB(allexist,6);
                       "BEGIN"\\
                   LOCALTAB(allexist,8);
                         "match_" ""functionname"" "(next,next,TRUE,match);"\\
                   LOCALTAB(allexist,8);
                         "next:=next^.brother;"\\
                   LOCALTAB(allexist,6);
                       "END;"\\
                   LOCALTAB(allexist,6);
                       "IF match THEN"\\
                   LOCALTAB(allexist,6);
                       "BEGIN"\\
                   LOCALTAB(allexist,8);
                         "match_" ""functionname"" "(next,mu.last,TRUE,match);"\\
                   LOCALTAB(allexist,8);
                          "ALL" """allexistcounter"""
                          ":=match;"\\
                   LOCALTAB(allexist,6);
                       "END"\\ 
                   LOCALTAB(allexist,6);
                       "ELSE"\\ 
                   LOCALTAB(allexist,8);
                       "ALL" """allexistcounter"""
                       ":=FALSE;"\\
                   LOCALTAB(allexist,4);
                     "END;"\\
                   LOCALTAB(allexist,2);
                   "END;{All}"\\
                 END;
                 IF nottest THEN
                 BEGIN
                   BEGIN \commatchfile.\LOCAL. END;
                   BEGIN
                     "NOT ALL" """allexistcounter"""
                     "(" ""variable"" ")"
                   END;
                 END
                 ELSE  
                 BEGIN
                   BEGIN \commatchfile.\LOCAL. END;
                   BEGIN
                     "ALL" """allexistcounter"""
                     "(" ""variable"" ")"
                   END;
                 END
               END
   *>
9: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
10: <* SEND: BEGIN %%LD.inexist:=TRUE;
            END
      !LD.
      RECEIVE: BEGIN
              allexistcounter:=allexistcounter+1;
              NumberOfItems:=%%LD.NumberOfItems;
              BEGIN \allexist.\LOCAL. END;
              BEGIN
                "FUNCTION FIRST" """allexistcounter"""
                        "(mu:LSMRUQUO_ListOfStrees):Boolean;"\\
                LOCALTAB(allexist,2);
                "VAR next:LSSTREE_pRelNode;"\\
                 levelids:=%%LD.levelids;
                 WHILE stillidents(levelids) DO
                   BEGIN
                   takeident(id,levelids);
                   "Linit" ""id.str"" ",Lrest" ""id.str""
                   ",Lfirst" ""id.str"" ",Llast" ""id.str""
                   ":LSSTREE_prelnode;"\\
                   "i" ""id.str"" ":INTEGER;"\\
                   "nomoretrees" ""id.str"" ",lastmatch"
                                ""id.str"" ":BOOLEAN;"\\
                   END;
                LOCALTAB(allexist,6);
                "Lfinal:LSSTREE_prelnode;"\\
                "match:Boolean;"\\
             END;
              appendlocfile(%%LD.allexist,allexist);
              BEGIN \allexist.\LOCAL. END;
              BEGIN
              LOCALTAB(allexist,2);
                "BEGIN{FIRST" """allexistcounter"""
                "}"\\
              LOCALTAB(allexist,4);
                  "next:=mu.first;match:=False;Lfinal:=mu.last;"\\
              LOCALTAB(allexist,4);
                  "IF next =NIL THEN"\\
              LOCALTAB(allexist,6);
                     "FIRST" """allexistcounter"""
                     ":=False"\\
              LOCALTAB(allexist,4);
                  "ELSE"\\
              LOCALTAB(allexist,4);
                  "BEGIN"\\
              LOCALTAB(allexist,6);
                      "matchlist" """NumberOfItems""" 
                                "items(next,TRUE,match);"\\
              LOCALTAB(allexist,6);
                    "FIRST" """allexistcounter"""
                    ":=match;"\\
              LOCALTAB(allexist,4);
                  "END;"\\
              LOCALTAB(allexist,2);
                "END;{FIRST}"\\
              END;
              IF nottest THEN
              BEGIN
                BEGIN \commatchfile.\LOCAL. END;
                BEGIN
                  "NOT FIRST" """allexistcounter"""
                  "(" ""variable"" ")"
                END;
              END
              ELSE  
              BEGIN
                BEGIN \commatchfile.\LOCAL. END;
                BEGIN
                  "FIRST" """allexistcounter"""
                  "(" ""variable"" ")"
                END;
              END
               END
   *>
11: <* SEND: BEGIN %%LD.inexist:=FALSE;
            END
      !LD.
      RECEIVE: BEGIN
              allexistcounter:=allexistcounter+1;
              NumberOfItems:=%%LD.NumberOfItems;
              BEGIN \allexist.\LOCAL. END;
              BEGIN
                "FUNCTION EQUALS" """allexistcounter"""
                        "(mu:LSMRUQUO_ListOfStrees):Boolean;"\\
                LOCALTAB(allexist,2);
                "VAR next:LSSTREE_pRelNode;"\\
                 levelids:=%%LD.levelids;
                 WHILE stillidents(levelids) DO
                   BEGIN
                   takeident(id,levelids);
                   "Linit" ""id.str"" ",Lrest" ""id.str""
                   ",Lfirst" ""id.str"" ",Llast" ""id.str""
                   ":LSSTREE_prelnode;"\\
                   "i" ""id.str"" ":INTEGER;"\\
                   "nomoretrees" ""id.str"" ",lastmatch"
                                ""id.str"" ":BOOLEAN;"\\
                   END;
                LOCALTAB(allexist,6);
                "Lfinal:LSSTREE_prelnode;"\\
                "match:Boolean;"\\
             END;
              appendlocfile(%%LD.allexist,allexist);
              BEGIN \allexist.\LOCAL. END;
              BEGIN
              LOCALTAB(allexist,2);
                "BEGIN{EQUALS" """allexistcounter"""
                "}"\\
              LOCALTAB(allexist,4);
                  "next:=mu.first;match:=False;Lfinal:=mu.last;"\\
              LOCALTAB(allexist,4);
                  "IF next =NIL THEN"\\
              LOCALTAB(allexist,6);
                     "EQUALS" """allexistcounter"""
                     ":=False"\\
              LOCALTAB(allexist,4);
                  "ELSE"\\
              LOCALTAB(allexist,4);
                  "BEGIN"\\
              LOCALTAB(allexist,6);
                      "matchlist" """NumberOfItems""" 
                                "items(next,TRUE,match);"\\
              LOCALTAB(allexist,6);
                    "EQUALS" """allexistcounter"""
                    ":=match;"\\
              LOCALTAB(allexist,4);
                  "END;"\\
              LOCALTAB(allexist,2);
                "END;{EQUALS}"\\
              END;
              IF nottest THEN
              BEGIN
                BEGIN \commatchfile.\LOCAL. END;
                BEGIN
                  "NOT EQUALS" """allexistcounter"""
                  "(" ""variable"" ")"
                END;
              END
              ELSE  
              BEGIN
                BEGIN \commatchfile.\LOCAL. END;
                BEGIN
                  "EQUALS" """allexistcounter"""
                  "(" ""variable"" ")"
                END;
              END
               END
   *>
*>
FINAL:BEGIN 
        $$MATCHBOOLEAN.commatchfile:=commatchfile;
        $$MATCHBOOLEAN.decommatchfile:=decommatchfile;
        $$MATCHBOOLEAN.allexist:=allexist;
        $$MATCHBOOLEAN.allexistcounter:=allexistcounter;
      END
END;
