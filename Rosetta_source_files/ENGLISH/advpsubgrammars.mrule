\newpage
\begin{verbatim}
% RULE RStartAdvpprop100           (* normal adverbs *)
< m1: SUBADV{SUBADVrec1}[mu1] 
  m2: T1
>

< m : ADVPPROP{ADVPPROPrec1}
              [ I1:subjrel/T1,
                predrel/ADVP{ADVPrec1}
                       [head/ADV{ADVrec1}
                            [head/SUBADV{SUBADVrec1}[mu1] ] 
                       ]
              ]
>

   MATCHCONDITIONS
      <
       m2: T1.CAT IN AUX_VARCATSET
       I1: T1.CAT IN AUX_VARCATSET
      >


      COMP
         <
          C1: SUBADVrec1.thetaadv = advp100
          A1: ADVrec1 := COPYT_subadvtoadv(SUBADVrec1);
              ADVrec1.compform := basic;
              ADVPrec1 := COPYT_advTOadvp(ADVrec1);
              ADVPrec1.actsubcefs := ADVrec1.subcs;
              (* superdeixis, thanascompl, advpatternefs:
                 default values *)
              ADVPPROPrec1 := COPYT_ADVPtoPROP(ADVPrec1);
              ADVPPROPrec1 := { aktionsarts : [stative]
                                PROsubject  : false }
         >

      DECOMP
         <
          C1: SUBADVrec1.thetaadv = advp100 AND
              ADVrec1 = COPYT_subadvtoadv(SUBADVrec1) AND
              ADVrec1.compform = basic AND
              ADVPrec1 = COPYT_advTOadvp(ADVrec1) AND
              ADVPrec1 = { superdeixis   : omegadeixis
                           advpatternefs : []
                           thanascompl   : false } AND
              ADVPrec1.actsubcefs * ADVrec1.subcs <> [] AND
              ADVPPROPrec1 = COPYT_ADVPtoPROP(ADVPrec1) AND
              ADVPPROPrec1 = { aktionsarts : [stative]
                               PROsubject  : false }
          A1: @
         >

&

\end{verbatim}
