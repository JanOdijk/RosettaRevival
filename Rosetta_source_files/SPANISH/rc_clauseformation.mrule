\newpage
\begin{verbatim}
% RULE RClauseformation4 (* existential NPPROP *)
< m1:NPPROP{NPPROPrec1}[mu12, objrel/T1,mu1] 
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu12,
             subjrel/NP{NPrec1}
                    [head/PERSPRO{PERSPROrec1}
                       [head/BPERSPRO(AUX_redellobpersprokey){BPERSPROrec1}]
                    ],
             predrel/VERBP{VERBPrec1}
                    [ head/VERB{VERBrec1}
                          [ head/SUBVERB{SUBVERBrec1}
                                [ head/BVERB(KEY_haberBVERBkey){BVERBrec1} ] 
                          ],
                      cliticrel/CLITIC{}[],
                      objrel/T1 
                    ],
             mu1
           ]
>

   MATCHCONDITIONS
      <
        I1: (CLAUSErec1.voice = active ) AND
            ( synHABER IN CLAUSErec1.synvpefs ) 
      >


      COMP
         <
          C1:NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts]
          A1:SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
             VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
              (* all other attributes of VERBrec1  retain the default values *)
             (* VERBPrec1 retains all default values *)
             CLAUSErec1 := COPYT_npproptoclause(NPPROPrec1);
             CLAUSErec1 :=
	       { 
		voice       : active
		synvpefs    : [synHABER]
                thetavp     : thetavpAUX
	       };
              (* all others retain the default values *)

             PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
             PERSPROrec1.forma := Nomdebil;
             NPrec1 := AUX_NPONredelloBPRSPR
         >

      DECOMP
         <
          C1: ( CLAUSErec1 = CLAUSErecdef EXCEPT FOR [ voice, synvpefs,
                thetavp, aktionsarts ] ) AND
              ( CLAUSErec1.thetavp = thetavpAUX ) AND
              ( VERBPrec1 = VERBPrecdef ) AND
              ( SUBVERBrec1 = COPYT_btosubverb(BVERBrec1) ) AND
              ( VERBrec1 = COPYT_subtoverb(SUBVERBrec1) ) AND
              ( VERBrec1 =
		  { 
		   numero       : singular
		   persona      : 3  
		   modo         : infinitivo  
		   tiempo       : omegatiempo  
		   status       : bareV
		  }
              )                                               AND
             (* the default values for these attributes *)

             (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) 
                                        EXCEPT FOR [forma])   AND
             (PERSPROrec1.forma = Nomdebil)                   AND
             (NPrec1 = AUX_NPONredelloBPRSPR)
          A1: NPPROPrec1 := NPPROPrecdef;
              NPPROPrec1 := 
               {
                 aktionsarts : CLAUSErec1.aktionsarts
               }
         >
&

\end{verbatim}
