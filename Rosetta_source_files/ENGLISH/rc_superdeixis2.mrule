\begin{description}
\item[* name:] Rinfinpastsuperdeixis
\item[* relevant examples:] he liked to work,
*he he liked  to `can' ....,
*he liked to `will' ....,
he liked to be ill,
he liked to be working,
*he liked to `must'
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 28-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpastsuperdeixis 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 19/05/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on futuredeixis adverbial.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before : PAST.
               This rule is for a infinite dependent clause.
               The deixis 
value of the possible reference adverbial is checked for 
               omega or future.
               The clause is marked for past superdeixis.
\item[\ \ strategy:] The match is left to right. The rule is not applicable to 
modal auxiliaries (conjclasses 12, 13, 14; no infinite forms).
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be pastdeixis in the case 
this sentence is a sentence with adverbs such as {\em graag} in Dutch. 
In English this may be 
the case in cases in which e.g. a verb is a semantic head but behaves as an  
auxiliary verb (e.g. modal verbs)\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% RULE Rinfinpastsuperdeixisspec
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I4: mu2,
                    I2: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I4: mu2,
                    auxrel/VERB{VERBrec3}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(AUX_havebverbkey){BVERBrec1}
                               ] 
                          ],
                    I2: rel1/VERB{VERBrec2}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST (mu5, [tempadvrel/..])
       I2: (rel1 IN [head, passauxrel, progauxrel])
       I4: NOT EXIST (mu2, [auxrel/..])
      >

<
   SUBRULE (*1: ADVPVAR *)
      <mu5 : [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I3: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I3: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.deixis = omegadeixis)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus)
            )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := pastdeixis;

             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modus = participle) AND
              (VERBrec2.tense = omegatense) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
                     {
                      numbers   : []
                      persons   : []
                      modus     : omegamodus
                      tense     : omegatense
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.superdeixis = pastdeixis)
             A11: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := omegadeixis;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.superdeixis = pastdeixis)
             A12: CLAUSErec1 := CLAUSErec2;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
         >

   SUBRULE (*2: PREPPVAR*)
      <mu5 : [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>
      <mu5 : [mu6, I3: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu7]>

   MATCHCONDITIONS
      <
       I3: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.deixis = omegadeixis)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus)
            )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := pastdeixis;

              (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis)
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modus = participle) AND
              (VERBrec2.tense = omegatense) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
                     {
                      numbers   : []
                      persons   : []
                      modus     : omegamodus
                      tense     : omegatense
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.superdeixis = pastdeixis)
             A11: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := omegadeixis;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.superdeixis = pastdeixis)
             A12: CLAUSErec1 := CLAUSErec2;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
         >


   SUBRULE (*3: SENTENCE*)
      <mu5 : [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>
      <mu5 : [mu6, I3: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu7]>

   MATCHCONDITIONS
      <
       I3: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjdeixis = omegadeixis)
      >

      COMP
         <
          C1:((CLAUSErec1.deixis = omegadeixis) AND
              (CLAUSErec1.aspect = perfective) AND
              (CLAUSErec1.retro = false) AND
              (CLAUSErec1.finiteness = infinite) AND
              (VERBrec1.tense = omegatense) AND
              (VERBrec1.modus = omegamodus)
            )
             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.superdeixis := pastdeixis;

             (* modal + dependent clause *)
             C12:(CLAUSErec1.superdeixis = pastdeixis) 
             A12: CLAUSErec2 := CLAUSErec1;

          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := participle;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain their default values *)
         >
      DECOMP
         <
          C1:((CLAUSErec2.deixis = omegadeixis) AND
              (CLAUSErec2.aspect = perfective) AND
              (CLAUSErec2.retro = false) AND
              (CLAUSErec2.finiteness = infinite) AND
              (VERBrec2.modus = participle) AND
              (VERBrec2.tense = omegatense) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
                     {
                      numbers   : []
                      persons   : []
                      modus     : omegamodus
                      tense     : omegatense
                     }
               )
              
              (* other values: default values *)
             )
             C11: (CLAUSErec2.superdeixis = pastdeixis)
             A11: CLAUSErec1 := CLAUSErec2;
                  CLAUSErec1.superdeixis := omegadeixis;
 
             (* modal + dependent clause *)
             C12: (CLAUSErec2.superdeixis = pastdeixis)
             A12: CLAUSErec1 := CLAUSErec2;

          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
         >

>
&
\end{verbatim}

\newpage
\begin{description}
\item[* name:] Rinfinpastsuperdeixisspec
\item[* relevant examples:] He believed (him to have bought a car at three o'
clock)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 28-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:]Rinfinpastdeixisspec 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a infinite dependent clause. This
               is a special rule,because past is expressed by the auxiliary 
               verb {\em have}. 
               The most left verb in the clause (input generative rule)
gets modus past particle.
The auxiliary verb {\em have
} is introduced with a omega tense.
               The deixis 
value of the reference adverbial is checked for 
               omega.
               The clause is marked for past superdeixis.
\item[\ \ strategy:] an auxiliary verb is not allowed to the left of {\em have}
. If this is the case this rule will be applicable in the next cycle.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different variable categories for the reference 
adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial, perfective aspect rule \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: This rule has the same semantics as 
Rfinpastsuperdeixis.\\

\item in other languages: \\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be pastdeixis in the case 
this sentence is a sentence with something like {\em graag} in Dutch or an 
auxiliary verb that is semantically a head and treated as a basic expression.\\

\end{enumerate}
\end{description}

