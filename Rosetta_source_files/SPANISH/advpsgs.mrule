\newpage
\begin{verbatim}
%SUBGRAMMAR AdvPformation

RstartADVP0/1
.
RADVPsuperdeixis/2

(* modification rules *)

. [ RADVPdegreemod1/13 | RADVPdegreemod2/14 | RADVPdegreemod3/15 ]

. [ RADVPCOMPARISONcomplmod/14 ] 

. [ TADVPNomCaseAssignment/15 ]

   (* RC_AdvpSubst *)

. { (* RADVPsubst1/6 |*) RADVPsubst2/7}

HEAD:
<
SUBADV FROM (ADVderivation)
>

<(* import *)>

EXPORT:
< ADVP >
&

\newpage
% RULE RstartADVP0
< m1:SUBADV{SUBADVrec1}[mu1] 
>

< m :ADVP{ADVPrec1}
         [ head/ADV{ADVrec1}[head/SUBADV{SUBADVrec1}[mu1]] 
         ]
>


      COMP
         <
          C1: SUBADVrec1.thetaadv = thetaadv100
          A1: ADVrec1 := COPYT_subadvTOadv(SUBADVrec1);
              ADVPrec1 := (*COPYT_advTOadvp(ADVrec1); *)
		  {
		  req           : ADVrec1.req
		  env           : ADVrec1.env
                  Qstatus       : ADVrec1.Qstatus
		  class         : ADVrec1.class
		  tiempo        : ADVrec1.tiempo
		  aspecto       : ADVrec1.aspecto
		  retro         : ADVrec1.retro
		  mood          : ADVrec1.mood
		  thetaadv      : ADVrec1.thetaadv
		  advpatternefs : ADVrec1.advpatterns
		  temporal      : ADVrec1.temporal
                  thanas        : ADVrec1.thanas
		  };

              ADVPrec1.actsubcefs := ADVrec1.subcs    

               (* superlatives intentionally left out *)

               (* supertiempo, thanascompl default value *)
         >

      DECOMP
         <
          C1: SUBADVrec1.thetaadv = thetaadv100       AND
              ADVrec1 = COPYT_subadvTOadv(SUBADVrec1) AND
              ADVPrec1 = (*COPYT_advTOadvp(ADVrec1); *)
		  {
		  req           : ADVrec1.req
		  env           : ADVrec1.env
                  Qstatus       : ADVrec1.Qstatus
		  class         : ADVrec1.class
		  tiempo        : ADVrec1.tiempo
		  aspecto       : ADVrec1.aspecto
		  retro         : ADVrec1.retro
		  mood          : ADVrec1.mood
		  thetaadv      : ADVrec1.thetaadv
		  advpatternefs : ADVrec1.advpatterns
		  temporal      : ADVrec1.temporal
                  thanas        : ADVrec1.thanas
                  actsubcefs    : ADVrec1.subcs
		  }                                 AND

              ADVPrec1.actsubcefs * ADVrec1.subcs <> []       (*!!!!*)
          A1: @
         >
&

\end{verbatim}
