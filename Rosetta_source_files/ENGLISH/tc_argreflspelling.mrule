              NPrec1 = AUX_NPonyouplPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              NPVARrec1 = { person : 2
                            number : plural }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 5. they *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_theyBPRSPRkey){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : plural }
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPontheyPRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = accusative AND
              NPrec1 = AUX_NPontheyPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              NPVARrec1 = { person : 3
                            number : plural }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >



   SUBRULE (* 6. one *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_oneINDEFPROkey){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1.NPhead = oneNP
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              NPrec1 := AUX_NPononeINDFPR;
              PERSPROrec1.persprocase := accusative;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = accusative AND
              NPrec1 = AUX_NPononeINDFPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              NPVARrec1.NPhead = oneNP
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >
>


&

