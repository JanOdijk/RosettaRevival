\begin{verbatim}
% RULE RAdvLocadvVar
< m1: ADVPPROP{ADVPPROPrec1}
               [ mu1,
                 predrel/ADVP{ADVPrec1}[mu2],
                 I4:mu4,
                 I3:mu3 
               ]

  m2: I1::ADVPVAR{ADVPVARrec1}                 
>

< m : ADVPPROP{ADVPPROPrec1}
               [ mu1,
                 predrel/ADVP{ADVPrec1}[mu2],
                 I4:mu4,
                 locadvrel/I1::ADVPVAR{ADVPVARrec1},
                 I5:mu3
               ]
>

   MATCHCONDITIONS
      <
       I1: locadv IN ADVPVARrec1.actsubcefs 
       I3: NOT EXIST (mu3, [locadvrel/..])
       I4: ALL (mu4, locadvrel/..)
       I5: NOT EXIST (mu3, [I51:rel1/..])
         I51: rel1 IN [locadvrel, tempadvrel]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
