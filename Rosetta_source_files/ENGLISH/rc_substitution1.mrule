\begin{verbatim}
% RULE RVarPrepNPsubst               (* NP in VARPREPP in VP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I2:rel1/VARPREPP{VARPREPPrec1}
                             [ mu3,
                               rel2/I1::NPVAR{NPVARrec1}
                             ],
                      mu5  
                    ],
              mu6 
           ] 

  SUBST:
  m2: T3=I3::NP{NPrec1}[I7:mu7]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I2:rel1/PREPP{PREPPrec2}
                             [ mu3,
                               I5:rel2/T4=I4::NP{NPrec2}[I8:mu8]
                             ],
                      mu5  
                    ],
              mu6 
           ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_gsubstordercondition2(mu5, mu6, T3, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T3)
       m : QUOTE_substordercondition2(mu5, mu6, CLAUSErec1.prosubject)
       I1: NPVARrec1.index = LEVEL 
       I2: rel1 IN [prepobjrel, byobjrel, vpadvrel]
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I4: NOT ( NPrec2.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I5: NOT QUOTE_NegPhrase(T4)
       I7: NOT EXIST (mu7, [head/BIGPRO{}[mu10]])
       I8: NOT EXIST (mu8, [head/BIGPRO{}[mu11]])
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_NPtoVAR(NPrec1) 
                                   EXCEPT FOR [cases] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric
            C11: CLAUSErec1.deixis = omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.superdeixis
            A11: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases)
            C12: CLAUSErec1.deixis <> omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.deixis
            A12: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases)
          A1: NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              PREPPrec2 := VARPREPPrec1
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
            C11: CLAUSErec1.deixis = omegadeixis
            A11: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []);
                 NPrec1.superdeixis := CLAUSErec1.superdeixis
            C12: CLAUSErec1.deixis <> omegadeixis
            A12: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []);
                 NPrec1.superdeixis := CLAUSErec1.deixis
          A1: NPVARrec1 := COPYT_NPtoVAR(NPrec2);
              (* including cases *)
              NPVARrec1 := { index   : LEVEL
                             generic : nogeneric };
              NPrec1.generic := nogeneric;
              VARPREPPrec1 := PREPPrec2
         >
&
\end{verbatim}
