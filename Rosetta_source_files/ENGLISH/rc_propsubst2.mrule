                 predrel/VERBP{VERBPrec2}
                        [ I5:mu5,
                          auxrel/I2::VERB{VERBrec1}[mu2],
                          I6:mu6,
                          head/VERB{VERBrec2}[mu3],
                          mu8
                        ],
                 I9:mu9,
                 I7:mu7,
                 I20:sig2
               ]
>

(* \end{verbatim}
   \newpage
   \begin{verbatim} *)

   MATCHCONDITIONS
      <
       I1: ALL (mu1, I11:rel1/..)
           I11: rel1 IN AUX_preauxAdvRels OR
                rel1 IN AUX_postauxAdvRels
       I2: VERBrec1 = { subc    : modalverb
                        thetavp : vp010 }
       I3: ALL (sig1, shiftrel/..)
       I4: T1.CAT IN [NPVAR, CNVAR, NP]
       I5: ALL (mu5, I51:rel5/..)
           I51: rel5 IN AUX_beginVPAdvRels
       I6: ALL (mu6, I61:rel6/T4)
           I61: rel6 IN [passauxrel, progauxrel] OR
                ( rel6 = auxrel AND (T4.CAT IN [VERB] WITH
                                T4.REC.subc = haveVerb ))
       I7: ALL (mu7, I71:rel7/T5) AND
           QUOTE_tempdurnotfound(mu7) 
           I71: T5.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR] AND
                rel7 IN AUX_postVPAdvRels
       I9: ALL (mu9, I91:rel9/T3)
           I91: rel9 IN AUX_postVPAdvRels AND
                NOT T3.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
                (* they must not be VARs anymore *)
      I10: SENTENCEVARrec1.index = LEVEL
      I12: ALL (sig3, negrel/..)
      I20: ALL (sig2, extraposrel/SENTENCE{SENTENCErec2}[mu20])
      I40: ALL (mu4, leftdislocrel/..)
      >

   PARAMETERS
      <
       LEVEL
      >

(* \end{verbatim}
   \newpage
   \begin{verbatim} *)

      COMP
         <
          C1: SENTENCEVARrec1 = COPYT_sentenceTOvar(SENTENCErec1)
              AND
              SENTENCErec1 = SENTENCErecdef EXCEPT FOR
                 [mood, senttype, PROsubject, modus, deixis, finiteness, 
                  infsort, superdeixis, conjkey, synvpefs, thetavp, 
                  voice, aktionsarts] 
              AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  PROsubject  : false
                                  modus       : infinitive
                                  deixis      : omegadeixis
                                  finiteness  : infinite
                                  infsort     : inf
                                  conjkey     : 0 }
              (* req and env are assumed default; no test on voice, 
                 synvpefs, thetavp and superdeixis, because they may 
                 have all values *)
              AND
              QUOTE_checkAktarts(VERBrec2.classes,
                                 SENTENCEVARrec1.aktionsarts) AND
              VERBPPROPrec1 = { thetavp : VERBrec1.thetavp
                                voice   : active  }    
              AND
              VERBPPROPrec1.synvpefs * VERBrec1.synvps 
                                     * AUX_closedInfComplVps <> []


          A1: VERBPPROPrec2 := VERBPPROPrec1;
              (* req, env, PROsubject are still default;
                 aktionsarts is not *)
              VERBPPROPrec2 := { voice       : SENTENCErec1.voice
                                 synvpefs    : SENTENCErec1.synvpefs
                                 adjuncts    : SENTENCErec1.adjuncts
                                 thetavp     : SENTENCErec1.thetavp  
                                 superdeixis : SENTENCErec1.superdeixis}
         >

(* \end{verbatim}
   \newpage
   \begin{verbatim} *)

      DECOMP
         <
          C1: VERBrec1.synvps * AUX_closedInfComplVps <> []
              (* voice of VERBPPROPrec2 may be active or passive;
                 superdeixis may have all values  *)

          A1: VERBPPROPrec1 := VERBPPROPrec2;
              (* including aktionsarts, which have been calculated 
                 in the SP on basis of the modal *)
              VERBPPROPrec1 := { voice   : active
                                 thetavp : VERBrec1.thetavp 
                                 adjuncts : VERBrec1.adjuncts
                                 superdeixis : omegadeixis };
              VERBPPROPrec1.synvpefs := 
                VERBrec1.synvps * AUX_closedInfComplVps ;
              SENTENCErec1 := { voice       : VERBPPROPrec2.voice
                                synvpefs    : VERBPPROPrec2.synvpefs
                                adjuncts    : VERBPPROPrec2.adjuncts
                                thetavp     : VERBPPROPrec2.thetavp
                                mood        : declarative
                                senttype    : subordinateclause
                                PROsubject  : false
                                modus       : infinitive
                                deixis      : omegadeixis
                                finiteness  : infinite
                                infsort     : inf
                                superdeixis : VERBPPROPrec2.superdeixis
                                conjkey     : 0 };
                   (* rest of attributes, including req and env 
                      remain default *)
              QUOTE_AssignAktarts(VERBrec2.classes,
                                  SENTENCErec1.aktionsarts);
              SENTENCEVARrec1 := { voice       : VERBPPROPrec2.voice
                                   synvpefs    : VERBPPROPrec2.synvpefs
                                   adjuncts    : VERBPPROPrec2.adjuncts
                                   thetavp     : VERBPPROPrec2.thetavp
                                   mood        : declarative
                                   senttype    : subordinateclause
                                   PROsubject  : false
                                   modus       : infinitive
                                   deixis      : omegadeixis
                                   finiteness  : infinite
                                   infsort     : inf
                                   superdeixis : VERBPPROPrec2.superdeixis
                                   conjkey     : 0 
                                   index       : LEVEL
                                 };
                   (* rest of attributes, including req and env 
                      remain default *)
              QUOTE_AssignAktarts(VERBrec2.classes,
                                  SENTENCEVARrec1.aktionsarts)
         >

&

