\newpage
\begin{verbatim}
% RULE RShiftNPsubst                       (* shifted NP in S *)
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              shiftrel/I1::NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4
            ] 

  SUBST:
  m2: T3=I3::NP{NPrec1}[I5:mu5]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I7:shiftrel/T4=I4::NP{NPrec2}[I6:mu6],
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4
            ] 
>

   MATCHCONDITIONS
      <
       m1: ALL
       m2: ALL
           NOT QUOTE_NegPhrase(T3) AND
           QUOTE_gsubstordercondition(mu2, mu3, mu4, T3, CLAUSErec1.prosubject) 
       m : ALL
           QUOTE_substordercondition(mu2, mu3, mu4, CLAUSErec1.prosubject)
       I1: NPVARrec1.index = LEVEL
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I4: NOT ( NPrec2.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I5: NOT EXIST (mu5, [head/BIGPRO{}[mu10]])
       I6: NOT EXIST (mu6, [head/BIGPRO{}[mu11]])
       I7: NOT QUOTE_NegPhrase(T4)
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_NPtoVAR(NPrec1) 
                                   EXCEPT FOR [cases, mood] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric AND
              NPrec1.class <> frequential AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              NPrec1.superdeixis)
            C11: NPVARrec1.mood = topicmood AND
                 NPrec1.mood = nowh
            A11: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases)
            C12: NPVARrec1.mood = wh AND
                 NPrec1.mood = wh
            A12: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases)
          A1: NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis AND
              NPrec2.class <> frequential 
            C11: NPrec2.mood = nowh
            A11: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []);
                 NPVARrec1 := COPYT_NPtoVAR(NPrec2);
                 NPVARrec1.mood := topicmood
            C12: NPrec2.mood = wh
            A12: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []);
                 NPVARrec1 := COPYT_NPtoVAR(NPrec2);
          A1: QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 NPrec1.superdeixis);
              NPVARrec1 := { index   : LEVEL
                             generic : nogeneric };
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
