SPANISH 73
&
\begin{verbatim}
%
% TRANSFORMATION TNPCNdeletion1    (*  countENkey*)
                                   (* Als deze regel geordend is na RNPmodADV
                                     dan twee regels nodig *)

< m1: NP{NPrec1}[detrel/DETP{DETPrec1}[head/DET{DETrec1}[mu4]],
                 head/CN{CNrec1}
                         [head/EN(KEY_countENkey){ENrec1}
                         ],
                 I1:mu1
                ]
>

< m : NP{NPrec1}[detrel/DETP{DETPrec1}[head/DET{DETrec1}[mu4]],
                 I1:mu1
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [head/CN{CNrec2}[mu3]])
      >

      COMP
         <
          C1: count IN NPrec1.actcomas AND
              NPrec1.NPhead = enNP AND
              NPrec1.numero = plural AND
              CNrec1 = CNrecdef EXCEPT FOR [numero, posscomas, generos] AND
              CNrec1.numero  = plural AND
              count IN CNrec1.posscomas
            C11: NPrec1.genero = masc AND
                 CNrec1 = {
                            numero : plural
                            generos: [masc]
                            posscomas : [count]
                           }
            A11: @
            C12: NPrec1.genero = fem  AND
                 CNrec1 = {
                            numero : plural
                            generos: [fem]
                            posscomas : [count]
                           }
            A12: @
          A1: @
         >
      DECOMP
         <
          C1: count IN NPrec1.actcomas AND
              NPrec1.NPhead = enNP AND
              NPrec1.numero = plural
            C11: NPrec1.genero = masc  
            A11: CNrec1 := CNrecdef;
                 CNrec1 := {
                            numero : plural
                            generos: [masc]
                            posscomas : [count]
                                
                           }
            C12: NPrec1.genero = fem 
            A12: CNrec1 := CNrecdef;
                 CNrec1 := {
                            numero : plural
                            generos: [fem]
                            posscomas : [count]
                           }
         A1: @
         >


&

\end{verbatim}
