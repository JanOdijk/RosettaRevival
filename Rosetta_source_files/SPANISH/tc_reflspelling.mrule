\newpage
\begin{verbatim}
%TRANSFORMATION TreflCLOSEDCAT1a (* reflexive, subject antecedent, NPVAR *)


< m1:VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                      [ mu11,
                        head/I1::VERB{VERBrec1}[mu3],
                        cliticrel/CLITIC{CLITICrec1}[mu4],
                        I6:rel1/I7::N1 [ I2:subjrel/T1,
                                         mu8
                                       ],
                        mu2
                      ],
                mu6
              ]
>

< m :VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                      [ mu11,
                        head/I1::VERB{VERBrec1}[mu3],
                        cliticrel/CLITIC{CLITICrec1}[mu5],
                        I6:rel1/I7::N1 [ I2:subjrel/T1,
                                         mu8
                                       ],
                        mu2
                      ],
                mu6
              ]
>


   MATCHCONDITIONS
      <
       I1: VERBrec1.reflexivity = reflexive
       I2: T1.CAT IN [NP, NPVAR]
       I6: rel1 IN [complrel, locargrel, dirargrel]
       I7: N1.CAT IN [CLOSEDADJPPROP, CLOSEDNPPROP, CLOSEDPREPPPROP]
      >
<
   SUBRULE (*Me*)
      < mu4: [I3: mu7]>
      < mu5: [rel2/REFLPRO(AUX_Mereflprokey){REFLPROrec1}[],mu7]>

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [I31: rel3/..])
       I31: rel3 IN [unoclrel, dosclrel]
      >

      COMP
         <
          C1: (T1.REC.numero = singular) AND
              (T1.REC.persona = 1)
          A1: rel2 := unoclrel;
         >


   SUBRULE (*Te*)
      < mu4: [I3: mu7]>
      < mu5: [rel2/REFLPRO(AUX_Tereflprokey){REFLPROrec1}[],mu7]>

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [dosclrel/..])
      >

      COMP
         <
          C1: (T1.REC.persona = 2) AND
              (T1.REC.numero = singular)
          A1: rel2 := dosclrel;
         >


   SUBRULE (*Se*)
      < mu4: [I3: mu7] >
      < mu5: [rel2/REFLPRO(AUX_Sereflprokey){REFLPROrec1},mu7]>

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [seclrel/..])
      >

      COMP
         <
          C1: T1.REC.persona = 3
          A1: rel2 := seclrel;
         >


   SUBRULE (*Nos*)
      < mu4: [I3: mu7]>
      < mu5: [rel2/REFLPRO(AUX_Nosreflprokey){REFLPROrec1}[],mu7]>

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [I31: rel3/..])
       I31: rel3 IN [unoclrel, dosclrel]
      >

      COMP
         <
          C1: (T1.REC.numero = plural) AND
              (T1.REC.persona = 1)
          A1: rel2 := unoclrel;
         >


   SUBRULE (*Os*)
      < mu4: [I3: mu7]>
      < mu5: [rel2/REFLPRO(AUX_Osreflprokey){REFLPROrec1}[],mu7]>

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu7, [dosclrel/..])
      >

      COMP
         <
          C1: (T1.REC.numero = plural) AND
              (T1.REC.persona = 2)
          A1: rel2 := dosclrel;
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* language:] Spanish
\item[* name:] TreflCLOSEDCAT1a
\item[* kind of rule:] M-rule
