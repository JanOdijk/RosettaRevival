                          APPENDSETS(%LD.SigmaVarList,SigmaVarList);
                          APPENDSETS(%LD.TreeVarList,TreeVarList);
                          APPENDSETS(%LD.NodeVarList,NodeVarList);
                          APPENDSETS(%LD.RelVarList,RelVarList);
