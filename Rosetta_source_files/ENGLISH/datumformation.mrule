\newpage
\begin{verbatim}
% RULE RMonthToNP
< m1:PROPERNOUN{PROPERNOUNrec1}[mu1] 
>

< m :NP{NPrec1}
         [head/PROPERNOUN{PROPERNOUNrec1}[mu1]]
>
         PARAMETERS
      <
       superpar :deixistype
      >
     COMP
         <
          C1:PROPERNOUNrec1.subc = monthnoun
          A1:NPrec1 := NPrecdef;
             NPrec1 :=
                      {   
                       superdeixis:      superpar
                       class:            PROPERNOUNrec1.class
                       deixis:           PROPERNOUNrec1.deixis
                       aspect:           PROPERNOUNrec1.aspect
                       retro:            PROPERNOUNrec1.retro
                       definite:         def   
                       genders:          PROPERNOUNrec1.genders
                       sexes:            PROPERNOUNrec1.sexes
                       actsubcs:         [PROPERNOUNrec1.subc]
                       temporal:         PROPERNOUNrec1.temporal
                       poss:             PROPERNOUNrec1.poss
                       animate:          PROPERNOUNrec1.animate
                       human:            PROPERNOUNrec1.human
                       generic:          nogeneric
                       posspred:         true
                       specQ:            yesspec
                      }
         >
      DECOMP
         <
          C1:PROPERNOUNrec1.subc = monthnoun AND
             NPrec1 = NPrecdef EXCEPT FOR [class, deixis, aspect, retro,
                      definite, genders, sexes, actsubcs, temporal, poss,
                      animate, human, generic, posspred, specQ] 
             AND
             NPrec1 =
                      {   
                       class:            PROPERNOUNrec1.class
                       deixis:           PROPERNOUNrec1.deixis
                       aspect:           PROPERNOUNrec1.aspect
                       retro:            PROPERNOUNrec1.retro
                       definite:         def   
                       genders:          PROPERNOUNrec1.genders
                       sexes:            PROPERNOUNrec1.sexes
                       actsubcs:         [PROPERNOUNrec1.subc]
                       temporal:         PROPERNOUNrec1.temporal
                       poss:             PROPERNOUNrec1.poss
                       animate:          PROPERNOUNrec1.animate
                       human:            PROPERNOUNrec1.human
                       generic:          nogeneric
                       posspred:         true
                       specQ:            yesspec
                      }
          A1:superpar := NPrec1.superdeixis;
         >

&

\end{verbatim}
