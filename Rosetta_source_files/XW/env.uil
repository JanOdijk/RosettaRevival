object env_separator1 : XmSeparator {
    arguments {
        XmNtopAttachment    = XmATTACH_FORM;
        XmNleftAttachment   = XmATTACH_WIDGET;
        XmNleftWidget       = XmForm env_lang_form;
	XmNbottomAttachment = XmATTACH_WIDGET;
	XmNbottomWidget     = XmSeparator env_separator;

        XmNorientation      = XmVERTICAL;
        XmNbottomOffset     = 0;
        XmNtopOffset        = 0;
    };
};

