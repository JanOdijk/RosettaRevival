\newpage
\begin{verbatim}
%
% TRANSFORMATION TnoComplSent
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}[I1:mu2],
              mu3 
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}[I1:mu2],
              mu3 
            ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [ complrel/SENTENCE{SENTENCErec1}[mu4] ])
      >
      COMP
         <
          C1:true
          A1:@
         >

      DECOMP
         <
          C1:true
          A1:@
         >
&

\end{verbatim}
