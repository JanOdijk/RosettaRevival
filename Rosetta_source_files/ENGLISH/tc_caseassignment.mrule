\newpage
\begin{verbatim}
% TRANSFORMATION TxppObjCaseAssign
< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     predrel/I4::N1
                        [ mu3,
                          I2:rel1/T1,
                          mu4 
                        ],
                     mu5 
                   ],
             mu6  
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     predrel/I4::N1
                        [ mu3,
                          I3:rel1/T2,
                          mu4 
                        ],
                     mu5 
                   ],
             mu6  
           ]
>


   MATCHCONDITIONS
      <
       I1: synBE IN CLAUSErec1.synvpefs
       I2: rel1 IN [objrel, indobjrel] AND
           (T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [])
       I3: rel1 IN [objrel, indobjrel] AND
           (T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases )
       I4: N1.CAT IN [ADJP, PREPP, NP, ADVP]
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} >
      < T2:NPVAR{NPVARrec2} >

      COMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Accusative];
         >

      DECOMP
         <
          C1: Accusative IN NPVARrec2.cases
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [];
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1} >
      < T2:CNVAR{CNVARrec2} >

      COMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Accusative];
         >

      DECOMP
         <
          C1: Accusative IN CNVARrec2.cases
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [];
         >

   SUBRULE (* 3. NP *)
      < T1:NP{NPrec1}[mu7] >
      < T2:NP{NPrec2}[mu8] >

      COMP
         <
          C1: true
          A1: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, [Accusative]);
         >

      DECOMP
         <
          C1: Accusative IN NPrec2.cases
          A1: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []);
         >

>
&

\end{verbatim}
