%PASCALSTATEMENT
BASIS RULE
      PASCALSTATEMENT = (VARNAME/2.DOTDOT/1.ISCAT/10.[ROUNDOPEN/18].
                         (VALUENAME/3|SETVALUENAME/4|VARNAME/5).
                         {(STARCAT/6|PLUSCAT/9|MINCAT/21).[ROUNDOPEN/18].
                          (SETVALUENAME/7|VARNAME/8).[ROUNDCLOSE/15]
                         }
                        |QUOTEASSIGN|SEMILEX|IDLEX)
    IDLEX = (KEYNAME/32.DOTDOT/11.ISCAT/11.
              DECOMPGETIDDICT/11.ROUNDOPEN/11.
              LEFTARROW/11.KEYNAME/25.{COMMA/11.KEYNAME/25}.RIGHTARROW/28
               .COMMA/19.IDENTIFIER/26
              .ROUNDCLOSE/30
             |LEFTARROW/11.KEYNAME/27.{COMMA/11.KEYNAME/27}.RIGHTARROW/29.
              DOTDOT/1.ISCAT/10.
              COMPGETIDDICT/23.ROUNDOPEN/18.KEYNAME/22.COMMA/19.IDENTIFIER/26
              .ROUNDCLOSE/31
            )
    SEMILEX = KEYNAME/22.DOTDOT/1.ISCAT/10.
              (COMPGETSIDDICT/23|DECOMPGETSIDDICT/23).ROUNDOPEN/18.
                   KEYNAME/22.COMMA/19.KEYNAME/22.COMMA/19.IDENTIFIER/13
              .ROUNDCLOSE/15
    QUOTEASSIGN = QUOTE/11.UNDERSCORE/11.IDENTIFIER/12.
               [ROUNDOPEN/18.
                 (IDENTIFIER/13|((AUX/20|KEYtje/24).UNDERSCORE/11.IDENTIFIER/13)|
                  (IDENTIFIER/13.DOT/14.IDENTIFIER/13)|
                  (SQUAREOPEN/16.[IDENTIFIER/13.{COMMA/19.IDENTIFIER/13}].SQUARECLOSE/17)
                 )
                .
                {COMMA/19.
                 (IDENTIFIER/13|((AUX/20|KEYtje/24).UNDERSCORE/11.IDENTIFIER/13)|
                  (IDENTIFIER/13.DOT/14.IDENTIFIER/13)|
                  (SQUAREOPEN/16.[IDENTIFIER/13.{COMMA/19.IDENTIFIER/13}].SQUARECLOSE/17)
                 )
                }.ROUNDCLOSE/15
               ]

SURFACE PART
VAR haakjescounter::int;

<*
INIT: BEGIN haakjescounter:=0 END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
