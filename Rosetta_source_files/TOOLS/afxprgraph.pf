pragma C_include ('afxprlangspec.pf');
pragma C_include ('afxprdecl.pf');

PACKAGE afxprGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH afxprDECL,
     afxprLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: afxprLANGSPEC_Category;
                          b: afxprDECL_nodeid): afxprDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: afxprDECL_psurfgraph): afxprDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: afxprDECL_psurfgraph): afxprDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: afxprDECL_psurfgraph): afxprDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: afxprDECL_psurfgraph): afxprDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: afxprLANGSPEC_Category; 
                          c: afxprDECL_psurfgraph); EXTERNAL;
 
END {afxprGRAPH};
