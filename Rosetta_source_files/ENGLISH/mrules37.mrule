ENGLISH 37
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Tfinite1
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    I1: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    I1: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
             mu5
            ]
>
   MATCHCONDITIONS
      <
       I1: rel1 IN [auxrel, progauxrel, passauxrel] AND
           VERBrec1.subc <> doaux
      >


      COMP
         <
          C1: CLAUSErec1.finiteness = omegafin
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.finiteness := finite;
         >
      DECOMP
         <
          C1: CLAUSErec2.finiteness = finite
          A1: CLAUSErec1 :=  CLAUSErec2;
              CLAUSErec1.finiteness := omegafin;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Tfinite1
\item[* relevant examples:]
CL(.......can work) (aux),
CL(.......will work) (aux),
CL(.......have worked) (aux),
CL(.......be hit) (passaux),
CL(.......be working) (progaux),
*CL(.......work) (head),
*CL(.......have a book) (head),
*CL(.......be ill) (head)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] finiteness transformations
\item[* date of creation:] 25-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Tfinite Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 09/01/91\ \ \ \ \ author: Lisette Appelo\\
added condition that verb is not {\em do}
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Mark the clause for finite in case of modal auxiliaries, passive 
and progressive {\em be} and the auxiliary {\em have}. They will not be 
preceded by the auxiliary {\em do}.
\item[\ \ strategy:] It is assumed that the match is left to right.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: VERBleft for the first VERB in the VP after the deixis rules.\\

\end{enumerate}
\item[\ \ consequences in the grammar:] Both the finite and infinite 
transformation are always applicable, which will result in  (temporary)
paraphrases in generation
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION Tfinite2
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I2: mu2,
                    head/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I2: mu2,
                    auxrel/VERB{VERBrec2}
                          [head/SUBVERB{SUBVERBrec1}
                               [head/BVERB(AUX_dobverbkey){BVERBrec1}]
                          ],
                    head/VERB{VERBrec3}[mu3],
                    mu4
                   ],
             mu5
            ]
>
   MATCHCONDITIONS
      <
       I2: NOT EXIST (mu2, [I3: rel2/..])
       I3: rel2 IN [auxrel, progauxrel, passauxrel] 
     >


      COMP
         <
          C1: (CLAUSErec1.finiteness = omegafin) AND
              (VERBrec1.modus = omegamodus)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.finiteness := finite;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec2 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values default values *)
              VERBrec3 := VERBrec1;
              VERBrec3.modus := infinitive;
         >
      DECOMP
         <
          C1: (CLAUSErec2.finiteness = finite) AND
              (VERBrec3.modus = infinitive) AND
              (VERBrec2 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec2 =
               {
                 numbers   : []
                 persons   : []
                 modus     : omegamodus
                 tense     : omegatense
               }
              )
              (* other values default values *)
          A1: CLAUSErec1 :=  CLAUSErec2;
              CLAUSErec1.finiteness := omegafin;
              VERBrec1 := VERBrec3;
              VERBrec1.modus := omegamodus;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Tfinite2
\item[* relevant examples:]
*CL(.......do can work) (aux),
*CL(.......do will work) (aux),
*CL(.......do have worked) (aux),
*CL(.......do be hit) (passaux),
*CL(.......do be working) (progaux),
CL(.......do work) (head),
CL(.......do have a book) (head),
CL(.......do be ill) (head)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] finiteness transformations
\item[* date of creation:] 25-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Tfinite1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Mark the clause for finite in case a main verb is the most 
left verb in the VP (has the relation {\em head} and not preceded by {\em be, 
have, do} or modals). It will be 
preceded by the auxiliary {\em do} which is inserted here.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: VERBleft for the first VERB in the VP after the deixis rules.\\

\end{enumerate}
\item[\ \ consequences in the grammar:] Both the finite and infinite 
transformation are always applicable, which will result in  (temporary)
paraphrases in generation
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems: The {\em do} that is inserted here for the main verbs {\em have 
}, {\em do} and {\em be} should be deleted elsewhere in some cases (VERBleft?)\\

\item modifications:\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% TRANSFORMATION Tinfinite
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                I1:[mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
               I1: [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
             mu5
            ]
>
   MATCHCONDITIONS
      <
       I1: VERBrec1.subc <> modalverb AND
           (VERBrec1.subc = haveverb ->
            NOT EXIST (mu4,[auxrel/T1]))
      >

      COMP
         <
          C1: (CLAUSErec1.finiteness = omegafin) 
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.finiteness := infinite;
         >

      DECOMP
         <
          C1: CLAUSErec2.finiteness = infinite
          A1: CLAUSErec1 := CLAUSErec2;     
              CLAUSErec1.finiteness := omegafin;
         >

&

\end{verbatim}

