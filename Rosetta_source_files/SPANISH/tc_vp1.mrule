\begin{description}
\item[* name:] TVerbpattern1
\item[* relevant examples:]
\begin{description}
   \item[subrule 1] \'{E}l pega a Juanita; Pedro ven\'{\i}a
   \item[subrule 2] Pedro come (x2) ($\rightarrow$ Pedro come)
   \item[subrule 3] x1 considera [Pedro el mejor presidente]; 
    salir [x1 un c\'{e}lebre m\'{e}dico] 
   \item[subrule 4] yo considero [Juan inteligente]; quedar(se) [Pedro ciego]
   \item[subrule 5] esto es (= smaakt) rico
   \item[subrule 6] esto cuesta cinco florines
   \item[subrule 7] <empty> parece que est\'{a} enfermo
   \item[subrule 8] (ik [hem uit de box] kreeg) \\
                    (ik [hem daar] kreeg). No example found yet.
   \item[subrule 9] (ik [hem de box uit] kreeg) (In Sp. always a preposition!) 
   \item[subrule 10] x1 vive [ x1 en Amsterdam]
   \item[subrule 11] x1 entra [ x1 por la puerta]; 
   \item[subrule 12] x1 tiene [los labios pintados]
   \item[subrule 13a] x1 quiere [x1 venir]
   \item[subrule 13b] x1 tiene [que x1 venir]
   \item[subrule 13c] x1 hay [que x1 venir]
   \item[subrule 14] x1 ve [Pedro venir]
   \item[subrule 15] x1 lamenta [el tener que partir]
   \item[subrule 16] x1 lamenta [el que tenga que partir]
   \item[subrule 17] x1 huele bien
   \item[subrule 18] x1 dijo [que ven\'{\i}a]
   \item[subrule 19] x1 sabe [si pod\'{\i}a venir]\\
                     x1 sabe [qu\'{e} deb\'{\i}a hacer] 
   \item[subrule 22] yo me lo pregunto (PROSENT spelled out as {\em lo})
   \item[subrule 23] llevar [x1 trabajando por tres horas];
   \item[subrule 24] caer [esto en desuso]; caer [esto ADVP??]
\end{description}
