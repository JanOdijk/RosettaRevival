\begin{verbatim}
% TRANSFORMATION TNPENdeletion1   (* count EN *) 
                                  (* Als deze regel geordend is na RNPmodADV
                                     dan twee regels nodig *)
< m1: NP{NPrec1}[I1:mu1,
                 head/CN{CNrec1}
                      I5:[I2:mu2,
                          head/EN(KEY_countENkey){ENrec1},  
                          I3:mu3
                         ],
                 mu4
                ]
>

< m : NP{NPrec1}[I1:mu1,
                 head/CN{CNrec1}
                      I5:[I2:mu2,
                          I3:mu3
                         ],
                 mu4
                ]
>
   MATCHCONDITIONS
      <
       I1: ALL(mu1, I11:rel1/..)
       I11: rel1 IN [detrel, artrel]
       I2: ALL(mu2, modrel/..)
       I3: ALL(mu3, I13:rel3/T1)
       I13: (rel3 IN [postmodrel, posrel, modrel]) AND
            ((T1.CAT IN [PREPP, ADJP]) OR
            (T1.CAT IN [SENTENCE] WITH T1.REC.mood =relative))
            
       I5: mu2 <> [] OR mu3 <> []
      >


      COMP
         <
          C1: count IN NPrec1.actcomas
          A1: @
         >
      DECOMP
         <
          C1: count IN NPrec1.actcomas
          A1: @
         >

&

\end{verbatim}
