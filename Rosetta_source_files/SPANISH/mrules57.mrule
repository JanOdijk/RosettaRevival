\newpage
\begin{verbatim}
% TRANSFORMATION Tsuperdeixisadaptation4
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    prepobjrel/I3::N1
                              [mu5,
                               I1: rel1/T1,
                               mu6], 
                    mu3
                   ],
            mu4
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2, 
                    prepobjrel/I3::N1
                              [mu5,
                               I2: rel1/T2,
                               mu6], 
                    mu3
                   ],
            mu4
           ]

>
   MATCHCONDITIONS
      <
       I1: (T1.CAT IN [OPENADJPPROP, CLOSEDADJPPROP, OPENPREPPPROP, 
                      CLOSEDPREPPPROP, OPENNPPROP, CLOSEDNPPROP,
                      OPENADVPPROP, CLOSEDADVPPROP])
            AND
           (rel1 IN [objrel, complrel])
       I2: (T2.CAT IN [OPENADJPPROP, CLOSEDADJPPROP, OPENPREPPPROP, 
                      CLOSEDPREPPPROP, OPENNPPROP, CLOSEDNPPROP,
                      OPENADVPPROP, CLOSEDADVPPROP])
            AND
           (rel1 IN [objrel, complrel])
       I3: N1.CAT IN [PREPP, VARPREPP]
      >

<
   SUBRULE (* 1 *)
      < T1: OPENADJPPROP{OPENADJPPROPrec1}[mu7] >
      < T2: OPENADJPPROP{OPENADJPPROPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (OPENADJPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: OPENADJPPROPrec2 := OPENADJPPROPrec1;
                  OPENADJPPROPrec2.supertiempo := omegatiempo;

             C12:(OPENADJPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
