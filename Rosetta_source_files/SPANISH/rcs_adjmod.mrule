                                     [mu2,
                                      degreemodrel/ADVP{ADVPrec1}[head/T3],
                                      head/T1,
                                      mu4,
                                      I2:paramodrel/SENTENCE{SENTENCErec2}[mu5]
                                     ]
                            ]
>
   MATCHCONDITIONS
      <
       I1: SENTENCErec1.infsort = parainf
       I2: SENTENCErec2.infsort = parainf
      >


      COMP
         <
          C1: SENTENCErec1.supertiempo = omegatiempo
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := ADVPrec1.mood;  (* m.h.o. op een WH-ADVP *)
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.supertiempo := ADVPrec1.supertiempo;
