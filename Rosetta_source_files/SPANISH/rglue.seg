*u(MED1)(MED2)(MED3)an+(B)+(A3) :: *ú(MED1)(MED2)(MED3)an(B)(A3) ;



{ 3rd person pl. ending on -en; celébrenmelo }


*a(OE)(MED1)(UU)en+(B)+(A3) :: *á(OE)(MED1)(UU)en(B)(A3) ;

*e(OE)(MED1)(UU)en+(B)+(A3) :: *é(OE)(MED1)(UU)en(B)(A3) ;

*o(OE)(MED1)(UU)en+(B)+(A3) :: *ó(OE)(MED1)(UU)en(B)(A3) ;


*a(OE)(MED1)(MED2)(UU)en+(B)+(A3) :: *á(OE)(MED1)(MED2)(UU)en(B)(A3) ;

*e(OE)(MED1)(MED2)(UU)en+(B)+(A3) :: *é(OE)(MED1)(MED2)(UU)en(B)(A3) ;

