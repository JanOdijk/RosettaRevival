\begin{verbatim}
% RULE RAgVPAdvObj    
< SUBST:
  m1: CLAUSE{CLAUSErec1} 
               [ I1:mu1,
                 predrel/VERBP{VERBPrec1}
                        [ mu2,
                          objrel/T1, 
                          I3:mu3 
                        ],
                 mu4
               ]

  m2: OPENADVPPROP{OPENADVPPROPrec1}
                  [ subjrel/T2,
                    predrel/I2::ADVP{ADVPrec1}
                           [ mu5,
                             head/ADV{ADVrec1}[mu6],
                             complrel/CLAUSEVAR{CLAUSEVARrec1},
                             mu7
                           ] 
                  ]
>

< m : CLAUSE{CLAUSErec1}          
               [ I1:mu1,
                 predrel/VERBP{VERBPrec1}
                        [ mu2,
                          objrel/T1, 
                          I3:mu3,
                          agvpadvrel/I2::ADVP{ADVPrec1}
                                    [ mu5,
                                      head/ADV{ADVrec1}[mu6],
                                      mu7
                                    ]
                        ],
                 mu4
               ]
 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [subjrel/..])
       I2: agvpadv IN ADVPrec1.actsubcefs
       I3: NOT EXIST (mu3, [byobjrel/..])    
      >

   PARAMETERS
      <
       LEVEL
      >

(* 
\end{verbatim}
