\newpage
\begin{verbatim}
% RULE RuttNp
< m1:T1=NP{NPrec1}[mu1] 
>

< m :UTT{UTTrec1}[head/NP{NPrec2}[mu2] ]
>


   PARAMETERS
      <
       casespar : caseSETtype
      >


      COMP
         <
          C1: NPrec1.generic = nogeneric AND
              NPrec1.cases = [] AND
              ( casespar = [nominative] OR
                casespar = [dative] OR
                casespar = [accusative] )      AND
              (NOT QUOTE_varsintree(T1))
          A1: NPrec2.generic := omegageneric;
              QUOTE_AssignCase(NPrec1, mu1, NPrec2, mu2, casespar);
         >

      DECOMP
         <
          C1: NPrec2.generic = omegageneric 
            C11: nominative IN NPrec2.cases
            A11: casespar := [nominative]
            C12: dative IN NPrec2.cases AND
                 NPrec2.cases * [nominative] = []
            A12: casespar := [dative]
            C13: accusative IN NPrec2.cases AND
                 NPrec2.cases * [nominative] = []
            A13: casespar := [accusative]
          A1: QUOTE_AssignCase(NPrec2, mu2, NPrec1, mu1, []);
              NPrec1.generic := nogeneric;
              NPrec1.supertiempo := presente
         >
&

\end{verbatim}
