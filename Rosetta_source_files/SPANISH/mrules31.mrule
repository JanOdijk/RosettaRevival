SPANISH 31
&
%
% TRANSFORMATION TIdVerbpattern
< m1: I1::VERBPPROP{VERBPPROPrec1}[mu1]
>

< m : I1::VERBPPROP{VERBPPROPrec1}[mu1]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs <> []
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TIdVerbpattern
\item[* relevant examples:] Every idiom
\item[* language:] (Dutch, English, Spanish) Spanish
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] (name of rule, transformation or filter class) TC: 
Verbpatternrules
\item[* date of creation:] 11-OCT-1988 16:08:05  
\item[* author:] Andr\'{e} Schenk
\item[* copied from:] English:idem
\item[*modification:]\mbox{}
\begin{enumerate}
\item date: 
\item date: 01/11/88\ \ \ \ \ author: Elly van Munster
\end{enumerate}
\item[* task:] to let VERBPPROPs pass the
verbpattern transformations without conditions on the status of the arguments, 
such that NPs and PPs also pass and not only VARs
\item[\ \ strategy:] (also: deviations from accepted proposals) this rule only 
works for VERBPPROPs that have received a verbpattern in the (idiom) startrules
. In analysis, all VERBPPROPs are allowed for the moment.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] dna
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:]dna
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\
Attribute "infsort" added.
\end{enumerate}
\end{description}
\newpage
\begin{verbatim}
% TRANSFORMATION TVerbpattern3
< m1: VERBPPROP{VERBPPROPrec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                         [ head/VERB{VERBrec1}[mu2],
                           argrel/T1
                         ] 
               ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
		         [ head/VERB{VERBrec1}[mu2],
                           prepobjrel/VARPREPP{VARPREPPrec1}
		                 [ head/PREP(VERBrec1.prepkey1){PREPrec1}, 
			           objrel/T1
		                 ]
		         ] 
	       ]
>


<
   (* Mira [a la chica] (vp120); Llueve [a c\'{a}ntaros] (vp010) *)

   SUBRULE (*1a*)
      < T1:NPVAR{NPVARrec1} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: synPREPNP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP];
              VARPREPPrec1 :=  PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.SpecQ
                  }
         >


   SUBRULE (*1b*)
      < T1:CNVAR{CNVARrec1} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: synPREPNP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP];
              VARPREPPrec1 :=  PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }
         >


   (* Esto sirve [de abrelatas] (vp120) *)

   SUBRULE (*2*)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >
      COMP
         <
          C1: synPREPOPENNPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPOPENNPPROP];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPOPENNPPROP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }
         >


   (* Lo considero [como un loco] (vp120) *)

   SUBRULE (*3*)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >
      COMP
         <
          C1: synPREPCLOSEDNPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPCLOSEDNPPROP];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPCLOSEDNPPROP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >


   (* Cuento con que viene (?) (vp120) *)

   SUBRULE (*4a*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      COMP
         <
          C1: synPREPQUESENTind IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Indicativo
                                 senttype    : subordinateclause
                                 finiteness  : finite
                                 adverbial   : false
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPQUESENTind];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPQUESENTind]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >


   (* Cuento con que venga] (vp120) *)

   SUBRULE (*4b*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      COMP
         <
          C1: synPREPQUESENTsubj IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Subjuntivo
                                 senttype    : subordinateclause
                                 finiteness  : finite
                                 adverbial   : false
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPQUESENTsubj];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPQUESENTsubj]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >


   (* Cuento [con poder venir] (vp120) *)

   SUBRULE (*5*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synPREPOPENINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Infinitivo
                                 senttype    : subordinateclause
                                 finiteness  : infinite
                                 adverbial   : false
                                 infsort     : inf
                                 PROsubject  : true
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPOPENINFSENT];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPOPENINFSENT]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >


   (* Lo considero [como loco] (vp120) *)

   SUBRULE (*6a*)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      COMP
         <
          C1: synPREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPCLOSEDADJPPROP];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPCLOSEDADJPPROP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >

   SUBRULE (*6b*)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      COMP
         <
          C1: synPREPOPENADJPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPOPENADJPPROP];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPOPENADJPPROP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >


   (* Se enter\'{o} [de si esto era posible] (vp120) *)

   SUBRULE (*7*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synPREPQSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1.senttype = subordinateclause AND
              SENTENCEVARrec1.mood IN [yesnointerrogative, whinterrogative] 
                                                                   AND
              SENTENCEVARrec1.modo = Indicativo
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPQSENT];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPQSENT]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >

   SUBRULE (*8*)
      < T1:EMPTYVAR{EMPTYVARrec1} >
      < T1:EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synPREPEMPTY IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPEMPTY];
              VARPREPPrec1 :=  PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }
         >

   SUBRULE (*9*)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >
      COMP
         <
          C1: synPREPMEASUREPHRASE IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPMEASUREPHRASE];
              VARPREPPrec1 := PREPPrecdef;
              VARPREPPrec1 :=
                  { mood       : declxpmood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synPREPMEASUREPHRASE]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  }

         >

>
&

\end{verbatim}
