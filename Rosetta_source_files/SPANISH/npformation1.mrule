\newpage
\begin{verbatim}
% RULE RNPformation10
< m1: I2::CN{CNrec1}[I1:mu1]
>

< m : NP{NPrec1}[head/I2::CN{CNrec1}[I1:mu1]
                ]
>

   MATCHCONDITIONS        (* meant to block the formation of NP out of EN 
                             plus an numerical modifier or a postmodifier
                             while there is no ADJP or SENTENCE
                           *)
      < 
        I1:EXIST(mu1, [head/NOUN{NOUNrec1}[mu8]]) OR
           EXIST(mu1, [I11:modrel/T1])
        I11: T1.cat IN  [ADJP, SENTENCE, PREPP]
        m: NPrec1 = { 
                      persona   : 3
                      NPhead    : otherNP
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }
        I2: (CNrec1.definite <> def) AND
              (* in order to prevent the definite CN 'tres libros'
                 to become an NP *) 
             ((mass IN CNrec1.posscomas) OR
              (CNrec1.numero = plural)
             )
            
      >

      COMP
         <
          C1: true
            C11: CNrec1.numero = singular AND
                 masc IN CNrec1.generos AND
                 mass IN CNrec1.posscomas

            A11: NPrec1 := { 
                          numero            : singular    (*NOUNrec.numero *)
                          genero            : masc
                          actcomas          : [mass]
                         }  
            C12: CNrec1.numero = singular AND
                 fem IN CNrec1.generos AND
                 mass IN CNrec1.posscomas
            A12: 
               NPrec1 := { 
                          numero            : singular    (*NOUNrec.numero *)
                          genero            : fem
                          actcomas          : [mass]
                         }  
            C13: CNrec1.numero = plural AND
                 masc IN CNrec1.generos AND
                 count IN CNrec1.posscomas

            A13: NPrec1 := { 
                          numero            : plural 
                          genero            : masc
                          actcomas          : [count]
                        }  
            C14: CNrec1.numero = plural AND
                 fem IN CNrec1.generos AND
                 count IN CNrec1.posscomas
            A14: NPrec1 := { 
                          numero            : plural 
                          genero            : fem
                          actcomas          : [count]
                          }  
          A1: NPrec1 := { 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs

                          definite          : indef
                          posspred          : true
                          possnietnp        : true
                          
                          specQ             : yesspec (* auxiliary *)
                          syntquant         : omegaquant (* auxiliary *)
                          generic           : nogeneric
        		  supertiempo       : omegatiempo
                          cases             : []
                         }  

         >

      DECOMP
         <
          C1: NPrec1  = { 
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs

                          definite          : indef
                          posspred          : true
                          possnietnp        : true
                          
                          specQ             : yesspec (* auxiliary *)
                          syntquant         : omegaquant (* auxiliary *)
                          generic           : nogeneric
        		  supertiempo       : omegatiempo
                          cases             : []
                         }  
              C11: NPrec1.actcomas * [mass] <> [] AND
                   NPrec1 = { 
                          numero            : singular    (*NOUNrec.numero *)
                          genero            : masc 
                         } AND
                   masc IN CNrec1.generos AND
                   mass IN CNrec1.posscomas

              A11: @ 
              C12: NPrec1.actcomas * [mass] <> [] AND
                   NPrec1 = { 
                          numero            : singular    (*NOUNrec.numero *)
                          genero            : fem
                         }   AND
                   fem IN CNrec1.generos AND
                   mass IN CNrec1.posscomas

              A12: @ 
              C13: NPrec1.actcomas * [count] <> [] AND
                   NPrec1 = { 
                          numero            : plural 
                          genero            : masc
                          }  AND
                   masc IN CNrec1.generos AND
                   count IN CNrec1.posscomas
              A13: @ 
              C14: NPrec1.actcomas * [count] <> [] AND
                   NPrec1 = { 
                          numero            : plural 
                          genero            : fem
                          }  AND
                   fem IN CNrec1.generos AND
                   count IN CNrec1.posscomas
              A14: @ 
           A1:  @
         >
&


\end{verbatim}
