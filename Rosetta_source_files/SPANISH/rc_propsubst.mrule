          C1: SENTENCEVARrec1.index = LEVEL
	      C11: SENTENCEVARrec1 =
                        COPYT_sentencetovar(SENTENCErec1)
	      A11: PERSPROrec1.forma := acusCL
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: SENTENCEVARrec1.index := LEVEL;
              SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1)
         >

&

