(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
pragma C_include('ldconvrec.pf');
pragma C_include('tstring.pf');


PACKAGE TLDCONVREC;
WITH ldconvrec,tstring;
TYPE
  TLDCONVREC_pCatAttrStruct = ^TLDCONVREC_CatAttrStruct;
(*MPT:::===================================================================*
 *
 *  Type name      : TLDCONVREC_CatAttrStruct
 *  Description    : record which contains information about a attribute.
 *                   NextAttr      : TLDCONVREC_CatAttrStruct (pointer
 *                                   to the next record of type
 *                                   TLDCONVREC_CatAttrStruct).
 *                   FieldName     : string representation of the name of
 *                                   the attribute.
 *
 *EMP:::===================================================================*)

   TLDCONVREC_CatAttrStruct = RECORD
                            NextAttr                  : TLDCONVREC_pCatAttrStruct;
                            FieldName                 : TSTRING_string
                         END;


(*MPF:::===================================================================*
 *
 *  Function Name  : TLDCONVREC_CatAttrbs
 *  Description    : 
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION TLDCONVREC_CatAttrbs(catstring: TSTRING_string)
                    : TLDCONVREC_pCatAttrStruct;
EXTERNAL;


END {TLDCONVREC};
