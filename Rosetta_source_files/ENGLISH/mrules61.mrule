ENGLISH 61
&
\begin{verbatim}
%
% TRANSFORMATION TADJCOMPLExtrapos

< m1: ADJPFORMULA{ADJPFORMULArec1}
                            [mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu6,
                                      degreemodrel/N1
                                             [mu5,   (* almost*)
                                              head/T1,
                                              I2:thanascomplrel/T2
                                             ],
                                      mu3,
                                      head/ADJ{ADJrec1}[mu2],
                                      mu4 
                                     ]

                            ]
>
< m : ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                      [mu6,
                                       degreemodrel/N1
                                             [mu5, 
                                              head/T1
                                             ],
                                      mu3,
                                      head/ADJ{ADJrec1}[mu2],
                                      mu4, 
                                      I1:postadjrel/T2
                                     ]
                            ]
>

   MATCHCONDITIONS
      <I1: T2.cat IN [THANP]
       I2: T2.cat IN [THANP]

      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
