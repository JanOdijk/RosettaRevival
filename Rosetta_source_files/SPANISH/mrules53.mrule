
SPANISH 53
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION T2clGLUEinf
< m1:I1::SENTENCE{SENTENCErec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                             [ I2:mu2,
                               head/VERB{VERBrec1}[mu3],
                               cliticrel/CLITIC{}[ I3:rel1/T1,
                                                   I4:rel2/T2
                                                 ],
                               mu4 
                             ],
                     mu5
                   ]
>

< m:I1::SENTENCE{SENTENCErec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                             [ I2:mu2,
                               head/VERB{VERBrec1}[mu3],
                               cliticrel/CLITIC{}[ I3:rel1/T1,
                                                   gluerel/GLUE{},
                                                   I4:rel2/T2
                                                 ],
                               mu4 
                             ],
                     mu5
                   ]
>


   MATCHCONDITIONS
      <
       I1:  (SENTENCErec1.finiteness = Infinite) AND
            ((SENTENCErec1.VRcompl = false AND
             SENTENCErec1.restructuring = false)  OR
            (SENTENCErec1.restructuring = true  AND
             SENTENCErec1.VRcompl = true))
       I2:  NOT EXIST(mu2, [cliticrel/..])
       I3:  rel1 IN [unoCLrel, dosCLrel, seCLrel]
       I4:  rel2 IN [unoCLrel, dosCLrel, tresCLrel]
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] T2clGLUEinf
\item[* relevant examples:] (dar/dando) me lo $\rightarrow$ 
                            me + GLUE + lo
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_gluerules
\item[* date of creation:] 11-OCT-1988 13:33:44  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 14/11/88\ \ \ \ \ author: Elly van Munster\\
Test on VRcompl added.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task: To create a GLUE between two clitics in a finite sentence.\\
Later on the clitic(s) is/are glued to a Gerundio/Infinitivo 
(The Infinitivo must be the HEAD :"decirtelo";
see TauxGLUEclPtc and TinfGLUEcl)
