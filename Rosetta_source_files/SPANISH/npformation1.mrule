\begin{verbatim}

% RULE RNPformation4                    (* () + NOUN  --> 
                                     el/la/los/las + [() + NOUN] *)

< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2],
                 I1:mu3]
>

< m:  NP{NPrec1}[detrel/DETP{DETPrec1}[head/T1],
                 head/CN{CNrec1}[mu1,
                                 head/NOUN{NOUNrec1}[mu2],
                                 mu3]
                ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu3, [posrel/NP{NPrec2}[mu8]])
       m:  NPrec1 = { 
                      persona   : 3
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                      NPhead    : otherNP
                     }
      >

<
(* 1 *)
SUBRULE
< >
<T1:ART(KEY_elartkey){ARTrec1}>

      COMP
         <
          C1: (NOUNrec1.generos * [masc, neutro] <> []) AND
              (NOUNrec1.numero = singular)
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
               NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                          possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          numero            : NOUNrec1.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         }  
         >

      DECOMP
         <
          C1: ((NOUNrec1.generos * [masc, neutro] <> [] ) AND
              (NOUNrec1.numero = singular)) AND 
               DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
               DETPrec1.posspred = true AND
               NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                          possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          numero            : NOUNrec1.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         }  

          A1:  @
         >

