/* mps : mpstatistics window */

object mps_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
	XmNdialogTitle	= N_mps_window;
        XmNnoResize    = true;
    };
    controls {
        XmRowColumn mps_appliedrules;
        XmRowColumn mps_triedrules;
        XmRowColumn mps_treerules;
        XmRowColumn mps_successfilters;
        XmRowColumn mps_treefilters;
        XmRowColumn mps_totalfilters;
        XmRowColumn mps_cpu;
        XmSeparator mps_separator;
	XmRowColumn mps_button_box;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_mps_window + DEFAULT_BUTTON_OFFSET*X_mps_ok_button);
    };
};

object mps_appliedrules : XmRowColumn {
    arguments {
	XmNtopAttachment    = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmLabel {
	    arguments {
                arguments label_args;
	        XmNlabelString	= N_mps_appliedrules_text;
	    };
	};
        XmLabel {
	    arguments {
                arguments label_args;
	    };
	    callbacks {
                MrmNcreateCallback = procedure 
                    XwuCreateWidget (X_mps_appliedrules_text);
	    };
	};
    };
};

object mps_triedrules : XmRowColumn {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmRowColumn mps_appliedrules;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

	XmNorientation      = XmHORIZONTAL;
    };
    controls {
