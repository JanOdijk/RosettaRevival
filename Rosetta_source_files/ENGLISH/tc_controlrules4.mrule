\begin{verbatim}
% TRANSFORMATION Tinfrelcontrol
< m1:CN{CNrec1}[mu1, 
                rel1/I1::SENTENCE{SENTENCErec1}
                       [ subjrel/NP{NPrec1}
                          [head/BIGPRO{BIGPROrec1}
                            [head/BBIGPRO(KEY_oneBBIGPROkey){BBIGPROrec1}] 
                          ],
                         I3:mu3
                       ],
                mu2
               ]
>

< m :CN{CNrec1}[mu1, 
                rel1/I1::SENTENCE{SENTENCErec1}
                       [ I3:mu3
                       ],
                mu2
               ]
>


   MATCHCONDITIONS
      <
       I1: SENTENCErec1.finiteness = infinite AND
           SENTENCErec1.mood = relative
       I3: ALL(mu3,I31:rel3/..)
           I31: QUOTE_Srelprec(subjrel,rel3) AND rel3 <> subjrel
      >

      COMP
         <
          C1: NPrec1 =
		  {
		  req         : [pospol,negpol,omegapol]
		  env         : [pospol,negpol,omegapol]
		  superdeixis : omegadeixis
		  class       : omegaTimeAdvClass
		  deixis      : omegadeixis
		  aspect      : omegaAspect
		  retro       : false
		  definite    : def
		  person      : BIGPROrec1.person
		  number      : BIGPROrec1.number
		  cases       : []
		  genders     : [BIGPROrec1.gender]
		  sexes       : []
		  actsubcs    : [othernoun]
		  temporal    : false
		  animate     : BIGPROrec1.animate
                  human       : omegahuman
		  actcomas    : [count]
		  thetanp     : omegathetanp
		  nounpatternefs : []
		  mood        : nowh
		  generic     : omegageneric
		  posspred    : true
		  possnietnp  : false
		  syntquant   : omegaquant
		  NPhead      : BIGPROrec1.NPhead
		  specQ       : yesspec
		  poss        : false
		  }                                            AND
              BIGPROrec1 =
                 {
                  number:           BBIGPROrec1.number
                  gender:           BBIGPROrec1.gender
                  person:           BBIGPROrec1.person
                  animate:          BBIGPROrec1.animate
                  predpos :         BBIGPROrec1.predpos 
                  NPhead:           BBIGPROrec1.NPhead
                  antecedent:       0
                 }
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: BIGPROrec1 :=
                 {
                  number:           BBIGPROrec1.number
                  gender:           BBIGPROrec1.gender
                  person:           BBIGPROrec1.person
                  animate:          BBIGPROrec1.animate
                  predpos :         BBIGPROrec1.predpos 
                  NPhead:           BBIGPROrec1.NPhead
                  antecedent:       0
                 };
              NPrec1 :=
		  {
		  req         : [pospol,negpol,omegapol]
		  env         : [pospol,negpol,omegapol]
		  superdeixis : omegadeixis
		  class       : omegaTimeAdvClass
		  deixis      : omegadeixis
		  aspect      : omegaAspect
		  retro       : false
		  definite    : def
		  person      : BIGPROrec1.person
		  number      : BIGPROrec1.number
		  cases       : []
		  genders     : [BIGPROrec1.gender]
		  sexes       : []
		  actsubcs    : [othernoun]
		  temporal    : false
		  animate     : BIGPROrec1.animate
                  human       : omegahuman
		  actcomas    : [count]
		  thetanp     : omegathetanp
		  nounpatternefs : []
		  mood        : nowh
		  generic     : omegageneric
		  posspred    : true
		  possnietnp  : false
		  syntquant   : omegaquant
		  NPhead      : BIGPROrec1.NPhead
		  specQ       : yesspec
		  poss        : false
		  };
         >




&

\end{verbatim}
