\begin{verbatim}
% TRANSFORMATION Twhshift0
< m1:CLAUSE{CLAUSErec1}[I1:mu1, predrel/VERBP{VERBPrec1}[I2:mu2 ], I3:mu3 ]
>

< m :CLAUSE{CLAUSErec1}[I1:mu1, predrel/VERBP{VERBPrec1}[I2:mu2 ], I3:mu3 ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[I11:../T1])                OR 
           (EXIST(mu1, [I11:shiftrel/T1])  AND
            CLAUSErec1.synvpefs * AUX_VRvps <> [])   OR
           ( EXIST(mu1, [I11:subjrel/T1]) AND
             CLAUSErec1.finiteness = infinite
           )
       I2: NOT EXIST(mu2,[I11:../T1]) 
       I3: NOT EXIST(mu3,[I11:../T1])  AND
           NOT EXIST(mu3, [extraposrel/I5::SENTENCE{SENTENCErec1}[I4:mu4]])
       I4: EXIST(mu4, [I11:shiftrel/T1])
       I5: SENTENCErec1.mood = declarative
       I11: (T1.CAT IN [NP, PREPP, VARPREPP, ADJP, ADVP, NPVAR] 
                    WITH T1.REC.mood IN [wh,relativexpmood]) OR
            (T1.CAT IN [CNVAR])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
