              (CLAUSErec2.deixis = presentdeixis) 
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.superdeixis = omegadeixis) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := presentdeixis;
 
          A1: CLAUSErec1.deixis := omegadeixis;
              VERBrec2 := VERBrec5;
              VERBrec2.tense := omegatense;

         >

   SUBRULE (* 3c *)
      <mu5: [mu6, I9: tempadvrel/SENTENCE{SENTENCErec1}[mu11], mu7]>
      <mu5: [mu6, I9: tempadvrel/SENTENCE{SENTENCErec1}[mu11], mu7]>

   MATCHCONDITIONS
      <
       I9: ((SENTENCErec1.conjclass = reference) AND
            (SENTENCErec1.conjretro = false) AND
            (SENTENCErec1.conjdeixis = futuredeixis) 
           )
      >

      COMP
         <
          C1:((CLAUSErec1.deixis= omegadeixis) AND
              (VERBrec2.tense = omegatense) AND
              (CLAUSErec1.finiteness = finite)
             )

             C11:(CLAUSErec1.superdeixis = omegadeixis)
             A11:CLAUSErec2 := CLAUSErec1;

             C12: (CLAUSErec1.superdeixis = presentdeixis) (* switch *)
             A12: CLAUSErec2 := CLAUSErec1;
                  CLAUSErec2.superdeixis := omegadeixis;

          A1: CLAUSErec2.deixis := presentdeixis;
              VERBrec5 := VERBrec2;
              VERBrec5.tense := presenttense;

         >
      DECOMP
         <
          C1:((VERBrec5.tense = omegatense) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.deixis = presentdeixis) 
             )
              C11: (CLAUSErec2.superdeixis = omegadeixis)
              A11: CLAUSErec1 := CLAUSErec2;

              C12: (CLAUSErec2.superdeixis = omegadeixis) (* switch *)
              A12: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.superdeixis := presentdeixis;
 
          A1: CLAUSErec1.deixis := omegadeixis;
              VERBrec2 := VERBrec5;
              VERBrec2.tense := omegatense;

         >


>
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpresfutdeixis
\item[* relevant examples:] He will sleep tomorrow, He will sleep at 6 o'clock
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Deixis rules
\item[* date of creation:] 05-OCT-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresfutdeixis Spanish 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 14/11/88\ \ \ \ \ author: Lisette Appelo
\item date: 17/11/88\ \ \ \ \ author: Lisette Appelo
\item date: 01/02/89\ \ \ \ \ author: Lisette Appelo
\item date: 09/02/89\ \ \ \ \ author: Lisette Appelo
\end{enumerate}
\item[* task:] The relation between Rs and S is simultanuous: PRESENT, but with 
S `shifted' into the future.
               This rule is for a finite independent clause.
               The auxiliary verb {\em will} is introduced.
               The deixis 
value of the reference adverbial is checked for 
               future deixis.
               The clause is marked for present deixis.
\item[\ \ strategy:] the match is assumed to be left to right
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials. 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task) It has the 
same semantics as Rfinpresentdeixis.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages: With this rule {\em He will sleep tomorrow} will be 
translated into {\em Hij slaapt morgen} and {\em dormir\'{a} ma\~{n}ana}\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: 14/11/88: Added omegadeixis for adverbial.
                     17/11/88: Added condition for presentdeixis for adverbial, 
but only applicable if clause is perfective and a durative adverbial is present
. This is for {\em He will swim for four hours} as a translation of {\em hij 
zwemt vier uur}.
                     1/2/89: split up into two subrules (1 and 2) that now both 
consist of three subrules (a - c), because of possible presence of {\em do} 
that must be substituted by {\em will}. Added also conditions on retro. If 
retro = true  and a durational adverbial is present, this rule should not apply 
in case of a present deixis referential adverbial. 
({\em hij heeft drie uur gezwommen} -> *{\em he will have swum for three hours}
)\\
                     9/2/89: added subrule 3 (a - c) for will + futuredeixis 
adverbial.\\
\end{enumerate}
\end{description}

