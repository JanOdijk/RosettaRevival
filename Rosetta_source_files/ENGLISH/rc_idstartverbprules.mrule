\begin{verbatim}
%RULE RIDDERIV3

<m1: I1::SUBVERB{SUBVERBREC1}[head/BVERB(KEY1){BVERBREC1}]
 m2: T1
>

< m:  IDFORMATION/TIDCLAUSETOVPPROP
        [CLAUSETOSENTENCE/ROBJNPSUBST{LEVEL:X1 
                                      SUBST:2}
           [IDFORMATION/TIDVPPROPTOCLAUSE
              [VERBPPROPFORMATION/TVERBPATTERN1
                 [VERBPPROPFORMATION/RSTARTVPPROP120
                    [VERBDERIVATION/RBVERBTOSUB
                       [BLEX/BVERB(KEY2)],
                     BLEX/I2:T1,
                     BLEX/NPVAR(X1){NPVARrec1}
                    ]
                 ]
              ],
            IDFORMATION/RIDNPFORMATION
              [CNFORMATION/RCNFORMATION1
                 [IDFORMATION/RIDSUBNOUNTONOUN{VPID}
                    [NPDERIVATION/BNOUNTOSUBNOUN
                       [BLEX/BNOUN(KEY3)]
                    ]
                 ],
               BLEX/T2
              ]
           ]
        ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBREC1.thetavp = vp120 
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
      >

<
   SUBRULE  (* 1 *)
      <T1:NPVAR{NPVARrec2}>
      <T1:NPVAR{NPVARrec2}
       T2:NPVAR{NPVARrec3}>

COMP
 <
   C1: COMPINIDDICT(KEY1, VPID4)
   A1: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID4);
       NPVARrec3 := NPVARrec2;
   C2: COMPINIDDICT(KEY1, VPID6)
   A2: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID6);
       NPVARrec3 := NPVARrec2;
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3>, VPID4)              AND
       NPVARREC3.index = NPVARREC2.index
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID4);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
   C2: DECOMPINIDDICT(<KEY2, KEY3>, VPID6)              AND
       NPVARREC3.index = NPVARREC2.index
   A2: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID6);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
 >

   SUBRULE  (* 2 *)
      <T1:CNVAR{CNVARrec1}>
      <T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}>

COMP
 <
   C1: COMPINIDDICT(KEY1, VPID4)
   A1: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID4);
       CNVARrec2 := CNVARrec1;
   C2: COMPINIDDICT(KEY1, VPID6)
   A2: <KEY2, KEY3> := COMPGETIDDICT (KEY1, VPID6);
       CNVARrec2 := CNVARrec1;
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3>, VPID4)              AND
       CNVARREC2.index = CNVARREC1.index
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID4);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
   C2: DECOMPINIDDICT(<KEY2, KEY3>, VPID6)              AND
       CNVARREC2.index = CNVARREC1.index
   A2: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3>, VPID6);
       SUBVERBREC1 := COPYT_bverbtosubverb(BVERBREC1);
 >

>

&
\end{verbatim}
