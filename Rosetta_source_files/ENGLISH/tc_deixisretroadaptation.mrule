\newpage
\begin{verbatim}
% TRANSFORMATION Tdeixisretroadaptation1
< m1: SENTENCE{SENTENCErec1}
            [mu1,
             head/VERB{VERBrec3}
                     [mu2,
                      rel2/VERB{VERBrec2}
                          [head/SUBVERB{SUBVERBrec1}
                              [head/BVERB(AUX_havebverbkey){BVERBrec1}]
                          ],
                      rel1/VERB{VERBrec1}[mu3],
                      mu4
                     ],
             mu5
            ] 
>

< m : SENTENCE{SENTENCErec2}
            [mu1,
             head/VERB{VERBrec3}
                    [mu2,
                     rel2/VERB{VERBrec2}
                         [head/SUBVERB{SUBVERBrec1}
                              [head/BVERB(AUX_havebverbkey){BVERBrec1}]
                         ],
                     rel1/VERB{VERBrec1}[mu3],
                     mu4
                    ],
               mu5
            ] 

>
   MATCHCONDITIONS
      <
      >

      COMP
         <
          C1: ((SENTENCErec1.aspect = perfective) AND
               (SENTENCErec1.retro = false) AND
               (VERBrec1.modus = participle)
              )
              C11: (SENTENCErec1.superdeixis = omegadeixis) AND
                   (SENTENCErec1.deixis = pastdeixis) AND
                   (SENTENCErec1.finiteness = infinite) AND
                   (VERBrec2.tense = omegatense)
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.deixis := omegadeixis;

              C12: ((SENTENCErec1.superdeixis = pastdeixis) OR
                    (SENTENCErec1.superdeixis = presentdeixis) 
                   ) AND
                   (SENTENCErec1.deixis = omegadeixis) AND
                   (SENTENCErec1.finiteness = infinite) AND
                   (VERBrec2.tense = omegatense)
              A12: SENTENCErec2 := SENTENCErec1;

          A1: SENTENCErec2.retro := true;
         >
      DECOMP
         <
          C1: ((SENTENCErec2.retro = true) AND
               (SENTENCErec2.aspect = perfective) AND
               (VERBrec1.modus = participle)
              ) 
              C11: (SENTENCErec2.superdeixis = omegadeixis) AND
                   (SENTENCErec2.deixis = omegadeixis) AND
                   (SENTENCErec2.finiteness = infinite) AND
                   (VERBrec2.tense = omegatense)
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.deixis := pastdeixis;

              C12: ((SENTENCErec2.superdeixis = pastdeixis) OR
                    (SENTENCErec2.superdeixis = presentdeixis) 
                   ) AND
                   (SENTENCErec2.deixis = omegadeixis) AND
                   (SENTENCErec2.finiteness = infinite) AND
                   (VERBrec2.tense = omegatense)
              A12: SENTENCErec1 := SENTENCErec2;

          A1: SENTENCErec1.retro := false;
         >

&
\end{verbatim}
