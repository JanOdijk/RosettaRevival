pragma C_Include('oldtree.pf');
pragma C_Include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE DrawTree;
WITH OLDTREE, WND;

(*MPT:::===================================================================*
 *
 *  Type name      : DrawTree_NodeSizeRange
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   DrawTree_NodeSizeRange = 0..MaxInt;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawTree_Initialize
 *  Description     : This procedure will initialize the drawtree-module
 *  Parameters      :
 *  Precondition    :
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DrawTree_Initialize;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawTree_NodeAttributes
 *  Description     : This procedure will handle the attribute-displaying
 *                    of the node in the tree with the specified node-id
 *  Parameters      : node_id : WND_Xid
 *  Precondition    :
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DrawTree_NodeAttributes (node_id : WND_Xid);
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawTree_CreateTree
 *  Description     : This procedure will generate a drawing of the tree
 *                    in the specified tree_window without displaying it
 *  Parameters      : OldNode : OLDTREE_OldTree
 *                    tree_id : WND_Xid
 *  Precondition    :
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DrawTree_CreateTree(OldNode : OLDTREE_OldTree; tree_id: WND_Xid);
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawTree_GenerateTree
 *  Description     : This procedure will generate a drawing of the tree and
 *                    display it
 *  Parameters      : OldNode : OLDTREE_OldTree
 *  Precondition    :
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE DrawTree_GenerateTree(OldNode : OLDTREE_OldTree);
EXTERNAL;

FUNCTION DrawTree_Manage(OldNode : OLDTREE_OldTree; parent_id : WND_Xid): integer;
EXTERNAL;

PROCEDURE DrawTree_HandleKey (key : WND_Xid);
EXTERNAL;

END {DrawTree};
