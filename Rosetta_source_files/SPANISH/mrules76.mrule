% RULE RINDEFPROTOSUBINDEFPRO  (* SUBINDEFPRO is introduced instead of 
                                  BINDEFPRO in order to avoid a major 
                                  modification of morphology *)
< m1: INDEFPRO{INDEFPROrec1}    
>

< m : SUBINDEFPRO{SUBINDEFPROrec1}[head/INDEFPRO{INDEFPROrec1}]
>

      COMP
         <
          C1: true
          A1: SUBINDEFPROrec1 := INDEFPROrec1
         >
      DECOMP
         <
          C1: SUBINDEFPROrec1 = INDEFPROrec1
          A1: @
         >

&

\end{verbatim}
