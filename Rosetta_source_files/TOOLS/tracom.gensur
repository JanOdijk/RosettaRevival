%ELEMENTTRANS
BASIS RULE
  ELEMENTTRANS = (VALUENAME/2|SETVALUENAME/6).
                    {BAR/8.(VALUENAME/2|SETVALUENAME/6)}.
                  [LEFTARROW/4].DASH/1.[RIGHTARROW/5].
                 (VALUENAME/3|SETVALUENAME/7).
                    {BAR/9.(VALUENAME/3|SETVALUENAME/7)}

SURFACE PART
VAR leftpresent,rightpresent::bool;
    pair::pair;
    identset::identset;
    ident::ident;

<*
 INIT:BEGIN leftpresent:=false;rightpresent:=false;
            initsetofidents(pair.lefts);
            initsetofidents(pair.rights);
            initsetofidentsets(pair.leftsets);
            initsetofidentsets(pair.rightsets);
            pair.leftsetvalued:=false;
            pair.rightsetvalued:=false;
            pair.leftpresent:=false;
            pair.rightpresent:=false;
            leftpresent:=false;
            rightpresent:=false;
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN ident.str:=%VALUENAME.str;
                                appendident(ident,pair.lefts);
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN ident.str:=%VALUENAME.str;
                                appendident(ident,pair.rights);
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN leftpresent:=true;
                                pair.leftpresent:=true;
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN rightpresent:=true;
                                pair.rightpresent:=true;
                          END
       *>
6:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN pair.leftsetvalued:=true;
                                identset.val:=%SETVALUENAME.copy;
                                appendidentset(identset,pair.leftsets);
                          END
       *>
7:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN identset.val:=%SETVALUENAME.copy;
                                pair.rightsetvalued:=true;
                                appendidentset(identset,pair.rightsets);
                          END
       *>
8:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
9:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
FINAL: #CONDITION: leftpresent or rightpresent
       #ACTION: BEGIN
                  SEND_ELEMENTTRANS;
                  $ELEMENTTRANS.pair:=pair;
                END
*>
END;

