\newpage
\begin{verbatim}
% RULE Rppadvpmod
< m1:PREPP{PREPPrec1}[mu2] 
  m2:ADVP{ADVPrec1}[mu3] 
>

< m :PREPP{PREPPrec1}
          [ modrel/ADVP{ADVPrec2}[mu3],
            mu2
          ] 
>

      COMP
         <
          C1: preppadv IN ADVPrec1.actsubcefs AND
              ADVPrec1.supertiempo = PREPPrec1.supertiempo 
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <C1: preppadv IN ADVPrec2.actsubcefs AND
              ADVPrec2.supertiempo = omegatiempo 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.supertiempo := PREPPrec1.supertiempo;
         >


&

\end{verbatim}
