\begin{verbatim}
% TRANSFORMATION Targreflspelling7 (*NPVAR in PP in VP: indobj=antec*)
< m1: CLAUSE{CLAUSErec1}
         I1:[ mu1,
              predrel/VERBP{VERBPrec1}
                  I2:[ mu2,
                       rel1/NPVAR{NPVARrec1},
                       mu3,
                       prepobjrel/VARPREPP{VARPREPPrec2}
                                 [mu5,
                                  rel2/NPVAR{NPVARrec2},
                                  mu6
                                 ],
                       mu4
                     ],
              mu8
            ]
>

< m : CLAUSE{CLAUSErec1}
         I1:[ mu1,
              predrel/VERBP{VERBPrec1}
                  I2:[ mu2,
                       rel1/NPVAR{NPVARrec1},
                       mu3,
                       prepobjrel/PREPP{PREPPrec2}
                                 [mu5,
                                  rel2/I3::NP{NPrec1}[head/T1],
                                  mu6
                                 ],
                       mu4
                     ],
              mu8
            ]
>

   MATCHCONDITIONS
      <
       I1: RIGHTTOLEFT
       I2: RIGHTTOLEFT
       m1: NPVARrec1 = NPVARrec2 AND
           NOT EXIST (mu3, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../VARPREPP{VARPREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) AND
           NOT EXIST (mu4, [../PREPP{PREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) 
       I3: NPrec1.NPhead = reflNP
       m : NOT EXIST (mu3, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../VARPREPP{VARPREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) AND
           NOT EXIST (mu4, [../PREPP{PREPPrec1}
                                   [ mu7,
                                     ../I31::NPVAR{NPVARrec3} ]
                           ] ) 
         I31: NPVARrec3 = NPVARrec1 
      >

<
   SUBRULE (* 1. myself *)
      < >
      < T1: REFLPRO(AUX_myselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : singular }
          A1: NPrec1 := AUX_NPONmyRFLPR;
              NPrec1.cases := NPVARrec2.cases;
              PREPPrec2 := VARPREPPrec2;
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONmyRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 1
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases;
              VARPREPPrec2 := PREPPrec2;

         >

   SUBRULE (* 2. yourself *)
      < >
      < T1: REFLPRO(AUX_yourselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : singular }
          A1: NPrec1 := AUX_NPONyoursgRFLPR;
              NPrec1.cases := NPVARrec2.cases;
              PREPPrec2 := VARPREPPrec2;
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONyoursgRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 2
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases;
              VARPREPPrec2 := PREPPrec2
         >

   SUBRULE (* 3a. himself *)
      < >
      < T1: REFLPRO(AUX_himselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: NPrec1 := AUX_NPONhimRFLPR;
              NPrec1.cases := NPVARrec2.cases;
              PREPPrec2 := VARPREPPrec2;
         >

      DECOMP
         <
