\newpage
\begin{verbatim}
% RULE RppSubstitution3       (* PREPP *)
< m1: PREPP{PREPPrec2}
           [ mu2,
             objrel/PREPPVAR{PREPPVARrec1},
             mu3 
           ]
  SUBST:
  m2: PREPP{PREPPrec1}[mu4]
>

< m : PREPP{PREPPrec2}
           [ mu2,
             objrel/PREPP{PREPPrec3}[mu4],
             mu3 
           ]
>

   MATCHCONDITIONS
      <
       I1: PREPPVARrec1.index = LEVEL
      >


   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_prepptovar(PREPPrec1) AND
              PREPPrec1.superdeixis = PREPPrec2.superdeixis AND
              (PREPPrec2.actsubcefs * [temp] <> [] ->
               PREPPrec1.actsubcefs * [temp] <> [])
          A1: PREPPrec3 := PREPPrec1;
              PREPPrec3.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: PREPPrec3.superdeixis = omegadeixis AND
              (PREPPrec2.actsubcefs * [temp] <> [] ->
               PREPPrec3.actsubcefs * [temp] <> [])
          A1: PREPPrec1 := PREPPrec3;
              PREPPrec1.superdeixis := PREPPrec2.superdeixis;
              PREPPVARrec1 := COPYT_prepptovar(PREPPrec3);
              PREPPVARRec1.index := LEVEL;
         >

&

\end{verbatim}
