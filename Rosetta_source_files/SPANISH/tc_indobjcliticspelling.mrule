\begin{verbatim}
%
% TRANSFORMATION Tindobjcliticspelling
< m1:VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       cliticrel/CLITIC{}[ ],
                       mu3,
                       indobjrel/VARPREPP{VARPREPPrec1}
                                [head/PREP{PREPrec1}[ ],
                                 objrel/T2
                                ],
                       mu4 
                      ],
               mu5
              ] 
>

< m : VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       cliticrel/CLITIC{}
                                [rel1/PERSPRO{PERSPROrec1}
                                     [head/T1] 
                                ],
                       mu3,
                       indobjrel/VARPREPP{VARPREPPrec1}
                                [head/PREP{PREPrec1}[ ],
                                 objrel/T2
                                ],
                       mu4 
                      ],
               mu5
              ] 
>

< 
  SUBRULE  (* me mannelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_yomascbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 1) AND
              (NPVARrec1.genero = masc) 
          A1: rel1 := unoclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* me vrouwelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_yofembpersprokey) {BPERSPROrec1} 
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 1) AND
              (NPVARrec1.genero = fem) 
          A1: rel1 := unoclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* te mannelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_tumascbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 2) AND
              (NPVARrec1.genero = masc) 
          A1: rel1 := dosclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* te vrouwelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_tufembpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 2) AND
              (NPVARrec1.genero = fem) 
          A1: rel1 := dosclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >


   SUBRULE  (* le mannelijk, ook voor usted *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_elbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 3) AND 
              (NPVARrec1.genero = masc) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* le vrouwelijk, ook voor usted *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_ellabpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 3) AND
              (NPVARrec1.genero = fem) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >


   SUBRULE  (* le onzijdig *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_ellobpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = singular) AND
              (NPVARrec1.persona = 3) AND
              (NPVARrec1.genero = neutro) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* le mannelijk; CNVAR *)
      < T2:CNVAR{CNVARrec1} >
      < T1:BPERSPRO (AUX_elbpersprokey) {BPERSPROrec1}
        T2:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1.numero = singular) AND
              (masc IN CNVARrec1.generos) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* le vrouwelijk *)
      < T2:CNVAR{CNVARrec1} >
      < T1:BPERSPRO (AUX_ellabpersprokey) {BPERSPROrec1}
        T2:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1.numero = singular) AND
              (fem IN CNVARrec1.generos) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* le onzijdig *)
      < T2:CNVAR{CNVARrec1} >
      < T1:BPERSPRO (AUX_ellobpersprokey) {BPERSPROrec1}
        T2:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1.numero = singular) AND
              (neutro IN CNVARrec1.generos) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* nos mannelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_nosotrosbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = plural) AND
              (NPVARrec1.persona = 1) AND
              (NPVARrec1.genero = masc) 
          A1: rel1 := unoclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* nos vrouwelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_nosotrasbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = plural) AND
              (NPVARrec1.persona = 1) AND
              (NPVARrec1.genero = fem) 
          A1: rel1 := unoclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* os mannelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_vosotrosbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = plural) AND
              (NPVARrec1.persona = 2) AND
              (NPVARrec1.genero = masc) 
          A1: rel1 := dosclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* os vrouwelijk *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_vosotrasbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = plural) AND
              (NPVARrec1.persona = 2) AND
              (NPVARrec1.genero = fem) 
          A1: rel1 := dosclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* les mannelijk, ook voor usted *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_ellosbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = plural) AND
              (NPVARrec1.persona = 3) AND
              (NPVARrec1.genero = masc) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* les vrouwelijk, ook voor usted *)
      < T2:NPVAR{NPVARrec1} >
      < T1:BPERSPRO (AUX_ellasbpersprokey) {BPERSPROrec1}
        T2:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1.numero = plural) AND
              (NPVARrec1.persona = 3) AND
              (NPVARrec1.genero = fem) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >


SUBRULE  (* les mannelijk *)
      < T2:CNVAR{CNVARrec1} >
      < T1:BPERSPRO (AUX_ellosbpersprokey) {BPERSPROrec1}
        T2:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1.numero = plural) AND
              (masc IN CNVARrec1.generos) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >

   SUBRULE  (* les vrouwelijk *)
      < T2:CNVAR{CNVARrec1} >
      < T1:BPERSPRO (AUX_ellasbpersprokey) {BPERSPROrec1}
        T2:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1.numero = plural) AND
              (fem IN CNVARrec1.generos) 
          A1: rel1 := tresclrel;
              PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := datCL;
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tindobjcliticspelling
\item[* relevant examples:]

me daba a m\'{\i}, te daba a ti, le daba a \'{e}l, le daba a ella, 
le daba a ello, nos daba a nosotros, nos daba a nosotras, 
os daba a vosotros, os daba a vosotras, 
les daba a ellos, les daba a ellas
\item[* language:] Spanish 
\item[* kind of rule:] M-rule
\item[* subgrammar:] VERBPPROPformation
\item[* class:] TC: indobjcliticspelling
\item[* date of creation:] 14-DEC-1987 15:56:05  
\item[* author:] Lisette Appelo
\item[* copied from:] -
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 01/03/88\ \ \ \ \ author: Elly van Munster \\
The rules were made for both NPVAR and CNVAR.\\
However, since CNVAR doesn't have "number", the rules couldn't collaps in
this way. (T2.REC.persona isn't possible for CNVAR).\\
Five subrules are added for CNVAR.\\
(i.e. singular,masc; singular,fem; singular, neutro; plural,masc; plural,fem)
\item date: 25/07/88\ \ \ \ \ author: Elly van Munster \\
Four subrules added:\\
\ \ \ \ \ \ \ \ \ \ usted masc\\
\ \ \ \ \ \ \ \ \ \ usted fem\\
\ \ \ \ \ \ \ \ \ \ ustedes masc\\
\ \ \ \ \ \ \ \ \ \ ustedes fem
\item date: 10/10/88\ \ \ \ \ author: Lisette Appelo\\
Four subrules for usted deleted. They cause an ambiguity that cannot be solved 
because the NPVAR does not give any information about the kind of perspro. The 
only thing that is important here is that it is person 3. The clitic will be 
based on \'{e}l, ella, ellos and ellas respectively!
\end{enumerate}
\item[* task:] Spell out the redundant indirect object clitic that is 
obligatory in Spanish in the CLITIC position.
\item[\ \ strategy:] (also: deviations from accepted proposals)\\
If the NP or CN to be substituted for the NPVAR or CNVAR
of the indirect object is a pronoun,
the indirect object PP can be optionally deleted after or during the 
substitution rules.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
Person, number and gender combinations, for NPVAR and CNVAR.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: A rule creating the CLITIC node precedes this rule.\\
No rule inserting clitics into the CLITIC node precedes this rule.\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] ????
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item 
It is assumed that "usted(es)" has no CNVAR.
\end{enumerate}
\end{description}
\newpage
\begin{verbatim}
% TRANSFORMATION Tnoindobjcliticspelling
< m1:VERBPPROP{VERBPPROPrec1}[mu1,
                              predrel/VERBP{VERBPrec1}[I1:mu2 ],
                              mu3 
                             ]
>

< m :VERBPPROP{VERBPPROPrec1}[mu1,
                              predrel/VERBP{VERBPrec1}[I1:mu2 ],
                              mu3 
                             ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [indobjrel/..]) OR
           EXIST (mu2, [indobjrel/EMPTYVAR{EMPTYVARrec1}])
      >

      COMP
         <
          C1: true
          A1:  @
         >
      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
