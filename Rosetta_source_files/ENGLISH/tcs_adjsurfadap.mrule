\newpage
\begin{verbatim}

% TRANSFORMATION TADJmostTOst
< m1: ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      degreemodrel/QP{QPrec1}
                                         [mu3,
                                          artrel/ART(KEY_theartkey){ARTrec1},
                                          head/Q(KEY_mostQkey){Qrec1}
                                         ],
                                      head/I1::ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                              ]
>

< m : ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [I2:mu2,
                                      I3:mu3, (* ALMOST *)
                                      I5:sig1,
                                      head/I4::ADJ{ADJrec2}[mu4],
                                      mu5
                                     ]
                            ]
>
   MATCHCONDITIONS
      <
       I1: ADJrec1.compformations <> [noComp] AND
           ADJrec1.compformations <> [moreComp] 
       I2: NOT EXIST(mu2, [premodrel/..])
       I3: ALL(mu3, premodrel/..)
       I4: ADJrec2.compform = super AND
           ADJrec2.compformations <> [noComp] AND
           ADJrec2.compformations <> [moreComp] 
       I5: ALL (sig1, artrel/ART(KEY_theartkey){ARTrec2})

      >

< 
   SUBRULE (* 1 *)
      < >
      <sig1: [] >

      COMP
         <
          C1: ADJrec1.compform = basic
          A1: ADJrec2 := ADjrec1;
              ADJrec2.compform := super;
              ADJPrec2 := ADJPrec1;
              ADJPrec2.actuseefs := ADJrec2.uses *  [attributive, nominalised]
             (* Deze vorm zonder `the' kan niet als ADV fungeren 
                en als ADJ niet in predicatieve functie 
               (NB. 'most' zonder 'the' in de betekenis van 'zeer' 
                   kan wel predicatief
                   gebruikt worden; voorstel: most in die betekenis is 
                   degreeADV.
             *)
         >
      DECOMP
         <
          C1: (ADJrec2.compform = super) AND
              (NOT predicative IN ADJPrec2.actuseefs) 
              (* is omkering van A1.4 *) 
          A1: ADJrec1 := ADjrec2;
              ADJrec1.compform := basic;
              ADJPrec1 := ADJPrec2;
              ADJPrec1.actuseefs := [];
              QPrec1 := COPYT_qTOqp(Qrec1)   (* QPrec1.thanascompl ??? *)

         >

   SUBRULE (* 2 *)
      < >
      <sig1: [artrel/ART(KEY_theartkey){ARTrec3}]>

      COMP
         <
          C1: ADJrec1.compform = basic
          A1: ADJrec2 := ADjrec1;
              ADJrec2.compform := super;
              ADJPrec2 := ADJPrec1;
              ADJPrec2.actuseefs := ADJrec2.uses * [predicative];
             (* deze vorm with `the' occurs only in predicative position *)
         >
      DECOMP
         <
          C1: (ADJrec2.compform = super) AND
              ADJPrec2.actuseefs = [predicative]
          A1: ADJrec1 := ADjrec2;
              ADJrec1.compform := basic;
              ADJPrec1 := ADJPrec2;
              ADJPrec1.actuseefs := [];
              QPrec1 := COPYT_qTOqp(Qrec1)   (* QPrec1.thanascompl ??? *)
         >

>
&

\end{verbatim}
