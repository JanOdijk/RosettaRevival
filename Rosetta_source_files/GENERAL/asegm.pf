pragma C_include('limorfdef.pf');
pragma C_include('listree.pf');
pragma C_include('interface1.pf');
pragma C_include('interface0.pf');
pragma C_include('string.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE ASEGM;
WITH LIMORFDEF, LISTREE, INTERFACE1, INTERFACE0, STRNG;

TYPE

(*MPT:::===================================================================*
 *
 *  Type name      : ASEGM_LayoutRuleMode
 *  Description    : Defines the two possible modes of the word layout rules:
 *                   splitting mode and non-splitting mode
 *
 *EMP:::===================================================================*)

   ASEGM_LayoutRuleMode = ( splitmode, nosplitmode );


(*MPF:::===================================================================*
 *
 *  Function Name  : ASEGM_ASEGMENTATION
 *  Description    : Implements the Analytical Morphological Segmentation
 *                   formalism, as described in document R0065.
 *  Parameters     : sw : INTERFCAE0_pSeqWords : Implementation of a "set 
 *                              of sequences of words (string without blanks)"
 *                              See documentation on module INTERFACE0 for
 *                              more information.
 *  Result         : INTERFACE1_pRowSeqSegmKeys : Datastructure containing the 
 *                              segmented results of each of the words.
 *
 *EMP:::===================================================================*)

FUNCTION ASEGM_ASEGMENTATION(sw: INTERFACE0_pSeqWords): 
                                        INTERFACE1_pRowSeqSegmKeys; 
EXTERNAL;


END {ASEGM};
