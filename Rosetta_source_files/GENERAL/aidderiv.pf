(*MPD:::===================================================================*
 *
 *  Rosetta Project
 *
 *  Module Title    : AIdDeriv
 *  Creation date   :  5-AUG-1988
 *  Author          : Joep Rous
 *
 *  Copyright (c) 1986, by Nederlandse Philips Bedrijven BV.
 *
 *  Remarks         : This module contains the functions
 *                    AIdDeriv_Analyse
 *
 *                    Both functions have a parameter of type 
 *                    HyperDtree_pHyperDtree. We decided to use this data-
 *                    structure for the implementation of derivation trees in 
 *                    input/output models of idiom M-rules because it met
 *                    almost perfectly the specifications we had in mind. In
 *                    the situations where the datastructure does not fit we 
 *                    misuse some fields in the nodes of the datastructure
 *                    to store the information.
 *                    The hyperdtree which is passed to functions should be
 *                    in conformity with the following specifications:
 *
 *                    Rule nodes : 
 *                                - .R > 0 and .params.index = -1 and
 *                                  .params.subst = -1  => normal rule node
 *                                - .R > 0 and .params.index <> -1 and
 *                                  .params.subst <> -1  => subst rule node
 *                                - .R < 0 and .params.index = -1 and
 *                                  .params.subst = -1  => transformation node
 *                                - .R = 0 and .params.index = -1 and
 *                                  .params.subst = -1  => complex leave node, 
 *                                  .LI^.stree contains the instantiated stree
 *                    Basic nodes : 
 *                                - .key > 0 => normal basic expression
 *                                - .key = 0 => basic leave node, .LI^.stree
 *                                  contains the instantiated stree
 *                    Var Nodes :
 *                                - .index > 0 => normal variable
 *
 *   
 *EMP:::===================================================================*)

pragma C_INCLUDE('listree.pf');
pragma C_INCLUDE('hyperdtree.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE AIdDeriv;
WITH LISTREE, HYPERDTREE;

(*MPF:::===================================================================*
 *
 *  Function Name  : AIdDeriv_Analyse
 *  Description    :  In analysis only one rule of a hypernode should be
 *                    applicable. In case more rules of a hypernode
 *                    are applicable the functions IdDeriv_Analyse will choose
 *                    randomly one of these rules. If a rule application yields
 *                    an ambiguous result 
 *                    and if more than one result can be analysed successfully,
 *                    the function will choose one of these results at random.
 *  Parameters     :  VAR d : HyperDtree_pHyperDtree;
 *                    t     : LISTREE_pStree;
 *  Result         :  BOOLEAN : TRUE if AIdDerive_Analyse could analyse the
 *                              input stree correctly, otherwise FALSE.
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION AIdDeriv_Analyse(VAR d: HyperDtree_pHyperDtree;
                                    t    : LISTREE_pStree)
                    : BOOLEAN;
EXTERNAL;




END {AIdDeriv};

