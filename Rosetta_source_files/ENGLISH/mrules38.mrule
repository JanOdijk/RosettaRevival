\begin{verbatim}
% RULE Raspectperfective
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            mu5
            ]
>
   MATCHCONDITIONS
      <
      >

      COMP
         <
          C1: CLAUSErec1.aspect = omegaaspect
 
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aspect:= perfective;
         >

      DECOMP
         <
          C1: CLAUSErec2.aspect= perfective

          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.aspect:= omegaaspect;
         >

&

\end{verbatim}

