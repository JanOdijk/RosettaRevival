echo "obj: $1:$2:$3:$4"
# $1 is the component of the .p file
# $2 is the component of the .o file
# $3 is the component of the .opt file
# $4 is the file name
if test -s $1/source/$4.p
then echo "inputfile $1/source/$4.p" > lognames
else echo "inputfile $1/target/$4.p" > lognames
fi
echo "objectfile $2/target/$4.o" >> lognames
echo "outputfile $3/target/$4.opt" >> lognames
echo "general/source//" > dirpath
echo "general/target//" >> dirpath
echo "interlingua/source//" >> dirpath
echo "interlingua/target//" >> dirpath
echo "tools/source//" >> dirpath
echo "tools/target//" >> dirpath
if ( test "$3" = "dutch") || (test "$3" = "english") || (test "$3" = "spanish")
then echo "$3/target//" >> dirpath
     echo "$3/source//" >> dirpath
fi
tools/target/optgenerator.exe lognames dirpath
rm -f lognames
