           ") ELSE match_" ""itemid.str""
              "(Lfirst" ""itemid.levelid"" ",Lfirst" ""itemid.levelid""
           ",FALSE,match) END;"\\
           END;
       IF M THEN BEGIN
           itemids1:=itemids;takeitemid(itemid,itemids1);
           "BEGIN IF first THEN BEGIN IF L=NIL THEN"\\
