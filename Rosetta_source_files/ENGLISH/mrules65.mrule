% TRANSFORMATION TQPofCOMPLCaseAssignment
< m1 : QP{QPrec2}[head/Q{Qrec1},
                  ofcomplrel/PREPP{PREPPrec1}
                         [mu1,
                          I1:complrel/T1
                         ]
                    ]

>
< m : QP{QPrec2}[head/Q{Qrec1},
                 ofcomplrel/PREPP{PREPPrec1}
                         [mu1,
                          I2:complrel/T2
                         ]
                    ]
>
   MATCHCONDITIONS
      <
       I1:T1.CAT IN [NP, NPVAR, CNVAR] WITH T1.REC.cases = []
       I2:T2.CAT IN [NP, NPVAR, CNVAR] WITH 
                               T2.REC.cases * [accusative] <> []
      >

<
   SUBRULE
      <T1: NPVAR{NPVARrec1} >
      <T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [accusative]
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := []
         >

   SUBRULE
      <T1: NP{NPrec1}[mu2]>
      <T2: NP{NPrec2}[mu3]>

      COMP
         <
          C1: true
          A1: QUOTE_AssignCase(NPrec1, mu2, NPrec2, mu3, [accusative])
         >
      DECOMP
         <
          C1: true
          A1: QUOTE_AssignCase(NPrec2, mu3, NPrec1, mu2, [])
         >

   SUBRULE
      <T1: CNVAR{CNVARrec1} >
      <T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [accusative]
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := []
         >
>

&

\end{verbatim}
