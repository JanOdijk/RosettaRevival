SPANISH 98
&
\newpage
\begin{verbatim}
%
% RULE Rnegvarintro1
< m1:CLAUSE{CLAUSErec1}
           [ I1:mu1,
             subjrel/T1,
             I2:mu2 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I1:mu1,
             subjrel/T1,
             negrel/NEGVAR{NEGVARrec1},
             I2:mu2 
           ]

>


   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1, [meltnegrel/..])
       I2: NOT EXIST(mu2, [I21:rel1/..])
           I21: rel1 IN [posrel, negrel]
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
