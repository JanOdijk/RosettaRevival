\newpage
\begin{verbatim}
% FILTER FPreConjSentControl
< m : CLAUSE{CLAUSErec1}[I1:mu1]
>

     MATCHCONDITIONS
      <
       I1: EXIST (mu1, [../I11::SENTENCE{SENTENCErec1}[I12:mu2]])
           OR 
           EXIST (mu1, [../PREPP{PREPPrec1}
                          [mu3, 
                           objrel/I14::NP{NPrec1}
                                 [head/I11::SENTENCE{SENTENCErec1}[I12:mu2]],
                           mu4
                          ]
                       ])
         I11: SENTENCErec1.adverbial = true AND
              SENTENCErec1.finiteness = infinite
         I12: NOT EXIST (mu2, [subjrel/T1])
         I14: NPrec1.NPhead = OpenIngNP
      >

         <
          C1: true
          A1: @
         >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] FPreConjSentControl
\item[* relevant examples:]
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_
ConjSentControl
\item[* date of creation:] 20-MAR-1989 
\item[* author:] margreet sanders
\item[* copied from:] Dutch FpreAdvCOntrol
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To prevent embedded adverbial subsentences from passing this 
optional transformation class without receiving a subject in analysis (such a 
path would run dry eventually; hence, this is a speed filter only)
\item[\ \ strategy:] (also: deviations from accepted proposals) A check is 
performed for the presence of any subject in the embedded clause; in case the 
subject is present but has been shifted, problems exist. 
