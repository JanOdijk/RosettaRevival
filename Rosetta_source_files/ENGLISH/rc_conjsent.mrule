ENGLISH 92

&
There are five rules to form adverbial subordinate clauses:
\begin{description}
 \item[RConjFinSubsent] finite subordinate adverbial clause introduced by a
                     conjunction: when he left
 \item[RConjIngSubsent] infinite subordinate adverbial ing-clause introduced 
                     by a conjunction: when leaving
 \item[RConjToInfSubsent] infinite subordinate adverbial to-inf clause
                     introduced by a conjunction: in order to leave
 \item[RPrepFinSubsent] finite subordinate adverbial clause introduced by a
                     preposition: before he left
 \item[RPrepIngSubsent] infinite subordinate adverbial ing-clause (possing or 
                     opening) headed by an NP and introduced by a
                     preposition: before leaving, without my noticing
\end{description}

\newpage
\begin{verbatim}
%
% RULE RConjFinSubsent
< m1: SENTENCE{SENTENCErec1}
              [ conjrel/CONJ(KEY_thatCONJkey){CONJrec1}, 
                mu1 ] 
  m2: CONJ{CONJrec2}
>

< m : SENTENCE{SENTENCErec2}
              [ conjrel/CONJ{CONJrec2}, 
                mu1 ] 
>
      COMP
         <
          C1: synTHATSENT IN CONJrec2.conjpatterns          AND
              CONJrec2.adverbial = true                     AND
              SENTENCErec1 =                  
		  {
		  senttype   : subordinateclause
		  conjkey    : KEY_thatCONJkey
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjdeixis : omegadeixis
		  conjaspect : omegaAspect
		  conjretro  : false
		  }
              C11: CONJrec2.temporal = false
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2 :=                  
		           {
		            conjkey    : CONJrec2.key
		            adverbial  : CONJrec2.adverbial
		            temporal   : CONJrec2.temporal
		            conjclass  : CONJrec2.class
		            conjdeixis : CONJrec2.deixis
		            conjaspect : CONJrec2.aspect
		            conjretro  : CONJrec2.retro
		           };

              C12: CONJrec2.temporal = true
                   C121: CONJrec2.class = duration OR
                         CONJrec2.class = frequential OR
                         (CONJrec2.class = reference AND
                          CONJrec2.retro = true)
                   A121: SENTENCErec2 := SENTENCErec1;
                         SENTENCErec2 :=                  
		           {
		            conjkey    : CONJrec2.key
		            adverbial  : CONJrec2.adverbial
		            temporal   : CONJrec2.temporal
		            conjclass  : CONJrec2.class
		            conjdeixis : CONJrec2.deixis
		            conjaspect : CONJrec2.aspect
		            conjretro  : CONJrec2.retro
		           };

                   C122: CONJrec2.class = reference AND
                         CONJrec2.retro = false AND
                         (((CONJrec2.aspect = omegaaspect OR
                            CONJrec2.aspect = perfective
                           ) AND
                           (SENTENCErec1.aspect = perfective)
                          ) OR
                          ((CONJrec2.aspect = omegaaspect OR
                            CONJrec2.aspect = imperfective
                           ) AND
                           (SENTENCErec1.aspect = imperfective)
                          )
                         ) 
                         C1221: (CONJrec2.deixis = presentdeixis) AND
                                (SENTENCErec1.deixis = presentdeixis)
                         A1221: SENTENCErec2 := SENTENCErec1;
                                SENTENCErec2.conjdeixis:= presentdeixis;
                         C1222: (CONJrec2.deixis = omegadeixis OR
                                 CONJrec2.deixis = pastdeixis
                                ) AND
                                (SENTENCErec1.deixis = pastdeixis)
                         A1222: SENTENCErec2 := SENTENCErec1;
                                SENTENCErec2.conjdeixis:= pastdeixis;
                         C1223: (CONJrec2.deixis = futuredeixis) OR
                                (CONJrec2.deixis = omegadeixis AND
                                 SENTENCErec1.deixis = presentdeixis)
                         A1223: SENTENCErec2 := SENTENCErec1;
                                SENTENCErec2.conjdeixis:= futuredeixis;
                   A122: SENTENCErec2 :=
      		           {
 	                    conjkey    : CONJrec2.key
                            adverbial  : CONJrec2.adverbial
	                    temporal   : CONJrec2.temporal
		            conjclass  : CONJrec2.class
		            conjaspect : CONJrec2.aspect
		            conjretro  : CONJrec2.retro
		           };

              A12:@
          A1: @
         >
      DECOMP
         <
          C1: synTHATSENT IN CONJrec2.conjpatterns          AND
              CONJrec2.adverbial = true 
              C1: CONJrec2.temporal = false AND
                  SENTENCErec2 =                  
		  {
		  senttype   : subordinateclause
		  conjkey    : CONJrec2.key
		  adverbial  : CONJrec2.adverbial
		  temporal   : CONJrec2.temporal
		  conjclass  : CONJrec2.class
		  conjdeixis : CONJrec2.deixis
		  conjaspect : CONJrec2.aspect
		  conjretro  : CONJrec2.retro
		  }
              A11: SENTENCErec1 := SENTENCErec2;
              C12: CONJrec2.temporal = true
                   C121: (CONJrec2.class = duration OR
                          CONJrec2.class = frequential OR
                          (CONJrec2.class  = reference AND
                           CONJrec2.retro = true)
                         ) AND
                         SENTENCErec2 =                  
		           {
		            conjkey    : CONJrec2.key
		            adverbial  : CONJrec2.adverbial
		            temporal   : CONJrec2.temporal
		            conjclass  : CONJrec2.class
		            conjdeixis : CONJrec2.deixis
		            conjaspect : CONJrec2.aspect
		            conjretro  : CONJrec2.retro
		           }
                   A121: SENTENCErec1 := SENTENCErec2;

                   C122: CONJrec2.class = reference AND 
                         CONJrec2.retro = false AND
                         (((CONJrec2.aspect = omegaaspect OR
                            CONJrec2.aspect = perfective
                           ) AND
                           (SENTENCErec2.aspect = perfective)
                          ) OR
                          ((CONJrec2.aspect = omegaaspect OR
                            CONJrec2.aspect = imperfective
                           ) AND
                           (SENTENCErec2.aspect = imperfective)
                          )
                         ) 
                         C1221: (CONJrec2.deixis = presentdeixis) AND
                                (SENTENCErec2.deixis = presentdeixis) AND
                                (SENTENCErec2.conjdeixis= presentdeixis)
                         A1221: SENTENCErec1 := SENTENCErec2;
                         C1222: (CONJrec2.deixis = omegadeixis OR
                                 CONJrec2.deixis = pastdeixis
                                ) AND
                                (SENTENCErec2.deixis = pastdeixis) AND
                                (SENTENCErec2.conjdeixis= pastdeixis)
                         A1222: SENTENCErec1 := SENTENCErec2;
                         C1223: ((CONJrec2.deixis = futuredeixis) OR
                                 (CONJrec2.deixis = omegadeixis AND
                                  SENTENCErec2.deixis = presentdeixis) 
                                )AND
                                SENTENCErec2.conjdeixis = futuredeixis
                         A1223: SENTENCErec1 := SENTENCErec2;
                   A122: @ 
              A12: @
          A1: SENTENCErec1 :=                  
		  {
		  conjkey    : KEY_thatCONJkey
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjdeixis : omegadeixis
		  conjaspect : omegaAspect
		  conjretro  : false
		  }
         >
&

\end{verbatim}
