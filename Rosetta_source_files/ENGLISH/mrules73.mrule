\newpage
\begin{verbatim}
% FILTER ftempindep1
< m:CLAUSE{CLAUSErec1}
           [mu1,
            I1:rel1/SENTENCE{SENTENCErec1}[mu2], 
            mu3
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [leftdislocrel, postsentadvrel] AND 
           SENTENCErec1.temporal = false
      >

         <
          C1:true
                 (* independent sentence *)
             C11: (
                  (SENTENCErec1.superdeixis = omegadeixis) AND
                  (((SENTENCErec1.deixis = presentdeixis) AND
                    ((QUOTE_temprefnotfound(mu2)) AND
                     (CLAUSErec1.deixis = presentdeixis) OR
                     (CLAUSErec1.superdeixis = presentdeixis) 
                    )  
                 ) OR
                   ((SENTENCErec1.deixis = pastdeixis) AND
                    ((QUOTE_temprefnotfound(mu2)) AND
                     (CLAUSErec1.deixis = pastdeixis) OR
                     (CLAUSErec1.superdeixis = pastdeixis)
                    ) 
                   ) 
                  )
                 )
             A11: @
         A1: @
      >  
&
\end{verbatim}
  \newpage
\begin{description}
\item[* name:] ftempindep1
\item[* relevant examples:]
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] Xproptoclause
\item[* class:] ?
\item[* date of creation:] 2-MAR-1989  
\item[* author:] Lisette Appelo
\item[* copied from:] Ftempindep1 Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 19/04/89\ \ \ \ \ author: Lisette Appelo\\
Changed conditions on relation of sentence. 
This filter should not apply to sentences 
with extraposrel, subjrel, complrel or objrel, 
because they are not treated in the recursive 
superdeixisadaptationrule11, but in the normal superdeixisadaptationrule1.
\item date: 27/06/89\ \ \ \ \ author: Lisette Appelo\\
Removed splitting into subrules.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Filter for independent temporal clauses in case:\\
1 present - present, without temporal adverbial\\
2 past - past, without temporal adverbial\\
these case are considered implausible within Rosetta3.
