andar    +     SFK3PlSubjPasa       ::  anduviesen ;
andar    +     SFKgerundio          ::  andando ;
andar    +     SFKPtcPasMascSg      ::  andado ;
andar    +     SFKPtcPasMascPl      ::  andados ;
andar    +     SFKPtcPasFemSg       ::  andada ;
andar    +     SFKPtcPasFemPl       ::  andadas ;


{ oír; added 4/5/90  EvM }

oír    +     SFK1SgIndPres        ::  oigo ;
oír    +     SFK2SgIndPres        ::  oyes ;
oír    +     SFK3SgIndPres        ::  oye ;
oír    +     SFK1PlIndPres        ::  oímos ;
oír    +     SFK2PlIndPres        ::  oís ;
oír    +     SFK3PlIndPres        ::  oyen ;
oír    +     SFK1Sg3SubjPres      ::  oiga ;
oír    +     SFK2SgSubjPres       ::  oigas ;
oír    +     SFK1PlSubjPres       ::  oigamos ;
oír    +     SFK2PlSubjPres       ::  oigáis ;
oír    +     SFK3PlSubjPres       ::  oigan ;
oír    +     SFK1Sg3Imperf        ::  oía ;
oír    +     SFK2SgImperf         ::  oías ;
oír    +     SFK1PlImperf         ::  oíamos ;
oír    +     SFK2PlImperf         ::  oíais ;
oír    +     SFK3PlImperf         ::  oían ;
oír    +     SFK1SgPD             ::  oí ;
oír    +     SFK2SgPD             ::  oíste ;
oír    +     SFK3SgPD             ::  oyó ;
oír    +     SFK1PlPD             ::  oímos ;
oír    +     SFK2PlPD             ::  oísteis ;
oír    +     SFK3PlPD             ::  oyeron ;
oír    +     SFK1SgFut            ::  oiré ;
oír    +     SFK2SgFut            ::  oirás ;
oír    +     SFK3SgFut            ::  oirá ;
oír    +     SFK1PlFut            ::  oiremos ;
oír    +     SFK2PlFut            ::  oiréis ;
oír    +     SFK3PlFut            ::  oirán ;
oír    +     SFK1Sg3Cond          ::  oiría ;
oír    +     SFK2SgCond           ::  oirías ;
oír    +     SFK1PlCond           ::  oiríamos ;
oír    +     SFK2PlCond           ::  oiríais ;
oír    +     SFK3PlCond           ::  oirían ;
oír    +     SFKsgImperat         ::  oye ;
oír    +     SFKplImperat         ::  oíd ;
oír    +     SFK1Sg3SubjPas       ::  oyera ;
oír    +     SFK2SgSubjPas        ::  oyeras ;
oír    +     SFK1PlSubjPas        ::  oyéramos ;
oír    +     SFK2PlSubjPas        ::  oyerais ;
oír    +     SFK3PlSubjPas        ::  oyeran ;
oír    +     SFK1Sg3SubjPasa      ::  oyese ;
oír    +     SFK2SgSubjPasa       ::  oyeses ;
oír    +     SFK1PlSubjPasa       ::  oyésemos ;
oír    +     SFK2PlSubjPasa       ::  oyeseis ;
oír    +     SFK3PlSubjPasa       ::  oyesen ;
oír    +     SFKgerundio          ::  oyendo ;
oír    +     SFKPtcPasMascSg      ::  oído ;
oír    +     SFKPtcPasMascPl      ::  oídos ;
oír    +     SFKPtcPasFemSg       ::  oída ;
oír    +     SFKPtcPasFemPl       ::  oídas ;


{--------------------------------einde V }



{ clitics; assuming both masc. and fem. forms are included in the lexicon,
  (i.e. BCAT) : 
          yo
          tú
          él
          ella
          usted
          nosotros
          nosotras
          vosotros
          vosotras
          ellos
          ellas
          ustedes
          ello   (neuter)                                            }

{ direct object clitics }

yo         +   SFKcliticOD    ::  me ;
tú         +   SFKcliticOD    ::  te ;
él         +   SFKcliticOD    ::  lo ;
él         +   SFKcliticOD1   ::  le ;
ella       +   SFKcliticOD    ::  la ;
usted      +   SFKcliticODm   ::  le ;
usted      +   SFKcliticODf   ::  la ;
nosotros   +   SFKcliticOD    ::  nos ;
nosotras   +   SFKcliticOD    ::  nos ;
vosotros   +   SFKcliticOD    ::  os ;
vosotras   +   SFKcliticOD    ::  os ;
ellos      +   SFKcliticOD    ::  los ;
ellos      +   SFKcliticOD1   ::  les ;
ellas      +   SFKcliticOD    ::  las ;
ustedes    +   SFKcliticODm   ::  les ;
ustedes    +   SFKcliticODf   ::  las ;
ello       +   SFKcliticOD    ::  lo ;

{ indirect object clitics }
    
yo         +   SFKcliticOI    ::  me ;
tú         +   SFKcliticOI    ::  te ;
él         +   SFKcliticOI    ::  le ;
ella       +   SFKcliticOI    ::  le ;
usted      +   SFKcliticOI    ::  le ;
nosotros   +   SFKcliticOI    ::  nos ;
nosotras   +   SFKcliticOI    ::  nos ;
vosotros   +   SFKcliticOI    ::  os ;
vosotras   +   SFKcliticOI    ::  os ;
ellos      +   SFKcliticOI    ::  les ;
ellas      +   SFKcliticOI    ::  les ;
ustedes    +   SFKcliticOI    ::  les ;
ello       +   SFKcliticOI    ::  le ;

{ strong pronouns }

yo         +   SFKpronFuerte    ::  mí ;
tú         +   SFKpronFuerte    ::  ti ;
él         +   SFKpronFuerte    ::  él ;
ella       +   SFKpronFuerte    ::  ella ;
usted      +   SFKpronFuerte    ::  usted ;
nosotros   +   SFKpronFuerte    ::  nosotros ;
nosotras   +   SFKpronFuerte    ::  nosotras ;
vosotros   +   SFKpronFuerte    ::  vosotros ;
vosotras   +   SFKpronFuerte    ::  vosotras ;
ellos      +   SFKpronFuerte    ::  ellos ;
ellas      +   SFKpronFuerte    ::  ellas ;
ustedes    +   SFKpronFuerte    ::  ustedes ;
ello       +   SFKpronFuerte    ::  ello ;

{ reflexive clitics are BCATs! They are dealt with in the M-grammar }

{ reflexive strong pronouns idem }  

{ possessive pronouns; unstressed forms }
{ Possessive pronouns function as ADJ; therefore the plural is formed by
  adding -s, like other ADJs ending on a vowel.                          }

yo         +   SFKposAdjSing      ::  mi ;
tú         +   SFKposAdjSing      ::  tu ;
él         +   SFKposAdjSing      ::  su ;
ella       +   SFKposAdjSing      ::  su ;
usted      +   SFKposAdjSing      ::  su ;
nosotros   +   SFKposAdjSing      ::  nuestro ;
nosotras   +   SFKposAdjSing      ::  nuestra ;
vosotros   +   SFKposAdjSing      ::  vuestro ;
vosotras   +   SFKposAdjSing      ::  vuestra ;
ellos      +   SFKposAdjSing      ::  su ;
ellas      +   SFKposAdjSing      ::  su ;
ustedes    +   SFKposAdjSing      ::  su ;

yo         +   SFKposAdjPlur      ::  mis ;
tú         +   SFKposAdjPlur      ::  tus ;
él         +   SFKposAdjPlur      ::  sus ;
ella       +   SFKposAdjPlur      ::  sus ;
usted      +   SFKposAdjPlur      ::  sus ;
nosotros   +   SFKposAdjPlur      ::  nuestros ;
nosotras   +   SFKposAdjPlur      ::  nuestras ;
vosotros   +   SFKposAdjPlur      ::  vuestros ;
vosotras   +   SFKposAdjPlur      ::  vuestras ;
ellos      +   SFKposAdjPlur      ::  sus ;
ellas      +   SFKposAdjPlur      ::  sus ;
ustedes    +   SFKposAdjPlur      ::  sus ;


{ possessive pronouns; stressed forms; also functioning as ADJ }

{ masc. }

{ I assume that the articles are all included in the lexicon, so no 
  morfological rules have to be written for them.                        }

{----------------------------------------------------------}

yo         +   SFKposAdjFuerte    ::  mío ;
tú         +   SFKposAdjFuerte    ::  tuyo ;
él         +   SFKposAdjFuerte    ::  suyo ;
usted      +   SFKposAdjFuerte    ::  suyo ;
nosotros   +   SFKposAdjFuerte    ::  nuestro ;
vosotros   +   SFKposAdjFuerte    ::  vuestro ;
ellos      +   SFKposAdjFuerte    ::  suyo ;
ustedes    +   SFKposAdjFuerte    ::  suyo ;

{-----------------------------------------------------------}


ambos      +   SFKmascDETpl       ::  ambos ;
ambos      +   SFKfemDETpl        ::  ambas ;
varios     +   SFKmascDETpl       ::  varios ;
varios     +   SFKfemDETpl        ::  varias ;


todo       +   SFKmascDETsg       ::  todo ;
todo       +   SFKfemDETsg        ::  toda ;
todo       +   SFKmascDETpl       ::  todos ;
todo       +   SFKfemDETpl        ::  todas ;

mucho      +   SFKmascDETsg       ::  mucho ;
mucho      +   SFKfemDETsg        ::  mucha ;
mucho      +   SFKmascDETpl       ::  muchos ;
mucho      +   SFKfemDETpl        ::  muchas ;

uno        +   SFKmascDETsg       ::  un ;    { EvM added 23 October 1989 }
uno        +   SFKfemDETsg        ::  una ;
uno        +   SFKmascDETpl       ::  unos ;
uno        +   SFKfemDETpl        ::  unas ;

alguno     +   SFKmascDETsg       ::  algún ;
alguno     +   SFKfemDETsg        ::  alguna ;
alguno     +   SFKmascDETpl       ::  algunos ;
alguno     +   SFKfemDETpl        ::  algunas ;

ninguno    +   SFKmascDETsg       ::  ningún ;
ninguno    +   SFKfemDETsg        ::  ninguna ;


{ NB. "algún"/"ningún" also before fem.nouns starting on a 
      stressed vowel }


{------------------------------------------------}

*e      +    SFKmente         ::  *emente ;   { 21/3/89  EvM }
*a      +    SFKmente         ::  *amente ;   { 21/3/89  EvM }

{------------------------------------------------}
{regels voor Digits:}

{Cardinals: 133, 1968, 10003, etc.}

   *(DG)       + SFK0        :: *(DG)0;
   *(DG)       + SFK1        :: *(DG)1;
   *(DG)       + SFK2        :: *(DG)2;
   *(DG)       + SFK3        :: *(DG)3;
   *(DG)       + SFK4        :: *(DG)4;
   *(DG)       + SFK5        :: *(DG)5;
   *(DG)       + SFK6        :: *(DG)6;
   *(DG)       + SFK7        :: *(DG)7;
   *(DG)       + SFK8        :: *(DG)8;
   *(DG)       + SFK9        :: *(DG)9;

   *(DG)       + SFKo        :: *(DG)o;

END
