          C1: SENTENCErec2.supertiempo = ADVPrec1.supertiempo
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := declxpmood;
              SENTENCErec1 := SENTENCerec2;
              SENTENCErec1.supertiempo := omegatiempo          
>

