object amb2_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
        XmNdialogTitle = N_amb_window;
        XmNnoResize    = true;
    };
    controls {
        XmRowColumn amb2_button_box;
        XmForm amb2_form1;
        XmForm amb2_form2;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_amb2_window + DEFAULT_BUTTON_OFFSET*X_amb2_ok_button);
    };
};

object amb2_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;
	XmNresizable        = false;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
	XmPushButton amb2_ok_button;
	XmPushButton amb2_help_button;
    };
};

object amb2_ok_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString       = N_amb_ok_button;
        XmNsensitive         = false;
    };
    callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_amb2_ok_button);
        XmNactivateCallback = procedure XwbAction (X_amb2_ok_button);
    };
};

object amb2_help_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString       = N_amb_help_button;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb2_help_button);
        XmNactivateCallback = procedure XwhAction (X_amb2_help_button);
    };
};

object amb2_form1 : XmForm {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn amb2_button_box;

        arguments form_args;
    };
    controls {
        XmFrame amb2_stem1;
        XmScrolledList amb2_list1;
    };
};

object amb2_stem1 : XmFrame {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
     	XmNrightAttachment  = XmATTACH_FORM;
    };
    controls {
        XmRowColumn {
            arguments {
                XmNorientation      = XmHORIZONTAL;
            };
            controls {
	        XmLabel amb2_stem1_label;
                XmLabel amb2_stem1_text;
            };
        };
    };
};

object amb2_stem1_label : XmLabel {
    arguments {
        arguments label_args;
	XmNlabelString      = N_amb_stem_text;
    };
};

object amb2_stem1_text : XmLabel {
    arguments {
        arguments text_args;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb2_stem1_text);
    };
};

object amb2_list1 : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame amb2_stem1;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments list_args;
        XmNvisibleItemCount = 9;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;

        XmNitemCount = 1;
        XmNitems = string_table ( '<jur.>' );
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb2_mean1_list);
        XmNdefaultActionCallback = procedure XwbAction (X_amb2_ok_button);
    };
};

object amb2_form2 : XmForm {
    arguments {
     	XmNleftAttachment   = XmATTACH_WIDGET;
        XmNleftWidget       = XmForm amb2_form1;
        XmNleftOffset       = 0;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn amb2_button_box;
        XmNrightAttachment  = XmATTACH_FORM;

        arguments form_args;
    };
    controls {
        XmFrame amb2_stem2;
        XmScrolledList amb2_list2;
    };
};

object amb2_stem2 : XmFrame {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
     	XmNrightAttachment  = XmATTACH_FORM;
    };
    controls {
        XmRowColumn {
            arguments {
                XmNorientation      = XmHORIZONTAL;
            };
            controls {
	        XmLabel amb2_stem2_label;
                XmLabel amb2_stem2_text;
            };
        };
    };
};

object amb2_stem2_label : XmLabel {
    arguments {
        arguments label_args;
	XmNlabelString      = N_amb_stem_text;
    };
};

object amb2_stem2_text : XmLabel {
    arguments {
        arguments text_args;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb2_stem2_text);
    };
};

object amb2_list2 : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame amb2_stem2;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments list_args;
        XmNvisibleItemCount = 9;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;

        XmNitemCount = 2;
        XmNitems = string_table ( 'door velen gekend', 
                                  'kennis hebbende van' );
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb2_mean2_list);
        XmNdefaultActionCallback = procedure XwbAction (X_amb2_ok_button);
    };
};
