\begin{verbatim}
%
% FILTER FDOclplusPERSPRO
< m:I1::CLAUSE{CLAUSErec1}
            [ mu1,
              cliticrel/CLITIC{}[mu7],
              head/I5::VERB{VERBrec1}[mu3],
              predrel/VERBP{VERBPrec1}[ mu4,
                                        I3:rel1/I4::NP{NPrec1}[mu5],
                                        mu6 
                                      ],
              mu9
            ]
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = finite  AND
           (CLAUSErec1.voice <> SEpassive)
        (*   AND
           (NPrec1.animate = noanimate ->
             NOT EXIST (mu1, [subjrel/I61::NP{NPrec6}])) 
       I61: NPrec6.NPhead = Seimpershead  *)
       I3: rel1 IN [objrel, predrel]
       I4: (NPrec1.NPhead = persproNP)  AND
           (Prepositive IN NPrec1.cases)
       I5: NOT (VERBrec1.thetavp IN [vp010, vp012, vp021]
      >
<
   SUBRULE  (* me + (a!) mí; masc. *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [unoCLrel/..]))  AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel]  
       I12:  (NOT EXIST(mu12, [unoCLrel/..]))  AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: @
         >
SUBRULE  (* me + (a!) mí; masc.; IO tu *)
      <mu7: [I11:mu11, 
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu21],
             I12:mu12]>                                     


   MATCHCONDITIONS
      <
       I13:  PERSPROrec2.numero = singular
       I11:  (NOT EXIST(mu11, [unoCLrel/..]))  AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel]
       I12:  (NOT EXIST(mu12, [unoCLrel/..]))  AND
             ALL (mu12, tresCLrel/..) 

      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: @
         >

   SUBRULE  (* me + (a!) mí; fem. *)
      <mu7: [I11:mu11, I12:mu12]>                                       

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [unoCLrel/..]))  AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel]  
       I12:  (NOT EXIST(mu12, [unoCLrel/..]))  AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)
          A1: @
         >

SUBRULE  (* me + (a!) mí; fem.; IO tú *)
      <mu7: [I11:mu11, 
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu21],
             I12:mu12]>                                     


   MATCHCONDITIONS
      <
       I13:  PERSPROrec2.numero = singular
       I11:  (NOT EXIST(mu11, [unoCLrel/..]))  AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel]
       I12:  (NOT EXIST(mu12, [unoCLrel/..]))  AND
             ALL (mu12, tresCLrel/..) 
       >

       
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: @
         >


   SUBRULE  (* te + (a!) ti; masc. *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [dosCLrel/..]))   AND
             ALL (mu11, seCLrel/..)
       I12:  (NOT EXIST(mu12, [dosCLrel/..]))   AND
             ALL (mu12, I121:rel6/..)
       I121: rel6 IN [unoCLrel, tresCLrel]
      >

         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: @
         >


   SUBRULE  (* te + (a!) ti; fem. *)
      <mu7: [I11:mu11, I12:mu12]>                                       

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [dosCLrel/..]))   AND
             ALL (mu11, seCLrel/..)
       I12:  (NOT EXIST(mu12, [dosCLrel/..]))   AND
             ALL (mu12, I121:rel6/..)
       I121: rel6 IN [unoCLrel, tresCLrel]
      >

         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)
          A1: @
         >



   SUBRULE  (* lo + (a!) él/usted *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: @
         >



SUBRULE  (* le + (a!) él/usted *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc)
          A1: @
         >



   SUBRULE  (* la + (a!) ella/usted *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel] 
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)
          A1: @
         >



   SUBRULE  (* nos + (a!) nosotros (masc) *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [unoCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu11, [unoCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: @
         >

   SUBRULE  (* nos + (a!) nosotras (fem) *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [unoCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [unoCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: @
         >



   SUBRULE  (* os + (a!) vosotros (masc) *)
      <mu7: [I11:mu11, I12:mu12]>                                       
 

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [dosCLrel/..]))   AND
             ALL (mu11, seCLrel/..)
       I12:  (NOT EXIST(mu12, [dosCLrel/..]))   AND
             ALL (mu12, I121:rel6/..)
       I121: rel6 IN [unoCLrel, tresCLrel]      
      >

         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: @
         >



   SUBRULE  (* os + (a!) vosotras (fem) *)
      <mu7: [I11:mu11, I12:mu12]>                                       
 

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [dosCLrel/..]))   AND
             ALL (mu11, seCLrel/..)
       I12:  (NOT EXIST(mu12, [dosCLrel/..]))   AND
             ALL (mu12, I121:rel6/..)
       I121: rel6 IN [unoCLrel, tresCLrel]      
      >

         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: @
         >


   SUBRULE  (* los + (a) ellos/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: @
         >



   SUBRULE  (* les + (a) ellos/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: @
         >

   SUBRULE  (* les + (a) ellas/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       
 
   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

          <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: @
         >

>

&

