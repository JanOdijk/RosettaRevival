pragma C_Include('strings.pf');
pragma C_Include('str.pf');
pragma C_Include('limorfdef.pf');
pragma C_Include('lidomaint.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
PACKAGE LDSTRTOTYPE;

WITH STR,
     LIMORFDEF,
     LIDOMAINT,
     STRINGS;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDSTRTOTYPE_Affix
 *  Description    : Converts strings to affixkey values (if possible)
 *  Parameters     : str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   l  : length of str
 *                   VAR afx: INTEGER; affix key value
 *  Result         : boolean;
 *  Precondition   : none
 *  Postcondition  : IF EXIST(affix): name(affixkey)=str THEN
 *                      afx := value(affix) AND 
 *                      LDSTRTOTYPE_Affix := true
 *                   ELSE
 *                      LDSTRTOTYPE_Affix := false
 *  Side Effects   : none
 *
 *EMP:::===================================================================*)

FUNCTION LDSTRTOTYPE_Affix(
           CONST str: STRING;
           l: STR_Range;
           VAR afx: INTEGER): BOOLEAN; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDSTRTOTYPE_CC
 *  Description    : Converts strings to Context Cond. values (if possible)
 *  Parameters     : str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   l  : length of str
 *                   VAR cxt: LIMORFDEF_contextconds; c.c. value
 *  Result         : boolean;
 *  Precondition   : none
 *  Postcondition  : IF EXIST(cc): name(cc)=str THEN
 *                      cxt := value(cc) AND 
 *                      LDSTRTOTYPE_CC := true
 *                   ELSE
 *                      LDSTRTOTYPE_CC := false
 *  Side Effects   : none
 *
 *EMP:::===================================================================*)

FUNCTION LDSTRTOTYPE_CC(
           CONST str: STRING;
           l: STR_Range;
           VAR cxt: LIMORFDEF_contextconds): BOOLEAN; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDSTRTOTYPE_FON
 *  Description    : Converts strings to Phonetic Cond. values (if possible)
 *  Parameters     : str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   l  : length of str
 *                   VAR ph: LIMORFDEF_phonmarker; p.c. value
 *  Result         : boolean;
 *  Precondition   : none
 *  Postcondition  : IF EXIST(fon): name(fon)=str THEN
 *                      cxt := value(fon) AND 
 *                      LDSTRTOTYPE_FON := true
 *                   ELSE
 *                      LDSTRTOTYPE_FON := false
 *  Side Effects   : none
 *
 *EMP:::===================================================================*)

FUNCTION LDSTRTOTYPE_FON(
           CONST str: STRING;
           l: STR_Range;
           VAR ph: LIMORFDEF_phonmarker): BOOLEAN; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDSTRTOTYPE_Cat
 *  Description    : Converts strings to Category values (if possible)
 *  Parameters     : str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   l  : length of str
 *                   VAR cat: LIDOMAINT_syntcat; cat. value
 *  Result         : boolean;
 *  Precondition   : none
 *  Postcondition  : IF EXIST(category): name(category)=str THEN
 *                      cat := value(category) AND 
 *                      LDSTRTOTYPE_CAT := true
 *                   ELSE
 *                      LDSTRTOTYPE_CAT := false
 *  Side Effects   : none
 *
 *EMP:::===================================================================*)

FUNCTION LDSTRTOTYPE_Cat(
           CONST str: STRING;
           l: STR_Range;
           VAR cat: LIDOMAINT_syntcat): BOOLEAN; EXTERNAL;
END{LDSTRTOTYPE};
