                                      mu7
                                    ],
                          byobjrel/VARPREPP{VARPREPPrec1}
                                  [ mu8, 
                                    objrel/T1, 
                                    mu9
                                  ], 
                          mu3 
                        ],
                 mu4
               ]
 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [subjrel/..])
       I2: agvpadv IN ADVPrec1.actsubcefs
      >

   PARAMETERS
      <
       LEVEL
      >

