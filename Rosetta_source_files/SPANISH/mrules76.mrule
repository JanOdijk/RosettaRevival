         <
          C1: attributive IN ADJPrec2.uses AND
              (ADJPrec1.posicion IN [postposicion, ambosposicion] ) AND
              (ADJPrec1.numero = CNrec1.numero) AND
              (ADJPrec1.genero IN CNrec1.generos) 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.uses := [attributive, nominalised];
              OPENADJPPROPrec1 := COPYT_ADJPtoADJPPROP(ADJPrec1);
              OPENADJPPROPrec1.supertiempo := CNrec1.supertiempo;
              OPENADJPPROPrec1.PROsubject := true;
              OPENADJPPROPrec1.aktionsarts := [stative];
              CNVARrec1 := COPYT_CNtoVAR(CNrec1);
              CNVARrec1.index := LEVEL

         >
&

