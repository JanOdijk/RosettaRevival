SPANISH 25
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Vclustering1

< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             predrel/VERBP{VERBPrec1}
                  [ I2:sig1,
                    I3:mu2,
                    cliticrel/CLITIC{}[mu4],
                    mu5
                  ],
             mu6
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             I2:sig1,
             cliticrel/CLITIC{}[mu4],
             mu7,
             predrel/VERBP{VERBPrec1}[mu5],
             mu6
           ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = finite
       I2: ALL(sig1, vpadvrel/ADVP{ADVPrec1}
                       [ head/ADV{ADVrec1}
                            [ head/SUBADV{SUBADVrec1}
                                 [ head/BADV(AUX_yaBADVkey){BADVrec1}]
                            ]
                       ]
              )
       I3: ALL (mu2, I4:rel1/..)
       I4: rel1 IN [auxrel, head]
      >

<
   SUBRULE (* no verbraising *)
      <mu2: [ I5:mu8, head/I6::VERB{VERBrec1}[mu3]]>
      <mu7: [head/I7::VERB{VERBrec2}
                  [I5:mu8,
                   head/I6::VERB{VERBrec1}[mu3]
                  ]
             ] >

   MATCHCONDITIONS
      <
       I5: ALL (mu8,  auxrel/..)
       I6: VERBrec1.status IN [ bareV]
       I7: VERBrec2.status = VV
      >

      COMP
         <
          C1: true
          A1: VERBrec2 := VERBrec1;
             (* especially VERBrec2.modo has to be known, for VerbRaising *)
              VERBrec2.status := VV;
              VERBrec2.numero := omeganumero;
              VERBrec2.genero := omegagenero;
             (* numero and genero have to be omega for the agreementrules *)
         >

      DECOMP
         <
          C1: (VERBrec2 = VERBrec1 EXCEPT FOR [ status,numero,genero ])
                                              AND
              (VERBrec2.status = VV)          AND
              (VERBrec2.numero = omeganumero) AND
              (VERBrec2.genero = omegagenero)
          A1:  @
         >

   SUBRULE (*  verbraising, auxiliaries in matrix *)
      <mu2: [ I5:mu8, head/I6::VERB{VERBrec1}[mu3]]>
      <mu7: [head/I7::VERB{VERBrec2}
                  [I5:mu8,
                   head/I6::VERB{VERBrec1}[mu3]
                  ]
             ] >

   MATCHCONDITIONS
      <
       I5: ALL (mu8,  auxrel/..) AND
           EXIST (mu8, [auxrel/..]) 
       I6: VERBrec1.status IN [ VV]
       I7: VERBrec2.status = VV
      >

      COMP
         <
          C1: true
          A1: VERBrec2 := VERBrec1;
             (* especially VERBrec2.modo has to be known, for VerbRaising *)
              VERBrec2.status := VV;
              VERBrec2.numero := omeganumero;
              VERBrec2.genero := omegagenero;
             (* numero and genero have to be omega for the agreementrules *)
         >

      DECOMP
         <
          C1: (VERBrec2 = VERBrec1 EXCEPT FOR [ status,numero,genero ]) 
                                                 AND    
              (VERBrec2.status = VV)             AND
              (VERBrec2.numero = omeganumero)   AND
              (VERBRec2.genero = omegagenero)
          A1:  @
         >

   SUBRULE (*  verbraising, no auxiliaries in matrix *)
      <mu2: [ I5:mu8, head/I6::VERB{VERBrec1}[mu3]]>
      <mu7: [head/I7::VERB{VERBrec2}
                  [mu3]
             ] >
   MATCHCONDITIONS
      <
       I5: ALL (mu8, auxrel/..) AND
           NOT EXIST (mu8, [auxrel/..]) 
       I6: VERBrec1.status IN [ VV]
       I7: VERBrec2.status = VV
      >

      COMP
         <
          C1: true
          A1: VERBrec2 := VERBrec1;
             (* especially VERBrec2.modo has to be known, for VerbRaising *)
              VERBrec2.status := VV;
              VERBrec2.numero := omeganumero;
              VERBrec2.genero := omegagenero;
             (* numero and genero have to be omega for the agreementrules *)
         >

      DECOMP
         <
          C1: (VERBrec2 = VERBrec1 EXCEPT FOR [ status,numero,genero ]) 
                                                    AND
              (VERBrec2.status = VV)                AND
              (VERBRec2.numero = omeganumero)       AND
              (VERBrec2.genero = omegagenero)
          A1:  @
         >

>
&


\end{verbatim}
\newpage
\begin{description}
\item[* name:] Vclustering1
\item[* relevant examples:]
\'{e}l [nada] $\rightarrow$ \'{e}l nada [] \\
\'{e}l [ha nadado] $\rightarrow$ \'{e}l ha nadado [] \\
\'{e}l [ya ha comprado lo] $\rightarrow$ \'{e}l ya lo ha comprado
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPTOCLAUSE
\item[* class:] TC:vclustering
\item[* date of creation:] 16-JUN-1988 10:30:00  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 26/08/88\ \ \ \ \ author: Lisette Appelo
\item date: 13/01/89\ \ \ \ \ author: Lisette Appelo\\
Split up in three subrules, because of problems with verbraising structures
and agreement and moodrules later on.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To create a V-Cluster node under the (finite!) CLAUSE; 
at the same time 
the CLITIC-node is put in the position to the left of this node.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item  sig1 is meant for the optional "ya".\\
\item  This rule is not reversible in this version (26/8/88). In generation the 
cluster verb node is copied from the head verb. If this head is a participle, 
it has values other than omega for numero and  genero, so these values are set 
to omega, because the agreement rules expect this. (LA)
\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% TRANSFORMATION Vclustering2
< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             predrel/VERBP{VERBPrec1}
                  [ I2:sig1,
                    I3:mu2,
                    head/I5::VERB{VERBrec1}[mu3],
                    cliticrel/CLITIC{CLITICrec1}[mu4],
                    mu5
                  ],
             mu6
           ]
>

< m:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             predrel/VERBP{VERBPrec1}
                  [ I2:sig1,
                    I3:mu2,
                    head/I5::VERB{VERBrec1}[mu3],
                    cliticrel/CLITIC{CLITICrec1}[mu4],
                    mu5
                  ],
             mu6
           ]
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = infinite
       I2: ALL(sig1, vpadvrel/ADVP{ADVPrec1}
                       [ head/ADV{ADVrec1}
                            [ head/SUBADV{SUBADVrec1}
                                 [ head/BADV(AUX_yaBADVkey){BADVrec1}]
                            ]
                       ]
              )
       I3: ALL (mu2, auxrel/..)
       I5: VERBrec1.status IN [ bareV, VV ]
      >


      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&


\end{verbatim}
