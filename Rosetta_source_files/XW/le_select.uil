/* select: select lemma window */

object le_select_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
	XmNdialogTitle	= 'Lemma Selection';
        XmNnoResize    = true;
    };
    controls {
        XmRowColumn le_select_stem;
        XmRowColumn le_select_category;
        XmSeparator le_select_separator;
	XmRowColumn le_select_button_box;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_le_select_window + DEFAULT_BUTTON_OFFSET*X_le_select_ok_button);
    };
};

object le_select_stem : XmRowColumn {
    arguments {
	XmNtopAttachment    = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmLabel {
	    arguments {
                arguments label_args;
	        XmNlabelString	= 'Stem: ';
	    };
	};
        XmText {
            arguments {
                arguments text_args;
                XmNcolumns           = 40;
                XmNvalue = ''; 
            };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget
                             (X_le_select_stem);
            };
        };
    };
};

object le_select_category : XmRowColumn {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmRowColumn le_select_stem;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmLabel {
	    arguments {
                arguments label_args;
	        XmNlabelString	= 'Category: ';
	    };
	};
        XmText {
            arguments {
                arguments text_args;
                XmNcolumns           = 25;
                XmNvalue = ''; 
            };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget
                             (X_le_select_category);
            };
        };
    };
};

object le_select_separator : XmSeparator {
    arguments {
        XmNleftAttachment    = XmATTACH_FORM;
        XmNrightAttachment   = XmATTACH_FORM;
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmRowColumn le_select_category;

        XmNleftOffset        = 0;
        XmNrightOffset       = 0;
        XmNmargin            = 0;
    };
};

object le_select_button_box : XmRowColumn {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmSeparator le_select_separator;
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= 'OK';
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_le_select_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_le_select_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= 'Cancel';
	    };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_le_select_cancel_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_le_select_cancel_button);
   	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= 'Help';
	    };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_le_select_help_button);
 		XmNactivateCallback = procedure XwhAction (X_le_select_help_button);
   	    };
	};
    };
};

 
