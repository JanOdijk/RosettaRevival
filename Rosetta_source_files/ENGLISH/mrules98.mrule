% RULE RDemproWhIdentSg
< m1: I3::NPVAR{NPVARrec1}
  m2: I1::NP{NPrec1}[mu1]
>

< m : NPPROP{NPPROPrec1}
            [ subjrel/I2::NP{NPrec2}[mu1],
              idrel/I3::NPVAR{NPVARrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: NPrec1.NPhead IN [itNP, thisNP, thatNP] AND
           NPrec1.number = singular
       I2: NPrec2.NPhead IN [itNP, thisNP, thatNP] AND
           NPrec2.number = singular
       I3: NPVARrec1.NPhead = whatwhproNP AND
           NPVARrec1.number = singular
      >

      COMP
         <
          C1: NPrec1.superdeixis = presentdeixis AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of NPPROP remains default *)
         >
      DECOMP
         <
          C1: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts] AND
              NPPROPrec1.aktionsarts = [stative] AND
              NPrec2.superdeixis = omegadeixis AND
              NPrec2.generic = omegageneric
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := presentdeixis;
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
