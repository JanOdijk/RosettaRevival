\newpage
\begin{verbatim}
% RULE RADVPCOMPARISONcomplmod  (* as .. as Jan , as .. as before *)

< m1: ADVP{ADVPrec1}[head/ADV{ADVrec1}[mu1]]
  m2: T1
>

< m : ADVP{ADVPrec2}
                [head/ADV{ADVrec1}[mu1],
                 thanascomplrel/THANP{THANPrec1}
                       [head/THANAS(KEY_asthanaskey){THANASrec1},
                        I2:complrel/T2
                       ]
                ]

>


   MATCHCONDITIONS
      <m1: (ADVPrec1.thanas = ascompl) 
       I2: T2.cat IN [NPVAR, CNVAR, ADVP, ADJP, PREPP]
       m2: T1.cat IN [ NPVAR, CNVAR, ADVP, OPENADJPPROP, PREPP]
 
      >
<

    SUBRULE (* 1  ADVP *)
      <T1: ADVP{ADVPrec3}[mu2] >
      <T2: ADVP{ADVPrec4}[mu2] >

     COMP
         <
          C1: ADVPrec3.superdeixis = ADVPrec1.superdeixis
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.thanascompl := true;
              ADVPrec4 := ADVPrec3;
              ADVPrec4.superdeixis := omegadeixis;

         >
      DECOMP
         <
          C1: ADVPrec4.superdeixis = omegadeixis 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := ascompl;
              ADVPrec1.thanascompl := false;
              ADVPrec3 := ADVPrec4;
              ADVPrec3.superdeixis := ADVPrec1.superdeixis;

         >

    SUBRULE (* 2  ADJP *) (* 04-01-90;FJ *)  (* as ... as possible *)
      <T1: OPENADJPPROP{OPENADJPPROPrec3}
                  [subjrel/EMPTY(KEY_zeroemptykey){EMPTYrec1},
                   predrel/ADJP{ADJPrec3}[mu2] 
                  ]
      >

      <T2: ADJP{ADJPrec3}[mu2] >


     COMP
         <
          C1: OPENADJPPROPrec3.superdeixis = ADVPrec1.superdeixis
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.thanascompl := true;

         >
      DECOMP
         <
          C1: true
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := ascompl;
              ADVPrec1.thanascompl := false;
              OPENADJPPROPrec3 := COPYT_ADJPtoADJPPROP(ADJPrec3);
              OPENADJPPROPrec3.aktionsarts := [stative];
              OPENADJPPROPrec3.prosubject := true;
              OPENADJPPROPrec3.superdeixis := ADVPrec1.superdeixis;

         >

    SUBRULE (* 3 PREPP *)
      <T1: PREPP{PREPPrec1}[mu2] >
      <T2: PREPP{PREPPrec2}[mu2] >

     COMP
         <
          C1: PREPPrec1.superdeixis = ADVPrec1.superdeixis
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.thanascompl := true;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := omegadeixis;

         >
      DECOMP
         <
          C1: PREPPrec2.superdeixis = omegadeixis 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := ascompl;
              ADVPrec1.thanascompl := false;
              PREPPrec1 := PREPPrec2;
              PREPPrec1.superdeixis := ADVPrec1.superdeixis;

         >

    SUBRULE (* 4 NPVAR *)
      <T1: NPVAR{NPVARrec1}>
      <T2: NPVAR{NPVARrec1}>

     COMP
         <
          C1: NPVARrec1.cases = []
          A1: ADVPrec2 := ADVPrec1;
         >
      DECOMP
         <
          C1: NPVARrec1.cases = []
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := ascompl;

         >

    SUBRULE (* 5 CNVAR *)
      <T1: CNVAR{CNVARrec1}>
      <T2: CNVAR{CNVARrec2}>

     COMP
         <
          C1: CNVARrec1.cases = []
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.thanascompl := true;
              CNVARrec2 := CNVARrec1;
         >
      DECOMP
         <
          C1: CNVARrec1.cases = []
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := ascompl;
              ADVPrec1.thanascompl := false;
              CNVARrec1 := CNVARrec2;

         >
>
&

\end{verbatim}
