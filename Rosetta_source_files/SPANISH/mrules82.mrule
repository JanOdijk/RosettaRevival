\newpage
\begin{verbatim}
% TRANSFORMATION Tppca1
< m1:PREPPFORMULA{PREPPFORMULArec1}
        [mu1,
         predrel/PREPP{PREPPrec1}[mu2, objrel/T1] 
        ]
>

< m :PREPPFORMULA{PREPPFORMULArec1}
        [mu1,
         predrel/PREPP{PREPPrec1}[mu2, objrel/T2] 
        ]
>

<
   SUBRULE
      <T1:NPVAR{NPVARrec1} >
      <T2:NPVAR{NPVARrec2} >


      COMP
         <
          C1: NPVARrec1.cases = []
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Prepositive];
         >
      DECOMP
         <
          C1: Prepositive IN NPVARrec2.cases
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [];
         >

   SUBRULE
      <T1:CNVAR{CNVARrec1} >
      <T2:CNVAR{CNVARrec2} >


      COMP
         <
          C1: CNVARrec1.cases = []
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Accusative];
         >
      DECOMP
         <
          C1: Accusative IN CNVARrec2.cases
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [];
         >

>
&

\end{verbatim}
