\begin{verbatim}
% RULE RConjIngSubsent
< m1: SENTENCE{SENTENCErec1}
              [ I1:mu1 ] 
  m2: CONJ{CONJrec2}
>

< m : SENTENCE{SENTENCErec2}
              [ conjrel/CONJ{CONJrec2}, 
                I1:mu1 ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [I11:rel1/..])
         I11: rel1 IN [shiftrel, conjrel]
      >

      COMP
         <
          C1: synOPENGERUND IN CONJrec2.conjpatterns AND
              CONJrec2.adverbial = true AND
              SENTENCErec1 = { senttype   : subordinateclause
                               finiteness : infinite
                               infsort    : opening
                               conjkey    : 0
                               adverbial  : false
                               temporal   : false
                               conjclass  : omegaTimeAdvClass
                               conjdeixis : omegadeixis
                               conjaspect : omegaAspect
                               conjretro  : false }
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2 := { conjkey    : CONJrec2.key
                                adverbial  : CONJrec2.adverbial
                                temporal   : CONJrec2.temporal
                                conjclass  : CONJrec2.class
                                conjdeixis : CONJrec2.deixis
                                conjaspect : CONJrec2.aspect
                                conjretro  : CONJrec2.retro }
         >

      DECOMP
         <
          C1: synOPENGERUND IN CONJrec2.conjpatterns AND
              CONJrec2.adverbial = true AND
              SENTENCErec2 = { senttype   : subordinateclause
                               finiteness : infinite
                               infsort    : opening
                               conjkey    : CONJrec2.key
                               adverbial  : CONJrec2.adverbial
                               temporal   : CONJrec2.temporal
                               conjclass  : CONJrec2.class
                               conjdeixis : CONJrec2.deixis
                               conjaspect : CONJrec2.aspect
                               conjretro  : CONJrec2.retro }
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1 := { conjkey    : 0
                                adverbial  : false
                                temporal   : false
                                conjclass  : omegaTimeAdvClass
                                conjdeixis : omegadeixis
                                conjaspect : omegaAspect
                                conjretro  : false }
         >

&

\end{verbatim}
