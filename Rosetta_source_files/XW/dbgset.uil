! the last active component menu

object dbgset_last_form : XmForm {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;        
        XmNrightAttachment   = XmATTACH_FORM;        
        XmNleftAttachment    = XmATTACH_WIDGET;
        XmNleftWidget        = XmSeparator dbgset_separator4;
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmSeparator dbgset_separator1;

	arguments form_args;
    };
    controls {
        XmLabel dbgset_last_label;
        XmRadioBox dbgset_last_toggles;
    };
};

object dbgset_last_label : XmLabel {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;        
