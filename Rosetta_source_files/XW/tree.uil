/* debug: debug draw tree window */

procedure TreeCreate ();

object tree_window : XmFormDialog {
    arguments {
	XmNdialogTitle	= N_tree_window;
        arguments form_dialog_args;
    };
    controls {
	XmRowColumn      tree_button_box;
        XmScrolledWindow tree_output_window;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_tree_window + DEFAULT_BUTTON_OFFSET*X_tree_ok_button);
    };
};

object tree_button_box : XmRowColumn {
    arguments {
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_tree_ok_button;
                XmNsensitive    = false;
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_tree_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_tree_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_tree_expand_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_tree_expand_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_tree_expand_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_tree_orientation_button;
	    };
	    callbacks {
		XmNactivateCallback = procedure 
		    XwtAction (X_tree_orientation_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_tree_showtree_button;
	    };
	    callbacks {
		XmNactivateCallback = procedure 
		    XwtAction (X_tree_showtree_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_tree_help_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_tree_help_button);
		XmNactivateCallback = procedure XwhAction (X_tree_help_button);
	    };
	};
    };
};

object tree_output_window : XmScrolledWindow {
    arguments {
	XmNtopAttachment	= XmATTACH_FORM;
	XmNleftAttachment       = XmATTACH_FORM;
	XmNrightAttachment	= XmATTACH_FORM;
	XmNbottomAttachment	= XmATTACH_WIDGET;
	XmNbottomWidget		= XmRowColumn tree_button_box;
	XmNscrollingPolicy      = XmAUTOMATIC;
	XmNworkWindow		= user_defined tree_area;

        XmNheight	= 255;
	XmNwidth	= 255;
    };
    controls {
        user_defined tree_area;
    };
};

value
    XmNverticalSpace : argument ('verticalSpace', integer);
    XmNhorizontalSpace : argument ('horizontalSpace', integer);

object tree_area : user_defined procedure TreeCreate () {
    arguments {
	XmNverticalSpace	= 20;
	XmNhorizontalSpace	= 20;
        XmNorientation          = XmHORIZONTAL;
        XmNborderWidth          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_tree_area);
    };
};
