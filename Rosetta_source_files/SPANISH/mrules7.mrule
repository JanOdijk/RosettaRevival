% SUBGRAMMAR datumformation

 ( RprnTOnp/1 )
.[ Rmonthyear/3 ]
.[ Rdaymonth/2 ] 
.[ Rweekdatum/4 | Rdaynumber/5 ]   

HEAD: 
<
PROPERNOUN FROM (NPderivation)
NP         FROM (NPformation)   
>

(* IMPORT: *)
<
(* DETP,NP *)
>

EXPORT:
< NP >
&
\end{verbatim}

\newpage
\begin{verbatim}
% RULE RprnTOnp
< 
  m1: PROPERNOUN{PROPERNOUNrec1}[mu1] 
>

< 
  m : NP{NPrec1}[
                  head/PROPERNOUN{PROPERNOUNrec1}[mu1]
                ]
>   
   PARAMETERS
      <
        superpar: tiempotype
      >


      COMP
         <
          C1: PROPERNOUNrec1.subc = monthnoun 
          A1: NPrec1:= NPrecdef;
              NPrec1:=  
                        { 
                           supertiempo   : superpar
                           class         : PROPERNOUNrec1.class
                           tiempo        : PROPERNOUNrec1.tiempo
                           aspecto       : PROPERNOUNrec1.aspecto
                           retro         : PROPERNOUNrec1.retro
                           genero        : PROPERNOUNrec1.genero
                           actsubcs      : [PROPERNOUNrec1.subc]
                           temporal      : PROPERNOUNrec1.temporal
                           animate       : PROPERNOUNrec1.animate
                           human         : PROPERNOUNrec1.human
                           numero        : PROPERNOUNrec1.numero
                           definite      : def
                           generic       : nogeneric
                           posspred      : true
                           NPhead        : otherNP
                           SpecQ         : yesspec
                        }                            
            >

      DECOMP
         <
          C1: PROPERNOUNrec1.subc = monthnoun   AND
              NPrec1 = NPrecdef  
                       EXCEPT FOR  [ supertiempo,class,tiempo,aspecto,retro,
                       genero,actsubcs,temporal,animate,human,numero,definite,
                       generic,posspred,true,NPhead,SpecQ ]  AND
              NPrec1 = 
                       { 
                           class         : PROPERNOUNrec1.class
                           tiempo        : PROPERNOUNrec1.tiempo
                           aspecto       : PROPERNOUNrec1.aspecto
                           retro         : PROPERNOUNrec1.retro
                           persona       : 3
                           genero        : PROPERNOUNrec1.genero
                           actsubcs      NI PROPERNOUNrec1.subc
                           temporal      : PROPERNOUNrec1.temporal
                           animate       : PROPERNOUNrec1.animate
                           human         : PROPERNOUNrec1.human
                           numero        : PROPERNOUNrec1.numero
                           definite      : def
                           generic       : nogeneric
                           posspred      : true
                           NPhead        : otherNP
                           SpecQ         : yesspec
                       }          
              
          A1: superpar := NPrec1.supertiempo
         >
&

\end{verbatim}
