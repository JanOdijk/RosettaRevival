\newpage
\begin{verbatim}
% RULE RDETPpartitiveformation
< m1: DETP{DETPrec1}[I1:head/T1]
  m2: DETP{DETPrec2}[mu2] 
>

< m : DETP{DETPrec3}[modrel/DETP{DETPrec4}[I1:head/T1],
                     partrel/PREP(KEY_deprepkey){PREPrec1},
                     head/DETP{DETPrec5}[mu2]
                    ]
>
   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NUM, DET]
      >

      COMP
         <
          C1: DETPrec2.definite = def AND
              DETPrec1.genero = DETPrec2.genero AND
              DETPrec1.supertiempo = DETPrec2.supertiempo
          A1: DETPrec3 := 
                 { genero      :  DETPrec2.genero 
                   numero      :  DETPrec2.numero (* om uno de aan
                                                       kunnen is extra atribuut 
                                                       nodig *)
                   definite    :  adef
                   posspred    :  DETPrec1.posspred
                   posscomas   :  DETPrec2.posscomas
                   mood        :  DETPrec1.mood
                   supertiempo :  DETPrec1.supertiempo
                 };
              DETPrec4 := DETPrec1;
              DETPrec4.supertiempo := omegatiempo;
              DETPrec5 := DETPrec2;
              DETPrec5.supertiempo := omegatiempo;
         >

      DECOMP
         <
          C1: DETPrec5.definite = def AND
              DETPrec5.genero = DETPrec4.genero AND
              DETPrec3 =
                 { genero      :  DETPrec5.genero 
                   numero      :  DETPrec5.numero (* om uno de aan
                                                       kunnen is extra atribuut 
                                                       nodig *)
                   definite    :  adef
                   posspred    :  DETPrec4.posspred
                   posscomas   :  DETPrec5.posscomas
                   mood        :  DETPrec4.mood
                 } AND
               DETPrec4.supertiempo = omegatiempo AND
               DETPrec5.supertiempo = omegatiempo
          A1:  DETPrec1 := DETPrec4;
               DETPrec1.supertiempo := DETPrec3.supertiempo;
               DETPrec2 := DETPrec5;
               DETPrec2.supertiempo := DETPrec3.supertiempo;
         >
&


\end{verbatim}
