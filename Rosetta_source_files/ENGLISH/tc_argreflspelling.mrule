                   [head/BPERSPRO(AUX_iBPERSPROkey){BPERSPROrec1}] >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : singular }
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPONiPRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = accusative AND
              NPrec1 = AUX_NPONiPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              NPVARrec1 = { person : 1
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 2. you *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_yousgBPERSPROkey){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : singular }
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPONyousgPRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = accusative AND
              NPrec1 = AUX_NPONyousgPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              NPVARrec1 = { person : 2
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3a. she *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_sheBPERSPROkey){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPONshePRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

          DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = accusative AND
              NPrec1 = AUX_NPONshePRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3b. he *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_heBPERSPROkey){BPERSPROrec1}]>

      COMP
         <
