% RULE RBtoBigpro
< m1:BBIGPRO{BBIGPROrec1} 
>

< m :BIGPRO{BIGPROrec1}[head/BBIGPRO{BBIGPROrec1} ]
>

      COMP
         <
          C1: true
          A1: BIGPROrec1 :=
                 {
                  person:           BBIGPROrec1.person
                  number:           BBIGPROrec1.number
                  gender:           BBIGPROrec1.gender
                  animate:          BBIGPROrec1.animate
                  predpos:          BBIGPROrec1.predpos
                  NPhead:           BBIGPROrec1.NPhead
                  antecedent:       0
                 }
         >
      DECOMP
         <
          C1:BIGPROrec1 =
                 {
                  person:           BBIGPROrec1.person
                  number:           BBIGPROrec1.number
                  gender:           BBIGPROrec1.gender
                  animate:          BBIGPROrec1.animate
                  predpos:          BBIGPROrec1.predpos
                  NPhead:           BBIGPROrec1.NPhead
                  antecedent:       0
                 }
          A1: @
         >


&

\end{verbatim}
