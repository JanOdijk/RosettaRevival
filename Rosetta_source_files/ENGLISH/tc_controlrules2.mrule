\begin{verbatim}
% TRANSFORMATION TNoControlADVP      (* CLOSEDADVPPROP *)
< m1:CLAUSE{CLAUSErec1}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I2:rel1/CLOSEDADVPPROP{CLOSEDADVPPROPrec1}
                             [ I3:subjrel/T1,
                               predrel/ADVP{ADVPrec1}[mu3] 
                             ],
                      mu4 
                    ],
             mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I3:objrel/T1,
                      I2:rel1/ADVP{ADVPrec1}[mu3],
                      mu4 
                    ],
             mu5
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2,[objrel/..])
       I2: rel1 IN [locargrel, dirargrel, complrel]
       I3: T1.CAT IN [NP, NPVAR, CNVAR]
       I4: NOT EXIST (mu1, [I41:auxrel/VERB{VERBrec1}[mu11]])
         I41: VERBrec1.subc = modalverb
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_closedxppvps <> [] AND
              CLOSEDADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [aktionsarts, superdeixis, PROsubject,
                            req, env] AND
              CLOSEDADVPPROPrec1 = { aktionsarts : [stative] 
                                     superdeixis : omegadeixis 
                                     PROsubject  : false }
              (* req, env are default *)
          A1: CLAUSErec2 := CLAUSErec1;
         >
              
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_closedxppvps <> [] 
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                 CLAUSErec2.synvpefs * AUX_closedxppvps;
              CLOSEDADVPPROPrec1 := { aktionsarts : [stative] 
                                      superdeixis : omegadeixis 
                                      PROsubject  : false }
              (* req, env get default value *)
         >

&
\end{verbatim}
