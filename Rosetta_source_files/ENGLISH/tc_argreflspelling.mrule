                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases;
              VARPREPPrec2 := PREPPrec2
         >

   SUBRULE (* 3c. itself *)
      < >
      < T1: REFLPRO(AUX_itselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              NPVARrec1.genders = [omegagender] AND
              NPVARrec1.sexes = [] 
          A1: NPrec1 := AUX_NPONitRFLPR;
              NPrec1.cases := NPVARrec2.cases;
              PREPPrec2 := VARPREPPrec2;

         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONitRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              NPVARrec1.genders = [omegagender] AND
              NPVARrec1.sexes = [] 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases;
              VARPREPPrec2 := PREPPrec2;
         >

   SUBRULE (* 4. ourselves *)
      < >
      < T1: REFLPRO(AUX_ourselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : plural }
          A1: NPrec1 := AUX_NPONourRFLPR;
              NPrec1.cases := NPVARrec2.cases;
              PREPPrec2 := VARPREPPrec2;
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONourRFLPR EXCEPT FOR [cases] AND
              NPVARrec1 = { person : 1
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases;
              VARPREPPrec2 := PREPPrec2;

         >

   SUBRULE (* 5. yourselves *)
      < >
      < T1: REFLPRO(AUX_yourselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : plural }
          A1: NPrec1 := AUX_NPONyourplRFLPR;
              NPrec1.cases := NPVARrec2.cases;
              PREPPrec2 := VARPREPPrec2;
         >

      DECOMP
         <
