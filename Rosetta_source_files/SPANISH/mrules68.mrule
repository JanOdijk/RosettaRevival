% RULE RADJPFORMULAFORMATION1
< m1: ADJPPROP{ADJPPROPrec1}[mu1]
>

< m : ADJPFORMULA{ADJPFORMULArec1}[mu1]
>

      COMP
         <
          C1: true
          A1: ADJPFORMULArec1 := ADJPPROPrec1
         >
      DECOMP
         <
          C1: true
          A1: ADJPPROPrec1 := ADJPFORMULArec1
         >

&

