%KEYSECTION
BASIS RULE
  KEYSECTION = KEYS/1 . LEFTARROW/2 . {ARGUMENTS/3} . RIGHTARROW/2

SURFACE PART
VAR newentries:BOOLEAN;

<*
 INIT:BEGIN newentries:=FALSE
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN 
                         END
       *>
 3:    <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN IF NOT(%ARGUMENTS.oldentry) THEN
                               newentries:=TRUE
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_KEYSECTION;
                  $KEYSECTION.newentries:=newentries
                END
*>
END;

PROCEDURAL PART
VAR tempkey ::KEY;
    keytable::setofKEYS;
    newkeytable::setofKEYS;
    maxstringlength:INTEGER;
BEGIN
INIT: BEGIN 
        INITSETOFkeys(newkeytable);
        INITSETOFkeys(keytable);
        maxstringlength:=0;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN
              %%ARGUMENTS.maxstringlength:=maxstringlength;
            END
      !ARGUMENTS.
      RECEIVE: BEGIN
                 maxstringlength := %%ARGUMENTS.maxstringlength;
                 IF %ARGUMENTS.oldentry THEN
                   APPENDkey(%%ARGUMENTS.keyrec,keytable)  
                 ELSE APPENDkey(%%ARGUMENTS.keyrec,newkeytable)
               END
   *>
*>
FINAL:BEGIN
       IF stillkeys(keytable) THEN BEGIN \of1.\GLOBAL. "CONST" \\ END;
        WHILE STILLkeys(keytable) do
          BEGIN
            TAKEkey(tempkey,keytable);
            BEGIN \of1.\GLOBAL. 
                  TAB(of1,2);
                  ""tempkey.string"";
                  TAB(of1,maxstringlength-tempkey.stringlength);
                  " = ";
                  ""tempkey.number"";
                  ";" \\
            END
          END;
        WHILE STILLkeys(newkeytable) DO
          BEGIN
          takekey(tempkey,newkeytable);
          \of1.\GLOBAL.
          " FUNCTION LSAUXDOM_" ""tempkey.string""
           ":INTEGER; EXTERNAL;"\\ 
          \of2.\GLOBAL.
          " FUNCTION LSAUXDOM_" ""tempkey.string""
           ":INTEGER;"\\
          "BEGIN"\\
          "LSAUXDOM_" ""tempkey.string"" ":="
            "CONSTFILE_" ""tempkey.string""\\
          "END;"\\
          END
      END
END;
&


%ARGUMENTS
BASIS RULE
  ARGUMENTS = IDENTIFIER/1. [ EQUIVALENT/2 . ARGLIST/3]

SURFACE PART
VAR oldentry:BOOLEAN;

<*
 INIT:BEGIN oldentry:=FALSE
      END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN oldentry:=TRUE
                         END
       *>
 3:    <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN 
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_ARGUMENTS;
                  $ARGUMENTS.oldentry:=oldentry
                END
*>
END;

PROCEDURAL PART
VAR StringLength : integer; 
    tempkey     :: KEY;
    TempString   : TSTRING_string;
    oldentry     :BOOLEAN;
BEGIN
INIT: BEGIN oldentry:=$ARGUMENTS.oldentry END;
<*
1: <* SEND: BEGIN
              TempString:=%.str;
              TSTRING_Concat(tempkey.string,'LSAUXDOM_',TempString);
              StringLength:=TSTRING_length(%.str);
              tempkey.StringLength:=StringLength;
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN  END
      !ARGLIST.
      RECEIVE: BEGIN 
                 tempkey.number:=%%ARGLIST.numb;
               END
   *>
*>
FINAL:BEGIN
        IF not oldentry THEN tempkey.string:=tempstring;
        $$ARGUMENTS.keyrec:=tempkey;
        IF StringLength > $$ARGUMENTS.maxstringlength THEN
                    $$ARGUMENTS.maxstringlength:=StringLength   
      END
END;
&
     

%ARGLIST
BASIS RULE
  ARGLIST = LEFTARROW/1 . KEYtje/1 . EQUIVALENT/1 . NUMBER/2 .
                         TERM/1 . EQUIVALENT/1 . TERMARGUMENT/4 .
                     CATEGORY/1 . EQUIVALENT/1 . IDENTIFIER/3 . 
            RIGHTARROW/1  
SURFACE PART

<*
 INIT:BEGIN  
      END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN 
                         END
       *>
3:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN 
                         END
       *>
4:     <*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN 
                         END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_ARGLIST;
                END
*>
END;

PROCEDURAL PART
VAR KeyNumber,
    KeyTerm,
    KeyCat  : TSTRING_string;

BEGIN
INIT: BEGIN END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !NUMBER.
      RECEIVE: BEGIN
                 KeyNumber:=%%NUMBER.numb
               END
   *>
3: <* SEND: BEGIN 
              KeyCat:=%.str
            END
      !.
      RECEIVE: BEGIN 
               END
   *>
4: <* SEND: BEGIN  END
      !TERMARGUMENT.
      RECEIVE: BEGIN 
                 KeyTerm:=%%TERMARGUMENT.term
               END
   *>
*>
FINAL:BEGIN
        $$ARGLIST.numb:=KeyNumber;
      END
END;
&


%NUMBER
BASIS RULE
  NUMBER = IDENTIFIER/1

SURFACE PART
HELP FUNCTION CheckNumber(str : TSTRING_string) :BOOLEAN;
     VAR digits : TSTRING_string;
     BEGIN
       digits := '0123456789';
       IF TSTRING_FindFirstNotInSet(str,digits) = 0 THEN
             CheckNumber:=TRUE
       ELSE  CheckNumber:=FALSE;         
     END;


<*
 INIT:BEGIN
       END;
1:     <*
        LOCALCONDITION:CheckNumber(%.str)
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_NUMBER;
                END
*>
END;

PROCEDURAL PART
VAR str : TSTRING_string;
BEGIN
INIT: BEGIN END;
<*
1: <* SEND: BEGIN
              str:=%.str;
            END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN 
        $$NUMBER.numb:=str;
      END
END;
&


