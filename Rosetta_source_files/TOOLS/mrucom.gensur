%MATCHCONDS
BASIS RULE
    MATCHCONDS = MATCHCONDITIONS/7.
                LEFTARROW/1.
               {LABELtje/2.DOTDOT/1.[LEFTTORIGHT/3|RIGHTTOLEFT/4|ALL/6].[ANDCOND/5]}.
                RIGHTARROW/1
SURFACE PART
VAR righttolefttable,alltable::SETOFidents;
    labelname::ident;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    otherrecordsvar,RelVarList::SETOFidents;
    modellabels::setofidents;
    vartypes::setofvartypes;
    vartypes1::setofvartypes;
    vartype::vartype;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;
    FUNCTION present(ident::ident;S1::setofidents):BOOLEAN;
    VAR ident1::ident;
        result:boolean;
    begin
    result:=false;
    while stillidents(S1) and not(result) do
      begin
      takeident(ident1,S1);
      result := (ident1.str=ident.str)
      end;
    present:=result
    end;

  PROCEDURE MERGESETS(S1::SETOFidents;VAR S2::SETOFidents);
  VAR ident1::ident;
  BEGIN
  WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   IF not(present(ident1,S2)) THEN APPENDident(ident1,S2)
   END
  END;
  FUNCTION SUBTRACTSETS(S1::SETOFidents;S2::SETOFidents)::setofidents;
  VAR ident1::ident;
      result::setofidents;
  BEGIN
  initsetofidents(result);
  WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   If stillidents(S2) THEN TAKEident(ident1,S2) ELSE APPENDident(ident1,result)
   END;
  subtractsets:=result
  END;
  FUNCTION recassign:BOOLEAN;
  BEGIN
  otherrecordsvar:=otherrecords;
  recassign:=TRUE;
  END;

<*
INIT: BEGIN 
        INITSETOFvartypes(vartypes);
        INITSETOFIDENTS(righttolefttable);
        INITSETOFIDENTS(alltable);
        INITsetofidents(MuVarlist);
        INITsetofidents(SigmaVarlist);
        INITsetofidents(NodeVarlist);
        INITsetofidents(TreeVarlist);
        INITsetofidents(RelVarlist);
        INITsetofidents(modellabels);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN labelname.str:=%LABELTJE.str; 
                              IF (%LABELTJE.labelkind=MLABEL) OR
                                 (%LABELTJE.labelkind=RLABEL) OR
                                 (%LABELTJE.labelkind=MULABEL) OR
                                 (%LABELTJE.labelkind=SIGLABEL) OR
                                 (%LABELTJE.labelkind=TLABEL) OR
                                 (%LABELTJE.labelkind=LLABEL) THEN
                                 appendident(labelname,modellabels);
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN appendident(labelname,righttolefttable) END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          vartypes1:=%ANDCOND.vartypes;
                          WHILE stillvartypes(vartypes1) DO
                            BEGIN
                            takevartype(vartype,vartypes1);
                            appendvartype(vartype,vartypes)
                            END;
                          MERGESETS(%ANDCOND.MuVarList,MuVarList);
                          MERGESETS(%ANDCOND.SigmaVarList,SigmaVarList);
                          MERGESETS(%ANDCOND.TreeVarList,TreeVarList);
                          MERGESETS(%ANDCOND.NodeVarList,NodeVarList);
                          MERGESETS(%ANDCOND.RelVarList,RelVarList);
                        END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN appendident(labelname,alltable) END
    *>
7 : <* LOCALCONDITION:recassign
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_MATCHCONDS;
                      $MATCHCONDS.vartypes:=vartypes;
                      $MATCHCONDS.righttolefttable:=righttolefttable;
                      $MATCHCONDS.alltable:=alltable;
                      $MATCHCONDS.records:=subtractsets(otherrecords,OtherRecordsvar);
                      $MATCHCONDS.MuVarlist:=MuVarList;
                      $MATCHCONDS.SigmaVarlist:=SigmaVarList;
                      $MATCHCONDS.NodeVarlist:=NodeVarList;
                      $MATCHCONDS.TreeVarlist:=TreeVarList;
                      $MATCHCONDS.RelVarlist:=RelVarList;
                      $MATCHCONDS.modellabels:=modellabels;
                END
*>
END;
PROCEDURAL PART
VAR commatchfile:LOCALFILE;
    decommatchfile:LOCALFILE;
    commatchfile1:LOCALFILE;
    decommatchfile1,helpdecommatchfile:LOCALFILE;
    decomallexist:LOCALFILE;
    labelname:TSTRING_string;
    andcondabsent:BOOLEAN;
    numofmatchconds:INTEGER;
    indent::int;
    leftMuvarlist,leftsigmavarlist,leftnodevarlist,leftrelvarlist,lefttreevarlist::setofidents;
    rightMuvarlist,rightsigmavarlist,rightnodevarlist,rightrelvarlist,righttreevarlist::setofidents;
BEGIN
INIT: BEGIN indent:=$$MATCHCONDS.indent;
            leftMuvarlist:=$$MATCHCONDS.leftMuVarlist;
            leftSigmaVarlist:=$$MATCHCONDS.leftSigmaVarlist;
            leftNodeVarlist:=$$MATCHCONDS.leftNodeVarlist;
            leftTreeVarlist:=$$MATCHCONDS.leftTreeVarlist;
            leftRelVarlist:=$$MATCHCONDS.leftRelVarlist;
            rightMuvarlist:=$$MATCHCONDS.rightMuVarlist;
            rightSigmaVarlist:=$$MATCHCONDS.rightSigmaVarlist;
            rightNodeVarlist:=$$MATCHCONDS.rightNodeVarlist;
            rightTreeVarlist:=$$MATCHCONDS.rightTreeVarlist;
            rightRelVarlist:=$$MATCHCONDS.rightRelVarlist;
            TSTRING_constantempty(labelname);
            INITLOCALFILE(commatchfile);
            INITLOCALFILE(decommatchfile);
            INITLOCALFILE(commatchfile1);
            INITLOCALFILE(decommatchfile1);
            INITLOCALFILE(decomallexist);
            andcondabsent:=true;
            numofmatchconds:=0;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: 
            BEGIN 
            IF andcondabsent and (numofmatchconds<>0) THEN
               BEGIN
                 BEGIN \commatchfile.\LOCAL. END;
                   LOCALTAB(commatchfile,indent);
                   "FUNCTION matchcond" ""labelname"" ":BOOLEAN;" \\ 
                   LOCALTAB(commatchfile,indent);
                   "BEGIN" \\
                   LOCALTAB(commatchfile,indent+2);
                   "matchcond" ""labelname"" ":= TRUE" \\
                   LOCALTAB(commatchfile,indent);
                   "END;{matchcond" ""labelname"" "}"\\
                 BEGIN \decommatchfile.\LOCAL. END;
                   LOCALTAB(decommatchfile,indent);
                   "FUNCTION matchcond" ""labelname"" ":BOOLEAN;" \\
                   LOCALTAB(decommatchfile,indent);
                   "BEGIN" \\
                   LOCALTAB(decommatchfile,indent+2);
                   "matchcond" ""labelname"" ":= TRUE" \\
                   LOCALTAB(decommatchfile,indent);
                   "END;{matchcond" ""labelname"" "}"\\
                 {invert order of match conditions:}
                 appendlocfile(commatchfile1,commatchfile);
                 INITLOCALFILE(commatchfile1);
                 appendlocfile(commatchfile,commatchfile1);
                 INITLOCALFILE(commatchfile);
                 appendlocfile(decommatchfile1,decommatchfile);
                 INITLOCALFILE(decommatchfile1);
                 appendlocfile(decommatchfile,decommatchfile1);
                 INITLOCALFILE(decommatchfile);
               END;
            andcondabsent:=true;
            numofmatchconds:=numofmatchconds+1;
            labelname:=%LABELTJE.str;
            END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
5: <* SEND: BEGIN %%ANDCOND.allexistcounter:=0; andcondabsent:=false;
                  %%ANDCOND.indent:=indent+2;
                  %%ANDCOND.toplevel:=TRUE;
                  INITSETOFvartypes(%%ANDCOND.vartypes);
            END
      !ANDCOND.
      RECEIVE: BEGIN
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   LOCALTAB(commatchfile,indent);
                   "FUNCTION matchcond" ""labelname"" ":BOOLEAN;" \\ 
                 END;
                 AppendLocFile(%%ANDCOND.allexist,commatchfile);
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   "BEGIN" \\
                   "matchcond" ""labelname"" ":=FALSE;" \\
                   LOCALTAB(commatchfile,indent+2);
                   "IF"\\
                 END;
                 AppendLocFile(%%ANDCOND.commatchfile,commatchfile);
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN 
                   "THEN "\\
                   "matchcond" ""labelname"" ":=TRUE;" \\
                   \\ LOCALTAB(commatchfile,indent);"END;{matchcond" ""labelname"" "}"\\
                 END;
                 BEGIN \decommatchfile.\LOCAL. END;
                 BEGIN
                   LOCALTAB(decommatchfile,indent); 
                   "FUNCTION matchcond" ""labelname"" ":BOOLEAN;" \\
                 END;
                 SAVElocfile(%%ANDCOND.allexist,decomallexist);
                 AppendLocFile(decomallexist,decommatchfile);
                 BEGIN \decommatchfile.\LOCAL. END;
                 BEGIN
                   LOCALTAB(decommatchfile,indent);
                   "BEGIN" \\
                   "matchcond" ""labelname"" ":=FALSE;" \\
                   LOCALTAB(decommatchfile,indent+2);
                   "IF"\\
                   LOCALTAB(decommatchfile,indent+10);
                 END;
                 SAVElocfile(%%ANDCOND.commatchfile,helpdecommatchfile);
                 AppendLocFile(helpdecommatchfile,decommatchfile);
                 BEGIN \decommatchfile.\LOCAL. END;
                 BEGIN 
                   "THEN "\\
                   "matchcond" ""labelname"" ":=TRUE;" \\
                   \\ LOCALTAB(decommatchfile,indent);"END;{matchcond" ""labelname"" "}"\\
                 END;
                 {invert order of match conditions:}
                 appendlocfile(commatchfile1,commatchfile);
                 INITLOCALFILE(commatchfile1);
                 appendlocfile(commatchfile,commatchfile1);
                 INITLOCALFILE(commatchfile);
                 appendlocfile(decommatchfile1,decommatchfile);
                 INITLOCALFILE(decommatchfile1);
                 appendlocfile(decommatchfile,decommatchfile1);
                 INITLOCALFILE(decommatchfile);
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN
        IF andcondabsent THEN
               BEGIN
                 BEGIN \commatchfile.\LOCAL. END;
                   LOCALTAB(commatchfile,indent);
                   "FUNCTION matchcond" ""labelname"" ":BOOLEAN;" \\ 
                   LOCALTAB(commatchfile,indent);
                   "BEGIN" \\
                   LOCALTAB(commatchfile,indent+2);
                   "matchcond" ""labelname"" ":= TRUE" \\
                   LOCALTAB(commatchfile,indent);
                   "END;{matchcond" ""labelname"" "}"\\
                 BEGIN \decommatchfile.\LOCAL. END;
                   LOCALTAB(decommatchfile,indent);
                   "FUNCTION matchcond" ""labelname"" ":BOOLEAN;" \\
                   "BEGIN" \\
                   LOCALTAB(decommatchfile,2);
                   "matchcond" ""labelname"" ":= TRUE" \\
                   LOCALTAB(decommatchfile,indent);
                   "END;{matchcond" ""labelname"" "}"\\
                 {invert order of match conditions:}
                 appendlocfile(commatchfile1,commatchfile);
                 INITLOCALFILE(commatchfile1);
                 appendlocfile(commatchfile,commatchfile1);
                 INITLOCALFILE(commatchfile);
                 appendlocfile(decommatchfile1,decommatchfile);
                 INITLOCALFILE(decommatchfile1);
                 appendlocfile(decommatchfile,decommatchfile1);
                 INITLOCALFILE(decommatchfile);
               END;
        INITLOCALFILE($$MATCHCONDS.commatchfile);
        appendlocfile(commatchfile1,$$MATCHCONDS.commatchfile);
        INITLOCALFILE($$MATCHCONDS.decommatchfile);
        appendlocfile(decommatchfile1,$$MATCHCONDS.decommatchfile);
      END
END;
&
 
%ANDCOND
BASIS RULE
    ANDCOND = [WITHEXPR].ORCOND/2.{ANDCAT/1.ORCOND/2}
WITHEXPR = [NOTCAT/10].(NODEVAR/7|TREEVAR/3).DOT/8.CATCAT/4.INCAT/9.SETVALUENAME/5.WITHje/6
SURFACE PART
VAR vartypes::setofvartypes;
    vartype::vartype;
    vartypes1::setofvartypes;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    RelVarList::SETOFidents;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

<*
INIT: BEGIN 
        INITsetofvartypes(vartypes);
        INITsetofidents(MuVarlist);
        INITsetofidents(SigmaVarlist);
        INITsetofidents(NodeVarlist);
        INITsetofidents(TreeVarlist);
        INITsetofidents(RelVarlist);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          vartypes1:=%ORCOND.vartypes;
                          WHILE stillvartypes(vartypes1) DO
                            BEGIN
                            takevartype(vartype,vartypes1);
                            appendvartype(vartype,vartypes);
                            END;
                          APPENDSETS(%ORCOND.MuVarList,MuVarList);
                          APPENDSETS(%ORCOND.SigmaVarList,SigmaVarList);
                          APPENDSETS(%ORCOND.TreeVarList,TreeVarList);
                          APPENDSETS(%ORCOND.NodeVarList,NodeVarList);
                          APPENDSETS(%ORCOND.RelVarList,RelVarList);
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        vartype.varname:=%.str;
                        END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        vartype.cattable:=%SETVALUENAME.valuetable;
                        appendvartype(vartype,vartypes);
                        END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
7 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                        vartype.varname:=%.str;
                        END
    *>
8 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
9 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
10 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_ANDCOND;
                      $ANDCOND.vartypes:=vartypes;
                      $ANDCOND.MuVarlist:=MuVarList;
                      $ANDCOND.SigmaVarlist:=SigmaVarList;
                      $ANDCOND.NodeVarlist:=NodeVarList;
                      $ANDCOND.TreeVarlist:=TreeVarList;
                      $ANDCOND.RelVarlist:=RelVarList;
                END
*>
END;
PROCEDURAL PART
VAR commatchfile,decommatchfile:LOCALFILE;
    allexist:LOCALFILE;
    allexistcounter::int;
    vartype::vartype;
    string:TSTRING_string;
    vartypes::setofvartypes;
    toplevel,notpresent::bool;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;
BEGIN
INIT: BEGIN notpresent:=FALSE;
        vartypes:=$$ANDCOND.vartypes;
        allexistcounter:=$$ANDCOND.allexistcounter;
        INITLOCALFILE(commatchfile);
        INITLOCALFILE(decommatchfile);
        INITLOCALFILE(allexist);
        toplevel:=$$ANDCOND.toplevel;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   IF toplevel THEN BEGIN "THEN IF"\\ END
                   ELSE BEGIN "AND"\\ END;
                   LOCALTAB(commatchfile,10);
                 END;
               END
   *>
2: <* SEND: BEGIN %%ORCOND.allexistcounter:=allexistcounter;
                  %%ORCOND.vartypes:=vartypes;
            END
      !ORCOND.
      RECEIVE: BEGIN
                 allexistcounter:=%%ORCOND.allexistcounter;
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   "("
                 END;
                 AppendLocFile(%%ORCOND.commatchfile,commatchfile);
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   ")" \\
                 END;
                 AppendLocFile(%%ORCOND.decommatchfile,decommatchfile);
                 AppendLocFile(%%ORCOND.allexist,allexist);
               END
   *>
3: <* SEND: BEGIN string:=%TREEVAR.str END
      !.
      RECEIVE: BEGIN "(" ""string"" "^.cat"
                        vartype.varname:=string;
               END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
5: <* SEND: BEGIN END
      !SETVALUENAME.
      RECEIVE: BEGIN vartype.cattable:=%SETVALUENAME.valuetable;
                     appendvartype(vartype,vartypes);
                 APPENDLOCFILE(%%SETVALUENAME.copy,commatchfile);
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN ") AND "\\
                     toplevel:=FALSE;
               END
   *>
7: <* SEND: BEGIN string:=%NODEVAR.str END
      !.
      RECEIVE: BEGIN  "(" ""string"" ".cat"\\
                        vartype.varname:=string;
               END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
9: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                   " IN "
               END
   *>
10: <* SEND: BEGIN notpresent:=TRUE END
      !.
      RECEIVE: BEGIN 
                   "NOT("
               END
   *>
*>
FINAL:BEGIN 
        IF notpresent THEN ")"
        $$ANDCOND.commatchfile:=commatchfile;
        $$ANDCOND.decommatchfile:=decommatchfile;
        $$ANDCOND.allexist:=allexist;
        $$ANDCOND.allexistcounter:=allexistcounter;
      END
END;
&
 
%ORCOND
BASIS RULE
     ORCOND = ELEMENTARYCOND/2.{ORCAT/1.ELEMENTARYCOND/2}
SURFACE PART
VAR vartypes::setofvartypes;
    vartype::vartype;
    vartypes1::setofvartypes;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    RelVarList::SETOFidents;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

<*
INIT: BEGIN 
        INITsetofvartypes(vartypes);
        INITsetofidents(MuVarlist);
        INITsetofidents(SigmaVarlist);
        INITsetofidents(NodeVarlist);
        INITsetofidents(TreeVarlist);
        INITsetofidents(RelVarlist);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          vartypes1:=%ELEMENTARYCOND.vartypes;
                          WHILE stillvartypes(vartypes1) DO
                            BEGIN
                            takevartype(vartype,vartypes1);
                            appendvartype(vartype,vartypes);
                            END;
                          APPENDSETS(%ELEMENTARYCOND.MuVarList,MuVarList);
                          APPENDSETS(%ELEMENTARYCOND.SigmaVarList,SigmaVarList);
                          APPENDSETS(%ELEMENTARYCOND.TreeVarList,TreeVarList);
                          APPENDSETS(%ELEMENTARYCOND.NodeVarList,NodeVarList);
                          APPENDSETS(%ELEMENTARYCOND.RelVarList,RelVarList);
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_ORCOND;
                      $ORCOND.MuVarlist:=MuVarList;
                      $ORCOND.SigmaVarlist:=SigmaVarList;
                      $ORCOND.NodeVarlist:=NodeVarList;
                      $ORCOND.TreeVarlist:=TreeVarList;
                      $ORCOND.RelVarlist:=RelVarList;
                      $ORCOND.vartypes:=vartypes;
                END
*>
END;
PROCEDURAL PART
VAR commatchfile,decommatchfile:LocalFile;
    allexist:LOCALFILE;
    allexistcounter::int;
    vartypes::setofvartypes;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;
BEGIN
INIT: BEGIN
        vartypes:=$$ORCOND.vartypes;
        allexistcounter:=$$ORCOND.allexistcounter;
        INITLOCALFILE(commatchfile);
        INITLOCALFILE(decommatchfile);
        INITLOCALFILE(allexist);
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   "OR"\\
                   LOCALTAB(commatchfile,10);
                 END;
               END
   *>
2: <* SEND: BEGIN %%ELEMENTARYCOND.allexistcounter:=allexistcounter;
                  %%ELEMENTARYCOND.vartypes:=vartypes;
            END
      !ELEMENTARYCOND.
      RECEIVE: BEGIN
                 allexistcounter:= %%ELEMENTARYCOND.allexistcounter;
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   "("
                 END;
                 AppendLocFile(%%ELEMENTARYCOND.commatchfile,commatchfile);
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   ")" \\
                 END;
                 AppendLocFile(%%ELEMENTARYCOND.decommatchfile,decommatchfile);
                 AppendLocFile(%%ELEMENTARYCOND.allexist,allexist);
               END
   *>
*>
FINAL:BEGIN 
        $$ORCOND.commatchfile:=commatchfile;
        $$ORCOND.decommatchfile:=decommatchfile;
        $$ORCOND.allexist:=allexist;
        $$ORCOND.allexistcounter:=allexistcounter;
      END
END;
&
 
%ELEMENTARYCOND
BASIS RULE
    ELEMENTARYCOND = (ROUNDOPEN/1.ANDCOND/2.ROUNDCLOSE/1|
                      MATCHBOOLEAN/3|
                      BOOLEANEXPR/4|QUOTECOND|SEMILEXCOND|IDLEXCOND|IMPLY
                     )
    IMPLY = ANDCOND/25.MINCAT/1.RIGHTARROW/1.ANDCOND/26
    IDLEXCOND = (DECOMPINIDDICT/1.ROUNDOPEN/1.
               LEFTARROW/1.KEYNAME/22.{COMMA/1.KEYNAME/22}.RIGHTARROW/24.
               COMMA/16.IDENTIFIER/23
              .ROUNDCLOSE/8
                |COMPINIDDICT/20.ROUNDOPEN/6.KEYNAME/19.COMMA/16.IDENTIFIER/23
              .ROUNDCLOSE/8
                )
    SEMILEXCOND = (COMPINSIDDICT/20|DECOMPINSIDDICT/20).ROUNDOPEN/6.
                   KEYNAME/19.COMMA/16.KEYNAME/19.COMMA/16.IDENTIFIER/11
              .ROUNDCLOSE/8
    QUOTECOND = [NOTCAT/12].[ROUNDOPEN/13].QUOTE/5.UNDERSCORE/1.IDENTIFIER/7.
                [ROUNDOPEN/6.
                 (IDENTIFIER/11|((AUX/18|KEYtje/21).UNDERSCORE/1.IDENTIFIER/11)|
                  (IDENTIFIER/11.DOT/14.IDENTIFIER/11)|
                  (SQUAREOPEN/15.[IDENTIFIER/11.{COMMA/16.IDENTIFIER/11}].SQUARECLOSE/17)
                 ).
                {COMMA/16.
                 (IDENTIFIER/11|((AUX/18|KEYtje/21).UNDERSCORE/1.IDENTIFIER/11)|
                  (IDENTIFIER/11.DOT/14.IDENTIFIER/11)|
                  (SQUAREOPEN/15.[IDENTIFIER/11.{COMMA/16.IDENTIFIER/11}].SQUARECLOSE/17)
                 )
                }.ROUNDCLOSE/8].[ROUNDCLOSE/13]

SURFACE PART
VAR
    vartypes::setofvartypes;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    RelVarList::SETOFidents;
    notpresent::bool;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

<*
INIT: BEGIN notpresent:=false;
        INITsetofvartypes(vartypes);
        INITsetofidents(MuVarlist);
        INITsetofidents(SigmaVarlist);
        INITsetofidents(NodeVarlist);
        INITsetofidents(TreeVarlist);
        INITsetofidents(RelVarlist);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          vartypes:=%ANDCOND.vartypes;
                          APPENDSETS(%ANDCOND.MuVarList,MuVarList);
                          APPENDSETS(%ANDCOND.SigmaVarList,SigmaVarList);
                          APPENDSETS(%ANDCOND.TreeVarList,TreeVarList);
                          APPENDSETS(%ANDCOND.NodeVarList,NodeVarList);
                          APPENDSETS(%ANDCOND.RelVarList,RelVarList);
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                          APPENDSETS(%MATCHBOOLEAN.MuVarList,MuVarList);
                          APPENDSETS(%MATCHBOOLEAN.SigmaVarList,SigmaVarList);
                          APPENDSETS(%MATCHBOOLEAN.TreeVarList,TreeVarList);
                          APPENDSETS(%MATCHBOOLEAN.NodeVarList,NodeVarList);
                          APPENDSETS(%MATCHBOOLEAN.RelVarList,RelVarList);
                        END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        IF TSTRING_length(%BOOLEANEXPR.vartype.varname)<>0 THEN
                          APPENDvartype(%BOOLEANEXPR.vartype,vartypes) 
                        END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
7 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
8 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
11: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
12: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN notpresent:=TRUE END
    *>
13: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: notpresent
               #ACTION: BEGIN END
    *>
14: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
15: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
16: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
17: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
18: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
19: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
20: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
21: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
22: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
23: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
24: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
25: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                          APPENDSETS(%ANDCOND.MuVarList,MuVarList);
                          APPENDSETS(%ANDCOND.SigmaVarList,SigmaVarList);
                          APPENDSETS(%ANDCOND.TreeVarList,TreeVarList);
                          APPENDSETS(%ANDCOND.NodeVarList,NodeVarList);
                          APPENDSETS(%ANDCOND.RelVarList,RelVarList);
                        END
    *>
26: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          APPENDSETS(%ANDCOND.MuVarList,MuVarList);
                          APPENDSETS(%ANDCOND.SigmaVarList,SigmaVarList);
                          APPENDSETS(%ANDCOND.TreeVarList,TreeVarList);
                          APPENDSETS(%ANDCOND.NodeVarList,NodeVarList);
                          APPENDSETS(%ANDCOND.RelVarList,RelVarList);
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_ELEMENTARYCOND;
                      $ELEMENTARYCOND.vartypes:=vartypes;
                      $ELEMENTARYCOND.MuVarlist:=MuVarList;
                      $ELEMENTARYCOND.SigmaVarlist:=SigmaVarList;
                      $ELEMENTARYCOND.NodeVarlist:=NodeVarList;
                      $ELEMENTARYCOND.TreeVarlist:=TreeVarList;
                      $ELEMENTARYCOND.RelVarlist:=RelVarList;
                END
*>
END;
PROCEDURAL PART
VAR commatchfile,decommatchfile:LocalFile;
    idargs,allexist,allexist1:LOCALFILE;
    str:TSTRING_string;
    allexistcounter1,allexistcounter::int;
    vartypes::setofvartypes;
    notpresent,idargspresent::bool;
    keypresent,writevpid::bool;
    argcounter::int;
BEGIN
INIT: BEGIN
        argcounter:=0;
        keypresent:=false;
        vartypes:=$$ELEMENTARYCOND.vartypes;
        allexistcounter:=$$ELEMENTARYCOND.allexistcounter;
        INITLOCALFILE(commatchfile);
        INITLOCALFILE(decommatchfile);
        INITLOCALFILE(idargs);
        INITLOCALFILE(allexist1);
        INITLOCALFILE(allexist);
        notpresent:=false;
        writevpid:=false;
        idargspresent:=FALSE;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN %%ANDCOND.allexistcounter:= allexistcounter;
                  %%ANDCOND.vartypes:=vartypes;
                  %%ANDCOND.toplevel:=FALSE;
            END
      !ANDCOND.
      RECEIVE: BEGIN
                 allexistcounter:=%%ANDCOND.allexistcounter;
                 AppendLocFile(%%ANDCOND.commatchfile,commatchfile);
                 AppendLocFile(%%ANDCOND.decommatchfile,decommatchfile);
                 AppendLocFile(%%ANDCOND.allexist,allexist);
               END
   *>
3: <* SEND: BEGIN %%MATCHBOOLEAN.allexistcounter:= allexistcounter END
      !MATCHBOOLEAN.
      RECEIVE: BEGIN 
                 allexistcounter:= %%MATCHBOOLEAN.allexistcounter;
                 AppendLocFile(%%MATCHBOOLEAN.commatchfile,commatchfile);
                 AppendLocFile(%%MATCHBOOLEAN.decommatchfile,decommatchfile);
                 AppendLocFile(%%MATCHBOOLEAN.allexist,allexist);
               END
   *>
4: <* SEND: BEGIN %%BOOLEANEXPR.allexistcounter:=allexistcounter;
                  %%BOOLEANEXPR.vartypes:=vartypes;
            END
      !BOOLEANEXPR.
      RECEIVE: BEGIN 
                 allexistcounter:=%%BOOLEANEXPR.allexistcounter;
                 AppendLocFile(%%BOOLEANEXPR.allexist,allexist);
                 AppendLocFile(%%BOOLEANEXPR.commatchfile,commatchfile);
                 AppendLocFile(%%BOOLEANEXPR.decommatchfile,decommatchfile);
               END
   *>
5: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \commatchfile.\LOCAL. 
                     IF notpresent THEN "NOT(" 
                     "LSMRUQUO_" 
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "(" END
   *>
7: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN \commatchfile.\LOCAL. ""str"" END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \commatchfile.\LOCAL. ")"
                     IF notpresent THEN ")"
{                     IF writevpid THEN BEGIN " AND (VPID=" ""str"" ")" END;}
                     writevpid:=false;
                     savelocfile(commatchfile,decommatchfile);
               END
   *>
11: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN \commatchfile.\LOCAL. 
                    if keypresent then "('"
                    ""str""
                    if keypresent then "')"
                    \\
               END
   *>
12: <* SEND: BEGIN notpresent:=true END
      !.
      RECEIVE: BEGIN END
   *>
13: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
14: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "." END
   *>
15: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "[" END
   *>
16: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "," END
   *>
17: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "]" END
   *>
18: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN "LSAUXDOM_" END
   *>
19: <* SEND: BEGIN str:=%KEYNAME.str1 END
      !.
      RECEIVE: BEGIN ""str"" END
   *>
20: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN "LIMATCHES_" ""str"" END
   *>
21: <* SEND: BEGIN keypresent:=true END
      !.
      RECEIVE: BEGIN "auxkey" END
   *>
22: <* SEND: BEGIN argcounter:=argcounter + 1;
                   str:=%KEYNAME.str1
             END    
      !.
      RECEIVE: BEGIN \idargs.\LOCAL.
                      "idargs.argkeys[" """argcounter""" 
                     "]:=" ""str"" ";"\\
                     \commatchfile.\LOCAL.
               END
   *>
23: <* SEND: BEGIN  str:=%.str END
      !.
      RECEIVE: BEGIN "ORD(" ""str"" ")" END
   *>
24: <* SEND: BEGIN idargspresent:=TRUE END
      !.
      RECEIVE: BEGIN "LIMATCHES_decompiniddict(idargs"
                     writevpid:=TRUE;
                     \allexist.\LOCAL.
                     allexistcounter:=allexistcounter+1;
                     "FUNCTION idargs" """allexistcounter""" ":BOOLEAN;"\\
                     "BEGIN"\\
                     appendlocfile(idargs,allexist);
                     "idargs.nrargs:=" """argcounter""" ";" \\
                     \commatchfile.\LOCAL.
               END
   *>
25: <* SEND: BEGIN allexistcounter:=allexistcounter+1;
                  %%ANDCOND.allexistcounter:= allexistcounter;
                  %%ANDCOND.vartypes:=vartypes;
                  %%ANDCOND.toplevel:=FALSE;
                  allexistcounter1:=allexistcounter;
                   "imply" """allexistcounter1"""
                   \allexist1.\LOCAL.
                   "FUNCTION imply" """allexistcounter1""" ":BOOLEAN;"\\
                   "BEGIN"\\
                   "IF "
             END
      !ANDCOND.
      RECEIVE: BEGIN appendlocfile(%%ANDCOND.commatchfile,allexist1);\\
                     "THEN imply" """allexistcounter1"""
                         ":="\\
                 allexistcounter:=%%ANDCOND.allexistcounter;
                 appendlocfile(%%ANDCOND.allexist,allexist);
               END
   *>
26: <* SEND: BEGIN 
                  %%ANDCOND.allexistcounter:= allexistcounter;
                  %%ANDCOND.vartypes:=vartypes;
                  %%ANDCOND.toplevel:=FALSE;
             END
      !ANDCOND.
      RECEIVE: BEGIN appendlocfile(%%ANDCOND.commatchfile,allexist1);
                     " ELSE imply" """allexistcounter1""" 
                        ":=TRUE;"\\
                     "END;"\\
                 allexistcounter:=%%ANDCOND.allexistcounter;
                 appendlocfile(%%ANDCOND.allexist,allexist);
                 appendlocfile(allexist1,allexist);
               END
   *>
*>
FINAL:BEGIN
        IF idargspresent THEN
           BEGIN
           \allexist.\LOCAL.
           "idargs" """allexistcounter""" ":="\\
           appendlocfile(commatchfile,allexist);
           "END;"\\
           initlocalfile(commatchfile);
           \commatchfile.\LOCAL.
           "idargs" """allexistcounter"""
           END;
        $$ELEMENTARYCOND.commatchfile:=commatchfile;
        $$ELEMENTARYCOND.decommatchfile:=decommatchfile;
        $$ELEMENTARYCOND.allexist:=allexist;
        $$ELEMENTARYCOND.allexistcounter:=allexistcounter;
      END
END;
&
 
%BOOLEANEXPR
BASIS RULE
    BOOLEANEXPR = PASCALEXPR/1|CONDRECORD/2|TRUECAT/3|
                  ((MUVAR/4|SIGMAVAR/8).(ISCAT/5|LEFTARROW/6.RIGHTARROW/6)
                  .SQUAREOPEN/7.SQUARECLOSE/9)
                  
SURFACE PART
VAR vartype::vartype;

<*
INIT: BEGIN TSTRING_constantempty(vartype.varname);
            INITsetofidents(vartype.cattable);
            END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN vartype:=%PASCALEXPR.vartype END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
7 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
8 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
9 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_BOOLEANEXPR;
                      $BOOLEANEXPR.vartype:=vartype;
                END
*>
END;
PROCEDURAL PART
VAR commatchfile,decommatchfile,allexist:LocalFile;
    listvar:TSTRING_string;
    equal::bool;
    allexistcounter::int;
    vartypes::setofvartypes;
BEGIN
INIT: BEGIN
        vartypes:=$$BOOLEANEXPR.vartypes;
        allexistcounter:=$$BOOLEANEXPR.allexistcounter;
        INITLOCALFILE(allexist);
        INITLOCALFILE(commatchfile);
        INITLOCALFILE(decommatchfile);
      END;
<*
1: <* SEND: BEGIN %%PASCALEXPR.vartypes:=vartypes;
                  %%PASCALEXPR.allexistcounter:=allexistcounter;
            END
      !PASCALEXPR.
      RECEIVE: BEGIN 
                 allexistcounter:=%%PASCALEXPR.allexistcounter;
                 Appendlocfile(%%PASCALEXPR.casefile,allexist);
                 AppendLocFile(%%PASCALEXPR.commatchfile,commatchfile);
                 AppendLocFile(%%PASCALEXPR.decommatchfile,decommatchfile);
               END
   *>
2: <* SEND: BEGIN %%CONDRECORD.allexistcounter:=allexistcounter END
      !CONDRECORD.
      RECEIVE: BEGIN 
                 allexistcounter:=%%CONDRECORD.allexistcounter;
                 AppendLocFile(%%CONDRECORD.allexist,allexist);
                 AppendLocFile(%%CONDRECORD.commatchfile,commatchfile);
                 AppendLocFile(%%CONDRECORD.decommatchfile,decommatchfile);
               END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 BEGIN \commatchfile.\LOCAL. END;
                 BEGIN
                   "TRUE"
                 END;
               END
   *>
4: <* SEND: BEGIN listvar:=%MUVAR.str END
      !.
      RECEIVE: BEGIN 
               END
   *>
5: <* SEND: BEGIN equal:=TRUE END
      !.
      RECEIVE: BEGIN 
               END
   *>
6: <* SEND: BEGIN equal:=FALSE END
      !.
      RECEIVE: BEGIN 
               END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \commatchfile.\LOCAL.
                    IF equal THEN
                     BEGIN
                     "((" ""listvar"" ".first=NIL) AND"
                     "(" ""listvar"" ".last=NIL))"\\
                     END
                    ELSE
                     BEGIN
                     "(" ""listvar"" ".first<>NIL)"\\
                     END
               END
   *>
8: <* SEND: BEGIN listvar:=%SIGMAVAR.str END
      !.
      RECEIVE: BEGIN 
               END
   *>
9: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
*>
FINAL:BEGIN 
        $$BOOLEANEXPR.allexist:=allexist;
        $$BOOLEANEXPR.allexistcounter:=allexistcounter;
        $$BOOLEANEXPR.commatchfile:=commatchfile;
        $$BOOLEANEXPR.decommatchfile:=decommatchfile;
      END
END;
&
 
%MATCHBOOLEAN
BASIS RULE
    MATCHBOOLEAN = 
          (
           [NOTCAT/2].EQUALS/9.ROUNDOPEN/1.(MUVAR/4|SIGMAVAR/5).COMMA/1.LD/11.
                              ROUNDCLOSE/1|
           [NOTCAT/2].FIRST/9.ROUNDOPEN/1.(MUVAR/4|SIGMAVAR/5).COMMA/1.LD/10.
                              ROUNDCLOSE/1|
           [NOTCAT/2].EXIST/3.ROUNDOPEN/1.(MUVAR/4|SIGMAVAR/5).COMMA/1.LD/6.
                              ROUNDCLOSE/1|
           [NOTCAT/2].ALL/7.ROUNDOPEN/1.(MUVAR/4|SIGMAVAR/5).COMMA/1.ITEM/8.
                            ROUNDCLOSE/1
          )

SURFACE PART
VAR
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    RelVarList::SETOFidents;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

  FUNCTION present(ident::ident;S1::setofidents):BOOLEAN;
  VAR ident1::ident;
      result:boolean;
  begin
  result:=false;
  while stillidents(S1) and not(result) do
    begin
    takeident(ident1,S1);
    result := (ident1.str=ident.str)
    end;
  present:=result
  end;

  PROCEDURE MERGESETS(S1::SETOFidents;VAR S2::SETOFidents);
  VAR ident1::ident;
  BEGIN
  WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   IF not(present(ident1,S2)) THEN APPENDident(ident1,S2)
   END
  END;


<*
INIT: BEGIN
        INITsetofidents(MuVarlist);
        INITsetofidents(SigmaVarlist);
        INITsetofidents(NodeVarlist);
        INITsetofidents(TreeVarlist);
        INITsetofidents(RelVarlist);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
