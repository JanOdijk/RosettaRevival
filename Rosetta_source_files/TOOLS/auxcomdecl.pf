pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('auxcomlangspec.pf');

PACKAGE auxcomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     auxcomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   auxcomDECL_Surfrulemode = (loccond, globcond);
   auxcomDECL_psyntcat     = ^auxcomLANGSPEC_Category;
   auxcomDECL_syntcatset   = SET OF auxcomLANGSPEC_Category;
   auxcomDECL_nodeid         = HINIT..HFINAL;
   auxcomDECL_plonodeid      = ^auxcomDECL_lonodeid;
   auxcomDECL_lonodeid       = RECORD
   			          next: auxcomDECL_plonodeid;
   			          arg : auxcomDECL_nodeid
   	 	               END;
   auxcomDECL_pSnode       = ^auxcomDECL_Snode;
   auxcomDECL_pRsnode      = ^auxcomDECL_Rsnode;
   auxcomDECL_Rsnode       = RECORD
                                sonnumber:auxcomDECL_nodeid;
                                node    : auxcomDECL_pSnode;
                                brother : auxcomDECL_pRsnode
                             END;
   auxcomDECL_Snode        = RECORD
                                sonlist : auxcomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : auxcomLANGSPEC_Category;
                                ldfield : auxcomLANGSPEC_FieldDef
                             END;
   auxcomDECL_pLostree     = ^auxcomDECL_Lostree;
   auxcomDECL_Lostree      = RECORD
                                next    : auxcomDECL_pLostree;
                                arg     : auxcomDECL_pSnode
                             END;
   auxcomDECL_pConnectionnode
                           = ^auxcomDECL_Connectionnode;
   auxcomDECL_pSingleSegmList
                           = ^auxcomDECL_SingleSegmList;
   auxcomDECL_Connectionnode 
                           = RECORD
                                list    : auxcomDECL_pSingleSegmList;
                                next,
                                prev    : auxcomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   auxcomDECL_SingleSegmList
                           = RECORD
                                next    : auxcomDECL_pSingleSegmlist;
                                rn      : auxcomDECL_pConnectionnode;
                                stree   : auxcomDECL_pSnode
                             END;
   auxcomDECL_psurfgraph     = ^auxcomDECL_surfgraphtype;
   auxcomDECL_psurfgraphnode = ^auxcomDECL_surfgraphnode;
   auxcomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: auxcomDECL_psurfgraphnode
   		               END;
   auxcomDECL_plossurfgraphnode 
                             = ^auxcomDECL_lossurfgraphnode;
   auxcomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : auxcomDECL_plossurfgraphnode;
   			       END;
   auxcomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  auxcomDECL_plossurfgraphnode;
   				   arg  :  auxcomDECL_psurfgraphnode
   			       END;
   auxcomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: auxcomDECL_psurfgraphnode;
   			          n    : auxcomDECL_nodeid;
   			          cat  : auxcomDECL_psyntcat;
   			          nextnodes: auxcomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : auxcomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

