object mw_atrans_label : XmLabel widget {
    arguments {
        arguments label_args;
	XmNlabelString      = N_mw_atrans_text;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_atrans_text);
    };
};

object mw_input_area : XmScrolledText {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
	XmNtopWidget	    = XmLabel mw_input_label;
	XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn mw_analysis_button_box;
	XmNrightAttachment  = XmATTACH_WIDGET;
	XmNrightWidget      = XmFrame mw_analysis_frame;
	XmNrightOffset      = spacing;

        arguments text_args;
	XmNeditable         = false;
	XmNeditMode         = XmMULTI_LINE_EDIT;
	XmNcolumns          = 60;
	XmNrows             = 10;
        XmNscrollHorizontal = false;
        XmNwordWrap         = true;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_input_area);
    };
};

object mw_translate_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString = N_mw_translate_button;
        XmNsensitive   = false;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_translate_button);
        XmNactivateCallback = procedure XwbAction (X_mw_translate_button);
    };
};

