\newpage
\begin{verbatim}
% TRANSFORMATION TExtrapFinControl 
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I5:mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/I4::VERB{VERBrec1}[mu8],
                       mu9
                     ],
              mu10,
              extraposrel/I3::SENTENCE{SENTENCErec1}
                         [ mu4, 
                           I2:subjrel/T2, 
                           mu5 
                         ],
              mu6
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I5:mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/I4::VERB{VERBrec1}[mu8],
                       mu9
                     ],
              mu10,
              extraposrel/I3::SENTENCE{SENTENCErec1}
                         [ mu4, 
                           subjrel/NP{NPrec1}
                                  [ head/T3 ], 
                           mu5 
                         ],
              mu6
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: SENTENCErec1.finiteness = finite AND 
           SENTENCErec1.mood = declarative
       I4: VERBrec1.controller = subject OR
           synBE IN VERBrec1.synvps
       I5: NOT EXIST (mu2, [I51:auxrel/VERB{VERBrec2}[mu3]])
         I51: VERBrec2.subc = modalverb
       m1: synBE IN VERBrec1.synvps ->
           ( synBE IN CLAUSErec1.synvpefs AND
             EXIST (mu9, [ I11:predrel/N1[mu3] ]) )
       m : synBE IN VERBrec1.synvps ->
           ( synBE IN CLAUSErec1.synvpefs AND
             EXIST (mu9, [ I11:predrel/N1[mu3] ]) )
       I11: N1.CAT IN [ ADJP, NP, PREPP, ADVP ]
      >

<
   SUBRULE (* 1a. NPVAR - PERSPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative]
            C11: NPVARrec1.person = 1 AND
                 NPVARrec1.number = singular
            A11: KEY1 := KEY_iBPERSPROkey;
            C12: NPVARrec1.person = 2 AND
                 NPVARrec1.number = singular
            A12: KEY1 := KEY_yousgBPERSPROkey;
            C13: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (masculine IN NPVARrec1.sexes OR
                  (masculinegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (feminine IN NPVARrec1.sexes OR
                  (femininegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 NPVARrec1.sexes = [] AND
                 NPVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C17: NPVARrec1.person = 1 AND
                 NPVARrec1.number = plural
            A17: KEY1 := KEY_weBPERSPROkey;
            C18: NPVARrec1.person = 2 AND
                 NPVARrec1.number = plural
            A18: KEY1 := KEY_youplBPERSPROkey;
            C19: NPVARrec1.person = 3 AND
                 NPVARrec1.number = plural
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := nominative;
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >

   SUBRULE (* 1b. NPVAR - INDEFPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:INDEFPRO(KEY_oneINDEFPROkey){INDEFPROrec1}>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              NPVARrec1.NPhead = oneNP
          A1: NPrec1 := AUX_NPONoneINDFPR;
              NPrec1.cases := NPVARrec2.cases
         >

   SUBRULE (* 2. CNVAR - PERSPRO *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = [nominative]
            C13: singular IN CNVARrec1.numbers AND
                 (masculine IN CNVARrec1.sexes OR
                  (masculinegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: singular IN CNVARrec1.numbers AND
                 (feminine IN CNVARrec1.sexes OR
                  (femininegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: singular IN CNVARrec1.numbers AND
                 CNVARrec1.sexes = [] AND
                 CNVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C19: plural IN CNVARrec1.numbers
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >

>

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TExtrapFinControl
\item[* relevant examples:] x1 do think [that x1 will be swimming] 
$\rightarrow$ x1
do think [he/we/they etc will be swimming] (as translation of a Dutch openInf:
x1 denkt te zullen zwemmen)\\
x1 be certain yesterday [that x1 must leave] $\rightarrow$ x1 be certain 
yesterday [that he/we/... must leave] (as translation of Dutch: x1 was er zeker 
van te moeten vertrekken)
\item[* language:] English
\item[* kind of rule:]  M-rule
\item[* subgrammar:]  XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_NOC
\item[* date of creation:]  25-JAN-1989
\item[* author:] margreet sanders
\item[* copied from:] Dutch TFinControl
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 30/03/89\ \ \ \ \ author: margreet sanders\\
Adapted to allow for sentences coming from a predrel/XP having the copula `be';
it is assumed they all have subject control, which may not always be true; 
however, there is no attribute spelling out what is the correct controller.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to take care of subject control for finite complements.
(in generation only). It is intended to be used when a translation occurred from
an infinite open sentence into a finite sentence.
\item[\ \ strategy:] (also: deviations from accepted proposals)
The subject variable is spelled out as a personal pronoun of the correct number
, person (and gender) or as the INDEFPRO `one'.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] different tree for 
perspro's and indefpro.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] No analysis allowed! A 
finite subsentence will go to finite transfer, because the subject in the 
subsentence must never be interpreted solely as a `controlled variable'.
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION TComplFinControl 
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I4:mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/VERB{VERBrec1}[mu8],
                       mu6
                     ],
              mu10
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I4:mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/VERB{VERBrec1}[mu8],
                       mu11
                     ],
              mu10
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I4: NOT EXIST (mu2, [I41:auxrel/VERB{VERBrec2}[mu14]])
         I41: VERBrec2.subc = modalverb
      >

<
   SUBRULE (* 1. no embedded predrel *)
      < mu6: [ mu3,
               complrel/I3::SENTENCE{SENTENCErec1}
                       [ mu4, 
                         I2:subjrel/T2, 
                         mu5 
                       ],
               mu9
             ]
      >
      < mu11: [ mu3,
                complrel/I3::SENTENCE{SENTENCErec1}
                        [ mu4, 
                          subjrel/NP{NPrec1}
                                 [ head/T3 ], 
                          mu5 
                        ],
                mu9
              ]
      >

   MATCHCONDITIONS
      <
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: SENTENCErec1.finiteness = finite AND 
           SENTENCErec1.mood = declarative
      >

   <
     SUBRULE (* 1a. NPVAR - PERSPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              VERBrec1.controller = subject
            C11: NPVARrec1.person = 1 AND
                 NPVARrec1.number = singular
            A11: KEY1 := KEY_iBPERSPROkey;
            C12: NPVARrec1.person = 2 AND
                 NPVARrec1.number = singular
            A12: KEY1 := KEY_yousgBPERSPROkey;
            C13: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (masculine IN NPVARrec1.sexes OR
                  (masculinegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (feminine IN NPVARrec1.sexes OR
                  (femininegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 NPVARrec1.sexes = [] AND
                 NPVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C17: NPVARrec1.person = 1 AND
                 NPVARrec1.number = plural
            A17: KEY1 := KEY_weBPERSPROkey;
            C18: NPVARrec1.person = 2 AND
                 NPVARrec1.number = plural
            A18: KEY1 := KEY_youplBPERSPROkey;
            C19: NPVARrec1.person = 3 AND
                 NPVARrec1.number = plural
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := nominative;
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >

   SUBRULE (* 1b. NPVAR - INDEFPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:INDEFPRO(KEY_oneINDEFPROkey){INDEFPROrec1}>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              VERBrec1.controller = subject AND
              NPVARrec1.NPhead = oneNP
          A1: NPrec1 := AUX_NPONoneINDFPR;
              NPrec1.cases := NPVARrec2.cases
         >

   SUBRULE (* 1c. CNVAR - PERSPRO *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = [nominative] AND
              VERBrec1.controller = subject
            C13: singular IN CNVARrec1.numbers AND
                 (masculine IN CNVARrec1.sexes OR
                  (masculinegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: singular IN CNVARrec1.numbers AND
                 (feminine IN CNVARrec1.sexes OR
                  (femininegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: singular IN CNVARrec1.numbers AND
                 CNVARrec1.sexes = [] AND
                 CNVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C19: plural IN CNVARrec1.numbers
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >
   >

   SUBRULE (* 2. embedded predrel *)
      < mu6: [ mu3,
               predrel/I11::N1
                      [ mu12,
                        I3:rel1/SENTENCE{SENTENCErec1}
                                [ mu4, 
                                  I2:subjrel/T2, 
                                  mu5 
                                ],
                        mu13
                      ],
               mu9
             ]
      >
      < mu11: [ mu3,
                predrel/I11::N1
                       [ mu12,
                         I3:rel1/SENTENCE{SENTENCErec1}
                                 [ mu4, 
                                   subjrel/NP{NPrec1}
                                          [ head/T3 ], 
                                   mu5 
                                 ],
                         mu13
                       ],
                mu9
              ]
      >

   MATCHCONDITIONS
      <
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: SENTENCErec1.finiteness = finite AND 
           SENTENCErec1.mood = declarative AND
           rel1 IN [complrel, toinfmodrel, postadjrel, causadvrel,
                    toinfcomplrel, resultrel]
       I11: N1.CAT IN [ADJP, NP, PREPP, ADVP]
      >

   <
     SUBRULE (* 2a. NPVAR - PERSPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs
            C11: NPVARrec1.person = 1 AND
                 NPVARrec1.number = singular
            A11: KEY1 := KEY_iBPERSPROkey;
            C12: NPVARrec1.person = 2 AND
                 NPVARrec1.number = singular
            A12: KEY1 := KEY_yousgBPERSPROkey;
            C13: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (masculine IN NPVARrec1.sexes OR
                  (masculinegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (feminine IN NPVARrec1.sexes OR
                  (femininegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 NPVARrec1.sexes = [] AND
                 NPVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C17: NPVARrec1.person = 1 AND
                 NPVARrec1.number = plural
            A17: KEY1 := KEY_weBPERSPROkey;
            C18: NPVARrec1.person = 2 AND
                 NPVARrec1.number = plural
            A18: KEY1 := KEY_youplBPERSPROkey;
            C19: NPVARrec1.person = 3 AND
                 NPVARrec1.number = plural
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := nominative;
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >

   SUBRULE (* 2b. NPVAR - INDEFPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:INDEFPRO(KEY_oneINDEFPROkey){INDEFPROrec1}>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs AND
              NPVARrec1.NPhead = oneNP
          A1: NPrec1 := AUX_NPONoneINDFPR;
              NPrec1.cases := NPVARrec2.cases
         >

   SUBRULE (* 2c. CNVAR - PERSPRO *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = [nominative] AND
              synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs
            C13: singular IN CNVARrec1.numbers AND
                 (masculine IN CNVARrec1.sexes OR
                  (masculinegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: singular IN CNVARrec1.numbers AND
                 (feminine IN CNVARrec1.sexes OR
                  (femininegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: singular IN CNVARrec1.numbers AND
                 CNVARrec1.sexes = [] AND
                 CNVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C19: plural IN CNVARrec1.numbers
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >
    >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TComplFinControl
\item[* relevant examples:] \mbox{}\\
subrule 1: x1 do think [x1 will be swimming] $\rightarrow$ x1
do think [he/we/they etc will be swimming] (as translation of a Dutch openInf:
x1 denkt te zullen zwemmen)\\
subrule 2: x1 do be certain [(that) x1 must leave] yesterday $\rightarrow$ x1 
do be certain [(that) he/we/... must leave] yesterday (as translation of Dutch: 
x1 is er zeker van te moeten vertrekken)  (perhaps also for a predrel/PREPP as 
in `x1 be of the opinion that';
unless this is not a complement going with the prep, but a modification of the 
noun `opinion')
\item[* language:] English
\item[* kind of rule:]  M-rule
\item[* subgrammar:]  XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_NOC
\item[* date of creation:]  25-JAN-1989
\item[* author:] margreet sanders
\item[* copied from:] TExtrapFinControl
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 30/03/89\ \ \ \ \ author: margreet sanders\\
Added an extra set of subrules for the case the sentence is in an embedded 
predrel/XP
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to take care of subject control for finite complements that have 
not been extraposed (e.g. a subsentence without conjunction `that')
(in generation only). It is intended to be used when a translation occurred from
an infinite open sentence into a finite sentence.
\item[\ \ strategy:] (also: deviations from accepted proposals)
The subject variable is spelled out as a personal pronoun of the correct number
, person (and gender) or as the INDEFPRO `one'.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] different tree for 
perspro's and indefpro.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] No analysis allowed! A 
finite subsentence will go to finite transfer, because the subject in the 
subsentence must never be interpreted solely as a `controlled variable'.
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION TPrepFinControl 
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I5:mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/VERB{VERBrec1}[mu8],
                       mu3,
                       I4:rel1/N1
                              [ mu6,
                                objrel/I3::SENTENCE{SENTENCErec1}
                                      [ mu4, 
                                        I2:subjrel/T2, 
                                        mu5 
                                      ]
                              ],
                       mu9
                     ],
              mu10
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              I1:subjrel/T1,
              I5:mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu7,
                       head/VERB{VERBrec1}[mu8],
                       mu3,
                       I4:rel1/N1
                              [ mu6,
                                objrel/I3::SENTENCE{SENTENCErec1}
                                      [ mu4, 
                                        subjrel/NP{NPrec1}
                                               [ head/T3 ], 
                                        mu5 
                                      ]
                              ],
                       mu9
                     ],
              mu10
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: SENTENCErec1.finiteness = finite AND 
           SENTENCErec1.mood = declarative
       I4: rel1 IN [prepobjrel, byobjrel] AND
           N1.CAT IN [PREPP, VARPREPP]
       I5: NOT EXIST (mu2, [I51:auxrel/VERB{VERBrec2}[mu11]])
         I51: VERBrec2.subc = modalverb
      >

<
   SUBRULE (* 1a. NPVAR - PERSPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              VERBrec1.controller = subject
            C11: NPVARrec1.person = 1 AND
                 NPVARrec1.number = singular
            A11: KEY1 := KEY_iBPERSPROkey;
            C12: NPVARrec1.person = 2 AND
                 NPVARrec1.number = singular
            A12: KEY1 := KEY_yousgBPERSPROkey;
            C13: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (masculine IN NPVARrec1.sexes OR
                  (masculinegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 (feminine IN NPVARrec1.sexes OR
                  (femininegender IN NPVARrec1.genders AND
                   NPVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: NPVARrec1.person = 3 AND
                 NPVARrec1.number = singular AND
                 NPVARrec1.NPhead <> oneNP AND
                 NPVARrec1.sexes = [] AND
                 NPVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C17: NPVARrec1.person = 1 AND
                 NPVARrec1.number = plural
            A17: KEY1 := KEY_weBPERSPROkey;
            C18: NPVARrec1.person = 2 AND
                 NPVARrec1.number = plural
            A18: KEY1 := KEY_youplBPERSPROkey;
            C19: NPVARrec1.person = 3 AND
                 NPVARrec1.number = plural
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := nominative;
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >

   SUBRULE (* 1b. NPVAR - INDEFPRO *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} 
        T3:INDEFPRO(KEY_oneINDEFPROkey){INDEFPROrec1}>

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
              NPVARrec2.cases = [nominative] AND
              VERBrec1.controller = subject AND
              NPVARrec1.NPhead = oneNP
          A1: NPrec1 := AUX_NPONoneINDFPR;
              NPrec1.cases := NPVARrec2.cases
         >

   SUBRULE (* 2. CNVAR - PERSPRO *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} 
        T3:PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY1){BPERSPROrec1}]>

      COMP
         <
          C1: CNVARrec1 = CNVARrec2 EXCEPT FOR [cases] AND
              CNVARrec2.cases = [nominative] AND
              VERBrec1.controller = subject
            C13: singular IN CNVARrec1.numbers AND
                 (masculine IN CNVARrec1.sexes OR
                  (masculinegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = [] ) )
            A13: KEY1 := KEY_heBPERSPROkey;
            C14: singular IN CNVARrec1.numbers AND
                 (feminine IN CNVARrec1.sexes OR
                  (femininegender IN CNVARrec1.genders AND
                   CNVARrec1.sexes = []) )
            A14: KEY1 := KEY_sheBPERSPROkey;
            C15: singular IN CNVARrec1.numbers AND
                 CNVARrec1.sexes = [] AND
                 CNVARrec1.genders = [omegagender]
            A15: KEY1 := KEY_itBPERSPROkey;
            C19: plural IN CNVARrec1.numbers
            A19: KEY1 := KEY_theyBPRSPRkey;
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              NPrec1 := AUX_NPonPRSPR;
              NPrec1 := { person  : BPERSPROrec1.person
                          number  : BPERSPROrec1.number
                          genders : [BPERSPROrec1.gender]
                          animate : BPERSPROrec1.animate 
                          NPhead  : BPERSPROrec1.NPhead
                          cases   : NPVARrec2.cases }
         >

>

&

\end{verbatim}
