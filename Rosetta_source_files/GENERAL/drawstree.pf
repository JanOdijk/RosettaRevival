pragma C_Include('oldtree.pf');
pragma C_Include('drawtree.pf');
pragma C_Include('listree.pf');
pragma C_Include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE DrawSTree;
WITH OLDTREE, DRAWTREE, LISTREE, WND;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawSTree_GenerateTree
 *  Description     : Prints the S-tree in a newly created window on the screen.
 *                    The user can walk through the tree by means of the cursor
 *                    keys. He furthermore can enlarge a node by hitting the 
 *                    "DO" key. Before returning control to the calling program
 *                    the window is closed.
 *  Parameters      : OldNode: LISTREE_pStree; The S-tree that is to be printed
 *  Precondition    : Oldnode contains a correct S-tree
 *  Postcondition   : None
 *  Side Effects    : The S-tree is printed on the screen
 *
 *EMP:::===================================================================*)

PROCEDURE DrawSTree_GenerateTree(OldNode : LISTREE_pStree);
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawSTree_CreateTree
 *  Description     : Prints the S-tree in a already existing window (with id tree_id)
 *                    on the screen.
 *  Parameters      :
 *  Precondition    :
 *  Postcondition   :
 *  Side Effects    :
 *
 *EMP:::===================================================================*)

PROCEDURE DrawSTree_CreateTree(OldNode : LISTREE_pStree; tree_id : WND_Xid);
EXTERNAL;

FUNCTION DrawSTree_Manage(OldNode : LISTREE_pStree; parent_id : WND_Xid): integer;
EXTERNAL;


END {DrawSTree};
