\newpage
\begin{verbatim}
% RULE RPrepIngSubsent
< m1: I1::NP{NPrec1}
            [ head/SENTENCE{SENTENCErec1}[mu1] ]
  m2: T1
>

< m : PREPP{PREPPrec1}
           [ I2:head/T1,
             objrel/I1::NP{NPrec1}
                          [head/SENTENCE{SENTENCErec2}[mu1]]
           ] 
>

   MATCHCONDITIONS
      <
       I1: NPrec1.NPhead IN [openIngNP, sentNP]
       m2: T1.CAT IN [PREP]
       I2: T1.CAT IN [PREP]
      >

<
   SUBRULE (* 1. temporal *)
      < T1: PREP{PREPrec1} >
      < T1: PREP{PREPrec1} >

   MATCHCONDITIONS
      <
       T1: temp IN PREPrec1.subcs
      >

      COMP
         <
          C1: SENTENCErec1.adverbial = false
            C11: synOPENGERUND IN PREPrec1.synpps AND
                 NPrec1.NPhead = openIngNP
            A11: PREPPrec1.synppefs := [synOPENGERUND]
            C12: synNP IN PREPrec1.synpps AND
                 NPrec1.NPhead = sentNP 
            A12: PREPPrec1.synppefs := [synNP]
          A1: PREPPrec1 := { actsubcefs  : [temp]
                             req         : PREPrec1.req
                             env         : PREPrec1.env
                             mood        : NPrec1.mood
                             thetapp     : PREPrec1.thetapp
                             headkey     : PREPrec1.key
                             class       : PREPrec1.class
                             deixis      : PREPrec1.deixis
                             aspect      : NPrec1.aspect
                             retro       : NPrec1.retro
                             superdeixis : NPrec1.superdeixis
                             specQ       : NPrec1.specQ
                             stranded    : false };
             SENTENCErec2 := SENTENCErec1;
             SENTENCErec2.adverbial := true
         >
    
      DECOMP
         <
          C1: PREPPrec1  = { actsubcefs  : [temp]
                             req         : PREPrec1.req
                             env         : PREPrec1.env
                             mood        : NPrec1.mood
                             thetapp     : PREPrec1.thetapp
                             headkey     : PREPrec1.key
                             class       : PREPrec1.class
                             deixis      : PREPrec1.deixis
                             aspect      : NPrec1.aspect
                             retro       : NPrec1.retro
                             superdeixis : NPrec1.superdeixis
                             specQ       : NPrec1.specQ
                             stranded    : false } AND
              SENTENCErec2.adverbial = true
            C11: synNP IN PREPrec1.synpps AND 
                 synNP IN PREPPrec1.synppefs AND
                 NPrec1.NPhead = sentNP 
            A11: @
            C12: synOPENGERUND IN PREPrec1.synpps AND
                 synOPENGERUND IN PREPPrec1.synppefs AND
                 NPrec1.NPhead = openIngNP
            A12: @
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.adverbial := false
         >

   SUBRULE (* 2. non-temporal *)
      < T1: PREP{PREPrec1} >
      < T1: PREP{PREPrec1} >

   MATCHCONDITIONS
      <
       T1: PREPrec1.subcs - [temp] <> []
      >

      COMP
         <
          C1: SENTENCErec1.adverbial = false
            C11: synOPENGERUND IN PREPrec1.synpps AND
                 NPrec1.NPhead = openIngNP
            A11: PREPPrec1.synppefs := [synOPENGERUND]
            C12: synNP IN PREPrec1.synpps AND
                 NPrec1.NPhead = sentNP 
            A12: PREPPrec1.synppefs := [synNP]
          A1: PREPPrec1 := { req         : PREPrec1.req
                             env         : PREPrec1.env
                             mood        : NPrec1.mood
                             thetapp     : PREPrec1.thetapp
                             headkey     : PREPrec1.key
                             class       : PREPrec1.class
                             deixis      : PREPrec1.deixis
                             aspect      : NPrec1.aspect
                             retro       : NPrec1.retro
                             superdeixis : NPrec1.superdeixis
                             specQ       : NPrec1.specQ
                             stranded    : false };
             PREPPrec1.actsubcefs := ( PREPrec1.subcs - [temp] );
             SENTENCErec2 := SENTENCErec1;
             SENTENCErec2.adverbial := true
         >
    
      DECOMP
         <
          C1: PREPPrec1  = { req         : PREPrec1.req
                             env         : PREPrec1.env
                             mood        : NPrec1.mood
                             thetapp     : PREPrec1.thetapp
                             headkey     : PREPrec1.key
                             class       : PREPrec1.class
                             deixis      : PREPrec1.deixis
                             aspect      : NPrec1.aspect
                             retro       : NPrec1.retro
                             superdeixis : NPrec1.superdeixis
                             specQ       : NPrec1.specQ
                             stranded    : false } AND
              PREPPrec1.actsubcefs = ( PREPrec1.subcs - [temp] ) 
              AND
              SENTENCErec2.adverbial = true
            C11: synNP IN PREPrec1.synpps AND 
                 synNP IN PREPPrec1.synppefs AND
                 NPrec1.NPhead = sentNP 
            A11: @
            C12: synOPENGERUND IN PREPrec1.synpps AND
                 synOPENGERUND IN PREPPrec1.synppefs AND
                 NPrec1.NPhead = openIngNP
            A12: @
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.adverbial := false
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RPrepIngSubsent
\item[* relevant examples:] \mbox{}
x1 leaving + before $\rightarrow$ before x1 leaving\\
my noticing + without $\rightarrow$ without my noticing
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] ClauseToSentence
\item[* class:] (name of rule, transformation or filter class) RC\_ConjSent
\item[* date of creation:] 10-OCT-1988 
\item[* author:] margreet sanders
\item[* copied from:] Dutch Rconjsent4
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 17/10/89\ \ \ \ \ author: margreet sanders\\
Added change of the SENTENCE attribute {\em adverbial\/}. Needed for 
FPostConjSentControl (and probably also for the Surface parser; perhaps more 
attributes will have to be reset!)
\item date: 27/11/89\ \ \ \ \ author: margreet sanders\\
split up the rule in two subrules, to set the actsubcefs of the PREPP to 
either [temp] or the rest of the set of the PREP. Needed for propsubst 
(R(final)conjsentsubst), so that temporal conjsentNPs will not be substituted 
by the `ordinary' conjsent substitution rules, but by the temporal substitution 
rules. Note that there is NO such substitution rule yet for temporal sentNPs/
openIngNPs!
\end{enumerate}
\item[* task:] to form an adverbial clause from a subordinate ing-clause headed 
by an NP, and an PREP
