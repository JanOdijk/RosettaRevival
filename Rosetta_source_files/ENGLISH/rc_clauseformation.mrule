\newpage
\begin{verbatim}
% RULE RPasClauseFormation
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [mu1,
                    predrel/VERBP{VERBPrec1}[I3:mu2],
                    mu3
                   ]
>

< m : I2::CLAUSE{CLAUSErec1}
                [mu1,
                 predrel/VERBP{VERBPrec1}
                        [passauxrel/VERB{VERBrec1}
                               [head/SUBVERB{SUBVERBrec1}
                                    [head/BVERB(AUX_bebverbkey){BVERBrec1}]
                               ],
                         mu2
                        ],
                 mu3
                ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.voice = passive
       I2: CLAUSErec1.voice = passive
       I3: NOT EXIST (mu2, [auxrel/I31::VERB{VERBrec2}[mu4]])
           I31: VERBrec2.subc = modalverb
      >

      COMP
         <
          C1: true
          A1: CLAUSErec1 := COPYT_verbppropTOclause(VERBPPROPrec1);
              (* all other attributes receive default values *)
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1)
              (* all other attributes receive default values *)
         >
      DECOMP
         <
          C1: CLAUSErec1 = { modus      : omegamodus
                             aspect     : omegaAspect
                             deixis     : omegaDeixis
                             retro      : false
                             finiteness : omegafin
                             infsort    : omegainf }
              (* default values for attributes specific to CLAUSE *)
              AND
              SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix AND
              VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1) AND
              VERBrec1 = { numbers : []
                           persons : []
                           modus   : omegamodus
                           tense   : omegatense }
              (* default values for attributes specific to VERB *)
          A1: VERBPPROPrec1 := COPYT_clauseTOverbpprop(CLAUSErec1)
         >
&

\end{verbatim}
