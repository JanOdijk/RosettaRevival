\newpage
\begin{verbatim}
% TRANSFORMATION TOblControl1a   (* OPENADJPPROP, object control *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     objrel/T1,
                     mu3,
                     complrel/OPENADJPPROP{OPENADJPPROPrec1}
                            [ subjrel/T2,
                              predrel/ADJP{ADJPrec1}[mu4] 
                            ],
                     mu5 
                   ],
             mu6
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     objrel/T1,
                     mu3,
                     predrel/ADJP{ADJPrec1}[mu4], 
                     mu5 
                   ],
             mu6
           ]
>

<
   SUBRULE  (* 1 *)
      <
       T1: NPVAR{NPVARrec1} 
       T2: NPVAR{NPVARrec2}
      >
      < 
       T1: NPVAR{NPVARrec1} 
      >

      COMP
         <
          C1: ( NPVARrec1 = NPVARrec2 ) AND
              ( OPENADJPPROPrec1 =
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : true
		   }
              )     
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec2.synvpefs * [synDONP_OPENADJPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
              [synDONP_OPENADJPPROP];
              NPVARrec2 := NPVARrec1;
              OPENADJPPROPrec1 :=
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : true
		   }
         >


   SUBRULE (* 2 *)
      <
       T1: CNVAR{CNVARrec1} 
       T2: CNVAR{CNVARrec2}
      >
      < 
       T1: CNVAR{CNVARrec1} 
      >

      COMP
         <
          C1: ( CNVARrec1 = CNVARrec2 ) AND
              ( OPENADJPPROPrec1 =
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : true
		   }
              )        
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDONP_OPENADJPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
              [synDONP_OPENADJPPROP];
              CNVARrec2 := CNVARrec1;
              OPENADJPPROPrec1 :=
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : true
		   }
         >
>
&

\end{verbatim}
