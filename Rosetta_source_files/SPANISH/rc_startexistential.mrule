\newpage
\begin{verbatim}
% RULE RExistConjsentVar
< m1: NPPROP{NPPROPrec1}[I1:mu1] 

  m2: SENTENCEVAR{SENTENCEVARrec1}
>

< m : NPPROP{NPPROPrec1}
            [ leftdislocrel/SENTENCEVAR{SENTENCEVARrec1},
              I1:mu1
            ] 
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1, [leftdislocrel/..])
      >

      COMP
         <
          C1: SENTENCEVARrec1.adverbial = true 
          A1: @
         >

      DECOMP
         <
          C1: SENTENCEVARrec1.adverbial = true 
          A1: @
         >

&

\end{verbatim}
