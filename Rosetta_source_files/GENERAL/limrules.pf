(*MPT:::===================================================================*
 *
 *  Type name      : LIMRULES_CeRuleSet
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LIMRULES_pLoCeRule = ^LIMRULES_LoCeRule;
   LIMRULES_LoCeRule  = RECORD
                           nxt : LIMRULES_pLoCeRule;
                           elt : INTEGER;
                           kind: LDMRULES_CtrlExprKind
                        END;
   LIMRULES_CeRuleSet = RECORD
                           BeginOfSG: BOOLEAN;
                           EndOfSG  : BOOLEAN;
                           Eps      : BOOLEAN;
                           first, last : LIMRULES_pLoCeRule
                        END;
   


