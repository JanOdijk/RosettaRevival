\newpage
\begin{verbatim}
%
% TRANSFORMATION TNoControlVERBP      (* CLOSEDVERBPPROP *)
< m1:CLAUSE{CLAUSErec1}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      complrel/CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}
                              [ I2:subjrel/T1,
                                predrel/VERBP{VERBPrec2}
                                       [mu3,
                                        head/VERB{VERBrec2}[mu6],
                                        mu7
                                       ] 
                              ],
                      mu4 
                    ],
             mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I3:mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I2:objrel/T1,
                      predrel/VERBP{VERBPrec2}
                             [mu3,
                              head/VERB{VERBrec2}[mu6],
                              mu7
                             ],
                      mu4 
                    ],
             mu5
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [objrel/..])
       I2: T1.CAT IN [NP, NPVAR, CNVAR]
       I3: NOT EXIST (mu1, [I31:auxrel/VERB{VERBrec1}[mu11]])
         I31: VERBrec1.subc = modalverb
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_closedxppvps <> [] AND
              CLOSEDVERBPPROPrec1 = { superdeixis : omegadeixis 
                                      PROsubject  : false }
              AND
              QUOTE_CheckAktArts(VERBrec2.classes,
                                 CLOSEDVERBPPROPrec1.aktionsarts)
          A1: CLAUSErec2 := CLAUSErec1;
              VERBPrec2 := { voice    : CLOSEDVERBPPROPrec1.voice
                             synvps   : CLOSEDVERBPPROPrec1.synvpefs
                             thetavp  : CLOSEDVERBPPROPrec1.thetavp }
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_closedxppvps <> [] 
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                 CLAUSErec2.synvpefs * AUX_closedxppvps;
              CLOSEDVERBPPROPrec1 := { superdeixis : omegadeixis 
                                       PROsubject  : false
                                       voice       : VERBPrec2.voice
                                       synvpefs    : VERBPrec2.synvps
                                       thetavp     : VERBPrec2.thetavp };
              QUOTE_AssignAktArts(VERBrec2.classes,
                                  CLOSEDVERBPPROPrec1.aktionsarts)
         >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] TNoControlVERBP
\item[* relevant examples:]\mbox{}\\
(vp010): ? - get [he [beaten up by his mother]] $\rightarrow$ - get he [beaten 
up by his mother]\\
(vp120): x1 have [the house [built by a famous architect]] $\rightarrow$ x1 
have the house [built by a famous architect]
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_Controlrules
\item[* date of creation:] 04-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:] TNoControlADVP
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 01/06/90\ \ \ \ \ author:Petra de Wit
replaced specific pattern(s) by set of CLOSED patterns
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To let closedverbpprops pass the control rules and to turn their 
subject into an object, deleting the closedverbpprop.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One for NPs,
one for NPVAR and CNVAR.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
