\newpage
\begin{verbatim}
% TRANSFORMATION TOblControl6a
                         (* SENTENCE, nonsubject antecedent *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I1:rel1/T1,
                      mu5,
                      I2:complrel/SENTENCE{SENTENCErec1}
                                 [ I3:mu9,
                                   subjrel/T2,
                                   I4:mu6 
                                 ],
                      mu7 
                    ],
              mu8 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu3],
                      mu4,
                      I1:rel1/T1,
                      mu5,
                      I2:complrel/SENTENCE{SENTENCErec1}
                                 [ I3:mu9,
                                   I4:mu6 
                                 ],
                      mu7 
                    ],
              mu8 
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [objrel, indobjrel]
       I2: SENTENCErec1.PROSubject = true
       I3: ALL(mu9, I31:rel3/..)
           I31: rel3 IN [shiftrel, conjrel]
       I4: NOT EXIST(mu6, [shiftrel/..])
      >

<
   SUBRULE
      <
       T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1}>

      COMP
         <
          C1:( ((rel1 = objrel) AND (VERBrec1.Controller = object)) OR
              ((rel1 = indobjrel) AND (VERBrec1.controller = indobj)) ) AND
              (NPVARrec1 = NPVARrec2)
          A1: @
         >

      DECOMP
         <
          C1:( ((rel1 = objrel) AND (VERBrec1.Controller = object)) OR
              ((rel1 = indobjrel) AND (VERBrec1.controller = indobj)) ) 
          A1: NPVARrec2 := NPVARrec1
         >


   SUBRULE
      <
       T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1}>

      COMP
         <
          C1:( ((rel1 = objrel) AND (VERBrec1.Controller = object)) OR
              ((rel1 = indobjrel) AND (VERBrec1.controller = indobj)) ) AND
              (CNVARrec1 = CNVARrec2)
          A1: @
         >

      DECOMP
         <
          C1:( ((rel1 = objrel) AND (VERBrec1.Controller = object)) OR
              ((rel1 = indobjrel) AND (VERBrec1.controller = indobj)) ) 
          A1: CNVARrec2 := CNVARrec1
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TOblControl6a
\item[* relevant examples:]
(Dutch:  x1 x2 [x2 x3 ] [dwong te lezen]  $\rightarrow$
x1 x2 [x3] dwong te lezen\\
(Piet dwong Klaas de boeken te lezen)\\
x1 x2 [x2 x3] [beval te lezen] $\rightarrow$
x1 x2 [x3] [beval te lezen]\\
(Piet beval Klaas de boeken te lezen ) )
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] TC: Controlrules
\item[* date of creation:] 29-APR-1988 12:55:00  
\item[* author:] Elly van Munster
\item[* copied from:] Jan Odijk
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To interpret and to delete the subject NPVAR or CNVAR of a
complrel/SENTENCE with PROsubject = true, where the antecedent is an
object or an indirect object. (Obligatory Control)
\item[\ \ strategy:] (also: deviations from accepted proposals)
