object mg_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
        XmNdialogTitle = N_mg_window;
        XmNnoResize    = true;
    };
    controls {
        XmFrame mg_rule_frame;
        XmFrame mg_trans_frame;
        XmFrame mg_toggle_frame;
        XmRowColumn mg_button_box;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_mg_window + DEFAULT_BUTTON_OFFSET*X_mg_start_button);
    };
};

object mg_rule_frame : XmFrame {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_FORM;
    };
    controls {
        XmForm {
            arguments {
                arguments form_args;
                XmNbackgroundPixmap = xbitmapfile ('zz');
            };
            controls {
                XmLabel mg_rule_sel_title;
                XmScrolledList mg_rule_sel_list;
                XmLabel mg_rule_info_title;
                XmScrolledList mg_rule_info_list;
                XmRowColumn mg_rule_text;
                XmRowColumn mg_rule_button_box;
            };
        };
    };    
};

object mg_rule_sel_title : XmLabel {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
!	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;

        XmNlabelString      = N_mg_rule_sel_list;
        XmNfontList         = bold;
    };
};

object mg_rule_sel_list : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmLabel mg_rule_sel_title;

        arguments list_args;
        XmNvisibleItemCount = 5;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;
        XmNspacing          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(X_mg_rule_sel_list);
    };    
};

object mg_rule_info_title : XmLabel {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
!	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmScrolledList mg_rule_sel_list;

        XmNlabelString      = N_mg_rule_info_list;
        XmNfontList         = bold;
    };
};

object mg_rule_info_list : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmLabel mg_rule_info_title;

        arguments list_args;
        XmNvisibleItemCount = 5;
        XmNselectionPolicy  = XmSINGLE_SELECT;
        XmNspacing          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(X_mg_rule_info_list);
        XmNsingleSelectionCallback =
                  procedure XwlAction (X_mg_rule_info_list);
    };
};

object mg_rule_text : XmRowColumn {
    arguments {
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmScrolledList mg_rule_info_list;
        XmNleftAttachment    = XmATTACH_FORM;

        XmNbackgroundPixmap = xbitmapfile ('zz');
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                XmNlabelString       = N_mg_rule_text;
                XmNfontList          = bold;
            };
        };
        XmText {
            arguments {
                arguments text_args;
                XmNcolumns           = 30;
            };
            callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_mg_rule_scroll_text);
                XmNactivateCallback = procedure
                    XwlAction(X_mg_rule_add_text);
                XmNvalueChangedCallback = procedure
                    XwlAction(X_mg_rule_scroll_text);
    	    };    
        };
    };
};

object mg_rule_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmRowColumn mg_rule_text;

        arguments button_box_args;
        XmNbackgroundPixmap = xbitmapfile ('zz');
        XmNorientation      = XmHORIZONTAL;
        XmNpacking = XmPACK_TIGHT;
    };
    controls {
        XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString       = N_mg_rule_last_button;
                XmNsensitive         = false;
            };
            callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_mg_rule_last_button);
                XmNactivateCallback = procedure
                    XwbAction(X_mg_rule_last_button);
            };    
        };
        XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString       = N_mg_rule_remove_button;
            };
            callbacks {
                XmNactivateCallback = procedure
                    XwlAction(X_mg_rule_remove_button);
            };    
        };
        XmPushButton {
            arguments {
                arguments button_args;
                XmNlabelString       = N_mg_rule_clear_button;
            };
            callbacks {
                XmNactivateCallback = procedure
                    XwlAction(X_mg_rule_clear_button);
            };    
        };
    };
};

object mg_trans_frame : XmFrame {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;
        XmNleftAttachment    = XmATTACH_WIDGET;
        XmNleftWidget        = XmFrame mg_rule_frame;
        XmNleftOffset        = 2 * spacing_h;
        XmNrightAttachment   = XmATTACH_FORM;
    };
    controls {
        XmForm {
            arguments {
                arguments form_args;
                XmNbackgroundPixmap = xbitmapfile ('zz');
            };
            controls {
                XmLabel mg_trans_sel_title;
                XmScrolledList mg_trans_sel_list;
                XmLabel mg_trans_info_title;
                XmScrolledList mg_trans_info_list;
                XmRowColumn mg_trans_text;
                XmRowColumn mg_trans_button_box;
            };
        };
    };    
};

