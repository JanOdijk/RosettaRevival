object le_button_box : XmRowColumn {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmForm le_comment_form; 
    XmNleftAttachment   = XmATTACH_FORM;
    XmNbottomAttachment = XmATTACH_FORM;
    XmNresizable    = false;

    arguments button_box_args;
    XmNorientation    = XmHORIZONTAL;
  };
  controls {
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString  = 'Previous';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(
          X_le_previous_button);
        XmNactivateCallback = procedure
          XwbAction (X_le_previous_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString  = 'Next';
        XmNsensitive  = false;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(
          X_le_next_button);
        XmNactivateCallback = procedure
          XwbAction (X_le_next_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString  = 'Jump';
        XmNsensitive  = false;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget(
          X_le_jump_button);
        XmNactivateCallback = procedure
          XwbAction (X_le_jump_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString  = 'Return';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_return_button);
        XmNactivateCallback = procedure XwbAction (X_le_return_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString  = 'Select';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_select_button);
        XmNactivateCallback = procedure XwbAction (X_le_select_button);
      };
    };
  };
};

object le_selection_form : XmForm {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmForm le_comment_form; 
    XmNleftAttachment   = XmATTACH_WIDGET;
    XmNleftWidget       = XmRowColumn le_button_box; 
    XmNrightAttachment  = XmATTACH_FORM;
    XmNbottomAttachment = XmATTACH_FORM;
    XmNresizable    = false;
    arguments form_args;
  };
  controls { 
        XmLabel {
          arguments {
            arguments label_args;
            XmNlabelString  = 'Selected: ';
            XmNx = 3;
            XmNy = 1;
          };
        };
        XmLabel {
          arguments {
            arguments label_args;
            XmNlabelString = '';
            XmNx = 85;
            XmNy = 1;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget
                   (X_le_selected_number);
          };
        };
        XmLabel {
          arguments {
            arguments label_args;
            XmNlabelString  = 'Current: ';
            XmNx = 3;
            XmNy = 15;
          };
        };
        XmLabel {
          arguments {
            arguments label_args;
            XmNlabelString = '';
            XmNx = 85;
            XmNy = 15;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget
                   (X_le_current_lemma);
          };
        };
  };
};

end module;
 
