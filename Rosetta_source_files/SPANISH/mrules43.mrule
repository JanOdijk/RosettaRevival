\newpage
\begin{verbatim}
% FILTER ftempindep1
< m:CLAUSE{CLAUSErec1}
           [mu1,
            I1:rel1/SENTENCE{SENTENCErec1}[mu2], 
            mu3
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [leftdislocrel (* , postsentadvrel *)] AND
           SENTENCErec1.temporal = false
      >

<
   SUBRULE (* no haber *)
      <mu2: [I2: mu4] >

   MATCHCONDITIONS
      <
       I2: (NOT EXIST(mu4, [auxrel/I21:: VERB{VERBrec1}[mu5]])) AND
           (NOT EXIST(mu4, [I22:rel1/VERB{VERBrec2}[I221:mu6]])) AND
           (NOT EXIST(mu4, [predrel/VERBP{VERBPrec1}[I23:mu8]]))

       I21: (VERBrec1.status = bareV) AND
            (VERBrec1.subc IN [haberaux])
       I22: rel1 IN [head, auxrel, progauxrel] AND 
            VERBrec2.status = VV 
       I221: EXIST(mu6, [auxrel/I222::VERB{VERBrec3}[mu7]])
       I222: VERBrec3.subc IN [haberaux]
       I23: EXIST (mu8, [auxrel/I231::VERB{VERBrec4}[mu9]])
       I231: VERBrec4.subc IN [haberaux]
 
      >

         <
          C1:true
                 (* independent sentence *)
             C11: (
                  (SENTENCErec1.supertiempo = omegatiempo) AND
                  (((SENTENCErec1.tiempo = presente) AND
                    ((QUOTE_temprefnotfound(mu2)) AND
                     (CLAUSErec1.tiempo = presente) OR
                     (CLAUSErec1.supertiempo = presente) 
                    )  
                 ) OR
                   ((SENTENCErec1.tiempo = pasado) AND
                    ((QUOTE_temprefnotfound(mu2)) AND
                     (CLAUSErec1.tiempo = pasado) OR
                     (CLAUSErec1.supertiempo = pasado)
                    ) 
                   ) 
                  )
                 )
             A11: @
         A1: @
>

   SUBRULE (* haber *)
      <mu2: [I2: mu4] >

   MATCHCONDITIONS
      <
       I2: (EXIST(mu4, [auxrel/I21:: VERB{VERBrec1}[mu5]])) OR
           (EXIST(mu4, [I22:rel1/VERB{VERBrec2}[I221:mu6]])) OR
           (EXIST(mu4, [predrel/VERBP{VERBPrec1}[I23:mu8]]))

       I21: (VERBrec1.status = bareV) AND
            (VERBrec1.subc IN [haberaux])
       I22: rel1 IN [head, auxrel, progauxrel] AND 
            VERBrec2.status = VV 
       I221: EXIST(mu6, [auxrel/I222::VERB{VERBrec3}[mu7]])
       I222: VERBrec3.subc IN [haberaux]
       I23: EXIST(mu8, [auxrel/I231::VERB{VERBrec4}[mu9]])
       I231: VERBrec4.subc IN [haberaux]
 
      >

         <
          C1:true
                 (* independent sentence *)
             C11: (
                  (SENTENCErec1.supertiempo = omegatiempo) AND
                  (((SENTENCErec1.tiempo = presente) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.tiempo = presente) OR
                      (CLAUSErec1.supertiempo = presente)
                     ) 
                    )
                   ) OR
                   ((SENTENCErec1.tiempo = pasado) AND
                    (((QUOTE_temprefnotfound(mu2)) AND
                      (CLAUSErec1.tiempo = pasado) OR
                      (CLAUSErec1.supertiempo = pasado)
                     ) 
                    )
                   )
                  )
                 )
             A11: @
        A1:@
>
>  
  
&
\end{verbatim}
