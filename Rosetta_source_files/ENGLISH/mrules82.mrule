\newpage
\begin{verbatim}
% TRANSFORMATION TNoDoBeDeletion

< m1: T1
>

< m : T1
>

<
   SUBRULE (* 1. SENTENCE *)
      < T1: SENTENCE{SENTENCErec1}
                    [ mu1,
                      predrel/VERBP{VERBPrec1}[mu3],
                      mu4
                    ] >
      < T1: SENTENCE{SENTENCErec1}
                    [ mu1,
                      predrel/VERBP{VERBPrec1}[mu3],
                      mu4
                    ] >

   MATCHCONDITIONS
      <
       T1: SENTENCErec1.finiteness = infinite OR
           ( SENTENCErec1.modus = imperative AND
             EXIST (mu1, [negrel/..])  ) OR
           NOT EXIST (mu1, [auxrel/I1::VERB{VERBrec1}[mu2]]) OR
           NOT EXIST (mu3, [head/I2::VERB{VERBrec2}[mu4]])
       I1: VERBrec1.subc = doaux 
       I2: VERBrec2.subc = beverb
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >

    SUBRULE (* 2. NP *)
       < T1: NP{NPrec1}[mu1] >
       < T1: NP{NPrec1}[mu1] >
    
    MATCHCONDITIONS
       <
        T1: NPrec1.NPhead IN [sentNP, openIngNP]
       >

       COMP
          <
           C1: true
           A1: @
          >
       DECOMP
          <
           C1: true
           A1: @
          >

    SUBRULE (* 3. PREPP *)
       < T1: PREPP{PREPPrec1}[mu1] >
       < T1: PREPP{PREPPrec1}[mu1] >
    
    MATCHCONDITIONS
       <
        T1: EXIST (mu1, [objrel/I1::NP{NPrec1}[mu2]])
        I1: NPrec1.NPhead IN [openIngNP, sentNP]
       >

       COMP
          <
           C1: true
           A1: @
          >
       DECOMP
          <
           C1: true
           A1: @
          >

    SUBRULE (* 4. CLOSEDVERBPPROP *)
       < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >
       < T1: CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}[mu1] >
    
       COMP
          <
           C1: true
           A1: @
          >
       DECOMP
          <
           C1: true
           A1: @
          >
>
&

\end{verbatim}
