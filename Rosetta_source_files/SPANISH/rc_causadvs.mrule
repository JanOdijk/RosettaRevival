\begin{verbatim}
%
% RULE Rcausadvvar
< m1: VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  mu3 
                ]

  m2: I1::ADVPVAR{ADVPVARrec1}                 
>

< m :VERBPPROP{VERBPPROPrec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  causadvrel/I1::ADVPVAR{ADVPVARrec1},
                  mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: causadv IN ADVPVARrec1.actsubcefs 
      >

      COMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
