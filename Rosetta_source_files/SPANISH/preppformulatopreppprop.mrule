\newpage
\begin{verbatim}
% RULE Rpppmood2
< m1:PREPPFORMULA{PREPPFORMULArec1}[mu1, predrel/T1] 
>

< m :CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}[mu1, predrel/T2 ]
>

<

   SUBRULE
      <T1:PREPP{PREPPrec1}[I1:mu2] >
      <T2:PREPP{PREPPrec1}[I1:mu2] >

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [I11:../T3])
           I11: T3.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: PREPPFORMULArec1.prosubject = false
          A1: CLOSEDPREPPPROPrec1 := PREPPFORMULArec1
         >
      DECOMP
         <
          C1: CLOSEDPREPPPROPrec1.prosubject = false
          A1: PREPPFORMULArec1 := CLOSEDPREPPPROPrec1
         >


   SUBRULE
      <T1:PREPP{PREPPrec1}[I1:mu2] >
      <T2:VARPREPP{VARPREPPrec1}[I1:mu2] >

   MATCHCONDITIONS
      <
       I1: EXIST(mu2, [I11:../T3])
           I11: T3.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: PREPPFORMULArec1.prosubject = false
          A1: CLOSEDPREPPPROPrec1 := PREPPFORMULArec1;
              VARPREPPrec1 := PREPPrec1;
         >
      DECOMP
         <
          C1: CLOSEDPREPPPROPrec1.prosubject = false
          A1: PREPPFORMULArec1 := CLOSEDPREPPPROPrec1;
              PREPPrec1 := VARPREPPrec1;
         >
>
&

\end{verbatim}
