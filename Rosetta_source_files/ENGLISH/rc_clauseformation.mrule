\newpage
\begin{verbatim}
%
% RULE RActClauseFormation
< m1: VERBPPROP{VERBPPROPrec1}
               [mu1,
                predrel/VERBP{VERBPrec1}[mu2],
                mu3
               ]
>

< m : CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}[mu2],
             mu3
            ]
>

   MATCHCONDITIONS
      <
       m1: VERBPPROPrec1.voice = active 
           OR
           ( VERBPPROPrec1.voice = passive AND
             EXIST (mu2, [auxrel/I1::VERB{VERBrec1}[mu4]]) )
       m : CLAUSErec1.voice = active 
           OR
           ( CLAUSErec1.voice = passive AND
             EXIST (mu2, [auxrel/I1::VERB{VERBrec1}[mu4]]) )
           I1: VERBrec1.subc = modalverb
      >

      COMP
         <
          C1: true
          A1: CLAUSErec1 := COPYT_verbppropTOclause(VERBPPROPrec1)
              (* including voice;
                 all other attributes receive default values *)
         >
      DECOMP
         <
          C1: CLAUSErec1 = { modus      : omegamodus
                             aspect     : omegaAspect
                             deixis     : omegaDeixis
                             retro      : false
                             finiteness : omegafin
                             infsort    : omegainf }
              (* default values for attributes specific to CLAUSE *)
          A1: VERBPPROPrec1 := COPYT_clauseTOverbpprop(CLAUSErec1)
              (* including voice *)
         >
&

\end{verbatim}
