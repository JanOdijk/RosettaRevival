\newpage
\begin{verbatim}
% RULE RStartPPProp120  
< m1: SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1} ] 
  m2: T1
  m3: T2
>

< m : PREPPPROP{PREPPPROPrec1}
               [ I1:subjrel/T1,
                 predrel/PREPP{PREPPrec1}
                        [ head/PREP{PREPrec1},
                          I2:argrel/T2
                         ]
              ]
>

   MATCHCONDITIONS
      <
       m2: T1.CAT IN AUX_VARCATSET
       m3: T2.CAT IN AUX_VARCATSET
       I1: T1.CAT IN AUX_VARCATSET 
       I2: T2.CAT IN AUX_VARCATSET
      >

      COMP
         <
          C1: PREPrec1.thetapp = pp120 AND
              SUBPREPrec1 = PREPrec1   
            C11: T2.CAT IN [NPVAR, PREPPVAR] 
            A11: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specQ := T2.REC.specQ;
                 PREPPrec1.mood := T2.REC.mood
            C12: T2.CAT IN [ADVPVAR]
            A12: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specQ := yesspec;
                 PREPPrec1.mood := T2.REC.mood
            C13: T2.CAT IN [CNVAR]
            A13: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specQ := yesspec;
                 PREPPrec1.mood := relativexpmood
            C14: NOT (T2.CAT IN [NPVAR, ADVPVAR, PREPPVAR, CNVAR])
            A14: PREPPrec1   := PREPPrecdef;
                 PREPPrec1.specQ := yesspec;
                 PREPPrec1.mood := nowh
          A1: PREPPrec1 := { thetapp     : pp120
                             headkey     : PREPrec1.key
                             actsubcefs  : PREPrec1.subcs
                             class       : PREPrec1.class
                             deixis      : PREPrec1.deixis
                             aspect      : PREPrec1.aspect
                             retro       : PREPrec1.retro } ;
               (* req, env, superdeixis, stranded, synppefs:
                  default values *)
              PREPPPROPrec1 := COPYT_prepptopreppprop(PREPPrec1);
              PREPPPROPrec1.aktionsarts := [stative]
               (* PROsubject: default value *)
         >

      DECOMP
         <
          C1: PREPrec1.thetapp = pp120  AND
              PREPPrec1 = PREPPrecdef EXCEPT FOR 
                          [thetapp, headkey, actsubcefs, class,
                           deixis, aspect, retro, specQ, mood]  AND
              PREPPrec1 = { thetapp     : pp120
                            headkey     : PREPrec1.key
                            actsubcefs  : PREPrec1.subcs 
                            class       : PREPrec1.class  
                            deixis      : PREPrec1.deixis
                            aspect      : PREPrec1.aspect  
                            retro       : PREPrec1.retro  } AND
              PREPPPROPrec1 = COPYT_PREPPtoPREPPPROP(PREPPrec1) AND
              PREPPPROPrec1 = { PROsubject : false
                                aktionsarts : [stative] }
            C11: ( T2.CAT IN [NPVAR, PREPPVAR] WITH 
                           ( T2.REC.specQ = PREPPrec1.specQ AND
                             T2.REC.mood = PREPPrec1.mood ) )
            A11: @
            C12: ( T2.CAT IN [ADVPVAR] WITH 
                             T2.REC.mood = PREPPrec1.mood ) AND
                 PREPPrec1.specQ = yesspec
            A12: @
            C13: T2.CAT IN [CNVAR] AND
                 PREPPrec1.specQ = yesspec AND
                 PREPPrec1.mood = relativexpmood
            A13: @
            C14: NOT (T2.CAT IN [NPVAR, PREPPVAR, ADVPVAR, CNVAR]) AND
                 PREPPrec1.specQ = yesspec AND
                 PREPPrec1.mood = nowh
            A14: @
          A1: SUBPREPrec1 := PREPrec1;
         >
&

\end{verbatim}
