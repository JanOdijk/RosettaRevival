ENGLISH 12

&
\newpage
\begin{verbatim}
%
% RULE RNPOpenIngMood
< m1: I3::CLAUSE{CLAUSErec1}
                [ I2:subjrel/T1,
                  mu1,
                  predrel/VERBP{VERBPrec1}
                         [ I4:mu4,
                           rel1/VERB{VERBrec1}[mu2],
                           mu3
                         ],
                  mu5
                ]
                  
>

< m : NP{NPrec1}[ head/I6::SENTENCE{SENTENCErec1}
                          [ I2:subjrel/T1,
                            mu1,
                            predrel/VERBP{VERBPrec1}
                                   [ I4:mu4,
                                     rel1/VERB{VERBrec2}[mu2],
                                     mu3
                                   ],
                            mu5
                          ]
                     ]
>

   MATCHCONDITIONS
      <
       I2: T1.CAT IN [NPVAR, CNVAR]
       I3: CLAUSErec1 = { finiteness : infinite
                          aspect     : perfective
                          PROsubject : true
                          infsort    : omegainf
                          modus      : omegamodus }
       I4: NOT EXIST (mu4, [../VERB{VERBrec3}[mu6]])
       m:  NPrec1 = NPrecdef EXCEPT FOR [ NPhead, specQ, mood,
                    definite, number, person, aspect, superdeixis ] AND
           NPrec1 = { NPhead     : OpenIngNP
                      specQ      : yesspec
                      mood       : nowh 
                      definite   : def
                      number     : singular
                      person     : 3 
                      aspect     : SENTENCErec1.aspect
                      superdeixis: SENTENCErec1.superdeixis }
       I6: SENTENCErec1 = { mood       : declarative
                            senttype   : subordinateclause
                            modus      : ingform
                            finiteness : infinite
                            aspect     : perfective
                            PROsubject : true
                            infsort    : opening
                            conjkey    : 0
                            adverbial  : false
                            temporal   : false
                            conjclass  : omegatimeAdvClass
                            conjdeixis : omegadeixis
                            conjaspect : omegaaspect
                            conjretro  : false }
      >

      COMP
         <
          C1: VERBrec1.modus = omegamodus
          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := ingform;
              NPrec1 := { NPhead      : OpenIngNP
                          mood        : nowh
                          specQ       : yesspec
                          definite    : def
                          number      : singular
                          person      : 3 
                          aspect      : CLAUSErec1.aspect
                          superdeixis : CLAUSErec1.superdeixis };
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1)
         >

      DECOMP
         <
          C1: VERBrec2.modus = ingform
          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1 := { infsort     : omegainf
                              modus       : omegamodus }
         >
&

\end{verbatim}
