object amb3_list3 : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame amb3_stem3;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments list_args;
        XmNvisibleItemCount = 9;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;

        XmNitemCount = 3;
        XmNitems = string_table ( 'sdfgsdfgsfd', 'dfadfs', 
                                  'trrtfgjhrtejkfv g dfg sdfg fdg' );
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb3_mean3_list);
        XmNdefaultActionCallback = procedure XwbAction (X_amb3_ok_button);
    };
};
