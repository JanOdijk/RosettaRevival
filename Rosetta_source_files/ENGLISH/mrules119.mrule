% RULE RcoordS
< m1:COORD{COORDrec1}
  m2:SENTENCE{SENTENCErec1}[mu1]
  m3:SENTENCE{SENTENCErec2}[mu2] 
>

< m :SENTENCE{SENTENCErec3}
         [ argrel/SENTENCE{SENTENCErec5}[mu1],
           head/COORD{COORDrec1},
           argrel/SENTENCE{SENTENCErec6}[mu2]
         ]
>

      COMP
         <
          C1: SENTENCErec1 =
                 {
                   mood       : SENTENCErec2.mood
                   senttype   : SENTENCErec2.senttype
                   PROsubject : SENTENCErec2.PROsubject
                   modus      : SENTENCErec2.modus
                   finiteness : SENTENCErec2.finiteness
                   infsort    : SENTENCErec2.infsort
                   superdeixis: SENTENCErec2.superdeixis
                   adverbial  : SENTENCErec2.adverbial
                   temporal   : SENTENCErec2.temporal
                 }
          A1: SENTENCErec3 := SENTENCErec2;
              SENTENCErec5 := SENTENCErec1;
              SENTENCErec6 := SENTENCErec2;
              SENTENCErec5.superdeixis := omegadeixis;
              SENTENCErec6.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: SENTENCErec3 = SENTENCErec6 EXCEPT FOR [superdeixis] AND
              SENTENCErec5.superdeixis = omegadeixis AND
              SENTENCErec6.superdeixis = omegadeixis AND
              SENTENCErec5 =
                 {
                   mood       : SENTENCErec6.mood
                   senttype   : SENTENCErec6.senttype
                   PROsubject : SENTENCErec6.PROsubject
                   modus      : SENTENCErec6.modus
                   finiteness : SENTENCErec6.finiteness
                   infsort    : SENTENCErec6.infsort
                   adverbial  : SENTENCErec6.adverbial
                   temporal   : SENTENCErec6.temporal
                 }
          A1: SENTENCErec1 := SENTENCErec5;
              SENTENCErec2 := SENTENCErec6;
              SENTENCErec1.superdeixis := SENTENCErec3.superdeixis;
              SENTENCErec2.superdeixis := SENTENCErec3.superdeixis;
              
         >


&

\end{verbatim}
