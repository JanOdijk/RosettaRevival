/* select: meaning window */

object le_il_window : XmFormDialog {
  arguments {
    arguments form_dialog_args;
    XmNdialogTitle    = 'Meaning';
    XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL; 
/*    XmNmenuBar    = XmMenuBar le_il_menubar; */
    XmNnoResize  = true;
  };
  controls {
    XmMenuBar   le_il_menubar;
    XmRowColumn le_il_description;
    XmRowColumn le_il_spref;
    XmRowColumn le_il_mpref;
    XmRowColumn le_il_mkey;
    XmRowColumn le_il_where;
    XmRowColumn le_il_comments;
/*    XmSeparator le_il_separator; */
    XmRowColumn le_il_button_box;
    XmLabel     le_il_status;
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_il_window /* + 
               DEFAULT_BUTTON_OFFSET*X_le_il_ok_button */ );
  };
};

object le_il_menubar : XmMenuBar {
  arguments {
    XmNtopAttachment  = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNmenuHelpWidget = XmCascadeButton le_il_help_menu; 
    XmNspacing    = 30;
  };
  controls {
    XmCascadeButton le_il_edit_menu;
    XmCascadeButton le_il_options_menu;
    XmCascadeButton le_il_help_menu; 
  };
};

object le_il_edit_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Edit';
    XmNsensitive   = true;
  };
  controls {
    XmPulldownMenu {
      controls {
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Modify';
          };
          controls {
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Spref';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_il_modify_spref_button);
                    XmNactivateCallback = procedure
              XwbAction (X_le_il_modify_spref_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Mpref';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_il_modify_mpref_button);
                    XmNactivateCallback = procedure
              XwbAction (X_le_il_modify_mpref_button);
                  };
                };
                XmCascadeButton {
                  arguments {
                    arguments cascade_args;
                    XmNsensitive   = true;
                    XmNlabelString = 'Meaning';
                  };
                  controls {
                    XmPulldownMenu {
                      controls {
                        XmPushButton {
                          arguments {
                            arguments cascade_args;
                            XmNlabelString = 'New meaning';
                          };
                          callbacks {
                            MrmNcreateCallback = procedure
                      XwuCreateWidget (X_le_il_new_meaning_button);
                            XmNactivateCallback = procedure
                      XwbAction (X_le_il_new_meaning_button);
                          };
                        };
                        XmCascadeButton {
                          arguments {
                            arguments cascade_args;
                            XmNsensitive   = true;
                            XmNlabelString = 'Existing meaning';
                          };
                          controls {
                            XmPulldownMenu {
                              controls {
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'Dutch';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_il_dutch_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_il_dutch_meaning_button);
                                  };
                                };
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'English';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_il_english_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_il_english_meaning_button);
                                  };
                                };
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'Spanish';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_il_spanish_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_il_spanish_meaning_button);
                                  };
                                };
                              };
                            };
                          };
                        };
                      };
                    };
                  };
                };
              };
            };
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Turn Off Meaning';
          };
          callbacks {
            MrmNcreateCallback = procedure
      XwuCreateWidget (X_le_il_mark_il_button);
            XmNactivateCallback = procedure
      XwbAction (X_le_il_mark_il_button);
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Delete Meaning';
          };
          callbacks {
            MrmNcreateCallback = procedure
      XwuCreateWidget (X_le_il_delete_il_button);
            XmNactivateCallback = procedure
      XwbAction (X_le_il_delete_il_button);
          };
        };
      };
    };
  };
};

object le_il_options_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Options';
    XmNsensitive   = true;
  };
  controls {
    XmPulldownMenu {
      controls {
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Translate';
          };
          controls {
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Dutch';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_il_translate_dutch_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_il_translate_dutch_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'English';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_il_translate_english_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_il_translate_english_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Spanish';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_il_translate_spanish_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_il_translate_spanish_button);
                  };
                };
              };
            };
          };
        };
      };
    };
  };
};

object le_il_help_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Help';
    XmNsensitive   = true;
  };
  callbacks {
    MrmNcreateCallback = procedure
             XwuCreateWidget (X_le_il_help_button);
    XmNactivateCallback = procedure XwhAction (X_le_il_help_button);
  };
};

object le_il_description: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmMenuBar le_il_menubar;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Description: ';
        XmNx = 3;
        XmNy = 10;
      };
    };
    XmText {
      arguments {
        arguments text_args;
/*        XmNscrollHorizontal = false; ? */
        XmNhighlightThickness = 0;
        XmNsensitive       = false;
        XmNcolumns = 50;
        XmNvalue = '';
        XmNx = 85;
        XmNy = 5;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                        (X_le_il_description);
      };
    };
  };
};

object le_il_spref: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_il_description;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Spref: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_il_spref);
      };
    };
  };
};

object le_il_mpref: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_il_spref;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Mpref: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_il_mpref);
      };
    };
  };
};

object le_il_mkey: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_il_mpref;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Mkey: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 85;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_il_mkey);
      };
    };
  };
};

object le_il_where : XmRowColumn { 
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_il_mkey;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls { 
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Where: ';
        XmNx = 3;
        XmNy = 5;
      };
    };
    XmRadioBox {
      arguments {
        XmNorientation      = XmHORIZONTAL;
        XmNx = 85;
      };
      controls {
        XmToggleButton {
          arguments {
            arguments toggle_args;
            XmNhighlightThickness = 0;
            XmNlabelString  = 'analysis';
            XmNsensitive       = false;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget 
                       (X_le_il_analysis_toggle);
          };
        };
        XmToggleButton {
          arguments {
            arguments toggle_args;
            XmNhighlightThickness = 0;
            XmNlabelString  = 'generation';
            XmNsensitive       = false;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget 
                       (X_le_il_generation_toggle);
          };
        };
        XmToggleButton {
          arguments {
            arguments toggle_args;
            XmNhighlightThickness = 0;
            XmNlabelString  = 'both';
            XmNsensitive       = false;
          };
          callbacks {
            MrmNcreateCallback = procedure XwuCreateWidget 
                       (X_le_il_angen_toggle);
          };
        };
      };
    };
  };
};

object le_il_comments : XmRowColumn {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_il_where;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNorientation    = XmVERTICAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Comments: ';
      };
    };
    XmScrolledText {
      arguments {
        arguments text_args;
        XmNeditMode     = XmMULTI_LINE_EDIT;
        XmNscrollHorizontal = false;
        XmNcolumns      = 80;
        XmNrows       = 3;
/*        XmNsensitive       = false;  becomes always insensitive! */
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget 
                    (X_le_il_comments);
      };
    };
  };
};
/*
object le_il_separator : XmSeparator {
  arguments {
    XmNleftAttachment  = XmATTACH_FORM;
    XmNrightAttachment   = XmATTACH_FORM;
    XmNtopAttachment   = XmATTACH_WIDGET;
    XmNtopWidget     = XmRowColumn le_il_comments;

    XmNleftOffset    = 0;
    XmNrightOffset     = 0;
    XmNmargin      = 0;
  };
};
*/
object le_il_button_box : XmRowColumn {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_il_comments;
    XmNbottomAttachment = XmATTACH_FORM; 
    XmNleftAttachment   = XmATTACH_FORM;
/*    XmNrightAttachment  = XmATTACH_FORM; */

    arguments button_box_args;
    XmNorientation    = XmHORIZONTAL;
  };
  controls {
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'OK';
      };
      callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_le_il_ok_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_il_ok_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Cancel';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_il_cancel_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_il_cancel_button);
         };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Select';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_il_select_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_il_select_button);
         };
    };
/*
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Help';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_il_help_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_il_help_button);
         };
    };
*/
  };
};

object le_il_status: XmLabel {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_il_comments;
    XmNbottomAttachment = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_WIDGET;
    XmNleftWidget        = XmRowColumn le_il_button_box;
    XmNrightAttachment  = XmATTACH_FORM; 
    arguments label_args;
    XmNfontList     = bigbold; 
    XmNlabelString  = '';
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget
           (X_le_il_status);
  };
};
