\newpage
\begin{verbatim}
% RULE Rppsuperdeixis
< m1:PREPP{PREPPrec1}[mu1] 
>

< m :PREPP{PREPPrec2}[mu1] 
>

   PARAMETERS
      <
       super : tiempotype
      >

      COMP
         <
          C1: PREPPrec1.supertiempo = omegatiempo AND
              super IN [presente, pasado]
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.supertiempo := super;
         >
      DECOMP
         <
          C1: PREPPrec2.supertiempo IN [presente, pasado]
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.supertiempo := omegatiempo;
              super := PREPPrec2.supertiempo;
         >

&

\end{verbatim}
