\newpage
\begin{verbatim}
% TRANSFORMATION TUNOspelling (* abstract `men' as uno *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I4:mu1,
             subjrel/I2::NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}[mu6]],
             I3:mu2,
             cliticrel/CLITIC{}[I7:mu7],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I5::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5
           ]

>

< m:I1::CLAUSE{CLAUSErec1}
          [ I4:mu1,
            subjrel/NP{NPrec2}
                      [head/INDEFPRO(KEY_unoindefprokey){INDEFPROrec1}],
            I3:mu2,
            cliticrel/CLITIC{}[I7:mu7],
            head/VERB{VERBrec2}
                 [ mu15,
                   head/VERB{VERBrec1}
                     [head/SUBVERB{SUBVERBrec1}
                        [head/I5::BVERB{BVERBrec1}]
                     ]
                 ],
            mu5
          ]
>

   MATCHCONDITIONS
      <
       I1:  CLAUSErec1.finiteness = finite
       I2:  (NPrec1.NPhead = Seimpershead)    AND
            (NPrec1.numero = singular)        AND
            (NPrec1.persona = 3)              AND
            (NPrec1.cases = [nominative])
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  BVERBrec1.reflexivity = reflexive
       I7: EXIST (mu7, [seCLrel/..])
      >

      COMP
         <
          C1: true
          A1: NPrec2 := NPrec1;
              NPrec2.NPhead := unoNP;
         >
&

\end{verbatim}
