  advpproptovar      = FROM ADVPPROPrecord  TO ADVPPROPVARrecord
  npproptovar        = FROM NPPROPrecord    TO NPPROPVARrecord
  preppproptovar     = FROM PREPPPROPrecord TO PREPPPROPVARrecord
  verbpproptovar     = FROM VERBPPROPrecord TO VERBPPROPVARrecord
  nptovar            = FROM NPrecord        TO NPVARrecord
  cntovar            = FROM CNrecord        TO CNVARrecord
  sentencetovar      = FROM SENTENCErecord  TO SENTENCEVARrecord
  clausetovar        = FROM CLAUSErecord    TO CLAUSEVARrecord
  advptovar          = FROM ADVPrecord      TO ADVPVARrecord         
  prepptovar         = FROM PREPPrecord     TO PREPPVARrecord
                                                                     {02-02-88}
  verbppropTOclause  = FROM VERBPPROPrecord TO CLAUSErecord
  clauseTOverbpprop  = FROM CLAUSErecord    TO VERBPPROPrecord
  adjppropTOclause   = FROM ADJPPROPrecord  TO CLAUSErecord
  clauseTOadjpprop   = FROM CLAUSErecord    TO ADJPPROPrecord  
  nppropTOclause     = FROM NPPROPrecord    TO CLAUSErecord
  clauseTOnpprop     = FROM CLAUSErecord    TO NPPROPrecord
  advpTOprop         = FROM ADVPrecord      TO ADVPPROPrecord              

  adjTOadjp          = FROM ADJrecord       TO ADJPrecord            {02-02-88}
  advTOadvp          = FROM ADVrecord       TO ADVPrecord            {07-06-88}
  adjpTOadjpprop     = FROM ADJPrecord      TO ADJPPROPrecord        {02-02-88}
  nounTOcn           = FROM NOUNrecord      TO CNrecord              {02-02-88}
  cnTOnp             = FROM CNrecord        TO NPrecord              {02-02-88}
  clauseTOsentence   = FROM CLAUSErecord    TO SENTENCErecord        {02-02-88}
  sentenceTOclause   = FROM SENTENCErecord  TO CLAUSErecord          {02-02-88}
  sentenceTOverbp    = FROM SENTENCErecord  TO VERBPrecord           {02-02-88}
  
  bdetTOdet          = FROM BDETrecord      TO DETrecord             {07-07-88}
  detTOdetp          = FROM DETrecord       TO DETPrecord            {07-07-88}
  artTOdetp          = FROM ARTrecord       TO DETPrecord            {02-02-88}
  qTOqp              = FROM Qrecord         TO QPrecord              {02-02-88}
  preppTOpreppprop   = FROM PREPPrecord     TO PREPPPROPrecord       {04-03-88}

