\newpage
\begin{verbatim}
% TRANSFORMATION Tinversion3 (* no subject, hence no inversion *)
< m1:SENTENCE{SENTENCErec1}[I1:mu1]
>

< m :SENTENCE{SENTENCErec1}[I1:mu1]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1, [subjrel/..])
      >

      COMP
         <
          C1: SENTENCErec1.finiteness = finite
          A1: @
         >
      DECOMP
         <
          C1: SENTENCErec1.finiteness = finite
          A1: @
         >


&

\end{verbatim}
