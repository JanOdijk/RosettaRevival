\begin{verbatim}
% TRANSFORMATION TOblObjControlPrepADJP  (* prepobj/OPENADJPPROP, 
                                            obj control *)
< m1: CLAUSE{CLAUSErec1}
            [ I3:mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I1:objrel/T1,
                       mu3,
                       prepobjrel/PREPP{PREPPrec1}
                                [ head/PREP{PREPrec1},
                                  objrel/OPENADJPPROP{OPENADJPPROPrec1}
                                       [ I2:subjrel/T2,
                                         predrel/ADJP{ADJPrec1}[mu4]
                                       ]
                                ],
                       mu5
                     ],
              mu6
            ]
>

< m : CLAUSE{CLAUSErec2}
            [ I3:mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I1:objrel/T1,
                       mu3,
                       prepobjrel/PREPP{PREPPrec1}
                                 [ head/PREP{PREPrec1},
                                   predrel/ADJP{ADJPrec1}[mu4]
                                 ],
                      mu5
                    ],
             mu6
           ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR]
       I2: T2.CAT IN [NPVAR, CNVAR]
       I3: NOT EXIST (mu1, [I31:auxrel/VERB{VERBrec1}[mu11]])
         I31: VERBrec1.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec2 = NPVARrec1 AND
              CLAUSErec1.synvpefs * AUX_openxppvps <> [] AND
              OPENADJPPROPrec1 = COPYT_adjpTOadjpprop(ADJPrec1) 
                EXCEPT FOR [aktionsarts, superdeixis, PROsubject]
              AND
              OPENADJPPROPrec1 = { aktionsarts   : [stative] 
                                   superdeixis   : omegadeixis
                                   PROsubject    : true }
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_openxppvps <> []
          A1: NPVARrec2 := NPVARrec1;
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                  CLAUSErec2.synvpefs * AUX_openxppvps;
              OPENADJPPROPrec1 := COPYT_adjpTOadjpprop(ADJPrec1); 
              OPENADJPPROPrec1 := { aktionsarts   : [stative ]
                                    superdeixis   : omegadeixis
                                    PROsubject    : true }
         >

   SUBRULE (* 1. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec2 = CNVARrec1 AND
              CLAUSErec1.synvpefs * AUX_openxppvps <> [] AND
              OPENADJPPROPrec1 = COPYT_adjpTOadjpprop(ADJPrec1) 
                EXCEPT FOR [aktionsarts, superdeixis, PROsubject]
              AND
              OPENADJPPROPrec1 = { aktionsarts   : [stative] 
                                   superdeixis   : omegadeixis
                                   PROsubject    : true }
          A1: CLAUSErec2 := CLAUSErec1
         >
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_openxppvps <> []
          A1: CNVARrec2 := CNVARrec1;
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                  CLAUSErec2.synvpefs * AUX_openxppvps;
              OPENADJPPROPrec1 := COPYT_adjpTOadjpprop(ADJPrec1); 
              OPENADJPPROPrec1 := { aktionsarts   : [stative ]
                                    superdeixis   : omegadeixis
                                    PROsubject    : true }
         >
>
&

\end{verbatim}
