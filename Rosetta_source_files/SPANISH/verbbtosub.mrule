SPANISH 1
&
\newpage
\begin{verbatim}
%
% RULE ErrorRule (* this rule is never applicable, and is translated in during
                    transfer if the M-rule mentioned in the transferrules does
                    not exist. It should remain the first rule in MRULES"1".
                    If may safely be removed, if it is no longer useful. *)
< m1:T1
>
< m:T1
>
COMP <C1:T1.cat<>T1.cat
      A1:@
     >
DECOMP <C1:T1.cat<>T1.cat
        A1:@
       >
&
% RULE RBVERBTOSUB
< m1:BVERB{BVERBrec1} 
>

< m :SUBVERB{SUBVERBrec1}[head/BVERB{BVERBrec1} ]
>

      COMP
         <
          C1: true
          A1: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1)
         >
&

\end{verbatim}

