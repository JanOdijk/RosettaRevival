              (ADJPrec1.adjpatternefs = []) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synPREPEMPTY];
              ADJPPROPrec2.adjpatternefs := [synPREPEMPTY];
