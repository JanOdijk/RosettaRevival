object amb1_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
        XmNdialogTitle = N_amb_window;
        XmNnoResize    = true;
    };
    controls {
        XmRowColumn amb1_button_box;
        XmForm amb1_form;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_amb1_window + DEFAULT_BUTTON_OFFSET*X_amb1_ok_button);
    };
};

object amb1_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;
	XmNresizable        = false;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
	XmPushButton amb1_ok_button;
	XmPushButton amb1_help_button;
    };
};

object amb1_ok_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString       = N_amb_ok_button;
        XmNsensitive         = false;
    };
    callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_amb1_ok_button);
        XmNactivateCallback = procedure XwbAction (X_amb1_ok_button);
    };
};

object amb1_help_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString       = N_amb_help_button;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb1_help_button);
        XmNactivateCallback = procedure XwhAction (X_amb1_help_button);
    };
};

object amb1_form : XmForm {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNrightAttachment  = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn amb1_button_box;

        arguments form_args;
    };
    controls {
        XmFrame amb1_stem;
        XmScrolledList amb1_list;
    };
};

object amb1_stem : XmFrame {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
     	XmNrightAttachment  = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
    };
    controls {
        XmRowColumn {
            arguments {
                XmNorientation      = XmHORIZONTAL;
            };
            controls {
	        XmLabel amb1_stem_label;
                XmLabel amb1_stem_text;
            };
        };
    };
};

object amb1_stem_label : XmLabel {
    arguments {
        arguments label_args;
	XmNlabelString      = N_amb_stem_text;
    };
};

object amb1_stem_text : XmLabel {
    arguments {
        arguments text_args;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb1_stem1_text);
    };
};

object amb1_list : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame amb1_stem;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments list_args;
        XmNvisibleItemCount = 9;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;

        XmNitemCount = 6;
        XmNitems = string_table ( 'mannetje v.d. geit', 
                                  'mannetje van andere dieren', 
                                  'hijswerktuig', 
                                  'gymnastiektoestel',
                                  'zitplaats v.d. koetsier',
                                  '<muz.>' );
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb1_mean1_list);
        XmNdefaultActionCallback = procedure XwbAction (X_amb1_ok_button);
    };
};
