\begin{verbatim}
% RULE Rconjsent4
< m1:SENTENCE{SENTENCErec1}[ I1:mu1 ] 
  m2:PREP{PREPrec1}
>

< m : SENTENCE{SENTENCErec2}[modrel/PREP{PREPrec1}, I1:mu1 ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[I11:rel1/..])
           I11: rel1 IN [shiftrel, conjrel]
      >

      COMP
         <
          C1: synOPENINFSENT IN PREPrec1.synpps          AND
              SENTENCErec1 =                  
		  {
		  senttype   : subordinateclause
                  finiteness : infinite
                  infsort    : inf
		  conjkey    : 0
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
                  restructuring : false
		  }
              C11: temp IN PREPrec1.subcs
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.temporal := true; 
              C12: PREPrec1.subcs - [temp] <> []
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.temporal := false;
          A1: SENTENCErec2 :=                  
		  {
		  adverbial  : true
		  conjclass  : PREPrec1.class
		  conjtiempo : PREPrec1.tiempo
		  conjaspecto: PREPrec1.aspecto
		  conjretro  : PREPrec1.retro
		  };
         >
      DECOMP
         <
          C1: synOPENINFSENT IN PREPrec1.synpps          AND
              SENTENCErec2 =                  
		  {
		  senttype   : subordinateclause
                  finiteness : infinite
                  infsort    : inf
		  conjkey    : 0
		  adverbial  : true
		  conjclass  : PREPrec1.class
		  conjtiempo : PREPrec1.tiempo
		  conjaspecto: PREPrec1.aspecto
		  conjretro  : PREPrec1.retro
                  restructuring : false
		  }
              C11: temp IN PREPrec1.subcs AND
                   SENTENCErec2.temporal = true
              A11: SENTENCErec1 := SENTENCErec2;
              C12: PREPrec1.subcs - [temp] <> [] AND
                   SENTENCErec2.temporal = false
              A12: SENTENCErec1 := SENTENCErec2;
          A1: SENTENCErec1 :=                  
		  {
		  conjkey    : 0
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
		  }
         >

&

\end{verbatim}
