\newpage
\begin{verbatim}
% FILTER FADJagr

  (* agreement for (ser/estar +) ADJ; *)

< m:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ predrel/ADJP{ADJPrec1}[mu5,
                                             head/ADJ{ADJrec1}[mu8],
                                             mu9
                                             ],
                      mu6
                   ],
             mu7
            ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.synvpefs * [synSER, synESTAR] <> []
      >

<
   SUBRULE        (* 1 : NPVAR *)
      <T1:NPVAR{NPVARrec1}>
      

         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: @
         >



   SUBRULE        (* 2a : CNVAR, masc *)
      <T1:CNVAR{CNVARrec1}>
      

         <
          C1: 
              (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (masc IN CNVARrec1.generos)

          A1: @
        >

   SUBRULE        (* 2b : CNVAR, fem *)
      <T1:CNVAR{CNVARrec1}>
      

         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })
                                            AND
               (fem IN CNVARrec1.generos)

          A1: @
         >


   SUBRULE        (* 3 : PRONP *)
      <T1:PRONP{PRONPrec1}[mu10]>
      

         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                         AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: @
         >



   SUBRULE     (* 4 : NP *)
      <T1:I4::NP{NPrec1}[mu11]>
      

   MATCHCONDITIONS
      <
       I4: NPrec1.NPhead IN [ redelloNP, redellosNP, eseNP, esteNP, aquelNP]
      >

         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                         AND
               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: @
         >



   SUBRULE        (* 5 : PRONPVAR *)
      <T1:PRONPVAR{PRONPVARrec1}>
      

         <
          C1: (ADJPrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })                        AND

               (ADJrec1 =
                  {
                   genero   : omegagenero
                   numero   : omeganumero
                  })


          A1: @
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] FADJagr
\item[* relevant examples:]
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPTOCLAUSE
\item[* class:] TC:TSVagr
\item[* date of creation:] 26-JAN-1989 
\item[* author:] Lisette Appelo
\item[* copied from:] TADJagr
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author: 
\end{enumerate}
\item[* task:] Filter 
to make the ADJ in a clause with ser/estar agree in "persona" and "genero" 
with the subject.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
Ren\'{e} made it possible to use {\bf variable keys}. In the model 
(KEY1) is given, and in the matchcondition: \\
(KEY1 = serBVERBkey) OR (KEY1 = estarBVERBkey)\\
However, since the attribute synvpefs  of CLAUSE can give the same information
in this case, I decided to use this, instead of 
embedding to the BVERB-level.
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]none
\item[\  \ suggested semantics:] 
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

 
\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% TRANSFORMATION TPtcPasAgr1

    (* agreement for Participium in Passive clauses *)

< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             I4:subjrel/T1,
             mu2,
             head/I2::VERB{VERBrec1}
                   [ mu4,
                     head/I6::VERB{VERBrec3}[mu5],
                     mu6
                   ],
             mu7
           ]             
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             I4:subjrel/T1,
             mu2,
             head/I3::VERB{VERBrec4}
                   [ mu4,
                     head/I7::VERB{VERBrec6}[mu5],
                     mu6
                   ],
             mu7
           ]             
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice = Passive)
       I2: VERBrec1.status = VV
       I3: VERBrec4.status = VV
       I4: T1.CAT IN [NPVAR, PRONPVAR, CNVAR]
       I6: VERBrec3.modo = PtcPas
       I7: VERBrec6.modo = PtcPas

      >
<
   SUBRULE (* 1: NPVAR, PRONPVAR *)
      <T1: T2>
      <T1: T2>

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR, PRONPVAR]
      >

      COMP
         <
          C1: (VERBrec3 =
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  })                        AND
            VERBrec1 =
                  {
                   genero   : omegagenero
                  }
          A1: VERBrec6 := VERBrec3;
              VERBrec6.numero := T2.REC.numero;
              VERBrec6.genero := T2.REC.genero;
              VERBrec4 := VERBrec1;
              VERBrec4.genero := T2.REC.genero;                 
                   
               (* The attribute "genero" of the Cluster-node has been 
                  assigned a value here because of the PtcPas (VERBrec6)  *)
         >

      DECOMP
         <
          C1: (VERBrec6.genero = T2.REC.genero)     AND
              (VERBrec6.numero = T2.REC.numero)     AND

              (VERBrec4.genero = T2.REC.genero)

          A1: VERBrec3 := VERBrec6;
              VERBrec3 :=
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  };

              VERBrec1 := VERBrec4;
              VERBrec1 :=
                  {
                   genero   : omegagenero
                  }
         >

   SUBRULE (* CNVAR fem *)
      <T1: CNVAR{CNVARrec1}>
      <T1: CNVAR{CNVARrec1}>

      COMP
         <
          C1: (VERBrec3 =
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  })                        AND
            VERBrec1 =
                  {
                   genero   : omegagenero
                  }                         AND
              fem IN CNVARrec1.generos

          A1: VERBrec6 := VERBrec3;
              VERBrec6 :=
                  {
                   numero   : CNVARrec1.numero
                   genero   : fem
                  };
              VERBrec4 := VERBrec1;
              VERBrec4 :=
                  {
                   genero   : fem
                  };                 
                   
               (* The attribute "genero" of the Cluster-node has been 
                  assigned a value here because of the PtcPas (VERBrec6)  *)
         >

      DECOMP
         <
          C1: (VERBrec6.genero = fem)     AND
              (VERBrec6.numero = CNVARrec1.numero)     AND

              (VERBrec4.genero = fem)      AND
              (fem IN CNVARrec1.generos)

          A1: VERBrec3 := VERBrec6;
              VERBrec3 :=
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  };

              VERBrec1 := VERBrec4;
              VERBrec1 :=
                  {
                   genero   : omegagenero
                  }
         >
   SUBRULE (* CNVAR masc *)
      <T1: CNVAR{CNVARrec1}>
      <T1: CNVAR{CNVARrec1}>

      COMP
         <
          C1: (VERBrec3 =
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  })                        AND
            VERBrec1 =
                  {
                   genero   : omegagenero
                  }                         AND
              masc IN CNVARrec1.generos

          A1: VERBrec6 := VERBrec3;
              VERBrec6 :=
                  {
                   numero   : CNVARrec1.numero
                   genero   : masc
                  };
              VERBrec4 := VERBrec1;
              VERBrec4 :=
                  {
                   genero   : masc
                  };                 
                   
               (* The attribute "genero" of the Cluster-node has been 
                  assigned a value here because of the PtcPas (VERBrec6)  *)
         >

      DECOMP
         <
          C1: (VERBrec6.genero = masc)     AND
              (VERBrec6.numero = CNVARrec1.numero)     AND

              (VERBrec4.genero = masc)      AND
              (masc IN CNVARrec1.generos)

          A1: VERBrec3 := VERBrec6;
              VERBrec3 :=
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  };

              VERBrec1 := VERBrec4;
              VERBrec1 :=
                  {
                   genero   : omegagenero
                  }
         >


>
&


\end{verbatim}
