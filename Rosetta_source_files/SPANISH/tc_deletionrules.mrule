\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: Wrong specification of genero for the VERB deleted in all 
subrules. Genero of VERB and genero of PERSPRO do not agree.\\
NPONnomBPRSPR in auxdomain and this rule attuned.\\
`CLAUSE' changed into `SENTENCE'.\\
\end{enumerate}
\end{description} 


% FILTER FPROSUBJdel
< m: I2::SENTENCE{SENTENCErec1}[ I1:mu1,
                              subjrel/NP{NPrec1}
                                     [head/PERSPRO{PERSPROrec1}[head/T1]
                                     ],
                              mu5,
                              head/VERB{VERBrec1}[mu3],
                              mu4
                            ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [subjrel/..])
       I2: SENTENCErec1.finiteness = finite AND
           SENTENCErec1.restructuring = false AND
           SENTENCErec1.mood <> imperativemood    (* JO  1-SEP-1988 16:34:56 *)
      >


<
   SUBRULE
      < T1:BPERSPRO(KEY_yomascBPERSPROkey){BPERSPROrec1}>

         <
          C1: (VERBrec1.numero = singular) AND
              (VERBrec1.persona = 1)       AND

