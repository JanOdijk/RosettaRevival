\newpage
\begin{verbatim}

%  TRANSFORMATION TNPcountENtoONE1

< m1: NP{NPrec1}[detrel/T1,
                 head/CN{CNrec1}
                      I1:[
                          mu2,
                          head/EN(KEY_countENkey){ENrec1},
                          mu3
                         ],
                 mu1
                ]
>

< m : NP{NPrec2}[detrel/T1,
                 head/CN{CNrec1}
                     I1: [
                          mu2,
                          head/NOUN{NOUNrec1}
                               [head/SUBNOUN{SUBNOUNrec1}
                                     [head/BNOUN(KEY_oneBNOUNkey){BNOUNrec1}]],
                          mu3
                         ],
                 mu1
                ]
>

   MATCHCONDITIONS
      <
       I1: EXIST (mu2, [I11:modrel/T2]) OR
           EXIST (mu3, [I12:rel1/T3]) 
       I11: T2.CAT IN [ADJP, SENTENCE]
       I12: ((T3.CAT IN [SENTENCE, ADJP, ADVP, PREPP]) OR 
            (T3.CAT IN [SENTENCE] WITH T3.REC.mood =relative)) AND
            rel1 IN [posrel, postmodrel]
       >

      COMP
         <
          C1: true
             C11: singular IN CNrec1.numbers
             A12: SUBNOUNrec1 := COPYT_bnounTOsubnoun(BNOUNrec1);
                  NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
                  NOUNrec1.numbers := [singular];
             C11: plural IN CNrec1.numbers
             A12: SUBNOUNrec1 := COPYT_bnounTOsubnoun(BNOUNrec1);
                  NOUNrec1 := COPYT_SUBNOUNtoNOUN(SUBNOUNrec1);
                  NOUNrec1.numbers := [plural];
          A1: NPrec2 := NPrec1;
              NPrec2.NPhead := oneNP;
         >

      DECOMP
         <
          C1: NPrec2.NPhead = oneNP
             C11: singular IN CNrec1.numbers AND
                  SUBNOUNrec1 = COPYT_bnounTOsubnoun(BNOUNrec1) AND
                  NOUNrec1 = COPYT_SUBNOUNtoNOUN(SUBNOUNrec1) AND
                  singular IN NOUNrec1.numbers 
             A11: @
             C11: plural IN CNrec1.numbers AND
                  SUBNOUNrec1 = COPYT_bnounTOsubnoun(BNOUNrec1) AND
                  NOUNrec1 = COPYT_SUBNOUNtoNOUN(SUBNOUNrec1) AND
                  plural IN NOUNrec1.numbers 
             A12: @
          A1: NPrec1 := NPrec2;
              NPrec2.NPhead := otherNP;
         >

&

\end{verbatim}
