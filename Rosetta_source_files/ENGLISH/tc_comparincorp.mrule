\newpage
\begin{verbatim}
% TRANSFORMATION TNoIncorp
< m1: I3::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       I2:predrel/ADJP{ADJPrec1}
                                 [ mu2,
                                   head/I1::ADJ{ADJrec1}[mu4],
                                   mu5
                                 ],
                       mu6
                     ],
              mu7
            ]
>

< m : I3::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       I2:predrel/ADJP{ADJPrec1}
                                 [ mu2,
                                   head/I1::ADJ{ADJrec1}[mu4],
                                   mu5
                                 ],
                       mu6
                     ],
              mu7
            ]
>

   MATCHCONDITIONS
      < I1: ADJrec1.compform = basic
        I2: NOT EXIST (mu2, [degreemodrel/QP{QPrec1}
                                         [ mu9,
                                           head/I21::Q{Qrec1},
                                           mu8
                                         ]
                           ]) OR 
            moreComp IN ADJrec1.compformations 
            
        I21: Qrec1.key = KEY_moreQkey OR
             Qrec1.key = KEY_mostQkey
        I3: synbe IN CLAUSErec1.synvpefs
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
