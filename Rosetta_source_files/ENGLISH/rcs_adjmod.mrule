ENGLISH 51
&
\begin{verbatim}
%
%RULE RADJFOROBJMOD           (* important for/to x1 *)

< m1: I4::ADJPPROP{ADJPPROPrec1}
                            [mu1,
                             predrel/ADJP{ADJPrec1},
                                     [mu4,
                                      head/ADJ{ADJrec1}[mu5],
                                      I2:mu2,
                                      I3:mu3
                                     ]
                            ]  
  m2: T2
>

< m : I4::ADJPPROP{ADJPPROPrec1}
              [mu1,
               predrel/ADJP{ADJPrec1}
                       [mu4,
                        head/ADJ{ADJrec1}[mu5],
                        I2:mu2,
                        forobjrel/VARPREPP{VARPREPPrec1}
                                  [head/T1,
                                   I1:objrel/T2
                                  ],
                        I3:mu3
                       ]
              ]
>
   MATCHCONDITIONS
      <m2: T2.cat IN [NPVAR, CNVAR]
       I1: T2.cat IN [NPVAR, CNVAR]
       I2: NOT EXIST (mu2, [I12:rel1/..])
       I12: rel1 IN [prepobjrel, toobjrel, forobjrel] 
       I3: NOT EXIST (mu3, [I13:rel2/..])
       I13: rel2 IN [forobjrel, objrel, indobjrel, causadvrel, 
                     locadvrel, tempadvrel]
       I4: NOT (synTONP IN ADJPPROPrec1.adjpatternefs)

      >
<

   SUBRULE
      < >
      <T1:PREP(KEY_forprepkey){PREPrec1}>


      COMP
         <
          C1: ADJPrec1.actsubcefs * [subjectiveadj (* provisional *),
                                     forsubjectiveadj] <> [] 
          A1: @
         >

      DECOMP
         <
          C1: ADJPrec1.actsubcefs * [subjectiveadj (* provisional *),
                                     forsubjectiveadj] <> [] 
          A1: @
         >


   SUBRULE
      < >
      <T1:PREP(KEY_toprepkey){PREPrec1}>

      COMP
         <
          C1: ADJPrec1.actsubcefs * [subjectiveadj (* provisional *),
                                     tosubjectiveadj] <> [] 
          A1: @
         >

      DECOMP
         <
          C1: ADJPrec1.actsubcefs * [subjectiveadj (* provisional *),
                                     tosubjectiveadj] <> [] 
          A1: @
         >
>

&

\end{verbatim}
