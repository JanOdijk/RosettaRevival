\begin{verbatim}
% RULE RNPretrovarInsert
< m1: NPPROP{NPPROPrec1}
            [ mu1,
              predrel/NP{NPrec1}[mu2],
              I4:mu4,
              I1:mu3
            ]

  m2: T1
>

< m : NPPROP{NPPROPrec1}
            [ mu1,
              predrel/NP{NPrec1}[mu2],
              I4:mu4,
              I2:tempadvrel/T1,
              I1:mu3
            ]
>

   MATCHCONDITIONS
      <
       I1: QUOTE_tempretronotfound(mu3) AND
           QUOTE_tempdurnotfound(mu3) AND 
           NOT EXIST (mu3, [locadvrel/..])
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       I2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       I4: ALL (mu4, locadvrel/..)
      >

<
   SUBRULE (* 1. ADVPVAR *)
      < T1: ADVPVAR{ADVPVARrec1}>
      < T1: ADVPVAR{ADVPVARrec1}>

      COMP
         <
          C1: ADVPVARrec1.retro = true
          A1: @
         >
      DECOMP
         <
          C1: ADVPVARrec1.retro = true
          A1: @
         >

   SUBRULE (* 2. PREPPVAR *)
      < T1: PREPPVAR{PREPPVARrec1}>
      < T1: PREPPVAR{PREPPVARrec1}>

      COMP
         <
          C1: PREPPVARrec1.retro = true
          A1: @
         >
      DECOMP
         <
          C1: PREPPVARrec1.retro = true
          A1: @
         >

   SUBRULE (* 3. SENTENCEVAR *)
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: SENTENCEVARrec1.conjretro = true
          A1: @
         >
      DECOMP
         <
          C1: SENTENCEVARrec1.conjretro = true
          A1: @
         >
>
&

\end{verbatim}
