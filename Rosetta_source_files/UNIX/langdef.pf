(* define aliasing conventions for Rosetta C programs *)

(* a constant defines how many chars must be uppercased (the prefix!) *)

package RosLangDef;

(* note: const made with concatenation to fool SCCS *)

const
    Rosetta_C_aliasing_conventions1 = '_%C'||'%r:1:1%c%r:2';
    Rosetta_C_aliasing_conventions2 = '_%C'||'%r:1:2%c%r:3';
    Rosetta_C_aliasing_conventions3 = '_%C'||'%r:1:3%c%r:4';
    Rosetta_C_aliasing_conventions4 = '_%C'||'%r:1:4%c%r:5';
    Rosetta_C_aliasing_conventions5 = '_%C'||'%r:1:5%c%r:6';
    Rosetta_C_aliasing_conventions6 = '_%C'||'%r:1:6%c%r:7';
    Rosetta_C_aliasing_conventions7 = '_%C'||'%r:1:7%c%r:8';
    Rosetta_C_aliasing_conventions8 = '_%C'||'%r:1:8%c%r:9';
    Rosetta_C_aliasing_conventions9 = '_%C'||'%r:1:9%c%r:10';

end {RosLangDef};
