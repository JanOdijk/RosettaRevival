\newpage
\begin{verbatim}
%
% TRANSFORMATION TVerbpattern0
< m1: I2::VERBPPROP{VERBPPROPrec1}[mu1,
                                   predrel/VERBP{VERBPrec1}
                                          [head/I1::VERB{VERBrec1}[mu2]]
                                  ]
>

< m : I3::VERBPPROP{VERBPPROPrec2}[mu1,
                                   predrel/VERBP{VERBPrec1}
                                           [head/I1::VERB{VERBrec1}[mu2]]
                                  ]
>

   MATCHCONDITIONS
      <
       I1: synNOVPArgs IN VERBrec1.synvps 
       I2: VERBPPROPrec1.synvpefs = []
       I3: synNOVPArgs IN VERBPPROPrec2.synvpefs 
      >

      COMP
         <
          C1: true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synNOVPArgs]
         >

      DECOMP
         <
          C1: true
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

&

\end{verbatim}
