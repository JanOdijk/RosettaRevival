\newpage
\begin{verbatim}
%
% RULE ROpenInfMood
< m1: I3::CLAUSE{CLAUSErec1}
                [ I1:sig1, 
                  I2:subjrel/T1,
                  mu1,
                  predrel/VERBP{VERBPrec1}
                         [I5:mu4,
                          rel1/VERB{VERBrec1}[mu2],
                          mu3
                         ],
                  mu5
                ]
>

< m : I4::SENTENCE{SENTENCErec1}
                  [ I1:sig1,
                    I2:subjrel/T1, 
                    mu1,
                    predrel/VERBP{VERBPrec1}
                           [I5:mu4,
                            rel1/VERB{VERBrec2}[mu2],
                            mu3
                           ],
                    mu5
                  ]
>


   MATCHCONDITIONS
      <
       I1 : ALL (sig1, shiftrel/..)
       I2 : T1.CAT IN [NPVAR, CNVAR]
       I3 : CLAUSErec1.finiteness = infinite AND
            CLAUSErec1.PROsubject =true AND
            CLAUSErec1.infsort = omegainf AND
            CLAUSErec1.modus = omegamodus AND
            CLAUSErec1.aspect = perfective
       I4 : SENTENCErec1 = { mood       : declarative
                             senttype   : subordinateclause
                             modus      : infinitive
                             finiteness : infinite
                             aspect     : perfective
                             PROsubject : true
                             infsort    : inf
                             conjkey    : 0
                             adverbial  : false
                             temporal   : false
                             conjclass  : omegaTimeadvClass
                             conjdeixis : omegadeixis
                             conjaspect : omegaAspect
                             conjretro  : false }
       I5: NOT EXIST (mu4, [../VERB{VERBrec3}[mu6]])
      >

      COMP
         <
          C1: VERBrec1.modus = omegamodus
          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := infinitive;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : declarative
                                senttype : subordinateclause
                                modus    : infinitive
                                infsort  : inf }
            (* other attributes specific to sentence
               retain default values *)
         >

      DECOMP
         <
          C1: VERBrec2.modus = infinitive
          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.infsort := omegainf
         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] ROpenInfMood
\item[* relevant examples:] (I can) come
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Clausetosentence
\item[* class:] (name of rule, transformation or filter class) RC\_
MoodDetermination
\item[* date of creation:] 4-MAY-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch RmoodOpenInf
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 07/12/88\ \ \ \ \ author: Lisette Appelo
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to make an open subordinate sentence with an inf
\item[\ \ strategy:] (also: deviations from accepted proposals) Since open Infs 
and closed Infs will probably not translate into each other, and since the 
formation of an open vs.\ a closed clause (in PROstatus) was only a 
transformation and hence meaningless, two separate rules have been written for 
open and for closed sentences.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
