\newpage
\begin{verbatim}
% TRANSFORMATION Tsuperdeixisadaptation8
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3:mu2,
                    rel2/VERB{VERBrec1}[mu8],
                    mu9,
                    predrel/ADJP{ADJPrec1}
                              [mu5,
                               I1: rel1/T1,
                               mu6], 
                    mu3
                   ],
            mu4
           ]
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3:mu2,
                    rel2/VERB{VERBrec1}[mu8],
                    mu9, 
                    predrel/ADJP{ADJPrec1}
                              [mu5,
                               I2: rel1/T2,
                               mu6], 
                    mu3
                   ],
            mu4
           ]

>
   MATCHCONDITIONS
      <
       I1: (T1.CAT IN [ADVP, PREPP, NP, QP] AND
            rel1 IN [degreemodrel, forobjrel, hoprel])
           OR 
           (T1.CAT IN [SENTENCE] AND
            rel1 IN AUX_sentencerels)
       I2: (T2.CAT IN [ADVP, PREPP, NP, QP] AND
            rel1 IN [degreemodrel, forobjrel, hoprel])
           OR 
           (T2.CAT IN [SENTENCE] AND
            rel1 IN AUX_sentencerels)
       I3: NOT EXIST (mu2, [auxrel/..])
      >

<
   SUBRULE (* 1. ADVP *)
      < T1: ADVP{ADVPrec1}[mu7] >
      < T2: ADVP{ADVPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (ADVPrec1.superdeixis = presentdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )
             A11: ADVPrec2:= ADVPrec1;
                  ADVPrec2.superdeixis := omegadeixis;

             C12:(ADVPrec1.superdeixis = pastdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = pastdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = pastdeixis)
                   )
                  )

              A12: ADVPrec2:= ADVPrec1;
                   ADVPrec2.superdeixis := omegadeixis;
              C13: (ADVPrec1.superdeixis <> omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: ADVPrec2 := ADVPrec1;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(ADVPrec2.superdeixis = omegadeixis) AND
                 (
                  (
                   (CLAUSErec1.deixis = presentdeixis) AND
                   (CLAUSErec1.superdeixis = omegadeixis)
                  ) OR
                  (
                   (CLAUSErec1.deixis = omegadeixis) AND
                   (CLAUSErec1.superdeixis = presentdeixis)
                  )
                 )
              A11: ADVPrec1:= ADVPrec2;
                   ADVPrec1.superdeixis := presentdeixis;
            
              C12: (ADVPrec2.superdeixis = omegadeixis) AND
                    (
                     (
                      (CLAUSErec1.deixis = pastdeixis) AND
                      (CLAUSErec1.superdeixis = omegadeixis)
                     ) OR
                     (
                      (CLAUSErec1.deixis = omegadeixis) AND
                      (CLAUSErec1.superdeixis = pastdeixis)
                     )
                    )                    
               A12: ADVPrec1 := ADVPrec2;
                    ADVPrec1.superdeixis := pastdeixis;

               C13: (ADVPrec2.superdeixis = omegadeixis) AND
                    (VERBrec1.subc = modalverb) AND
                    (rel2 = auxrel)
               A13: ADVPrec1 := ADVPrec2;

          A1: @
         >

   SUBRULE (* 2. PREPP *)
      < T1: PREPP{PREPPrec1}[mu7] >
      < T2: PREPP{PREPPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (PREPPrec1.superdeixis = presentdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = presentdeixis)
                    )
                   )
             A11: PREPPrec2:= PREPPrec1;
                  PREPPrec2.superdeixis := omegadeixis;

             C12:(PREPPrec1.superdeixis = pastdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = pastdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = pastdeixis)
                   )
                  )
              A12: PREPPrec2:= PREPPrec1;
                   PREPPrec2.superdeixis := omegadeixis;

              C13: (PREPPrec1.superdeixis <> omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: PREPPrec2 := PREPPrec1;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(PREPPrec2.superdeixis = omegadeixis) AND
                 (
                  (
                   (CLAUSErec1.deixis = presentdeixis) AND
                   (CLAUSErec1.superdeixis = omegadeixis)
                  ) OR
                  (
                   (CLAUSErec1.deixis = omegadeixis) AND
                   (CLAUSErec1.superdeixis = presentdeixis)
                  )
                 )
              A11: PREPPrec1:= PREPPrec2;
                   PREPPrec1.superdeixis := presentdeixis;
            
              C12: (PREPPrec2.superdeixis = omegadeixis) AND
                    (
                     (
                      (CLAUSErec1.deixis = pastdeixis) AND
                      (CLAUSErec1.superdeixis = omegadeixis)
                     ) OR
                     (
                      (CLAUSErec1.deixis = omegadeixis) AND
                      (CLAUSErec1.superdeixis = pastdeixis)
                     )
                    )                    
               A12: PREPPrec1 := PREPPrec2;
                    PREPPrec1.superdeixis := pastdeixis;

              C13: (PREPPrec1.superdeixis = omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: PREPPrec1 := PREPPrec2;
          A1: @
         >

   SUBRULE (* 3. NP *)
      < T1: NP{NPrec1}[mu7] >
      < T2: NP{NPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (NPrec1.superdeixis = presentdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = presentdeixis)
                    )
                   )
             A11: NPrec2:= NPrec1;
                  NPrec2.superdeixis := omegadeixis;

             C12:(NPrec1.superdeixis = pastdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = pastdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = pastdeixis)
                   )
                  )
              A12: NPrec2:= NPrec1;
                   NPrec2.superdeixis := omegadeixis;

              C13: (NPrec1.superdeixis <> omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: NPrec2 := NPrec1;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(NPrec2.superdeixis = omegadeixis) AND
                 (
                  (
                   (CLAUSErec1.deixis = presentdeixis) AND
                   (CLAUSErec1.superdeixis = omegadeixis)
                  ) OR
                  (
                   (CLAUSErec1.deixis = omegadeixis) AND
                   (CLAUSErec1.superdeixis = presentdeixis)
                  )
                 )
              A11: NPrec1:= NPrec2;
                   NPrec1.superdeixis := presentdeixis;
            
              C12: (NPrec2.superdeixis = omegadeixis) AND
                    (
                     (
                      (CLAUSErec1.deixis = pastdeixis) AND
                      (CLAUSErec1.superdeixis = omegadeixis)
                     ) OR
                     (
                      (CLAUSErec1.deixis = omegadeixis) AND
                      (CLAUSErec1.superdeixis = pastdeixis)
                     )
                    )                    
               A12: NPrec1 := NPrec2;
                    NPrec1.superdeixis := pastdeixis;

              C13: (NPrec1.superdeixis = omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: NPrec1 := NPrec2;

          A1: @
         >

   SUBRULE (* 4. QP *)
      < T1: QP{QPrec1}[mu7] >
      < T2: QP{QPrec2}[mu7] >

      COMP
         <
          C1:true

            C11: (QPrec1.superdeixis = presentdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = presentdeixis)
                    )
                   )
             A11: QPrec2:= QPrec1;
                  QPrec2.superdeixis := omegadeixis;

             C12:(QPrec1.superdeixis = pastdeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = pastdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = pastdeixis)
                   )
                  )
              A12: QPrec2:= QPrec1;
                   QPrec2.superdeixis := omegadeixis;

              C13: (QPrec1.superdeixis <> omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: QPrec2 := QPrec1;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(QPrec2.superdeixis = omegadeixis) AND
                 (
                  (
                   (CLAUSErec1.deixis = presentdeixis) AND
                   (CLAUSErec1.superdeixis = omegadeixis)
                  ) OR
                  (
                   (CLAUSErec1.deixis = omegadeixis) AND
                   (CLAUSErec1.superdeixis = presentdeixis)
                  )
                 )
              A11: QPrec1:= QPrec2;
                   QPrec1.superdeixis := presentdeixis;
            
              C12: (QPrec2.superdeixis = omegadeixis) AND
                    (
                     (
                      (CLAUSErec1.deixis = pastdeixis) AND
                      (CLAUSErec1.superdeixis = omegadeixis)
                     ) OR
                     (
                      (CLAUSErec1.deixis = omegadeixis) AND
                      (CLAUSErec1.superdeixis = pastdeixis)
                     )
                    )                    
               A12: QPrec1 := QPrec2;
                    QPrec1.superdeixis := pastdeixis;

              C13: (QPrec1.superdeixis = omegadeixis) AND
                   (VERBrec1.subc = modalverb) AND
                   (rel2 = auxrel)
              A13: QPrec1 := QPrec2;

          A1: @
         >

   SUBRULE (* 5. SENTENCE *)
      < T1: SENTENCE{SENTENCErec1}[mu7] >
      < T2: SENTENCE{SENTENCErec2}[mu7] >

      COMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec1.superdeixis = omegadeixis) AND
                  (((SENTENCErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.deixis <> presentdeixis) AND
                    (CLAUSErec1.superdeixis <> presentdeixis) 
                   ) OR
                   ((SENTENCErec1.deixis = pastdeixis) AND
                    ((QUOTE_temprefnotfound(mu7)) AND
                     (CLAUSErec1.deixis <> pastdeixis) AND
                     (CLAUSErec1.superdeixis <> pastdeixis)
                    ) OR
                    (NOT (QUOTE_temprefnotfound(mu7))
                    ) 
                   ) OR
                   ((VERBrec1.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

                  (* dependent clause present *)
             C12: (SENTENCErec1.superdeixis = presentdeixis) AND
                  (SENTENCErec1.deixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec1.finiteness = finite)
                 A121: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := presentdeixis;

                 C122: (SENTENCErec1.finiteness = infinite)
                 A122: SENTENCErec2 := SENTENCErec1;

             A12: SENTENCErec2.superdeixis := omegadeixis;

                  (* dependent clause past *)
             C13: (SENTENCErec1.deixis = omegadeixis) AND
                  (SENTENCErec1.superdeixis = pastdeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec1.finiteness = finite)
                 A131: SENTENCErec2 := SENTENCErec1;
                       SENTENCErec2.deixis := pastdeixis;

                 C132: (SENTENCErec1.finiteness = infinite)
                 A132: SENTENCErec2 := SENTENCErec1;

             A13: SENTENCErec2.superdeixis := omegadeixis;

          A1: @
         >

      DECOMP
         <
          C1:true
                 (* independent complement clause *)
             C11:((SENTENCErec2.superdeixis = omegadeixis) AND
                  (((SENTENCErec2.deixis = presentdeixis) AND
                    (CLAUSErec1.deixis <> presentdeixis) AND
                    (CLAUSErec1.superdeixis <> presentdeixis) 
                   ) OR
                   ((SENTENCErec2.deixis = pastdeixis) AND
                    ((QUOTE_temprefnotfound(mu7)) AND
                     (CLAUSErec1.deixis <> pastdeixis) AND
                     (CLAUSErec1.superdeixis <> pastdeixis)
                    ) OR
                    (NOT (QUOTE_temprefnotfound(mu7))
                    ) 
                   ) OR
                   ((VERBrec1.subc = modalverb) AND
                    (rel2 = auxrel)
                   )
                  )
                 )
             A11: SENTENCErec1 := SENTENCErec2;

                 (* dependent clause present *)
             C12:(SENTENCErec2.superdeixis = omegadeixis) AND
                  (
                   (
                    (CLAUSErec1.deixis = presentdeixis) AND
                    (CLAUSErec1.superdeixis = omegadeixis)
                   ) OR
                   (
                    (CLAUSErec1.deixis = omegadeixis) AND
                    (CLAUSErec1.superdeixis = presentdeixis)
                   )
                  )

                 C121: (SENTENCErec2.deixis = presentdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A121: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C122: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A122: SENTENCErec1 := SENTENCErec2;


              A12: SENTENCErec1.superdeixis := presentdeixis;

                  (* dependent clause past *)
              C13:(SENTENCErec2.superdeixis = omegadeixis) AND
                   (
                    (
                     (CLAUSErec1.deixis = pastdeixis) AND
                     (CLAUSErec1.superdeixis = omegadeixis)
                    ) OR
                    (
                     (CLAUSErec1.deixis = omegadeixis) AND
                     (CLAUSErec1.superdeixis = pastdeixis)
                    )
                   )

                 C131: (SENTENCErec2.deixis = pastdeixis) AND
                       (SENTENCErec2.finiteness = finite)
                 A131: SENTENCErec1 := SENTENCErec2;
                       SENTENCErec1.deixis := omegadeixis;

                 C132: (SENTENCErec2.deixis = omegadeixis) AND
                       (SENTENCErec2.finiteness = infinite)
                 A132: SENTENCErec1 := SENTENCErec2;

              A13: SENTENCErec1.superdeixis := pastdeixis;

          A1: @
        >
>

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tsuperdeixisadaptation8
\item[* relevant examples:] He is [very ill], he is [able to swim], he is [glad 
that she came yesterday]
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:]  XPPROPtoCLAUSE
\item[* class:] TC: Superdeixisadaptation
\item[* date of creation:] 27-OCT-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Tsuperdeixisadaptation6 DUTCH
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: margreet sanders\\
Extended the rule with a subrule for (argument) sentences (copied from 
TSuperdeixisAdaptation2)
\item date: 02/11/89\ \ \ \ \ author: Lisette Appelo\\
Added condition for modal verb. In these cases  superdeixisadaptation should
not take place, because it has already taken place in an earlier cycle (
generative version)
\end{enumerate}
\item[* task:] Check superdeixis of ADVP, PREPP, NP or QP as modifiers  under
ADJP or superdeixis and deixis of SENTENCE as argument under ADJP with
superdeixis or deixis of the higher clause. Note that modifier SENTENCES (in
toinfmodrel or postmodrel ) are dealt with in a separate (iterative)
Superdeixis Adaptation Transformation (nr.\ 9) \\
The superdeixis of ADVP, PREPP, NP or QP is set omega/given a 
value present or past.(This is needed for efficiency 
reasons of the surface parser.) 
\item[\ \ strategy:] The reason this adaptation rule is necessary is that the 
modification rules with ADVP, PREPP, Np or QP
 in the ADJP-grammars are (incorrectly) 
ordered before the (super)deixis rules.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] Different syntactic 
categrories.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
