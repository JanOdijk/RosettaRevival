\newpage
\begin{verbatim}
% RULE RUttADVP
< m1: T1
>

< m : UTT{UTTrec1}[head/T2]
>

<
   SUBRULE
      < T1: ADVP{ADVPrec1}[mu1] >
      < T2: ADVP{ADVPrec2}[mu1] >

      COMP
         <
          C1: ADVPrec1.superdeixis = presentdeixis AND
              QUOTE_polarityOK(T1)                 AND
              (NOT QUOTE_varsintree(T1))
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis
         >
      DECOMP
         <
          C1: ADVPrec2.superdeixis = omegadeixis AND
              QUOTE_polarityOK(T2)
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := presentdeixis
         >
>

&
\end{verbatim}
