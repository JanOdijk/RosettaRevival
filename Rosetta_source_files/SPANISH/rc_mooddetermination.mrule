\newpage
\begin{verbatim}
% RULE Rmoodgerundio
< m1: I3::CLAUSE{CLAUSErec1}
                [ I7:sig3, 
                  I2:subjrel/T1,
                  mu1,
                  predrel/VERBP{VERBPrec1}
                     [ I1:rel1/VERB{VERBrec2}[mu3],
                       mu4
                     ],
                  mu6
                ]
>

< m : I4::SENTENCE{SENTENCErec1}
                           [I7:sig3,
                            I2:subjrel/T1, 
                            mu1,
                            predrel/VERBP{VERBPrec1}
                                [ I1:rel1/VERB{VERBrec3}[mu3],
                                  mu4
                                ],
                            mu6
                           ]
>


   MATCHCONDITIONS
      <
       I7 : ALL(sig3, shiftrel/..)
       I2 : T1.CAT IN [NPVAR, CNVAR]
       I3 : CLAUSErec1.finiteness = infinite AND
            CLAUSErec1.PROsubject =true 
       I4 : SENTENCErec1 =
		   {
 		    mood       : declarative
		    senttype   : subordinateclause
                    modo       : gerundio 
                    finiteness : infinite
                    PROsubject : true
                    adverbial  : false
                    temporal   : false
                    conjclass  : omegaTimeadvClass
                    conjtiempo : omegatiempo
                    conjaspecto: omegaaspecto
                    conjretro  : false
		   }
       I1 : rel1 IN [head, auxrel]
      >


      COMP
         <
          C1: VERBrec2.modo = omegamodo
          A1: VERBrec3 := VERBrec2;
              VERBrec3.modo := gerundio;
              SENTENCErec1 := COPYT_clausetosentence(CLAUSErec1);
              SENTENCErec1 :=
		   {
 		    mood     : declarative
		    senttype : subordinateclause
                    modo     : gerundio
		   }
            (* other attributes retain default values *)
         >

      DECOMP
         <
          C1: VERBrec3.modo = gerundio
          A1: VERBrec2 := VERBrec3;
              VERBrec2.modo := omegamodo;
              CLAUSErec1 := COPYT_sentencetoclause(sentencerec1);
              CLAUSErec1.modo := omegamodo;
         >


&

\end{verbatim}
