\newpage
\begin{verbatim}
% TRANSFORMATION TOblPrepobjControlExtrapSent  (* extrap/SENT,
                                              prepobj/byobj ant. *)
< m1:CLAUSE{CLAUSErec1}
           [ I6:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu4],
                      mu3,
                      I1:rel1/VARPREPP{VARPREPPrec1}
                             [ head/PREP{PREPrec1},
                               objrel/T1
                             ],
                      mu5
                    ],
             mu6,
             extraposrel/I4::SENTENCE{SENTENCErec1}
                        [ I2:sig1,
                          I5:sig2,
                          subjrel/T2,
                          I3:mu7 
                        ]
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I6:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu4],
                      mu3,
                      I1:rel1/VARPREPP{VARPREPPrec1}
                             [ head/PREP{PREPrec1},
                               objrel/T1
                             ],
                      mu5
                    ],
             mu6,
             extraposrel/SENTENCE{SENTENCErec1}
                        [ I2:sig1,
                          I5:sig2,
                          I3:mu7 
                        ]
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [prepobjrel, byobjrel]
       I2: ALL (sig1, shiftrel/..)
       I3: NOT EXIST (mu7, [shiftrel/..]) AND
           NOT EXIST (mu7, [conjrel/..] )
       I4: SENTENCErec1.PROsubject = true
       I5: ALL (sig2, conjrel/..)
       I6: NOT EXIST (mu1, [I61:auxrel/VERB{VERBrec2}[mu9]])
         I61: VERBrec2.subc = modalverb
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: ((rel1 = prepobjrel AND VERBrec1.Controller = prepobj)
               OR
               (rel1 = byobjrel AND 
                VERBrec1 = { controller : subject 
                             oblcontrol : nooblcontrol } ))
              AND
              NPVARrec1 = NPVARrec2 
              (* including cases, which should be [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: (rel1 = prepobjrel AND VERBrec1.Controller = prepobj) 
              OR
              (rel1 = byobjrel AND 
               VERBrec1 = { controller : subject
                            oblcontrol : nooblcontrol })
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which should be [omegacase] *)
         >


   SUBRULE (* 2. CNVAR *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: ((rel1 = prepobjrel AND VERBrec1.Controller = prepobj)
               OR
               (rel1 = byobjrel AND 
                VERBrec1 = { controller : subject
                             oblcontrol : nooblcontrol} ))
              AND
              CNVARrec1 = CNVARrec2 
              (* including cases, which should be [omegacase] *)
          A1: @
         >
      DECOMP
         <
          C1: (rel1 = prepobjrel AND VERBrec1.Controller = prepobj) 
              OR
              (rel1 = byobjrel AND 
              VERBrec1= { controller : subject
                          oblcontrol : nooblcontrol })
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which should be [omegacase] *)
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TOblPrepobjControlExtrapSent
\item[* relevant examples:] \mbox{}\\
\begin{enumerate}
\item PrepObj:(extraposed in analysis only)\\
x1 signed to x3 yesterday [x3 to stop] $\rightarrow$ x1 signed to x3 yesterday 
[to stop]
\item ByObj:(Only for NOC-verbs in the interpretation that BIGPRO and x3 are 
identical; extraposed in analysis only)\\
-- was decided by x1 [x1 to leave at six] $\rightarrow$ -- was decided by x1 [
to leave at six]
\end{enumerate}
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_Controlrules
\item[* date of creation:]  08-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:]  Dutch TNOC3
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To interpret the subject of extraposed complement sentences as
identical to the prepositional object of the CLAUSE, 
or as identical to the object of the byobjrel/ in the CLAUSE, and to
delete the interpreted subject.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One for NPVAR, one
for CNVAR.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
