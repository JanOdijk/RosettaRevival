pragma C_include ('ilacomlangspec.pf');
pragma C_include ('ilacomdecl.pf');

PACKAGE ilacomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH ilacomDECL,
     ilacomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: ilacomLANGSPEC_Category;
                          b: ilacomDECL_nodeid): ilacomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: ilacomDECL_psurfgraph): ilacomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: ilacomDECL_psurfgraph): ilacomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: ilacomDECL_psurfgraph): ilacomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: ilacomDECL_psurfgraph): ilacomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: ilacomLANGSPEC_Category; 
                          c: ilacomDECL_psurfgraph); EXTERNAL;
 
END {ilacomGRAPH};
