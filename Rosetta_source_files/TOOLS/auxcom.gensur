PROCEDURAL PART
VAR term : TSTRING_string;
    punct:: leesteken;
BEGIN
INIT: BEGIN 
        term:='';
        punct:=GeenLeesteken;
      END;
<*
1: <* SEND: BEGIN
              term:=%.str;
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN
              term:='ABSTRACT';
            END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN
            END
      !PUNCTUATION.
      RECEIVE: BEGIN
                 punct:=%%PUNCTUATION.punct;
               END
   *>
*>
FINAL:BEGIN 
        $$TERMARGUMENT.term:=term;
      END
END;
&


%PUNCTUATION
BASIS RULE
  PUNCTUATION = PUNC1|PUNC2|PUNC3|PUNC4|PUNC5|PUNC6|PUNC7
  PUNC1       = LEFTARROW/1|RIGHTARROW/2|SQUAREOPEN/3|SQUARECLOSE/4
  PUNC2       = ROUNDOPEN/5|ROUNDCLOSE/6|CURLYOPEN/7|CURLYCLOSE/8
  PUNC3       = RIGHTQUOTE/9|DOUBLEQUOTE/11|PLUS/31|MINUS/12
  PUNC4       = ASTERISK/13|EQUIVALENT/14|EXCLAMATION/15|QUARY/16|COLON/17
  PUNC5       = COMMA/18|SEMICOLON/19|DOT/20|MONKEYTAIL/21|RAILING/22|DOLLAR/23
  PUNC6       = PERCENT/24|ROOF/25|ANDSIGN/26|UNDERSCORE/27|BACKSLASH/28
  PUNC7       = UPSLASH/28|FORWARDSLASH/30|INVQUARY/32|INVEXCLAMATION/33

