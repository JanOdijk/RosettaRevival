    CATpresent::bool;
    INpresent::bool;
    vartype::vartype;
    str1:TSTRING_string;
    cattable::setofidents;
    cat::ident;
    haakjescounter::int;

<*
INIT: BEGIN
      haakjescounter:=0;
      TSTRING_constantempty(vartype.varname);
      INITsetofidents(vartype.cattable); 
      INITsetofidents(cattable); 
      TSTRING_constantempty(str1);
      beginhaakjepresent:=FALSE;
      NOTpresent:=false;CATpresent:=FALSE;INpresent:=FALSE 
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN INpresent:=TRUE END
