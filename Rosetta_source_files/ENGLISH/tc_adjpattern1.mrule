\newpage
\begin{verbatim}
% TRANSFORMATION TADJPATTERN11    (* locative argument, 
                                      measure phrase argument *)

< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [head/ADJ{ADJrec1}[mu2],
                                      argrel/T1
                                     ]
                            ]
>

< m : ADJPPROP{ADJPPROPrec2}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [head/ADJ{ADJrec1}[mu2],
                                      I1:rel1/T1
                                     ]
                             ]
>
   MATCHCONDITIONS
      <I1: rel1 IN [objrel, complrel, locargrel, dirargrel]
      >

<

   SUBRULE (* 1 *)           (* this hous is worth 200.000 guilders *)

      <T1: NPVAR{NPVARrec1}>
      <T1: NPVAR{NPVARrec1}>


      COMP
         <
          C1: (synMEASUREPHRASE IN ADJrec1.adjpatterns) AND
              ADJPrec1.adjpatternefs = [] AND
              ADJPPROPrec1.adjpatternefs = []
          A1: rel1 := objrel;
              ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synMEASUREPHRASE ];
              ADJPPROPrec2.adjpatternefs := [synMEASUREPHRASE ];
              
         >
      DECOMP
         <
          C1: (rel1 = objrel) AND
              (synMEASUREPHRASE IN ADJrec1.adjpatterns) AND
              (synMEASUREPHRASE IN ADJPrec2.adjpatternefs) AND
              (synMEASUREPHRASE IN ADJPPROPrec2.adjpatternefs) 
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []

         >


   SUBRULE (* 2 *)        (* no English examples found yet;
                             Dutch: ik ben in Amsterdam goed bekend 
                             (not meaning: they know me in A. very well)
                           *)

      <T1: PREPPVAR{PREPPVARrec1}>
      <T1: PREPPVAR{PREPPVARrec1}>


      COMP
         <
          C1: (synLOCPREPP IN ADJrec1.adjpatterns) AND
              (ADJPrec1.adjpatternefs = []) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: rel1 := locargrel;
              ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synLOCPREPP];
              ADJPPROPrec2.adjpatternefs := [synLOCPREPP];
              
         >
      DECOMP
         <
          C1: (rel1 = locargrel) AND
              (synLOCPREPP IN ADJPrec2.adjpatternefs) AND
              (synLOCPREPP IN ADJPPROPrec2.adjpatternefs) AND
              (synLOCPREPP IN ADJrec1.adjpatterns) 
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []

         >


   SUBRULE (*3 *)           (* English: I'm settled down (here) *)
 

      <T1: ADVPVAR{ADVPVARrec1}>
      <T1: ADVPVAR{ADVPVARrec1}>


      COMP
         <
          C1: (synLOCPREPP IN ADJrec1.adjpatterns) AND
              (ADJPrec1.adjpatternefs = []) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: rel1 := locargrel;
              ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synLOCPREPP];
              ADJPPROPrec2.adjpatternefs := [synLOCPREPP];
              
         >
      DECOMP
         <
          C1: (rel1 = locargrel) AND
              (synLOCPREPP IN ADJPrec2.adjpatternefs) AND
              (synLOCPREPP IN ADJPPROPrec2.adjpatternefs) AND
              (synLOCPREPP IN ADJrec1.adjpatterns) 
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []

         >
   SUBRULE (* 4 *)           (* I am settled down a bit;
                                ik ben al behoorlijk gewend *)

      <T1: EMPTYVAR{EMPTYVARrec1}>
      <T1: EMPTYVAR{EMPTYVARrec1}>

      COMP
         <
          C1: (synLOCEMPTY IN ADJrec1.adjpatterns) AND
              (ADJPrec1.adjpatternefs = []) AND
              (ADJPPROPrec1.adjpatternefs = [])
          A1: rel1 := locargrel;
              ADJPrec2 := ADJPrec1;
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPrec2.adjpatternefs := [synLOCEMPTY];
              ADJPPROPrec2.adjpatternefs := [synLOCEMPTY];
              
         >
      DECOMP
         <
          C1: (rel1 = locargrel) AND
              (synLOCEMPTY IN ADJPPROPrec2.adjpatternefs) AND
              (synLOCEMPTY IN ADJPrec2.adjpatternefs) AND
              (synLOCEMPTY IN ADJrec1.adjpatterns) 
          A1: ADJPrec1 := ADJPrec2;
              ADJPPROPrec1 := ADJPPROPrec2;
              ADJPrec1.adjpatternefs := [];
              ADJPPROPrec1.adjpatternefs := []

         >

>
&

\end{verbatim}
