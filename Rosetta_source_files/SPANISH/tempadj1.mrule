\begin{verbatim}
% RULE RADJaspectimperfective
< m1:ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [mu2,
                    head/ADJ{ADJrec1}[mu3],
                    I1: mu4
                   ],
            mu5
           ] 
>

< m :ADJPFORMULA{ADJPFORMULArec2}
           [mu1,
            predrel/ADJP{ADJPrec2}
                   [mu2,
                    head/ADJ{ADJrec1}[mu3],
                    I1: mu4
                   ],
            mu5
           ] 
>
   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu4) AND
           QUOTE_temprefnotfound(mu4) AND
           QUOTE_tempretronotfound(mu4)
      >

      COMP
         <
          C1: ADJPFORMULArec1.aspecto = ADJrec1.aspecto AND
              ADJPrec1.aspecto = ADJrec1.aspecto
          A1: ADJPFORMULArec2 := ADJPFORMULArec1;
              ADJPFORMULArec2.aspecto := imperfectivo;
              ADJPrec2 := ADJPrec1;
              ADJPrec2.aspecto := imperfectivo;
         >

      DECOMP
         <
          C1: ADJPFORMULArec2.aspecto = imperfectivo AND
              ADJPrec2.aspecto = imperfectivo
          A1: ADJPFORMULArec1 := ADJPFORMULArec2;
              ADJPFORMULArec1.aspecto := ADJrec1.aspecto;
              ADJPrec1 := ADJPrec2;
              ADJPrec1.aspecto := ADJrec1.aspecto;
         >

&

\end{verbatim}

