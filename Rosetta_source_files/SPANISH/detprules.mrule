\newpage
\begin{verbatim}
% RULE DETPformation3
< m1: QP{QPrec1}[mu1, head/I1::Q{Qrec1}] 
>

< m : DETP{DETPrec1}[head/QP{QPrec2}[mu1, head/I1::Q{Qrec1}]
                    ]
>

   MATCHCONDITIONS
      <
       I1: Qrec1.key <> KEY_'s_mas2qkey'
      >


      COMP
(* dubbele paden voor bijv. comparatief 'mas' uit sluiten via omegagenero *)
         <
          C1: QPrec1.posspred = true (* to block a double analysis of 
                                         mucho and poco as DETP *)

              C11: singular IN QPrec1.possnumbers
                   C111: true
                   A111: DETPrec1.genero := masc;
                   C112: true
                   A112: DETPrec1.genero := fem;
              A11: DETPrec1.numero := singular;
              C12: plural IN QPrec1.possnumbers
                   C121: true
                   A121: DETPrec1.genero := masc;
                   C122: true
                   A122: DETPrec1.genero := fem;
              A12: DETPrec1.numero := plural;
   
          A1: DETPrec1 :=
                  {
                   definite    :  QPrec1.definite
                   posspred    :  QPrec1.posspred
                   posscomas   :  QPrec1.posscomas
                   mood        :  QPrec1.mood
                   supertiempo :  QPrec1.supertiempo
                 };
              QPrec2 := QPrec1;
              QPrec2.supertiempo := omegatiempo;

         >

      DECOMP
         <
          C1: DETPrec1 = 
                 {
                   definite    :  QPrec2.definite
                   posspred    :  QPrec2.posspred
                   posscomas   :  QPrec2.posscomas
                   mood        :  QPrec2.mood
                 } AND
              QPrec2.supertiempo = omegatiempo AND
              QPrec2.posspred = true AND
              DETPrec1.genero IN [masc, fem]
              C11: singular IN QPrec2.possnumbers AND
                   DETPrec1.numero = singular 
              A11: @
              C12: plural IN QPrec2.possnumbers AND
                   DETPrec1.numero = plural
              A12: @
          A1: QPrec1 := QPrec2;
              QPrec1.supertiempo := DETPrec1.supertiempo;
         >
&

\end{verbatim}
