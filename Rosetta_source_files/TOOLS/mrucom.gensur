%PARAMETERSspec
BASIS RULE
    PARAMETERSspec = PARAMETERS/1.LEFTARROW/1.{LEVEL/4|IDENTIFIER/2.DOTDOT/1.PARTYPE/3}.
                                  RIGHTARROW/1
SURFACE PART
VAR param1::param;
    levelpar::bool;

<*
INIT: BEGIN levelpar:=FALSE END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN param1.parname:=%.str END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN param1.typename:=%PARTYPE.str;
                              appendparam(param1,paramtable)
                        END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN levelpar:=TRUE;
                              TSTRING_constantempty(param1.parname);
                              TSTRING_constantempty(param1.typename);
                              TSTRING_APPENDCHARS(param1.parname,
                              param1.parname,'LEVEL',5);
                              TSTRING_APPENDCHARS(param1.typename,
                              param1.typename,'INTEGER',7);
                              appendparam(param1,paramtable);
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_PARAMETERSspec;
                      $PARAMETERSspec.level:=levelpar
                END
*>
END;
