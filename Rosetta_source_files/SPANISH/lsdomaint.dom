< OPENVERBPPROP   : VERBPPROPrecord >
< CLOSEDVERBPPROP : VERBPPROPrecord >

< BWHADJ          : BWHADJrecord >
< WHADJ           : WHADJrecord >
< BWHPRO          : BWHPROrecord >
< WHPRO           : WHPROrecord >
>

CATSETS: 
<
  UTTERANCE = [UTT]

  TOPCAT    = [
               {* CATs made by the surface-parser; not from morphology *}
	       ADJP, ADVP, DETP, CN, NP, PREPP, QP, SENTENCE, 
               THANP, UTT, VERB {* for complex Vs *}, VERBP
              ]

  LEXCAT    = [ 
               {* output from morphology *}
	       ADJ, ADV, ART, CONJ, COORD, DEMADJ, DEMPRO, DET,
	       EXCLAM, GLUE, INDEFPRO, NEG, NOUN, NUM, ORDINAL, PERSPRO,
               POS, POSSADJ, POSSPRO, PREP, PROPERNOUN, PUNC, Q,  
               REFLPRO, RELPRO, THANAS, VERB, WHADJ, WHPRO,
               CARD 
              ]

  BLEXCAT   = [
               {* CATs in lexicon *}
	       BADJSUFF, BADJ, BADVSUFF, BADV, BIGPRO, CONJ, COORD,
	       BDEMADJ, DEMPRO, BDET, EMPTY, EC, EN, EXCLAM, INDEFPRO, 
               NEG, BNOUNSUFF, BNOUN, NUM, ORDINAL, BPERSPRO, POS, PREP, 
               BPROPERNOUN, PUNC, Q, BVERBSUFF, BVERB, BWHADJ, BWHPRO, 
               DIGIT, 

	       ART, GLUE, REFLPRO, RECIPRO, RELPRO, THANAS
                           {* added for robustness; local translation *}
              ]

  VARCATSET = [
               {* VARs that can be substituted for *}
               ADJPPROPVAR, ADVPPROPVAR, CLAUSEVAR, 
               NPPROPVAR, PREPPPROPVAR, CNVAR, NPVAR, PRONPVAR {*28/1/88*}, 
               PROSENTVAR, SENTENCEVAR, EMPTYVAR, VERBPPROPVAR, 
               PREPPVAR, ADVPVAR
              ]

  SUFFIXCAT = [BADJSUFF, BADVSUFF, BNOUNSUFF, BVERBSUFF]

  PREFIXCAT = [ ]
>


COPY:

SUBNOUNtoNOUN    = FROM SUBNOUNrecord     TO  NOUNrecord       {* D.NPrules *} 
NOUNtoCN         = FROM NOUNrecord        TO  CNrecord         {* D.NPrules *} 
BtoSUBNOUN       = FROM BNOUNrecord       TO  SUBNOUNrecord    {* 8/1/88 *}
ADJtoADJP        = FROM ADJrecord         TO  ADJPrecord       {*STARTXPPROP*} 
ADJPtoADJPPROP   = FROM ADJPrecord        TO  ADJPPROPrecord   {* D.NPrules *} 
PREPPtoPREPPPROP = FROM PREPPrecord       TO  PREPPPROPrecord  {* D.NPrules *}
CNTOVAR          = FROM CNrecord          TO  CNVARrecord      {* D.NPrules *} 
CNtoNP           = FROM CNrecord          TO  NPrecord         {* D.NPrules *} 
ARTtoDETP        = FROM ARTrecord         TO  DETPrecord       {* D.NPrules *} 
WHPROtoNP        = FROM WHPROrecord       TO  NPrecord         {* D.NPrules *} 
INDEFPROtoNP     = FROM INDEFPROrecord    TO  NPrecord         {* D.NPrules *} 
PERSPROtoNP      = FROM PERSPROrecord     TO  NPrecord         {* D.NPrules *} 
PROPERNOUNtoNP   = FROM PROPERNOUNrecord  TO  NPrecord         {* D.NPrules *}
DEMPROtoNP       = FROM DEMPROrecord      TO  NPrecord         {* D.NPrules *} 

NPVARtoNP        = FROM NPVARrecord       TO  NPrecord           {* 17/3/88 *}
                                                 {* also for "NPVARtoPRONP" *}
CNVARtoNP        = FROM CNVARrecord       TO  NPrecord         {* 17/3/88 *}
                                                 {* also for "CNVARtoPRONP" *}
CNVARtoNPVAR     = FROM CNVARrecord       TO  NPVARrecord      {* 18/3/88 *}
                                              {* also for "CNVARtoPRONPVAR" *}

bpropernountopropernoun = FROM BPROPERNOUNrecord TO PROPERNOUNrecord{* Dutch *} 
bdettodet         = FROM BDETrecord       TO  DETrecord             {* Dutch *} 
adjpproptovar     = FROM ADJPPROPrecord   TO ADJPPROPVARrecord      {* Dutch *} 
advpproptovar     = FROM ADVPPROPrecord   TO ADVPPROPVARrecord      {* Dutch *} 
npproptovar       = FROM NPPROPrecord     TO NPPROPVARrecord        {* Dutch *} 
preppproptovar    = FROM PREPPPROPrecord  TO PREPPPROPVARrecord     {* Dutch *} 
verbpproptovar    = FROM VERBPPROPrecord  TO VERBPPROPVARrecord     {* Dutch *} 
nptovar           = FROM NPrecord         TO NPVARrecord            {* Dutch *} 
sentencetovar     = FROM SENTENCErecord   TO SENTENCEVARrecord      {* Dutch *} 
clausetovar       = FROM CLAUSErecord     TO CLAUSEVARrecord        {* Dutch *} 

verbppropTOclause = FROM VERBPPROPrecord  TO CLAUSErecord           {* Dutch *} 
clauseTOverbpprop = FROM CLAUSErecord     TO VERBPPROPrecord        {* Dutch *} 
adjppropTOclause  = FROM ADJPPROPrecord   TO CLAUSErecord           {* Dutch *} 
clauseTOadjpprop  = FROM CLAUSErecord     TO ADJPPROPrecord         {* Dutch *} 
nppropTOclause    = FROM NPPROPrecord     TO CLAUSErecord           {* Dutch *} 
clauseTOnpprop    = FROM CLAUSErecord     TO NPPROPrecord           {* Dutch *} 
advpTOprop        = FROM ADVPrecord       TO ADVPPROPrecord         {* Dutch *} 

alotoverb         = FROM ALOVERBrecord    TO VERBrecord             {*morph*}
subtoverb         = FROM SUBVERBrecord    TO VERBrecord             {*morph*}
subtoaloverb      = FROM SUBVERBrecord    TO ALOVERBrecord          {*morph*}
btosubverb        = FROM BVERBrecord      TO SUBVERBrecord          {*morph*}
verbtoalo         = FROM VERBrecord       TO ALOVERBrecord          {*morph*}
btoperspro        = FROM BPERSPROrecord   TO PERSPROrecord          {*morph*}
bpersprotopossadj = FROM BPERSPROrecord   TO POSSADJrecord          {*morph*}
bperstoposspro    = FROM BPERSPROrecord   TO POSSPROrecord          {*morph*}
btowhpro          = FROM BWHPROrecord     TO WHPROrecord            {*morph*}
btowhadj          = FROM BWHADJrecord     TO WHADJrecord            {*morph*}
btodemadj         = FROM BDEMADJrecord    TO DEMADJrecord           {*morph*}

BtoSUBADJ         = FROM BADJrecord       TO SUBADJrecord         {* 8/1/88 *}
SUBADJtoADJ       = FROM SUBADJrecord     TO ADJrecord            {* 8/1/88 *}

BtoSUBADV         = FROM BADVrecord       TO SUBADVrecord         {* 8/1/88 *}  
SUBADVtoADV       = FROM SUBADVrecord     TO ADVrecord            {* 8/1/88 *}
ADVtoADVP         = FROM ADVrecord        TO ADVPrecord           {* 24/3/88 EA *}

advptovar         = FROM ADVPrecord       TO ADVPVARrecord        {* 8/1/88 *}
prepptovar        = FROM PREPPrecord      TO PREPPVARrecord       {* 8/1/88 *}

clauseTOsentence  = FROM CLAUSErecord     TO SENTENCErecord       {* 8/1/88 *}
sentenceTOclause  = FROM SENTENCErecord   TO CLAUSErecord         {* 8/1/88 *}

QtoQP             = FROM Qrecord          TO QPrecord             {* 8/1/88 *}

END

