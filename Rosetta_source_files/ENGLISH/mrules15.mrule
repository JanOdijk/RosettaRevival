\newpage
\begin{verbatim}
% RULE RxppObjNPsubst
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       predrel/I6::N6
                              [ mu7, 
                                I2:rel1/I1::NPVAR{NPVARrec1},
                                mu8
                              ],
                       mu3
                     ],
              mu4 
            ] 

  SUBST:
  m2: T3=I3::NP{NPrec1}[I9:mu5]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       predrel/I6::N6
                              [ mu7, 
                                I5:rel1/T4=I4::NP{NPrec2}
                                       [ I8:mu6 ],
                                mu8
                              ],
                       mu3
                     ],
              mu4 
            ] 
>

   MATCHCONDITIONS
      <
       m2: NOT QUOTE_NegPhrase(T3) AND
           QUOTE_Gsubstordercondition(mu8, mu3, mu4, T3, CLAUSErec1.prosubject) 
       m : QUOTE_substordercondition(mu8, mu3, mu4, CLAUSErec1.prosubject) 
       I1: NPVARrec1.index = LEVEL
       I2: rel1 IN [objrel, indobjrel] 
       I3: [NPrec1.NPhead] * [reflNP, reciproNP,
                              sentNP, openIngNP] = [] 
       I4: [NPrec2.NPhead] * [reflNP, reciproNP,
                              sentNP, openIngNP] = [] 
       I5: rel1 IN [objrel, indobjrel] AND
           NOT QUOTE_NegPhrase(T4)
       I6: N6.CAT IN [NP, PREPP, ADJP, ADVP]
       I8 :NOT EXIST (mu6, [head/BIGPRO{}[mu10]])
       I9: NOT EXIST (mu5, [head/BIGPRO{}[mu10]])
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = []   AND
              NPrec1.generic = nogeneric
            C11: CLAUSErec1.deixis = omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.superdeixis
            A11: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases); 
            C12: CLAUSErec1.deixis <> omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.deixis
            A12: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases); 
          A1: NPrec2.generic := omegageneric;
              NPrec2.superdeixis := omegadeixis  
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
            C11: CLAUSErec1.deixis = omegadeixis
            A11: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []); 
                 NPrec1.superdeixis := CLAUSErec1.superdeixis;
            C12: CLAUSErec1.deixis <> omegadeixis
            A12: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []); 
                 NPrec1.superdeixis := CLAUSErec1.deixis;
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              (* including cases *)
              NPVARrec1.index := LEVEL;
              NPVARrec1.generic := nogeneric;
              NPrec1.generic := nogeneric;
         >

&

\end{verbatim}
