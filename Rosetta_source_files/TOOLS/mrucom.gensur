        IF MMUM THEN BEGIN
           takeitemid(itemid,itemids1);
           MMUM:=((itemid.minnum=0) AND (itemid.maxnum>100) AND NOT(itemid.issublist));
           END;
        IF MMUM THEN BEGIN
           takeitemid(itemid,itemids1);
