\newpage
\begin{verbatim}
% RULE RADJDegreemod1  
            
< m1: ADJPPROP{ADJPPROPrec1}
              [ mu1,
                predrel/ADJP{ADJPrec1}
                       [ head/ADJ{ADJrec1}[mu8],
                         mu4
                       ]
              ]  
  m2: T2
>

< m : ADJPPROP{ADJPPROPrec1}
              [ mu1,
                predrel/ADJP{ADJPrec2}
                       [ I1:degreemodrel/T2,
                         head/ADJ{ADJrec1}[mu8],
                         mu4
                       ]
              ]
>

   MATCHCONDITIONS
      <
       I1: T2.CAT IN [QP, ADVP, NP]
       m2: T2.CAT IN [QP, ADVP, NP]
       >

<
   SUBRULE (* 1: a bit, much less (than before), most, how much more *)
      <T2: QP{QPrec1}[I4:mu7]>
      <T2: QP{QPrec1}[I4:mu7]>

   MATCHCONDITIONS
      < 
       I4: NOT EXIST(mu7, [toinfcomplrel/..]) (* in that case RADJdegreemod2a
                                              applies*) AND
           NOT EXIST(mu7, [head/Q(KEY_'s_fewer_Q_1'){Qrec1}]) AND
                                            (* 'fewer' is used in DETPs only *)
           NOT  EXIST(mu7, [I14:rel1/..]) 
       I14: rel1 IN [degreemodrel, premodrel,  forobjrel]
            (* ?? artrel,*)
      >

(* nog niet geregeld: als QPrec1.hop = true en premodrel in mu7, dan mu3 leeg
*)
      COMP
         <
          C1: true
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := QPrec1.mood  (* m.h.o. op een WH-QP *)
         >
      DECOMP
         <
          C1: ADJPrec2.mood = QPrec1.mood
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := nowh
         >

(* The relevance of a subclassification of QPs is still to be investigated.
   Therefore no more restrictions have been stated yet. *)

  SUBRULE (* 1a: a bit, much less (than before), most, how much more *)
                  
      <T2: QP{QPrec1}[I4:mu7]>
      <T2: QP{QPrec1}[I4:mu7]>

   MATCHCONDITIONS
      < 
       I4: NOT EXIST(mu7, [toinfcomplrel/..]) (* in that case RADJdegreemod2a
                                              applies*) AND
           NOT EXIST(mu7, [head/Q(KEY_'s_fewer_Q_1'){Qrec1}]) AND
                                            (* 'fewer' is used in DETPs only *)
           EXIST(mu7, [I14:rel1/..])
       I14: rel1 IN [degreemodrel, premodrel,  forobjrel]
            (* ?? artrel,*)
      >

(* nog niet geregeld: als QPrec1.hop = true en premodrel in mu7, dan mu3 leeg
*)
      COMP
         <
          C1: true
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := QPrec1.mood;  (* m.h.o. op een WH-QP *)
              ADJPrec2.actuseefs := [predicative];   (* not reversible  *)

         >

      DECOMP
         <
          C1: ADJPrec2.mood = QPrec1.mood 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := nowh;
         >

(* The relevance of a subclassification of QPs is still to be investigated.
   Therefore no more restrictions have been stated yet. *)

   SUBRULE  (* 2 *) (* too, very much, for me too, three meters too, 
                       how, quite, as .. as possible *)

      <T2: ADVP{ADVPrec1}[I3:mu5]>
      <T2: ADVP{ADVPrec1}[I3:mu5]>

   MATCHCONDITIONS
      <I3: NOT EXIST(mu5, [toinfcomplrel/..])  (* in that case RADJDegreemod2b
                                               applies *) AND
           NOT EXIST(mu5, [I14:rel1/..]) AND
           ADVPrec1.thanas = omegacompl
       I14: rel1 IN [degreemodrel, premodrel, forobjrel, thanascomplrel]
      >

      COMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs 
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := ADVPrec1.mood;  (* m.h.o. op een WH-ADV *)
              ADJPrec2.actuseefs := [predicative]; (* not reversible  *)
        >

      DECOMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs  AND
              ADJPrec2.mood = ADVPrec1.mood 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := nowh;
         >


   SUBRULE  (* 2a *) (* too, very much, for me too, three meters too, 
                       how, quite, as .. as possible *)

      <T2: ADVP{ADVPrec1}[I3:mu5]>
      <T2: ADVP{ADVPrec1}[I3:mu5]>

   MATCHCONDITIONS
      <I3: NOT EXIST(mu5, [toinfcomplrel/..])  (* in that case RADJDegreemod2b
                                               applies *) AND
           ( EXIST(mu5, [I14:rel1/..]) OR
             (ADVPrec1.thanas <> omegacompl)
           )
       I14: rel1 IN [degreemodrel, premodrel, forobjrel, thanascomplrel]
   >

      COMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs 
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := ADVPrec1.mood;  (* m.h.o. op een WH-ADV *)
              ADJPrec2.actuseefs := [predicative]; (* not reversible  *)
        >

      DECOMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs  AND
              ADJPrec2.mood = ADVPrec1.mood  
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := nowh;          
         >

   SUBRULE  (* 3 *)  (* (almost) 3 meters long, ??hoeveel meter lang *)
      <T2:NP{NPrec1}[mu6] >
      <T2:NP{NPrec1}[mu6] >

      COMP
         <
          C1: unitnoun IN NPrec1.actsubcs AND
              ADJrec1.temporal = false
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := NPrec1.mood;  (* m.h.o. op een WH-NP *)
              ADJPrec2.actuseefs := [predicative]; (* not reversible  *)
         >
      DECOMP
         <
          C1: unitnoun IN NPrec1.actsubcs AND
              ADJrec1.temporal = false AND
              ADJPrec2.mood = NPrec1.mood 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := nowh;
         >
      

>


&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RADJDegreemod1
\item[* relevant examples:]too big, very beautiful, how long, 
                           less funny than yesterday, 
                           a bit greenish/yellowlike, 
                           as soon as poosible,
                           more than Jan
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Adjppropformation
\item[* class:] RC: ADJDegreemodrules
\item[* date of creation:] 9-JUL-1987 14:26:49  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] insertion of a degree-modifier 
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:] Measure NPs are not analyzed as QPs. Instead,
the uniformity among the modifying categories is expressed by the relationname
degreemodrel that links the modifying categories to the ADJP. 
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] Cf. remarks.


\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{} Degree-modifiers are NOT 
analyzed as ADVPPROPs, QPPROPs etc., but as ADVPs, QPs, etc.
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems 1:`too' en `too much' moeten wellicht als synoniemen beschouwd 
worden, i.e. `too much' is not a modification of `much'.

\item problems 2:{\em te weinig} should be translated into {\em not enough};
NB. In fact {\em te weinig} should be considered a paraphrase of {\em niet genoeg}
as well. 

\item 
In analysis 
the rule classes dealing with the morphological incorporation of comparative 
and superlative modifiers (mrules62), the value for actuseefs is set to [].
Therefore, the generative assignment ADJPrec2.actuseefs := [predicative], meant to exclude examples such as 
*{\em the three inches longer man} lacks an analytical condition.
In order to get rid of this asymmetry, the role of actuseefs should be 
revised. 
\item modifications:\\
\end{enumerate}
\end{description}
\newpage
\begin{verbatim}

% RULE RADJDegreemod2a     (* enough ... to bring home *)
            
< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [I2:mu2,
                                      head/T1,
                                      I4:mu4 
                                     ]
                            ]  
  m2: QP{QPrec1}[head/T3,
                 toinfcomplrel/SENTENCE{SENTENCErec1}[mu5]
                ]
>

< m : ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec2} 
                                     [I2:mu2,
                                      degreemodrel/QP{QPrec1}[head/T3],
                                      head/T1,
                                      I4:mu4,
                                      postadjrel/SENTENCE{SENTENCErec2}[mu5]
                                     ]
                            ]
>
   MATCHCONDITIONS
      <
       I2: NOT EXIST (mu2, [degreemodrel/..])
       I4: NOT EXIST(mu4, [hoprel/..])
      >


      COMP
         <
          C1: SENTENCErec1.superdeixis = omegadeixis
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := QPrec1.mood;  (* m.h.o. op een WH-QP *)
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.superdeixis := QPrec1.superdeixis;

         >
      DECOMP
         <
          C1: SENTENCErec2.superdeixis = QPrec1.superdeixis
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := nowh;
              SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.superdeixis := omegadeixis;         
>

&

\end{verbatim}
