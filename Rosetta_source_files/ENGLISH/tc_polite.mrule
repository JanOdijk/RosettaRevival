\begin{verbatim}
% TRANSFORMATION Tpolite4 (* would-like-to-insertion *)
< m1:SENTENCE{SENTENCErec1}
           [I2:mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY1){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 
>

< m :SENTENCE{SENTENCErec2}
           [I2:mu1,
            I4:auxrel/VERB{VERBrec3}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec4}
                        [head/SUBVERB{SUBVERBrec4}
                             [I1:head/BVERB(KEY_likeBVERBkey){BVERBrec4}]
                        ],
                    complrel/SENTENCE{SENTENCErec3}
                            [torel/TOCAT(KEY_totocatkey){TOCATrec1}[],
                             predrel/VERBP{VERBPrec1}
                                    [head/VERB{VERbrec2}
                                          [head/SUBVERB{SUBVERBrec2}
                                                [I1:head/BVERB(KEY1){BVERBrec2}]
                                           ],
                                     mu3
                                    ]
                            ]
                   ],
            mu4
           ] 

>
   MATCHCONDITIONS
      <
       I1: KEY1 = KEY_askBVERBkey  
       I2: EXIST (mu1, [I5:subjrel/NP{NPrec1}[mu5]])
       I3: VERBrec1.tense = presenttense
       I4: VERBrec3.tense = pasttense
       I5: NPrec1.person = 1
       m1: SENTENCErec1.mood = declarative
       m : SENTENCErec2.mood = declarative

      >


      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1) EXCEPT FOR
                                    [numbers, persons, tense, modus]) AND
              (SUBVERBrec1.affix = noaffix) AND
              (SENTENCErec1.deixis = presentdeixis) AND
              (VERBrec1.tense = presenttense)

          A1: VERBrec3 := VERBrec1;
              VERBrec3.tense := pasttense;
              SUBVERBrec4 := COPYT_bverbtosubverb(BVERBrec4);
              VERBrec4 := COPYT_subverbtoverb(SUBVERBrec4);
              VERBrec4 :=
                {
                  numbers     : VERBrec2.numbers
                  persons     : VERBrec2.persons
                  modus       : VERBrec2.modus
                  tense       : VERBrec2.tense
                };
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.deixis := pastdeixis;
              SENTENCErec2.aktionsarts := [stative];
              SENTENCErec2.thetavp := vp120;
              SENTENCErec2.synvpefs := [synopentosent];
              SENTENCErec2.voice := active;
              SENTENCErec3 := SENTENCErec1;
              SENTENCErec3.infsort := toinf;
              SENTENCErec3.finiteness := infinite;
              SENTENCErec3.deixis := omegadeixis;
              SENTENCErec3.modus := infinitive;
              SENTENCErec3.prosubject := true;
              SENTENCErec3.senttype := subordinateclause;

         >
      DECOMP
         <
             (* no decomp version *)
             
         >

&

\end{verbatim}
