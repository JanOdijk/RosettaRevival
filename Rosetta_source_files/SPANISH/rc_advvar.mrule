\begin{verbatim}
% RULE Rconjsvar
< m1: VERBPPROP{VERBPPROPrec1}
                [ I2:mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  mu3 
                ]

  m2: I1::SENTENCEVAR{SENTENCEVARrec1}                 
>

< m :VERBPPROP{VERBPPROPrec1}
                [ leftdislocrel/I1::SENTENCEVAR{SENTENCEVARrec1},
                  I2:mu1,
                  predrel/VERBP{VERBPrec1}[mu2],
                  mu3
                ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCEVARrec1.adverbial = true
       I2: NOT EXIST(mu1, [leftdislocrel/..])
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
