\newpage
\begin{verbatim}
% TRANSFORMATION TExtrapWhShift
< m1: CLAUSE{CLAUSErec1}[mu1]
>

< m : CLAUSE{CLAUSErec1}[mu4]
>

<
   SUBRULE (* 1. shift from shiftrel *)
      < mu1: [ I1:mu2,
               extraposrel/I2::SENTENCE{SENTENCErec1}
                          [ I3:shiftrel/T1,
                            I4:mu3
                          ]
             ] >
      < mu4: [ I3:shiftrel/T1,
               I1:mu2,
               extraposrel/I2::SENTENCE{SENTENCErec1}
                          [ I4:mu3 ]
             ] >

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11:rel1/..])
       I2: SENTENCErec1.mood = declarative
       I3: T1.CAT IN [PREPP, VARPREPP, ADJP, ADVP, NPVAR] 
                    WITH T1.REC.mood = wh
       I4: NOT EXIST (mu3, [I11:rel1/..])
         I11: rel1 IN [shiftrel, leftdislocrel]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. shift from subjrel *)
      < mu1: [ I1:mu2,
               extraposrel/I2::SENTENCE{SENTENCErec1}
                          [ I3:subjrel/NPVAR{NPVARrec1},
                            I4:mu3
                          ]
             ] >
      < mu4: [ I3:shiftrel/NPVAR{NPVARrec1},
               I1:mu2,
               extraposrel/I2::SENTENCE{SENTENCErec1}
                          [ I4:mu3 ]
             ] >

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11:rel1/..])
       I2: SENTENCErec1.mood = declarative AND
           SENTENCErec1.finiteness = infinite
       I3: NPVARrec1.mood = wh
       I4: NOT EXIST (mu3, [I11:rel1/..])
         I11: rel1 IN [shiftrel, leftdislocrel]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
