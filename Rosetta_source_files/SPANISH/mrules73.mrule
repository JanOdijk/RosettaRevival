\newpage
\begin{verbatim}
% RULE RNPPresentSuperdeixis2
< m1: NP{NPrec1}[mu1,
                 I1:head/N1[mu4],
                 mu2
                 ] 
>

< m: NP{NPrec2}[mu1,
                 I1:head/N1[mu4],
                 mu2
                 ] 
>

   MATCHCONDITIONS
      <
       m1: NPrec1.supertiempo = omegatiempo 
       m: NPrec2.supertiempo = presente
       I1: N1.cat IN [PERSPRO, WHPRO, INDEFPRO, PROPERNOUN, DEMPRO, RECIPRO,
                      CARD]
      >


      COMP
         <
          C1: true
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := presente;
         >
      DECOMP
         <
          C1: true
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := omegatiempo ;
         >
&

\end{verbatim}
