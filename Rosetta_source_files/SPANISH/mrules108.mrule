SPANISH 108
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TSEspelling1 (* PRONPVAR sepassive objrel *)
< m1:I1::SENTENCE{SENTENCErec1}
           [ I4:mu1,
             subjrel/PRONPVAR{PRONPVARrec1}[],
             I3:mu2,
             cliticrel/CLITIC{}[I5:mu3],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5,
             predrel/VERBP{VERBPrec1}[mu6,
                                      I2:objrel/T1,
                                      mu7
                                     ],
             mu8
            ]
>

< m:I1::SENTENCE{SENTENCErec1}
          [ I4:mu1,
            I3:mu2,
            cliticrel/CLITIC{}[seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1},
                               I5:mu3
                              ],
            head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
            mu5,
            predrel/VERBP{VERBPrec1}[mu6,
                                     I2:objrel/T1,
                                     mu7
                                    ],
            mu8
          ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCErec1.voice = sepassive AND
           SENTENCErec1.finiteness = finite AND
           SENTENCErec1.Restructuring = false
           (*
            OR
            ((SENTENCErec1.Restructuring = true)     AND  
             (SENTENCErec1.finiteness = finite))
             Zijn er finiete restr.compls?
           *)
       I2:  T1.CAT IN [NP,CNVAR, NPVAR]
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  NOT EXIST (mu3, [seCLrel/..])
       I6:  (BVERBrec1.reflexivity = notreflexive)    AND
            (BVERBrec1.key <> KEY_haberque1BVERBkey)  AND
            (BVERBrec1.key <> KEY_haberque2BVERBkey)
      >

<
  SUBRULE
      <T1: NP{NPrec1}[mu20] >
      <T1: NP{NPrec1}[mu20] >

      COMP
         <
          C1: (PRONPVARrec1 = AUX_PRONPVARONecBPRSPR EXCEPT FOR 
                                           [numero,persona,genero]) 
                                                       AND
              ( PRONPVARrec1.numero = VERBrec2.numero)    AND
              ( PRONPVARrec1.persona = VERBrec2.persona)  AND
              ( PRONPVARrec1.genero = NPrec1.genero)
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;
              PRONPVARrec1.numero := VERBrec2.numero;
              PRONPVARrec1.persona := VERBrec2.persona;
              PRONPVARrec1.genero := NPrec1.genero
         >

  SUBRULE
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: (PRONPVARrec1 = AUX_PRONPVARONecBPRSPR EXCEPT FOR 
                                           [numero,persona,genero]) 
                                                       AND
              ( PRONPVARrec1.numero = VERBrec2.numero)    AND
              ( PRONPVARrec1.persona = VERBrec2.persona)  AND
              ( PRONPVARrec1.genero = NPVARrec1.genero)
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;
              PRONPVARrec1.numero := VERBrec2.numero;
              PRONPVARrec1.persona := VERBrec2.persona;
              PRONPVARrec1.genero := NPVARrec1.genero
         >


   SUBRULE
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: (PRONPVARrec1 = AUX_PRONPVARONecBPRSPR EXCEPT FOR 
                         [numero,genero])                 AND
              (PRONPVARrec1.numero = VERBrec2.numero)        AND
              (PRONPVARrec1.genero = masc)
          A1:  @
          C1: (PRONPVARrec1 = AUX_PRONPVARONecBPRSPR EXCEPT FOR 
                         [numero,genero])                 AND
              (PRONPVARrec1.numero = VERBrec2.numero)        AND
              (PRONPVARrec1.genero = fem)
          A1:  @
         >

      DECOMP
         <
          C1: masc IN CNVARrec1.generos
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;
              PRONPVARrec1.numero := VERBrec2.numero;
              PRONPVARrec1.genero := masc
          C1: fem IN CNVARrec1.generos
          A1: PRONPVARrec1 := AUX_PRONPVARONecBPRSPR;
              PRONPVARrec1.numero := VERBrec2.numero;
              PRONPVARrec1.genero := fem
         >          
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TSEspelling1
\item[* relevant examples:] SE venden libros
\item[* language:] Spanish 
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_SEspelling
\item[* date of creation:] 23-SEP-1988 10:33:24  
\item[* author:] Elly van Munster
\item[* copied from:] TSEspelling
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 27/1/89\ \ \ \ \ author: Elly van Munster\\
objrel/T1 added, in order to test on (or, in analysis, assign) genero(s) to
PRONP[EC]. Therefore three subrules are made (NP, NPVAR, CNVAR).
\item date: 13/09/89\ \ \ \ \ author: Lisette Appelo\\
Changed PRONP into PRONPVAR; added conditions on sepassive voice and finite 
sentence.
\end{enumerate}
\item[* task:] To replace subjrel/PRONP{}[EC{}] by SE (category REFLPRO) in 
clitic-position.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:] (see TSEspelling)
