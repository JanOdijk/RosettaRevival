\newpage
\begin{verbatim}
% TRANSFORMATION TNoControlPREPP      (* CLOSEDPREPPPROP *)
< m1:CLAUSE{CLAUSErec1}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I2:rel1/CLOSEDPREPPPROP{CLOSEDPREPPPROPrec1}
                             [ I3:subjrel/T1,
                               predrel/PREPP{PREPPrec1}[mu3] 
                             ],
                      mu4 
                    ],
             mu5
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I3:objrel/T1,
                      I5:rel2/PREPP{PREPPrec1}[mu3],
                      mu4 
                    ],
             mu5
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2,[objrel/..])
       I2: rel1 IN [locargrel, dirargrel, complrel]
       I3: T1.CAT IN [NP, NPVAR, CNVAR]
       I4: NOT EXIST (mu1, [I41:auxrel/VERB{VERBrec1}[mu11]])
         I41: VERBrec1.subc = modalverb
       I5: rel2 IN [locargrel,dirargrel,predrel]
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_closedxppvps <> [] AND
              CLOSEDPREPPPROPrec1 = COPYT_preppTOpreppprop(PREPPrec1)
                EXCEPT FOR [PROsubject, env, req,
                            aktionsarts, superdeixis] AND
              CLOSEDPREPPPROPrec1 = { PROsubject  : false
                                      aktionsarts : [stative] 
                                      superdeixis : omegadeixis }
              (* no test on req or env *)
              C11: rel1 IN [dirargrel, locargrel] 
              A11: rel2 := rel1;
              C12: rel1 IN [complrel] 
              A12: rel2 := predrel;
          A1: CLAUSErec2 := CLAUSErec1;
         >
              
      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_closedxppvps <> [] 
              C11: rel2 IN [dirargrel, locargrel] 
              A11: rel1 := rel2;
              C12: rel2 IN [predrel] 
              A12: rel1 := complrel;
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs :=
                 CLAUSErec2.synvpefs * AUX_closedxppvps ;
              CLOSEDPREPPPROPrec1 := COPYT_preppTOpreppprop(PREPPrec1);
              CLOSEDPREPPPROPrec1 := { PROsubject  : false
                                       aktionsarts : [stative] 
                                       superdeixis : omegadeixis }
              (* req, env get PREPP value *)
         >

&
\end{verbatim}
