pragma C_include('tstring.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH TSTRING;

PACKAGE DOMCOMLANGSPEC;

CONST
   DOMCOMLANGSPEC_NROW      =   23;
   DOMCOMLANGSPEC_MAXRNR    =   26;

TYPE SETOFCHAR = SET OF CHAR;
plosstring = ^losstring;
losstring = RECORD
   next:plosstring;
   carriage:BOOLEAN;
   arg:TSTRING_string
 END; 
LOCALFILE = RECORD 
            first,last:plosstring
            END; 
   DOMCOMLANGSPEC_Category  =   (DomainTcat,ENDcat,AFFIXKEYScat,IScat,roundopen,
                                 roundclose,comma,TYPEScat,dotdot,RECORDScat,
                                 RELATIONScat,CATEGORIEScat,dot,squareopen,
                                 squareclose,CATSETScat,catsetspec,
                                 dotcomma,INTEGERcat,BOOLEANcat,SETcat,OFcat,
                                 KEYcat,INDEXcat,leftarrow,rightarrow,COMMENT,dutchcat,
                                 englishcat,spanishcat,copycat,fromcat,tocat,
                                 utt,affixspec,typespec,recordspec,relationspec,
                                 categoriespec,identifier,typedefinition,
                                 recorddefinition,catdefinition,enumdef,
                                 subrangedef,integerdef,booleandef,setdef,
                                 typename,attribname,defaultvalue,recordname,
                                 catlist,catname,functionname,copyspec,
                                 contextspec,phoneticspec,contextcat,
                                 phoneticcat,minus,derivkeyscat,derivspec);

   DOMCOMLANGSPEC_pTerminal = ^DOMCOMLANGSPEC_Terminal;
   DOMCOMLANGSPEC_Terminal  = RECORD 
                                 str : TSTRING_String;
                              END;
   DOMCOMLANGSPEC_SetConstrRec = RECORD 
                                    emptyvar : boolean
                                 END;
   DOMCOMLANGSPEC_MatchStringRec = RECORD
                                    str      : TSTRING_String;
                                    nrvars   : integer;
                                    vars     : ARRAY [1..9] OF integer
                                   END;
   DOMCOMLANGSPEC_AnGenSpecRec = RECORD
                                    agchar : char
                                 END;
   DOMCOMLANGSPEC_FieldDef  = RECORD 
                                 CASE DOMCOMLANGSPEC_Category OF
                                 DomainTcat,ENDcat,AFFIXKEYScat,IScat,roundopen,
                                   roundclose,comma,TYPEScat,dotdot,RECORDScat,
                                   RELATIONScat,CATEGORIEScat,dot,fromcat,tocat,
                                   copycat,squareopen,squareclose,
                                   dotcomma,INTEGERcat,BOOLEANcat,SETcat,OFcat,
                                   KEYcat,INDEXcat,leftarrow,rightarrow,COMMENT,dutchcat,
                                   englishcat,spanishcat,contextcat,phoneticcat,
                                   minus, identifier, derivkeyscat
                                      : ( terminal : DOMCOMLANGSPEC_pTerminal);
                                   typename,attribname,defaultvalue,recordname,
   				   catname
                                      :(preterminal:DOMCOMLANGSPEC_pTerminal)
                                 END;

FUNCTION DOMCOMLANGSPEC_ScanChars:SETOFCHAR;
         EXTERNAL;

PROCEDURE DOMCOMLANGSPEC_Init; EXTERNAL;

PROCEDURE DOMCOMLANGSPEC_Word(i: integer; VAR s: TSTRING_String);
         EXTERNAL;

FUNCTION DOMCOMLANGSPEC_Wcat(i: integer): DOMCOMLANGSPEC_Category;
         EXTERNAL;

FUNCTION DOMCOMLANGSPEC_Scat(c: CHAR): DOMCOMLANGSPEC_Category;
         EXTERNAL;

PROCEDURE DOMCOMLANGSPEC_CreateTerm(s: DOMCOMLANGSPEC_Category;
                                                   w: TSTRING_String;
                                                   VAR f: DOMCOMLANGSPEC_FieldDef); EXTERNAL;

END {DOMCOMLANGSPEC};
