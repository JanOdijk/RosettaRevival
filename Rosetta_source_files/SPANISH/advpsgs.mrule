\newpage
\begin{verbatim}
% TRANSFORMATION Tadvpattern0
< m1:ADVPPROP{ADVPPROPrec1}
           [mu1, predrel/ADVP{ADVPrec1}[head/ADV{ADVrec1}[mu2]] ]
>

< m :ADVPPROP{ADVPPROPrec2}[mu1, 
           predrel/ADVP{ADVPrec2}[head/ADV{ADVrec1}[mu2] ] ]
>

      COMP
         <
          C1: synnovpargs IN ADVrec1.advpatterns AND
              ADVPrec1.advpatternefs = []        AND
              ADVPPROPrec1.advpatternefs = []
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synnovpargs];
              ADVPPROPrec2 := ADVPPROPrec1;
              ADVPPROPrec2.advpatternefs := [synnovpargs];
         >
      DECOMP
         <
          C1: synnovpargs IN ADVrec1.advpatterns AND
              synnovpargs IN ADVPrec2.advpatternefs AND
              synnovpargs IN ADVPPROPrec2.advpatternefs
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
              ADVPPROPrec1 := ADVPPROPrec2;
              ADVPPROPrec1.advpatternefs := [];
         >

&

\end{verbatim}
