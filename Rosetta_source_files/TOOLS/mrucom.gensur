%GRAPH
BASIS RULE
  GRAPH = CONCGRAPH/2.{VERTLINE/1.CONCGRAPH/2}
SURFACE PART
  VAR numofconcgraphs::int;


<*
 INIT:BEGIN
         numofconcgraphs:=0
       END;
 1    :<*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
 2    :<*
        LOCALCONDITION: TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION: BEGIN
                         numofconcgraphs:=numofconcgraphs+1
                         END
       *>
 FINAL: #CONDITION: TRUE
         #ACTION: BEGIN
                  SEND_GRAPH;
                  $GRAPH.numofconcgraphs:=numofconcgraphs
                  END
*>
END;

PROCEDURAL PART
VAR make:LOCALFILE;
    i,number::int;
BEGIN
INIT: BEGIN initlocalfile(make);number:=0;
            \make.\LOCAL.
            "FUNCTION GRAPH:LDMRULES_pCtrlExpr;"\\
      END;
<*
1: <* SEND: BEGIN  END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN number:=number+1; %%CONCGRAPH.number:=number END
      !CONCGRAPH.
      RECEIVE: BEGIN 
               APPENDlocfile(%%CONCGRAPH.make,make);
               END
   *>
*>
FINAL:BEGIN
            "VAR result:LDMRULES_pCtrlExpr;"\\
            "BEGIN"\\
            "LDMRULES_makectrlexpr(result);"\\
            "result^.kind:=alternative;"\\
            "InitCtrlExprLst(result);"\\
            i:=0;
            WHILE i<>number DO
             BEGIN
             i:=i+1;
             "AppendCtrlExpr(CONCGRAPH" """i""" ",result);"\\
            END;
      "GRAPH:=result;"\\
      "END;"\\
      $$GRAPH.make:=make 
      END
END;
