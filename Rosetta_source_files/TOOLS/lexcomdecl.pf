 *  Function Name  : LEXCOMDECL_absent
 *  Description    : 
 *  Parameters     : 
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION LEXCOMDECL_absent:LEXCOMDECL_psurfgraph; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LEXCOMDECL_assignabsent
 *  Description    : 
 *  Parameters     : 
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : valeu of absent is 'valeu'
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

PROCEDURE LEXCOMDECL_assignabsent(valeu:LEXCOMDECL_psurfgraph); EXTERNAL;

