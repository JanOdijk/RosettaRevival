\newpage
\begin{verbatim}
% RULE Rdaynumber
< m1: NP {NPrec1}
          [ head/PROPERNOUN {PROPERNOUNrec1} [mu11]
          ]

  m2: NP{NPrec2}[I2:mu2] 
>

< m : NP{NPrec1}
         [ head/PROPERNOUN{PROPERNOUNrec1}[mu11],
           complrel/NP{NPrec2}[I2:mu2] 
         ]
>

   MATCHCONDITIONS
      <
        I2:  ALL (mu2, I21:head/T1)
        I21: T1.CAT = CARD
     >

      COMP
         <
          C1: PROPERNOUNrec1.subc = daynoun AND
              NPrec1.supertiempo = NPrec2.supertiempo
          A1: NPrec2.supertiempo := omegatiempo
         >
      DECOMP
         <
          C1: PROPERNOUNrec1.subc = daynoun AND
              NPrec2.supertiempo = omegatiempo
          A1: NPrec2.supertiempo := NPrec1.supertiempo
         >



&

\end{verbatim}
