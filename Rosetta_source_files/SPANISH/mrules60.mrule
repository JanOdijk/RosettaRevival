SPANISH 60
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Tainsertion
< m1 :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/I1::NP{NPrec1}[I2:mu5],
                      mu3
                    ],
             mu4 
           ] 
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/I1::NP{NPrec1}
                           [modrel/PREP(KEY_aPREPkey){PREPrec1},
                            [I2:mu5]
                           ],
                      mu3
                    ],
             mu4 
           ] 
>

   MATCHCONDITIONS
      <
       I1: Prepositive IN NPrec1.cases
       I2: NOT EXIST (mu5, [modrel/PREP{}])
      >

      COMP
         <
          C1: true 
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
