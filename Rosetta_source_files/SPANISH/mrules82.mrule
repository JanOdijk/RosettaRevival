SPANISH 82

&
%
%SUBGRAMMAR Preppproptopreppformula

(Rpreptoformula/1)
.
(RpppAspectImperfective/4)

(* tijdregels *)
.(Rpppsuperdeixis/7)

.
(Tppca0/2 | Tppca1/3)



HEAD:
<
PREPPPROP     FROM (PREPPPROPformation)
>


(* IMPORT: *)
<
>


EXPORT:
<
PREPPFORMULA
>
&


\newpage
\begin{verbatim}
% RULE Rpreptoformula
< m1: PREPPPROP{PREPPPROPrec1}[mu1]
>

< m : PREPPFORMULA{PREPPFORMULArec1}[mu1]
>

      COMP
         <
          C1: true
          A1: PREPPFORMULArec1 := PREPPPROPrec1;
         >
      DECOMP
         <
          C1: true
          A1: PREPPPROPrec1 := PREPPFORMULArec1;
         >

&

\end{verbatim}
