          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);

              NPrec1 := AUX_NPONnomBPRSPR;                     
              NPrec1.numero := plural;                     
              NPrec1.persona := 1;
              NPrec1.genero := fem;
         >


   SUBRULE
      < T1:BPERSPRO(KEY_vosotrosBPERSPROkey){BPERSPROrec1}>
      < >

      COMP
         <
