\begin{verbatim}
%
% RULE RNPformation11

< m1: CN{CNrec1}I2:[mu1,
                 head/EN(KEY_countenkey){ENrec1},
                 I4:mu2
                ]

>

< m:  NP{NPrec1}[detrel/DETP{DETPrec1}[head/T4],
                 head/CN{CNrec1}I2:[mu1,
                                 head/EN(KEY_countenkey){ENrec1},
                                 mu2
                                ]
                ]                       
>

   MATCHCONDITIONS
      <
      I2: EXIST(mu1, [I12:modrel/T1]) OR
          EXIST(mu2, [I13:rel1/T3])
      I12: T1.CAT IN [ADJP, SENTENCE]
      I13: ((T3.CAT IN [ADJP, ADVP, PREPP]) OR 
            (T3.CAT IN [SENTENCE] WITH T3.REC.mood =relative) OR
            (T3.CAT IN [SENTENCE] WITH T3.REC.mood =partrelative)) AND
            rel1 IN [posrel, postmodrel]
      I4: NOT EXIST(mu2, [posrel/NP{NPrec2}[mu9]])
      >

      COMP
         <
          C1:true
          A1:@
         >
      DECOMP
         <
          C1:true
          A1:@
         >


&

   SUBRULE(* 1 *)
      < >
      <T1:ART(KEY_unartkey){ARTrec1}>

      COMP
         <
          C1: (CNrec1.generos * [masc, neutro] <> []) AND
              (CNrec1.numero = singular ) AND
               count IN CNrec1.posscomas
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
               NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                          possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          numero            : CNrec1.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          NPhead     : ennp
                         }  
         >

      DECOMP
         <
          C1: ((CNrec1.generos * [masc, neutro] <> [] ) AND
              (CNrec1.numero = singular)) AND 
               count IN CNrec1.posscomas AND
               DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
               DETPrec1.posspred = true AND
               NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                          possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          numero            : CNrec1.numero
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                          NPhead     : ennp
                         }  

          A1:  @
         >

      COMP
         <
          C1: (DETPrec1.posscomas * CNrec1.posscomas <> []) AND
              (DETPrec1.superdeixis = CNrec1.superdeixis)

          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              DETPrec1.possnietnp := true;
              DETPrec1.mood := declxpmood;              
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          number            : NOUNrec1.number
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : [count]
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          possgeni          : CNrec1.possgeni
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          class             : CNrec1.class 
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          NPhead     : enokNP
                         }  
         >

      DECOMP
         <
          C1: CNrec1.numbers = [singular] AND
              DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
              DETPrec1.posspred = true AND
              DETPrec1.possnietnp = true AND
              DETPrec1.mood = declxpmood AND
              CNrec1.posscomas * [count] <> [] AND
              NPrec1.actcomas * [count] <> [] AND
              NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          number            : NOUNrec1.number
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          possgeni          : CNrec1.possgeni
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          class             : CNrec1.class 
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro

                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          NPhead     : enokNP
                         }  
            
              AND (NPrec1.cases = [nominative]) 
             
          A1:  @
         >

&

\end{verbatim}
