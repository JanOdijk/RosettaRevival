\begin{verbatim}
% TRANSFORMATION TPronIOdel2
< m1:I1::SENTENCE{SENTENCErec1}
                      [ mu1,
                        cliticrel/CLITIC{}
                           [seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1}[],
                            I3: mu8
                           ],
                        head/VERB{VERBrec1}[mu3],
                        mu4,
                        predrel/VERBP{VERBPrec1}
                            [mu10,
                             indobjrel/PREPP{PREPPrec1}
                                  [head/PREP(KEY_aPREPkey){PREPrec1},
                                   objrel/NP{NPrec1}
                                      [head/PERSPRO{PERSPROrec2}[head/T2]]
                                  ],
                             mu9
                            ],
                        mu6
                      ]
>

< m:I1::SENTENCE{SENTENCErec1}
                     [ mu1,
                       cliticrel/CLITIC{}
                          [seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1}[],
                           I3: mu8
                          ],
                       head/VERB{VERBrec1}[mu3],
                       mu4,
                       predrel/VERBP{VERBPrec1}[mu10,
                                                mu9
                                               ],
                       mu6
                     ]
>


   MATCHCONDITIONS
      <
       I1: SENTENCErec1.finiteness = finite  AND
           (SENTENCErec1.voice = active  OR
            SENTENCErec1.voice = passive )
       I3: EXIST (mu8, [I4:rel1/..])
       I4: rel1 IN [tresCLrel, dosCLrel, unoCLrel]

      >

< 
   SUBRULE  (* se mannelijk *)
      < T2:BPERSPRO(KEY_elbpersprokey){BPERSPROrec2}>
      < >

      COMP
         <
          C1: (PREPPrec1 =
                   { mood          : NPrec1.mood
                     actsubcefs    : PREPrec1.subcs
                     synppefs      : PREPrec1.synpps
                     thetapp       : PREPrec1.thetapp
                     headkey       : PREPrec1.key
                     class         : NPrec1.class
                     tiempo        : NPrec1.tiempo
                     aspecto       : NPrec1.aspecto
                     retro         : NPrec1.retro
                     supertiempo   : NPrec1.supertiempo
                     SpecQ         : NPrec1.SpecQ
                   })                           AND

              (NPrec1 = AUX_NPONnomBPRSPR EXCEPT FOR [cases, numero,
                                                      persona, genero]) AND
              (prepositive IN NPrec1.cases) AND
              (NPrec1.numero = PERSPROrec2.numero) AND
              (NPrec1.persona = PERSPROrec2.persona) AND
              (NPrec1.genero = PERSPROrec2.genero) AND
 
              (PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                              EXCEPT FOR [forma]) AND
              (PERSPROrec2.forma = PrepFuerte)
          A1:  @
         >
  
     DECOMP
         <
          C1: true
          A1: PERSPROrec2 := COPYT_btoperspro(BPERSPROrec2);
              PERSPROrec2.forma := PrepFuerte;

              NPrec1 := AUX_NPONnomBPRSPR;
              NPrec1.cases := [prepositive];
              NPrec1.numero := PERSPROrec2.numero;
              NPrec1.persona := PERSPROrec2.persona;
              NPrec1.genero := PERSPROrec2.genero;

              PREPPrec1 := 
