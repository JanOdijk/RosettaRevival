\begin{verbatim}
% FILTER FpostNPCNdeletion1   

< m1: NP{NPrec1}[detrel/T1,
                 head/CN{CNrec1}
                         [head/EN(KEY_countENkey){ENrec1}],
                 mu1
                ]
>


      COMP
         <
          C1: count IN NPrec1.actcomas AND
              NPrec1.NPhead = enNP AND
              NPrec1.definite <> indef AND
              NPrec1.numero = plural AND
              count IN CNrec1.posscomas
          A1: @
         >


  (* No DECOMP *)


&

\end{verbatim}
