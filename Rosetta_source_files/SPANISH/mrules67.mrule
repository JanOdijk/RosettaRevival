\begin{verbatim}
  TRANSFORMATION TADJQPhopping2       (* bijna mooi genoeg, 
                                         bijna lang zat *)

< m1:  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [mu2,
                       degreemodrel/QP{QPrec1}
                                    [I1:modrel/T1,
                                     head/I2::Q{Qrec1}
                                    ],
                       head/ADJ{ADJrec1}[mu5],
                       mu6
                      ] 
                ]
>

< m :  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [mu2,
                       I1:premodrel/T1,
                       head/ADJ{ADJrec1}[mu5],
                       hoprel/QP{QPrec1}[mu3],
                       mu6
                      ] 
                ]
>



   MATCHCONDITIONS
      <I1: T1.cat IN [ADVP]
       I2: QPrec1.hop =  true
      >
<
   SUBRULE
      <T1: ADVP{ADVPrec1}[ ] >
      <T1: ADVP{ADVPrec1}[ ] >

      COMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs 
          A1: @
         >
      DECOMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs 
          A1: @
         >

>
&

\end{verbatim}
