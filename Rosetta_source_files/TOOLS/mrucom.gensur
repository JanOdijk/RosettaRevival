VAR str:TSTRING_string;
begin
TSTRING_constant(str,'T',1);
STRING:=str
end;
FUNCTION EXTRACT(str:TSTRING_string):BOOLEAN;
VAR ch:CHAR;
BEGIN
TSTRING_extractchar(ch,str,2);
EXTRACT:=(ch IN ['1','2','3','4','5','6','7','8','9'])
END;


<*
INIT: BEGIN TSTRING_constantempty(str) END;
1 : <* LOCALCONDITION:(TSTRING_comparebegin(%.str,STRING)=0) AND
                      EXTRACT(%.str)
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%.str END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_TREEVAR; $TREEVAR.str:=str END
*>
END;
