                                                  VAR length : INTEGER);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : LDMrules_RuleName
 *  Description     : 
 *  Parameters      : sg:LDMrules_SubgrammarIndex
