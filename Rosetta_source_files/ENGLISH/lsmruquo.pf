 *  Result         : BOOLEAN
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION LSMRUQUO_bigpronp(T:LSSTREE_pSTREE)
                    :BOOLEAN ;
EXTERNAL;


