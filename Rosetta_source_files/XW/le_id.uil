    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 80;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_id_skey);
      };
    };
  };
};

object le_id_mkey: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_id_skey;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Mkey: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 80;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_id_mkey);
      };
    };
  };
};

object le_id_comments : XmRowColumn {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_id_mkey;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNorientation    = XmVERTICAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Comments: ';
      };
    };
    XmScrolledText {
      arguments {
        arguments text_args;
        XmNeditMode     = XmMULTI_LINE_EDIT;
        XmNscrollHorizontal = false;
        XmNcolumns      = 80;
        XmNrows       = 3;
/*        XmNsensitive       = false;  becomes always insensitive! */
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget 
                    (X_le_id_comments);
      };
    };
  };
};
/*
object le_id_separator : XmSeparator {
  arguments {
    XmNleftAttachment  = XmATTACH_FORM;
    XmNrightAttachment   = XmATTACH_FORM;
    XmNtopAttachment   = XmATTACH_WIDGET;
    XmNtopWidget     = XmRowColumn le_id_comments;

    XmNleftOffset    = 0;
    XmNrightOffset     = 0;
    XmNmargin      = 0;
  };
};
*/
object le_id_button_box : XmRowColumn {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_id_comments;
    XmNbottomAttachment = XmATTACH_FORM; 
    XmNleftAttachment   = XmATTACH_FORM;
/*    XmNrightAttachment  = XmATTACH_FORM; */

    arguments button_box_args;
    XmNorientation    = XmHORIZONTAL;
  };
  controls {
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'OK';
      };
      callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_le_id_ok_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_id_ok_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Cancel';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_id_cancel_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_id_cancel_button);
         };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Select';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_id_select_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_id_select_button);
         };
    };
/*
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Help';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_id_help_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_id_help_button);
         };
    };
*/
  };
};

object le_id_deleted: XmLabel {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_id_comments;
    XmNbottomAttachment = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_WIDGET;
    XmNleftWidget        = XmRowColumn le_id_button_box;
    XmNrightAttachment  = XmATTACH_FORM; 
    arguments label_args;
    XmNfontList     = bigbold; 
    XmNlabelString  = '';
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget
           (X_le_id_deleted);
  };
};
 
