\newpage
\begin{verbatim}
% RULE RADVPsuperdeixis
< m1:ADVP{ADVPrec1}[mu1 ] 
>

< m :ADVP{ADVPrec2}[mu1 ]
>
   PARAMETERS
      <
       super: tiempotype
      >

      COMP
         <
          C1:ADVPrec1.supertiempo = omegatiempo AND
             super IN [presente, pasado]
          A1:ADVPrec2 := ADVPrec1;
             ADVPrec2.supertiempo := super;
         >
      DECOMP
         <
          C1: ADVPrec2.supertiempo IN [presente, pasado]
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.supertiempo := omegatiempo;
              super := ADVPrec2.supertiempo;
         >

&

\end{verbatim}
