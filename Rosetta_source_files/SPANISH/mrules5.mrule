\newpage
\begin{verbatim}
% RULE RSEactive2
< m1:I1::VERBPPROP{VERBPPROPrec1}
                           [mu6,
                            subjrel/EMPTYVAR{EMPTYVARrec1},
                            predrel/VERBP{VERBPrec1}
                                   [head/I2::VERB{VERBrec1}[mu1],
                                    mu2,
                                    I4:rel1/T1,
                                    mu3
                                   ],
                            mu4
                           ]
>

< m :I3::VERBPPROP{VERBPPROPrec2}
                           [mu6,
                            subjrel/EMPTYVAR{EMPTYVARrec1},
                            predrel/VERBP{VERBPrec1}
                                    [head/I2::VERB{VERBrec1}[mu1],
                                     mu2,
                                     I4:rel1/T1,
                                     mu3
                                    ],
                            mu4
                           ]
>


   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.voice = omegavoice
       I2: (VERBrec1.modo = omegamodo) AND
           (VERBrec1.reflexivity = notreflexive)
       I3: VERBPPROPrec2.voice = SEactive
       I4: rel1 IN [objrel, prepobjrel]
      >

<
   SUBRULE  (* 1a *)
      < T1: NPVAR{NPVARrec1} >
      < T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp120)
            C2: ((NPVARrec1.animate = YesAnimate) AND
                 (NPVARrec1.human = YesHuman)     AND
                 (NPVARrec1.generic = nogeneric))    OR
                ((NPVARrec1.NPhead = persproNP)   AND
                 (NPVARrec1.genero <> neutro))
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.voice := SEactive
          A1:  @
         >


   SUBRULE  (* 1b *)
      < T1: CNVAR{CNVARrec1} >
      < T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp120)
            C2: (CNVARrec1.animate = YesAnimate) AND
                (CNVARrec1.human = YesHuman)

                (* no test on "generic" since CNVAR doesn't have this 
                   attribute.                                        *)

            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.voice := SEactive
          A1:  @
         >


   SUBRULE  (* 2 *)
      < T1: EMPTYVAR{EMPTYVARrec2} >
      < T1: EMPTYVAR{EMPTYVARrec2} >


      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp120)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.voice := SEactive
         >

   SUBRULE  (* 3a *)
      < T1: VARPREPP{VARPREPPrec1}
                     [head/PREP{PREPrec1},
                      objrel/NPVAR{NPVARrec1}
                     ]
      >
      < T1: VARPREPP{VARPREPPrec1}
                     [head/PREP{PREPrec1},
                      objrel/NPVAR{NPVARrec1}
                     ]
      >

      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp120) AND
              (NPVARrec1.generic = nogeneric)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.voice := SEactive;
         >


   SUBRULE  (* 3b *)
      < T1: VARPREPP{VARPREPPrec1}
                     [head/PREP{PREPrec1},
                      objrel/CNVAR{CNVARrec1}
                     ]
      >
      < T1: VARPREPP{VARPREPPrec1}
                     [head/PREP{PREPrec1},
                      objrel/CNVAR{CNVARrec1}
                     ]
      >

      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp120)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.voice := SEactive;
         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* language:] Spanish
\item[* name:] RSEactive2
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] RC: VoiceRules
\item[* date of creation:] 02-FEBR-1988 11:00:00  
\item[* author:] Elly van Munster, Lisette Appelo
\item[* copied from:] Jan Odijk
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 30/1/89\ \ \ \ \ author: Elly van Munster\\
Condition on "Human" added in SEPassive.\\
In SEactive2 a condition added, such that PERSPRO's in objrel are admitted, too.
NB. Note that PERSPRO's cannot be tested on Human; only a test on genero, such 
that:\\
 - Hij wordt geslagen. admits SEactive2 ("hij" is non-neutro).\\
 - Het wordt geslagen. doesn't admit SEactive2 ("het" is neutro).\\
NB. Note that this is not correct in case of a text-translation: if "hij" is
non-Human, SEactive2 shouldn't apply, i.e. a PERSPRO should have a condition on
Human !
\end{enumerate}
\item date: 19/03/90\ \ \ \ \ author: Lisette Appelo\\
Added subrule 3a + b to account for cases as {\em se cuenta con el sistema} as
translation of {\em er wordt op het systeem gerekend}.
\item[* task:] To generate Active voice structures (with SE; "SEimpersonal").
{\em Transitive verbs with +animate/+human/nongeneric DO}. (NB.Cases where the 
preposition {\em a} occurs).\\
NB. In case the object is a PERSPRO no test on Human can be done, i.e. a 
sentence like "Se lo pega" can be a translation both of "Hij (human) wordt 
geslagen" and "Hij (non-human) wordt geslagen".\\
It cannot be a translation, however, of "Het wordt geslagen", since a test
is done on genero <> neutro.
Also with EMPTY object (eg. SE come).
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
1a/1b: NPVAR and CNVAR cannot collaps since CNVAR doesn't have the
attribute "generic", which in fact is needed in this rule. At the moment
of NP-substitution, a SE-active with a "generic" NP (from a CNVAR) will 
be filtered out.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[* relevant examples:] (SE) ve a Juan (SUBRULE 1).\\
\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \ \  (SE) come (SUBRULE 2).
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RSEactive3
< m1:I1::VERBPPROP{VERBPPROPrec1}
                           [I4:mu1,
                            predrel/VERBP{VERBPrec1}
                                   [head/I2::VERB{VERBrec1}[mu3],
                                    mu2,
                                    rel1/T1,
                                    mu5
                                   ],
                            mu4
                           ]
>

< m :I3::VERBPPROP{VERBPPROPrec2}
                           [I4:mu1,
                            predrel/VERBP{VERBPrec1}
                                   [head/I2::VERB{VERBrec1}[mu3],
                                    mu2,
                                    rel1/T1,
                                    mu5
                                   ],
                            mu4
                           ]
>


   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.voice = omegavoice
       I2: (VERBrec1.modo = omegamodo) AND
           (VERBrec1.reflexivity = notreflexive)
       I3: VERBPPROPrec2.voice = SEactive
       I4: NOT EXIST (mu1, [subjrel/..])
      >

<
   SUBRULE
      <T1: EMPTYVAR{EMPTYVARrec1} >
      <T1: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp010) AND
              rel1 = objrel
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.voice := SEactive
         >

   SUBRULE
      <T1:VARPREPP{VARPREPPrec1}
                  [sig1, objrel/EMPTYVAR{EMPTYVARrec1}] >
      <T1:VARPREPP{VARPREPPrec1}
                  [sig1, objrel/EMPTYVAR{EMPTYVARrec1}] >

      COMP
         <
          C1: (Active IN VERBrec1.possvoices) AND
              (VERBrec1.thetavp = vp010) AND
              rel1 = prepobjrel
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.voice := SEactive
         >
>
&

\end{verbatim}
