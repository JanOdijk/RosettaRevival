\newpage
\begin{verbatim}
% TRANSFORMATION TOblControl3a
                                 (* OPENNPROP, object control *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      complrel/OPENNPPROP{OPENNPPROPrec1}
                             [ subjrel/T2,
                               I1:rel1/NP{NPrec1}[mu4] 
                             ],
                      mu5 
                    ],
             mu6 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      predrel/NP{NPrec1}[mu4],
                      mu5 
                    ],
             mu6 
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [predrel, idrel]
      >

<
   SUBRULE (* 1 *)
      <
       T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: (NPVARrec1 = NPVARrec2) AND 
              ( OPENNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative]
		    PROsubject     : true
		   }
              )
              C11: (rel1 = predrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      }
                   )
              A11: @
              C12: (rel1 = idrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      }
                   )
              A12: @
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: true
              C11: true
              A11: OPENNPPROPrec1 :=
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      };
                   rel1 := predrel                  
              C12: true
              A12: OPENNPPROPrec1 :=
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      };
                   rel1 := idrel                  
          A1:  CLAUSErec1 := CLAUSErec2;
               NPVARrec2 := NPVARrec1;
               OPENNPPROPrec1 :=
		   { 
		    PROsubject     : true
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >


   SUBRULE (* 2 *)
      <
       T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: (CNVARrec1 = CNVARrec2) AND 
              ( OPENNPPROPrec1 =
		   { 
		    supertiempo    : omegatiempo
		    aktionsarts    : [stative]
		    PROsubject     : true
		   }
              )
              C11: (rel1 = predrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      }
                   )
              A11: @
              C12: (rel1 = idrel) AND
                   (OPENNPPROPrec1 =
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      }
                   )
              A12: @
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: true
              C11: true
              A11: OPENNPPROPrec1 :=
                      {
                       thetanp        : NPrec1.thetanp
		       nounpatternefs : NPrec1.nounpatternefs
                      };
                   rel1 := predrel                  
              C12: true
              A12: OPENNPPROPrec1 :=
                      {
                       thetanp        : Omegathetanp
		       nounpatternefs : []
                      };
                    rel1 := idrel              
          A1:  CLAUSErec1 := CLAUSErec2;
               CNVARrec2 := CNVARrec1;
               OPENNPPROPrec1 :=
		   { 
		    PROsubject     : true
                    aktionsarts    : [stative]
		   }
                 (* supertiempo retains default value *)
         >
>
&

\end{verbatim}
