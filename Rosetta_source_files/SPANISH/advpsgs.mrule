\newpage
\begin{verbatim}
% RULE RADVPCOMPARISONcomplmod  (* tan .. como Jan , tan  .. como en Madrid *)

< m1: ADVP{ADVPrec1}[head/ADV{ADVrec1}[mu1]]
  m2: T1
>

< m : ADVP{ADVPrec2}
                [head/ADV{ADVrec1}[mu1],
                 thanascomplrel/THANP{THANPrec1}
                       [head/THANAS(KEY_comothanaskey){THANASrec1},
                        I2:complrel/T2
                       ]
                ]

>


   MATCHCONDITIONS
      <m1: (ADVPrec1.thanas = comocompl)
       I2: T2.cat IN [NPVAR, CNVAR, ADVP, ADJP, PREPP]
       m2: T1.cat IN [NPVAR, CNVAR, ADVP, OPENADJPPROP, PREPP]
 
      >
<

    SUBRULE (* 1  ADVP *)
      <T1: ADVP{ADVPrec3}[mu2] >
      <T2: ADVP{ADVPrec4}[mu2] >

     COMP
         <
          C1: ADVPrec3.supertiempo = ADVPrec1.supertiempo
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec4 := ADVPrec3;
              ADVPrec4.supertiempo := omegatiempo;

         >
      DECOMP
         <
          C1: ADVPrec4.supertiempo = omegatiempo 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := comocompl;
              ADVPrec3 := ADVPrec4;
              ADVPrec3.supertiempo := ADVPrec1.supertiempo;

         >

    SUBRULE (* 2  ADJP *) (* 04-01-90;FJ *)  (* as ... as possible *)
      <T1: OPENADJPPROP{OPENADJPPROPrec3}
                  [subjrel/EMPTY(KEY_zeroemptykey){EMPTYrec1},
                   predrel/ADJP{ADJPrec3}[mu2] 
                  ]
      >

      <T2: ADJP{ADJPrec3}[mu2] >


     COMP
         <
          C1: OPENADJPPROPrec3.supertiempo = ADVPrec1.supertiempo
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.thanascompl := true;

         >
      DECOMP
         <
          C1: true
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := comocompl;
              OPENADJPPROPrec3 := COPYT_ADJPtoADJPPROP(ADJPrec3);
              OPENADJPPROPrec3.aktionsarts := [stative];
              OPENADJPPROPrec3.prosubject := true;
              OPENADJPPROPrec3.supertiempo := ADVPrec1.supertiempo;

         >

    SUBRULE (* 3 PREPP *)
      <T1: PREPP{PREPPrec1}[mu2] >
      <T2: PREPP{PREPPrec2}[mu2] >

     COMP
         <
          C1: PREPPrec1.supertiempo = ADVPrec1.supertiempo
          A1: ADVPrec2 := ADVPrec1;
              PREPPrec2 := PREPPrec1;
              PREPPrec2.supertiempo := omegatiempo;

         >
      DECOMP
         <
          C1: PREPPrec2.supertiempo = omegatiempo 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := comocompl;
              PREPPrec1 := PREPPrec2;
              PREPPrec1.supertiempo := ADVPrec1.supertiempo;

         >

    SUBRULE (* 4 NPVAR *)
      <T1: NPVAR{NPVARrec1}>
      <T2: NPVAR{NPVARrec2} >

     COMP
         <
          C1: NPVARrec1.cases = []
          A1: ADVPrec2 := ADVPrec1;
              NPVARrec2 := NPVARrec1;
         >
      DECOMP
         <
          C1: NPVARrec1.cases = []
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := comocompl;
              NPVARrec1 := NPVARrec2;

         >

    SUBRULE (* 5 CNVAR *)
      <T1: CNVAR{CNVARrec1} >
      <T2: CNVAR{CNVARrec2} >

     COMP
         <
          C1: CNVARrec1.cases = []
          A1: ADVPrec2 := ADVPrec1;
              CNVARrec2 := CNVARrec1;
         >
      DECOMP
         <
          C1: CNVARrec1.cases = []
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.thanas := comocompl;
              CNVARrec1 := CNVARrec2;

         >
>
&

