                [ mu1, 
                  I2:subjrel/T1,
                  mu3 
                ]
>

< m : I1::CLAUSE{CLAUSErec1}
                [ mu1, 
                  I2:subjrel/T1,
                  mu3 
                ]
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = infinite
       I2: ( T1.CAT IN [NPVAR] WITH T1.REC.mood IN [wh, relativexpmood])
           OR ( T1.CAT IN [CNVAR] )
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

