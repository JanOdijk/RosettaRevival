*ean+(B)+(A3) :: *éan(B)(A3) ;

*oan+(B)+(A3) :: *óan(B)(A3) ;


*a(MED1)an+(B)+(A3) :: *á(MED1)an(B)(A3) ;

*e(MED1)an+(B)+(A3) :: *é(MED1)an(B)(A3) ;

*i(MED1)an+(B)+(A3) :: *í(MED1)an(B)(A3) ;

