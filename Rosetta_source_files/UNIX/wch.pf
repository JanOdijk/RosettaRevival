pragma c_include ('language.pf' );
pragma c_include ('langdef.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

pragma c_include ('globdef.pf');
pragma c_include ('wchdef.h');

Package WCH;

With globdef;

pragma calling_convention (language.C);
pragma routine_aliasing_convention (RosLangDef.Rosetta_C_aliasing_conventions3);


(*MPT:::===================================================================*
 *
 *  Type name      : WIPC
 *  Description    : message queue id
 *
 *EMP:::===================================================================*)

type WIPC = loopholes.Address;

(*MPT:::===================================================================*
 *
 *  Type name      : WCH_msg_id
 *  Description    : Defines all message id's
 *
 *EMP:::===================================================================*)

type WCH_msg_id = integer;


(*MPT:::===================================================================*
 *
 *  Type name      : WCH_vt_id
 *  Description    : Defines all video modes
 *
 *EMP:::===================================================================*)


type WCH_vt_id = integer;



(*MPF:::===================================================================*
 *
 *  Function Name  : WCH_
 *  Description    : 
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *EMP:::===================================================================*)

Function WCH_get_boolean (
    var bool	: Boolean)
		: Boolean;
External;

Function WCH_get_id (
    var id	: integer)
		: Boolean;
External;

Function WCH_get_integer (
    var i	: integer)
		: Boolean;
External;

Function WCH_get_message_id (
    var msg_id	: WCH_msg_id)
		: Boolean;
External;

Function WCH_get_pstring (
    var s	: string;
        n_max   : integer)
		: Boolean;
External;

Function WCH_put_id (
	id	: integer)
		: Boolean;
External;

Function WCH_put_boolean (
	bool	: Boolean)
		: Boolean;
External;

Function WCH_put_integer (
	i	: integer)
		: Boolean;
External;

Function WCH_put_message_id (
	msg_id	: WCH_msg_id)
		: Boolean;
External;

Function WCH_put_pstring (
    const s	: string)
		: Boolean;
External;

Function WCH_receive (
	w	: WIPC)
		: Boolean;
External;

Function WCH_send (
	w	: WIPC)
		: Boolean;
External;


pragma calling_convention ();           (* switch off previous settings *)
pragma routine_aliasing_convention ();

END {PC};
