pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('surfcomlangspec.pf');

PACKAGE surfcomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     surfcomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   surfcomDECL_Surfrulemode = (loccond, globcond);
   surfcomDECL_psyntcat     = ^surfcomLANGSPEC_Category;
   surfcomDECL_syntcatset   = SET OF surfcomLANGSPEC_Category;
   surfcomDECL_nodeid         = HINIT..HFINAL;
   surfcomDECL_plonodeid      = ^surfcomDECL_lonodeid;
   surfcomDECL_lonodeid       = RECORD
   			          next: surfcomDECL_plonodeid;
   			          arg : surfcomDECL_nodeid
   	 	               END;
   surfcomDECL_pSnode       = ^surfcomDECL_Snode;
   surfcomDECL_pRsnode      = ^surfcomDECL_Rsnode;
   surfcomDECL_Rsnode       = RECORD
                                sonnumber:surfcomDECL_nodeid;
                                node    : surfcomDECL_pSnode;
                                brother : surfcomDECL_pRsnode
                             END;
   surfcomDECL_Snode        = RECORD
                                sonlist : surfcomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : surfcomLANGSPEC_Category;
                                ldfield : surfcomLANGSPEC_FieldDef
                             END;
   surfcomDECL_pLostree     = ^surfcomDECL_Lostree;
   surfcomDECL_Lostree      = RECORD
                                next    : surfcomDECL_pLostree;
                                arg     : surfcomDECL_pSnode
                             END;
   surfcomDECL_pConnectionnode
                           = ^surfcomDECL_Connectionnode;
   surfcomDECL_pSingleSegmList
                           = ^surfcomDECL_SingleSegmList;
   surfcomDECL_Connectionnode 
                           = RECORD
                                list    : surfcomDECL_pSingleSegmList;
                                next,
                                prev    : surfcomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   surfcomDECL_SingleSegmList
                           = RECORD
                                next    : surfcomDECL_pSingleSegmlist;
                                rn      : surfcomDECL_pConnectionnode;
                                stree   : surfcomDECL_pSnode
                             END;
   surfcomDECL_psurfgraph     = ^surfcomDECL_surfgraphtype;
   surfcomDECL_psurfgraphnode = ^surfcomDECL_surfgraphnode;
   surfcomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: surfcomDECL_psurfgraphnode
   		               END;
   surfcomDECL_plossurfgraphnode 
                             = ^surfcomDECL_lossurfgraphnode;
   surfcomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : surfcomDECL_plossurfgraphnode;
   			       END;
   surfcomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  surfcomDECL_plossurfgraphnode;
   				   arg  :  surfcomDECL_psurfgraphnode
   			       END;
   surfcomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: surfcomDECL_psurfgraphnode;
   			          n    : surfcomDECL_nodeid;
   			          cat  : surfcomDECL_psyntcat;
   			          nextnodes: surfcomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : surfcomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

