\begin{verbatim}
% TRANSFORMATION TVerbpattern1
< m1: VERBPPROP{VERBPPROPrec1}
               [ sig1,
                 predrel/VERBP{VERBPrec1}
                        [ head/VERB{VERBrec1}[mu1], 
                          argrel/T1
                        ]
               ] 
>

< m : VERBPPROP{VERBPPROPrec2}
               [ sig1,
                 predrel/VERBP{VERBPrec1}
                        [ head/VERB{VERBrec1}[mu1],
                          rel1/T1
                        ]
               ] 
>


<
   (* \'{El} pega a Juanita (vp120); Pedro vino (vp010) *)

   SUBRULE (*1*)
      <  >
      <  >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synNP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs:= [synNP];
                rel1:= objrel
          A1:  @
         >


   (* Pedro come x2 $\rightarrow$ Pedro come (vp120) *)

   SUBRULE (*2*)
      <T1: EMPTYVAR{EMPTYVARrec1} >
      <T1: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY];
              rel1 := objrel
         >


   (* (\'{E}l) considera [Pedro el mejor presidente] (vp120) *)

   SUBRULE (*3a*)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synCLOSEDNPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDNPPROP];
              rel1 := complrel
         >


   SUBRULE (*3b*)

   (* x1 sali\'{o} [x1 un c\'{e}lebre m\'{e}dico] (vp010) *) 

      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synOPENNPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENNPPROP];
              rel1 := complrel
         >


   (* Yo considero [Juan inteligente] (vp120);\\
      quedar(se) [Pedro ciego]; parece [Juan enfermo] (vp010) *)

   SUBRULE (*4*)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synCLOSEDADJPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDADJPPROP];
              rel1 := complrel
         >


   (* Esto es bueno (= dit smaakt lekker) (vp120) \\
      NB. esto sabe/huele bien (ADV; see 1,17)         *)

   SUBRULE (*5*)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synOPENADJPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADJPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENADJPPROP];
              rel1 := complrel
         >


(*!*)

   (* Esto cuesta cinco florines (vp120) *)

   SUBRULE (*6*)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synMEASUREPHRASE IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synMEASUREPHRASE];
              rel1 := complrel
         >


(*!*)
   (* <empty> parece como si est\'{a} enfermo (vp010) *)

   SUBRULE (*7*)
      <T1: SENTENCEVAR{SENTENCEVARrec1}>
      <T1: SENTENCEVAR{SENTENCEVARrec1}>

      COMP
         <
          C1: synCOMOCLOSEDADJPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1.adverbial = true AND
              (SENTENCEVARrec1.conjkey = KEY_'s_como_siCONJkey' OR
               SENTENCEVARrec1.conjkey = KEY_'s_como_queCONJkey')
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCOMOCLOSEDADJPPROP];
              rel1 := complrel
         >


   (* ik [hem uit de box] kreeg; vertaalprobleem! *)\\
   (* no example found yet for Spanish *)

   SUBRULE (*8a*)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec2} >

      COMP
         <
          C1: synLOCCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              PREPPPROPVARrec1.PROsubject = false AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: PREPPPROPVARrec2 := PREPPPROPVARrec1;
              PREPPPROPVARrec2.actsubcefs := [loc];
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCCLOSEDPREPPPROP];
              rel1 := locargrel
         >


   (* ik [hem daar] kreeg; vertaalprobleem! *)\\
   (* no example found yet for Spanish *)

   SUBRULE (*8b*)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec2} >

      COMP
         <
          C1: synLOCCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.PROsubject = false AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: ADVPPROPVARrec2 := ADVPPROPVARrec1;
              ADVPPROPVARrec1.actsubcefs := [Locadv];
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCCLOSEDPREPPPROP];
              rel1 := locargrel
         >


   (* ik [hem de box uit] kreeg; vertaalprobleem! *)
   (* no example found yet for Spanish *)

   SUBRULE (*9a*)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec2} >

      COMP
         <
          C1: synDIRCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              PREPPPROPVARrec1.PROsubject = false AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: PREPPPROPVARrec2 := PREPPPROPVARrec1;
              PREPPPROPVARrec2.actsubcefs := [dir];
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIRCLOSEDPREPPPROP];
              rel1 := dirargrel
         >


   (* ik [hem de box uit] kreeg; vertaalprobleem! *)
   (* no example found yet for Spanish *)

   SUBRULE (*9b*)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synDIRCLOSEDPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.PROsubject = false AND
              DirAdv IN ADVPPROPVARrec1.actsubcefs
          A1: ADVPPROPVARrec2 := ADVPPROPVARrec1;
              ADVPPROPVARrec1.actsubcefs := [DirAdv];
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIRCLOSEDPREPPPROP];
              rel1 := dirargrel
         >


   (* x1 vive [x1 en Amsterdam] (vp120) *)

   SUBRULE (*10a*)
      <T1:PREPPPROPVAR{PREPPPROPVARrec1}>
      <T1:PREPPPROPVAR{PREPPPROPVARrec1}>

      COMP
         <
          C1: synLOCOPENPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCOPENPREPPPROP];
              rel1 := locargrel
         >

   (* x1 vive [x1 aqui] (vp120) *)

   SUBRULE (*10b*)
      <T1:ADVPPROPVAR{ADVPPROPVARrec1}>
      <T1:ADVPPROPVAR{ADVPPROPVARrec1}>

      COMP
         <
          C1: synLOCOPENPREPPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCOPENPREPPPROP];
              rel1 := locargrel
         >


   (* x1 entra [x1 por la puerta] (vp120) *)

   SUBRULE (*11*)
      <  >
      <  >

      COMP
         <
          C1: T1.CAT IN [ PREPPPROPVAR,ADVPPROPVAR ]
            C2: synDIROPENPREPPPROP IN VERBrec1.synvps AND     
                VERBPPROPrec1.synvpefs = [] AND
                PREPPPROPVARrec1.PROsubject = true AND
                dir IN PREPPPROPVARrec1.actsubcefs
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDIROPENPREPPPROP];
                rel1 := dirargrel
          A1:  @
         >


   (* x1 tiene [los labios pintados] (vp120) *)

   SUBRULE (*12a*)
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >

      COMP
         <
          C1: synCLOSEDVERBPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              VERBPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDVERBPPROP];
              rel1 := complrel
         >


   SUBRULE (*12b*)
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >

      COMP
         <
          C1: synOPENVERBPPROP IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              VERBPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENVERBPPROP];
              rel1 := complrel
         >


   (* x1 quiere [x1 venir] (vp120) *)

   SUBRULE (*13a*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synOPENINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Infinitivo
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : inf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENINFSENT];
              rel1 := complrel
         >


   (* x1 tiene [que x1 venir] (vp120) *)

   SUBRULE (*13b*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synQUEOPENINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Infinitivo
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : queinf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synQUEOPENINFSENT];
              rel1 := complrel
         >


   (* x1 hay [que x1 venir] (vp010) *)

   SUBRULE (*13c*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synQUECLOSEDINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Infinitivo
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : queinf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synQUECLOSEDINFSENT];
              rel1 := complrel
         >


   (* x1 ve [Pedro venir] (vp120) *)

   SUBRULE (*14*)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synCLOSEDINFSENT IN VERBrec1.synvps AND
              VERBPPROPrec1.synvpefs = [] AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 modo        : Infinitivo
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : inf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDINFSENT];
              rel1 := complrel
         >


  (* 

       # x1 lamenta [el tener que partir]  (vp120) #


   SUBRULE #15#
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
