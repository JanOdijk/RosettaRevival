 *
 *EMP:::===================================================================*)


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE GLOBDEF;

   CONST

(*MPC:::===================================================================*
 *
 *  Constant name  : GLOBDEF_maxlogname
 *  Description    : Defines the maximum number of characters to be used for
 *                   logical name strings
 *
 *EMP:::===================================================================*)
       GLOBDEF_maxlogname  = 63;

(*MPC:::===================================================================*
 *
 *  Constant name  : GLOBDEF_maxwordchar
 *  Description    : Definition of the maximum number of characters to be
 *                   used in one word ( without blanks )
 *
 *EMP:::===================================================================*)
       GLOBDEF_maxwordchar = 50;

   TYPE

(*MPT:::===================================================================*
 *
 *  Type name      : GLOBDEF_status
 *  Description    : Definition of possible status values which can
 *                   be returned by operating system dependent functions
 *
 *EMP:::===================================================================*)
       GLOBDEF_status	= (successful, notsuccessful);
       
(*MPT:::===================================================================*
 *
 *  Type name      : GLOBDEF_yntype
 *  Description    : 
 *
 *EMP:::===================================================================*)
       GLOBDEF_yntype   = (GLOBDEF_yes, GLOBDEF_no);

(*MPT:::===================================================================*
 *
 *  Type name      : GLOBDEF_leveltype
 *  Description    : Definition of the interface levels of the Rosetta
 *                   system.
 *                 -1:alayout:0:amorph:1:sparser:2:mparser:3:atransfer:4:
 *                  4:gtransfer:5:mgenerator:6:linearizer:7:gmorph:8:glayout:9
 *EMP:::===================================================================*)
       GLOBDEF_leveltype = -1..9;

(*MPT:::===================================================================*
 *
 *  Type name      : GLOBDEF_AnGenMode
 *  Description    : Can be used for determining the current executable
 *
 *EMP:::===================================================================*)

TYPE
   GLOBDEF_AnGenMode = (anmode, genmode, controlmode);


(*MPT:::===================================================================*
 *
 *  Type name      : GLOBDEF_InteractionMode
 *  Description    : Determines whether the system runs in interactive mode
 *                   or not
 *
 *EMP:::===================================================================*)

TYPE
   GLOBDEF_InteractionMode = BOOLEAN;


(*MPF:::===================================================================*
 *
 *  Function Name  : GLOBDEF_GetAnGenMode
 *  Description    : Returns wether the current executable is ANALYSIS,
 *                   GENERATION or CONTROL
 *  Result         : GLOBDEF_AnGenMode
 *  Precondition   : GLOBDEF_SetAnGenMode has been called
 *
 *EMP:::===================================================================*)

FUNCTION GLOBDEF_GetAnGenMode: GLOBDEF_AnGenMode;
EXTERNAL;


(*MPP:::===================================================================*
 *
 *  Procedure Name : GLOBDEF_SetAnGenMode
 *  Description    : Sets the current executable: ANALYSIS,
 *                   GENERATION or CONTROL
 *  Parameters     : mode: GLOBDEF_AnGenMode
 *  Precondition   : true
 *
 *EMP:::===================================================================*)

PROCEDURE GLOBDEF_SetAnGenMode(mode: GLOBDEF_AnGenMode);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : GLOBDEF_GetInteractionMode
 *  Description    : Returns wether the current mode is interactive or
 *                   non interactive 
 *  Result         : BOOLEAN
 *  Precondition   : GLOBDEF_SetInteractionMode has been called
 *
 *EMP:::===================================================================*)

FUNCTION GLOBDEF_GetInteractionMode: BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : GLOBDEF_SetInteractionMode
 *  Description     : Sets the current interaction mode
 *
 *EMP:::===================================================================*)

PROCEDURE GLOBDEF_SetInteractionMode(i: BOOLEAN);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : GLOBDEF_GetBatchMode
 *  Description    : Returns wether the current mode is interactive or
 *                   non interactive 
 *  Result         : BOOLEAN
 *  Precondition   : GLOBDEF_SetBatchMode has been called
 *
 *EMP:::===================================================================*)

FUNCTION GLOBDEF_GetBatchMode: BOOLEAN;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : GLOBDEF_SetBatchMode
 *  Description     : Sets the current Batch mode
 *
 *EMP:::===================================================================*)

PROCEDURE GLOBDEF_SetBatchMode(i: BOOLEAN);
EXTERNAL;


(*MPP:::===================================================================*
 *
 *  Procedure Name  : GLOBDEF_SetSentenceID
 *  Description     : Sets the SentenceID of the current sentence.
 *  Parameters      : i: INTEGER
 *
 *EMP:::===================================================================*)

PROCEDURE GLOBDEF_SetSentenceID(i: INTEGER);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : GLOBDEF_GetSentenceID
 *  Description     : Gets the value of the SentenceID id of the current sentence
 *  Result          : INTEGER
 *
 *EMP:::===================================================================*)

FUNCTION GLOBDEF_GetSentenceID: INTEGER;
EXTERNAL;


END {GLOBDEF};
