\newpage
\begin{verbatim}
% TRANSFORMATION Ttempadvcheck
< m1:CLAUSE{CLAUSErec1}[mu1]
>

< m :CLAUSE{CLAUSErec1}[mu1]
>

   MATCHCONDITIONS
      <
       m1: (EXIST (mu1, [I14:auxrel/T4]))                               OR
          (                                                                 
          (
           ( EXIST(mu1, [I11:rel1/T1])     AND 
             CLAUSErec1.deixis <> omegadeixis    
           )                                          OR
           ( CLAUSErec1.deixis = omegadeixis    
           )
          )                                                     AND
           NOT EXIST(mu1, [I13:rel3/T3])  
          ) 
       m :(EXIST(mu1, [I14:auxrel/T4]))                                 OR
          (
          (
           ( EXIST(mu1, [I11:rel1/T1])     AND 
             CLAUSErec1.deixis <> omegadeixis    
           )                                          OR
           ( CLAUSErec1.deixis = omegadeixis     
           )
          )                                                     AND
           NOT EXIST(mu1, [I12:rel2/T2])  
          ) 


       I11: rel1 IN [tempadvrel, shiftrel]                 AND
            (T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCE]) 
       I12: rel2 IN [tempadvrel, shiftrel]                 AND
            ((T2.CAT IN [ADVP] 
               WITH T2.REC.temporal =true)   OR
             (T2.CAT IN [PREPP] 
               WITH T2.REC.actsubcefs * [temp] <> [])
            )
       I13: rel3 IN [tempadvrel, shiftrel]                 AND
            (T3.CAT IN [ADVP]
              WITH T3.REC.temporal = true)
       I14: T4.CAT IN [VERB] WITH T4.REC.subc = modalverb
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&
\end{verbatim}
