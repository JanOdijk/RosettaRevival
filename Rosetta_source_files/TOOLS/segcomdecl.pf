 FUNCTION SEGCOMDECL_MakeTerminal(s: SEGCOMLANGSPEC_Category;
                                            w: STRING_String): 
                                            SEGCOMDECL_pSnode; EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : SEGCOMDECL_MakeNonTerminal
 *  Description    : 
 *  Parameters     : 
 *  Result         :  
