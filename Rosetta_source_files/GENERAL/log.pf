(*MPD:::===================================================================*
 *
 *  Rosetta Project                                                 
 *                                                                  
 *  Module Title    : LOG 
 *  Creation date   :                                               
 *  Author          : J. Rous
 *                                                                  
 *  Copyright (c) 1985, by Nederlandse Philips Bedrijven BV.        
 *                                                                  
 *  Remarks         : This module provides a number of functions for error-
 *                    logging purposes. It should be used to give error messages
 *                    that might be useful for the designers of the system in
 *                    case of a system failure, e.g. files that could not
 *                    be opened or closed.
 *
 *   15-AUG-1986    : Adapted to the new module Files by Carel Fellinger
 *                    It is now possible to have one log-file in use by
 *                    several programs at the same time. This enables that
 *                    the log-remarks of analysis, generation and control
 *                    are written into one file in the right order!
 *
 *EMP:::===================================================================*)

pragma C_Include('strings.pf');
pragma C_Include('globdef.pf');
pragma C_Include('files.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LOG;
WITH GLOBDEF, FILES, STRINGS;


(*MPF:::===================================================================*
 *
 *  PROCEDURE Name    : LOG_open 
 *  Description      : Initializes LOG module. Creates a new logfile for the
 *                     system.
 *                     !!Operating system dependent procedure!!
 *  Parameters       : name,len : name[1..len] is the filename of the log-file
 *                     create: specifies whether new file must be created, or
 *                             old one must be used.
 *  Precondition     : Nothing of module LOG has been used.
 *  Postcondition    : LOG file has been created and LOG functions are
 *                     available.
 *
 *EMP:::===================================================================*)

PROCEDURE LOG_open( CONST name: STRING;
                          len: Files_NameRange;
                           create: GLOBDEF_yntype);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LOG_write
 *  Description     : Writes to logfile.
 *  Parameters      : STR,len : STR[1..len] is the string of text containing a
 *                              comment
 *                    STATUS: status value to be written to the file
 *  Precondition    : LOG_init has been called by the system (not necessarily
 *                    by this executable ).
 *  Postcondition   : String and status-value have been written to logfile.
 *
 *EMP:::===================================================================*)

PROCEDURE LOG_write(CONST str: STRING;
                               len: Files_IORange;
                               status: integer);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LOG_close
 *  Description     : Closes logfile. 
 *  Parameters      : none
 *  Precondition    : LOG file has been opened
 *  Postcondition   : LOG file has been closed
 *
 *EMP:::===================================================================*)

PROCEDURE LOG_close;
EXTERNAL;

END {LOG};
