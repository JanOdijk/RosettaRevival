% RULE RCNmodposs3     

< m1: CN{CNrec1}[I1:mu1]

  m2: NP{NPrec1}[mu2, head/T1]
>

< m : CN{CNrec1}[I1:mu1,
                 posrel/I2::NP{NPrec2}[mu2, head/T1]
                ]
>

   MATCHCONDITIONS
      <I1: ( EXIST (mu1,[head/NOUN{NOUNrec1}[mu7]]) ) AND
           ( NOT EXIST (mu1,[posrel/T2]) )
        m2: NPrec1.generic = nogeneric AND
            NPrec1.cases = [] 
        I2: NPrec2.generic = omegageneric AND
            NPrec2.cases = [] 
      >


<
(* 1 *)
SUBRULE               (* book my father *)   
<T1: CN{CNrec2}[mu3]>
<T1: CN{CNrec2}[mu3]>


      COMP
         <
          C1: NPrec1.superdeixis = CNrec1.superdeixis AND
              NPrec1.poss = true
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
         >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis AND
              NPrec2.poss = true
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := CNrec1.superdeixis;
              NPrec1.generic:= nogeneric;
         >

