\begin{verbatim}
%
%SUBGRAMMAR IdentPropFormation

(* Lowest rule number available: 12. Please update rigourously! *)


  (* RC_StartIdentificational *)
( RDemproIdentSg/1   | RDemproIdentPl/2   | 
  RDemproWhIdentSg/3 | RDemproWhIdentPl/4 | 
  RPersproIdent/5    | RSentIdent/6 )
.
  (* RC_IdentTempVarInsertion *)
  (* RC_IdentSentAdvVarInsertion *)
  (* RC_IdentLocAdvVarInsertion *)
{ RIdentRefVarInsert/7  | RIdentSentadvVar/10 | 
  RIdentConjsentVar/11  | RIdentFinalConjsentVar/12 |
  RIdentLocAdvVar/8     | RIdentLocPreppVar/9 }

HEAD:
<
NPVAR         BASIC EXPRESSION
SENTENCEVAR   BASIC EXPRESSION
>

(* IMPORT: *)
<
 1: < ARGUMENT 2    NP            FROM (NPFormation)       
    >
 2: < ARGUMENT 2    NP            FROM (NPFormation)       
    >
 3: < ARGUMENT 2    NP            FROM (NPFormation)       
    >
 4: < ARGUMENT 2    NP            FROM (NPFormation)       
    >
 5: < ARGUMENT 2    NPVAR         BASIC EXPRESSION         
    >
 6: < ARGUMENT 2    NPVAR         BASIC EXPRESSION  
    >
 7: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION         
      ARGUMENT 2    ADVPVAR       BASIC EXPRESSION         
      ARGUMENT 2    SENTENCEVAR   BASIC EXPRESSION         
    >
 8: < ARGUMENT 2    ADVPVAR       BASIC EXPRESSION         
    >
 9: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION         
    >
10: < ARGUMENT 2    ADVPVAR       BASIC EXPRESSION         
      ARGUMENT 2    PREPPVAR      BASIC EXPRESSION         
    >
11: < ARGUMENT 2    SENTENCEVAR   BASIC EXPRESSION         
      ARGUMENT 2    PREPPVAR      BASIC EXPRESSION         
    >
12: < ARGUMENT 2    SENTENCEVAR   BASIC EXPRESSION         
      ARGUMENT 2    PREPPVAR      BASIC EXPRESSION         
    >
>

EXPORT:
<
NPPROP
>

&
\end{verbatim}
\newpage
\begin{verbatim}

% RULE RDemproIdentSg
< m1: I3::NPVAR{NPVARrec1}
  m2: I1::NP{NPrec1}[mu1]
>

< m : NPPROP{NPPROPrec1}
            [ subjrel/I2::NP{NPrec2}[mu1],
              idrel/I3::NPVAR{NPVARrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: NPrec1.NPhead IN [itNP, thisNP, thatNP] AND
           NPrec1.number = singular 
       I2: NPrec2.NPhead IN [itNP, thisNP, thatNP] AND
           NPrec2.number = singular
       I3: NPVARrec1.NPhead <> whatwhproNP
      >

      COMP
         <
          C1: ( NPVARrec1.number = singular OR
                ( NPVARrec1.number = plural AND 
                  NPVARrec1.NPhead = persproNP) ) AND
              NPrec1.superdeixis = presentdeixis AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of NPPROP remains default *)
         >
      DECOMP
         <
          C1: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts] AND
              NPPROPrec1.aktionsarts = [stative] AND
              ( NPVARrec1.number = singular OR
                ( NPVARrec1.number = plural AND
                  NPVARrec1.NPhead = persproNP ) ) AND
              NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
          A1: NPrec1 := NPrec2;
              NPrec1.generic := nogeneric;
              NPrec1.superdeixis := presentdeixis
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RDemproIdentSg
\item[* relevant examples:] \mbox{}\\
1. It/This/That is my brother\\
2. ?That was his shutting the door\\
3. It/This/That is me/us/?them\\
4. That is that\\
5. That is who (sg)?\\
(reciproNP and reflNP won't occur as input)
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] IdentPropFormation
\item[* class:] (name of rule, transformation or filter class) RC\_
StartIdentificational
\item[* date of creation:] 16-JUN-1988 13:40:29  
\item[* author:] margreet sanders
\item[* copied from:] Dutch RIdentFormation1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to make a propositional structure out of a (third person) 
singular NPVAR. For PERSPROs, the NPVAR may also be plural ($^{*}$These are us; 
This is us).
\item[\ \ strategy:] (also: deviations from accepted proposals) The rule only 
works for singular NPVARs, since the basic expressions it/this/that can be 
mapped onto the Dutch basic expressions het/dit/dat, but the plural forms 
they/these/those cannot be mapped onto the singular Dutch forms without causing 
many ambiguities (Dutch only recognises a singular form of het/dit/dat as 
basic expression). It is assumed that {\em who/wie\/} is entered in the 
dictionary at least twice, one for singular reference and one for plural.
\item[\ \ rejected alternatives:] To distinguish a singular and a plural het/
dit/dat in Dutch. This is impossible because with other verbs than {\em zijn\/}
, het/dit/dat never behaves as a plural: $^{*}$dit bewijzen niets, $^{*}$Wat 
bewijzen dat?
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: 03-02-89: margreet sanders:\\
The rule has been modified to take only presentdeixis nogeneric NPs as input, 
and modify them to omega values. For comment, see Dutch 
RC\_StartIdentificational.mrule. Also, the Aktionsarts of the NPPROP is set to 
stative.
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RDemproIdentPl
< m1: I3::NPVAR{NPVARrec1}
  m2: I1::NP{NPrec1}[mu1]
>

< m : I4::NPPROP{NPPROPrec1}
                [ subjrel/I2::NP{NPrec2}[mu2],
                  idrel/I3::NPVAR{NPVARrec1}
                ]
>

   MATCHCONDITIONS
      <
       I1: NPrec1.NPhead IN [itNP, thisNP, thatNP] AND
           NPrec1.number = singular
       I2: NPrec2.NPhead IN [theyNP, theseNP, thoseNP] AND
           NPrec2.number = plural
       I3: NPVARrec1.NPhead <> whatwhproNP AND
           NPVARrec1.number = plural AND 
           NPVARrec1.NPhead <>  persproNP
       I4: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts] AND
           NPPROPrec1.aktionsarts = [stative]
      >

<
   SUBRULE (* 1. itNP *)
      < mu1: [head/PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(AUX_itBPERSPROkey){BPERSPROrec1}]
             ] >
      < mu2: [head/PERSPRO{PERSPROrec2}
                  [head/BPERSPRO(AUX_theyBPRSPRkey){BPERSPROrec2}]
             ] >

      COMP
         <
          C1: NPrec1 = AUX_NPONitPRSPR EXCEPT FOR 
                               [superdeixis, generic] AND
              NPrec1.superdeixis = presentdeixis AND
              NPrec1.generic = nogeneric AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = omegacase
          A1: NPrec2 := AUX_NPONtheyPRSPR;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative];
              (* rest of npprop remains default *)
              PERSPROrec2 := COPYT_bpersproTOperspro(BPERSPROrec2)
              (* persprocase remains default *)
         > 
      DECOMP
         <
          C1: NPrec2 = AUX_NPONtheyPRSPR EXCEPT FOR 
                              [superdeixis, aktionsarts] AND
              NPrec2.superdeixis = omegadeixis AND
              NPrec2.generic = omegageneric AND
              PERSPROrec2 = COPYT_bpersproTOperspro(BPERSPROrec2) AND
              PERSPROrec2.persprocase = omegacase
          A1: NPrec1 := AUX_NPONitPRSPR;
              NPrec1.superdeixis := presentdeixis;
              NPrec1.generic := nogeneric;
              PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1)
              (* other values remain default *)
         >

   SUBRULE (* 2. thisNP *)
      < mu1: [head/DEMPRO(AUX_thisDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(AUX_theseDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONthisDMPR EXCEPT FOR
                         [superdeixis, generic] AND
              NPrec1.superdeixis = presentdeixis AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := AUX_NPONtheseDMPR;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >
      DECOMP
         <
          C1: NPrec2 = AUX_NPONtheseDMPR EXCEPT FOR
                          [superdeixis, generic] AND
              NPrec2.superdeixis = omegadeixis AND
              NPrec2.generic = omegageneric
          A1: NPrec1 := AUX_NPONthisDMPR;
              NPrec1.superdeixis := presentdeixis;
              NPrec1.generic := nogeneric
         >

   SUBRULE (* 3. thatNP *)
      < mu1: [head/DEMPRO(AUX_thatDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(AUX_thoseDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONthatDMPR EXCEPT FOR
                        [superdeixis, generic] AND
              NPrec1.superdeixis = presentdeixis AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := AUX_NPONthoseDMPR;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >
      DECOMP
         <
          C1: NPrec2 = AUX_NPONthoseDMPR EXCEPT FOR
                          [superdeixis, generic] AND
              NPrec2.superdeixis = omegadeixis AND
              NPrec2.generic = omegageneric 
          A1: NPrec1 := AUX_NPONthatDMPR;
              NPrec1.superdeixis := presentdeixis;
              NPrec1.generic := nogeneric
         >
>
&

\end{verbatim}
