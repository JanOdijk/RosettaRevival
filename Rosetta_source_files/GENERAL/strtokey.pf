pragma C_include('string.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE StrToKey;
WITH STRNG;

PROCEDURE StrToKey_OpenSkeyRead;
EXTERNAL;
PROCEDURE StrToKey_OpenSkeyWrite;
EXTERNAL;
PROCEDURE StrToKey_OpenSkeyUpdate;
EXTERNAL;
FUNCTION StrToKey_GetSkey(strkey: STRING_String;
                                   VAR intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_GetSkeyNR(strkey: STRING_String;
                                   VAR intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_GetSkeyHash(strkey: STRING_String;
                                   VAR intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_GetSkeyStr(intkey: INTEGER;
                                        VAR strkey: STRING_String): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_PutSkey(strkey: STRING_String;
                                   intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_GetHighestSkey(var skey: integer): boolean;
EXTERNAL;
PROCEDURE StrToKey_Release;
EXTERNAL;
PROCEDURE StrToKey_CloseSkey;
EXTERNAL;
FUNCTION StrToKey_GetFkey(strkey: STRING_String;
                                   VAR intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_PutFkey(strkey: STRING_String;
                                   intkey: INTEGER): BOOLEAN;
EXTERNAL;
PROCEDURE StrToKey_OpenMkeyRead;
EXTERNAL;
PROCEDURE StrToKey_OpenMkeyWrite;
EXTERNAL;
PROCEDURE StrToKey_OpenMkeyUpdate;
EXTERNAL;
FUNCTION StrToKey_GetMkey(strkey: STRING_String;
                                   VAR intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_GetMkeyStr(intkey: INTEGER;
                                        VAR strkey: STRING_String): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_PutMkey(strkey: STRING_String;
                                   intkey: INTEGER): BOOLEAN;
EXTERNAL;
FUNCTION StrToKey_GetHighestMkey(var Mkey: integer): boolean;
EXTERNAL;
PROCEDURE StrToKey_CloseMkey;
EXTERNAL;
END {StrToKey};
