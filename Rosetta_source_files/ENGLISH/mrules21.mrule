\newpage
\begin{verbatim}
% TRANSFORMATION TExtrapWhShift
< m1: CLAUSE{CLAUSErec1}
            [ I1:mu2,
              extraposrel/I2::SENTENCE{SENTENCErec1}
                         [ I3:shiftrel/T1,
                           I4:mu3
                         ]
             ] 
>

< m : CLAUSE{CLAUSErec1}
            [ I3:shiftrel/T1,
              I1:mu2,
              extraposrel/I2::SENTENCE{SENTENCErec1}
                         [ I4:mu3 ]
            ] 
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11:rel1/..])
       I2: SENTENCErec1.mood = declarative
       I3: (T1.CAT IN [PREPP, VARPREPP, PREPPVAR, ADJP, ADVP, 
                       ADVPVAR, NPVAR]
               WITH T1.REC.mood IN [wh, relativexpmood, topicmood]) OR
           (T1.CAT IN [CNVAR])                                             OR
           ((T1.CAT IN [NP])          AND
            (QUOTE_VARinNP(T1))
           )
       I4: NOT EXIST (mu3, [I11:rel1/..])
         I11: rel1 IN [shiftrel, leftdislocrel]
      >


<
   SUBRULE (* 1 *)
      <T1: T2 >
      <T1: T2 >

   MATCHCONDITIONS
      <
       T1: (T2.CAT IN [PREPP, VARPREPP, PREPPVAR, ADJP, ADVP, 
                       ADVPVAR, NPVAR]
               WITH T2.REC.mood IN [wh, relativexpmood, topicmood]) OR
           (T2.CAT IN [CNVAR])
      >


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2 *)
      <T1: NP{NPrec1}[mu5, I6:detrel/T3, mu4] >
      <T1: NP{NPrec1}[mu5, I6:detrel/T3, mu4]  >

   MATCHCONDITIONS
      <
       I6: (T3.CAT IN [NPVAR]
                    WITH T3.REC.mood IN [wh, topicmood, relativexpmood]) OR
           (T2.CAT IN [CNVAR])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
