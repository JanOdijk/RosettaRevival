\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RSentNegSubst        (* sentadvrel/NEG *)
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              negrel/NEGVAR{NEGVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4  
            ] 

  m2: T1=NEG(KEY_notNEGkey){NEGrec1}
>

< m : CLAUSE{CLAUSErec2}
            [ mu1,
              negrel/NEG(KEY_notNEGkey){NEGrec1},
              mu2,
              predrel/VERBP{VERBPrec1}[mu3],
              mu4  
            ] 
>

   MATCHCONDITIONS
      <
       m2 : QUOTE_gsubstordercondition(mu2, mu3, mu4, T1, CLAUSErec1.prosubject) 
       m  : QUOTE_substordercondition(mu2, mu3, mu4, CLAUSErec2.prosubject)  
      >

      COMP
         <
          C1: CLAUSErec1.aktionsarts * 
              [activity, accomplishment,stative, achievement, dynstative] <> []
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aktionsarts := [stative]
         >

      DECOMP
         <
          C1: true
            C11: CLAUSErec2.aktionsarts = [stative]
            A11: CLAUSErec1 := CLAUSErec2;
            C12: stative IN CLAUSErec2.aktionsarts
            A12: CLAUSErec1 := CLAUSErec2;
                 CLAUSErec1.aktionsarts :=
                       CLAUSErec2.aktionsarts - [stative] 
          A1: @
         >
&

\end{verbatim}
