                              ]
                       ]
>

< m : ADJPPROP{ADJPPROPrec2}
         [mu1,
          predrel/ADJP{ADJPrec2}
                  [complrel/SENTENCEVAR{SENTENCEVARrec1},
                   head/ADJ{ADJrec1}[mu2]
                  ]
         ]
>

      COMP
         <
          C1: (ADJrec1.adjpatterns * [synOPENTOINFSENTPROOBJ] <> [])   AND
              (ADJPPROPrec1.adjpatternefs = []) AND
              (SENTENCEVARrec1 = { PROsubject  : true
                                   finiteness  : infinite
                                   mood        : whmod
                                   senttype    : subordinateclause
                                  }
              )

             C11: (synOPENTOINFSENTPROOBJ IN ADJrec1.adjpatterns) AND
                  (SENTENCEVARrec1 = { 
                                      infsort     : omteinf
                                      }
                   )
             A11: ADJPPROPrec2 := ADJPPROPrec1;
                  ADJPPROPrec2.adjpatternefs := [synOPENTOINFSENTPROOBJ]


          A1: @
 
         >

      DECOMP
         <
          C1: (ADJrec1.adjpatterns * [synOPENTOINFSENTPROOBJ]  <> [])    AND
              (SENTENCEVARrec1 = { 
                                   senttype  : subordinateclause
                                   PROsubject  : true                    
                                   finiteness  : infinite
                                   mood        : whmod
                                  }
              )

              C11: (synOPENTOINFSENTPROOBJ IN ADJrec1.adjpatterns) AND
                   (synOPENTOINFSENTPROOBJ IN ADJPrec2.adjpatternefs)  AND
                   (synOPENTOINFSENTPROOBJ IN ADJPPROPrec2.adjpatternefs) 
                    AND
