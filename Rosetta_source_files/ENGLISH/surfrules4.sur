      auxfound           ::: BOOLEAN;
      classesvar         :: classSETtype;
      conjaspectvar      :: aspecttype;
      conjclassvar       :: timeadvclasstype;
      CONJconjfound      :: BOOLEAN;
      conjdeixisvar      :: deixistype;
      conjfound          ::: BOOLEAN;
      conjkeyvar         :: keytype;
      conjpatternsvar    :: synpatternEFFSETtype;
      conjretrovar       :: retrotype;
      deixisvar          :: deixistype;
      deixisvarvar       :: deixistype;
      dirargrelfound     :: BOOLEAN;
      envvar             :: polarityEFFSETtype;
      extraposfound      :: BOOLEAN;
      extraposinfsortvar :: inftype;
      extraposmoodvar    :: moodtype;
      extraposmodusvar   :: modustype;
      extraposok         ::: BOOLEAN;
      extraposprosubjectvar :: prosubjecttype;
      finalpuncfound     :: BOOLEAN;
      finitenessvar      :: finitenesstype;
      finitenessvarvar   :: finitenesstype;
      gensubjfound       :: BOOLEAN;
      indobjrelfound     :: BOOLEAN;
      infdoinconjfound   ::: BOOLEAN;
      infsortreset       :: BOOLEAN;
      infsortvar         :: inftype;
      infsortvarvar      :: inftype;
      inversfound        ::: BOOLEAN;
      leftdislocfound    ::: BOOLEAN;
      letinconjfound     ::: BOOLEAN;
      letusgluefound     ::: BOOLEAN;
      locargrelfound     ::  BOOLEAN;
      modusvar           :: modustype;
      modusvarvar        :: modustype;
      moodvar            :: moodtype;
      negfound           ::: BOOLEAN;
      nomsubjfound       :: BOOLEAN;
      notinauxfound      ::: BOOLEAN;
      npinshiftfound     :: BOOLEAN;
      nppredrelfound     ::  BOOLEAN;
      objrelfound        :: BOOLEAN;
      onlyaccsubjfound   :: BOOLEAN; 
      onlynomsubjfound   :: BOOLEAN; 
      particlekey        :: keytype;
      prepkeyvar1        :: keytype;
      prepkeyvar2        :: keytype;
      prepobjrelfound    :: BOOLEAN;
      prepobj2relfound   :: BOOLEAN;
      preppinshiftfound  :: BOOLEAN;
      prepppredrelfound  :: BOOLEAN;
      prosubjectvar      :: BOOLEAN;
      RELPROfound        ::: BOOLEAN;
      reqvar             :: polarityEFFSETtype;
      scomplrelfound     :: BOOLEAN;
      senttypevar        :: senttypetype;
      shiftcases         :: casesettype;
      shiftfound         ::: BOOLEAN;
      shiftnumbervar     ::: numbertype;
      shiftpersonvar     :: persontype;
      shiftsexes         :: sexSETtype;
      shiftxpmoodvar     :: xpmoodtype;
      Sinldlfound        :: BOOLEAN;
      strandedrelfound   :: BOOLEAN;
      subjNPhead         :: NPheadtype;
      subjnumbervar      ::: numbertype;
      subjpersonvar      ::: persontype;
      subjfound          ::: BOOLEAN;
      synvpefsvar        ::: synpatternEFFsettype;
      temporalvar        :: BOOLEAN;
      tensevar           :: tensetype;
      therenpfound       ::: BOOLEAN;
      thetavpvar         :: thetavptype;
      tofound            ::: BOOLEAN;
      VERBconjfound      ::: BOOLEAN;
      verbpersonsvar     ::: personSETtype;
      verbnumbersvar     ::: numberSETtype;
