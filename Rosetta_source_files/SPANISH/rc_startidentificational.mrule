\newpage
\begin{verbatim}
% RULE RDemproWhIdentSg
< m1: I3::NPVAR{NPVARrec1}
  m2: I1::NP{NPrec1}[mu1]
>

< m : NPPROP{NPPROPrec1}
            [ subjrel/I2::NP{NPrec2}[mu1],
              idrel/I3::NPVAR{NPVARrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: NPrec1.NPhead IN [esteNP, eseNP, aquelNP, redelloNP] AND
           NPrec1.numero = singular
       I2: NPrec2.NPhead IN [esteNP, eseNP, aquelNP, redelloNP] AND
           NPrec2.numero = singular
       I3: NPVARrec1.NPhead IN [quewhproNP] AND
           NPVARrec1.numero = singular
      >

      COMP
         <
          C1: NPrec1.supertiempo = presente AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of NPPROP remains default *)
         >
&

\end{verbatim}
