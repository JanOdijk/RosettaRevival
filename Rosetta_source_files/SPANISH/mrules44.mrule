\begin{verbatim}
% RULE Rfinpastfutsuperdeixis
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu4],
                    mu3
                   ],
            mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec2}[mu4],
                    mu3
                   ],
            mu5
           ] 

>

<

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (ADVPVARrec1.class = reference) AND
           (ADVPVARrec1.retro = false) AND
           (ADVPVARrec1.tiempo = futuro)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (ADVPVARrec1.tiempo = omegatiempo ->
               CLAUSErec1.retro = false)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (ADVPVARrec1.tiempo = omegatiempo ->
               CLAUSErec2.retro = false)
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (PREPPVARrec1.class = reference) AND
           (PREPPVARrec1.retro = false) AND
           (PREPPVARrec1.tiempo = futuro)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (PREPPVARrec1.tiempo = omegatiempo ->
               CLAUSErec1.retro = false)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (PREPPVARrec1.tiempo = omegatiempo ->
               CLAUSErec2.retro = false)
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;

         >

   SUBRULE
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>
      <mu5: [I1: mu6, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], I3: mu7]>

   MATCHCONDITIONS
      <
       I1: QUOTE_temprefnotfound(mu6)
       I2: (SENTENCErec1.conjclass = reference) AND
           (SENTENCErec1.conjretro = false) AND
           (SENTENCErec1.conjtiempo = futuro) AND
           (SENTENCErec1.temporal = true)
       I3: QUOTE_temprefnotfound(mu7)
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (SENTENCErec1.conjtiempo = omegatiempo ->
               CLAUSErec1.retro = false)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (SENTENCErec1.conjtiempo = omegatiempo ->
               CLAUSErec2.retro = false)
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;

         >

   SUBRULE
      <mu5: [I1: mu6]>
      <mu5: [I1: mu6]>

   MATCHCONDITIONS
      <
       I1: (QUOTE_temprefnotfound(mu6)) AND
           (NOT QUOTE_tempdurnotfound(mu6))
      >

      COMP
         <
          C1:( 
              (CLAUSErec1.tiempo = omegatiempo) AND
              (VERBrec1.tiempo = omegatiempo) AND
              (VERBrec1.futuro = nofuturo) AND
              (VERBrec1.aspecto = omegaaspecto) AND
              (CLAUSErec1.finiteness = finite) AND
              (CLAUSErec1.aspecto = perfectivo) AND
              (CLAUSErec1.retro = false)
             )

             C11:(CLAUSErec1.supertiempo = omegatiempo)
             A11:CLAUSErec2 := CLAUSErec1;
                 CLAUSErec2.supertiempo := pasado;
             

          A1: VERBrec2 := VERBrec1;
              VERBrec2.tiempo := pasado;
              VERBrec2.futuro := sifuturo;

         >
      DECOMP
         <
          C1:(
              (VERBrec2.tiempo = pasado) AND
              (VERBrec2.futuro = sifuturo) AND
              (VERBrec2.aspecto = omegaaspecto) AND
              (CLAUSErec2.finiteness = finite) AND
              (CLAUSErec2.tiempo = omegatiempo) AND
              (CLAUSErec2.aspecto = perfectivo) AND
              (CLAUSErec2.retro = false)
             )
              C11: (CLAUSErec2.supertiempo = pasado)
              A11: CLAUSErec1 := CLAUSErec2;
                   CLAUSErec1.supertiempo := omegatiempo;

 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.tiempo := omegatiempo;
              VERBrec1.futuro := nofuturo;
         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rfinpastfutsuperdeixis
\item[* relevant examples:] ella dijo (que Juan dormir\'{i}a ma\~{n}ana)
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] superdeixis rules
\item[* date of creation:] 30-SEP-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Rfinpresfutsuperdeixis 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 26/06/89\ \ \ \ \ author: Lisette Appelo\\
Added subrule 4 for absence reference, presence duration adverbial.\\
added conditions on combination of omega adverbail with retro aspect. 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST, but Rs 
has been `shifted' to the future.
               This rule is for a finite dependent clause.
               The most left verb in the clause gets a past future tense.
               The deixis 
value of the possible reference adverbial is checked for 
               future
               The clause is marked for past superdeixis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] The splitting into
subrules corresponds to the different categories of the variables for the 
reference adverbials.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: finiteness transformations, rules that introduce the 
reference adverbial \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages: In Dutch future adverbials are marked omega, because 
they do not have to agree with future tense as in Spanish and English.\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: \\
\end{enumerate}
\end{description}

