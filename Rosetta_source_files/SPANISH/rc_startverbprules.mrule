\newpage
\begin{verbatim}

%RULE RSTARTVPPROP010a

<m1: I1::SUBVERB{SUBVERBrec1}[mu1]
 m2: T1
>
<m: I3::VERBPPROP{VERBPPROPrec1}
                 [ predrel/VERBP{VERBPrec1}
                          [ head/I4::VERB{VERBrec1}
                                [head/I1::SUBVERB{SUBVERBrec1}[mu1]],
                            I2:argrel/T1
                          ]
                 ]
>

   MATCHCONDITIONS
      <
       I1: (SUBVERBrec1.thetavp = vp010 )            AND
           ( (SUBVERBrec1.CaseAssigner =  false)  OR 
             (SUBVERBrec1.reflexivity = reflexive) 
           )
       I2: T1.CAT IN AUX_VARCATSET
       m2: T1.CAT IN AUX_VARCATSET
       I3: VERBPPROPrec1 =
		  { 
                   thetavp     : vp010
		   req         : [pospol, negpol, omegapol]
		   env         : [pospol, negpol, omegapol]
		   supertiempo : omegatiempo
		   PROsubject  : false
		   voice       : omegavoice
		   synvpefs    : []
		   aktionsarts : []
		  }
       I4: VERBrec1 =
		  {
		   numero       : omeganumero  
		   persona      : 3
                   genero       : omegagenero
		   modo         : omegamodo
		   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
		   status       : bareV
                   foundauxes   : []
		  }
      >


COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
       (* all other attributes retain their default value *)
       VERBPPROPrec1.thetavp := vp010
       (* all other attributes retain their default value *)
 >
&


\end{verbatim}
