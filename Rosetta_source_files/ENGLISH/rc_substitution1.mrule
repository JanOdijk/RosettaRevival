\begin{verbatim}
% RULE RPROsentSubst    
< m1: I5::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ I1:mu2,
                           complrel/I3::PROSENTVAR{PROSENTVARrec1},
                           I2:mu3
                         ],
                  mu4 
                ] 

  SUBST:
  m2: T1=PROSENT(KEY_PROSENTkey){PROSENTrec1}
>

< m : I5::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ I1:mu2,
                           I2:mu3
                         ],
                  mu4 
                ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_gsubstordercondition2(mu3, mu4, T1, CLAUSErec1.prosubject)  
       m : QUOTE_substordercondition2(mu3, mu4, CLAUSErec1.prosubject)
       I1: ALL (mu2, I11:rel1/..) AND
           NOT EXIST (mu2, [I12:rel2/..])
         I11: QUOTE_VPrelprec(rel1, complrel)
         I12: rel2 IN [objrel, complrel]
       I2: ALL (mu3, I21:rel3/..)
         I21: QUOTE_VPrelprec(complrel, rel3)
       I3: PROSENTVARrec1.index = LEVEL AND
           PROSENTVARrec1.so = false
       I5: CLAUSErec1.synvpefs * AUX_PROSENTvps <> []
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: PROSENTVARrec1.so = PROSENTrec1.so
              (* no COPY function exists for this one attribute *)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: PROSENTVARrec1.so := false;
              PROSENTVARrec1.index := LEVEL;
              PROSENTrec1.so := false
         >

&
\end{verbatim}
