\begin{verbatim}
% TRANSFORMATION TVerbpattern8
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                           [ head/VERB{VERBrec1}[mu2],
                             argrel/T1,
                             argrel/T2
                           ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                           [ head/VERB{VERBrec1}[mu2],
                             rel1/T1,
                             I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                      [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                        objrel/T2 ]
                           ] 
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR 
                [headkey, actsubcefs, synppefs, mood, thetapp,
                 specQ, class, aspect, deixis, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            aspect     : PREPrec1.aspect
                            deixis     : PREPrec1.deixis
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >
<
   SUBRULE (* 1a. x1 name x2 as (x2 x3) *)
      < T1: NPVAR{NPVARrec1}
        T2: NPPROPVAR{NPPROPVARrec1} >

      < T1: NPVAR{NPVARrec1} 
        T2: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synDONP_PREPOPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PREPOPENNPPROP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := objrel
         >
      DECOMP
         <
          C1: synDONP_PREPOPENNPPROP IN VERBrec1.synvps AND
              synDONP_PREPOPENNPPROP IN VERBPPROPrec2.synvpefs AND
              NPPROPVARrec1.PROsubject = true AND
              VARPREPPrec1 = { synppefs   NI synNP
                               mood        : nowh
                               specQ       : yesspec
                               thetapp     : pp120 }  AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. ?x1 name x2 as (x2 x3) *)
      < T1: CNVAR{CNVARrec1}
        T2: NPPROPVAR{NPPROPVARrec1} >

      < T1: CNVAR{CNVARrec1} 
        T2: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synDONP_PREPOPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PREPOPENNPPROP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : nowh
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := objrel
         >
      DECOMP
         <
          C1: synDONP_PREPOPENNPPROP IN VERBrec1.synvps AND
              synDONP_PREPOPENNPPROP IN VERBPPROPrec2.synvpefs AND
              NPPROPVARrec1.PROsubject = true AND
              VARPREPPrec1 = { synppefs   NI synNP
                               mood        : nowh
                               specQ       : yesspec
                               thetapp     : pp120 }  AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2a. x1 change x2 to (x2 x3) *)
      < T1: NPVAR{NPVARrec1}
        T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      < T1: NPVAR{NPVARrec1} 
        T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synDONP_PREPOPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PREPOPENADJPPROP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synOPENADJPPROP]
                                mood       : nowh 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := objrel
         >
      DECOMP
         <
          C1: synDONP_PREPOPENADJPPROP IN VERBrec1.synvps AND
              synDONP_PREPOPENADJPPROP IN VERBPPROPrec2.synvpefs AND
              ADJPPROPVARrec1.PROsubject = true AND
              VARPREPPrec1 = { synppefs   NI synOPENADJPPROP
                               mood        : nowh 
                               specQ       : yesspec
                               thetapp     : pp120 }  AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b. x1 change x2 to x3 *)
      < T1: CNVAR{CNVARrec1}
        T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      < T1: CNVAR{CNVARrec1} 
        T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synDONP_PREPOPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PREPOPENADJPPROP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synOPENADJPPROP]
                                mood       : nowh 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := objrel
         >
      DECOMP
         <
          C1: synDONP_PREPOPENADJPPROP IN VERBrec1.synvps AND
              synDONP_PREPOPENADJPPROP IN VERBPPROPrec2.synvpefs AND
              ADJPPROPVARrec1.PROsubject = true AND
              VARPREPPrec1 = { synppefs   NI synOPENADJPPROP
                               mood        : nowh 
                               specQ       : yesspec
                               thetapp     : pp120 }  AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3a. x1 give x2 to x3 *)
      < T1 : NPVAR{NPVARrec1}
        T2 : NPVAR{NPVARrec2} >

      < T1 : NPVAR{NPVARrec1} 
        T2 : NPVAR{NPVARrec2} >

      COMP
         <
          C1: synDONP_PREPNP IN VERBrec1.synvps 
          A1: VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDONP_PREPNP];
              rel1 := objrel
         >
      DECOMP
         <
          C1: synDONP_PREPNP IN VERBrec1.synvps AND
              synDONP_PREPNP IN VERBPPROPrec2.synvpefs AND
              VARPREPPrec1 = { synppefs   NI synNP
                               mood        : NPVARrec2.mood 
                               specQ       : NPVARrec2.specQ
                               thetapp     : pp120 }  AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3b. x1 give x2 to x3 *)
      < T1 : CNVAR{CNVARrec1}
        T2 : NPVAR{NPVARrec2} >

      < T1 : CNVAR{CNVARrec1} 
        T2 : NPVAR{NPVARrec2} >

      COMP
         <
