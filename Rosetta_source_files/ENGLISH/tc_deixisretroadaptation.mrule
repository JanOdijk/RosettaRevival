ENGLISH 75
&
\newpage
\begin{verbatim}
%
% FILTER Fdeixisretroadaptation1
< m: SENTENCE{SENTENCErec1}
            [mu1,
             head/VERB{VERBrec3}
                     [mu2,
                      rel2/VERB{VERBrec2}
                          [head/SUBVERB{SUBVERBrec1}
                              [head/BVERB(AUX_havebverbkey){BVERBrec1}]
                          ],
                      rel1/VERB{VERBrec1}[mu3],
                      mu4
                     ],
             mu5
            ] 
>

   MATCHCONDITIONS
      <
      >

         <
          C1: ((SENTENCErec1.aspect = perfective) AND
               (SENTENCErec1.retro = false) AND
               (VERBrec1.modus = participle)
              )
              C11: (SENTENCErec1.superdeixis = omegadeixis) AND
                   (SENTENCErec1.deixis = pastdeixis) AND
                   (SENTENCErec1.finiteness = infinite) AND
                   (VERBrec2.tense = omegatense)
              A11: @

              C12: ((SENTENCErec1.superdeixis = pastdeixis) OR
                    (SENTENCErec1.superdeixis = presentdeixis) 
                   ) AND
                   (SENTENCErec1.deixis = omegadeixis) AND
                   (SENTENCErec1.finiteness = infinite) AND
                   (VERBrec2.tense = omegatense)
              A12: @

          A1: @
         >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] Fdeixisretroadaptation1
\item[* relevant examples:]
he believes Bill to have killed John yesterday/at 3 o'clock
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC: deixisretroadaptation
\item[* date of creation:] 05-APR-88 
\item[* author:] Lisette Appelo
\item[* copied from:] Tdeixisretroadaptation1 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 07/12/88\ \ \ \ \ author: Lisette Appelo
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] FILTER for the rule that sets attributes 
that got a value in special deixis rules to a more or less "default value" for 
the S-parser so that it will not have to deal with these special deixis 
configurations. In English there are two  special rules: 
Rinfinpastdeixisspec and Rinfinpastsuperdeixisspec.
The attribute retro is made true in generation 
and in analysis it is set false as one of the options.\\
This rule is meant for a clause that is marked for perfective aspect.\\
The auxiliary verb {\em have} must be present.
\item[\ \ strategy:] 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
