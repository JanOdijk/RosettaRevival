\newpage
\begin{verbatim}

% RULE RADVPsuperdeixis
< m1: ADVP{ADVPrec1}[mu1] 
>

< m : ADVP{ADVPrec2}[mu1]
>

   PARAMETERS
      <
       super: deixistype
      >

      COMP
         <
          C1: ADVPrec1.superdeixis = omegadeixis AND
              super IN [presentdeixis, pastdeixis]
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := super;
         >
      DECOMP
         <
          C1: ADVPrec2.superdeixis IN [presentdeixis, pastdeixis]
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := omegadeixis;
              super := ADVPrec2.superdeixis;
         >

&

\end{verbatim}
