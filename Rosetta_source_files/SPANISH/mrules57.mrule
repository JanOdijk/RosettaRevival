            C11: (OPENADVPPROPrec1.supertiempo = presente) AND
                  (
                   (
                    (CLAUSErec1.tiempo = presente) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                    (
                     (CLAUSErec1.tiempo = omegatiempo) AND
                     (CLAUSErec1.supertiempo = presente)
                    )
                   )
             A12: OPENADVPPROPrec2 := OPENADVPPROPrec1;
                  OPENADVPPROPrec2.supertiempo := omegatiempo;

             C12:(OPENADVPPROPrec1.supertiempo = pasado) AND
                  (
                   (
                    (CLAUSErec1.tiempo = pasado) AND
                    (CLAUSErec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (CLAUSErec1.tiempo = omegatiempo) AND
                    (CLAUSErec1.supertiempo = pasado)
                   )
                  )

              A12: OPENADVPPROPrec2 := OPENADVPPROPrec1;
                   OPENADVPPROPrec2.supertiempo := omegatiempo;

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:(OPENADVPPROPrec2.supertiempo = omegatiempo) AND
                 (
                  (
                   (CLAUSErec1.tiempo = presente) AND
                   (CLAUSErec1.supertiempo = omegatiempo)
                  ) OR
                  (
                   (CLAUSErec1.tiempo = omegatiempo) AND
                   (CLAUSErec1.supertiempo = presente)
                  )
                 )
              A11: OPENADVPPROPrec1 := OPENADVPPROPrec2;
                   OPENADVPPROPrec1.supertiempo := presente;
            
              C12: (OPENADVPPROPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (CLAUSErec1.tiempo = pasado) AND
                      (CLAUSErec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (CLAUSErec1.tiempo = omegatiempo) AND
                      (CLAUSErec1.supertiempo = pasado)
                     )
                    )

               A12: OPENADVPPROPrec1 := OPENADVPPROPrec2;
                    OPENADVPPROPrec1.supertiempo := pasado;

          A1: @
         >

   SUBRULE (* 8 *)
      < T1: CLOSEDADVPPROP{CLOSEDADVPPROPrec1}[mu5] >
