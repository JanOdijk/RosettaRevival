pragma C_include('interfaces.pf');
pragma C_include('globdef.pf');
pragma C_include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LEVEL;
WITH INTERFACES, GLOBDEF, WND;


(*MPP:::===================================================================*
 *
 *  Function Name  : LEVEL_debug_to_Xid
 *  Description    : return Xid of X object related to debug on/off info
 *                   for a given level
 *  Parameters     : level : level for which the Xid is wanted
 *  Precondition   : 1 <= level <= 8
 *  Postcondition  : 
 *
 *EMP:::===================================================================*)

Function LEVEL_debug_to_Xid (level : GLOBDEF_LevelType)
	: WND_Xid;
External;


(*MPP:::===================================================================*
 *
 *  Function Name  : LEVEL_printerf_to_Xid
 *  Description    : return Xid of X object related to printerf on/off info
 *                   for a given level
 *  Parameters     : level : level for which the Xid is wanted
 *  Precondition   : 1 <= level <= 8
 *  Postcondition  : 
 *
 *EMP:::===================================================================*)

Function LEVEL_printerf_to_Xid (level : INTERFACES_LevelType)
	: WND_Xid;
External;


(*MPP:::===================================================================*
 *
 *  Function Name  : LEVEL_interact_to_Xid
 *  Description    : return Xid of X object related to interaction on/off info
 *                   for a given level
 *  Parameters     : level : level for which the Xid is wanted
 *  Precondition   : 1 <= level <= 8
 *  Postcondition  : 
 *
 *EMP:::===================================================================*)

Function LEVEL_interact_to_Xid (level : INTERFACES_LevelType)
	: WND_Xid;
External;


(*MPP:::===================================================================*
 *
 *  Function Name  : LEVEL_last_active_to_Xid
 *  Description    : return Xid of X object related to last active on/off info
 *                   for a given level
 *  Parameters     : level : level for which the Xid is wanted
 *  Precondition   : 1 <= level <= 8
 *  Postcondition  : 
 *
 *EMP:::===================================================================*)

Function LEVEL_last_active_to_Xid (level : INTERFACES_LevelType)
	: WND_Xid;
External;


END {LASTACTIVE};
 
