\newpage
\begin{verbatim}
% RULE RUTTPREPP
< 
   m1: T1 = PREPP{PREPPrec1}[mu1] 
>

< 
   m : UTT{UTTrec1}
           [ 
            head/T2 = PREPP{PREPPrec2}[mu1] 
           ]
         
>


      COMP
         <
          C1: PREPPrec1.supertiempo = presente AND
              QUOTE_polarityOK(T1)             AND
              (NOT QUOTE_varsintree(T1)) 
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.supertiempo := omegatiempo
         >
      DECOMP
         <
          C1: PREPPrec2.supertiempo = omegatiempo AND
              QUOTE_polarityOK(T2)
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.supertiempo := presente
         >

&

\end{verbatim}
