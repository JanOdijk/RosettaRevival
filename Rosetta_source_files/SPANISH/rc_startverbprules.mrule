       I5: VERBrec1 =
		  {
		   numero       : omeganumero  
		   persona      : 3
                   genero       : omegagenero
		   modo         : omegamodo
		   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
		   status       : bareV
                   foundauxes   : []
		  }
      >


COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
       VERBPPROPrec1.thetavp := vp210
 >
&


\end{verbatim}
