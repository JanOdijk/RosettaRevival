\begin{verbatim}
% TRANSFORMATION TOblObjControlComplSent  (* complrel/SENT, 
                                             (ind)obj ant. *)
< m1:CLAUSE{CLAUSErec1}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu6],
                      mu3,
                      I1:rel1/T1,
                      mu4,
                      complrel/I2::SENTENCE{SENTENCErec1}
                              [ I3:sig1,
                                subjrel/T2,
                                I5:mu5
                              ],
                      mu7 
                    ],
              mu8 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I4:mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}[mu6],
                      mu3,
                      I1:rel1/T1,
                      mu4,
                      complrel/I2::SENTENCE{SENTENCErec1}
                              [ I3:sig1,
                                I5:mu5
                              ],
                      mu7 
                    ],
              mu8 
           ]
>

(* \end{verbatim}
   \newpage
   \begin{verbatim} *)

     MATCHCONDITIONS
      <
       I1: rel1 IN [objrel, indobjrel]
       I2: SENTENCErec1.PROSubject = true
       I3: ALL (sig1, shiftrel/..)
       I4: NOT EXIST (mu1, [I41:auxrel/VERB{VERBrec2}[mu9]])
         I41: VERBrec2.subc = modalverb
       I5: NOT EXIST (mu5, [shiftrel/..])
      >

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: ((rel1 = objrel AND VERBrec1.controller = object) 
               OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
              AND
              NPVARrec1 = NPVARrec2
              (* including cases, which should be nominative *)
          A1: @
         >

      DECOMP
         <
          C1: (rel1 = objrel AND VERBrec1.Controller = object) 
              OR
              (rel1 = indobjrel AND VERBrec1.controller = indobj) 
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is nominative *)
         >

   SUBRULE (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: ((rel1 = objrel AND VERBrec1.Controller = object)
               OR
               (rel1 = indobjrel AND VERBrec1.controller = indobj))
              AND
              CNVARrec1 = CNVARrec2 
              (* including cases, which is nominative *)
          A1: @
         >
      DECOMP
         <
          C1: (rel1 = objrel AND VERBrec1.Controller = object)
              OR
              (rel1 = indobjrel AND VERBrec1.controller = indobj)
          A1: CNVARrec2 := CNVARrec1
              (* including cases, which is nominative *)
         >
>

&
\end{verbatim}
