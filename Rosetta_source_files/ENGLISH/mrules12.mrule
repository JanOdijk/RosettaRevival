\newpage
\begin{verbatim}

% RULE RLetsMood
< m1: I3::CLAUSE{CLAUSErec1}
                [ subjrel/NP{NPrec1}[mu6],
                  I1:mu1,
                  auxrel/VERB{VERBrec1}
                        [head/SUBVERB{SUBVERBrec1}
                             [head/BVERB(KEY_doBVERBkey){BVERBrec1}]
                        ],
                  I2:mu8,
                  predrel/VERBP{VERBPrec1}
                         [ I5:mu5,
                           head/VERB{VERBrec2}[mu2],
                           mu3
                         ],
                  mu4
                ]
>

< m : I4::SENTENCE{SENTENCErec1}
                  [ conjrel/VERB{VERBrec3}
                           [ head/SUBVERB{SUBVERBrec3}
                                 [ head/BVERB(KEY_letsBVERBkey){BVERBrec3}]
                           ],
                    sig1,
                    subjrel/NP{NPrec2}[mu7],
                    I1:mu1,
                    I2:mu8,
                    predrel/VERBP{VERBPrec1}
                           [ I5:mu5,
                             head/VERB{VERBrec2}[mu2],
                             mu3
                           ],
                    mu4
                  ]
>

   MATCHCONDITIONS
      <
       I1: ALL (mu1, I11:rel1/..)
         I11: rel1 IN AUX_preAuxAdvRels
       I2: ALL (mu8, I21:rel8/..)
         I21: rel8 IN AUX_postAuxAdvRels OR rel8 = negrel
       I3: CLAUSErec1 = { finiteness : finite
                          modus      : imperative
                          aspect     : perfective
                          deixis     : presentdeixis }
       I4: SENTENCErec1 = { mood       : letsmood
                            senttype   : mainclause
                            modus      : imperative
                            finiteness : finite
                            PROsubject : false
                            conjkey    : 0
                            adverbial  : false
                            temporal   : false
                            aspect     : perfective
                            deixis     : presentdeixis
                            conjclass  : omegaTimeAdvClass
                            conjdeixis : omegadeixis
                            conjaspect : omegaaspect
                            conjretro  : false }
       I5: NOT EXIST (mu5, [../VERB{}[mu9]])
      >

<
   SUBRULE (* 1. no contraction: let us *)
      < >
      < sig1: [] >

      COMP
         <
          C1: NPrec1 = { number   : plural 
                         person   : 1 
                         cases   NI nominative } AND
              VERBrec1 = COPYT_subverbTOverb(SUBVERBrec1) AND
              VERBrec1 = { numbers NI plural
                           persons NI 1
                           modus    : omegamodus } AND
              SUBVERBrec1 = COPYT_bverbTOsubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix 
          A1: SUBVERBrec3 := COPYT_bverbTOsubverb(BVERBrec3);
              SUBVERBrec3.affix := noaffix;
              VERBrec3 := COPYT_subverbTOverb(SUBVERBrec3);
              VERBrec3 := { numbers : []
                            persons : []
                            modus   : infinitive };
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood       : letsmood
                                senttype   : mainclause
                                modus      : imperative
                                finiteness : finite };
              (* other attributes specific to sentence retain 
                 default values *)
              QUOTE_assigncase(NPrec1, mu6, NPrec2, mu7, [accusative])
         >

      DECOMP
         <
          C1: NPrec2 = { cases    NI accusative 
                         person    : 1 
                         number    : plural } AND
              SUBVERBrec3 = COPYT_bverbTOsubverb(BVERBrec3) AND
              SUBVERBrec3.affix = noaffix AND
              VERBrec3 = COPYT_subverbTOverb(SUBVERBrec3) AND
              VERBrec3 = { numbers : []
                           persons : []
                           modus   : infinitive } AND
              SENTENCErec1 = { mood       : letsmood
                               senttype   : mainclause
                               modus      : imperative
                               finiteness : finite }
          A1: SUBVERBrec1 := COPYT_bverbTOsubverb(BVERBrec1);
              SUBVERBrec1.affix := noaffix;
              VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
              VERBrec1 := { persons : [1]
                            numbers : [plural]
                            modus   : omegamodus };
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1 := { finiteness : finite
                              modus      : imperative };
              QUOTE_assigncase(NPrec2, mu7, NPrec1, mu6, [nominative])
         >

   SUBRULE (* 2. contraction: let's *)
      < >
      < sig1: [gluerel/GLUE{GLUErec1}] >

      (* no COMP part *)

      DECOMP
         <
          C1: NPrec2 = { cases    NI accusative 
                         person    : 1 
                         number    : plural } AND
              SUBVERBrec3 = COPYT_bverbTOsubverb(BVERBrec3) AND
              SUBVERBrec3.affix = noaffix AND
              VERBrec3 = COPYT_subverbTOverb(SUBVERBrec3) AND
              VERBrec3 = { numbers : []
                           persons : []
                           modus   : infinitive } AND
              SENTENCErec1 = { mood       : letsmood
                               senttype   : mainclause
                               modus      : imperative
                               finiteness : finite }
          A1: SUBVERBrec1 := COPYT_bverbTOsubverb(BVERBrec1);
              SUBVERBrec1.affix := noaffix;
              VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
              VERBrec1 := { persons : [1]
                            numbers : [plural]
                            modus   : omegamodus };
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1 := { finiteness : finite
                              modus      : imperative };
              QUOTE_assigncase(NPrec2, mu7, NPrec1, mu6, [nominative])
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RLetsMood
\item[* relevant examples:] $_{CL}$[we do be happy] $\rightarrow$ $_{S}$[Let us 
be happy]
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] clauseTOsentence
\item[* class:] (name of rule, transformation or filter class) 
RC\_MoodDetermination
\item[* date of creation:] 16-OCT-1988
\item[* author:] margreet sanders
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 11/12/89\ \ \ \ \ author: margreet sanders\\
Added subrule for analysis of contracted form {\em Let's\/}.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to create a main sentence with {\em Let us\/}
\item[\ \ strategy:] (also: deviations from accepted proposals) No other verbs 
than the head are allowed in the VERBP, and no other auxiliary than `do' is 
allowed; sentences like {\em Let us have done it\/} and {\em Let us be singing
\/} are not provided for.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] see above under 
`modification 11/12/89'
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
The surface Parser must be able to recognize {\em us\/} as the subject of the 
sentence (contrary to ordinary imperatives, where there are only objects). This
could be cued by the verb {\em let\/}.
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
It is unclear what kind of {\em let\/} should officially be used here: a two-
place verb or a three place verb. However, since it is introduced 
syncategorematically, it does not matter in practice. The solution chosen for 
the moment is vp120: let + closedinfsent.
\item modifications:

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RVPPROPMood
< m1: I3::CLAUSE{CLAUSErec1} 
                [ I2:sig1,
                  subjrel/T1,
                  predrel/VERBP{VERBPrec1}
                         [ I1:passauxrel/VERB{VERBrec1}
                                    [head/SUBVERB{SUBVERBrec1}
                                         [head/BVERB(KEY_beBVERBkey)
                                                          {BVERBrec1}]
                                    ],
                           head/I5::VERB{VERBrec2}[mu2],
                           mu3
                         ],
                  mu4
                ]
>

< m : I4::CLOSEDVERBPPROP{CLOSEDVERBPPROPrec1}
                         [ I2:sig1,
                           subjrel/T1,
                           predrel/VERBP{VERBPrec1}
                                  [ head/I5::VERB{VERBrec2}[mu2],
                                    mu3
                                  ],
                           mu4
                         ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.subc = beVerb
       I2: ALL (sig1, shiftrel/..)
       I3: CLAUSErec1 = { finiteness  : infinite
                          infsort     : omegainf
                          modus       : omegamodus
                          voice       : passive
                          aspect      : perfective
                          deixis      : omegadeixis
                          PROsubject  : false }
       I4: CLOSEDVERBPPROPrec1 = { PROsubject : false
                                   voice      : passive }
       I5: VERBrec2.modus = participle
      >

      COMP
         <
          C1: VERBrec1 = COPYT_subverbTOverb(SUBVERBrec1) AND
              VERBrec1 = { modus   : omegamodus
                           tense   : omegatense
                           persons : []
                           numbers : [] } AND
              SUBVERBrec1 = COPYT_bverbTOsubverb(BVERBrec1) AND
              SUBVERBrec1.affix = noaffix
          A1: CLOSEDVERBPPROPrec1 := COPYT_clauseTOverbpprop(CLAUSErec1)
              (* including superdeixis *)
         >

      DECOMP
         <
          C1: true
          A1: SUBVERBrec1 := COPYT_bverbTOsubverb(BVERBrec1);
              SUBVERBrec1.affix := noaffix;
              VERBrec1 := COPYT_subverbTOverb(SUBVERBrec1);
              VERBrec1 := { modus   : omegamodus
                            tense   : omegatense
                            persons : []
                            numbers : [] };
              CLAUSErec1 := COPYT_verbppropTOclause(CLOSEDVERBPPROPrec1);
              (* including superdeixis *)
              CLAUSErec1 := { modus      : omegamodus
                              finiteness : infinite
                              aspect     : perfective
                              infsort    : omegainf }
              (* other attributes remain default *)
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RVPPROPMood
\item[* relevant examples:] the house be built by a famous architect 
$\rightarrow$ the house built by a famous architect (to become: He had the 
house built by a famous architect); By whom (did you have) it signed?
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) RC\_
Mooddetermination
\item[* date of creation:] 29-NOV-1988 11:16:41  
\item[* author:] margreet sanders
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 08/12/88\ \ \ \ \ author: Lisette Appelo
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to reduce a clause to a closed VERBPPROP which can be used as an 
argument by the verb {\em have\/}. This rule is needed since no separate 
VERBPPROP-grammars exist (VERBPPROPtoFORMULA and VERBPFORMULAtoPROP).
\item[\ \ strategy:] (also: deviations from accepted proposals) It is assumed 
that no adverbs can occur after the subject andd before or after the auxiliary 
{\em be\/}. Also, it is assumed that no conjrel exists preceding the subject. 
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:
8/12/88: Added condition/action for perfective aspect of CLAUSE. Because 
VERBPPROP does not have an attribute aspect, the clause is given an aspect 
value here in analysis. This is possible because it is presupposed that these 
VERBPPROPs are always dependent propositions that cannot have retrospective 
aspect, neither temporal adverbials. If this is wrong VERBPPROP must get rules 
and attributes for temporal aspects!\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% RULE Rwouldinsertion
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_doBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 
>

< m :CLAUSE{CLAUSErec1}
           [mu1,
            auxrel/VERB{VERBrec3}
                  [head/SUBVERB{SUBVERBrec3}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec3}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 

>
   MATCHCONDITIONS
      <
       I1: KEY2 = KEY_likeBVERBkey OR
           KEY2 = KEY_preferBVERBkey

      >


      COMP
         <
          C1: (CLAUSErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND

              ((CLAUSErec1.deixis = presentdeixis) AND
                  (VERbrec1.tense =  presenttense)
              ) OR
              ((CLAUSErec1.deixis = pastdeixis) AND
                  (VERbrec1.tense =  pasttense)
              ) OR
              ((CLAUSErec1.superdeixis = presentdeixis) AND
                  (VERbrec1.tense =  presenttense)
              ) OR
              ((CLAUSErec1.superdeixis = pastdeixis) AND
                  (VERbrec1.tense =  pasttense)
              )
                 

          A1: SUBVERBrec3 := COPYT_bverbtosubverb(BVERBrec3);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec3);
              VERBrec3 :=
                {
                  numbers     : VERBrec1.numbers
                  persons     : VERBrec1.persons
                  modus       : VERBrec1.modus
                  tense       : pasttense
                };
         >
      DECOMP
         <
          C1:(CLAUSErec1.finiteness = finite) AND
              (SUBVERBrec3 = COPYT_bverbtosubverb(BVERBrec3)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec3)) AND
              (SUBVERBrec3.affix = noaffix) 
    
              C11:((CLAUSErec1.deixis = pastdeixis) OR
                   (CLAUSErec1.superdeixis = pastdeixis) 
                  ) AND
                  (VERbrec3.tense =  pasttense)
                  
              A11: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                        {
                          numbers     : VERBrec3.numbers
                          persons     : VERBrec3.persons
                          modus       : VERBrec3.modus
                          tense       : pasttense
                        };
              C12:((CLAUSErec1.superdeixis = presentdeixis) OR
                   (CLAUSErec1.deixis = presentdeixis)) AND
                  (VERbrec3.tense =  pasttense)
              A12: SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
                   VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
                   VERBrec1 :=
                        {
                          numbers     : VERBrec3.numbers
                          persons     : VERBrec3.persons
                          modus       : VERBrec3.modus
                          tense       : presenttense
                        };
          A1:@
         >

&

\end{verbatim}
