\begin{verbatim}

% RULE RSTARTADJPPROP120          (*x1 fond of x2 *)
< m1: SUBADJ{SUBADJrec1}[mu1] 
  m2: T1
  m3: T2
>

< m : I4::ADJPPROP{ADJPPROPrec1}
                           [I2:subjrel/T1,
                            predrel/I5::ADJP{ADJPrec1}
                                    [head/I6::ADJ{ADJrec1}
                                          [head/SUBADJ{SUBADJrec1}[mu1]],
                                     I3:argrel/T2
                                    ]
                          ]
>

   MATCHCONDITIONS
      <
       m1: SUBADJrec1.thetaadj = adjp120 
       m2: T1.cat IN AUX_VARCATSET
       I2: T1.cat IN AUX_VARCATSET
       m3: T2.cat IN AUX_VARCATSET
       I3: T2.cat IN AUX_VARCATSET
       I4: ADJPPROPrec1 = ADJPPROPRECDEF EXCEPT FOR [thetaadj, actsubcefs,
                       temporal, class, deixis, aspect, retro ] AND
           ADJPPROPrec1.thetaadj =adjp120
       I5: ADJPrec1 = ADJPRECDEF EXCEPT FOR [thetaadj, actsubcefs,
                       temporal, class, deixis, aspect, retro ] AND
           ADJPrec1.thetaadj =adjp120
       I6: ADJrec1 = {compform      : basic                     }
      >


      COMP
         <
          C1: true
          A1: ADJrec1 := COPYT_subadjtoadj(SUBADJrec1);
              ADJPrec1 := COPYT_adjtoadjp(ADJrec1);
              ADJPrec1.actsubcefs := ADJrec1.subcs;
              ADJPPROPrec1 := COPYT_adjptoadjpprop(ADJPrec1)

          >
      DECOMP
         <
          C1: (ADJrec1 = COPYT_subadjtoadj(SUBADJrec1)) AND
              (ADJPrec1 = COPYT_adjtoadjp(ADJrec1)) AND
              (ADJPrec1.actsubcefs = ADJrec1.subcs ) AND
              (ADJPPROPrec1 = COPYT_adjptoadjpprop(ADJPrec1)) 
          A1: @
         >

&
\end{verbatim}
