\begin{verbatim}
% RULE RNPargmodsubst1                   (* provisional draft; 16-JAN-89 *)

< m1 : NP{NPrec1}[mu1,
                  head/CN{CNrec1}[mu4,
                                  head/I2::NOUN{NOUNrec1}[mu2],
                                  prepobjrel/VARPREPP{VARPREPPrec1}
                                         [head/PREP(NOUNrec1.prepkey){PREPrec1},
                                          objrel/I1::NPVAR{NPVARrec1}]
                                  ],
                  mu3
                 ]
SUBST:
  m2: NP{NPrec2}[mu5]
>
< m  : NP{NPrec1}[mu1,
                  head/CN{CNrec1}[mu4,
                                  head/I2::NOUN{NOUNrec1}[mu2],
                                  prepobjrel/PREPP{PREPPrec1}
                                         [head/PREP(NOUNrec1.prepkey){PREPrec1},
                                          objrel/NP{NPrec3}[mu6]]
                                 ],
                  mu3
                 ]
>

   MATCHCONDITIONS
      <
       I1: NPVARrec1.index = LEVEL
       I2: synPREPNP IN NOUNrec1.nounpatterns 

      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:NPVARrec1 = COPYT_nptovar(NPrec2) EXCEPT FOR [cases] AND
             NPrec2.cases = [] AND
             NPrec2.generic = nogeneric AND
             NPrec2.superdeixis = NPrec1.superdeixis
          A1:PREPPrec1 := VARPREPPrec1;
             QUOTE_assigncase(NPrec2,mu5,NPrec3,mu6,NPVARrec1.cases); 
             NPrec3.superdeixis := omegadeixis;
             NPrec3.generic := omegageneric;
         >
      DECOMP
         <
          C1: NPrec3.generic = omegageneric 
          A1:VARPREPPrec1 := PREPPrec1;
             QUOTE_assigncase(NPrec3,mu6,NPrec2,mu5,[]); 
             NPrec2.superdeixis := NPrec1.superdeixis;
             NPVARrec1 := COPYT_nptovar(NPrec3);
             NPVARrec1.index := LEVEL;
             NPrec2.generic := nogeneric;
         >


&

\end{verbatim}
