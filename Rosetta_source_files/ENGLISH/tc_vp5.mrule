\begin{verbatim}
% TRANSFORMATION Tverbpattern11
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                            [ head/VERB{VERBrec1}[mu2],
                              argrel/T1,
                              argrel/T2
                            ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                          [ head/VERB{VERBrec1}[mu2],
                            rel1/T1,                           
                            I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                   [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                     objrel/T2 ]
                          ] 
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR
               [headkey, actsubcefs, mood, synppefs, thetapp,
                specQ, class, deixis, aspect, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            deixis     : PREPrec1.deixis
                            aspect     : PREPrec1.aspect
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >

<
   SUBRULE (*1. x1 say SO to x2 *)

       < T1: PROSENTVAR{PROSENTVARrec1}
         T2: NPVAR{NPVARrec1}>

       < T1: PROSENTVAR{PROSENTVARrec1}
         T2: NPVAR{NPVARrec1}>

      COMP
         <
          C1: synSOPROSENT_PREPNP IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synSOPROSENT_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                mood       : NPVARrec1.mood
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := complrel;
         >
      DECOMP
         <
          C1: synSOPROSENT_PREPNP IN VERBPPROPrec2.synvpefs AND
              synSOPROSENT_PREPNP IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true AND
              VARPREPPrec1 = { synppefs  NI synNP 
                               mood       : NPVARrec1.mood 
                               specQ      : NPVARrec1.specQ
                               thetapp    : pp120 } AND
              rel1 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (*1. x1 say SO to x2 *)
       < T1: PROSENTVAR{PROSENTVARrec1}
         T2: CNVAR{CNVARrec1}>

       < T1: PROSENTVAR{PROSENTVARrec1}
         T2: CNVAR{CNVARrec1}>

      COMP
         <
          C1: synSOPROSENT_PREPNP IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synSOPROSENT_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                mood       : NPVARrec1.mood
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := complrel;
         >
      DECOMP
         <
          C1: synSOPROSENT_PREPNP IN VERBPPROPrec2.synvpefs AND
              synSOPROSENT_PREPNP IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true AND
              VARPREPPrec1 = { synppefs  NI synNP 
                               mood       : NPVARrec1.mood 
                               specQ      : NPVARrec1.specQ
                               thetapp    : pp120 } AND
              rel1 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >


   SUBRULE (*2. x1 say EMPTY to x2 *)
       < T1: PROSENTVAR{PROSENTVARrec1}
         T2: EMPTYVAR{EMPTYVARrec1}>

       < T1: PROSENTVAR{PROSENTVARrec1}
         T2: EMPTYVAR{EMPTYVARrec1}>

      COMP
         <
          C1: synSOPROSENT_EMPTY IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synSOPROSENT_EMPTY];
              rel1 := complrel;
         >
      DECOMP
         <
          C1: synSOPROSENT_EMPTY IN VERBPPROPrec2.synvpefs AND
              synSOPROSENT_EMPTY IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true AND
              rel1 = complrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >


>
&

\end{verbatim}
