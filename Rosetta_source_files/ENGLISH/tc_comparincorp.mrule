\newpage
\begin{verbatim}
%
% TRANSFORMATION TSadjcomplextrapos
< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      predrel/ADJP{ADJPrec1}
                                     [mu6,
                                      degreemodrel/N1
                                             [mu7,   (* almost/much *)
                                              head/T1,
                                              I2:thanascomplrel/T2
                                             ],
                                      mu3,
                                      head/ADJ{ADJrec1}[mu9],
                                      I4:mu4, 
                                      I5:mu5 
                                     ],
                      mu10
                    ],
             mu8 
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      predrel/ADJP{ADJPrec1}
                                      [mu6,
                                       degreemodrel/N1
                                             [mu7, 
                                              head/T1
                                             ],
                                      mu3,
                                      head/ADJ{ADJrec1}[mu9],
                                      mu4, 
                                      I3:postadjrel/T2,
                                      mu5 
                                     ],
                      mu10
                    ],
             mu8
           ]
>



   MATCHCONDITIONS
      <
       I1: synbe IN CLAUSErec1.synvpefs
       I2: T2.cat IN [THANP]
       I3: T2.cat IN [THANP]
       I4: NOT EXIST(mu4, [I14:rel1/T4])
       I14: T4.CAT IN [SENTENCE]
       I5: NOT EXIST(mu5, [I15:rel1/T3])
       I15: T3.CAT IN [VARPREPP, QP] 
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] TsADJCOMPLExtrapos
\item[* relevant examples:] 
To be translated:

\begin{enumerate}
\item
hij (veel/bijna) minder/meer dan Jan lang is $\rightarrow$, 
hij (veel/bijna) minder/meer lang dan Jan is, 

\item
... as as possible soon ... $\rightarrow$ 
... as soon as possible ...
\item
... meer dan Jan gek op geld ...$\rightarrow$ 
... meer gek op geld dan Jan ...
\end{enumerate}
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoclause
\item[* class:] (name of rule, transformation or filter class)
