\newpage
\begin{verbatim}
% RULE RQPsuperdeixis
< m1:QP{QPrec1}[mu1] 
>

< m :QP{QPrec2}[mu1] 
>

   PARAMETERS
      <
       super : tiempotype
      >

      COMP
         <
          C1: QPrec1.supertiempo = omegatiempo AND
              super IN [presente, pasado]
          A1: QPrec2 := QPrec1;
              QPrec2.supertiempo := super;
         >
      DECOMP
         <
          C1: QPrec2.supertiempo IN [presente, pasado]
          A1: QPrec1 := QPrec2;
              QPrec1.supertiempo := omegatiempo;
              super := QPrec2.supertiempo;
         >

&

\end{verbatim}
