object mps_separator : XmSeparator {
    arguments {
        XmNleftAttachment    = XmATTACH_FORM;
        XmNrightAttachment   = XmATTACH_FORM;
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmRowColumn mps_cpu;

        XmNleftOffset        = 0;
        XmNrightOffset       = 0;
        XmNmargin            = 0;
    };
};

object mps_button_box : XmRowColumn {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmSeparator mps_separator;
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_mps_ok_button;
                XmNsensitive    = false;
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_mps_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_mps_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_mps_help_button;
	    };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_mps_help_button);
		XmNactivateCallback = procedure XwhAction (X_mps_help_button);
   	    };
	};
    };
};

