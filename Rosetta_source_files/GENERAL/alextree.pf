pragma C_include('limorfdef.pf');
pragma C_include('listree.pf');
pragma C_include('string.pf');
pragma C_include('interface0.pf');
pragma C_include('interface1.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE ALEXTREE;
WITH LIMORFDEF, LISTREE, STRNG, INTERFACE0, INTERFACE1;

(*MPF:::===================================================================*
 *
 *  Function Name  : ALEXTREE_ALEXTREEPLUS
 *  Description    : Implements the function ALEXTREE+ as described in document 
 *                   R065. Tries to construct S-trees on top of the rows of
 *                   a row segment S-trees.
 *                   If ALEXTREE cannot find at least one correct sequence of 
 *                   lexical S-trees for the input, it tries to detect which 
 *                   words in the original input sentence caused the errors. In
 *                   that case a datastructure is made which contains the
 *                   coordinates of the erroneous words in the input window.
 *                   This datastructure can then be passed to the 
 *                   ALAYOUT_MarkWrongos function.
 *  Parameters     : r: INTERFACE1_pRowSeqSegmKeys : set of seqences of rows 
 *                                                   of segment S-trees.
 *                   r0: INTERFACE0_pSeqWords :1. NIL if the function returns
 *                                                a value <> NIL.
 *                                             2. Datastructure containing
 *                                                the erroneous words otherwise
 *  Result         : INTERFACE1_pRowSeqSegmKeys :Datastructure containing the 
 *                                               sequences of lexical S-trees.
 *                   The resulting datastructure is a double linked circular
 *                   list. See the documentation on module INTERFACE1 for
 *                   exact description of the datastructure. 
 *
 *EMP:::===================================================================*)

FUNCTION ALEXTREE_ALEXTREEplus(r: INTERFACE1_pRowSeqSegmKeys;
                                  VAR r0: INTERFACE0_pSeqWords): 
                                  INTERFACE1_pRowSeqSegmKeys; 
EXTERNAL;


END {ALEXTREE};
