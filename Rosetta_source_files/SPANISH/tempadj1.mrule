< m : ADJPPROP{ADJPPROPrec1}
            [mu1,
             predrel/ADJP{ADJPrec1}
                    [mu2,
                     head/ADJ{ADJrec1}[mu4],
                     I9:mu9,
                     I1:mu3,
                     tempadvrel/T1,
                     I7:mu5
                    ],
             mu6
            ] 

>
   MATCHCONDITIONS
      <
       I1: ALL(mu3, locadvrel/..) 
       I2: NOT EXIST(mu5, [locadvrel/..]) AND
           QUOTE_tempretronotfound(mu5)  AND
           QUOTE_tempdurnotfound(mu5)
       I7: NOT EXIST(mu5,[I71:rel7/..]) AND
           QUOTE_tempretronotfound(mu5)  AND
           QUOTE_tempdurnotfound(mu5)
           I71: rel7 IN [locadvrel, sentadvrel]
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       I9: ALL(mu9, I91:rel9/..)
           I91: QUOTE_Adjprelprec(head, rel9) AND
                [rel9] * [locadvrel, tempadvrel, sentadvrel] = []
      >
<
