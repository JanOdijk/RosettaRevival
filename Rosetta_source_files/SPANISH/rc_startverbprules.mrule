\newpage
\begin{verbatim}
%
%RULE RSIDSTARTVPPROP120

<m1: I1::SUBVERB{SUBVERBREC1}[head/BVERB(KEY1){BVERBREC1}]
 m2: T1
 m3: T2
>

<m: I4::VERBPPROP{VERBPPROPREC1}
             [ I2:subjrel/T1, 
               predrel/VERBP{VERBPREC1}
                      [ head/I5::VERB{VERBREC1}
                         [head/SUBVERB{SUBVERBREC1}[head/BVERB(KEY3){BVERBREC1}]
                         ],
                        argrel/T2
                      ]
             ]
>

   MATCHCONDITIONS
      <
       I1: SUBVERBREC1.thetavp = vp120 
       I2: T1.CAT IN AUX_VARCATSET 
       m2: T1.CAT IN AUX_VARCATSET 
       I4: VERBPPROPREC1 =
		  { 
		   thetavp     : vp120
		   req         : [ pospol, negpol, omegapol]
		   env         : [ pospol, negpol, omegapol]
		   supertiempo : Omegatiempo
		   PROsubject  : false
		   voice       : omegavoice
		   synvpefs    : []
                   aktionsarts : []
		  }
       I5: VERBREC1 =
		  {
                   thetavp      : vp120
		   numero       : omeganumero  
		   persona      : 3
                   genero       : omegagenero
		   modo         : omegamodo
		   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
		   status       : bareV
                   foundauxes   : []
		  }
      >

<
   SUBRULE (* 1 *)
     <T2: NPVAR{NPVARREC1}^NP{NPREC1}
                                [mu1,
                                 head/CN{CNREC1}
                                   [mu3,
                                    head/NOUN{NOUNREC1}
                                        [head/SUBNOUN{SUBNOUNREC1}
                                           [head/BNOUN(KEY2){BNOUNREC1}]
                                        ],
                                    mu4
                                   ],
                                 mu2
                                ]
      >
     <T2: NPVAR{NPVARREC1}^NP{NPREC1}
                                [mu1,
                                 head/CN{CNREC1}
                                   [mu3,
                                    head/NOUN{NOUNREC1}
                                        [head/SUBNOUN{SUBNOUNREC1}
                                           [head/BNOUN(KEY2){BNOUNREC1}]
                                        ],
                                    mu4
                                   ],
                                 mu2
                                ]
      >
COMP
 <
   C1: COMPINSIDDICT(KEY1, KEY2, 2)
   A1: VERBPPROPREC1.thetavp := vp120;
       KEY3 := COMPGETSIDDICT (KEY1, KEY2, 2);
       VERBREC1 := COPYT_subtoverb(SUBVERBREC1);
 >
DECOMP
 <
   C1: DECOMPINSIDDICT(KEY3, KEY2, 2)
      C11: VERBREC1 = COPYT_subtoverb(SUBVERBREC1)
      A11: KEY1 := DECOMPGETSIDDICT(KEY3, KEY2, 2);
   A1: @
 >

  SUBRULE (* 2 *)
     <T2: CNVAR{CNVARREC1}^CN{CNREC1}
                                   [mu3,
                                    head/NOUN{NOUNREC1}
                                        [head/SUBNOUN{SUBNOUNREC1}
                                           [head/BNOUN(KEY2){BNOUNREC1}]
                                        ],
                                    mu4
                                   ]
      >
     <T2: CNVAR{CNVARREC1}^CN{CNREC1}
                                   [mu3,
                                    head/NOUN{NOUNREC1}
                                        [head/SUBNOUN{SUBNOUNREC1}
                                           [head/BNOUN(KEY2){BNOUNREC1}]
                                        ],
                                    mu4
                                   ]
      >

COMP
 <
   C1: COMPINSIDDICT(KEY1, KEY2, 2)
   A1: VERBPPROPREC1.thetavp := vp120;
       KEY3 := COMPGETSIDDICT (KEY1, KEY2, 2);
       VERBREC1 := COPYT_subtoverb(SUBVERBREC1);
 >
DECOMP
 <
   C1: DECOMPINSIDDICT(KEY3, KEY2, 2)
      C11: VERBREC1 = COPYT_subtoverb(SUBVERBREC1)
      A11: KEY1 := DECOMPGETSIDDICT(KEY3, KEY2, 2);
   A1: @
 >
>
&
\end{verbatim}

\newpage
\begin{description}
\item[* name:] RSIDSTARTVPPROP120
\item[* relevant examples:] x1 geven schreeuw, Marie geeft een schreeuw
\item[* language:]  Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] RC:Startverbprules
\item[* date of creation:] 04-AUG-1988 13:25:00  
\item[* author:] Andre\'{e} Schenk
\item[* copied from:Dutch:rsidstartvpprop120]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Combines a SUBVERB with its required number of arguments and 
puts one of them in subject position and one inside the VERBP; the head of the 
argument NP in VERBP is specified; this is a part of a semi-idiom.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of 
parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] Function-application and "thematic role" .
assignment.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ Attribute thetavp with BVERBs.

\item rules:\\ This is the first rule-class.

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{} The number of arguments should remain 
the same.
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc. nr. 269 (Semi-Idioms and the 
Dictionary)
\item[\ \ remarks:]\mbox{} In this rule the subverbrecords are copied from each 
other analytically and generatively; another way is to change the bverb first
(i.e. attributes values are the same except for the key) and then copy the
subverb from the bverb. If dictionary structure changes: keep this in
account!!! 
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}


