\begin{verbatim}
% RULE RAdjppComplSentSubst
< m1: ADJPPROP{ADJPPROPrec1}
              [ mu1,
                predrel/ADJP{ADJPrec1}
                       [ mu2,
                         I1:rel1/I2::SENTENCEVAR{SENTENCEVARrec1},
                         mu3
                       ],
                mu4
              ]
  SUBST:
  m2: SENTENCE{SENTENCErec1}[mu6]          (* substituent *)
>

< m : ADJPPROP{ADJPPROPrec1}
              [ mu1,
                predrel/ADJP{ADJPrec1}
                       [ mu2,
                         I1:rel1/SENTENCE{SENTENCErec1}[mu6],
                         mu3
                       ],
                mu4
              ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [complrel, toinfmodrel, postadjrel, 
                    causadvrel, toinfcomplrel, resultrel]
       I2: SENTENCEVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec1);
              SENTENCEVARrec1.index := LEVEL;
         >
&

\end{verbatim}
