pragma C_include('lexcomdecl.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE lexcomscanner;

WITH LEXCOMDECL;
(*MPF:::===================================================================*
 *
 *  Procedure Name  : scanner 
 *  Description     : does the "morphology" of the lextreecompiler
 *                    The input text is in if1. If allmode = true then it
 *                    looks for the next rule (starting with "%" in the first
 *                    column) and delivers the rule name in "rulenaam" and
 *                    a sequence of tokens and charstrings in if2. A charstring
 *                    is everything between two tokens on one line, between
 *                    the last token of a line and the end of the line, and
 *                    between the beginning of the line and the first token.
 *  Parameters      : 
 *  Precondition    : 
 *  Postcondition   : lextree rules in 'file' are compiled
 *
 *EMP:::===================================================================*)

PROCEDURE LEXCOMSCANNER_body(var if1:text;var rulenaam:LEXCOMDECL_string;
                                               allmode:BOOLEAN;
   					var if2:LEXCOMDECL_pconnectionnode); 
EXTERNAL;

END {scanner};
