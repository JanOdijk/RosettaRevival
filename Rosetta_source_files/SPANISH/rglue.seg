TYPE RGLUE2;

{ dividing a word into two segments }

VAR

A    =  [ se,te,me,le,lo,la,os,nos,les,los,las ] ;

A1   =  [ se,te,me,le,lo,la,os,les,los,las ] ;      { A without "nos" }

A2   =  [ se,te,me,le,lo,la,nos,les,los,las ] ;     { A without "os" }

A3   =  [ te,me,le,lo,la,os,nos,les,los,las ] ;     { A without "se" }  

OE   =  [ u,i ] ;

UU   =  [ u ] ;

MED1 =  [ b,c,d,f,g,j,l,m,n,ñ,p,q,r,s,t,v,x,y,z ] ;

MED2 =  [ b,c,d,f,g,j,l,m,n,ñ,p,q,r,s,t,v,x,y,z ] ;

MED3 =  [ b,c,d,f,g,j,l,m,n,ñ,p,q,r,s,t,v,x,y,z ] ;

B    =  [ se,te,me,os,nos ] ;

B1   =  [ se,te,me,nos ] ;

F    =  [ me,te,le,lo,la,nos,les,los,las ] ;

G    =  [ le,lo,la,les,los,las ] ;

D    =  [ se,te,os ] ;

D1   =  [ te,os ] ;                                 { D without "se" }

D2   =  [ se,te ] ;                                 { D without "os" }

E    =  [ me,te,nos,os ] ;

H    =  [ me,nos ] ;


{ infinitivo; hablar - hablarte }

TABLE

*ar + (A)  ::  *ar(A) ;

*er + (A)  ::  *er(A) ;

*ir + (A)  ::  *ir(A) ;


{ gerundio; hablando - hablándome }

*ando + (A)  ::  *ándo(A) ;

*endo + (A)  ::  *éndo(A) ;


{ regular imperativo } 

{ forms ending on -a; habla/coma - háblame/cómase }


*a(OE)(MED1)a + (A)  ::  *á(OE)(MED1)a(A) ;

*e(OE)(MED1)a + (A)  ::  *é(OE)(MED1)a(A) ;

*o(OE)(MED1)a + (A)  ::  *ó(OE)(MED1)a(A) ;


*a(OE)(MED1)(MED2)a + (A)  ::  *á(OE)(MED1)(MED2)a(A) ;

*e(OE)(MED1)(MED2)a + (A)  ::  *é(OE)(MED1)(MED2)a(A) ;

*o(OE)(MED1)(MED2)a + (A)  ::  *ó(OE)(MED1)(MED2)a(A) ;


*a(OE)(MED1)(MED2)(MED3)a + (A)  ::  *á(OE)(MED1)(MED2)(MED3)a(A) ;

*e(OE)(MED1)(MED2)(MED3)a + (A)  ::  *é(OE)(MED1)(MED2)(MED3)a(A) ;

*o(OE)(MED1)(MED2)(MED3)a + (A)  ::  *ó(OE)(MED1)(MED2)(MED3)a(A) ;


*aa + (A)  ::  *áa(A) ;

*ea + (A)  ::  *éa(A) ;

*oa + (A)  ::  *óa(A) ;



*a(MED1)a + (A)  ::  *á(MED1)a(A) ;

*e(MED1)a + (A)  ::  *é(MED1)a(A) ;

*i(MED1)a + (A)  ::  *í(MED1)a(A) ;
 
*o(MED1)a + (A)  ::  *ó(MED1)a(A) ;

*u(MED1)a + (A)  ::  *ú(MED1)a(A) ;


*a(MED1)(MED2)a + (A)  ::  *á(MED1)(MED2)a(A) ;

*e(MED1)(MED2)a + (A)  ::  *é(MED1)(MED2)a(A) ;

*i(MED1)(MED2)a + (A)  ::  *í(MED1)(MED2)a(A) ;
 
*o(MED1)(MED2)a + (A)  ::  *ó(MED1)(MED2)a(A) ;

*u(MED1)(MED2)a + (A)  ::  *ú(MED1)(MED2)a(A) ;


*a(MED1)(MED2)(MED3)a + (A)  ::  *á(MED1)(MED2)(MED3)a(A) ;

*e(MED1)(MED2)(MED3)a + (A)  ::  *é(MED1)(MED2)(MED3)a(A) ;

*i(MED1)(MED2)(MED3)a + (A)  ::  *í(MED1)(MED2)(MED3)a(A) ;
 
*o(MED1)(MED2)(MED3)a + (A)  ::  *ó(MED1)(MED2)(MED3)a(A) ;

*u(MED1)(MED2)(MED3)a + (A)  ::  *ú(MED1)(MED2)(MED3)a(A) ;


 
{ forms ending on -e; hable/come - hábleme/cómese }


*a(OE)(MED1)(UU)e + (A)  ::  *á(OE)(MED1)(UU)e(A) ;

*e(OE)(MED1)(UU)e + (A)  ::  *é(OE)(MED1)(UU)e(A) ;

*o(OE)(MED1)(UU)e + (A)  ::  *ó(OE)(MED1)(UU)e(A) ;  


*a(OE)(MED1)(MED2)(UU)e + (A)  ::  *á(OE)(MED1)(MED2)(UU)e(A) ;

*e(OE)(MED1)(MED2)(UU)e + (A)  ::  *é(OE)(MED1)(MED2)(UU)e(A) ;

*o(OE)(MED1)(MED2)(UU)e + (A)  ::  *ó(OE)(MED1)(MED2)(UU)e(A) ;  


*a(OE)(MED1)(MED2)(MED3)(UU)e + (A)  ::  *á(OE)(MED1)(MED2)(MED3)e(UU)(A) ;

*e(OE)(MED1)(MED2)(MED3)(UU)e + (A)  ::  *é(OE)(MED1)(MED2)(MED3)e(UU)(A) ;

*o(OE)(MED1)(MED2)(MED3)(UU)e + (A)  ::  *ó(OE)(MED1)(MED2)(MED3)(UU)e(A) ;  



*ae + (A)  ::  *áe(A) ;

*ee + (A)  ::  *ée(A) ;

*oe + (A)  ::  *óe(A) ;  


*a(MED1)(UU)e + (A)  ::  *á(MED1)(UU)e(A) ;

*e(MED1)(UU)e + (A)  ::  *é(MED1)(UU)e(A) ;

*i(MED1)(UU)e + (A)  ::  *í(MED1)(UU)e(A) ;

*o(MED1)(UU)e + (A)  ::  *ó(MED1)(UU)e(A) ;  

*u(MED1)(UU)e + (A)  ::  *ú(MED1)(UU)e(A) ;



*a(MED1)(MED2)(UU)e + (A)  ::  *á(MED1)(MED2)(UU)e(A) ;

*e(MED1)(MED2)(UU)e + (A)  ::  *é(MED1)(MED2)(UU)e(A) ;

*i(MED1)(MED2)(UU)e + (A)  ::  *í(MED1)(MED2)(UU)e(A) ;

*o(MED1)(MED2)(UU)e + (A)  ::  *ó(MED1)(MED2)(UU)e(A) ;  

*u(MED1)(MED2)(UU)e + (A)  ::  *ú(MED1)(MED2)(UU)e(A) ;


*a(MED1)(MED2)(MED3)(UU)e + (A)  ::  *á(MED1)(MED2)(MED3)(UU)e(A) ;

*e(MED1)(MED2)(MED3)(UU)e + (A)  ::  *é(MED1)(MED2)(MED3)(UU)e(A) ;

*i(MED1)(MED2)(MED3)(UU)e + (A)  ::  *í(MED1)(MED2)(MED3)(UU)e(A) ;

*o(MED1)(MED2)(MED3)(UU)e + (A)  ::  *ó(MED1)(MED2)(MED3)(UU)e(A) ;  

*u(MED1)(MED2)(MED3)(UU)e + (A)  ::  *ú(MED1)(MED2)(MED3)(UU)e(A) ;



{ 1st person pl.; hablemos - hablémosle }

*emos + (A1)  ::  *émos(A1) ;

*amos + (A1)  ::  *ámos(A1) ;


*emos + nos  ::  *émonos ;

*amos + nos  ::  *ámonos ;


{ 2nd person plural; hablad - habladle }

*ad + (A2)  ::  *ad(A2) ;

*ed + (A2)  ::  *ed(A2) ;

*id + (A2)  ::  *id(A2) ;


{ lavados --> lavaos }

*ad + os  :: *aos ;

*ed + os  :: *eos ;

*id + os  :: *íos ;    { accent! }


{ 3rd person plural; coman - cómanlo } 


*a(OE)(MED1)an + (A)  ::  *á(OE)(MED1)an(A) ;

*e(OE)(MED1)an + (A)  ::  *é(OE)(MED1)an(A) ;

*o(OE)(MED1)an + (A)  ::  *ó(OE)(MED1)an(A) ; 


*a(OE)(MED1)(MED2)an + (A)  ::  *á(OE)(MED1)(MED2)an(A) ;

*e(OE)(MED1)(MED2)an + (A)  ::  *é(OE)(MED1)(MED2)an(A) ;

*o(OE)(MED1)(MED2)an + (A)  ::  *ó(OE)(MED1)(MED2)an(A) ; 


*a(OE)(MED1)(MED2)(MED3)an + (A)  ::  *á(OE)(MED1)(MED2)(MED3)an(A) ;

*e(OE)(MED1)(MED2)(MED3)an + (A)  ::  *é(OE)(MED1)(MED2)(MED3)an(A) ;

*o(OE)(MED1)(MED2)(MED3)an + (A)  ::  *ó(OE)(MED1)(MED2)(MED3)an(A) ; 


*aan + (A)  ::  *áan(A) ;

*ean + (A)  ::  *éan(A) ;

*oan + (A)  ::  *óan(A) ; 


*a(MED1)an + (A)  ::  *á(MED1)an(A) ;

*e(MED1)an + (A)  ::  *é(MED1)an(A) ;

*i(MED1)an + (A)  ::  *í(MED1)an(A) ;

*o(MED1)an + (A)  ::  *ó(MED1)an(A) ; 

*u(MED1)an + (A)  ::  *ú(MED1)an(A) ;



*a(MED1)(MED2)an + (A)  ::  *á(MED1)(MED2)an(A) ;

*e(MED1)(MED2)an + (A)  ::  *é(MED1)(MED2)an(A) ;

*i(MED1)(MED2)an + (A)  ::  *í(MED1)(MED2)an(A) ;

*o(MED1)(MED2)an + (A)  ::  *ó(MED1)(MED2)an(A) ; 

*u(MED1)(MED2)an + (A)  ::  *ú(MED1)(MED2)an(A) ;


*a(MED1)(MED2)(MED3)an + (A)  ::  *á(MED1)(MED2)(MED3)an(A) ;

*e(MED1)(MED2)(MED3)an + (A)  ::  *é(MED1)(MED2)(MED3)an(A) ;

*i(MED1)(MED2)(MED3)an + (A)  ::  *í(MED1)(MED2)(MED3)an(A) ;

*o(MED1)(MED2)(MED3)an + (A)  ::  *ó(MED1)(MED2)(MED3)an(A) ; 

*u(MED1)(MED2)(MED3)an + (A)  ::  *ú(MED1)(MED2)(MED3)an(A) ;



{ hablen - háblenle }


*a(OE)(MED1)(UU)en + (A)  ::  *á(OE)(MED1)(UU)en(A) ;

*e(OE)(MED1)(UU)en + (A)  ::  *é(OE)(MED1)(UU)en(A) ;

*o(OE)(MED1)(UU)en + (A)  ::  *ó(OE)(MED1)(UU)en(A) ; 


*a(OE)(MED1)(MED2)(UU)en + (A)  ::  *á(OE)(MED1)(MED2)(UU)en(A) ;

*e(OE)(MED1)(MED2)(UU)en + (A)  ::  *é(OE)(MED1)(MED2)(UU)en(A) ;

*o(OE)(MED1)(MED2)(UU)en + (A)  ::  *ó(OE)(MED1)(MED2)(UU)en(A) ; 


