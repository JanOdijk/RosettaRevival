\begin{verbatim}
% FILTER Fpreinfrelcontrol
< m :CN{CNrec1}[I1:mu1]
>
  
   MATCHCONDITIONS
      <
       I1: EXIST(mu1, [../I11::SENTENCE{SENTENCErec1}[I12:mu2 ]])
           I11: SENTENCErec1.finiteness = infinite AND
                SENTENCErec1.mood = relative
           I12: NOT EXIST(mu2,[subjrel/..])
      >

         <
          C1: true
          A1: @
         >
  
&
