\newpage
\begin{verbatim}
% RULE RcardTOnp        
< 
   m1: CARD{CARDrec1} [mu1]
>

< 
   m : NP{NPrec1}
         [
          head/CARD{CARDrec1} [mu1]
         ]
>
      COMP
         <
          C1:True
          A1:NPrec1 := 
                         { 
                           req           : [pospol,negpol,omegapol]
                           env           : [pospol,negpol,omegapol]
                           supertiempo   : omegatiempo
                           class         : reference
                           tiempo        : omegatiempo
                           aspecto       : perfectivo
                           retro         : false
                           persona       : 3
                           genero        : masc
                           actsubcs      : [othernoun]
                           temporal      : true
                           animate       : noanimate
                           human         : nohuman
                           actcomas      : [count]
                           mood          : declxpmood
                           numero        : singular
                           definite      : def
                           generic       : nogeneric
                           thetanp       : omegathetanp
                           nounpatternefs: [] 
                           posspred      : true
                           possnietnp    : false
                           syntquant     : omegaquant
                           NPhead        : cardnp 
                           SpecQ         : yesspec
                           DefSpec       : false     
                           cases         : []
                         }                            
                      
         >
      DECOMP
         <
          C1: NPrec1 =
                        { 
                           req           : [pospol,negpol,omegapol]
                           env           : [pospol,negpol,omegapol]
                           supertiempo   : omegatiempo
                           class         : reference
                           tiempo        : omegatiempo
                           aspecto       : perfectivo
                           retro         : false
                           persona       : 3
                           genero        : masc
                           actsubcs      NI othernoun
                           temporal      : true
                           animate       : noanimate
                           human         : nohuman
                           actcomas      NI count
                           mood          : declxpmood
                           numero        : singular
                           definite      : def
                           generic       : nogeneric
                           thetanp       : omegathetanp
                           nounpatternefs: [] 
                           posspred      : true
                           possnietnp    : false
                           syntquant     : omegaquant
                           NPhead        : cardnp
                           SpecQ         : yesspec
                           DefSpec       : false     
                           cases         : []
                         }
          A1: @   
         >

&

\end{verbatim}
