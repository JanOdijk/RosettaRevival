% TRANSFORMATION TNPqpcomplextrapos
< m1: NP{NPrec1}[mu1,
                 detrel/DETP{DETPrec1}
                             [head/QP{QPrec1}[mu2,
                                              I1:rel1/T1
                                             ]
                             ],
                 mu4
                 ]
>
< m : NP{NPrec1}[mu1,
                 detrel/DETP{DETPrec1}
                             [head/QP{QPrec1}[mu2]],
                 mu4,
                 I2:extraposrel/T1
                 ]
>

   MATCHCONDITIONS
      <
       I1: (rel1 IN [decomplrel] AND  T1.CAT IN [PREPP]) OR
           (rel1 IN [thanascomplrel] AND T1.CAT IN [THANP])
       I2: T1.CAT IN [PREPP, THANP]

      >
<
   SUBRULE
      <T1: PREPP{PREPPrec1}[mu6] >
      <T1: PREPP{PREPPrec1}[mu6] >

      COMP
         <
          C1: QPrec1.thanas IN [decompl, quecompl]
          A1: @
         >
      DECOMP
         <
          C1: QPrec1.thanas IN [decompl, quecompl]
          A1: rel1 := decomplrel
         >

   SUBRULE
      <T1: THANP{THANPrec1}[mu7] >
      <T1: THANP{THANPrec1}[mu7] >

      COMP
         <
          C1: QPrec1.thanas IN [quecompl]
          A1: @
         >
      DECOMP
         <
          C1: QPrec1.thanas IN [quecompl]
          A1: rel1 := thanascomplrel
         >
>
&

\end{verbatim}
