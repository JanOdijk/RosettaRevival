\newpage
\begin{verbatim}
% TRANSFORMATION TObjectok3d (* active, not-ergative, no subject,  bonus -1 *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             I4:mu7,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      I5:head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I3: mu1,
             subjrel/NP{NPrec1}
                       [head/INDEFPRO(KEY_unoindefprokey){INDEFPROrec1}],
             I4: mu7,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      I5:head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice = active) AND
           (CLAUSErec1.thetavp IN [vp100,vp120, vp123])
       I3:  ALL (mu1, I31:rel1/..)
       I31: rel1 IN AUX_presubjrels
       I4:  NOT EXIST (mu7, [subjrel/..]) AND
            NOT EXIST (mu7, [I41:rel2/..])
       I41: rel2 IN AUX_presubjrels
       I5: VERBrec1.reflexivity = reflexive
      >

      COMP
         <
          C1: true
          A1: NPrec1.NPhead := unoNP;
              NPrec1.persona := 3;
              NPrec1.numero := singular;

              (* the other values are default *)

         >

      DECOMP
         <
          C1: (NPrec1 = NPrecdef EXCEPT FOR [NPhead, persona, numero]) AND
              (NPrec1.NPhead = unoNP) AND
              (NPrec1.persona = 3) AND
              (NPrec1.numero = singular)

          A1: @
         >


&

\end{verbatim}
