(*MPD:::===================================================================*
 *
 *  Rosetta Project                                                 
 *                                                                  
 *  Module Title    : LSSTREE 
 *  Creation date   :                                               
 *  Author          :                                               
 *                                                                  
 *  Copyright (c) 1985, by Nederlandse Philips Bedrijven BV.        
 *                                                                  
 *  Remarks         :  This module defines the abstract datatype S-trees.
 *                     The S-trees defined here are completely
 *                     language independent. In order to accomplish this
 *                     a kind of trick has been used. For each language
 *                     there will be a module LS-STREE, in which the
 *                     language specific parts are defined explicitely.
 *                     If S-trees are passed from language specific modules
 *                     to language independent modules a CAST operation 
 *                     transforms the LS-Strees into the LI-Strees.
 *
 *EMP:::===================================================================*)

pragma C_include('listree.pf');
pragma C_include('lsdomaint.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE LSSTREE;
WITH LISTREE, LSDOMAINT;

TYPE

(*MPT:::===================================================================*
 *
 *  Type name      : LSSTREE_pStree
 *  Description    : Pointer to S-tree
 *
 *EMP:::===================================================================*)
   LSSTREE_pStree   = ^LSSTREE_Stree;

(*MPT:::===================================================================*
 *
 *  Type name      : LSSTREE_Prelnode
 *  Description    : Pointer to relation node
 *
 *EMP:::===================================================================*)
   LSSTREE_pRelNode = ^LSSTREE_RelNode;

(*MPT:::===================================================================*
 *
 *  Type name      : LSSTREE_stree
 *  Description    : This is the LI definition of an S-tree.
 *
 *                           LSSTREE_stree
 *                           +-----+
 *                           |     |
 *                           |     |
 *                           +-----+
 *                              |
 *                              |                    LSSTREE_relnode
 *                           +-----+     +-----+     +-----+
 *                           |     |---->|     |---->|     |
 *                           +-----+     +-----+     +-----+
 *                              |           |           |
 *                              |           |           |
 *
 *EMP:::===================================================================*)
   LSSTREE_Stree = RECORD cat  : LSDOMAINT_syntcat;
                          sons : LSSTREE_pRelNode;
                          twin : LSSTREE_pstree;
                          LI   : LISTREE_pLIrecord;
                          LS   : LSDOMAINT_pLSrecord
                   END;

(*MPT:::===================================================================*
 *
 *  Type name      : LSSTREE_relnode
 *  Description    : Definition of relation-node
 *
 *EMP:::===================================================================*)
   LSSTREE_RelNode = RECORD node     : LSSTREE_pStree;
                            brother  : LSSTREE_pRelNode;
                            relation : LSDOMAINT_synrel
                     END;

END{LSSTREE};
