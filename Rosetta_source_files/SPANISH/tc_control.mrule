\begin{verbatim}
% TRANSFORMATION TNOControl7  
                              (* CLOSEDADVPPROP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      I2:rel1/CLOSEDADVPPROP{CLOSEDADVPPROPrec1}
                             [ subjrel/T1,
                               predrel/ADVP{ADVPrec1}[mu3]
                             ],
                      mu4
                    ],
             mu5 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      objrel/T1,
                      I3:rel2/ADVP{ADVPrec1}[mu3],
                      mu4
                    ],
             mu5 
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [objrel/..])
       I2: rel1 IN [locargrel,dirargrel,complrel]
       I3: rel2 IN [locargrel,dirargrel, predrel]
      >

<
   SUBRULE
      <T1:NP{NPrec1}[mu6] >
      <T1:NP{NPrec1}[mu6] >


      COMP
         <
          C1: ( CLOSEDADVPPROPrec1 =
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : ADVPrec1.aspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : false
		   }
              )                     AND
              CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP] <> []
              C11: rel1 = locargrel
              A11: rel2 := locargrel;
              C12: rel1 = dirargrel
              A12: rel2 := dirargrel;
              C13: rel1 = complrel
              A13: rel2 := predrel;
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP] <> [])

              C11: rel2 = locargrel
              A11: rel1 := locargrel;
              C12: rel2 = dirargrel
              A12: rel1 := dirargrel;
              C13: rel2 = predrel
              A13: rel1 := complrel;
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
              [synDIRCLOSEDPREPPPROP,
               synLOCCLOSEDPREPPPROP];
              CLOSEDADVPPROPrec1 :=
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : ADVPrec1.aspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : false
		   }
         >


   SUBRULE
      <T1: T2 >
      <T1: T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [ NPVAR, CNVAR]
      >


      COMP
         <
          C1: ( CLOSEDADVPPROPrec1 =
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : ADVPrec1.aspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : false
		   }
              )  AND
                (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                        synLOCCLOSEDPREPPPROP] <> [])
              C11: rel1 = locargrel
              A11: rel2 := locargrel;
              C12: rel1 = dirargrel
              A12: rel2 := dirargrel;
              C13: rel1 = complrel
              A13: rel2 := predrel;
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDIRCLOSEDPREPPPROP,
                                      synLOCCLOSEDPREPPPROP] <> [])
              C11: rel2 = locargrel
              A11: rel1 := locargrel;
              C12: rel2 = dirargrel
              A12: rel1 := dirargrel;
              C13: rel2 = predrel
              A13: rel1 := complrel;
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
              [synDIROPENPREPPPROP,
               synLOCOPENPREPPPROP];
              CLOSEDADVPPROPrec1 :=
		   {
                    Qstatus       : ADVPrec1.Qstatus
		    class         : ADVPrec1.class
		    tiempo        : ADVPrec1.tiempo
		    aspecto       : ADVPrec1.aspecto
		    retro         : ADVPrec1.retro
		    aktionsarts   : [stative] 
		    supertiempo   : omegatiempo
		    actsubcefs    : ADVPrec1.actsubcefs
                    mood          : ADVPrec1.mood
		    thetaadv      : ADVPrec1.thetaadv
		    advpatternefs : ADVPrec1.advpatternefs
                    temporal      : ADVPrec1.temporal
                    thanas        : ADVPrec1.thanas
                    thanascompl   : ADVPrec1.thanascompl
		    PROsubject    : false
		   }
         >
>
&

\end{verbatim}
