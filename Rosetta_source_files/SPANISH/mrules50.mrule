\begin{description}
\item[* name:] RADJpastsuperdeixis
\item[* relevant examples:] vi (el hombre (enfermo))
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] ADJPPPROPtoADJPFORMULA
\item[* class:] Superdeixis rules
\item[* date of creation:] 23-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] RADJpastsuperdeixis dutch
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] The relation between Rs and S is before: PAST.
               This rule is for a dependent ADJPFORMULA.
               Temporal adverbials are not allowed.
               The ADJPFORMULA is marked for past superdeixis.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] 
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: rules that introduce the 
reference adverbial; the superdeixis value is assigned in analysis during(?) 
desubstitution \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The superdeixis value also may be pastdeixis in the case 
this sentence is a sentence with {\em graag}\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% TRANSFORMATION TADJsuperdeixisadaptation1
< m1:ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [mu2,
                    I1:rel1/T1, 
                    mu4
                   ],
            mu5
           ]
>

< m :ADJPFORMULA{ADJPFORMULArec1}
           [mu1,
            predrel/ADJP{ADJPrec1}
                   [mu2, 
                    I1:rel1/T2, 
                    mu4
                   ],
            mu5
           ]

>
   MATCHCONDITIONS
      <
       I1: rel1 IN AUX_sentencerels OR
           rel1 IN [degreemodrel, paraobjrel]
      >

<
   SUBRULE (* 1 SENTENCE *)
      <T1: SENTENCE{SENTENCErec1}[mu3] >
      <T2: SENTENCE{SENTENCErec2}[mu3] >

      COMP
         <
          C1:true
             C11:((SENTENCErec1.supertiempo = omegatiempo) AND
                  ((SENTENCErec1.tiempo = presente) OR
                   (SENTENCErec1.tiempo = pasado) OR
                   (SENTENCErec1.tiempo = omegatiempo)
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

             C12:true
                  
                 C121: (SENTENCErec1.supertiempo = presente) AND
                       (SENTENCErec1.tiempo = omegatiempo) AND
                       (
                        (
                         (ADJPFORMULArec1.tiempo = presente) AND
                         (ADJPFORMULArec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (ADJPFORMULArec1.tiempo = omegatiempo) AND
                         (ADJPFORMULArec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := presente;

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: SENTENCErec2 := SENTENCErec1;

                 A121: SENTENCErec2.supertiempo := omegatiempo;

                 C122:(SENTENCErec1.tiempo = omegatiempo) AND
                      (SENTENCErec1.supertiempo = pasado) AND
                       (
                        (
                         (ADJPFORMULArec1.tiempo = pasado) AND
                         (ADJPFORMULArec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (ADJPFORMULArec1.tiempo = omegatiempo) AND
                         (ADJPFORMULArec1.supertiempo = pasado)
                        )
                       )
                       C1211: (SENTENCErec1.finiteness = finite)
                       A1211: SENTENCErec2 := SENTENCErec1;
                              SENTENCErec2.tiempo := pasado;

                       C1212: (SENTENCErec1.finiteness = infinite)
                       A1212: SENTENCErec2 := SENTENCErec1;

                 A122: SENTENCErec2.supertiempo := omegatiempo;
                       
              A12: @

          A1: @
         >

      DECOMP
         <
          C1:true
             C11:((SENTENCErec2.supertiempo = omegatiempo) AND
                  ((SENTENCErec2.tiempo = presente) OR
                   (SENTENCErec2.tiempo = pasado) OR
                   (SENTENCErec2.tiempo = omegatiempo)
                  )
                 )
             A11: SENTENCErec2 := SENTENCErec1;

             C12:true
                  
                 C121: (SENTENCErec2.supertiempo = omegatiempo) AND
                       (
                        (
                         (ADJPFORMULArec1.tiempo = presente) AND
                         (ADJPFORMULArec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (ADJPFORMULArec1.tiempo = omegatiempo) AND
                         (ADJPFORMULArec1.supertiempo = presente)
                        )
                       )
                       C1211: (SENTENCErec2.tiempo = presente) AND
                              (SENTENCErec2.finiteness = finite)
                       A1211: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1212: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1212: SENTENCErec1 := SENTENCErec2;

                A121: SENTENCErec1.supertiempo := presente;

                 C122:(SENTENCErec2.supertiempo = omegatiempo) AND
                       (
                        (
                         (ADJPFORMULArec1.tiempo = pasado) AND
                         (ADJPFORMULArec1.supertiempo = omegatiempo)
                        ) OR
                        (
                         (ADJPFORMULArec1.tiempo = omegatiempo) AND
                         (ADJPFORMULArec1.supertiempo = pasado)
                        )
                       )
                       C1221: (SENTENCErec2.tiempo = pasado) AND
                              (SENTENCErec2.finiteness = finite)
                       A1211: SENTENCErec1 := SENTENCErec2;
                              SENTENCErec1.tiempo := omegatiempo;

                       C1212: (SENTENCErec2.tiempo = omegatiempo) AND
                              (SENTENCErec2.finiteness = infinite)
                       A1212: SENTENCErec1 := SENTENCErec2;

                 A122: SENTENCErec1.supertiempo := pasado;
                       

              A12: @

          A1: @
         >

   SUBRULE (* 2 ADVP*)
      <T1: ADVP{ADVPrec1}[mu3] >
      <T2: ADVP{ADVPrec2}[mu3] >

      COMP
         <
          C1:true
             C11: (ADVPrec1.supertiempo = presente) AND
                  (
                   (
                    (ADJPFORMULArec1.tiempo = presente) AND
                    (ADJPFORMULArec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (ADJPFORMULArec1.tiempo = omegatiempo) AND
                    (ADJPFORMULArec1.supertiempo = presente)
                   )
                  )
              A11: ADVPrec2 := ADVPrec1;
                   ADVPrec2.supertiempo := omegatiempo;

              C12: (ADVPrec1.supertiempo = pasado) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = pasado) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = pasado)
                    )
                   )
               A12: ADVPrec2 := ADVPrec1;
                    ADVPrec2.supertiempo := omegatiempo;
          A1: @
         >

      DECOMP
         <
          C1: true
              C11: (ADVPrec2.supertiempo = omegatiempo) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = presente) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = presente)
                    )
                   )
                A11: ADVPrec1 := ADVPrec2;
                     ADVPrec1.supertiempo := presente;

                C12:(ADVPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (ADJPFORMULArec1.tiempo = pasado) AND
                      (ADJPFORMULArec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (ADJPFORMULArec1.tiempo = omegatiempo) AND
                      (ADJPFORMULArec1.supertiempo = pasado)
                     )
                    )
                 A12: ADVPrec1 := ADVPrec2;
                      ADVPrec1.supertiempo := pasado;
                       
          A1: @
         >

   SUBRULE (* 3 PREPP *)
      <T1: PREPP{PREPPrec1}[mu3] >
      <T2: PREPP{PREPPrec2}[mu3] >

      COMP
         <
          C1:true
             C11: (PREPPrec1.supertiempo = presente) AND
                  (
                   (
                    (ADJPFORMULArec1.tiempo = presente) AND
                    (ADJPFORMULArec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (ADJPFORMULArec1.tiempo = omegatiempo) AND
                    (ADJPFORMULArec1.supertiempo = presente)
                   )
                  )
              A11: PREPPrec2 := PREPPrec1;
                   PREPPrec2.supertiempo := omegatiempo;

              C12: (PREPPrec1.supertiempo = pasado) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = pasado) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = pasado)
                    )
                   )
               A12: PREPPrec2 := PREPPrec1;
                    PREPPrec2.supertiempo := omegatiempo;
          A1: @
         >

      DECOMP
         <
          C1: true
              C11: (PREPPrec2.supertiempo = omegatiempo) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = presente) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = presente)
                    )
                   )
                A11: PREPPrec1 := PREPPrec2;
                     PREPPrec1.supertiempo := presente;

                C12:(PREPPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (ADJPFORMULArec1.tiempo = pasado) AND
                      (ADJPFORMULArec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (ADJPFORMULArec1.tiempo = omegatiempo) AND
                      (ADJPFORMULArec1.supertiempo = pasado)
                     )
                    )
                 A12: PREPPrec1 := PREPPrec2;
                      PREPPrec1.supertiempo := pasado;
                       
          A1: @
         >

   SUBRULE (* 4 QP *)
      <T1: QP{QPrec1}[mu3] >
      <T2: QP{QPrec2}[mu3] >

      COMP
         <
          C1:true
             C11: (QPrec1.supertiempo = presente) AND
                  (
                   (
                    (ADJPFORMULArec1.tiempo = presente) AND
                    (ADJPFORMULArec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (ADJPFORMULArec1.tiempo = omegatiempo) AND
                    (ADJPFORMULArec1.supertiempo = presente)
                   )
                  )
              A11: QPrec2 := QPrec1;
                   QPrec2.supertiempo := omegatiempo;

              C12: (QPrec1.supertiempo = pasado) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = pasado) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = pasado)
                    )
                   )
               A12: QPrec2 := QPrec1;
                    QPrec2.supertiempo := omegatiempo;
          A1: @
         >

      DECOMP
         <
          C1: true
              C11: (QPrec2.supertiempo = omegatiempo) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = presente) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = presente)
                    )
                   )
                A11: QPrec1 := QPrec2;
                     QPrec1.supertiempo := presente;

                C12:(QPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (ADJPFORMULArec1.tiempo = pasado) AND
                      (ADJPFORMULArec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (ADJPFORMULArec1.tiempo = omegatiempo) AND
                      (ADJPFORMULArec1.supertiempo = pasado)
                     )
                    )
                 A12: QPrec1 := QPrec2;
                      QPrec1.supertiempo := pasado;
                       
          A1: @
         >

   SUBRULE (* 5 NP *)
      <T1: NP{NPrec1}[mu3] >
      <T2: NP{NPrec2}[mu3] >

      COMP
         <
          C1:true
             C11: (NPrec1.supertiempo = presente) AND
                  (
                   (
                    (ADJPFORMULArec1.tiempo = presente) AND
                    (ADJPFORMULArec1.supertiempo = omegatiempo)
                   ) OR
                   (
                    (ADJPFORMULArec1.tiempo = omegatiempo) AND
                    (ADJPFORMULArec1.supertiempo = presente)
                   )
                  )
              A11: NPrec2 := NPrec1;
                   NPrec2.supertiempo := omegatiempo;

              C12: (NPrec1.supertiempo = pasado) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = pasado) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = pasado)
                    )
                   )
               A12: NPrec2 := NPrec1;
                    NPrec2.supertiempo := omegatiempo;
          A1: @
         >

      DECOMP
         <
          C1: true
              C11: (NPrec2.supertiempo = omegatiempo) AND
                   (
                    (
                     (ADJPFORMULArec1.tiempo = presente) AND
                     (ADJPFORMULArec1.supertiempo = omegatiempo)
                    ) OR
                    (
                     (ADJPFORMULArec1.tiempo = omegatiempo) AND
                     (ADJPFORMULArec1.supertiempo = presente)
                    )
                   )
                A11: NPrec1 := NPrec2;
                     NPrec1.supertiempo := presente;

                C12:(NPrec2.supertiempo = omegatiempo) AND
                    (
                     (
                      (ADJPFORMULArec1.tiempo = pasado) AND
                      (ADJPFORMULArec1.supertiempo = omegatiempo)
                     ) OR
                     (
                      (ADJPFORMULArec1.tiempo = omegatiempo) AND
                      (ADJPFORMULArec1.supertiempo = pasado)
                     )
                    )
                 A12: NPrec1 := NPrec2;
                      NPrec1.supertiempo := pasado;
                       
          A1: @
         >

>
&

\end{verbatim}
