           END;
        END;
        itemnumber:=Staticnumberofitems;
        ItemIds1:=ItemIds;
        i:=1;
        WHILE i <= StaticNumberOfItems  DO
          BEGIN
            indent:=indent-2;
            IF NOT(righttoleftmatch) THEN
              GetLastItem(itemIds1,ItemId,ItemNumber)
            ELSE takeitemId(itemid,itemIds1);
            levelid:=itemid.levelid;
   IF NOT( bounded OR RM OR MR OR M OR MMUM OR RMUM OR MUMR OR MUM OR MRM OR MUMUM OR
      (inexist AND (i=1)) OR 
      (labeled AND (i=staticnumberofitems)) OR
      righttoleftmatch) AND
      (((itemid.minnum=0) AND (itemid.maxnum=1) AND NOT(itemid.issublist)) OR
      ((itemid.minnum=0) AND (itemid.maxnum>100) AND NOT(itemid.issublist)) OR
      ((itemid.minnum=1) AND (itemid.maxnum=1))) THEN
      BEGIN {normal cases}
      IF (itemid.minnum=0) AND (itemid.maxnum=1) THEN 
         BEGIN
         "BEGIN LSMATCHES_matchlistsigma"\\ "(L,first,match,match_"
         ""itemid.str"" ",matchlist" """i-1""" 
         "items,"\\
         "Llast" ""levelid"" ",Lfirst" ""levelid""
         ",Lrest" ""levelid"" ",nomoretrees" ""levelid""
         ",i" ""levelid"" ") END;"\\
         END;
      IF (itemid.minnum=0) AND (itemid.maxnum>100) THEN 
         BEGIN
         "BEGIN LSMATCHES_matchlistmu"\\ "(L,first,match,match_"
         ""itemid.str"" ",matchlist" """i-1""" 
         "items,"\\
         "Llast" ""levelid"" ",Lfirst" ""levelid""
         ",Lrest" ""levelid"" ",nomoretrees" ""levelid""
         ") END;"\\
         END;
      IF (itemid.minnum=1) AND (itemid.maxnum=1) THEN 
         BEGIN
         "BEGIN LSMATCHES_matchlistreltree"\\ "(L,first,match,match_"
         ""itemid.str"" ",matchlist" """i-1""" 
         "items,"\\
         "Llast" ""levelid"" ",Lfirst" ""levelid""
         ",Lrest" ""levelid"" ",nomoretrees" ""levelid""
         ") END;"\\
         END;
      END; {normal cases}
   IF bounded OR 
      (inexist AND (i=1)) OR 
      (labeled AND (i=staticnumberofitems)) OR
      righttoleftmatch OR
      NOT (((itemid.minnum=0) AND (itemid.maxnum=1) AND NOT(itemid.issublist)) OR
      ((itemid.minnum=0) AND (itemid.maxnum>100) AND NOT(itemid.issublist)) OR
      ((itemid.minnum=1) AND (itemid.maxnum=1))) THEN
      BEGIN {special cases}
            BEGIN \leftcom.\LOCAL.END;
            BEGIN
              LOCALTAB(leftcom,indent);
              "BEGIN {MatchList";"""i""";"Items}"\\
              LOCALTAB(leftcom,indent+2);
              "match:=FALSE;"\\
              IF shorthandpresent THEN BEGIN
                ""shorthand"" ".first:=L;"\\
                ""shorthand"" ".last:=NIL;"\\
                IF bounded THEN BEGIN
                  ""shorthand"" ".last:=Lfinal;"\\
                END;
              END;
              LOCALTAB(leftcom,indent+2);
              "IF first THEN"\\
              LOCALTAB(leftcom,indent+4);
              "BEGIN "\\
              LOCALTAB(leftcom,indent+2);
              "nomoretrees" ""levelid"" ":=False;"\\
              IF righttoleftmatch THEN
               BEGIN
               IF i=staticnumberofitems THEN
                BEGIN
                IF bounded THEN
                  BEGIN
                  LOCALTAB(leftcom,indent+4);
                  "Lrest" ""levelid"" ":=Lfinal;"\\
                  END
                ELSE
                  BEGIN
                  LOCALTAB(leftcom,indent+4);
                  "Lrest" ""levelid"" ":=L;"\\
                  LOCALTAB(leftcom,indent+4);
                  "IF Lrest" ""levelid"" "<>NIL THEN"\\
                  LOCALTAB(leftcom,indent+6);
                  "WHILE Lrest" ""levelid"" "^.brother<>NIL DO"\\
                  LOCALTAB(leftcom,indent+8);
                  "BEGIN"\\
                  LOCALTAB(leftcom,indent+8);
                  "Lrest" ""levelid"" ":=Lrest" 
                      ""levelid"" "^.brother"\\
                  LOCALTAB(leftcom,indent+8);
                  "END;"\\
                  END;
                LOCALTAB(leftcom,indent+4);
                "Linit" ""Linitid"" ":=L;"\\
                END
               ELSE 
                BEGIN
                LOCALTAB(leftcom,indent+4);
                "Lrest" ""levelid"" ":=L;"\\
                LOCALTAB(leftcom,indent+4);
                "L:=Linit" ""Linitid"" ";"\\
                END
               END;
              LOCALTAB(leftcom,indent+4);
              IF (ItemId.minnum=0) and not(righttoleftmatch) THEN 
                BEGIN "Llast" ""levelid"" 
                      ":=NIL;Lrest" ""levelid"" ":=L;" END;
              "Lfirst" ""levelid"" ":=NIL;"\\
              j:=0;
              WHILE j<>itemId.minnum DO
                BEGIN
                j:=j+1;
                IF j>1 THEN
                 BEGIN
                 LOCALTAB(leftcom,indent+4);
                 "IF NOT nomoretrees" ""levelid"" " THEN " \\
                 LOCALTAB(leftcom,2)
                 END;
                LOCALTAB(leftcom,indent+4);
                IF NOT(righttoleftmatch) then
                   BEGIN
                   "SelectLfirstAndLlast(Lfirst" ""levelid"" ",Llast"
                    ""levelid"" ",Lrest"
                    ""levelid""\\ ",nomoretrees"
                    ""levelid"" ",L);"\\
                   IF bounded THEN
                     BEGIN
                     LOCALTAB(leftcom,indent+4);
                     "IF Llast" ""levelid"" 
                        "=Lfinal THEN Lrest" ""levelid"" ":=NIL;"\\
                     END;
                   END
                ELSE 
                   BEGIN
                   "TcelesLfirstAndLlast(Lfirst" ""levelid"" ",Llast"
                     ""levelid"" ",Lrest"
                     ""levelid"" \\",nomoretrees"
                     ""levelid"" ",L);"\\
                   END
                END;
              IF ItemId.minnum=ItemId.maxnum THEN
                BEGIN
                LOCALTAB(leftcom,indent+4);
                "IF NOT nomoretrees" ""levelid"" " THEN" \\
                LOCALTAB(leftcom,indent+6);
                "BEGIN" \\
                LOCALTAB(leftcom,indent+6);
                "Match_";""ItemId.str"";"(Lfirst" ""levelid"" 
                    ",Llast" ""levelid"" ",TRUE,itemmatch);"\\
                LOCALTAB(leftcom,indent+6);
            IF NOT((i=1) AND inexist) THEN
              BEGIN
                "IF itemmatch THEN"\\
                IF NOT (bounded and (i=1) and not(righttoleftmatch)) THEN
                  BEGIN
                  LOCALTAB(leftcom,indent+8);
                  "MatchList";"""i-1""";"Items(Lrest"
                   ""levelid"" ",TRUE,listmatch);"\\
                  END
                ELSE
                  BEGIN
                  LOCALTAB(leftcom,indent+8);
                  "listmatch:= (Lrest" ""levelid"" 
                    "=NIL) AND ((Lfirst" ""levelid"" "<>NIL) OR (L=NIL));"\\
                  END;
                LOCALTAB(leftcom,indent+6);
                "match:=(itemmatch AND listmatch);"\\
                LOCALTAB(leftcom,indent+6);
              END
            ELSE
              BEGIN
              "match:=itemmatch;"\\
              END;
                "END" \\
                END;
              LOCALTAB(leftcom,indent+4);
              "END"\\
              LOCALTAB(leftcom,indent+2);
              "ELSE"\\  
              LOCALTAB(leftcom,indent+2);
              "BEGIN"\\
              IF NOT righttoleftmatch THEN 
                BEGIN 
                IF bounded THEN
                  BEGIN
                  "IF Llast" ""levelid"" 
                     "=Lfinal THEN Lrest" ""levelid"" ":=NIL;"\\
                  END;
                END
              ELSE
                BEGIN
                "L:=Linit" ""Linitid"" ";"\\
                END;
              LOCALTAB(leftcom,indent+4);
              "Match_";""ItemId.str"";"(Lfirst" ""levelid"" 
                  ",Llast" ""levelid"" ",FALSE,match);"\\
              LOCALTAB(leftcom,indent+4);
            IF NOT((i=1) AND inexist) THEN
              BEGIN
              "IF NOT match THEN"\\
              LOCALTAB(leftcom,indent+6);
              "MatchList";"""i-1""";"Items(Lrest" 
                 ""levelid"" ",FALSE,match);"\\
              LOCALTAB(leftcom,indent+2);
              END;
              "END;"\\
              IF itemId.maxnum <> ItemId.minnum THEN
                BEGIN
                LOCALTAB(leftcom,indent+2);
                "IF NOT(first OR nomoretrees" ""levelid"" " OR match) THEN"\\
                LOCALTAB(leftcom,indent+4);
                IF NOT(righttoleftmatch) then
                   BEGIN
                   "SelectLfirstAndLlast(Lfirst" ""levelid"" ",Llast"
                      ""levelid"" ",Lrest"
                      ""levelid""\\ ",nomoretrees"
                      ""levelid"" ",L);"\\
                   END
                ELSE 
                   BEGIN
                   "TcelesLfirstAndLlast(Lfirst" ""levelid"" ",Llast"
                     ""levelid"" ",Lrest"
                     ""levelid"" \\ ",nomoretrees"
                     ""levelid"" ",L);"\\
                   END;
                LOCALTAB(leftcom,indent+2);
                IF ItemId.maxnum < 100 THEN 
                       BEGIN
                       "IF first THEN i" ""levelid"" 
                            ":=" """ItemId.minnum""" 
                                           ";" \\
                       LOCALTAB(leftcom,indent+2)
                       END;
                "While (NOT match) AND (NOT nomoretrees" ""levelid"" ")"
                IF ItemId.maxnum < 100 THEN 
                        BEGIN 
                        " AND (i" ""levelid"" 
                               "<=" """ItemId.maxnum""" ")" 
                        END;
                " DO"\\
                LOCALTAB(leftcom,indent+2);
                "BEGIN"\\
                IF ItemId.maxnum < 100 THEN
                       BEGIN
                       LOCALTAB(leftcom,indent+4);
                       "i" ""levelid"" ":=i"
                         ""levelid"" "+1;" \\
                       END;
                LOCALTAB(leftcom,indent+4);
                "Match_";""ItemId.str"";"(Lfirst" ""levelid"" 
                      ",Llast" ""levelid"" ",TRUE,itemmatch);"\\
                IF bounded and not(righttoleftmatch) THEN
                  BEGIN
                  LOCALTAB(leftcom,indent+4);
                  "IF Llast" ""levelid"" 
                     "=Lfinal THEN Lrest" ""levelid"" ":=NIL;"\\
                  END;
                LOCALTAB(leftcom,indent+4);
            IF NOT((i=1) AND inexist) THEN
              BEGIN
                "IF itemmatch THEN"\\
                IF NOT (bounded and (i=1) and not(righttoleftmatch)) THEN
                  BEGIN
                  LOCALTAB(leftcom,indent+6);
                  "MatchList";"""i-1""";"Items(Lrest"
                   ""levelid"" ",TRUE,listmatch);"\\
                  END
                ELSE
                  BEGIN
                  LOCALTAB(leftcom,indent+6);
                  "listmatch:=(Lrest" ""levelid"" 
                    "=NIL) AND ((Lfirst" ""levelid"" "<>NIL) OR (L=NIL));"\\
                  END;
                LOCALTAB(leftcom,indent+4);
                "match:=(itemmatch AND listmatch);"\\
                LOCALTAB(leftcom,indent+4);
              END
            ELSE
              BEGIN
              "match:=itemmatch;"\\
              END;
                "IF (NOT match) THEN"\\
                LOCALTAB(leftcom,indent+6);
                IF NOT(righttoleftmatch) THEN 
                   BEGIN
                   "SelectLfirstAndLlast(Lfirst" ""levelid"" ",Llast" 
                   ""levelid"" ",Lrest"
                   ""levelid"" \\",nomoretrees"
                   ""levelid"" ",L);"\\ 
                   END
                ELSE
                   BEGIN
                   "TcelesLfirstAndLlast(Lfirst" ""levelid"" ",Llast"
                   ""levelid"" ",Lrest"
                   ""levelid"" \\ ",nomoretrees"
                   ""levelid"" ",L);"\\
                   END;
                LOCALTAB(leftcom,indent+2);
                "END;{while}"\\
              END;
            IF bounded and (i=1) and not(righttoleftmatch) THEN
              IF NOT(inexist and (i=1)) THEN
                BEGIN
                LOCALTAB(leftcom,indent);
                "IF (Lfirst" ""levelid"" 
                "<>NIL) THEN match:=match AND (Llast" ""levelid"" "=Lfinal);" \\
                END
            END;
            IF labeled AND (i=staticnumberofitems) THEN
            BEGIN
              BEGIN \leftcom.\LOCAL. END;
              BEGIN            
                LOCALTAB(leftcom,indent+2);
                "IF match THEN IF NOT Matchcond" ""ilabel"" " THEN"\\
                LOCALTAB(leftcom,indent+4);
                "MatchList";"""i""";"Items(Lrest"
                ""levelid"" ",FALSE,match);"\\
              END;
            END;
            BEGIN \leftcom.\LOCAL. END;
            BEGIN
              LOCALTAB(leftcom,indent);
              "END;{MatchList";"""i""";"Items}"\\
            END;
     END;{special cases}
            ItemNumber:=ItemNumber-1;
            i:=i+1;
          END;
          $$BARELD.levelids:=levelids;
          $$BARELD.NumberOfItems:=StaticNumberOfItems;
          $$BARELD.leftcom:=leftcom;
          $$BARELD.rightcom:=rightcom;
          $$BARELD.dtreeproc:=dtreeproc;
      END;
END;
&
 
%ITEM
BASIS RULE
    ITEM = (LABELEDITEM/1|BAREITEM/2)
SURFACE PART
VAR setofnames,relationlist,records::SETOFidents;
    minnum,maxnum::int;issublist::bool;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,RelVarList::SETOFidents;

<*
INIT: BEGIN INITsetofidents(records);
            INITsetofidents(MuVarlist);
            INITsetofidents(SigmaVarlist);
            INITsetofidents(NodeVarlist);
            INITsetofidents(TreeVarlist);
            INITsetofidents(RelVarlist);
            INITsetofidents(Relationlist);
            minnum:=0;maxnum:=0;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN records:=%LABELEDITEM.records; 
                              MuVarlist:=%LABELEDITEM.MuVarList;
                              SigmaVarlist:=%LABELEDITEM.SigmaVarList;
                              NodeVarlist:=%LABELEDITEM.NodeVarList;
                              TreeVarlist:=%LABELEDITEM.TreeVarList;
                              RelVarlist:=%LABELEDITEM.RelVarList;
                              relationlist:=%LABELEDITEM.relationlist;
                              minnum:=%LABELEDITEM.minnum;
                              maxnum:=%LABELEDITEM.maxnum;
                              issublist:=%LABELEDITEM.issublist;
                              setofnames:=%LABELEDITEM.setofnames;
                        END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN records:=%BAREITEM.records;
                              MuVarlist:=%BAREITEM.MuVarList;
                              SigmaVarlist:=%BAREITEM.SigmaVarList;
                              NodeVarlist:=%BAREITEM.NodeVarList;
                              TreeVarlist:=%BAREITEM.TreeVarList;
                              RelVarlist:=%BAREITEM.RelVarList;
                              relationlist:=%BAREITEM.relationlist;
                              minnum:=%BAREITEM.minnum;
                              maxnum:=%BAREITEM.maxnum;
                              issublist:=%BAREITEM.issublist;
                              setofnames:=%BAREITEM.setofnames;
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN 
                SEND_ITEM;
                $ITEM.issublist:=issublist;
                $ITEM.setofnames:=setofnames;
                $ITEM.relationlist:=relationlist;
                $ITEM.minnum:=minnum;
                $ITEM.maxnum:=maxnum;
                $ITEM.records:=records;
                $ITEM.MuVarlist:=MuVarList;
                $ITEM.SigmaVarlist:=SigmaVarList;
                $ITEM.NodeVarlist:=NodeVarList;
                $ITEM.TreeVarlist:=TreeVarList;
                $ITEM.RelVarlist:=RelVarList;
                END
*>
END;
PROCEDURAL PART
VAR leftcom,rightcom,dtreeproc:LOCALFILE;
    identifier:TSTRING_string;
    indent:Integer;
    root,name:TSTRING_string;
    righttolefttable,levelids::setofidents;
BEGIN
INIT: BEGIN root:=$$ITEM.root;
            name:=$$ITEM.name;
            InitLOCALFILE(leftcom);
            InitLOCALFILE(rightcom);
            indent:=$$ITEM.indent;
            righttolefttable:=$$ITEM.righttolefttable;
            TSTRING_constantempty(identifier)
      END;
<*
1: <* SEND: BEGIN 
              %%LABELEDITEM.indent:=indent;
              %%LABELEDITEM.righttolefttable:=righttolefttable;
              %%LABELEDITEM.name:=name;
              %%LABELEDITEM.root:=root;
            END
      !LABELEDITEM.
      RECEIVE: BEGIN dtreeproc:=%%LABELEDITEM.dtreeproc;
                 levelids:=%%LABELEDITEM.levelids;
                 identifier:=%%LABELEDITEM.identifier;
                 AppendLocFile(%%LABELEDITEM.leftcom,leftcom);
                 AppendLocFile(%%LABELEDITEM.rightcom,rightcom);
               END
   *>
2: <* SEND: BEGIN
              %%BAREITEM.labeled:=FALSE;
              %%BAREITEM.indent:=indent;
              %%BAREITEM.righttolefttable:=righttolefttable;
              %%BAREITEM.name:=name;
              %%BAREITEM.root:=root;
            END
      !BAREITEM.
      RECEIVE: BEGIN dtreeproc:=%%BAREITEM.dtreeproc;
                 levelids:=%%BAREITEM.levelids;
                 identifier:=%%BAREITEM.identifier;
                 AppendLocFile(%%BAREITEM.leftcom,leftcom);
                 AppendLocFile(%%BAREITEM.rightcom,rightcom);
               END
   *>
*>
FINAL:BEGIN
       $$ITEM.dtreeproc:=dtreeproc;
       $$ITEM.levelids:=levelids;
       $$ITEM.leftcom:=leftcom;
       $$ITEM.rightcom:=rightcom;
       $$ITEM.identifier:=identifier
      END
END;
&
 
%LABELEDITEM
BASIS RULE
    LABELEDITEM = ILABELtje/2.DOTDOT/1.BAREITEM/3 
SURFACE PART
VAR setofnames,relationlist,records::SETOFidents;
    minnum,maxnum::int;issublist::bool;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,RelVarList::SETOFidents;

<*
INIT: BEGIN INITsetofidents(records);
            INITsetofidents(MuVarlist);
            INITsetofidents(SigmaVarlist);
            INITsetofidents(NodeVarlist);
            INITsetofidents(TreeVarlist);
            INITsetofidents(RelVarlist);
            INITsetofidents(relationlist);
            minnum:=0;maxnum:=0
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN records:=%BAREITEM.records;
                              setofnames:=%BAREITEM.setofnames;
                              MuVarlist:=%BAREITEM.MuVarList;
                              SigmaVarlist:=%BAREITEM.SigmaVarList;
                              NodeVarlist:=%BAREITEM.NodeVarList;
                              TreeVarlist:=%BAREITEM.TreeVarList;
                              RelVarlist:=%BAREITEM.RelVarList;
                              relationlist:=%BAREITEM.relationlist;
                              minnum:=%BAREITEM.minnum;
                              maxnum:=%BAREITEM.maxnum;
                              issublist:=%BAREITEM.issublist;
                         END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_LABELEDITEM;
                      $LABELEDITEM.issublist:=issublist;
                      $LABELEDITEM.setofnames:=setofnames;
                      $LABELEDITEM.relationlist:=relationlist;
                      $LABELEDITEM.minnum:=minnum;
                      $LABELEDITEM.maxnum:=maxnum;
                      $LABELEDITEM.records:=records;
                      $LABELEDITEM.MuVarlist:=MuVarList;
                      $LABELEDITEM.SigmaVarlist:=SigmaVarList;
                      $LABELEDITEM.NodeVarlist:=NodeVarList;
                      $LABELEDITEM.TreeVarlist:=TreeVarList;
                      $LABELEDITEM.RelVarlist:=RelVarList;
                END
*>
END;
PROCEDURAL PART
VAR dtreeproc,leftcom,rightcom:LOCALFILE;
    ilabel,
    identifier,root,name :TSTRING_string;
    indent:Integer;
    righttolefttable,levelids::setofidents;
    righttoleftmatch:BOOLEAN;
HELP FUNCTION labelpresent(labeltje:TSTRING_string;table::setofidents):BOOLEAN;
     VAR result:BOOLEAN;
         ident::ident;
     BEGIN
     result:=FALSE;
     WHILE stillidents(table) AND NOT(result) DO
       BEGIN
       takeident(ident,table);
       result:= (labeltje=ident.str)
       END;
     labelpresent:=result
     END;
BEGIN
INIT: BEGIN root:=$$LABELEDITEM.root;
            name:=$$LABELEDITEM.name;
            InitLOCALFILE(leftcom);
            InitLOCALFILE(rightcom);
            indent:=$$LABELEDITEM.indent;
            righttolefttable:=$$LABELEDITEM.righttolefttable;
            righttoleftmatch:=FALSE;
            TSTRING_constantempty(ilabel);
            TSTRING_constantempty(identifier)
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN  END
   *>
2: <* SEND: BEGIN END
      !ILABELtje.
      RECEIVE: BEGIN ilabel:=%%ILABELtje.ident;
                     righttoleftmatch:=labelpresent(ilabel,righttolefttable)
               END
   *>
3: <* SEND: BEGIN %%BAREITEM.labeled:=TRUE;
                  %%BAREITEM.label:=ilabel;
                  %%BAREITEM.indent:=indent;
                  %%BAREITEM.righttolefttable:=righttolefttable;
                  %%BAREITEM.righttoleftmatch:=righttoleftmatch;
                  %%BAREITEM.name:=name;
                  %%BAREITEM.root:=root;
             END
      !BAREITEM.
      RECEIVE: BEGIN dtreeproc:=%%BAREITEM.dtreeproc;
                 levelids:=%%BAREITEM.levelids;
                 identifier:=%%BAREITEM.identifier;
                 AppendLocFile(%%BAREITEM.leftcom,leftcom);
                 AppendLocFile(%%BAREITEM.rightcom,rightcom);
               END
   *>
*>
FINAL:BEGIN
        $$LABELEDITEM.dtreeproc:=dtreeproc;
        $$LABELEDITEM.levelids:=levelids;
        $$LABELEDITEM.leftcom:=leftcom;
        $$LABELEDITEM.rightcom:=rightcom;
        $$LABELEDITEM.identifier:=identifier;
      END
END;
&
 
%BAREITEM
BASIS RULE
    BAREITEM = MUVAR/1|SIGMAVAR/2|BARELD/3|RTD/4 
SURFACE PART
VAR setofnames,records::SETOFidents;
    minnum,maxnum::int;
    relationlist::setofidents;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,RelVarList::SETOFidents;
    Varident::ident;
    issublist::bool;

<*
INIT: BEGIN INITsetofidents(records);
            INITsetofidents(setofnames);
            INITsetofidents(MuVarlist);
            INITsetofidents(SigmaVarlist);
            INITsetofidents(NodeVarlist);
            INITsetofidents(TreeVarlist);
            INITsetofidents(RelVarlist);
            INITsetofidents(relationlist);
            minnum:=0;maxnum:=0;issublist:=FALSE;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN Varident.str:=%MUVAR.str;
                              maxnum:=1000;
                              APPENDident(Varident,MuVarList);
                        END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN Varident.str:=%SIGMAVAR.str;
                              maxnum:=1;
                              APPENDident(Varident,SigmaVarList);
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN records:=%BARELD.records;
                              setofnames:=%BARELD.setofnames;
                              relationlist:=%BARELD.relationlist;
                              minnum:=%BARELD.minnum;
                              maxnum:=%BARELD.maxnum;
                              MuVarlist:=%BARELD.MuVarList;
                              SigmaVarlist:=%BARELD.SigmaVarList;
                              NodeVarlist:=%BARELD.NodeVarList;
                              TreeVarlist:=%BARELD.TreeVarList;
                              RelVarlist:=%BARELD.RelVarList;
                              issublist:=TRUE;
                         END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN records:=%RTD.records;
                              setofnames:=%RTD.setofnames;
                              relationlist:=%RTD.relationlist;
                              minnum:=1;
                              maxnum:=1;
                              MuVarlist:=%RTD.MuVarList;
                              SigmaVarlist:=%RTD.SigmaVarList;
                              NodeVarlist:=%RTD.NodeVarList;
                              TreeVarlist:=%RTD.TreeVarList;
                              RelVarlist:=%RTD.RelVarList;
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_BAREITEM;
                      $BAREITEM.issublist:=issublist;
                      $BAREITEM.setofnames:=setofnames;
                      $BAREITEM.relationlist:=relationlist;
                      $BAREITEM.minnum:=minnum;
                      $BAREITEM.maxnum:=maxnum;
                      $BAREITEM.records:=records;
                      $BAREITEM.MuVarlist:=MuVarList;
                      $BAREITEM.SigmaVarlist:=SigmaVarList;
                      $BAREITEM.NodeVarlist:=NodeVarList;
                      $BAREITEM.TreeVarlist:=TreeVarList;
                      $BAREITEM.RelVarlist:=RelVarList;
                END
*>
END;
PROCEDURAL PART
VAR leftcom,rightcom,dtreeproc:LOCALFILE;
    minnum,maxnum::INT;
    relationlist::setofidents;
    i,j:INTEGER;
    RelationNamed,labeled::bool;
    identifier,
    ilabel,root,name:TSTRING_string;
    relationname::ident;
    NumberOfItems,k,indent,level:Integer;
    levelids,righttolefttable::setofidents;
    righttoleftmatch:BOOLEAN;
    keymentioned,keyvar::bool;
    treevarname,nodevarname,recordname,category,keystr1,keystr2:TSTRING_string;
BEGIN
INIT: BEGIN TSTRING_constantempty(ilabel);
            TSTRING_constantempty(relationname.str);
            TSTRING_constantempty(identifier);
            InitLOCALFILE(leftcom);
            initsetofidents(levelids);
            InitLOCALFILE(dtreeproc);
            InitLOCALFILE(rightcom);
            indent:=$$BAREITEM.indent;
            level:=(indent DIV 6) + 1;
            labeled:=$$BAREITEM.labeled;
            name:=$$BAREITEM.name;
            root:=$$BAREITEM.root;
            k:=0;
            righttolefttable:=$$BAREITEM.righttolefttable;
            righttoleftmatch:=FALSE;
            IF labeled THEN
               BEGIN
               righttoleftmatch:=$$BAREITEM.righttoleftmatch;
               ilabel:=$$BAREITEM.label;
               END;
      END;
<*
1: <* SEND: BEGIN
            END
      !MUVAR.
      RECEIVE: BEGIN
                 identifier:=%%MUVAR.ident;
                 BEGIN \rightcom.\LOCAL. END;
                 LOCALTAB(rightcom,indent);
                 "PROCEDURE create" ""identifier"" "(VAR list:LSMRUQUO_ListOfStrees);"\\
                 LOCALTAB(rightcom,indent);
                 "BEGIN{" ""identifier"" "}"\\
                 LOCALTAB(rightcom,indent);
                 "copylist(" ""identifier"" ",list);"\\
                 LOCALTAB(rightcom,indent);
                 "END{" ""identifier"" "};"\\
                 BEGIN \leftcom.\LOCAL. END;
		 BEGIN
                   LOCALTAB(leftcom,indent);
		   "PROCEDURE Match_";""identifier"";
                              "(Lfirst,Llast:LSSTREE_pRelNode;first:Boolean;"
                                               "VAR match:Boolean);"\\
                   LOCALTAB(leftcom,indent);
		   "BEGIN{match}"\\
                   LOCALTAB(leftcom,indent+2);
                   "IF first THEN BEGIN" \\
                   LOCALTAB(leftcom,indent+4);
		   ""identifier"";".first:=Lfirst;"\\
                   LOCALTAB(leftcom,indent+4);
		   ""identifier"";".last:=Llast;"\\
		 END;
		 IF labeled THEN
		 BEGIN
                   LOCALTAB(leftcom,indent+4);
		   "match:= matchcond" ""ilabel"" ";"\\
                   LOCALTAB(leftcom,indent+2);
		   "END"\\ 
		 END
		 ELSE
		 BEGIN   
                   LOCALTAB(leftcom,indent+4);
		   "match:=TRUE;"\\
                   LOCALTAB(leftcom,indent+2);
		   "END"\\
		 END;
                   LOCALTAB(leftcom,indent+2);
                   "ELSE match:=FALSE" \\
                   LOCALTAB(leftcom,indent);
                   "END;"\\
               END
   *>
2: <* SEND: BEGIN 
            END
      !SIGMAVAR.
      RECEIVE: BEGIN
                identifier:=%%SIGMAVAR.ident;
                 BEGIN \rightcom.\LOCAL. END;
                 LOCALTAB(rightcom,indent);
                 "PROCEDURE create" ""identifier"" "(VAR list:LSMRUQUO_ListOfStrees);"\\
                 LOCALTAB(rightcom,indent);
                 "BEGIN{" ""identifier"" "}"\\
                 LOCALTAB(rightcom,indent);
                 "copylist(" ""identifier"" ",list);"\\
                 LOCALTAB(rightcom,indent);
                 "END{" ""identifier"" "};"\\
                 BEGIN \leftcom.\LOCAL. END;
		 BEGIN
                   LOCALTAB(leftcom,indent);
		   "PROCEDURE Match_";""identifier"";
                              "(Lfirst,Llast:LSSTREE_pRelNode;first:Boolean;"
                                               "VAR match:Boolean);"\\
                   LOCALTAB(leftcom,indent);
		   "BEGIN{match}"\\
                   LOCALTAB(leftcom,indent+2);
                   "IF first THEN BEGIN" \\
                   LOCALTAB(leftcom,indent+4);
		   ""identifier"";".first:=Lfirst;"\\
                   LOCALTAB(leftcom,indent+4);
		   ""identifier"";".last:=Llast;"\\
		 END;
		 IF labeled THEN
		 BEGIN
                   LOCALTAB(leftcom,indent+4);
		   "match:= matchcond" ""ilabel"" ";"\\
                   LOCALTAB(leftcom,indent+2);
		   "END"\\ 
		 END
		 ELSE
		 BEGIN   
                   LOCALTAB(leftcom,indent+4);
		   "match:=TRUE;"\\
                   LOCALTAB(leftcom,indent+2);
		   "END"\\
		 END;
                   LOCALTAB(leftcom,indent+2);
                   "ELSE match:=FALSE" \\
                   LOCALTAB(leftcom,indent);
                   "END;"\\
               END
   *>
3: <* SEND: BEGIN 
              %%BARELD.indent:=indent+2;
              %%BARELD.labeled:=labeled;
              %%BARELD.label:=ilabel;
              %%BARELD.bounded:=TRUE;
              %%BARELD.inexist:=FALSE;
              %%BARELD.righttolefttable:=righttolefttable;
              %%BARELD.righttoleftmatch:=righttoleftmatch;
              TSTRING_appendchars(identifier,identifier,'list',4);
                BEGIN \leftcom.\LOCAL. END;
                LOCALTAB(leftcom,indent);
                BEGIN
                "PROCEDURE Match_";""identifier"";
                                  "(Lfirst,Lfinal:LSSTREE_pRelNode;"
                                   "first:Boolean;VAR match:Boolean);"\\
                END;
              %%BARELD.name:=name;
              %%BARELD.root:=root;
            END
      !BARELD.
      RECEIVE: BEGIN dtreeproc:=%%BARELD.dtreeproc;
                 levelids:=%%BARELD.levelids;
                 BEGIN \leftcom.\LOCAL. END;
                 AppendLocFile(%%BARELD.leftcom,leftcom);
                 LOCALTAB(leftcom,indent);
                 "BEGIN{matchlist}"\\
                 k:=%%BARELD.numberofitems;
                 LOCALTAB(leftcom,indent);
                 "IF first OR lastmatch" ""root""
                 " THEN matchlist" """k""" "items(L,first,match)" \\
                 LOCALTAB(leftcom,indent);
                 "ELSE match:=FALSE;"\\
                 LOCALTAB(leftcom,indent);
                 "lastmatch" ""root"" ":=match;"\\
                 LOCALTAB(leftcom,indent);
                 "END;{matchlist}"\\
                 BEGIN \rightcom.\LOCAL. END;
                 LOCALTAB(rightcom,indent);
                 "PROCEDURE create" ""identifier"" "(VAR list:LSMRUQUO_ListOfStrees);"\\
                 AppendLocFile(%%BARELD.rightcom,rightcom);
                 LOCALTAB(rightcom,indent);
                 "BEGIN{" ""identifier"" "}"\\
                 LOCALTAB(rightcom,indent);
                 "createlist1(list);"\\
                 LOCALTAB(rightcom,indent);
                 "END{" ""identifier"" "};"\\
               END
   *>
4: <* SEND: BEGIN 
              %%RTD.indent:=indent;
              %%RTD.righttolefttable:=righttolefttable;
              %%RTD.name:=name;
              %%RTD.root:=root;
            END
      !RTD.
      RECEIVE: BEGIN dtreeproc:=%%RTD.dtreeproc;
                  levelids:=%%RTD.levelids;
                  minnum:=%RTD.minnum;
                  maxnum:=%RTD.maxnum;
                  relationlist:=%RTD.treerellist;
                  identifier:=%%RTD.variable;
                  nodevarname:=%RTD.nodevarname;
                  recordname:=%RTD.recordname;
                  category:=%RTD.category;
                  treevarname:=%RTD.treevarname;
                  NumberOfItems:=%%RTD.NumberOfItems;
                  RelationNamed:=%%RTD.RelationNamed;
                  BEGIN \leftcom.\LOCAL. END;
                  BEGIN
                   LOCALTAB(leftcom,indent);
                   "PROCEDURE Match_";""identifier"";"(Lfirst,Llast:LSSTREE_pRelNode;";
                                   "first:Boolean;VAR match:Boolean);"\\
                   LOCALTAB(leftcom,indent);
                   "VAR matchcond:BOOLEAN;"\\
                   LOCALTAB(leftcom,indent+2);
                   "Stree:LSSTREE_pStree;"\\
                   LOCALTAB(leftcom,indent+2);
                   "lisons:LISTREE_pRelnode;"\\
                   i:=0;
                   WHILE stillidents(relationlist) DO
                     BEGIN
                     takeident(relationname,relationlist);
                     i:=i+1;
                     LOCALTAB(leftcom,indent+2);
                     "lirel" """i""" ":LIDOMAINT_synrel;"\\
                     LOCALTAB(leftcom,indent+2);
                     "lsrel" """i""" ":LSDOMAINT_synrel;"\\
                     END;
                  j:=i; IF i>4 THEN j:=4;
                  END;
                  AppendLocFile(%%RTD.leftcom,leftcom);
                  "BEGIN{MatchTree}"\\
                  LOCALTAB(leftcom,indent+4);
                  IF RelationNamed THEN
                  BEGIN 
                   BEGIN \leftcom.\LOCAL. END;
          IF FALSE THEN {special case}
                   BEGIN
                     LOCALTAB(leftcom,indent);
             "IF first THEN match:= (Lfirst^.relation = " ""identifier"" ")"
             " ELSE match:= TRUE;"\\
                   END;
                  END
                  ELSE
                  BEGIN
                   BEGIN \leftcom.\LOCAL. END;
            IF NOT(%RTD.containsTi) THEN
                   BEGIN 
                     LOCALTAB(leftcom,indent);
                     IF TSTRING_length(identifier)<>0 THEN
                       BEGIN
                       "IF first THEN " ""identifier"" ":= Lfirst^.relation;" 
                       END;
                     "match:=TRUE;"\\
                   END;
                  END;
                  BEGIN \leftcom.\LOCAL. END;

                  IF %RTD.containsTi THEN
                    BEGIN{normal case}
                    "LSMATCHES_matchtree"
                    IF NOT(relationnamed) THEN
                       BEGIN
                       IF TSTRING_length(identifier)<>0 THEN BEGIN "Var" END
                          ELSE "Emp"
                       END;
                    IF labeled THEN "Con"
                    IF TSTRING_length(treevarname)<>0 THEN BEGIN "Var" END
                       ELSE "Emp"
                    "(Lfirst,Llast,first,"
                    IF NOT(relationnamed) THEN
                       BEGIN
                       IF TSTRING_length(identifier)<>0 THEN 
                           BEGIN ""identifier"" "," END;
                       END
                    ELSE BEGIN ""identifier"" "," END;
                    IF TSTRING_length(treevarname)<>0 THEN
                           BEGIN ""treevarname"" "," END;
                    "match,"
                    IF labeled THEN
                           BEGIN "matchcond" ""ilabel"" "," END;
                    "lastmatch" ""root"" ");"\\
                    "END;"\\
                    END;
      IF %RTD.containsTi THEN
        IF (TSTRING_length(identifier)=0) AND (TSTRING_length(treevarname)=0) THEN
                    BEGIN {special case}
                    LOCALTAB(leftcom,indent+2);
                    "IF match THEN"\\
                    LOCALTAB(leftcom,indent+2);
                    "BEGIN"\\
                    LOCALTAB(leftcom,indent+4);
                    "Stree:=Lfirst^.node;"\\
                    LOCALTAB(leftcom,indent+4);
                    "IF first THEN"\\
                    LOCALTAB(leftcom,indent+6);
                    "BEGIN"\\
                    IF TSTRING_length(treevarname)<>0 THEN
                      BEGIN
                      LOCALTAB(leftcom,indent+6);
                      ""treevarname"" ":=Stree;"\\
                      END;                  
                    LOCALTAB(leftcom,indent+6);
                    "END"\\
                    LOCALTAB(leftcom,indent+4);
                    "ELSE"\\
                    LOCALTAB(leftcom,indent+6);
                    "BEGIN"\\
                    LOCALTAB(leftcom,indent+6);
                    "match:=FALSE"\\
                    LOCALTAB(leftcom,indent+6);
                    "END;"\\
                    LOCALTAB(leftcom,indent+2);
                    "END;"\\
                    LOCALTAB(leftcom,indent);
                  IF labeled THEN
                  BEGIN
                    BEGIN \leftcom.\LOCAL. END;
                    BEGIN
                      LOCALTAB(leftcom,indent+8);
                      "if match then matchcond:=matchcond" ""ilabel"" ";"\\
                      LOCALTAB(leftcom,indent+8);
                      "IF match THEN IF NOT(matchcond) THEN"\\
                      LOCALTAB(leftcom,indent+10);
                      "Match_";""identifier"";"(Lfirst,Llast,false,match);"\\
                      LOCALTAB(leftcom,indent+8);
                      "IF match AND matchcond THEN"\\
                      LOCALTAB(leftcom,indent+10);
                      "match:=TRUE"\\
                      LOCALTAB(leftcom,indent+6);
                      "END;{MatchTree" ""identifier"" "}"\\
                    END;       
                  END
                  ELSE
                  BEGIN
                    BEGIN \leftcom.\LOCAL. END;
                    BEGIN
                      LOCALTAB(leftcom,indent+6);
                      "END;{MatchTree" ""identifier"" "}"\\
                    END;
                  END;
                    END;

        IF (NOT %RTD.containsTi) AND (TSTRING_length(identifier)<>0) THEN
                  BEGIN{normal case}
                    IF %RTD.basiccat AND (TSTRING_length(recordname)<>0) THEN
                      BEGIN
                      LOCALTAB(leftcom,indent+4);
                      ""recordname"" "tree:=Lfirst^.node;"\\
                      END;
                  IF (maxnum<100) OR (minnum>0) THEN
                      BEGIN
                      LOCALTAB(leftcom,indent+6);
                       "IF first THEN match:= "
                      IF minnum>0 THEN 
                       BEGIN "(Lfirst^.node^.li^.n >=" """minnum"""
                       ")" END;
                       IF (maxnum<100) AND (minnum>0) THEN " AND "
                       IF (maxnum<100) THEN BEGIN
                         "(Lfirst^.node^.li^.n <=" """maxnum""" ")" END;
                       "ELSE match:=TRUE;IF match THEN" \\
                      END;
                 relationlist:=%RTD.treerellist;
                 "LSMATCHES_matchtree" 
                 IF labeled THEN "Con"
                 IF not relationnamed THEN "Var";
                 """j""" "rels("
                 IF relationnamed THEN BEGIN "Lfirst,Llast," END
                 ELSE "Lfirst^.node," 
                 "first" 
                 IF relationnamed THEN BEGIN "," ""identifier"" END;\\
                  i:=0;
                  WHILE stillidents(relationlist) AND (i<4) DO BEGIN
                     i:=i+1;
                     takeident(relationname,relationlist);
                     "," ""relationname.str""
                     END;
                 ",match,matchnode,matchlist" """numberofitems""" "items"
                 ",lastmatch" ""root"" 
                 IF labeled THEN BEGIN ",matchcond" ""ilabel"" END;
                 ") END;"\\
           END;{normal case}
                  IF NOT %RTD.containsTi THEN
        IF TSTRING_length(identifier)=0 THEN {special case}
                  BEGIN
                  BEGIN
                    LOCALTAB(leftcom,indent+2);
                    "IF match THEN"\\
                    LOCALTAB(leftcom,indent+2);
                    "BEGIN"\\
                    LOCALTAB(leftcom,indent+4);
                    "Stree:=Lfirst^.node;"\\
                    IF %RTD.basiccat AND (TSTRING_length(recordname)<>0) THEN
                      BEGIN
                      LOCALTAB(leftcom,indent+4);
                      ""recordname"" "tree:=stree;"\\                      
                      END;
                    LOCALTAB(leftcom,indent+4);
                    "IF first THEN"\\
                    LOCALTAB(leftcom,indent+4);
                    "BEGIN"\\
                    LOCALTAB(leftcom,indent+6);
                    "MatchNode(Stree,match);"\\
                    IF (maxnum<100) OR (minnum>0) THEN
                      BEGIN
                      LOCALTAB(leftcom,indent+4); "IF match THEN"\\
                      LOCALTAB(leftcom,indent+6);
                       "match:= "
                      IF minnum>0 THEN 
                       BEGIN "(Stree^.li^.n >=" """minnum"""
                       ")" END;
                       IF (maxnum<100) AND (minnum>0) THEN " AND "
                       IF (maxnum<100) THEN BEGIN
                         "(Stree^.li^.n <=" """maxnum""" ")" END;
                       ";" \\
                      END;
                    LOCALTAB(leftcom,indent+4);
                    "IF match THEN"\\
                    LOCALTAB(leftcom,indent+6);
                    "BEGIN"\\
                    relationlist:=%RTD.treerellist;
                    i:=0;
                    WHILE stillidents(relationlist) DO
                      BEGIN
                      i:=i+1;
                      takeident(relationname,relationlist);
                      LOCALTAB(leftcom,indent+6);
                      "lsrel" """i""" ":=" 
                                  ""relationname.str"" ";"\\
                      LOCALTAB(leftcom,indent+6);
                      "lirel" """i""" ":= loopholes.retype(lsrel" 
                                    """i""" ",LIDOMAINT_synrel);"\\
                      END;
                    IF (j<>0) THEN
                      BEGIN
                      LOCALTAB(leftcom,indent+6);
                      "lisons:=loopholes.retype"
                       "(Stree^.sons,LISTREE_pRelnode);"\\
                      LOCALTAB(leftcom,indent+6);
                      "match:= LIMATCHES_TEST" """j""" "rels("
                      i:=0;
                      WHILE i<>j DO
                        BEGIN
                        i:=i+1;
                        "lirel" """i""" ","
                        END;
                      "lisons,FALSE);"\\
                      END;
                    LOCALTAB(leftcom,indent+6);
                    "END;"\\
                    LOCALTAB(leftcom,indent+6);
                    "IF match THEN"\\
                    LOCALTAB(leftcom,indent+6);
                    "BEGIN"\\
                    LOCALTAB(leftcom,indent+8);
                    "MatchList" """NumberOfItems""" "Items(Stree^.sons,TRUE,match);"\\
                  END;  
                  IF labeled THEN
                  BEGIN
                    BEGIN \leftcom.\LOCAL. END;
                    BEGIN
                      LOCALTAB(leftcom,indent+8);
                      "if match then matchcond:=matchcond" ""ilabel"" ";"\\
                      LOCALTAB(leftcom,indent+8);
                      "IF match THEN IF NOT(matchcond) THEN"\\
                      LOCALTAB(leftcom,indent+10);
                      "Match_";""identifier"";"(Lfirst,Llast,false,match);"\\
                      LOCALTAB(leftcom,indent+8);
                      "IF match AND matchcond THEN"\\
                      LOCALTAB(leftcom,indent+10);
                      "match:=TRUE"\\
                      LOCALTAB(leftcom,indent+6);
                      "END"\\
                    END;       
                  END
                  ELSE
                  BEGIN
                    BEGIN \leftcom.\LOCAL. END;
                    BEGIN
                      LOCALTAB(leftcom,indent+6);
                      "END"\\
                    END;
                  END;
                  LOCALTAB(leftcom,indent+4);
                  "END"\\
                  BEGIN \leftcom.\LOCAL. END;
                  BEGIN
                    LOCALTAB(leftcom,indent+4);
                    "ELSE"\\
                    LOCALTAB(leftcom,indent+6);
                    "BEGIN"\\
                    LOCALTAB(leftcom,indent+8);
                    "IF lastmatch" ""root"" " THEN"\\
                    LOCALTAB(leftcom,indent+8);
                    "MatchList";"""NumberOfItems""" "Items(Stree^.sons,FALSE,match)"\\
                    LOCALTAB(leftcom,indent+8);
                    "ELSE match:=FALSE;"\\
                  END;
                  IF labeled THEN
                  BEGIN
                  BEGIN \leftcom.\LOCAL. END;
                  BEGIN
                    LOCALTAB(leftcom,indent+8);
                    "if match then matchcond:=matchcond" ""ilabel"" ";"\\
                    LOCALTAB(leftcom,indent+8);
                    "IF match THEN IF NOT(matchcond) THEN"\\
                    LOCALTAB(leftcom,indent+10);
                    "Match_";""identifier"";"(Lfirst,Llast,false,match);"\\
                    LOCALTAB(leftcom,indent+8);
                    "IF match AND matchcond THEN"\\
                    LOCALTAB(leftcom,indent+10);
                    "match:=TRUE;"\\
                    LOCALTAB(leftcom,indent+6);
                    "END;"\\
                  END;       
                END
                ELSE
                BEGIN
                  BEGIN \leftcom.\LOCAL. END;
                  BEGIN
                    LOCALTAB(leftcom,indent+6);
                    "END"\\
                  END;
                END;
                BEGIN \leftcom.\LOCAL. END;
                BEGIN
                  LOCALTAB(leftcom,indent+2);
                  "END;"\\
                  LOCALTAB(leftcom,indent);
                  "lastmatch" ""root"" ":=match;"\\
                  LOCALTAB(leftcom,indent);
                 "END;{MatchTree";""identifier"";"}"\\
                END;
                END; {IF NOT RTD.containsTi}

            keymentioned:=%%RTD.keymentioned;
            keyvar:=%%RTD.keyvar;
            keystr1:=%%RTD.keystr1;
            keystr2:=%%RTD.keystr2;
            recordname:=%RTD.recordname;
             level:=level - 1;
             BEGIN \rightcom.\LOCAL. END;
             LOCALTAB(rightcom,indent);
             "PROCEDURE create" ""identifier"" "(VAR list:LSMRUQUO_ListOfStrees);"\\
             LOCALTAB(rightcom,indent);
             "VAR s:LSSTREE_pStree;relnode:LSSTREE_prelnode;"\\
             LOCALTAB(rightcom,indent);
             " list1:LSMRUQUO_ListOfStrees;"\\
             AppendLocFile(%%RTD.rightcom,rightcom);
             LOCALTAB(rightcom,indent);
             "BEGIN{" ""identifier"" "}"\\
             IF (NOT %RTD.basiccat) AND (NOT keymentioned) AND
        ((TSTRING_length(category)<>0) OR (TSTRING_length(treevarname)<>0))
             THEN BEGIN
                 IF (TSTRING_length(category)<>0) THEN
                    BEGIN
                    "LSMATCHES_createitem(list," ""identifier"" ","
                    ""category"" ",createnode,createlist1);"\\
                    END;
                 IF (TSTRING_length(treevarname)<>0) THEN
                    BEGIN
                    "LSMATCHES_createitemVar(list," ""identifier"" ","
                    ""treevarname"" ");"\\
                    END;
                 END
          ELSE BEGIN{special case}
             LOCALTAB(rightcom,indent);
             "LISTREE_makerelnode(loopholes.retype"
               "(relnode,LISTREE_prelnode));"\\
             LOCALTAB(rightcom,indent);
             "list.first:=relnode;"\\
             LOCALTAB(rightcom,indent);
             "list.last:=relnode;"\\
             LOCALTAB(rightcom,indent);
             "relnode^.relation:=" ""identifier"" ";"\\
            keymentioned:=%%RTD.keymentioned;
            keyvar:=%%RTD.keyvar;
            keystr1:=%%RTD.keystr1;
            keystr2:=%%RTD.keystr2;
            recordname:=%RTD.recordname;
            IF keymentioned THEN
             BEGIN
                "s:=" ""recordname"" "tree;"\\
             END
            ELSE
             BEGIN
             IF %RTD.containsTi THEN
               BEGIN
               LOCALTAB(rightcom,indent);
               "s:=" ""treevarname"" ";"\\
               END
             ELSE
               BEGIN
               IF %RTD.basiccat THEN
                BEGIN
                IF TSTRING_comparechars(category,'GLUE',4)<>0 THEN
                  BEGIN
                  "s:=" ""recordname"" "tree;"\\
                  END
                ELSE
                  BEGIN
                  "s:=MAKET_stree(GLUE);"\\
                  END
                END
               ELSE
               IF (TSTRING_length(category)<>0) THEN
                  BEGIN
                  IF %RTD.noderiv THEN
                    BEGIN
                    LOCALTAB(rightcom,indent);
                    "s:=MAKET_stree(" ""category""  ");"\\
                    END;
                  LOCALTAB(rightcom,indent);
                  IF TSTRING_comparechars(category,'GLUE',4)<>0 THEN
                          BEGIN
                          "createnode(s);"\\
                          LOCALTAB(rightcom,indent);
                          END;
                  IF %RTD.noderiv THEN 
                     BEGIN
                     "createlist1(list1);"\\
                     LOCALTAB(rightcom,indent);
                     "IF (list1.first<>NIL) THEN list1.last^.brother:=NIL;"\\
                     LOCALTAB(rightcom,indent);
                     "s^.li^.n:=numberofelements(list1);"\\
                     LOCALTAB(rightcom,indent);
                     "s^.sons:=list1.first;"\\
                     END;
                  END
               ELSE
                  BEGIN
                  IF TSTRING_length(treevarname)<>0 THEN
                           BEGIN
                           LOCALTAB(rightcom,indent);
                           "s:=" ""treevarname"" ";"\\
                           END
                        ELSE
                           BEGIN
                           LOCALTAB(rightcom,indent);
                           "s:=MAKET_stree(" ""nodevarname"" ".cat);"\\
                           LOCALTAB(rightcom,indent);
                           "createnode(s);"\\
                           LOCALTAB(rightcom,indent);
                           IF %RTD.noderiv THEN
                             BEGIN
                             "createlist1(list1);"\\
                             LOCALTAB(rightcom,indent);
                             "IF (list1.first<>NIL) THEN list1.last^.brother:=NIL;"\\
                             LOCALTAB(rightcom,indent);
                             "s^.li^.n:=numberofelements(list1);"\\
                             LOCALTAB(rightcom,indent);
                             "s^.sons:=list1.first;"\\
                             END;
                           END
                  END;
               END;
             END;
             LOCALTAB(rightcom,indent);
             "relnode^.node:=s;"\\
         END;
             LOCALTAB(rightcom,indent);
             "END{" ""identifier"" "};"\\
             END;
   *>
*>
FINAL:BEGIN
        $$BAREITEM.dtreeproc:=dtreeproc;
        $$BAREITEM.levelids:=levelids;
        $$BAREITEM.identifier:=identifier;
        $$BAREITEM.leftcom:=leftcom; 
        $$BAREITEM.rightcom:=rightcom; 
      END
END;
&
 
%LD
BASIS RULE
    LD = LABELEDLD/1|BARELD/2
SURFACE PART
VAR records::SETOFidents;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    RelVarList::SETOFidents;

<*
INIT: BEGIN 
        INITsetofidents(records);
        INITsetofidents(MuVarlist);
        INITsetofidents(SigmaVarlist);
        INITsetofidents(NodeVarlist);
        INITsetofidents(TreeVarlist);
        INITsetofidents(RelVarlist);
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                          records:=%LABELEDLD.records;
                          MuVarlist:=%LABELEDLD.MuVarList;
                          SigmaVarlist:=%LABELEDLD.SigmaVarList;
                          NodeVarlist:=%LABELEDLD.nodeVarList;
                          TreeVarlist:=%LABELEDLD.TreeVarList;
                          RelVarlist:=%LABELEDLD.RelVarList;
                        END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN
                          records:=%BARELD.records;
                          MuVarlist:=%BARELD.MuVarList;
                          SigmaVarlist:=%BARELD.SigmaVarList;
                          NodeVarlist:=%BARELD.nodeVarList;
                          TreeVarlist:=%BARELD.TreeVarList;
                          RelVarlist:=%BARELD.RelVarList;
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_LD; 
                      $LD.records:=records;
                      $LD.MuVarlist:=MuVarList;
                      $LD.SigmaVarlist:=SigmaVarList;
                      $LD.NodeVarlist:=NodeVarList;
                      $LD.TreeVarlist:=TreeVarList;
                      $LD.RelVarlist:=RelVarList;
                END
*>
END;
PROCEDURAL PART
VAR allexist:LOCALFILE;
    NumberOfItems:Integer;
    levelids::setofidents;
    inexist::bool;
BEGIN
INIT: BEGIN inexist:=$$LD.inexist;
        INITLOCALFILE(allexist);
      END;
<*
1: <* SEND: BEGIN %%LABELEDLD.submodellist:=FALSE;
                  %%LABELEDLD.indent:=0;
                  %%LABELEDLD.inexist:=inexist;
                  INITSETOFIDENTS(%%LABELEDLD.righttolefttable);
                  TSTRING_constantempty(%%LABELEDLD.root);
                  TSTRING_constantempty(%%LABELEDLD.name);
            END
      !LABELEDLD.
      RECEIVE: BEGIN 
                 levelids:=%%LABELEDLD.levelids;
                 NumberOfItems:=%%LABELEDLD.NumberOfItems;
                 AppendLocFile(%%LABELEDLD.leftcom,allexist);      
               END
   *>
2: <* SEND: BEGIN 
              TSTRING_constantempty(%%BARELD.label);
              %%BARELD.indent:=0;
              %%BARELD.inexist:=inexist;
              %%BARELD.labeled:=FALSE;
              %%BARELD.bounded:=TRUE;
              %%BARELD.righttoleftmatch:=FALSE;
              TSTRING_constantempty(%%BARELD.root);
              TSTRING_constantempty(%%BARELD.name);
            END
      !BARELD.
      RECEIVE: BEGIN
                 levelids:=%%BARELD.levelids;
                 NumberOfItems:=%%BARELD.NumberOfItems;
                 AppendLocFile(%%BARELD.leftcom,allexist);      
               END
   *>
*>
FINAL:BEGIN 
        $$LD.levelids:=levelids;
        $$LD.allexist:=allexist;
        $$LD.NumberOfItems:=NumberOfItems;
      END
END;
&
 
%RTD
BASIS RULE
    RTD = RELD/2.SLASH/1.BARETD/3
SURFACE PART
VAR setofnames,records::SETOFidents;
    MuVarList,SigmaVarList,TreeVarList,NodeVarList,
    RelVarList,RelVarList1::SETOFidents;
    minnum,maxnum::INT;
    noderiv,basiccat,containsTi::bool;
    recordname,Treevarname,nodevarname,category:TSTRING_string;
    relationlist,treerellist::setofidents;
HELP PROCEDURE APPENDSETS(S1::SETOFidents;VAR S2::SETOFidents);
VAR ident1::ident;
BEGIN
WHILE STILLidents(S1) DO
   BEGIN
   TAKEident(ident1,S1);
   APPENDident(ident1,S2)
   END
END;

<*
INIT: BEGIN INITsetofidents(records);
            INITsetofidents(MuVarlist);
            INITsetofidents(SigmaVarlist);
            INITsetofidents(NodeVarlist);
            INITsetofidents(TreeVarlist);
            INITsetofidents(RelVarlist1);
            INITsetofidents(RelVarlist);
            INITsetofidents(relationlist);
            INITsetofidents(treerellist);
            TSTRING_constantempty(treevarname);
            containsTi:=false;
            minnum:=0;maxnum:=0;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN 
                        RelVarList1:=%RELD.RelVarList;
                        IF TSTRING_length(%RELD.relationname.str)<>0 THEN
                          appendident(%RELD.relationname,relationlist)
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN setofnames:=%BARETD.setofnames;
                              noderiv:=%BARETD.noderiv;
                              records:=%BARETD.records; 
                              MuVarlist:=%BARETD.MuVarList;
                              SigmaVarlist:=%BARETD.SigmaVarList;
                              NodeVarlist:=%BARETD.NodeVarList;
                              TreeVarlist:=%BARETD.TreeVarList;
                              RelVarlist:=%BARETD.RelVarList;
                              APPENDSETS(RelVarList1,RelVarList);
                              basiccat:=%BARETD.basiccat;
                              recordname:=%BARETD.recordname;
                              minnum:=%BARETD.minnum;
                              maxnum:=%BARETD.maxnum;
                              treerellist:=%BARETD.relationlist;
                              containsTi:=%BARETD.containsTi;
                              treevarname:=%BARETD.treevarname;
                              nodevarname:=%BARETD.nodevarname;
                              category:=%BARETD.category;
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_RTD;
                      $RTD.noderiv:=noderiv;
                      $RTD.setofnames:=setofnames;
                      $RTD.relationlist:=relationlist;
                      $RTD.treerellist:=treerellist;
                      $RTD.minnum:=minnum;
                      $RTD.maxnum:=maxnum;
                      $RTD.records:=records;
                      $RTD.basiccat:=basiccat;
                      $RTD.recordname:=recordname;
                      $RTD.MuVarlist:=MuVarList;
                      $RTD.SigmaVarlist:=SigmaVarList;
                      $RTD.NodeVarlist:=NodeVarList;
                      $RTD.TreeVarlist:=TreeVarList;
                      $RTD.RelVarlist:=RelVarList;
                      $RTD.containsTi:=containsTi;
                      $RTD.treevarname:=treevarname;
                      $RTD.nodevarname:=nodevarname;
                      $RTD.category:=category;
                END
*>
END;
PROCEDURAL PART
VAR variable,keystr1,keystr2,root,name:TSTRING_string;
    RelationNamed,keymentioned,keyvar::Bool;
    leftcom,rightcom,dtreeproc:LOCALFILE;
    indent,NumberOfItems:Integer;
    righttolefttable,levelids::setofidents;
BEGIN
INIT: BEGIN
        TSTRING_constantempty(variable);
        indent:=$$RTD.indent;
        righttolefttable:=$$RTD.righttolefttable;
        InitLOCALFILE(leftcom);
        InitLOCALFILE(rightcom);
        name:=$$RTD.name;
        root:=$$RTD.root;
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
2: <* SEND: BEGIN
            END
      !RELD.
      RECEIVE: BEGIN
                 variable:=%%RELD.variable;
                 RelationNamed:=%%RELD.RelationNamed;
               END
   *>
3: <* SEND: BEGIN %%BARETD.indent:=indent+2;
                  %%BARETD.righttolefttable:=righttolefttable;
                  %%BARETD.name:=name;
                  %%BARETD.root:=root;
            END
      !BARETD.
      RECEIVE: BEGIN dtreeproc:=%%BARETD.dtreeproc;
                 levelids:=%%BARETD.levelids;
                 keymentioned:=%%BARETD.keymentioned;
                 keyvar:=%%BARETD.keyvar;
                 keystr1:=%%BARETD.keystr1;
                 keystr2:=%%BARETD.keystr2;
                 NumberOfItems:=%%BARETD.NumberOfItems;
                 AppendLocFile(%%BARETD.leftcom,leftcom);
                 AppendLocFile(%%BARETD.rightcom,rightcom);
               END
   *>
*>
FINAL:BEGIN
        $$RTD.dtreeproc:=dtreeproc;
        $$RTD.levelids:=levelids;
        $$RTD.keymentioned:=keymentioned;
        $$RTD.keyvar:=keyvar;
        $$RTD.keystr1:=keystr1;
        $$RTD.keystr2:=keystr2;
        $$RTD.leftcom:=leftcom; 
        $$RTD.rightcom:=rightcom; 
        $$RTD.RelationNamed:=RelationNamed;
        $$RTD.variable:=variable;
        $$RTD.NumberOfItems:=NumberOfItems;
      END
END;
&
 
%RELD
BASIS RULE
