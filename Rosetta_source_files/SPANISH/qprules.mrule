\newpage
\begin{verbatim}

% RULE RQPSUPERLATIVEcomplmod
< m1: QP{QPrec1}[head/Q{Qrec1}]
  m2: T1
>

< m : QP{QPrec1}[head/Q{Qrec1},
                     decomplrel/PREPP{PREPPrec1}
                           [head/PREP(KEY_dePREPkey){PREPrec1},
                            I2:complrel/T2
                           ]
                    ]

>


   MATCHCONDITIONS
      <m1: (QPrec1.thanas = decompl) 
       I2: (T2.cat IN [ NPVAR] WITH T2.REC.cases = []) 
       m2: T1.cat IN [NPVAR]
       >

<

   SUBRULE
      <T1: NPVAR{NPVARrec1}>
      <T2: NPVAR{NPVARrec2}>

      COMP
         <
          C1: NPVARrec1.supertiempo = QPrec1.supertiempo 
          A1: NPVArrec2 := NPVARrec1;
              NPVARrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: NPVARrec2.supertiempo = omegatiempo
          A1: QPrec1.thanas := decompl; 
              NPVARrec1 := NPVARrec2;
              NPVARrec1.supertiempo := QPrec1.supertiempo;
         >
>
&

\end{verbatim}
