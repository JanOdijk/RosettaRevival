\begin{verbatim}
% TRANSFORMATION TPrepCaseAssign
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I4:rel1/N1
                              [ mu3,
                                I1:objrel/T1
                              ],
                       mu5 
                     ],
              mu6 
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I4:rel1/N1
                              [ mu3,
                                I2:objrel/T2
                              ],
                       mu5 
                     ],
              mu6 
            ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [] 
       I2: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
       I4: rel1 IN [prepobjrel, byobjrel] AND
           N1.CAT IN [VARPREPP, PREPP]
      >

<
   SUBRULE
      < T1:NPVAR{NPVARrec1}>
      < T2:NPVAR{NPVARrec2}>

      COMP
         <
          C1: true
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Accusative]
         >
      DECOMP
         <
          C1: true
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [] 
         >

   SUBRULE
      < T1:CNVAR{CNVARrec1}>
      < T2:CNVAR{CNVARrec2}>

      COMP
         <
          C1: true
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Accusative]
         >
      DECOMP
         <
          C1: true
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [] 
         >

   SUBRULE
      < T1:NP{NPrec1}[mu7] >
      < T2:NP{NPrec2}[mu8] >

      COMP
         <
          C1: true
          A1: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, [Accusative])
         >
      DECOMP
         <
          C1: true
          A1: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, [] )
         >
>
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] TPrepCaseAssign
\item[* relevant examples:] The aliens spoke to them, They talked about her, 
With whom did you discuss this?, Who(m) did you stay with, these are the 
people who(m) we visited last year
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_
CaseAssignment
\item[* date of creation:] 6-APR-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch TCaseAssignment3
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to give accusative case to NPVARs etc.\ that are governed by a 
PREP
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed that either the function QUOTE\_assigncase or some other rule 
will be 
able to deal with the variation in {\em who/whom\/}. Morphology assumes that 
{\em who\/} has [nominative, accusative] as possible cases, while {\em whom\/} 
only has [accusative]. Note that {\em who\/} is 
allowed when interrogative and shifted from its prep, but tricky in relatives 
in object position (Quirk claims that {\em who\/} is substandard there, but {
\em whom\/} pedantic, leaving {\em that\/} as alternative; however, I 
personally think that {\em that\/} is equally substandard, and would prefer 
{\em which\/} in these cases).
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION TExceptCaseAssign
< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu5],
                           complrel/I2::SENTENCE{SENTENCErec1}[mu3],
                           mu6
                         ],
                  mu7
                ]
>

< m : I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu5],
                           complrel/I2::SENTENCE{SENTENCErec1}[mu8],
                           mu6
                         ],
                  mu7
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.voice <> passive 
       I2: SENTENCErec1.PROsubject = false
       I3: VERBrec1.Caseassigner = true AND 
           VERBrec1.thetavp IN [vp120, vp123] 
      >

(* \end{verbatim}
   \newpage
   \begin{verbatim}
*)

<
   SUBRULE  (* 1. the embedded subject has not been shifted *)
      < mu3: [I6:sig1, I4:subjrel/T1, mu9] >
      < mu8: [I6:sig1, I5:subjrel/T2, mu9] >

      MATCHCONDITIONS
         <
          I4: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [] 
          I5: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
          I6: ALL (sig1, shiftrel/..)
         >

   <
     SUBRULE (* 1a. NPVAR *)
         < T1:NPVAR{NPVARrec1} >
         < T2:NPVAR{NPVARrec2} >

         COMP
            <
             C1: true
             A1: NPVARrec2 := NPVARrec1;
                 NPVARrec2.cases := [Accusative]
            >
         DECOMP
            <
             C1: true
             A1: NPVARrec1 := NPVARrec2;
                 NPVARrec1.cases := [] 
            >

      SUBRULE (* 1b. CNVAR *)
         < T1:CNVAR{CNVARrec1} >
         < T2:CNVAR{CNVARrec2} >

         COMP
            <
             C1: true
             A1: CNVARrec2 := CNVARrec1;
                 CNVARrec2.cases := [Accusative]
            >
         DECOMP
            <
             C1: true
             A1: CNVARrec1 := CNVARrec2;
                 CNVARrec1.cases := [] 
            >

      SUBRULE (* 1c. NP *)
         < T1:NP{NPrec1}[mu10] >
         < T2:NP{NPrec2}[mu11] >

         COMP
            <
             C1: true
             A1: QUOTE_assigncase(NPrec1, mu10, NPrec2, mu11, [Accusative])
            >
         DECOMP
            <
             C1: true
             A1: QUOTE_assigncase(NPrec2, mu11, NPrec1, mu10, [] )
            >
      >
   
(* \end{verbatim}
   \newpage
   \begin{verbatim}
*)

   SUBRULE  (* 2. the embedded subject has been shifted *)
      < mu3: [I5:shiftrel/T1, I6:mu9] >
      < mu8: [I7:shiftrel/T2, I6:mu9] >

      MATCHCONDITIONS
         <
          I5: T1.CAT IN [NPVAR, CNVAR, NP] WITH T1.REC.cases = [] 
          I6: NOT EXIST(mu9, [subjrel/..])
          I7: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
         >

      <
       SUBRULE (* 2a. NPVAR *)
          < T1:NPVAR{NPVARrec1} >
          < T2:NPVAR{NPVARrec2} >

          COMP
             <
              C1: true
              A1: NPVARrec2 := NPVARrec1;
                  NPVARrec2.cases := [Accusative]
             >
          DECOMP
             <
              C1: true
              A1: NPVARrec1 := NPVARrec2;
                  NPVARrec1.cases := [] 
             >

       SUBRULE (* 2b. CNVAR *)
          < T1:CNVAR{CNVARrec1} >
          < T2:CNVAR{CNVARrec2} >

          COMP
             <
              C1: true
              A1: CNVARrec2 := CNVARrec1;
                  CNVARrec2.cases := [Accusative]
             >
          DECOMP
             <
              C1: true
              A1: CNVARrec1 := CNVARrec2;
                  CNVARrec1.cases := [] 
             >

       SUBRULE (* 2c. NP *)
          < T1:NP{NPrec1}[mu10] >
          < T2:NP{NPrec2}[mu11] >

          COMP
             <
              C1: true
              A1: QUOTE_assigncase(NPrec1, mu10, NPrec2, mu11, [Accusative])
             >
          DECOMP
             <
              C1: true
              A1: QUOTE_assigncase(NPrec2, mu11, NPrec1, mu10, [] )
             >
      >
>

&
\end{verbatim}
