\newpage
\begin{verbatim}
% RULE RxppVarPrepNPsubst
< m1:I5::CLAUSE{CLAUSErec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                        [ mu2,
                          predrel/I6::N6
                                 [ mu9,
                                   I2:rel1/VARPREPP{VARPREPPrec1}
                                          [ mu3,
                                            rel2/I1::NPVAR{NPVARrec1},
                                            mu4
                                          ],
                                   mu11
                                 ],
                             mu5  
                           ],
                mu6 
             ] 

  SUBST:
  m2: T3=I3::NP{NPrec1}[I7:mu7]
>

< m :I5::CLAUSE{CLAUSErec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                        [ mu2,
                          predrel/I6::N6
                                 [ mu9,
                                   I2:rel1/PREPP{PREPPrec1}
                                          [ mu3,
                                            I8:rel2/T4=I4::NP{NPrec2}
                                                   [I9:mu8],
                                            mu4
                                          ],
                                   mu11
                                 ],
                          mu5  
                        ],
                mu6 
              ] 
>

   MATCHCONDITIONS
      <
       m : QUOTE_substordercondition(mu11, mu5, mu6, CLAUSErec1.prosubject)
       m2: NOT QUOTE_Negphrase(T3) AND
           QUOTE_Gsubstordercondition(mu11, mu5, mu6, T3, CLAUSErec1.prosubject)
       I1: NPVARrec1.index = LEVEL 
       I2: rel1 IN [prepobjrel, toobjrel, forobjrel, postadjrel, vpadvrel]
       I3: [NPrec1.NPhead] * [reflNP, reciproNP,
                              sentNP, openIngNP] = [] 
       I4: [NPrec2.NPhead] * [reflNP, reciproNP,
                              sentNP, openIngNP] = [] 
       I5: synBE IN CLAUSErec1.synvpefs 
       I6: N6.CAT IN [NP, PREPP, ADJP, ADVP]
       I7: NOT EXIST(mu7, [head/BIGPRO{}[mu10]])
       I8: NOT QUOTE_Negphrase(T4)
       I9: NOT EXIST(mu8, [head/BIGPRO{}[mu10]])
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = []   AND
              NPrec1.generic = nogeneric
            C11: CLAUSErec1.deixis = omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.superdeixis
            A11: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases); 
            C12: CLAUSErec1.deixis <> omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.deixis
            A12: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases); 
          A1: NPrec2.generic := omegageneric;
              NPrec2.superdeixis := omegadeixis;
              PREPPrec1 := VARPREPPrec1
         >

      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
            C11: CLAUSErec1.deixis = omegadeixis
            A11: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []); 
                 NPrec1.superdeixis := CLAUSErec1.superdeixis;
            C12: CLAUSErec1.deixis <> omegadeixis 
            A12: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []); 
                 NPrec1.superdeixis := CLAUSErec1.deixis;
          A1: NPVARrec1 := COPYT_nptovar(NPrec2);
              (* including cases *)
              NPVARrec1.index := LEVEL;
              NPVARrec1.generic := nogeneric;
              NPrec1.generic := nogeneric;
              VARPREPPrec1 := PREPPrec1
         >

&

\end{verbatim}
