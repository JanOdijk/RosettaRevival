\begin{verbatim}
% RULE RShiftLocAdvSubst         (* shiftrel/loc,sentADVP, (VAR)PREPP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             I1:shiftrel/T1,
             mu3,
             predrel/VERBP{VERBPrec1}[mu2],
             mu6 
           ] 

  SUBST:
  m2: T2
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             I2:shiftrel/T3,
             mu3,
             predrel/VERBP{VERBPrec1}[mu2],
             mu6 
           ] 
>

   MATCHCONDITIONS
      <
       m2: T2.CAT IN [PREPP, VARPREPP, ADVP] AND
           QUOTE_Gsubstordercondition(mu3, mu2, mu6, T2, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T2) 
       m : QUOTE_substordercondition(mu3, mu2, mu6, CLAUSErec1.prosubject)
       I1: T1.CAT IN [PREPPVAR, ADVPVAR] WITH T1.REC.index = LEVEL
       I2: T3.CAT IN [PREPP, VARPREPP, ADVP] AND
           NOT QUOTE_NegPhrase(T3) 
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* 1. PREPP *)
      < T1: PREPPVAR{PREPPVARrec1} 
        T2: PREPP{PREPPrec1}[mu4]  >
      < T3: PREPP{PREPPrec2}[mu4]  >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_preppTOvar(PREPPrec1) 
                             EXCEPT FOR [mood] AND
              [loc,caus] * PREPPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              PREPPrec1.superdeixis)
            C11: PREPPVARrec1.mood = topicmood AND
                 PREPPrec1.mood = nowh
            A11: @
            C12: PREPPVARrec1.mood = wh AND
                 PREPPrec1.mood = wh
            A12: @
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1:  [loc,caus] * PREPPrec2.actsubcefs  <> [] AND
              PREPPrec2.superdeixis = omegadeixis
            C11: PREPPrec2.mood = nowh
            A11: PREPPVARrec1 := COPYT_preppTOvar(PREPPrec2);
                 PREPPVARrec1.mood := topicmood
            C12: PREPPrec2.mood = wh
            A12: PREPPVARrec1 := COPYT_preppTOvar(PREPPrec2);
          A1: PREPPVARrec1.index := LEVEL;
              PREPPrec1 := PREPPrec2;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 PREPPrec1.superdeixis)
         >

   SUBRULE (* 2a. VARPREPP on NPVAR *)
      < T1: PREPPVAR{PREPPVARrec1} 
        T2: VARPREPP{VARPREPPrec1}[I4:mu4]  >
      < T3: VARPREPP{VARPREPPrec2}[I4:mu4]  >

   MATCHCONDITIONS
      <
       I4: EXIST (mu4, [../NPVAR{NPVARrec4}])
      >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_preppTOvar(VARPREPPrec1) 
                             EXCEPT FOR [mood] AND
              [loc,caus] * VARPREPPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              VARPREPPrec1.superdeixis)
            C11: PREPPVARrec1.mood = topicmood AND
                 VARPREPPrec1.mood = nowh
            A11: VARPREPPrec2 := VARPREPPrec1
            C12: PREPPVARrec1.mood = relativexpmood AND
                 VARPREPPrec1.mood = nowh
            A12: VARPREPPrec2 := VARPREPPrec1;
                 VARPREPPrec2.mood := relativexpmood
            C13: PREPPVARrec1.mood = wh AND
                 VARPREPPrec1.mood = wh
            A13: VARPREPPrec2 := VARPREPPrec1;
          A1: VARPREPPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: [loc,caus] * VARPREPPrec2.actsubcefs <> [] AND
              VARPREPPrec2.superdeixis = omegadeixis
            C11: VARPREPPrec2.mood = nowh
            A11: PREPPVARrec1 := COPYT_preppTOvar(VARPREPPrec2);
                 PREPPVARrec1.mood := topicmood;
                 VARPREPPrec1 := VARPREPPrec2
            C12: VARPREPPrec2.mood = relativexpmood
            A12: PREPPVARrec1 := COPYT_preppTOvar(VARPREPPrec2);
                 VARPREPPrec1 := VARPREPPrec2;
                 VARPREPPrec1.mood := nowh
            C13: VARPREPPrec2.mood = wh
            A13: PREPPVARrec1 := COPYT_preppTOvar(VARPREPPrec2);
                 VARPREPPrec1 := VARPREPPrec2;
          A1: PREPPVARrec1.index := LEVEL;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 VARPREPPrec1.superdeixis)
         >

   SUBRULE (* 2b. VARPREPP on CNVAR *)
      < T1: PREPPVAR{PREPPVARrec1} 
        T2: VARPREPP{VARPREPPrec1}[I4:mu4]  >
      < T3: VARPREPP{VARPREPPrec2}[I4:mu4]  >

   MATCHCONDITIONS
      <
       I4: EXIST (mu4, [../CNVAR{CNVARrec4}])
      >

      COMP
         <
          C1: PREPPVARrec1 = COPYT_preppTOvar(VARPREPPrec1) 
                             EXCEPT FOR [mood] AND
              [loc,caus] * VARPREPPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              VARPREPPrec1.superdeixis)
            C13: PREPPVARrec1.mood = relativexpmood AND
                 VARPREPPrec1.mood = relativexpmood
            A13: VARPREPPrec2 := VARPREPPrec1;
          A1: VARPREPPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: [loc,caus] *  VARPREPPrec2.actsubcefs <> []AND
              VARPREPPrec2.superdeixis = omegadeixis
            C13: VARPREPPrec2.mood = relativexpmood
            A13: PREPPVARrec1 := COPYT_preppTOvar(VARPREPPrec2);
                 VARPREPPrec1 := VARPREPPrec2;
          A1: PREPPVARrec1.index := LEVEL;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 VARPREPPrec1.superdeixis)
         >

   SUBRULE (* 3. ADVP *)
      < T1: ADVPVAR{ADVPVARrec1} 
        T2: ADVP{ADVPrec1}[mu5]  >
      < T3: ADVP{ADVPrec2}[mu5]  >

      COMP
         <
          C1: ADVPVARrec1 = COPYT_advpTOvar(ADVPrec1) 
                                  EXCEPT FOR [mood] AND
              [locadv,sentadv] *  ADVPrec1.actsubcefs <> [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                              ADVPrec1.superdeixis)
            C11: ADVPVARrec1.mood = topicmood AND
                 ADVPrec1.mood = nowh
            A11: @
            C12: ADVPVARrec1.mood = wh AND
                 ADVPrec1.mood = wh
            A12: @
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis
         >

      DECOMP
         <
          C1: [locadv,sentadv] * ADVPrec2.actsubcefs <> [] AND
              ADVPrec2.superdeixis = omegadeixis
            C11: ADVPrec2.mood = nowh
            A11: ADVPVARrec1 := COPYT_advpTOvar(ADVPrec2);
                 ADVPVARrec1.mood := topicmood
            C12: ADVPrec2.mood = wh
            A12: ADVPVARrec1 := COPYT_advpTOvar(ADVPrec2);
          A1: ADVPrec1 := ADVPrec2;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                                 ADVPrec1.superdeixis);
              ADVPVARrec1.index := LEVEL
         >
>
&
\end{verbatim}
