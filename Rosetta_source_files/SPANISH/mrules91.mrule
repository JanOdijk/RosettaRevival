      >

   
         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: @
         >

   SUBRULE  (* os + deletion of vosotros (masc) *)
      <mu7: [I11:mu11]>                                       
 
   
   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
             I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]      
      >


         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: @
         >

   SUBRULE  (* os + deletion of vosotras (fem) *)
      <mu7: [I11:mu11]>                                       
 
   
   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I111:rel6/..]))   AND
             ALL (mu11, seCLrel/..)
             I111: rel6 IN [unoCLrel, dosCLrel, tresCLrel]      
      >

   
         <
          C1: (NPrec1.persona = 2)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: @
         >

   SUBRULE  (* los + deletion of ellos/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = reflexive)
          A1: @
        >     


SUBRULE  (* los + deletion of ellos/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [unoCLrel, dosCLrel]  
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)           AND
              (VERBrec1.reflexivity = notreflexive)
          A1: @
         >

   SUBRULE  (* les + deletion of ellos/ustedes *)
      <mu7: [I11:mu11]>                                       

   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [I112:rel10/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel,unoCLrel, dosCLrel]
       I112: rel10 IN [ tresCLrel]  
       >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = masc)
          A1: @
         >

   
   SUBRULE  (* las + deletion of ellas/ustedes *)
      <mu7: [I11:mu11, I12:mu12]>                                       


   MATCHCONDITIONS
      <
       I11:  (NOT EXIST(mu11, [tresCLrel/..]))   AND
             ALL (mu11, I111:rel8/..)
       I111: rel8 IN [seCLrel, unoCLrel, dosCLrel]
       I12:  (NOT EXIST(mu12, [tresCLrel/..]))   AND
             ALL (mu12, tresCLrel/..)
      >

         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = plural)         AND
              (NPrec1.genero = fem)
          A1: @
         >

>

&

\end{verbatim}
