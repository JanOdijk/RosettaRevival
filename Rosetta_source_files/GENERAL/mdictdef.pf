pragma C_Include('lsphondef.pf');
pragma C_Include('limorfdef.pf');
pragma C_Include('ldmdict.pf');
pragma C_Include('interface1.pf');
pragma C_Include('ldconvrec.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE MDICTDEF;
WITH
        LSPHONDEF,
        LIMORFDEF,
        LDMDICT,
        INTERFACE1,
        LDCONVREC;


(*MPT:::===================================================================*
 *
 *  Type name      : MDICTDEF_RecordDef
 *  Description    : Definition of an MDICT entry.
 *
 *EMP:::===================================================================*)
 TYPE
   MDICTDEF_RecordDef = RECORD
                        stem : LDMDICT_StemType;
                        kind : INTERFACE1_KeyType;
                        CC   : LIMORFDEF_ContextConds;
                        FON  : LSPHONDEF_PhonInfo;
                        where: LDMDICT_WhereType;
                        KEY  : INTEGER
                     END;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : MDICTDEF_MakeMDICTrec
 *  Description     : Fills the attributes of a variable of type MDICT_RecordDef
 *  Parameters      :    stem : LDMDICT_StemType;
 *                       kind : INTERFACE1_KeyType;
 *                       CC   : LIMORFDEF_ContextConds;
 *                       FON  : LSPHONDEF_PhonInfo;
 *                       where: LDMDICT_WhereType;
 *                       KEY  : INTEGER
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE MDICTDEF_MakeMDICTrec(
                        stem : LDMDICT_StemType;
                        kind : INTERFACE1_KeyType;
                        CC   : LIMORFDEF_ContextConds;
                        FON  : LSPHONDEF_PhonInfo;
                        where: LDMDICT_WhereType;
                        KEY  : INTEGER;
                        VAR rec: MDICTDEF_RecordDef);

EXTERNAL;


(*MPF:::===================================================================*
 *
 *  FUNCTION  Name  : MDICTDEF_LIMakeMDICTrec
 *  Description     : Fills the attributes of a variable of type MDICT_RecordDef
 *  Parameters      :    stem : LDMDICT_StemType;
 *                       kind : INTERFACE1_KeyType;
 *                       CC   : LIMORFDEF_ContextConds;
 *                       FON  : LDCONVREC_pAttrStruct;
 *                       where: LDMDICT_WhereType;
 *                       KEY  : INTEGER
 *  Result          : BOOLEAN; TRUE if conversion was possible
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

FUNCTION MDICTDEF_LIMakeMDICTrec(
                        stem : LDMDICT_StemType;
                        kind : INTERFACE1_KeyType;
                        CC   : LIMORFDEF_ContextConds;
                        FON  : LDCONVREC_pAttrStruct;
                        where: LDMDICT_WhereType;
                        KEY  : INTEGER;
                        VAR rec: MDICTDEF_RecordDef): BOOLEAN;

EXTERNAL;


END {MDICTDEF};
