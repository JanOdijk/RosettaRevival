\newpage
\begin{verbatim}
% RULE RDemproWhIdentPl
< m1: I3::NPVAR{NPVARrec1}
  m2: I1::NP{NPrec1}[mu1]
>

< m : I4::NPPROP{NPPROPrec1}
                [ subjrel/I2::NP{NPrec2}[mu2],
                  idrel/I3::NPVAR{NPVARrec1}
                ]
>

   MATCHCONDITIONS
      <
       I1: NPrec1.NPhead IN [redelloNP, esteNP, eseNP, aquelNP] AND
           NPrec1.numero = singular
       I2: NPrec2.NPhead IN [redelloNP, esteNP, eseNP, aquelNP] AND
           NPrec2.numero = plural
       I3: NPVARrec1.NPhead = quewhproNP AND
           NPVARrec1.numero = singular
       I4: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts]
           AND NPPROPrec1.aktionsarts = [stative]
      >

<
   SUBRULE (* 1. redelloNP *)
      < mu1: [head/PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY_redelloBPERSPROkey){BPERSPROrec1}]
             ] 
      >
      < mu2: [head/PERSPRO{PERSPROrec1}
                  [head/BPERSPRO(KEY_redelloBPERSPROkey){BPERSPROrec1}]
             ] 
      >

      COMP
         <
          C1: NPrec1 = AUX_NPONredelloBPRSPR EXCEPT FOR 
                             [supertiempo, generic] AND
              NPrec1.supertiempo = presente         AND
              NPrec1.generic = nogeneric AND
              PERSPROrec1 = COPYT_bTOperspro(BPERSPROrec1) 
          A1: NPrec2 := AUX_NPONredelloBPRSPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         > 

   SUBRULE (* 2. éstos *)
      < mu1: [head/DEMPRO(KEY_estoDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_estosDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONestoDMPR EXCEPT FOR
                              [supertiempo, generic] AND
              NPrec1.supertiempo = presente          AND
              NPrec1.generic = nogeneric             AND
              NPVARrec1.numero = plural              AND
              NPVARrec1.genero = masc
          A1: NPrec2 := AUX_NPONestosDMPR;              
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

   SUBRULE (* 3. ésos *)
      < mu1: [head/DEMPRO(KEY_esoDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_esosDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONesoDMPR EXCEPT FOR
                              [supertiempo, generic] AND
              NPrec1.supertiempo = presente          AND
              NPrec1.generic = nogeneric             AND
              NPVARrec1.numero = plural              AND
              NPVARrec1.genero = masc
          A1: NPrec2 := AUX_NPONesosDMPR;
              NPrec2.numero := singular;
              NPrec2.genero := masc;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

   SUBRULE (* 4. éstas *)
      < mu1: [head/DEMPRO(KEY_estoDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_estasDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONestoDMPR EXCEPT FOR
                              [supertiempo, generic] AND
              NPrec1.supertiempo = presente          AND
              NPrec1.generic = nogeneric             AND
              NPVARrec1.numero = plural              AND
              NPVARrec1.genero = fem
          A1: NPrec2 := AUX_NPONestasDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

   SUBRULE (* 5. ésas *)
      < mu1: [head/DEMPRO(KEY_esoDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_esasDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONesoDMPR EXCEPT FOR
                              [supertiempo, generic] AND
              NPrec1.supertiempo = presente          AND
              NPrec1.generic = nogeneric             AND
              NPVARrec1.numero = plural              AND
              NPVARrec1.genero = fem
          A1: NPrec2 := AUX_NPONesasDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

SUBRULE (* 6. aquéllos *)
      < mu1: [head/DEMPRO(KEY_aquelloDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_aquellosDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONaquelloDMPR EXCEPT FOR
                              [supertiempo, generic] AND
              NPrec1.supertiempo = presente          AND
              NPrec1.generic = nogeneric             AND
              NPVARrec1.numero = plural              AND
              NPVARrec1.genero = masc
          A1: NPrec2 := AUX_NPONaquellosDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

SUBRULE (* 7. aquéllas *)
      < mu1: [head/DEMPRO(KEY_aquelloDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_aquellasDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONaquelloDMPR EXCEPT FOR
                              [supertiempo, generic] AND
              NPrec1.supertiempo = presente          AND
              NPrec1.generic = nogeneric             AND
              NPVARrec1.numero = plural              AND
              NPVARrec1.genero = fem
          A1: NPrec2 := AUX_NPONaquellasDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >
>
&

\end{verbatim}
