\begin{verbatim}
% RULE Rconjsent3
< m1:SENTENCE{SENTENCErec1}[conjrel/CONJ(KEY_queCONJkey){CONJrec1}, mu1 ] 
  m2:PREP{PREPrec1}
>

< m : SENTENCE{SENTENCErec2}[ modrel/PREP{PREPrec1}, 
                              conjrel/CONJ(KEY_queCONJkey){CONJrec1}, 
                              mu1 
                            ] 
>

      COMP
         <
          C1: SENTENCErec1 =                  
		  {
		  senttype   : subordinateclause
		  conjkey    : KEY_queCONJkey
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
		  }
              C11: temp IN PREPrec1.subcs
                   C111: synQUESENTind IN PREPrec1.synpps AND
                         SENTENCErec1.modo = indicativo
                   A111: @
                   C112: synQUESENTsubj IN PREPrec1.synpps AND
                         SENTENCErec1.modo = subjuntivo
                   A112: @
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.temporal := true; 
              C12: PREPrec1.subcs - [temp] <> []
                   C121: synQUESENTind IN PREPrec1.synpps AND
                         SENTENCErec1.modo = indicativo
                   A121: @
                   C122: synQUESENTsubj IN PREPrec1.synpps AND
                         SENTENCErec1.modo = subjuntivo
                   A122: @
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.temporal := false;
          A1: SENTENCErec2 :=                  
		  {
		  adverbial  : true
		  conjclass  : PREPrec1.class
		  conjtiempo : PREPrec1.tiempo
		  conjaspecto: PREPrec1.aspecto
		  conjretro  : PREPrec1.retro
		  };
         >
      DECOMP
         <
          C1: SENTENCErec2 =                  
		  {
		  senttype   : subordinateclause
		  adverbial  : true
		  conjclass  : PREPrec1.class
		  conjtiempo : PREPrec1.tiempo
		  conjaspecto: PREPrec1.aspecto
		  conjretro  : PREPrec1.retro
		  }
              C11: temp IN PREPrec1.subcs AND
                   SENTENCErec2.temporal = true
                   C111: synQUESENTind IN PREPrec1.synpps AND
                         SENTENCErec2.modo = indicativo
                   A111: @
                   C112: synQUESENTsubj IN PREPrec1.synpps AND
                         SENTENCErec2.modo = subjuntivo
                   A112: @
              A11: SENTENCErec1 := SENTENCErec2;
              C12: PREPrec1.subcs - [temp] <> [] AND
                   SENTENCErec2.temporal = false
                   C121: synQUESENTind IN PREPrec1.synpps AND
                         SENTENCErec2.modo = indicativo
                   A121: @
                   C122: synQUESENTsubj IN PREPrec1.synpps AND
                         SENTENCErec2.modo = subjuntivo
                   A122: @
              A12: SENTENCErec1 := SENTENCErec2;
          A1: SENTENCErec1 :=                  
		  {
		  adverbial  : false
		  temporal   : false
		  conjclass  : omegaTimeAdvClass
		  conjtiempo : omegatiempo
		  conjaspecto: omegaaspecto
		  conjretro  : false
		  }
         >

&

\end{verbatim}
