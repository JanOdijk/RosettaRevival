ENGLISH 18

&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TArgReflSpelling1
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       rel2/NPVAR{NPVARrec2},
                       mu4
                     ],
              mu5
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       rel2/I3::NP{NPrec1}[head/T1],
                       mu4
                     ],
              mu5
            ]
>

   MATCHCONDITIONS
      <
       m1: NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
           NOT EXIST (mu3, [../I31::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../I41::NPVAR{NPVARrec4}]) AND
           NOT EXIST (mu4, [../VARPREPP{VARPREPPrec1}
                                   [ mu7,
                                     ../I51::NPVAR{NPVARrec5} ]
                           ] ) AND
           NOT EXIST (mu4, [../PREPP{PREPPrec1}
                                   [ mu7,
                                     ../I51::NPVAR{NPVARrec5} ]
                           ] ) 
       I3: NPrec1.NPhead = reflNP
         I31: NPVARrec3 = NPVARrec1 EXCEPT FOR [cases]
         I41: NPVARrec4 = NPVARrec1 EXCEPT FOR [cases]
         I51: NPVARrec5 = NPVARrec1 EXCEPT FOR [cases]
       m : NOT EXIST (mu3, [../I61::NP{NPrec2}[mu6]]) AND
           NOT EXIST (mu4, [../I61::NP{NPrec2}[mu6]]) AND
           NPVARrec1 = COPYT_npTOvar(NPrec1) EXCEPT FOR [cases]
         I61: NPrec2.NPhead = reflNP
      >

<
   SUBRULE (* 1. myself *)
      < >
      < T1: REFLPRO(AUX_myselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : singular }
          A1: NPrec1 := AUX_NPONmyRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONmyRFLPR AND
              NPVARrec1 = { person : 1
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 2. yourself *)
      < >
      < T1: REFLPRO(AUX_yourselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : singular }
          A1: NPrec1 := AUX_NPONyoursgRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONyoursgRFLPR AND
              NPVARrec1 = { person : 2
                            number : singular }
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3a. himself *)
      < >
      < T1: REFLPRO(AUX_himselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: NPrec1 := AUX_NPONhimRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONhimRFLPR AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3b. herself *)
      < >
      < T1: REFLPRO(AUX_herselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: NPrec1 := AUX_NPONherRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONherRFLPR AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( feminine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI femininegender } )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3c. itself *)
      < >
      < T1: REFLPRO(AUX_itselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( NPVARrec1.sexes = [masculine, feminine] OR
                NPVARrec1.sexes = [] )
          A1: NPrec1 := AUX_NPONitRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONitRFLPR AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( NPVARrec1.sexes = [masculine, feminine] OR
                NPVARrec1.sexes = [] )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 4. ourselves *)
      < >
      < T1: REFLPRO(AUX_ourselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : plural }
          A1: NPrec1 := AUX_NPONourRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONourRFLPR AND
              NPVARrec1 = { person : 1
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 5. yourselves *)
      < >
      < T1: REFLPRO(AUX_yourselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 2
                            number : plural }
          A1: NPrec1 := AUX_NPONourRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONourRFLPR AND
              NPVARrec1 = { person : 2
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 6. themselves *)
      < >
      < T1: REFLPRO(AUX_themselvesREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : plural }
          A1: NPrec1 := AUX_NPONthemRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONthemRFLPR AND
              NPVARrec1 = { person : 3
                            number : plural } 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 6. oneself *)
      < >
      < T1: REFLPRO(AUX_oneselfREFLPROkey){REFLPROrec1} >

      COMP
         <
          C1: NPVARrec1.NPhead = oneNP
          A1: NPrec1 := AUX_NPONoneRFLPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPONoneRFLPR AND
              NPVARrec1.NPhead = oneNP
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TArgReflSpelling1
\item[* relevant examples:] I gave myself a present, One shouldn't degrade 
oneself in front of one's superior, the baby hurt itself/herself/himself
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) TC\_
ArgReflSpelling
\item[* date of creation:] 17-AUG-1988 11:38:19  
\item[* author:] margreet sanders
\item[* copied from:] Dutch TArgReflSpelling1 and English TObjReflInsertion1
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to spell out the second of two identical NPVARs as a reflexive. 
Even the LEVEL of the two VARs must be the same. The cases of the two VARs 
may differ, though.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
For the formulation of the third person singular rules (with reference to sex 
and gender) see TObjReflInsertion1: inanimate NPs have sexes = [], but may 
still have a gender specification (for cases like {\em ship\/}, which might be 
referred to as {\em she\/}. Animate NPs will usually have only one sex (even
words like {\em doctor\/} should have only one sex per entry), but a word like
{\em baby\/} is supposed to be ambiguous with respect to sexes, and can receive 
[masculine, feminine], causing it to be referred to as {\em it\/}.
\end{enumerate}
\item[\ \ consequences in the grammar:]
