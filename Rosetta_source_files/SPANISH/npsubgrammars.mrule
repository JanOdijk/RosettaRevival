\newpage
\begin{verbatim}
% RULE RCNmodRELSENT1
< SUBST:
  m1: CN{CNrec1}[I1:mu1]                 (* substituent *)
  m2: I2::SENTENCE{SENTENCErec1}
              [ shiftrel/T1,
                conjrel/CONJ(KEY_queconjkey){CONJrec1},
                mu2 
              ] 


>

< m : CN{CNrec1}[ I1:mu1, 
                  postmodrel/I4::SENTENCE{SENTENCErec2}
	                [ shiftrel/T2,
                          mu2 
			]
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[head/EN{ENrec1}])
       I2: SENTENCErec1 =
                 { mood        : relative
                   senttype    : subordinateclause
                   finiteness  : finite
                 }
       I4: SENTENCErec2 =
                 { mood        : relative
                   senttype    : subordinateclause
                   finiteness  : finite
                 }
      >



   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE  (* que *)
      < T1: CNVAR{CNVARrec1}>
      < T2:RELPRO(KEY_querelprokey){RELPROrec1}
      >

      COMP
         <
          C1: (CNVARrec1.index = LEVEL ) AND
              (CNVARrec1 = COPYT_CNTOVAR(CNrec1) EXCEPT FOR [cases] ) AND
              (CNVARrec1.cases * [Nominative, Accusative] <> [] ) AND
              (CNVARrec1.cases * [Prepositive] = [])
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   (((SENTENCErec1.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec1.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
              A11: SENTENCErec2 := SENTENCErec1;
              C12: (* temporally dependent *)
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.supertiempo = CNrec1.supertiempo)
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.tiempo := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;
          A1: @
         >


      DECOMP
         <
          C1: true
              C11: (* temporally independent *)
                   (SENTENCErec2.supertiempo = omegatiempo) AND
                   (((SENTENCErec2.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;
               C12: (SENTENCErec2.supertiempo = omegatiempo) AND
                    (SENTENCErec2.tiempo = CNrec1.supertiempo)
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.supertiempo := CNrec1.supertiempo;
                    SENTENCErec1.tiempo := omegatiempo;  
                   
          A1: CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [Nominative, Accusative]
         >


   SUBRULE  (* PREP + RELPRO human, singular (de quien, a quien) *)

       <
       T1: VARPREPP{VARPREPPrec1}
                    [head/PREP{PREPrec1},
                     objrel/CNVAR{CNVARrec1}
                    ]
       >
       <T2: PREPP{PREPPrec1}
                 [head/PREP{PREPrec1},
                  objrel/NP{NPrec1}[head/RELPRO(KEY_quienRELPROkey){RELPROrec1}]
                 ]
       >

   MATCHCONDITIONS
      <
      >


      COMP
         <
          C1: (CNVARrec1.index = LEVEL ) AND
              (CNVARrec1 = COPYT_CNTOVAR(CNrec1) EXCEPT FOR [cases] ) AND
              (CNVARrec1.human = yeshuman) AND
              (CNVARrec1.cases * [prepositive] <> []) AND
              (CNVARrec1.numero = singular)
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   (((SENTENCErec1.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec1.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
              A11: SENTENCErec2 := SENTENCErec1;
              C12: (* temporally dependent *)
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.supertiempo = CNrec1.supertiempo)
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.tiempo := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;

          A1: PREPPrec1 := VARPREPPrec1;
              PREPPrec1.mood := relativexpmood;
              NPrec1 := 
                    {
                     definite       : def
                     numero         : singular  
                     cases          : [prepositive]
                     genero         : masc          (* also fem needed! EA *)
                     animate        : yesanimate
                     human          : yeshuman
                     mood           : relativexpmood
                     generic        : omegageneric
                     syntquant      : Equant
                     specq          : yesspec
                  }
         >


      DECOMP
         <
          C1: PREPPrec1.mood  = relativexpmood AND
              CNrec1.numero = singular AND
              NPrec1 = 
                    {
                     definite       : def
                     numero         : singular  
                     cases          : [prepositive]
                     genero         : masc         (* also fem needed! EA *)
                     animate        : yesanimate
                     human          : yeshuman
                     mood           : relativexpmood
                     generic        : omegageneric
                     syntquant      : Equant
                     specq          : yesspec
                  }
              C11: (* temporally independent *)
                   (SENTENCErec2.supertiempo = omegatiempo) AND
                   (((SENTENCErec2.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;
               C12: (SENTENCErec2.supertiempo = omegatiempo) AND
                    (SENTENCErec2.tiempo = CNrec1.supertiempo)
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.supertiempo := CNrec1.supertiempo;
                    SENTENCErec1.tiempo := omegatiempo;  
                   
          A1: VARPREPPrec1 := PREPPrec1;
              VARPREPPrec1.mood := declxpmood;
              CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.human := yeshuman; 
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [prepositive];
         >

   SUBRULE  (* PREP + RELPRO human, plural (de quienes, a quienes) *)

       <
       T1: VARPREPP{VARPREPPrec1}
                    [head/PREP{PREPrec1},
                     objrel/CNVAR{CNVARrec1}
                    ]
       >
       <T2: PREPP{PREPPrec1}
                 [head/PREP{PREPrec1},
                  objrel/NP{NPrec1}[head/RELPRO(KEY_quienesRELPROkey)
                                                                 {RELPROrec1}]
                 ]
       >

   MATCHCONDITIONS
      <
      >


      COMP
         <
          C1: (CNVARrec1.index = LEVEL ) AND
              (CNVARrec1 = COPYT_CNTOVAR(CNrec1) EXCEPT FOR [cases] ) AND
              (CNVARrec1.human = yeshuman) AND
              (CNVARrec1.cases * [prepositive] <> []) AND
              (CNVARrec1.numero = plural)
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   (((SENTENCErec1.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec1.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
              A11: SENTENCErec2 := SENTENCErec1;
              C12: (* temporally dependent *)
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.supertiempo = CNrec1.supertiempo)
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.tiempo := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;

          A1: PREPPrec1 := VARPREPPrec1;
              PREPPrec1.mood := relativexpmood;
              NPrec1 := 
                    {
                     definite       : def
                     numero         : plural  
                     cases          : [prepositive]
                     genero         : masc          (* also fem needed! EA *)
                     animate        : yesanimate
                     human          : yeshuman
                     mood           : relativexpmood
                     generic        : omegageneric
                     syntquant      : Equant
                     specq          : yesspec
                  };
         >


      DECOMP
         <
          C1: PREPPrec1.mood  = relativexpmood AND
              CNrec1.numero = plural AND
              NPrec1 = 
                    {
                     definite       : def
                     numero         : plural  
                     cases          : [prepositive]
                     genero         : masc         (* also fem needed! EA *)
                     animate        : yesanimate
                     human          : yeshuman
                     mood           : relativexpmood
                     generic        : omegageneric
                     syntquant      : Equant
                     specq          : yesspec
                  }
              C11: (* temporally independent *)
                   (SENTENCErec2.supertiempo = omegatiempo) AND
                   (((SENTENCErec2.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;
               C12: (SENTENCErec2.supertiempo = omegatiempo) AND
                    (SENTENCErec2.tiempo = CNrec1.supertiempo)
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.supertiempo := CNrec1.supertiempo;
                    SENTENCErec1.tiempo := omegatiempo;  
                   
          A1: VARPREPPrec1 := PREPPrec1;
              VARPREPPrec1.mood := declxpmood;
              CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.human := yeshuman; 
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [prepositive];
         >


   SUBRULE  (* PREP + RELPRO  (de que, a que) *)

       <
       T1: VARPREPP{VARPREPPrec1}
                    [head/PREP{PREPrec1},
                     objrel/CNVAR{CNVARrec1}
                    ]
       >
       <T2: PREPP{PREPPrec1}
                 [head/PREP{PREPrec1},
                  objrel/RELPRO(KEY_querelprokey){RELPROrec1}
                 ]
       >

   MATCHCONDITIONS
      <
      >


      COMP
         <
          C1: (CNVARrec1.index = LEVEL ) AND
              (CNVARrec1 = COPYT_CNTOVAR(CNrec1) EXCEPT FOR [cases] ) AND
              (CNVARrec1.human <> yeshuman) AND
              (CNVARrec1.cases * [prepositive] <> [])
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   (((SENTENCErec1.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec1.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
              A11: SENTENCErec2 := SENTENCErec1;
              C12: (* temporally dependent *)
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.supertiempo = CNrec1.supertiempo)
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.tiempo := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;

          A1: PREPPrec1 := VARPREPPrec1;
              PREPPrec1.mood := relativexpmood;
         >


      DECOMP
         <
          C1: PREPPrec1.mood  = relativexpmood 
              C11: (* temporally independent *)
                   (SENTENCErec2.supertiempo = omegatiempo) AND
                   (((SENTENCErec2.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;
               C12: (SENTENCErec2.supertiempo = omegatiempo) AND
                    (SENTENCErec2.tiempo = CNrec1.supertiempo)
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.supertiempo := CNrec1.supertiempo;
                    SENTENCErec1.tiempo := omegatiempo;  
                   
          A1: VARPREPPrec1 := PREPPrec1;
              VARPREPPrec1.mood := declxpmood;
              CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [prepositive];
         >

   SUBRULE  (* al que *)
      < T1: CNVAR{CNVARrec1}>
      < T2:NP{NPrec1}[modrel/PREP(KEY_aprepkey){PREPrec1},
                      gluerel/GLUE{},
                      detrel/DETP{DETPrec1}
                            [head/ART(KEY_elartkey){ARTrec1}],
                      head/RELPRO(KEY_queRELPROkey){RELPROrec1}]
      >

      COMP
         <
          C1: (CNVARrec1.index = LEVEL ) AND
              (CNVARrec1 = COPYT_CNTOVAR(CNrec1) EXCEPT FOR [cases] ) AND
              (CNVARrec1.cases * [Nominative, Accusative] = [] ) AND
              (CNVARrec1.cases * [Prepositive] <> []) AND
              (CNVARrec1.numero = singular) AND
              (masc IN CNVARrec1.generos ) AND
              (CNVARrec1.human = yeshuman)
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   (((SENTENCErec1.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec1.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
              A11: SENTENCErec2 := SENTENCErec1;
              C12: (* temporally dependent *)
                   (SENTENCErec1.tiempo = omegatiempo) AND
                   (SENTENCErec1.supertiempo = CNrec1.supertiempo)
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.tiempo := CNrec1.supertiempo;
                   SENTENCErec2.supertiempo := omegatiempo;
          A1: NPrec1 := 
                    {
                     definite       : def
                     numero         : CNVARrec1.numero  
                     cases          : [prepositive]
                     genero         : masc
                     animate        : yesanimate
                     human          : yeshuman
                     mood           : relativexpmood
                     generic        : omegageneric
                     syntquant      : Equant
                     specq          : yesspec
                  }
   
         > 


      DECOMP
         <
          C1: NPrec1 = 
                    {
                     definite       : def
                     numero         : CNrec1.numero  
                     cases          : [prepositive]
                     genero         : masc
                     animate        : yesanimate
                     human          : yeshuman
                     mood           : relativexpmood
                     generic        : omegageneric
                     syntquant      : Equant
                     specq          : yesspec
                  } AND
              CNrec1.numero = singular AND
              masc IN CNrec1.generos AND
              CNrec1.human = yeshuman 

              C11: (* temporally independent *)
                   (SENTENCErec2.supertiempo = omegatiempo) AND
                   (((SENTENCErec2.tiempo = presente) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> presente)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.tiempo = pasado) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.supertiempo <> pasado) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;
               C12: (SENTENCErec2.supertiempo = omegatiempo) AND
                    (SENTENCErec2.tiempo = CNrec1.supertiempo)
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.supertiempo := CNrec1.supertiempo;
                    SENTENCErec1.tiempo := omegatiempo;  
                   
          A1: CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [prepositive]
         >

   SUBRULE  (* a la que *)
      < T1: CNVAR{CNVARrec1}>
      < T2:NP{NPrec1}[modrel/PREP(KEY_aprepkey){PREPrec1},
                      detrel/DETP{DETPrec1}
                            [head/ART(KEY_laARTkey){ARTrec1}],
                      head/RELPRO(KEY_queRELPROkey){RELPROrec1}]
      >

      COMP
         <
          C1: (CNVARrec1.index = LEVEL ) AND
              (CNVARrec1 = COPYT_CNTOVAR(CNrec1) EXCEPT FOR [cases] ) AND
              (CNVARrec1.cases * [Nominative, Accusative] = [] ) AND
              (CNVARrec1.cases * [Prepositive] <> []) AND
              (CNVARrec1.numero = singular) AND
              (fem IN CNVARrec1.generos ) AND
              (CNVARrec1.human = yeshuman)
              C11: (* temporally independent *)
                   (SENTENCErec1.supertiempo = omegatiempo) AND
                   (((SENTENCErec1.tiempo = presente) AND
