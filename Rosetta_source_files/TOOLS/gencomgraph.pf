pragma C_include ('#langspec.pf');
pragma C_include ('#decl.pf');

PACKAGE #GRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH #DECL,
     #LANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: #LANGSPEC_Category;
                          b: #DECL_nodeid): #DECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: #DECL_psurfgraph): #DECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: #DECL_psurfgraph): #DECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: #DECL_psurfgraph): #DECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: #DECL_psurfgraph): #DECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: #LANGSPEC_Category; 
                          c: #DECL_psurfgraph); EXTERNAL;
 
END {#GRAPH};
