\begin{verbatim}
% RULE Ridnppsuperdeixis
< m1:NPPROP{NPPROPrec1}[I1:mu1] 
>

< m :NPPROP{NPPROPrec1'}[I1:mu1] 
>

   MATCHCONDITIONS
      <
       I1: EXIST(mu1,[idrel/..])
      >

   PARAMETERS
      <
       super: deixistype
      >


      COMP
         <
          C1:NPPROPrec1.superdeixis = omegadeixis
          A1:NPPROPrec1' := NPPROPrec1;
             NPPROPrec1'.superdeixis := super;
         >
      DECOMP
         <
          C1: true
          A1: NPPROPrec1 := NPPROPrec1';
              NPPROPrec1.superdeixis := omegadeixis;
              super := NPPROPrec1'.superdeixis;
         >


&

\end{verbatim}
