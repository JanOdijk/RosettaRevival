\newpage
\begin{verbatim}
% RULE Rdaymonth
< 
  m1: NP{NPrec1}
         [
          head/PROPERNOUN{PROPERNOUNrec1}[mu2],
          mu3
         ]   
  m2: DETP{DETPrec1}[I1:mu1] 

>

< m : NP{NPrec2}
         [ detrel/DETP{DETPrec2}[I1:mu1],
           postmodrel/PREPP{PREPPrec1}
                            [ head/PREP(KEY_deprepkey){PREPrec1},
                              postmodrel/NP{NPrec3}
                                          [
                                           head/PROPERNOUN{PROPERNOUNrec1}[mu2],
                                           mu3
                                          ]
                            ]
         ]
>

   MATCHCONDITIONS
      <
       I1: EXIST (mu1,[I11:head/T1])
       I11: T1.CAT = CARD
      >


      COMP
         <
          C1: PROPERNOUNrec1.subc = monthnoun AND
              DETPrec1.supertiempo = NPrec1.supertiempo 
          A1: NPrec2 := NPrec1;
              NPrec3 := NPrec2;
              NPrec3.supertiempo := omegatiempo;
              NPrec3.generic := omegageneric;
              NPrec3.cases := [accusative];
              DETPrec2 := DETPrec1;
              DETPrec2.supertiempo := omegatiempo;
              PREPPrec1 := { 
                              req : [pospol,negpol,omegapol]
                              env : [pospol,negpol,omegapol]
                              mood : NPrec3.mood
                              actsubcefs : PREPrec1.subcs
                              synppefs : [synNP]
                              thetapp : pp120
                              headkey : PREPrec1.key
                              class : PREPrec1.class
                              tiempo : PREPrec1.tiempo
                              aspecto : PREPrec1.aspecto
                              retro : PREPrec1.retro
                              supertiempo : omegatiempo
                              SpecQ :NPrec3.SpecQ
                            }
    
              
         >

      DECOMP
         <
          C1: PROPERNOUNrec1.subc = monthnoun  AND
              DETPrec2.supertiempo = omegatiempo  AND
              NPrec3 = NPrec2
                       EXCEPT FOR [supertiempo,generic,cases] AND
              NPrec3.supertiempo = omegatiempo  AND              
              NPrec3.generic = omegageneric   AND                   
              accusative IN NPrec3.cases   AND
              PREPPrec1 = { 
                              req : [pospol,negpol,omegapol]
                              env : [pospol,negpol,omegapol]
                              mood : NPrec3.mood
                              actsubcefs : PREPrec1.subcs
                              synppefs : [synNP]
                              thetapp : pp120
                              headkey : PREPrec1.key
                              class : PREPrec1.class
                              tiempo : PREPrec1.tiempo
                              aspecto : PREPrec1.aspecto
                              retro : PREPrec1.retro
                              supertiempo : omegatiempo
                              SpecQ :NPrec3.SpecQ
                            }
     
          A1: NPrec1 := NPrec2;
              DETPrec1 := DETPrec2; (*  EXCEPT FOR [supertiempo];  *)
              DETPrec1.supertiempo := NPrec2.supertiempo;               
       >
              
&

\end{verbatim}
