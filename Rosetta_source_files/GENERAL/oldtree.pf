pragma C_Include('strings.pf');
pragma C_Include('listree.pf');
pragma C_Include('superdtree.pf');
pragma C_Include('hyperdtree.pf');
pragma C_Include('hiltree.pf');
pragma C_Include('wnd.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE OldTree;
WITH STRINGS, SUPERDTREE, HYPERDTREE, HILTREE, LISTREE, WND;

(*MPT:::===================================================================*
 *
 *  Type name      : OLDTREE_TreeType
 *  Description    : This type contains all the treetypes which
 *                   can be processed by DRAWTREE.
 *                   To add a new treetype do the following things:
 *                   1) Add the type to OLDTREE_TreeType (env.)
 *                   2) Add the type to OLDTREE_OldTree  (env.)
 *                   3) Add to all the functions and procedures
 *                      the statements to process the new tree (impl.)
 *                   4) Add the module of the new treetype in the
 *                      inherit statement of OLDTREE. (environment + impl.)
 *                   5) Create a new module DRAW*TREE
 *                      (Use DRAWJTREE as example)
 *                   6) And last but not least update MMS file.
 *                      a) add new treetype source in ENV OLDTREE
 *                      b) add new treetype source in PAS OLDTREE
 *                      c) add new treetype source in OBJ OLDTREE
 *EMP:::===================================================================*)

TYPE
   OLDTREE_TreeType = (OLDTREE_Empty, OLDTREE_JTree,
                       OLDTREE_STree, OLDTREE_SuperDTree,
                       OLDTREE_HyperDtree, OLDTREE_HyperILtree);



(*MPT:::===================================================================*
 *
 *  Type name      : OldTree_OldTree
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   OldTree_OldTree = RECORD
                       CASE TreeType : OLDTREE_TreeType OF
                          OLDTREE_Empty : ();
                          OLDTREE_STree : (STree : LISTREE_pRelNode);
                          OLDTREE_SuperDTree : (SuperDTree : SuperDtree_pLoSuperSon);
                          OLDTREE_HyperDTree : (HyperDtree : HyperDtree_pLoHyperDtree);
                          OLDTREE_HyperILtree: (HyperILtree: HILtree_pLoHyperILtree);
                     END;


(*MPF:::===================================================================*
 *
 *  Function Name  : OldTree_Initialize
 *  Description    : This function initializes the internal registration of
 *                   hypernodes.
 *  Parameters     :
 *  Result         :
