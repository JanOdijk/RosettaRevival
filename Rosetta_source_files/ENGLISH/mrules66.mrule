\begin{verbatim}

% RULE RNPformation4         (* () + NOUN  --> the + () + NOUN *)

< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec1}[mu2],
                 I1:mu3]
>

< m: I2::NP{NPrec1}[detrel/DETP{DETPrec1}[head/ART(KEY_theartkey)
                                                   {ARTrec1}],
                    head/CN{CNrec1}[mu1,
                                    head/NOUN{NOUNrec1}[mu2],
                                    I1:mu3]
                   ]
>
   MATCHCONDITIONS
      <
       I1: (NOT EXIST(mu3, [posrel/NP{NPrec2}[mu4]]) 
                     (* a possible result of RCNmodposs3  *)) AND
           (NOT EXIST(mu3, [posrel/PREPP{PREPPrec2}[I11:mu8]]))
       I11: (EXIST(mu8, [objrel/NP{NPrec9}[mu9,
                                          head/T3
                                         ]
                       ]) (*  to exlude: the house of my father;
                              to allow: the house of the boy on this picture 
                          *)
            )
            OR
            (EXIST(mu8, [objrel/I111::NP{NPrec8}[mu10]]))
       I111: NPrec8.animate = yesanimate 
                            (* to allow: the people of this city *)
       I2: NPrec1 = { NPhead    : otherNP
                      person    : 3 }
      >

      COMP
         <
          C1: true

              C11: singular IN NOUNrec1.numbers
              A11: NPrec1.number := singular
              C12: plural IN NOUNrec1.numbers
              A12: NPrec1.number := plural

          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              (* mood, possnietnp, syntquant remain default *)
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders

         (* added mjs *)  cases             : CNrec1.cases 
                          class             : CNrec1.class
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro 
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         };
                          NPrec1.actcomas       := CNrec1.posscomas;
         >

      DECOMP
         <
          C1:  DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
               DETPrec1.posspred = true AND
               DETPrec1 = { mood        : nowh
                            possnietnp  : false
                            syntquant   : omegaquant } AND
               NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          
         (* added mjs *)  cases             : CNrec1.cases 
                          class             : CNrec1.class
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro 
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                         }  AND
                         NPrec1.actcomas * CNrec1.posscomas <> []

                 C11: singular IN NOUNrec1.numbers AND
                      NPrec1.number  = singular
                 A11: @
                 C12: plural IN NOUNrec1.numbers AND
                      NPrec1.number = plural
                 A12: @
             
          A1:  @
         >
&

\end{verbatim}
