(*MPD:::===================================================================*
 *
 *  Rosetta Project                                                 
 *                                                                  
 *  Module Title    : LIDOMAINT
 *  Creation date   :                                               
 *  Author          :                                               
 *                                                                  
 *  Copyright (c) 1985, by Nederlandse Philips Bedrijven BV.        
 *                                                                  
 *  Remarks         :  This module defines some types that have language
 *                     specific counterparts. 
 *                     The types defined here are completely
 *                     language independent. The language specific counterparts
 *                     can be found in the module LSDOMAINT for each language.
 *                     If information is passed from language specific modules
 *                     to language independent modules a CAST operation 
 *                     transforms the LS-types into the LI-types. In order
 *                     to guarantee that can be done without any problems, we
 *                     only allow it for pointers and enumeration types.
 *                     The LI counterpart of a LS pointertype will be a pointer
 *                     to integer. For each enumeration type a fixed number
 *                     of constants must be present, e.g. both LIDOMAINT_syntcat
 *                     and LSDOMAIN_syntcat must contain the same number of
 *                     constants.
 *
 *EMP:::===================================================================*)


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LIDOMAINT;


(*MPC:::===================================================================*
 *
 *  Constant name  : LIDOMAINT_maxrelcat
 *  Description    : 
 *
 *EMP:::===================================================================*)

CONST
   LIDOMAINT_maxrelcat = 150;


TYPE

(*MPT:::===================================================================*
 *  WATCH OUT!!!
 *  Type name      : LIDOMAINT_syntcat
 *  Description    : Defines the language independent syntactic categories.
 *                   Module LSDOMAINT of each language should contain a
 *                   definition of LSDOMAINT_syntcat, which must also be
 *                   an enumeration type containing 80 values.
 *
 *EMP:::===================================================================*)   

   LIDOMAINT_syntcat         = 
           (LIBUG, LIUG, LICAT0,
            LICAT1,LICAT2,LICAT3,LICAT4,LICAT5,LICAT6,LICAT7,LICAT8,LICAT9,LICAT10,
            LICAT11,LICAT12,LICAT13,LICAT14,LICAT15,LICAT16,LICAT17,LICAT18,LICAT19,LICAT20,
            LICAT21,LICAT22,LICAT23,LICAT24,LICAT25,LICAT26,LICAT27,LICAT28,LICAT29,LICAT30,
            LICAT31,LICAT32,LICAT33,LICAT34,LICAT35,LICAT36,LICAT37,LICAT38,LICAT39,LICAT40,
            LICAT41,LICAT42,LICAT43,LICAT44,LICAT45,LICAT46,LICAT47,LICAT48,LICAT49,LICAT50,
            LICAT51,LICAT52,LICAT53,LICAT54,LICAT55,LICAT56,LICAT57,LICAT58,LICAT59,LICAT60,
            LICAT61,LICAT62,LICAT63,LICAT64,LICAT65,LICAT66,LICAT67,LICAT68,LICAT69,LICAT70,
            LICAT71,LICAT72,LICAT73,LICAT74,LICAT75,LICAT76,LICAT77,LICAT78,LICAT79,LICAT80,
            LICAT81,LICAT82,LICAT83,LICAT84,LICAT85,LICAT86,LICAT87,LICAT88,LICAT89,LICAT90,
            LICAT91,LICAT92,LICAT93,LICAT94,LICAT95,LICAT96,LICAT97,LICAT98,LICAT99,
            LICAT100,
            LICAT101,LICAT102,LICAT103,LICAT104,LICAT105,LICAT106,LICAT107,LICAT108,LICAT109,LICAT110,
            LICAT111,LICAT112,LICAT113,LICAT114,LICAT115,LICAT116,LICAT117,LICAT118,LICAT119,LICAT120,
            LICAT121,LICAT122,LICAT123,LICAT124,LICAT125,LICAT126,LICAT127,LICAT128,LICAT129,LICAT130,
            LICAT131,LICAT132,LICAT133,LICAT134,LICAT135,LICAT136,LICAT137,LICAT138,LICAT139,LICAT140,
            LICAT141,LICAT142,LICAT143,LICAT144,LICAT145,LICAT146,LICAT147,LICAT148,LICAT149,LICAT150);


(*MPT:::===================================================================*
 *  WATCH OUT!!!
 *  Type name      : LIDOMAINT_synrel
 *  Description    : Defines the (language independent) syntactic relation 
 *                   type between a node in the S-tree and its sons.
 *                   Module LSDOMAINT of each language should contain a
 *                   definition of LSDOMAINT_synrel, which must also be
 *                   an enumeration type containing 80 values.
 *
 *EMP:::===================================================================*)   

   LIDOMAINT_synrel         = 
           (LIREL0,
            LIREL1,LIREL2,LIREL3,LIREL4,LIREL5,LIREL6,LIREL7,LIREL8,LIREL9,LIREL10,
            LIREL11,LIREL12,LIREL13,LIREL14,LIREL15,LIREL16,LIREL17,LIREL18,LIREL19,LIREL20,
            LIREL21,LIREL22,LIREL23,LIREL24,LIREL25,LIREL26,LIREL27,LIREL28,LIREL29,LIREL30,
            LIREL31,LIREL32,LIREL33,LIREL34,LIREL35,LIREL36,LIREL37,LIREL38,LIREL39,LIREL40,
            LIREL41,LIREL42,LIREL43,LIREL44,LIREL45,LIREL46,LIREL47,LIREL48,LIREL49,LIREL50,
            LIREL51,LIREL52,LIREL53,LIREL54,LIREL55,LIREL56,LIREL57,LIREL58,LIREL59,LIREL60,
            LIREL61,LIREL62,LIREL63,LIREL64,LIREL65,LIREL66,LIREL67,LIREL68,LIREL69,LIREL70,
            LIREL71,LIREL72,LIREL73,LIREL74,LIREL75,LIREL76,LIREL77,LIREL78,LIREL79,LIREL80 );


(*MPT:::===================================================================*
 *
 *  Type name      : LIDOMAINT_pLSrecord
 *  Description    : Pointer to LS information. Because this part is not 
 *                   relevant for the LI software, it is implemented with
 *                   a pointer to integer. If the record under consideration
 *                   is being passed to LS software, the type is casted to 
 *                   a pointer to a LDSTREE_LSrecord record.
 *
 *EMP:::===================================================================*)
   LIDOMAINT_pLSrecord = ^integer;
   
   
END {LIDOMAINT};
