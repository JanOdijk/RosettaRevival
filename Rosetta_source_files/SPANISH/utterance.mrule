SPANISH 55
&
\begin{verbatim}
%
%SUBGRAMMAR Utterance

(RUTT1/1 | RUTTNP/2 | RUTTADVP/3 | RUTTADJP/4 | RUTTPREPP/5 | RUTTEXCLAM/7 )
.[Raddexclam/8]

HEAD:
<
NP             FROM (NPFORMATION)
PREPP          FROM (PREPPFORMATION)
ADVP           FROM (ADVPFORMATION)
ADJP           FROM (ADJPFORMULAtoADJPPROP)
CLOSEDADVPPROP FROM (ADVPFORMULATOADVPPROP)
OPENADJPPROP   FROM (ADJPFORMULATOADJPPROP)
SENTENCE       FROM (CLAUSEtoSENTENCE)
>

(* IMPORT: *)
<
>

EXPORT:
<
UTT
>
&

\newpage
% RULE RUtt1
< m1:T1
>

< m :UTT{UTTrec1}[head/T1]
>


<
   SUBRULE
      <T1:SENTENCE{SENTENCErec1}[mu1]  >
      <T1:SENTENCE{SENTENCErec1}[mu1]  >

      COMP
         <
          C1: SENTENCErec1.senttype = mainclause  AND
              (SENTENCErec1.finiteness = finite  OR
               SENTENCErec1.mood = WHinterrogative
              ) AND
              QUOTE_polarityok(T1)               AND
              (NOT QUOTE_varsintree(T1))
          A1: @
           >

      DECOMP
         <
          C1: SENTENCErec1.senttype = mainclause AND
              (SENTENCErec1.finiteness = finite  OR
               SENTENCErec1.mood = WHinterrogative
              ) AND
              QUOTE_polarityok(T1)
          A1: @
         >
>
&

\end{verbatim}
