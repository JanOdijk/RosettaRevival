
SPANISH 7
&
%
% SUBGRAMMAR cardinals

 ( RSINGLEcard/1 )
.{ RCOMPOSEDcard/2 }

HEAD: 
<
DIGIT BASIC EXPRESSION
>

(* IMPORT: *)
<

>

EXPORT:
< CARD >

&
\end{verbatim}

\newpage
\begin{verbatim}
% RULE RSINGLEcard
< m1:
     DIGIT{DIGITrec1}
>

< m :
     CARD{CARDrec1}
             [
              head/DIGIT{DIGITrec1}
             ]
>

      COMP
         <
          C1: DIGITrec1.valeu = 1
          A1: CARDrec1.numero := singular

          C2: DIGITrec1.valeu <> 1
          A2: CARDrec1.numero := plural
         >
      DECOMP
         <
          C1: DIGITrec1.valeu = 1 AND 
              CARDrec1.numero = singular
          A1: @

          C2: DIGITrec1.valeu <> 1 AND
              CARDrec1.numero = plural
          A2: @
         >

&

\end{verbatim}
