\begin{verbatim}
% TRANSFORMATION TNoVPAdvs
< m1: CLAUSE{CLAUSErec1}
            [ mu1, 
              predrel/VERBP{VERBPrec1}[I1:mu2],
              mu3
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              predrel/VERBP{VERBPrec1}[I1:mu2],
              mu3
            ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu2, [I11:rel1/I12::ADVP{ADVPrec1}[mu4]]) 
         I11: rel1 IN [agvpadvrel, vpadvrel]
         I12: ADVPrec1.advpatternefs = [synCLAUSE]
      >

      COMP
         <
          C1: true
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
