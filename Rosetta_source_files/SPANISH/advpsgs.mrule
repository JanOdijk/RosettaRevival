\newpage
\begin{verbatim}

% RULE RSubadjToSubadv
< m1: BADVSUFF(KEY_menteBADVSUFFkey){BADVSUFFrec1}
  m2: I1::SUBADJ{SUBADJrec1}[mu1]
>

< m : SUBADV{SUBADVrec1}
            [ complrel/I1::SUBADJ{SUBADJrec1}[mu1],
              head/BADVSUFF(KEY_menteBADVSUFFkey){BADVSUFFrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: SUBADJrec1.possadv = true
      >

      COMP
         <
          C1: true
          A1: SUBADVrec1 := { req         : SUBADJrec1.req
                              env         : SUBADJrec1.env
                              subcs       : BADVSUFFrec1.subcs
                              Qstatus     : false
                              class       : SUBADJrec1.class
                              tiempo      : SUBADJrec1.tiempo
                              aspecto     : SUBADJrec1.aspecto
                              retro       : SUBADJrec1.retro
                              mood        : BADVSUFFrec1.mood
                              thetaadv    : BADVSUFFrec1.thetaadv
                              advpatterns : BADVSUFFrec1.advpatterns
                              prepkey     : BADVSUFFrec1.prepkey
                              temporal    : BADVSUFFrec1.temporal 
                              thanas      : BADVSUFFrec1.thanas
                            }
         >

      DECOMP
         <
          C1: SUBADVrec1 =  { req         : SUBADJrec1.req
                              env         : SUBADJrec1.env
                              subcs       : BADVSUFFrec1.subcs
                              Qstatus     : false
                              class       : SUBADJrec1.class
                              tiempo      : SUBADJrec1.tiempo
                              aspecto     : SUBADJrec1.aspecto
                              retro       : SUBADJrec1.retro
                              mood        : BADVSUFFrec1.mood
                              thetaadv    : BADVSUFFrec1.thetaadv
                              advpatterns : BADVSUFFrec1.advpatterns
                              prepkey     : BADVSUFFrec1.prepkey
                              temporal    : BADVSUFFrec1.temporal 
                              thanas      : BADVSUFFrec1.thanas
                            }

          A1:  @
         >
&

\end{verbatim}
