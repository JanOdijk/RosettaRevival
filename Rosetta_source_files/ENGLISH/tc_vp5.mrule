\begin{verbatim}
% TRANSFORMATION TVerbpattern10
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                           [ head/VERB{VERBrec1}[mu2],
                             argrel/T1,
                             argrel/T2
                           ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                           [ head/VERB{VERBrec1}[mu2],
                             rel1/T1,
                             I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                     [ head/PREP(VERBrec1.prepkey2){PREPrec1},
                                       objrel/T2 ]
                           ] 
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey2
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR 
                [headkey, actsubcefs, synppefs, mood, thetapp,
                 specQ, class, aspect, deixis, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            aspect     : PREPrec1.aspect
                            deixis     : PREPrec1.deixis
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >

<
   SUBRULE (* 1a. x1 talk (to EMPTY) about x2 *)
      < T1: EMPTYVAR{EMPTYVARrec1} 
        T2: NPVAR{NPVARrec1}>

      < T1: EMPTYVAR{EMPTYVARrec1} 
        T2: NPVAR{NPVARrec1}>

      COMP
         <
          C1: synEMPTY_PREP2NP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_PREP2NP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec1.mood
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := prepobjrel
         >
      DECOMP
         <
          C1: synEMPTY_PREP2NP IN VERBrec1.synvps AND
              synEMPTY_PREP2NP IN VERBPPROPrec2.synvpefs 
              AND
              VARPREPPrec1 = { synppefs NI synNP 
                               mood      : NPVARrec1.mood
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 } AND
              rel1 = prepobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. x1 talk (to EMPTY) about x2 *)
      < T1: EMPTYVAR{EMPTYVARrec1} 
        T2: CNVAR{CNVARrec1}>

      < T1: EMPTYVAR{EMPTYVARrec1} 
        T2: CNVAR{CNVARrec1}>

      COMP
         <
          C1: synEMPTY_PREP2NP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY_PREP2NP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := prepobjrel
         >
      DECOMP
         <
          C1: synEMPTY_PREP2NP IN VERBrec1.synvps AND
              synEMPTY_PREP2NP IN VERBPPROPrec2.synvpefs 
              AND
              VARPREPPrec1 = { synppefs NI synNP 
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              rel1 = prepobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

>
&

\end{verbatim}
