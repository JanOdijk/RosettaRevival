\begin{verbatim}
% RULE RIndicYesNoMoodSub     (* finite, yesnointerr., subordinate *)
< m1: I2::CLAUSE{CLAUSErec1}
                [ I1:mu1,
                  auxrel/VERB{VERBrec1}[mu2],
                  mu3
                ]
>

< m : I3::SENTENCE{SENTENCErec1}
                  [ I4:sig1,
                    I1:mu1,
                    auxrel/VERB{VERBrec2}[mu2],
                    mu3
                  ]
>


   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [I12:rel1/..])
         I12: rel1 IN [leftdislocrel, shiftrel, conjrel]
       I2: CLAUSErec1.finiteness = finite AND
           CLAUSErec1.modus = omegamodus
       I3: SENTENCErec1 = { finiteness: finite
                            mood      : yesnointerrogative
                            senttype  : subordinateclause
                            modus     : indicative
                            adverbial : false
                            temporal  : false
                            conjclass : omegaTimeadvClass
                            conjdeixis: omegadeixis
                            conjaspect: omegaAspect
                            conjretro : false } 
           (* no test on deixis of SENTENCE: it may not have
              been assigned, in case of independent deixis *)
       I4: EXIST (sig1, [conjrel/..])
      >

<
   SUBRULE (* 1. whether *)
      < >
      < sig1: [conjrel/CONJ(KEY_whetherCONJkey){CONJrec1}] >

      COMP
         <
          C1: VERBrec1.modus = omegamodus
          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := indicative;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : yesnointerrogative
                                senttype : subordinateclause
                                modus    : indicative
                                conjkey  : KEY_whetherCONJkey }
            (* other attributes specific to sentence 
               retain default values *)
         >

      DECOMP
         <
          C1: VERBrec2.modus = indicative AND
              SENTENCErec1.conjkey = KEY_whetherCONJkey
          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus
         >

   SUBRULE (* 2. if *)
      < >
      < sig1: [conjrel/CONJ(KEY_ifCONJkey){CONJrec1}] >

      (* no COMP part *)

      DECOMP
         <
          C1: VERBrec2.modus = indicative AND
              SENTENCErec1.conjkey = KEY_ifCONJkey
          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus
         >
>
&
\end{verbatim}
