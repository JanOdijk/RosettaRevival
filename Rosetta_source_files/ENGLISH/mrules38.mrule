ENGLISH 38
&
\newpage
\begin{verbatim}
%
% RULE Raspectimperfective1
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3: mu2,
                    I2: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [I3: mu2,
                    progauxrel/VERB{VERBrec3}
                              [head/SUBVERB{SUBVERBrec1}
                                   [head/BVERB(KEY_bebverbkey){BVERBrec1}[]
                                   ]
                              ],
                    I2: rel1/VERB{VERBrec2}[mu3],
                    mu4
                   ],
            I1: mu5
            ]
>
   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu5)
       I2: rel1 IN [head, passauxrel]
       I3: NOT EXIST (mu2, [I4: rel2/..])
       I4: rel2 IN [auxrel, progauxrel]
      >

      COMP
         <
          C1: (CLAUSErec1.aspect = omegaaspect) AND
              (CLAUSErec1.aktionsarts <> [stative]  OR
               CLAUSErec1.voice = passive) AND
              (VERBrec1.modus = omegamodus) AND
              (VERBRec1.ingform <> noing)
 
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aspect:= imperfective;
              VERBrec2 := VERBrec1;
              VERBrec2.modus := ingform;
              SUBVERBrec1 := COPYT_bverbtosubverb(BVERBrec1);
              VERBrec3 := COPYT_subverbtoverb(SUBVERBrec1);
              (* other values retain default values *)
         >

      DECOMP
         <
          C1: (CLAUSErec2.aspect= imperfective) AND
              (CLAUSErec2.aktionsarts <> [stative]  OR
               CLAUSErec2.voice = passive) AND
              (VERBrec2.modus = ingform) AND
              (VERBRec2.ingform <> noing) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1)) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (SUBVERBrec1.affix = noaffix) AND
              (VERBrec3 =
               {
                modus     : omegamodus
                tense     : omegatense
                persons   : []
                numbers   : []
               }
              )     
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.aspect:= omegaaspect;
              VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Raspectimperfective1
\item[* relevant examples:] he work $\rightarrow$ he be working (head),
he be hit $\rightarrow$ he be being hit (passaux),
*be `canning' (noing, aux),
*be `willing'(noing, aux),
*be being working (progaux),
*be having worked (aux),
*be doing work (aux)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Aspectrules
\item[* date of creation:] 25-MAR-1988
\item[* author:] Lisette Appelo
\item[* copied from:] Raspectimperfective Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 22/03/89\ \ \ \ \ author: margreet sanders\\
Added possibility of passive stative (she is being thought beautiful)
\item date: 01/08/89\ \ \ \ \ author: Lisette Appelo\\
Changed condition on stative Aktionsart.
\end{enumerate}
\item[* task:] imperfective aspect relation between the interval E and a 
reference interval R
\item[\ \ strategy:] In this rule is checked if a duration adverbial is absent. 
Presence of a duration adverbial makes the aspect of an event perfective.
The verb is given the {\em ingform} for modus and the auxiliary verb {\em be}
is introduced. Auxiliary verbs such as modal verbs, {\em do} or progressive {\
em be} are not allowed to the left of {\em be}. In case of modal verbs, the 
rule will be applied in the next cycle (analytically spoken).
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application? (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: \\

\item in other languages: in Spanish and Dutch aspect rules can have other
form effects. These languages do not always make a distinction between 
perfective and 
imperfective aspect forms (Dutch) or have different means for expressing it
(Spanish).\\

\end{enumerate}
\item[* relevant literature/documents:] doc. 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Raspectimperfective2
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    I2: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    I2: rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5
            ]
>
   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu5)
       I2: rel1 IN [head, progauxrel, auxrel]
      >

      COMP
         <
          C1: (CLAUSErec1.aspect = omegaaspect) AND
              ((VERBRec1.ingform = noing) OR
               (CLAUSErec1.aktionsarts = [stative] ) OR
               ((stative IN CLAUSErec1.aktionsarts) AND
                (VERBrec1.subc = beverb) AND
                (rel1 = progauxrel) AND
                (CLAUSErec1.voice <> passive)
               )
              ) AND
              (VERBrec1.modus = omegamodus) 
               
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aspect:= imperfective;
         >

      DECOMP
         <
          C1: (CLAUSErec2.aspect= imperfective) AND
              (
               (CLAUSErec2.aktionsarts = [stative]) OR
               (VERBRec1.ingform = noing) OR
               ((stative IN CLAUSErec2.aktionsarts) AND
                (VERBrec1.subc = beverb) AND
                (rel1 = progauxrel) AND
                (CLAUSErec2.voice <> passive)
               )
              ) AND
              (VERBrec1.modus = omegamodus)

          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.aspect:= omegaaspect;
         >

&

\end{verbatim}

\newpage
\begin{description}
\item[* name:] Raspectimperfective2
\item[* relevant examples:] he can $\rightarrow$ he can (aux),
he have a book $\rightarrow$ he have a book (stative),
he will come $\rightarrow$ he will come (aux),
he be ill $\rightarrow$ he be ill (stative, head),
he be working  $\rightarrow$ he be working (stative and progaux),
he do work $\rightarrow$ he do work (aux),
he have worked $\rightarrow$ he have worked (aux),
*he work $\rightarrow$ he work (no stative, head),
*he be hit $\rightarrow$ he be hit (no stative, progaux)
\item[* language:] English
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Aspectrules
\item[* date of creation:] 25-MAR-1988
\item[* author:] Lisette Appelo
\item[* copied from:] Raspectimperfective Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 03/08/89\ \ \ \ \ author: Lisette Appelo\\
Changed conditions on stative Aktionsart.
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] imperfective aspect relation between the interval E and a 
reference interval R
\item[\ \ strategy:] In this rule is checked if a duration adverbial is absent. 
Presence of a duration adverbial makes the aspect of an event perfective.
The verb is not given the {\em ingform} for modus and the auxiliary verb 
{\em be} is not introduced, because these verbs do not allow {\em ingform} or 
because the aktionsart of the clause is stative. It is assumed that all 
auxiliary verbs except for the passive {\em be} will fall under this rule.\\
It is assumed that the match is left to right. So modals etc. are not excluded 
in mu2. the existence of {\em have} as first verb is impossible here.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application? (see task)
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language: \\

\item in other languages: in Spanish and Dutch aspect rules can have other
form effects. These languages do not always make a distinction between 
perfective and 
imperfective aspect forms (Dutch) or have different means for expressing it
(Spanish).\\

\end{enumerate}
\item[* relevant literature/documents:] doc. 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}


