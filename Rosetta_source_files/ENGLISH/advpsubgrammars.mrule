\newpage
\begin{verbatim}
% TRANSFORMATION TADVPpattern1
< m1: ADVP{ADVPrec1}
          [ head/ADV{ADVrec1}[mu1],
            argrel/NPVAR{NPVARrec1}
          ]
>

< m : ADVP{ADVPrec2}
          [ modrel/NPVAR{NPVARrec2},
            head/ADV{ADVrec1}[mu1]
          ]
>


      COMP
         <
          C1: synMEASUREPHRASE IN ADVrec1.advpatterns AND
              ADVPrec1.advpatternefs = [] AND 
              NPVARrec1.cases = []
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.advpatternefs := [synMEASUREPHRASE];
              NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [accusative];
         >
      DECOMP
         <
          C1:  synMEASUREPHRASE IN ADVrec1.advpatterns AND
               synMEASUREPHRASE IN ADVPrec2.advpatternefs AND
               accusative IN NPVARrec1.cases
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.advpatternefs := [];
              NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [];
         >

&

\end{verbatim}
