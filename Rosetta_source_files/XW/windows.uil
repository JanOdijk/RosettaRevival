/* Rosetta window definitions */

module Rosetta
  
version = 'v1.0'
names = case_sensitive
character_set=iso_latin1
objects= {
    XmCascadeButton = gadget;
    XmToggleButton = gadget;
    XmPushButton = gadget;
    XmLabel = gadget;
    XmArrowButton = gadget;
    XmSeparator = gadget;
}

#include "Xwuil.h"

procedure
  XwuCreateWidget(integer);
  XwuManageWidget(integer);
  XwuUnmanageWidget(integer);
  XwaAction(integer);
  XwbAction(integer);
  XwdAction(integer);
  XwhAction(integer);
  XwlAction(integer);
  XwtAction(integer);

#include "strings.uil"

value
    spacing                     : 10;
    spacing_h                   : 10;
    spacing_v                   : 10;

identifier
    small;
    normal;
    bold;
    big;
    bigbold;

list button_box_args : arguments {
    XmNpacking        = XmPACK_COLUMN;
    XmNentryAlignment = XmALIGNMENT_CENTER;
    XmNspacing        = spacing;
    XmNmarginWidth    = 0;
    XmNmarginHeight   = 0;
};

list button_args : arguments {
    XmNmarginHeight       = 4;
    XmNmarginWidth        = 4;
    XmNfontList           = bigbold;
    XmNhighlightThickness = 2;
    XmNshadowThickness    = 4;
};

list cascade_args : arguments {
    XmNmarginHeight       = 4;
    XmNmarginWidth        = 4;
    XmNfontList           = bold;
};

list form_args : arguments {
    XmNhorizontalSpacing = spacing_h;
    XmNverticalSpacing   = spacing_v;
};

list list_args : arguments {
    XmNscrollBarDisplayPolicy = XmSTATIC;
    XmNfontList          = normal;
};

list form_dialog_args : arguments {
    XmNdialogStyle  = XmDIALOG_MODELESS;
    arguments form_args;
};

list arrow_button_args : arguments {
    XmNheight            = 21;
    XmNwidth             = 25;
};

list text_args : arguments {
    XmNfontList          = normal;
};

list label_args : arguments {
    XmNfontList          = normal;
};

list toggle_args : arguments {
    XmNfontList          = normal;
};

! mw: main window definition

#include "mw.uil"

! dialog windows

#include "dialogs.uil"

! options debug window

#include "dbgset.uil"

! options environment window

#include "env.uil"

! ambiguities windows

#include "amb1.uil"
#include "amb2.uil"
#include "amb3.uil"

! m-parser debug window

#include "mp.uil"

! m-generator debug window

#include "mg.uil"

! common debug output window

#include "dbg.uil"

! tree debug output window

#include "tree.uil"

! treeset debug output window

#include "trees.uil"

! attribute debug output window

#include "attr.uil"

! help window

#include "help.uil"

! mpstatistics window

#include "mps.uil"

! hypernode window

#include "hn.uil"

end module;
