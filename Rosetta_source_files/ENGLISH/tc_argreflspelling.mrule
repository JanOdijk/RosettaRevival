              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPonhePRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              NPrec1 = AUX_NPonhePRSPR EXCEPT FOR [cases] AND 
              NPrec1.cases = [accusative] AND
              PERSPROrec1.persprocase = accusative AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              ( masculine IN NPVARrec1.sexes OR
                NPVARrec1 = { sexes    : []
                              genders NI masculinegender } )
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 3c. it *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_itBPERSPROkey){BPERSPROrec1}] >

      COMP
         <
          C1: NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              NPVARrec1.genders = [omegagender] AND
              NPVARrec1.sexes = [] 
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPonitPRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              NPrec1 = AUX_NPonitPRSPR EXCEPT FOR [cases] AND
              NPrec1.cases = [accusative] AND
              PERSPROrec1.persprocase = accusative AND
              NPVARrec1 = { person : 3
                            number : singular } AND
              NPVARrec1.NPhead <> oneNP AND
              NPVARrec1.genders = [omegagender] AND
              NPVARrec1.sexes = [] 
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := NPrec1.cases
         >

   SUBRULE (* 4. we *)
      < >
      < T1: PERSPRO{PERSPROrec1}
                   [head/BPERSPRO(AUX_weBPERSPROkey){BPERSPROrec1}] >

      COMP
         <
          C1: NPVARrec1 = { person : 1
                            number : plural }
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := accusative;
              NPrec1 := AUX_NPonwePRSPR;
              NPrec1.cases := NPVARrec2.cases
         >

      DECOMP
         <
          C1: PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
