       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN  RelVarIdent.str:=%RELVAR.str;
                               IF TSTRING_length(%RELVAR.str)<>0 THEN
                                     APPENDident(RelVarIdent,RelVarList);
                        END
