\newpage
\begin{verbatim}
% TRANSFORMATION TOblSubjControlComplSent      (* complrel/SENT, 
                                                  subj.ant. *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             I6:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu6],
                      mu9
                    ],
              mu8 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             I6:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu6],
                      mu12
                    ],
              mu8 
           ]
>

   MATCHCONDITIONS
      <
       I6: NOT EXIST (mu2, [I61:auxrel/VERB{VERBrec2}[mu13]])
         I61: VERBrec2.subc = modalverb
      >

<
   SUBRULE (* 1. no embedded predrel *)
      < mu9: [ mu5,
               complrel/I2::SENTENCE{SENTENCErec1}
                       [ I3:sig1,
                         subjrel/T2,
                         I4:mu4 
                       ],
               mu7 
             ]
      >
      < mu12: [ mu5,
                complrel/I2::SENTENCE{SENTENCErec1}
                        [ I3:sig1,
                          I4:mu4 
                        ],
                mu7 
              ]
      >

   MATCHCONDITIONS
      <
       I2: SENTENCErec1.PROsubject = true
       I3: ALL (sig1, shiftrel/..)
       I4: NOT EXIST (mu4, [shiftrel/..])
      >

  <
   SUBRULE (* 1a. NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 AND
              (* including cases, which is [] *)
              VERBrec1.controller = subject
          A1: @
         >
      DECOMP
         <
          C1: VERBrec1.controller = subject
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is [] *)
         >

   SUBRULE (* 1b. CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2  (* including [] case *) AND
              VERBrec1.controller = subject
          A1: @
         >
      DECOMP
         <
          C1: VERBrec1.controller = subject
          A1: CNVARrec2 := CNVARrec1 (* including [] case *)
         >
   >

   SUBRULE (* 2. embedded predrel *)
      < mu9: [ mu5,
               predrel/I1::N1
                      [ mu10,
                        I5:rel2/I2::SENTENCE{SENTENCErec1}
                               [ I3:sig1,
                                 subjrel/T2,
                                 I4:mu4 
                               ],
                        mu11
                      ],
               mu7 
             ]
      >
      < mu12: [ mu5,
                predrel/I1::N1
                       [ mu10,
                         I5:rel2/I2::SENTENCE{SENTENCErec1}
                                [ I3:sig1,
                                  I4:mu4 
                                ],
                         mu11
                       ],
                mu7 
              ]
      >

   MATCHCONDITIONS
      <
       I1: N1.CAT IN [ADJP, NP, PREPP, ADVP]
       I2: SENTENCErec1.PROsubject = true
       I3: ALL (sig1, shiftrel/..)
       I4: NOT EXIST (mu4, [shiftrel/..])
       I5: rel2 IN [complrel, toinfmodrel, postadjrel, causadvrel,
                    toinfcomplrel, resultrel]
      >

  <
   SUBRULE (* 2a. NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: NPVARrec1 = NPVARrec2 AND
              (* including cases, which is [] *)
              synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs
          A1: @
         >
      DECOMP
         <
          C1: synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs
          A1: NPVARrec2 := NPVARrec1
              (* including cases, which is [] *)
         >

   SUBRULE (* 2b. CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CNVARrec1 = CNVARrec2  (* including [] case *) AND
              synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs
          A1: @
         >
      DECOMP
         <
          C1: synBE IN VERBrec1.synvps AND
              synBE IN CLAUSErec1.synvpefs
          A1: CNVARrec2 := CNVARrec1 (* including [] case *)
         >
   >
>
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] TOblSubjControlComplSent
\item[* relevant examples:]\mbox{}\\
\begin{enumerate}
\item OPENTOSENT:\\
(vp120): x1 decided [x1 to leave] $\rightarrow$ x1 decided [to leave]\\
(vp123): x1 promised x2 [x1 to see a doctor] $\rightarrow$ x1 promised x2 
[to see a doctor]\\
(adjp): x1 was able [x1 to read a book] yesterday $\rightarrow$ x1 was able 
[to read a book] yesterday
\item QSENT:\\
(vp120): x1 hesitated [whether x1 to go there] yesterday $\rightarrow$ x12 
hesitated [whether to go there] yesterday\\
(vp120): x1 asked himself [where x1 to go] $\rightarrow$ x1 asked himself [
where to go]
\end{enumerate}
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] (name of rule, transformation or filter class) TC\_Controlrules
\item[* date of creation:]  01-MAR-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch TOblControl6b
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 30/03/89\ \ \ \ \ author: margreet sanders\\
Adapted for sentences under a predrel/XP. It is assumed for the moment that 
subject control is indeed needed. There is no attribute to indicate another 
controller.
\item date: 25/10/89\ \ \ \ \ author: margreet sanders\\
Adapted rule to stop a false path in analysis: for modals, the control rules 
should work only in the next cycle, when the modal has been removed (He will 
want to swim - he want to swim).
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To interpret and to delete the subject NPVAR or CNVAR of a
complrel/SENTENCE with PROsubject = true, when the antecedent is a
subject. (Obligatory Control) (Not for openGerunds anymore; they are covered by 
TOblSubjControlOpenIngNP).
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] One for NPVAR,
one for CNVAR
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] dna
\item[\ \ presuppositions:]\mbox{}
