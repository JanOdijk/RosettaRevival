\newpage
\begin{verbatim}
% RULE RNPformation7

< m1: SUBINDEFPRO{SUBINDEFPROrec1}[head/INDEFPRO{INDEFPROrec1}]
>

< m: NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}] 
>

      COMP
         <
          C1: SUBINDEFPROrec1 = INDEFPROrec1
              C11: INDEFPROrec1.NPhead <> oneNP
              A11: Nprec1.generic := nogeneric;
              C12: INDEFPROrec1.NPhead = oneNP
              A12: NPrec1.generic := yesgeneric;
          A1: NPrec1.definite    := INDEFPROrec1.definite;
              NPrec1.number      := INDEFPROrec1.number;
              NPrec1.poss        := INDEFPROrec1.poss;
              NPrec1.syntquant   := INDEFPROrec1.syntquant;
              NPrec1.animate     := INDEFPROrec1.animate;
              NPrec1.NPhead      := INDEFPROrec1.NPhead;
              NPrec1.possnietnp  := INDEFPROrec1.possnietnp;
              NPrec1.posspred    := true;
              NPrec1.superdeixis := omegadeixis;
              NPrec1.specQ       := yesspec;

              (* other attributes have default values *)
         >

      DECOMP
         <
          C1: NPrec1.definite    = INDEFPROrec1.definite AND
              NPrec1.number      = INDEFPROrec1.number AND
              NPrec1.poss        = INDEFPROrec1.poss AND
              NPrec1.syntquant   = INDEFPROrec1.syntquant AND
              NPrec1.animate     = INDEFPROrec1.animate AND
              NPrec1.NPhead      = INDEFPROrec1.NPhead AND
              NPrec1.possnietnp  = INDEFPROrec1.possnietnp AND

              NPrec1.posspred    = true AND
              NPrec1.superdeixis = omegadeixis AND
              NPrec1.specQ       = yesspec 
              C11: NPrec1.generic = nogeneric AND
                   INDEFPROrec1.NPhead <> oneNP
              A11: @
              C12: NPrec1.generic = yesgeneric AND
                   INDEFPROrec1.NPhead = oneNP
              A12: @
          A1: SUBINDEFPROrec1 := INDEFPROrec1
         >
&

\end{verbatim}
