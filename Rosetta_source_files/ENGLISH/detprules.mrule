\newpage
\begin{verbatim}
% RULE DETPformation2
< m1: NUM{NUMrec1} 
>

< m : DETP{DETPrec1}[head/NUM{NUMrec1}]
>

      COMP
         <
          C1: true
          A1: DETPrec1.possnietnp  := false;
              DETPrec1.definite    := indef;
              DETPrec1.posspred    := true;
              DETPrec1.possnumbers := NUMrec1.numbers;
              DETPrec1.posscomas   := [count];
              DETPrec1.mood        := nowh;
              DETPrec1.syntquant   := omegaquant;    
                  (* the distinction between omgequant and equant 
                     has become irrelevant; 14/6/88 *)                    
              DETPrec1.superdeixis := omegadeixis;  
         >

      DECOMP
         <
          C1: DETPrec1.possnietnp  = false AND
              DETPrec1.definite    = indef AND
              DETPrec1.posspred    = true AND
              DETPrec1.possnumbers = NUMrec1.numbers AND
              DETPrec1.posscomas   = [count] AND
              DETPrec1.mood        = nowh AND
              DETPrec1.syntquant   = omegaquant AND    (* see COMP *)
              DETPrec1.superdeixis = omegadeixis
          A1:  @
         >
&

\end{verbatim}
