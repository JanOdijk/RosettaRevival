SPANISH 72
&
\begin{verbatim}
%
% RULE RNPformation1                  (* NP uit DETP en CN met NOUN *)
<  
 m1: CN{CNrec1}[I1:mu1]

 m2: DETP{DETPrec1}[mu2,
                    I2:head/T1, 
                    I3:mu3
                    ]

>

< m : NP{NPrec1}[detrel/DETP{DETPrec2}[mu2,
                                       I2:head/T1,
                                       I3:mu3
                                      ],
                 head/CN{CNrec1}[I1:mu1]
                ]
>

   MATCHCONDITIONS
      <
        I1: NOT EXIST(mu1,[head/EN{ENrec1}])
        I2: T1.CAT IN [NUM, DET, DEMADJ, QP, DETP, CARD]    
        I3: ALL (mu3, artrel/ART{ARTrec1})
        m: NPrec1 = { 
                      persona   : 3
                      NPhead    : otherNP
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }
      >

      COMP
         <
            C1: DETPrec1.posscomas * CNrec1.posscomas <> [] AND

                 DETPrec1.numero = CNrec1.numero AND
                (DETPrec1.genero IN CNrec1.generos  OR 
                 DETPrec1.genero = omegagenero ) AND
                 ((CNrec1.definite = DETPrec1.definite )
                 OR (CNrec1.definite = omegadef)) AND
                 DETPrec1.supertiempo = CNrec1.supertiempo     
                 C11: CNrec1.numero = plural 
                 A11: NPrec1.actcomas := [count];
                      NPrec1.numero := plural    
                 C12: ((CNrec1.numero = singular) AND
                      (mass IN CNrec1.posscomas))           
                 A12: NPrec1.actcomas := [mass];
                      NPrec1.numero := singular  
                 C13: CNrec1.numero = singular AND
                      count IN CNrec1.posscomas 
                 A13: NPrec1.actcomas := [count];
                      NPrec1.numero := singular  
         A1: 
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
(*                        possnietnp        : DETPrec1.possnietnp *)
                          mood              : DETPrec1.mood
                          genero            : DETPrec1.genero

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                         };
                DETPrec2 := DETPrec1;
                DETPrec2.supertiempo := omegatiempo;
                          
         >

      DECOMP
         <
          C1: 
               NPrec1 = { posspred          : DETPrec2.posspred
                          definite          : DETPrec2.definite
(*                           possnietnp        : DETPrec2.possnietnp *)
                          mood              : DETPrec2.mood
                          genero            : DETPrec2.genero

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          supertiempo: omegatiempo
                          cases      : []
                         }  AND
         
              ((CNrec1.definite = DETPrec2.definite )
              OR (CNrec1.definite = omegadef))     AND
              DETPrec2.posscomas * CNrec1.posscomas <>[] AND
              (DETPrec2.genero IN CNrec1.generos  OR 
               DETPrec2.genero = omegagenero ) AND
              DETPrec2.numero = CNrec1.numero  (* probleem: een van de *)

                   C11:( CNrec1.numero = plural) AND
                       (NPrec1.actcomas * [count]<> []) AND
                       (NPrec1.numero = plural) 
                   A11: @
                   C12:((CNrec1.numero = singular) AND
                        (mass IN CNrec1.posscomas)) AND
                        (NPrec1.actcomas * [mass] <> []) AND
                        (NPrec1.numero = singular)
                   A12: @
                   C13: CNrec1.numero  = singular AND
                        NPrec1.actcomas * [count] <> []  AND
                        NPrec1.numero = singular
                  A13:  @
            A1:  DETPrec1 := DETPrec2;
                 DETPrec1.supertiempo := CNrec1.supertiempo;
         >



&


\end{verbatim}
