% RULE RCNmodposs2

< m1: CN{CNrec1}[I1:mu1]

  m2: NP{NPrec1}[mu2, 
                 head/T1,
                 mu3
                ]
>

< m : CN{CNrec4}[I1:mu1,
                 posrel/PREPP{PREPPrec1}
                       [head/PREP(KEY_ofprepkey){PREPrec1}],
                        objrel/I2::NP{NPrec2}
                              [mu2,
                               head/T2,
                               mu3
                              ]
                ]
>

   MATCHCONDITIONS
      < I1:  EXIST(mu1, [head/EN{ENrec1}])  AND
             NOT EXIST (mu1, [posrel/T3])  AND
             NOT EXIST (mu1, [postmodrel/PROPERNOUN{PROPERNOUNrec2}[mu7]])
        m2: NPrec1.generic = nogeneric AND
            NPrec1.cases = []
        I2: NPrec2.generic = omegageneric AND
            accusative IN NPrec2.cases 
      >

<
(* 1 *) 
SUBRULE          (*  (EN of) my father *)

<T1: CN{CNrec2}[mu4]>
<T2: CN{CNrec3}[mu4]>


      COMP
         <
          C1: NPrec1.superdeixis = CNrec1.superdeixis
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative];
              CNrec3 := CNrec2;
              CNrec3.cases := NPrec2.cases;
              CNrec4 := CNrec1;
              CNrec4.poss := false;
      >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis AND
              CNrec3.cases = NPrec2.cases AND
              CNrec4.poss = false
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := CNrec1.superdeixis;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
              CNrec2 := CNrec3;
              CNrec2.cases := [];
              CNrec1 := CNrec4;
              CNrec1.poss := true; (* default *)
         >

(* 2 *) 
SUBRULE            (*  (EN of) mine *)

<T1: PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}]>
<T2: POSSPRO{POSSPROrec1}[head/BPERSPRO{BPERSPROrec1}]>

      COMP
         <
          C1: NPrec1.superdeixis = CNrec1.superdeixis AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = omegacase AND
              BPERSPROrec1.predpos = true
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative]; 
              (* POSSPRO has no attributes *)
              CNrec4 := CNrec1;
              CNrec4.poss := false;
         >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis AND
              BPERSPROrec1.predpos = true
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              PERSPROrec1.persprocase := omegacase;
              NPrec1 := NPrec2;
              NPrec1.superdeixis := CNrec1.superdeixis;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
              CNrec1 := CNrec4;
              CNrec1.poss := true; (* default *)
         >


(* 3 *) 
SUBRULE        (* (EN of) everybody *)

<T1: INDEFPRO{INDEFPROrec1}[mu4]>
<T2: INDEFPRO{INDEFPROrec1}[mu4]>


      COMP
         <
          C1: NPrec1.superdeixis = CNrec1.superdeixis
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative]; 
              CNrec4 := CNrec1;
              CNrec4.poss := false;
         >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := CNrec1.superdeixis;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
              CNrec1 := CNrec4;
              CNrec1.poss := true; (* default *)
         >

(* 4 *) 
SUBRULE           (* (EN of) John *)

<T1: PROPERNOUN{PROPERNOUNrec1}[mu5]>
<T2: PROPERNOUN{PROPERNOUNrec1}[mu5]>


      COMP
         <
          C1: NPrec1.superdeixis = CNrec1.superdeixis
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative]; 
              CNrec4 := CNrec1;
              CNrec4.poss := false;
         >

      DECOMP
         <
          C1: NPrec2.superdeixis = omegadeixis
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := CNrec1.superdeixis;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
              CNrec1 := CNrec4;
              CNrec1.poss := true; (* default *)
         >
>
&

