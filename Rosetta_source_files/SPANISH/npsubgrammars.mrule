\begin{verbatim}
% TRANSFORMATION TPPdelglue
< m1 : CN{CNrec1}[I1:mu1,
                 I2:rel1/PREPP{PREPPrec1}
                        [head/PREP(KEY_deprepkey){PREPrec1}],
                         complrel/NP{NPrec2}
                                  [artrel/ART(KEY_elARTkey){ARTrec1},
                                   head/T2,
                                   mu3
                                  ]
                ]
>

< m1 : CN{CNrec1}[I1:mu1,
                 I2:rel1/PREPP{PREPPrec1}
                        [head/PREP(KEY_deprepkey){PREPrec1}],
                         gluerel/GLUE{},
                         complrel/NP{NPrec2}
                                  [artrel/ART(KEY_elARTkey){ARTrec1},
                                   head/T2,
                                   mu3
                                  ]
                ]
>

   MATCHCONDITIONS
      < I1: EXIST(mu1, [head/EN{ENrec1}])  OR
            EXIST(mu1, [head/NOUN{NOUNrec1}])  
        I2: rel1 IN [posrel, postmodrel]
     >

      COMP
         <
          C1:true
          A1:@
         >
      DECOMP
         <
          C1:true
          A1:@
         >
&


\end{verbatim}
