       m2: QUOTE_Gsubstordercondition(mu1, mu3, mu4, T3, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T3)
       m : QUOTE_substordercondition(mu1, mu3, mu4, CLAUSErec1.prosubject)
       I1: caus IN PREPPrec1.actsubcefs
       I2: caus IN PREPPrec2.actsubcefs 
       I3: PREPPVARrec1.index = LEVEL
       I8: NOT QUOTE_NegPhrase(T4)
      >

