\begin{verbatim}
% RULE Rtempadvsubstitution4
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             I2:rel1/PREPPVAR{PREPPVARrec1},
             mu2,
             predrel/VERBP{VERBPrec1}[mu3],
             mu4
           ] 
SUBST:
  m2: T1
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             I3:rel1/T2,
             mu2,
             predrel/VERBP{VERBPrec1}[mu3],
             mu4
           ] 
>

   MATCHCONDITIONS
      <
       m2 : QUOTE_Gsubstordercondition(mu2, mu3, mu4) AND
            T1.CAT IN [PREPP, VARPREPP]
       m  : QUOTE_substordercondition(mu2, mu3, mu4) 
       I2 : rel1 IN [shiftrel] AND
            PREPPVARrec1.index = LEVEL
       I3 : rel1 IN [shiftrel] AND
            T2.CAT IN [PREPP, VARPREPP]
      >
 
   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE
      <T1:PREPP{PREPPrec1}[mu5] >
      <T2:PREPP{PREPPrec2}[mu5] >


      COMP
         <
          C1: (temp IN PREPPrec1.actsubcefs) AND
              (PREPPVARrec1 = COPYT_prepptovar(PREPPrec1)) AND
              ((PREPPrec1.class = reference) OR
               (PREPPrec1.class = frequential) OR
               ((PREPPrec1.class = duration) AND
                ((PREPPrec1.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((PREPPrec1.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              ) AND
              QUOTE_tiempomax(CLAUSErec1.tiempo,
                          CLAUSErec1.supertiempo, PREPPrec1.supertiempo)
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.supertiempo := omegatiempo;

         >
      DECOMP
         <
          C1: (temp IN PREPPrec2.actsubcefs) AND
              ((PREPPrec2.class = reference) OR
               (PREPPrec2.class = frequential) OR
               ((PREPPrec2.class = duration) AND
                ((PREPPrec2.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((PREPPrec2.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )
          A1: PREPPVARrec1 := COPYT_prepptovar(PREPPrec2);
              PREPPVARrec1.index := LEVEL;
              PREPPrec1 := PREPPrec2;
              QUOTE_asstiempomax(CLAUSErec1.tiempo,
                          CLAUSErec1.supertiempo, PREPPrec1.supertiempo);

         >

   SUBRULE
      <T1:VARPREPP{VARPREPPrec1}[mu5] >
      <T2:VARPREPP{VARPREPPrec2}[mu5] >

      COMP
         <
          C1: (temp IN VARPREPPrec1.actsubcefs) AND

              ((VARPREPPrec1.class = reference) OR
               (VARPREPPrec1.class = frequential) OR
               ((VARPREPPrec1.class = duration) AND
                ((VARPREPPrec1.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((VARPREPPrec1.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              ) AND
              QUOTE_tiempomax(CLAUSErec1.tiempo,
                          CLAUSErec1.supertiempo, VARPREPPrec1.supertiempo)
              C11: rel1 = shiftrel AND
                   PREPPVARrec1.mood = relativexpmood  AND
                   VARPREPPrec1.mood = declxpmood      AND
                   (PREPPVARrec1 = COPYT_prepptovar(VARPREPPrec1) 
                             EXCEPT FOR [mood]) 
              A11: VARPREPPrec2 := VARPREPPrec1;
                   VARPREPPrec2.mood := relativexpmood; 
              C12: rel1 <> shiftrel OR
                   PREPPVARrec1.mood <> relativexpmood AND
                   PREPPVARrec1 = COPYT_prepptovar(VARPREPPrec1) 
              A12: VARPREPPrec2 := VARPREPPrec1;
          A1: VARPREPPrec2.supertiempo := omegatiempo;

         >
      DECOMP
         <
          C1: (temp IN VARPREPPrec2.actsubcefs) AND
              ((VARPREPPrec2.class = reference) OR
               (VARPREPPrec2.class = frequential) OR
               ((VARPREPPrec2.class = duration) AND
                ((VARPREPPrec2.aspecto = perfectivo) AND
                 (CLAUSErec1.aktionsarts * [stative, activity] <> [])
                ) OR
                ((VARPREPPrec2.aspecto = imperfectivo) AND
                 (CLAUSErec1.aktionsarts * [accomplishment, achievement] <> [])
                )
               )
              )
              C11: rel1 = shiftrel AND
                   VARPREPPrec2.mood = relativexpmood
              A11: VARPREPPrec1 := VARPREPPrec2;
                   VARPREPPrec1.mood := declxpmood;
                   PREPPVARrec1 := COPYT_prepptovar(VARPREPPrec1);
                   PREPPVARrec1.mood := relativexpmood;
              C12: rel1 <> shiftrel OR
                   VARPREPPrec2.mood <> relativexpmood
              A12: VARPREPPrec1 := VARPREPPrec2; 
                   PREPPVARrec1 := COPYT_prepptovar(VARPREPPrec1);
          A1: PREPPVARrec1.index := LEVEL;
              QUOTE_asstiempomax(CLAUSErec1.tiempo,
                          CLAUSErec1.supertiempo, VARPREPPrec1.supertiempo);

         >


>


&

