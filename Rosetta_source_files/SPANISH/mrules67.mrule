\begin{verbatim}

 TRANSFORMATION TADJQPhopping1  
        (* mooi genoeg, lang zat *)

< m1:  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [mu2,
                       degreemodrel/QP{QPrec1}
                                    [mu3],
                       mu4,
                       head/ADJ{ADJrec1}[mu5],
                       mu6
                      ] 
                ]
>

< m :  ADJPPROP{ADJPPROPrec1}
                [mu1,
                 predrel/ADJP{ADJPrec1}
                      [I1:mu2,
                       I2:mu4,
                       head/ADJ{ADJrec1}[mu5],
                       hoprel/QP{QPrec1}[mu3],
                       mu6
                      ] 
                ]
>
   MATCHCONDITIONS
      <I1: NOT EXIST(mu2, [I11:rel1/..])
       I2: NOT EXIST(mu4, [I12:rel2/..])
       I11: rel1 IN [prepobjrel, aanobjrel]
       I12: rel2 IN [objrel, voorobjrel, indobjrel, causadvrel, locadvrel,
                     tempadvrel]
      >


      COMP
         <
          C1: QPrec1.hop = true  
          A1: @
         >
      DECOMP
         <
          C1: QPrec1.hop = true  
          A1: @
         >


&

\end{verbatim}
