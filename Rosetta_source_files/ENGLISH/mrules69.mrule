\begin{verbatim}
% RULE RCNmodNUM
< 
  m1: CN{CNrec1}[
                 I3:mu3,
                 I1:head/N1[mu2],
                 mu8
                ]
  
  m2: DETP{DETPrec1}[mu4,
                     head/NUM{NUMrec1}
                    ]
>

< m : CN{CNrec2}[
                 modrel/DETP{DETPrec2}[mu4,
                                       head/NUM{NUMrec1}
                                      ],
                 I3:mu3,
                 I1:head/N1[mu2], 
                 mu8
                ]
>

   MATCHCONDITIONS
      <
       I1: N1.CAT IN [EN, NOUN]
       I3: ALL (mu3, I13:modrel/T2)
       I13: T2.CAT IN [ADJP, SENTENCE]
      >

      COMP
         <
          C1: (CNrec1.definite = omegadef) AND
              (plural IN CNrec1.numbers) AND
               CNrec1.superdeixis = DETPrec1.superdeixis 
          A1:  CNrec2 := CNrec1;
               CNrec2.definite := def;     (* 'drie groene truien' is def     *)
                                          (* via NPformation: 'de drie ...   *) 
               DETPrec2 := DETPrec1;
               DETPrec2.superdeixis := omegadeixis;
         >

      DECOMP
         <
          C1: CNrec2.definite = def AND
              plural IN CNrec2.numbers AND
              DETprec2.superdeixis = omegadeixis
          A1: CNrec1 := CNrec2;
              CNrec1.definite := omegadef;
              DETPrec1 := DETPrec2;
              DETPrec1.superdeixis := CNrec1.superdeixis;

         >
&

\end{verbatim}
