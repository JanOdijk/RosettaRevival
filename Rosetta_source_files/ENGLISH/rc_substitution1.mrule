\newpage
\begin{verbatim}
% RULE RPrepNPsubst               (* NP in PREPP in VP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I2:rel1/PREPP{PREPPrec1}
                             [ mu3,
                               rel2/I1::NPVAR{NPVARrec1}
                             ],
                      mu5  
                    ],
              mu6 
           ] 

  SUBST:
  m2: T3=I3::NP{NPrec1}[I7:mu7]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      I2:rel1/PREPP{PREPPrec2}
                             [ mu3,
                               I5:rel2/T4=I4::NP{NPrec2}[I8:mu8]
                             ],
                      mu5  
                    ],
              mu6 
           ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_gsubstordercondition2(mu5, mu6, T3, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T3)
       m : QUOTE_substordercondition2(mu5, mu6, CLAUSErec1.prosubject)
       I1: NPVARrec1.index = LEVEL 
       I2: rel1 IN [locargrel, dirargrel, complrel, vpadvrel]
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I4: NOT ( NPrec2.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I5: NOT QUOTE_NegPhrase(T4)
       I7: NOT EXIST (mu7, [head/BIGPRO{}[mu10]])
       I8: NOT EXIST (mu8, [head/BIGPRO{}[mu11]])
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_NPtoVAR(NPrec1) 
                                   EXCEPT FOR [cases] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric
            C11: CLAUSErec1.deixis = omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.superdeixis
            A11: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases)
            C12: CLAUSErec1.deixis <> omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.deixis
            A12: QUOTE_assigncase(NPrec1, mu7, NPrec2, mu8, NPVARrec1.cases)
          A1: NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric;
              PREPPrec2 := PREPPrec1
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
            C11: CLAUSErec1.deixis = omegadeixis
            A11: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []);
                 NPrec1.superdeixis := CLAUSErec1.superdeixis
            C12: CLAUSErec1.deixis <> omegadeixis
            A12: QUOTE_assigncase(NPrec2, mu8, NPrec1, mu7, []);
                 NPrec1.superdeixis := CLAUSErec1.deixis
          A1: NPVARrec1 := COPYT_NPtoVAR(NPrec2);
              (* including cases *)
              NPVARrec1 := { index   : LEVEL
                             generic : nogeneric };
              NPrec1.generic := nogeneric;
              PREPPrec1 := PREPPrec2
         >
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] RPrepNPsubst
\item[* relevant examples:] \mbox{}\\
locargrel1: x1 stood [behind x2] $\rightarrow$ x1 stood [behind the door] \\
locargrel2: x1 put x2 [on x3] $\rightarrow$ x1 put x2 [on the table]\\
dirargrel1: x1 jumps [off x2] $\rightarrow$ x1 jumps [off the fence]\\
dirargrel2: x1 drove x2 [into x3] $\rightarrow$ x1 drove x2 [into the garage]\\
vpadvrel: x1 cut x2 [with x3] $\rightarrow$ x1 cut x2 [with a knife]\\
NB: no patternrules, PropSubst rules and Control rules exist for instradvs yet!
\\
complrel: ?x1 seems [with x2] $\rightarrow$ x1 seems [with child]
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) RC\_Substitution
\item[* date of creation:] 15-APR-1988
\item[* author:] margreet sanders
\item[* copied from:] Dutch RSubstitution3
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 15/03/89\ \ \ \ \ author: margreet sanders\\
1) added conditions on absence of BIGPROs (needed for NOC)\\
2) added conditions on absence of an element with incorporated negation, since 
such a word must be broken down to a separate negation (no local translation of 
a word like `nobody' should be possible, except when translating bare NPs)
\item date: 08/08/89\ \ \ \ \ author: margreet sanders\\
removed `predrel' from allowed set: already covered by RxppObjNPsubst
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] To substitute NPs for NPVARs inside PREPPs.
The PREPPS can bear one of the following 
relations: locargrel, dirargrel, complrel (for `other' preps), vpadvrel, 
predrel (from PrepPClauseFormation). Note that it is assumed that in the 
Control Rules all structures produced by the PropSubst rules (i.e.\ locargrel, 
dirargrel, complrel/OPEN(CLOSED)\-PREPPPROP/ADVPPROP, and prepobjrel/PREPP - 
CLOSED(OPEN)\-NPPROP/ADJPPROP/PREPPPROP) are converted into a structure with a 
PREPP, irrespective of whether the XPPROP still contained a VAR or not. It is 
also assumed in the Control Rules that prepobjrel/PREPPs do not contain a VAR 
anyway, so all prepobjrel/PREPPs need not pass the Substitution Rules at all. 
Prepobjrel/VARPREPPs are produced by the Pattern Rules for real prepositional 
objects only, and are covered by RVarPrepNPSubst.
\item[\ \ strategy:] (also: deviations from accepted proposals)
