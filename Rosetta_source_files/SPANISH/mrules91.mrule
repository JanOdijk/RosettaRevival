      >

         <
          C1: (NPrec1.persona = 1)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = fem)             
          A1: @
         >

   
  SUBRULE  (* me + deletion of mí; fem.; IO tú *)
      <mu7: [I11:mu11,
             I13:dosCLrel/PERSPRO{PERSPROrec2}[mu22]] > 

  MATCHCONDITIONS
      <
       I13:  PERSPROrec2.numero = singular 
