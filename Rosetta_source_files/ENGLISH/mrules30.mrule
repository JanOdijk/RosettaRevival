          C1: true
          A1: EMPTYVARrec1 := { index  : LEVEL
                                person : 3
                                number : omeganumber
                                gender : omegagender };
              CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                        CLAUSErec2.synvpefs * AUX_emptyPrepobjVps

         >
&

