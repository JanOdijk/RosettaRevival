pragma C_include('strings.pf');
pragma C_include('string.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE TSTRING;

WITH STRNG,
     STRINGS;

(*MPC:::===================================================================*
 *
 *  Constant name  : TSTRING_Max
 *  Description    : maximal length of a string
 *
 *EMP:::===================================================================*)

CONST
   TSTRING_Max = 54;


(*MPT:::===================================================================*
 *
 *  Type name      : TSTRING_Range
 *  Description    : defines index range of a string.
 *                   the first character in a string has index 1.
 *                   0 is an extra value used to indicate out of bound
 *                   conditions, empty strings ed.
 *
 *EMP:::===================================================================*)

TYPE
   TSTRING_Range = 0..TSTRING_Max;


(*MPT:::===================================================================*
 *
 *  Type name      : TSTRING_String
 *  Description    : TSTRING_String is to be used as the only string type in
 *                   Rosetta. Its internal structure should be considered
 *                   to be unknown outside this module!!
 *                   The only actions upon this data type are the one
 *                   defined in this module and the Pascal assignment statement.
 *                   To initiate and/or assign a Pascal-string-constant to a
 *                   variable of this type use the TSTRING_Constant routines.
 *
 *EMP:::===================================================================*)

TYPE
   TSTRING_String = STRING(TSTRING_Max);


FUNCTION  TSTRING_FindFirstNotInSet ( str1 : TSTRING_String;
                                                str2 : TSTRING_String)
                     : TSTRING_Range;
EXTERNAL;
   

(*MPT:::===================================================================*
 *
 *  Type name      : TSTRING_CompareResult
 *  Description    : TSTRING_Compare Result is used to represent the result of
 *                   a string comparison. Comparing string a with string b the
 *                   meaning of the different values is as follows :
 *                      -1 -> a<b
 *                       0 -> a=b
 *                       1 -> a>b
 *
 *EMP:::===================================================================*)

TYPE
   TSTRING_CompareResult = -1..1;

PROCEDURE TSTRING_PrefixChar (VAR str1 : TSTRING_String;
                                        str2 : TSTRING_String;
                                        c : CHAR);
EXTERNAL;
   


PROCEDURE TSTRING_converttostring(str1:TSTRING_string;
                                             VAR str2:STRING_string);
EXTERNAL;

PROCEDURE TSTRING_converttotstring(str1:STRING_string;
                                             VAR str2:TSTRING_string);
EXTERNAL;

FUNCTION TSTRING_Length (str : TSTRING_String) : TSTRING_Range;
EXTERNAL;

FUNCTION  TSTRING_Compare (str1 : TSTRING_String; str2 : TSTRING_String)
                     : TSTRING_CompareResult;
EXTERNAL;

FUNCTION  TSTRING_CompareBegin (str1 : TSTRING_String; str2 : TSTRING_String)
                     : TSTRING_CompareResult;
EXTERNAL;
   
FUNCTION  TSTRING_CompareEnd (str1 : TSTRING_String; str2 : TSTRING_String)
                     : TSTRING_CompareResult;
EXTERNAL;
   
FUNCTION  TSTRING_CompareChars (str1 : TSTRING_String;
                                     CONST str2 : STRING;
                                          len2 : TSTRING_Range)
                     : TSTRING_CompareResult;
EXTERNAL;
   
FUNCTION  TSTRING_CompareChar (str : TSTRING_String;
                                         i : TSTRING_Range;
                                         c : CHAR)
                     : TSTRING_CompareResult;
EXTERNAL;
   
PROCEDURE TSTRING_Constant (VAR str1 : TSTRING_String;
                                CONST str2 : STRING;
                                      len2 : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_ConstantChar (VAR str : TSTRING_String;
                                          c : CHAR);
EXTERNAL;
   
PROCEDURE TSTRING_ConstantEmpty (VAR str : TSTRING_String);
EXTERNAL;
   
PROCEDURE TSTRING_Extract (VAR str1 : TSTRING_String;
                                     str2 : TSTRING_String;
                                     pos, len : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_ExtractBegin (VAR str1 : TSTRING_String;
                                          str2 : TSTRING_String;
                                          pos : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_ExtractEnd (VAR str1 : TSTRING_String;
                                        str2 : TSTRING_String;
                                        pos : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_ExtractChars (VAR str1 : STRING;
                                          VAR len1 : STRING_Range;
                                          str2 : TSTRING_String;
                                          pos, len : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_ExtractChar (VAR c : CHAR;
                                         str : TSTRING_String;
                                         i : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_Concat (VAR str1 : TSTRING_String;
                                    str2 : TSTRING_String;
                                    str3 : TSTRING_String);
EXTERNAL;

PROCEDURE TSTRING_Prefix (VAR str1 : TSTRING_String;
                                    str2 : TSTRING_String);
EXTERNAL;

PROCEDURE TSTRING_Append (VAR str1 : TSTRING_String;
                                    str2 : TSTRING_String);
EXTERNAL;

PROCEDURE TSTRING_AppendChars (VAR str1 : TSTRING_String;
                                         str2 : TSTRING_String;
                                   CONST str3 : STRING;
                                         len3 : TSTRING_Range);
EXTERNAL;

PROCEDURE TSTRING_PrefixChars (VAR str1 : TSTRING_String;
                                         str2 : TSTRING_String;
                                    CONST  str3 : STRING;
                                         len3 : TSTRING_Range);
EXTERNAL;
   
PROCEDURE TSTRING_AppendChar (VAR str1 : TSTRING_String;
                                        str2 : TSTRING_String;
                                        c : CHAR);
EXTERNAL;


PROCEDURE TSTRING_UpperCase (VAR str1 : TSTRING_String;
                                       str2 : TSTRING_String);
EXTERNAL;

END {TSTRING};
