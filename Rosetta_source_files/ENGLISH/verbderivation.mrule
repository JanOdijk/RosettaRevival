\newpage
\begin{verbatim}
% RULE Rvncompounds
< m1:CN{CNrec1}[head/NOUN{NOUNrec1}[mu1]] 
  m2:SUBVERB{SUBVERBrec1}[mu2]
>

< m :CN{CNrec1}
       [ head/NOUN{NOUNrec2}
             [ modrel/VERB{VERBrec1}[head/SUBVERB{SUBVERBrec1}[mu2]],
               head/NOUN{NOUNrec1}[mu1]
             ] 
       ]
>

      COMP
         <
          C1: SUBVERBrec1.particle = 0
          A1: NOUNrec2 := NOUNrec1;
              VERBrec1 := COPYT_subverbtoverb(SUBVERBrec1);
              VERBrec1 :=
                {
                    numbers:          []
                    persons:          []
                    modus:            ingform
                    tense:            omegatense
                };
              
         >
      DECOMP
         <
          C1: SUBVERBrec1.particle = 0                       AND
              NOUNrec2 = NOUNrec1                            AND
              VERBrec1 = COPYT_subverbToverb(SUBVERBrec1)    AND
              VERBrec1 =
                {
                    numbers:          []
                    persons:          []
                    modus:            ingform
                    tense:            omegatense
                }
          A1: @
         >




&

\end{verbatim}
