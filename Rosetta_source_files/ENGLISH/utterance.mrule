\newpage
\begin{verbatim}

% RULE RUttPREPP
< m1: T1
>

< m : UTT{UTTrec1}[head/T2]
>

<
   SUBRULE
      < T1: PREPP{PREPPrec1}[mu1] >
      < T2: PREPP{PREPPrec2}[mu1] >

      COMP
         <
          C1: PREPPrec1.superdeixis = presentdeixis AND
              QUOTE_polarityOK(T1)                  AND
              (NOT QUOTE_varsintree(T1))
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.superdeixis := omegadeixis
         >
      DECOMP
         <
          C1: PREPPrec2.superdeixis = omegadeixis AND
              QUOTE_polarityOK(T2)
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.superdeixis := presentdeixis
         >
>
&
\end{verbatim}
