SPANISH 70
&
\begin{verbatim}
%
% TRANSFORMATION TADJCOMPLExtrapos

< m1: ADJPFORMULA{ADJPFORMULArec1}
                            [mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu6,
                                      degreemodrel/N1
                                             [mu7,   (* e.g. casi *)
                                              head/T1,
                                              I2:thanascomplrel/T2
                                             ],
                                      mu3,
                                      head/ADJ{ADJrec1}[mu2],
                                      I4:mu4, 
                                      I5:mu5 
                                     ]

                            ]
>
< m : ADJPFORMULA{ADJPFORMULArec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                      [mu6,
                                       degreemodrel/N1
                                             [mu7, 
                                              head/T1
                                             ],
                                      mu3,
                                      head/ADJ{ADJrec1}[mu2],
                                      mu4, 
                                      I1:extraposrel/T2, 
                                         (* beter: postadjrel *)
                                      mu5 
                                     ]
                            ]
>

   MATCHCONDITIONS
      <I1: T2.cat IN [THANP]
       I2: T2.cat IN [THANP]
       I4: NOT EXIST(mu4, [I14:rel1/T4])
       I14: T4.CAT IN [SENTENCE]
       I5: NOT EXIST(mu5, [I15:rel1/T3])
       I15: T3.CAT IN [VARPREPP, QP] 
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
