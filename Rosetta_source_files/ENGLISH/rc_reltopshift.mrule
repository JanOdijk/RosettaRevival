ENGLISH 85

&
\newpage
\begin{verbatim}
%
% RULE RSRelMarking
< m1: CLAUSE{CLAUSErec1}
            [ mu1, 
              I1:rel1/T1, 
              mu2
            ] 
>

< m : CLAUSE{CLAUSErec1}
            [ mu1, 
              I2:rel1/T2, 
              mu2 
            ] 
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [NPVAR] WITH T1.REC.index = indexpar
       I2: T2.CAT IN [NPVAR] WITH T2.REC.mood = relativexpmood
      >

   PARAMETERS
      <
       indexpar   :keytype
      >

<

   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1} >
      < T2:NPVAR{NPVARrec2} >

      COMP
         <
          C1: NPVARrec1.mood = nowh
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.mood := relativexpmood; 
         >
      DECOMP
         <
          C1: true
          A1: indexpar := NPVARrec2.index; 
              NPVARrec1 := NPVARrec2;
              NPVARrec1.mood := nowh
         >
>
&

\end{verbatim}
