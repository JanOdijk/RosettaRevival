ENGLISH 104
&
\newpage
\begin{verbatim}
%
% FILTER FPreArgReflSpelling
< m : CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [mu2],
             mu3
            ]
>
  
   MATCHCONDITIONS
      <
       m: NOT EXIST (mu2, [head/I12::VERB{VERBrec1}[mu5]]) AND
          ( EXIST (mu1, [../I11::NP{NPrec1}[mu4]]) OR
            EXIST (mu2, [../I11::NP{NPrec1}[mu4]]) OR
            EXIST (mu3, [../I11::NP{NPrec1}[mu4]]) )
       I11: NPrec1.NPhead = reflNP
       I12: VERBrec1.reflexivity <> notreflexive
      >

         <
          C1: true
          A1: @
         >
&

\end{verbatim}

\newpage
\begin{verbatim}
% FILTER FPostArgReflSpelling
< m : CLAUSE{CLAUSErec1}
         I1:[ mu1,
              rel1/NPVAR{NPVARrec1},
              mu2,
              predrel/VERBP{VERBPrec1}
                     [ mu3,
                       rel2/NPVAR{NPVARrec2},
                       mu4
                     ],
              mu5
            ]
>
                    

   MATCHCONDITIONS
      <
       I1: RIGHTTOLEFT
       m : NPVARrec1 = NPVARrec2 EXCEPT FOR [cases] AND
           NOT EXIST (mu3, [../I11::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../I11::NPVAR{NPVARrec3}]) AND
           NOT EXIST (mu4, [../VARPREPP{VARPREPPrec1}
                                       [mu7,
                                        ../I11::NPVAR{NPVARrec3}]
                           ]) AND
           NOT EXIST (mu4, [../PREPP{PREPPrec1}
                                    [mu7,
                                     ../I11::NPVAR{NPVARrec3}]]) 
         I11: NPVARrec3 = NPVARrec1 EXCEPT FOR [cases]
      >

         <
          C1: true
          A1: @
         >
&

\end{verbatim}
