pragma C_include('string.pf');

PACKAGE mrusurcomdecl;
WITH strng;

const maxrnr = 9;
      Hinit = -1;
      Hdum = Hinit;
      Hfinal = 99;

type 
     string = STRING_string;
     graphtypetype = (enclosedgraph,optgraph,stargraph,helpgraphident,atomgraph);
     surfrulemode = (loccond,globcond);
     syntcat = (UTT,Regexp,graph,helpgraph,CAs,concgraph,vertline,
                elementarygraph,dot,roundopen,roundclose,squareopen,
                squareclose,curlyopen,curlyclose,ident,slash,number,
                charstring,rulename,iscat
               );
     psyntcat = ^syntcat;
     syntcatset = set of syntcat;
     pcharstringfieldrecord = ^charstringfieldrecord;
     charstringfieldrecord = record
                             stringfield:string;
                             linenumber:integer
                             end;
     prulenamefieldrecord = ^rulenamefieldrecord;
     rulenamefieldrecord = record
                            rulename:string
                           end;
     puttfieldrecord = ^uttfieldrecord;
     uttfieldrecord = record
                       numofhelpgraphs:integer
                      end;
     phelpgraphfieldrecord = ^helpgraphfieldrecord;
     helpgraphfieldrecord = record
                             str:string
                            end;
     pidentfieldrecord = ^identfieldrecord;
     identfieldrecord = record
                             str:string
                        end;
     pgraphfieldrecord = ^graphfieldrecord;
     graphfieldrecord = record
                         numofconcgraphs:integer
                        end;
     pconcgraphfieldrecord = ^concgraphfieldrecord;
     concgraphfieldrecord = record
                             numofelementarygraphs:integer
                            end;
     pelementarygraphfieldrecord = ^elementarygraphfieldrecord;
     elementarygraphfieldrecord = record
                                   graphtype:graphtypetype
                                  end;

     psnode = ^snode;
     prsnode = ^rsnode;
     rsnode = record node :psnode;
		     brother:prsnode
	      end;
     snode = record
			sonlist:prsnode;
			minpos,maxpos:integer;
			n:integer;
			
			case cat:syntcat of
            UTT:(uttfield:puttfieldrecord);
            IDENT:(identfield:pidentfieldrecord);
            HELPGRAPH:(helpgraphfield:phelpgraphfieldrecord);
            GRAPH:(graphfield:pgraphfieldrecord);
            CONCGRAPH:(concgraphfield:pconcgraphfieldrecord);
            ELEMENTARYGRAPH:(elementarygraphfield:pelementarygraphfieldrecord);
            CHARSTRING:(charstringfield:pcharstringfieldrecord);
   	    RULENAME:(rulenamefield:prulenamefieldrecord)
                        end;

     plostree = ^lostree;            
     lostree = record
			next:plostree;
			arg: psnode
	       end;
     pconnectionnode = ^connectionnode;
     psinglesegmentlist = ^singlesegmentlist;
     connectionnode = record
		      list:psinglesegmentlist;
		      next,prev:pconnectionnode;
		      idnr:integer
		      end;
     singlesegmentlist = record
				next:psinglesegmentlist;
				rn: pconnectionnode;
				stree: psnode
			 end;
     psurfgraph = ^surfgraphtype;
     psurfgraphnode = ^surfgraphnode;
     surfgraphtype = record
   			first,
   			last:psurfgraphnode
   		     end;
     nodeid = Hinit..Hfinal;
     plonodeid = ^lonodeid;
     lonodeid = record
   			next:plonodeid;
   			arg:nodeid
   	 	end;
     plossurfgraphnode = ^lossurfgraphnode;
     surfgraphnodelist = record
   				first,
   				last:plossurfgraphnode;
   			 end;
     lossurfgraphnode = record
   				next:plossurfgraphnode;
   				arg:psurfgraphnode
   			end;
     surfgraphnode = record
   			left,
   			right:psurfgraphnode;
   			n:nodeid;
   			cat:psyntcat;
   			nextnodes:surfgraphnodelist;
   			nextcats,
   			nexttops:syntcatset;
   			completed,alreadysearched:boolean
   	             end;
