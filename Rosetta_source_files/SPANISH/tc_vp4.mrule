                    tiempo     : PREPrec2.tiempo
                    aspecto    : PREPrec2.aspecto
                    retro      : PREPrec2.retro
                    SpecQ      : NPVARrec2.specQ
                  }
         >

   SUBRULE (*d*)
      <T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}>

      <T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}>

      COMP
         <
          C1: synPREPNP_PREPNP IN VERBrec1.synvps AND
