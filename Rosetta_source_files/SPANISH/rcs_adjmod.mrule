\newpage
\begin{verbatim}
% RULE RADJDegreemod1  
            
< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1}
                                     [mu2,
                                      head/ADJ{ADJrec1}[mu4],
                                      mu5 
                                     ]
                            ]  
  m2: T2
>

< m : ADJPPROP{ADJPPROPrec2}[mu1,
                             predrel/ADJP{ADJPrec2}
                                     [mu2,
                                      I1:degreemodrel/T2,
                                      head/ADJ{ADJrec1}[mu4],
                                      mu5
                                     ]
                            ]
>
   MATCHCONDITIONS
      <I1: T2.cat IN [QP, ADVP, NP]
       m2: T2.cat IN [QP, ADVP, NP]
      >

<
   SUBRULE (* 1 *) (* un poco, mas, demasiado menos, 
                      quanta mas *)

      <T2: QP{QPrec1}[mu7, head/Q{Qrec1}, I4:mu8]>
      <T2: QP{QPrec1}[mu7, head/Q{Qrec1}, I4:mu8]>

   MATCHCONDITIONS
      < I4: NOT EXIST(mu8, [paramodrel/..]) (* in that case RADJdegreemod2a
                                              applies*) 
        T2: ((Qrec1.key = KEY_'s_mas2qkey') -> 
             NOT EXIST(mu7, [artrel/..])) 
                             (* in that case the next subrule applies *)


     >

(* The relevance of a subclassification of QPs is still to be investigated.
   Therefore no restrictions have been stated yet. *)

      COMP
         <
          C1: true
            C11: Qrec1.key <> KEY_'s_mas2qkey'
            A11: ADJPrec2 := ADJPrec1;
            C11: Qrec1.key = KEY_'s_mas2qkey'
            A12: ADJPrec2 := ADJPrec1;
                 ADJPrec2.uses := ADJPrec2.uses - [ predicative ];
                 (* naar vorm is er geen onderscheid tussen attributief 
                    gebruik van superlatief (mas2) en comparatief mas; 
                    zie remarks *)
            
          A1: ADJPrec2.mood := QPrec1.mood;  (* m.h.o. op een WH-QP *)
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPPROPrec2.uses := ADJPrec2.uses;
         >
      DECOMP
         <
          C1: true  (* omkering !! *)
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := declxpmood;
              ADJPPROPrec1 := ADJPPROPrec2;
              (* ?? ADJPrec2.uses := [] *)   
          >

   SUBRULE (* 1a  el/la/los/las mas *)
           (* deze QP zou geen DETP mogen worden *)

      <T2: QP{QPrec2 }[artrel/ART{ARTrec1},
                       head/Q(KEY_'s_mas2qkey'){Qrec1}]
      >
      <T2: QP{QPrec2 }[artrel/ART{ARTrec1},
                       head/Q(KEY_'s_mas2qkey'){Qrec1}]
      >

      COMP
         <
          C1: ADJPrec1.genero = ARTrec1.genero AND
              ADJPrec1.numero = ARTrec1.numero
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.uses := [ predicative ];
              ADJPPROPrec2 := ADJPPROPrec1;
              ADJPPROPrec2.uses := ADJPrec2.uses;

         >
      DECOMP
         <
          C1: ADJPrec2.genero = ARTrec1.genero AND
              ADJPrec2.numero = ARTrec1.numero AND
              predicative IN  ADJPrec2.uses
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := declxpmood;
              (* ?? ADJPrec1.uses := [ ]; *)
              ADJPPROPrec1 := ADJPPROPrec2;

          >



   SUBRULE  (* 2 *) (* muy, muy para mio, tres metros TE, como *)
      <T2: ADVP{ADVPrec1}[I3:mu6]>
      <T2: ADVP{ADVPrec1}[I3:mu6]>

   MATCHCONDITIONS
      <I3: NOT EXIST(mu6, [paramodrel/..])  (* in that case RADJDegreemod2b
                                               applies *)
      >

      COMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs 
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := ADVPrec1.mood;  (* m.h.o. op een WH-ADV *)
              ADJPPROPrec2 := ADJPPROPrec1;
         >
      DECOMP
         <
          C1: degreeadv IN ADVPrec1.actsubcefs 
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := declxpmood;
              ADJPPROPrec1 := ADJPPROPrec2;
          
         >

   SUBRULE  (* 3 *)  (* (bijna) drie meter lang, hoeveel meter lang *)
                     (* NB. Phrases such as `drie uur lang' 
                            should only be analysed as ADVPs.
                         *)  

      <T2: NP{NPrec1}[mu6] >
      <T2: NP{NPrec1}[mu6] >

      COMP
         <
          C1: (unitnoun IN NPrec1.actsubcs) AND
              (ADJrec1.temporal = false)
          A1: ADJPrec2 := ADJPrec1;
              ADJPrec2.mood := NPrec1.mood;  (* m.h.o. op een WH-NP *)
              ADJPPROPrec2 := ADJPPROPrec1;
         >
      DECOMP
         <
          C1: (unitnoun IN NPrec1.actsubcs ) AND
              (ADJrec1.temporal = false)
          A1: ADJPrec1 := ADJPrec2;
              ADJPrec1.mood := declxpmood;
              ADJPPROPrec1 := ADJPPROPrec2;


         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RADJDegreemod1
\item[* relevant examples:]
                           te groot, zeer mooi, hoe lang, minder leuk, iets 
                           gelig
\item[* language:] Spanish
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Adjppropformation
\item[* class:] RC: ADJDegreemodrules
\item[* date of creation:] 20-SEP-1988 14:26:49  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] insertion of a degree-modifier 
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:] Measure NPs are not analyzed as QPs. Instead,
the uniformity among the modifying categories is expressed by the relationname
degreemodrel that links the modifying categories to the ADJP. 
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{} 
Degree-modifiers are NOT 
analyzed as ADVPPROPs, QPPROPs etc., but as ADVPs, QPs, etc.
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item 
Naar vorm is er geen onderscheid tussen attributief gebruik van superlatief
(mas2) en comparatief mas; {\em el libro mas bonito} correspondeert zowel met
{\em het mooiere boek, als met het mooiste boek};  in combinatie met het
definiete lidwoord is er pragmatisch wellicht ook geen verschil; de
superlatief is hier in het Nederlands 'gewoner'. In
combinatie met het indefiniete lidwoord  is de superlatief
juist  minder gewoon. Indefiniete bare plurals met een
superlatief kunnen uitsluitend generiek gebruikt worden:   
{\em Oudste kinderen zijn meestal nogal conservatief}         

\item problems:

\item modifications:\\
\end{enumerate}
\end{description}

