\newpage
\begin{verbatim}
% RULE RPPPAdvpMod
< m1: PREPPPROP{PREPPPROPrec1}
               [ mu1, 
                 predrel/PREPP{PREPPrec1}[mu2] 
               ]

  m2: ADVP{ADVPrec1}[mu3] 
>

< m : PREPPPROP{PREPPPROPrec1}
               [ mu1, 
                 predrel/PREPP{PREPPrec1}
                        [ modrel/ADVP{ADVPrec2}[mu3],
                          mu2
                        ] 
               ]
>

      COMP
         <
          C1: preppadv IN ADVPrec1.actsubcefs  AND
              ADVPrec1.superdeixis = presentdeixis 
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.superdeixis := omegadeixis 
         >
      DECOMP
         <
          C1: preppadv IN ADVPrec2.actsubcefs AND
              ADVPrec2.superdeixis = omegadeixis 
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := presentdeixis 
         >

&

\end{verbatim}
