\begin{verbatim}
% RULE DETPformation1a
< m1: DET{DETrec1}[head/BDET(KEY_todoBDETkey){BDETrec1}]
>

< m : DETP{DETPrec1}[head/DET{DETrec1}[head/BDET(KEY_todoBDETkey){BDETrec1}],
                     I1:artrel/T1] 
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [ART]
      >

<   
   SUBRULE
      < >
      <T1: ART(KEY_elARTkey){ARTrec1} >

      COMP
         <
          C1: DETrec1.numero = singular AND
              DETrec1.genero = masc
          A1: DETPrec1 := 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
         >

      DECOMP
         <
          C1: DETrec1.numero = singular AND
              DETrec1.genero = masc AND
              DETPrec1 = 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
          A1:  @
         >

   SUBRULE
      < >
      <T1: ART(KEY_laARTkey){ARTrec1} >

      COMP
         <
          C1: DETrec1.numero = singular AND
              DETrec1.genero = fem
          A1: DETPrec1 := 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
         >

      DECOMP
         <
          C1: DETrec1.numero = singular AND
              DETrec1.genero = fem AND
              DETPrec1 = 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
          A1:  @
         >

   SUBRULE
      < >
      <T1: ART(KEY_losARTkey){ARTrec1} >

      COMP
         <
          C1: DETrec1.numero = plural AND
              DETrec1.genero = masc
          A1: DETPrec1 := 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
         >

      DECOMP
         <
          C1: DETrec1.numero = plural AND
              DETrec1.genero = masc AND
              DETPrec1 = 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
          A1:  @
         >

   SUBRULE
      < >
      <T1: ART(KEY_lasARTkey){ARTrec1} >

      COMP
         <
          C1: DETrec1.numero = plural AND
              DETrec1.genero = fem
          A1: DETPrec1 := 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
         >

      DECOMP
         <
          C1: DETrec1.numero = plural AND
              DETrec1.genero = fem AND
              DETPrec1 = 
                 { 
                   genero      :  DETrec1.genero
                   numero      :  DETrec1.numero
                   definite    :  DETrec1.definite
                   posspred    :  DETrec1.posspred
                   posscomas   :  DETrec1.posscomas
                   mood        :  DETrec1.mood
           (*        syntquant   :  DETrec1.syntquant  *)
                 }
          A1:  @
         >


>

&

\end{verbatim}
