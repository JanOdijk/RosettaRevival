       I2: SENTENCErec1.mood = declarative AND
           SENTENCErec1.finiteness = infinite
       I3: NPVARrec1.mood = wh
       I4: NOT EXIST (mu3, [I11:rel1/..])
         I11: rel1 IN [shiftrel, leftdislocrel]
      >

