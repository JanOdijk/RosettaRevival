\newpage
\begin{verbatim}
% RULE RVPNegVar
< m1: CLAUSE{CLAUSErec1}
            [ I1:mu1,
              predrel/VERBP{VERBPrec1}
                           [ mu2,
                             head/VERB{VERBrec1}[mu3],
                             I4:mu4,
                             I5:mu5
                           ],
              mu6
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ I1:mu1,
              predrel/VERBP{VERBPrec1}
                           [ mu2,
                             head/VERB{VERBrec1}[mu3],
                             I4:mu4,
                             meltnegrel/NEGVAR{NEGVARrec1},
                             I5:mu5
                           ],
              mu6
            ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [I11:rel1/..])
         I11: rel1 IN [posrel, negrel]
       I4: NOT EXIST (mu4, [meltnegrel/..])
       I5: QUOTE_firstisapossnietNP(mu5)
       m1: ALL
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
