pragma c_include('tstring.pf');
package surflinklangspec;
with tstring;
const
     surflinklangspec_nrow = 1  ;
type setofchar = set of char;
type
     surflinklangspec_int=integer;
     surflinklangspec_bool=boolean;
     surflinklangspec_primorsec = (primary,secondary);
     surflinklangspec_graphtypetype = (shorthand,atomgraph,stargraph,optgraph,enclosedgraph);
plosstring = ^losstring;
losstring = record
   next:plosstring;
   carriage:boolean;
   arg:tstring_string
 end; 
localfile = record 
first,last:plosstring
 end; 
surflinklangspec_ptr = record 
node:surflinklangspec_int;

 end; 
plosptr = ^losptr;
losptr = record
   next:plosptr;
   arg:surflinklangspec_ptr
 end; 
surflinklangspec_setofptrs = record 
first,last:plosptr
 end; 
surflinklangspec_idt = record 
str:TSTRING_string;

 end; 
plosidt = ^losidt;
losidt = record
   next:plosidt;
   arg:surflinklangspec_idt
 end; 
surflinklangspec_setofidts = record 
first,last:plosidt
 end; 
surflinklangspec_shd = record 
str:TSTRING_string;
tree:surflinklangspec_int;

 end; 
plosshd = ^losshd;
losshd = record
   next:plosshd;
   arg:surflinklangspec_shd
 end; 
surflinklangspec_setofshds = record 
first,last:plosshd
 end; 
surflinklangspec_tran = record 
cat:TSTRING_string;
block:surflinklangspec_int;
node:surflinklangspec_int;
surfcat:surflinklangspec_bool;
kind:surflinklangspec_primorsec;

 end; 
plostran = ^lostran;
lostran = record
   next:plostran;
   arg:surflinklangspec_tran
 end; 
surflinklangspec_setoftrans = record 
first,last:plostran
 end; 
surflinklangspec_node = record 
cat:TSTRING_string;
rule:TSTRING_string;
lexrules:surflinklangspec_setofidts;
nonlexrules:surflinklangspec_setofidts;
refs:surflinklangspec_setofidts;
procstate:surflinklangspec_bool;
emptys:surflinklangspec_setofptrs;
searchedbefore2:surflinklangspec_bool;
lexsearched:surflinklangspec_bool;
completed:surflinklangspec_bool;
state:surflinklangspec_int;
trans:surflinklangspec_setoftrans;

 end; 
plosnode = ^losnode;
losnode = record
   next:plosnode;
   arg:surflinklangspec_node
 end; 
surflinklangspec_setofnodes = record 
first,last:plosnode
 end; 
surflinklangspec_auto = record 
initial:surflinklangspec_int;
final:surflinklangspec_int;

 end; 
plosauto = ^losauto;
losauto = record
   next:plosauto;
   arg:surflinklangspec_auto
 end; 
surflinklangspec_setofautos = record 
first,last:plosauto
 end; 
     surflinklangspec_pterminal = ^surflinklangspec_terminal;
     surflinklangspec_terminal = 
         record
                       str:tstring_string
           end;
     surflinklangspec_puttrec = ^surflinklangspec_uttrec;
     surflinklangspec_uttrec = 
         record
                      rulenames:surflinklangspec_setofidts;
                     shorthands:surflinklangspec_setofshds;
           end;
     surflinklangspec_prulespecrec = ^surflinklangspec_rulespecrec;
     surflinklangspec_rulespecrec = 
         record
           end;
     surflinklangspec_pgraphrec = ^surflinklangspec_graphrec;
     surflinklangspec_graphrec = 
         record
                numofconcgraphs:surflinklangspec_int;
                 numberofstates:surflinklangspec_int;
           end;
     surflinklangspec_pconcgraphrec = ^surflinklangspec_concgraphrec;
     surflinklangspec_concgraphrec = 
         record
                numofelemgraphs:surflinklangspec_int;
                 numberofstates:surflinklangspec_int;
           end;
     surflinklangspec_pelemgraphrec = ^surflinklangspec_elemgraphrec;
     surflinklangspec_elemgraphrec = 
         record
                      graphtype:surflinklangspec_graphtypetype;
                 numberofstates:surflinklangspec_int;
           end;
     surflinklangspec_pnumberrec = ^surflinklangspec_numberrec;
     surflinklangspec_numberrec = 
         record
                            int:surflinklangspec_int;
           end;
     surflinklangspec_pparamsrec = ^surflinklangspec_paramsrec;
     surflinklangspec_paramsrec = 
         record
                      rulenames:surflinklangspec_setofidts;
           end;
     surflinklangspec_prulebodyrec = ^surflinklangspec_rulebodyrec;
     surflinklangspec_rulebodyrec = 
         record
           end;
     surflinklangspec_pblockrec = ^surflinklangspec_blockrec;
     surflinklangspec_blockrec = 
         record
           end;
     surflinklangspec_ppascalrec = ^surflinklangspec_pascalrec;
     surflinklangspec_pascalrec = 
         record
           end;
     surflinklangspec_category = (comment,identifier,UTT,RULESPEC,RULEBODY,BLOCK,PASCALTOHEKJE,PASCALTOGLOBAL,PASCALTOEND,
PSTOSTARRIGHT,GRAPH,CONCGRAPH,ELEMGRAPH,NUMBER,PARAMS,PASCAL,PROCENT,SLASH,ISCAT,DOT,VERTLINE,XXXX,HEKJE,SEMICOLON,COLON,PLUS,
ROUNDOPEN,ROUNDCLOSE,CURLYOPEN,CURLYCLOSE,SQUAREOPEN,SQUARECLOSE);

surflinklangspec_pfielddef = ^surflinklangspec_fielddef;
surflinklangspec_fielddef =
         record
      case cat:surflinklangspec_category of
                  UTT:
                     (UTTfield:surflinklangspec_puttrec);
                  RULESPEC:
                     (RULESPECfield:surflinklangspec_prulespecrec);
                  RULEBODY:
                     (RULEBODYfield:surflinklangspec_prulebodyrec);
                  BLOCK:
                     (BLOCKfield:surflinklangspec_pblockrec);
                  PASCALTOHEKJE:
                     (PASCALTOHEKJEfield:surflinklangspec_ppascalrec);
                  PASCALTOGLOBAL:
                     (PASCALTOGLOBALfield:surflinklangspec_ppascalrec);
                  PASCALTOEND:
                     (PASCALTOENDfield:surflinklangspec_ppascalrec);
                  PSTOSTARRIGHT:
                     (PSTOSTARRIGHTfield:surflinklangspec_ppascalrec);
                  GRAPH:
                     (GRAPHfield:surflinklangspec_pgraphrec);
                  CONCGRAPH:
                     (CONCGRAPHfield:surflinklangspec_pconcgraphrec);
                  ELEMGRAPH:
                     (ELEMGRAPHfield:surflinklangspec_pelemgraphrec);
                  NUMBER:
                     (NUMBERfield:surflinklangspec_pnumberrec);
                  PARAMS:
                     (PARAMSfield:surflinklangspec_pparamsrec);
                  PASCAL:
                     (PASCALfield:surflinklangspec_ppascalrec);
identifier,                  PROCENT,
                  SLASH,
                  ISCAT,
                  DOT,
                  VERTLINE,
                  XXXX,
                  HEKJE,
                  SEMICOLON,
                  COLON,
                  PLUS,
                  ROUNDOPEN,
                  ROUNDCLOSE,
                  CURLYOPEN,
                  CURLYCLOSE,
                  SQUAREOPEN,
                  SQUARECLOSE:
                     (      terminal:surflinklangspec_pterminal);
           end;

procedure initint(var s:integer);external;
procedure initbool(var s:boolean);external;
procedure initsetofptrs(var s:surflinklangspec_setofptrs); external;
function stillptrs(var s:surflinklangspec_setofptrs):boolean; external;
procedure takeptr(var ptr1:surflinklangspec_ptr
        ;var s:surflinklangspec_setofptrs); external;
procedure appendptr(ptr1:surflinklangspec_ptr
        ;var s:surflinklangspec_setofptrs); external;
procedure initsetofidts(var s:surflinklangspec_setofidts); external;
function stillidts(var s:surflinklangspec_setofidts):boolean; external;
procedure takeidt(var idt1:surflinklangspec_idt
        ;var s:surflinklangspec_setofidts); external;
procedure appendidt(idt1:surflinklangspec_idt
        ;var s:surflinklangspec_setofidts); external;
procedure initsetofshds(var s:surflinklangspec_setofshds); external;
function stillshds(var s:surflinklangspec_setofshds):boolean; external;
procedure takeshd(var shd1:surflinklangspec_shd
        ;var s:surflinklangspec_setofshds); external;
procedure appendshd(shd1:surflinklangspec_shd
        ;var s:surflinklangspec_setofshds); external;
procedure initsetoftrans(var s:surflinklangspec_setoftrans); external;
function stilltrans(var s:surflinklangspec_setoftrans):boolean; external;
procedure taketran(var tran1:surflinklangspec_tran
        ;var s:surflinklangspec_setoftrans); external;
procedure appendtran(tran1:surflinklangspec_tran
        ;var s:surflinklangspec_setoftrans); external;
procedure initsetofnodes(var s:surflinklangspec_setofnodes); external;
function stillnodes(var s:surflinklangspec_setofnodes):boolean; external;
procedure takenode(var node1:surflinklangspec_node
        ;var s:surflinklangspec_setofnodes); external;
procedure appendnode(node1:surflinklangspec_node
        ;var s:surflinklangspec_setofnodes); external;
procedure initsetofautos(var s:surflinklangspec_setofautos); external;
function stillautos(var s:surflinklangspec_setofautos):boolean; external;
procedure takeauto(var auto1:surflinklangspec_auto
        ;var s:surflinklangspec_setofautos); external;
procedure appendauto(auto1:surflinklangspec_auto
        ;var s:surflinklangspec_setofautos); external;
 function surflinklangspec_scanchars:setofchar;
         external;
 procedure surflinklangspec_init; external;
 procedure surflinklangspec_word(i:integer;var s:tstring_string);
         external;
 function surflinklangspec_wcat(i:integer):surflinklangspec_category;
         external;
 function surflinklangspec_scat(c:char):surflinklangspec_category;
         external;
 procedure surflinklangspec_createterm(s:surflinklangspec_category;
           w:tstring_string;var f:surflinklangspec_fielddef);
         external;
end{langspec};
