/* debug: debug draw trees window */

object trees_window : XmFormDialog {
    arguments {
	XmNdialogTitle	= N_trees_window;
        arguments form_dialog_args;
    };
    controls {
	XmRowColumn      trees_button_box;
        XmSeparator      trees_separator1;
        XmForm           trees_nr_form;
        XmScrolledWindow trees_output_window;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_trees_window + DEFAULT_BUTTON_OFFSET*X_trees_ok_button);
    };
};

object trees_button_box : XmRowColumn {
    arguments {
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_trees_ok_button;
                XmNsensitive    = false;
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_trees_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_trees_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_trees_expand_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_trees_expand_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_trees_expand_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_trees_orientation_button;
	    };
	    callbacks {
		XmNactivateCallback = procedure 
		    XwtAction (X_trees_orientation_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_trees_showtree_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_trees_showtree_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_trees_showtree_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_trees_help_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_trees_help_button);
		XmNactivateCallback = procedure XwhAction (X_trees_help_button);
	    };
	};
    };
};

object trees_separator1 : XmSeparator {
    arguments {
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmRowColumn trees_button_box;
        XmNleftAttachment    = XmATTACH_FORM;
        XmNleftOffset        = 0;
        XmNrightAttachment   = XmATTACH_FORM;
        XmNrightOffset       = 0;
    };
};

object trees_nr_form : XmForm {
    arguments {
        XmNbottomAttachment  = XmATTACH_WIDGET;
        XmNbottomWidget      = XmSeparator trees_separator1;
        XmNleftAttachment    = XmATTACH_FORM;
        XmNrightAttachment   = XmATTACH_FORM;

        arguments form_args;
    };
    controls {
        XmRowColumn trees_card_tuple;
        XmRowColumn trees_arity_stree;
    };
};

object trees_card_tuple : XmRowColumn {
    arguments {
        XmNtopAttachment     = XmATTACH_FORM;        
        XmNleftAttachment    = XmATTACH_FORM;

        XmNspacing           = spacing * 6;
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmRowColumn trees_card;
        XmRowColumn trees_tuple;
    };
};

object trees_arity_stree : XmRowColumn {
    arguments {
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmRowColumn trees_card_tuple; 
        XmNleftAttachment    = XmATTACH_FORM;

        XmNspacing           = spacing * 6;
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmRowColumn trees_arity;
        XmRowColumn trees_stree;
    };
};

object trees_card : XmRowColumn {
    arguments {
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                XmNlabelString       = N_trees_card_text;
                XmNfontList          = big;
            };
        };
        XmLabel {
            callbacks {
                MrmNcreateCallback =
                        procedure XwuCreateWidget (X_trees_card_text);
            };
        };
    };
};

object trees_arity : XmRowColumn {
    arguments {
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                XmNlabelString       = N_trees_arity_text;
                XmNfontList          = big;
            };
        };
        XmLabel {
            callbacks {
                MrmNcreateCallback =
                        procedure XwuCreateWidget (X_trees_arity_text);
            };
        };
    };
};

object trees_tuple : XmRowColumn {
    arguments {
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                XmNlabelString       = N_trees_tuple_text;
                XmNfontList          = big;
            };
        };
        XmScale {
            arguments {
		XmNmaximum           = 2;
		XmNminimum           = 1;
		XmNorientation       = XmHORIZONTAL;
		XmNscaleMultiple     = 1;
		XmNshowValue         = true;
		XmNvalue             = 2;
                XmNborderWidth       = 1;
    	    };
    	    callbacks {
        	MrmNcreateCallback =
                        procedure XwuCreateWidget (X_trees_tuple_text);
            };
        };
    };
};

object trees_stree : XmRowColumn {
    arguments {
        XmNorientation       = XmHORIZONTAL;
    };
    controls {
        XmLabel {
            arguments {
                XmNlabelString       = N_trees_stree_text;
                XmNfontList          = big;
            };
        };
        XmScale {
            arguments {
		XmNmaximum           = 2;
		XmNminimum           = 1;
		XmNorientation       = XmHORIZONTAL;
		XmNscaleMultiple     = 1;
		XmNshowValue         = true;
		XmNvalue             = 2;
        	XmNsensitive         = false;
    	    };
    	    callbacks {
        	MrmNcreateCallback =
                        procedure XwuCreateWidget (X_trees_stree_text);
            };
        };
    };
};

object trees_output_window : XmScrolledWindow {
    arguments {
	XmNtopAttachment	= XmATTACH_FORM;
	XmNleftAttachment       = XmATTACH_FORM;
	XmNrightAttachment	= XmATTACH_FORM;
	XmNbottomAttachment	= XmATTACH_WIDGET;
	XmNbottomWidget		= XmForm trees_nr_form;
	XmNscrollingPolicy      = XmAUTOMATIC;
	XmNworkWindow		= user_defined trees_area;

        XmNheight	= 255;
	XmNwidth	= 255;
    };
    controls {
        user_defined trees_area;
    };
};

object trees_area : user_defined procedure TreeCreate () {
    arguments {
	XmNverticalSpace	= 20;
	XmNhorizontalSpace	= 20;
        XmNorientation          = XmHORIZONTAL;
        XmNborderWidth          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_trees_area);
    };
};
