\newpage
\begin{verbatim}
% TRANSFORMATION TADVmoreTOer

< m1: ADVP{ADVPrec1}
           [mu2,
           degreemodrel/QP{QPrec1}
                        [mu3,
                         head/Q(KEY_moreQkey){Qrec1}
                        ],
           head/I1::ADV{ADVrec1}[mu4],
           mu5
           ]
>

< m : ADVP{ADVPrec1}
          [I2:mu2,
           I3:mu3, (* much/a bit/ 3 hours *)
           head/I4::ADV{ADVrec2}[mu4],
           mu5
          ]
>
   MATCHCONDITIONS
      <
       I1: ADVrec1.compformations * [noComp, moreCOmp] = [] AND
           ADVrec1.compform = basic
       I2: NOT EXIST(mu2, [premodrel/..])
       I3: ALL(mu3, premodrel/..)
       I4: ADVrec2.compform = compar AND
           ADVrec2.compformations * [noComp, moreComp] = []
      >

      COMP
         <
          C1: true           
          A1: ADVrec2 := ADVrec1;
              ADVrec2.compform := compar
         >
      DECOMP
         <
          C1: true
          A1: ADVrec1 := ADVrec2;
              ADVrec1.compform := basic;
              QPrec1 := COPYT_qTOqp(Qrec1) (* QPrec1.thanascompl ??? *)
         >


&

\end{verbatim}
