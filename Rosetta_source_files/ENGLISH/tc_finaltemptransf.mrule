ENGLISH 34
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION Taspectneutralization
< m1:SENTENCE{SENTENCErec1}
           [mu1] 
>

< m :SENTENCE{SENTENCErec2}
           [mu1]
>
<
    SUBRULE (* perfective and imperfective *)
      <mu1: [mu2] >
      <mu1: [mu2] >

      COMP
         <
          C1: (SENTENCErec1.aspect = imperfective AND
               QUOTE_tempdurnotfound(mu2)
              ) OR
              (SENTENCErec1.aspect = perfective)
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.aspect := omegaaspect;
         >

      DECOMP
         <
          C1: SENTENCErec2.aspect = omegaaspect
             C11: true
             A11: SENTENCErec1 := SENTENCErec2;
                  SENTENCErec1.aspect := perfective;
             C12: QUOTE_tempdurnotfound(mu2)
             A12: SENTENCErec1 := SENTENCErec2;
                  SENTENCErec1.aspect := imperfective;
          A1: @
         >

    SUBRULE (* habitual *)
      <mu1: [I1: mu2] >
      <mu1: [I1: mu2] >
   MATCHCONDITIONS
      <
       I1: NOT QUOTE_tempfreqnotfound(mu2)
      >


      COMP
         <
          C1: (SENTENCErec1.aspect = habitual) 
          A1: SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.aspect := omegaaspect;
         >

      DECOMP
         <
          C1: SENTENCErec2.aspect = omegaaspect
          A1: SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.aspect := habitual;
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Taspectneutralization
\item[* relevant examples:] 
\item[* language:]  english
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] Finaltransformations
\item[* date of creation:] 25-MAR-1988
\item[* author:] Lisette Appelo
\item[* copied from:] Taspectneutralization spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 7/12/88\ \ \ \ \ author: Lisette Appelo
\item date: 12/12/88\ \ \ \ \ author: Lisette Appelo
\item date: 27/06/89\ \ \ \ \ author: Lisette Appelo\\
Added condition on absence of duratrion adverbial for imperfective aspect. this 
will cut off paths in analysis rather early.
\end{enumerate}
\item[* task:] This rule is for efficiency of the surface parser. In analysis 
it creates the paths for imperfective, perfective and habitual
aspect that are needed 
because distinctions in other languages. In generation it sets the value for 
aspect to omegaaspect after application of the timerules (symmetry reasons).
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] 
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules: \\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item 

\item in other languages: 

\end{enumerate}
\item[* relevant literature/documents:] doc. 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:
7/12/88: Changed CLAUSE to SENTENCE because of change in order in control 
expression\\
12/12/88: Added subrule for habitual aspect.\\
\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION Taspectneutralization2
< m1:NP{NPrec1}
           [head/SENTENCE{SENTENCErec1}[mu1]] 
>

< m :NP{NPrec2}
           [head/SENTENCE{SENTENCErec2}[mu1]]
>
<
    SUBRULE (* perfective and imperfective *)
      <mu1: [mu2] >
      <mu1: [mu2] >

      COMP
         <
          C1: ((NPrec1.aspect = imperfective) AND
               (SENTENCErec1.aspect = imperfective)
              ) OR
              ((NPrec1.aspect = perfective) AND
               (SENTENCErec1.aspect = perfective)
              )
          A1: NPrec2 := NPrec1;
              NPrec2.aspect := omegaaspect;
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.aspect := omegaaspect;
         >

      DECOMP
         <
          C1: NPrec2.aspect = omegaaspect AND
              SENTENCErec2.aspect = omegaaspect
             C11: true
             A11: NPrec1 := NPrec2;
                  NPrec1.aspect := perfective;
                  SENTENCErec1 := SENTENCErec2;
                  SENTENCErec1.aspect := perfective;
             C12: true
             A12: NPrec1 := NPrec2;
                  NPrec1.aspect := imperfective;
                  SENTENCErec1 := SENTENCErec2;
                  SENTENCErec1.aspect := imperfective;
          A1: @
         >

    SUBRULE (* habitual *)
      <mu1: [I1: mu2] >
      <mu1: [I1: mu2] >
   MATCHCONDITIONS
      <
       I1: NOT QUOTE_tempfreqnotfound(mu2)
      >


      COMP
         <
          C1: (NPrec1.aspect = habitual) AND
              (SENTENCErec1.aspect = habitual)
          A1: NPrec2 := NPrec1;
              NPrec2.aspect := omegaaspect;
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.aspect := habitual;

         >

      DECOMP
         <
          C1: NPrec2.aspect = omegaaspect AND
              SENTENCErec2.aspect = omegaaspect
          A1: NPrec1 := NPrec2;
              NPrec1.aspect := habitual;
              SENTENCErec1 := SENTENCErec2;
              SENTENCErec1.aspect := habitual;

         >
>
&

\end{verbatim}
