\begin{verbatim}
% TRANSFORMATION TVerbpattern6
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                            [ head/VERB{VERBrec1}[mu2],
                              argrel/T1,
                              argrel/T2
                            ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                          [ head/VERB{VERBrec1}[mu2],
                            I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                   [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                     objrel/T2 ],
                            rel1/T1                           
                          ] 
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR
               [headkey, actsubcefs, mood, synppefs, thetapp,
                specQ, class, deixis, aspect, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            deixis     : PREPrec1.deixis
                            aspect     : PREPrec1.aspect
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >

<
   SUBRULE (* 1a. seem x1 x2; x1 mention x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synPREPNP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : finite
                                  PROsubject  : false }
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                mood       : NPVARrec2.mood
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_THATSENT]
         >
      DECOMP
         <
          C1: synPREPNP_THATSENT IN VERBrec1.synvps AND
              synPREPNP_THATSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP 
                               mood       : NPVARrec2.mood 
                               specQ      : NPVARrec2.specQ
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : finite
                                  PROsubject  : false }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. seem to x1 x2; x1 mention to x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synPREPNP_THATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : finite
                                  PROsubject  : false }
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                mood       : relativexpmood
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                synppefs   : [synNP] 
                                thetapp    : pp120 } ;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_THATSENT]
         >
      DECOMP
         <
          C1: synPREPNP_THATSENT IN VERBrec1.synvps AND
              synPREPNP_THATSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : relativexpmood 
                               specQ      : yesspec
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : finite
                                  PROsubject  : false }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2a. x1 inquire of x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synPREPNP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.mood  IN 
                         [yesnointerrogative, whinterrogative] AND
              SENTENCEVARrec1.senttype = subordinateclause
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_QSENT]
         >
      DECOMP
         <
          C1: synPREPNP_QSENT IN VERBrec1.synvps AND
              synPREPNP_QSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : NPVARrec2.mood 
                               specQ      : NPVARrec2.specQ
                               thetapp    : pp120 } AND
              SENTENCEVARrec1.mood  IN 
                         [yesnointerrogative, whinterrogative] AND
              SENTENCEVARrec1.senttype = subordinateclause
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b. x1 inquire of x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synPREPNP_QSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.mood  IN 
                         [yesnointerrogative, whinterrogative] AND
              SENTENCEVARrec1.senttype = subordinateclause
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_QSENT]
         >
      DECOMP
         <
          C1: synPREPNP_QSENT IN VERBrec1.synvps AND
              synPREPNP_QSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : relativexpmood 
                               specQ      : yesspec
                               thetapp    : pp120 } AND
              SENTENCEVARrec1.mood  IN 
                         [yesnointerrogative, whinterrogative] AND
              SENTENCEVARrec1.senttype = subordinateclause
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3a. x1 sign to x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synPREPNP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : infinite
                                  infsort     : toinf
                                  PROsubject  : true }
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_OPENTOSENT]
         >
      DECOMP
         <
          C1: synPREPNP_OPENTOSENT IN VERBrec1.synvps AND
              synPREPNP_OPENTOSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : NPVARrec2.mood 
                               specQ      : NPVARrec2.specQ
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : infinite
                                  infsort     : toinf
                                  PROsubject  : true }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3b. x1 sign to x2 x3 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synPREPNP_OPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : infinite
                                  infsort     : toinf
                                  PROsubject  : true }
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_OPENTOSENT]
         >
      DECOMP
         <
          C1: synPREPNP_OPENTOSENT IN VERBrec1.synvps AND
              synPREPNP_OPENTOSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : relativexpmood 
                               specQ      : yesspec
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood        : declarative
                                  senttype    : subordinateclause
                                  finiteness  : infinite
                                  infsort     : toinf
                                  PROsubject  : true }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >


   SUBRULE (* 5a. seem to x2 x1 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synPREPNP_CLOSEDTOSENT IN VERBrec1.synvps  AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  finiteness : infinite
                                  infsort    : toinf
                                  PROsubject : false }
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_CLOSEDTOSENT]
         >
      DECOMP
         <
          C1: synPREPNP_CLOSEDTOSENT IN VERBrec1.synvps AND
              synPREPNP_CLOSEDTOSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : NPVARrec2.mood 
                               specQ      : NPVARrec2.specQ
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  finiteness : infinite
                                  infsort    : toinf
                                  PROsubject : false }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5b. seem to x2 x1 *)
      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      < T1: SENTENCEVAR{SENTENCEVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synPREPNP_CLOSEDTOSENT IN VERBrec1.synvps  AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  finiteness : infinite
                                  infsort    : toinf
                                  PROsubject : false }
          A1: rel1 := complrel;
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood
                                specQ      : yesspec
                                class      : PREPrec1.class
                                deixis     : PREPrec1.deixis
                                aspect     : PREPrec1.aspect
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_CLOSEDTOSENT]
         >
      DECOMP
         <
          C1: synPREPNP_CLOSEDTOSENT IN VERBrec1.synvps AND
              synPREPNP_CLOSEDTOSENT IN VERBPPROPrec2.synvpefs AND
              rel1 = complrel AND
              VARPREPPrec1 = { synppefs  NI synNP
                               mood       : relativexpmood
                               specQ      : yesspec
                               thetapp    : pp120 } AND
              SENTENCEVARrec1 = { mood       : declarative
                                  senttype   : subordinateclause
                                  finiteness : infinite
                                  infsort    : toinf
