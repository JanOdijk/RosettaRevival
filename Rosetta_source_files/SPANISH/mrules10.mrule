\begin{verbatim}
%
% TRANSFORMATION Tcliticnodeinsertion
< m1:VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu3],
                       I1: mu4
                      ],
               mu5 
              ] 
>

< m :VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu3],
                       cliticrel/CLITIC{}[ ],
                       I1: mu4
                      ],
               mu5 
              ] 

>

   MATCHCONDITIONS
      <
        I1: NOT EXIST (mu4, [cliticrel/CLITIC{}[ ]])       
      >

      COMP
         <
          C1: true
          A1: @
         >
&

\newpage
\end{verbatim}
