\begin{description}
\item[* name:] TWhshift1
\item[* relevant examples:]
\begin{description}
    \item[preadvrel]   Wie heeft hij aan elkaar voorgesteld?
    \item[subjrel]      Wie heeft hem gezien
    \item[postsubjrel] Wie heeft er een boek gekocht?
    \item[tempadvrel] Wanneer heeft hij het boek gekocht? 
    \item[locadvrel] Waar heeft hij het boek gekocht?
    \item[objrel] Wat heeft hij gekocht
    \item[indobjrel] Wie heeft hij een boek gegeven
    \item[predrel/ADJP] Hoe groot is hij geworden
    \item[predrel/NPVAR] Wat is dat?
    \item[predrel, NP] Wat is hij geworden
\end{description}
