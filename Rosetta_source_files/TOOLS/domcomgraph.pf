pragma C_include ('domcomlangspec.pf');
pragma C_include ('domcomdecl.pf');

PACKAGE domcomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH domcomDECL,
     domcomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: domcomLANGSPEC_Category;
                          b: domcomDECL_nodeid): domcomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: domcomDECL_psurfgraph): domcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: domcomDECL_psurfgraph): domcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: domcomDECL_psurfgraph): domcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: domcomDECL_psurfgraph): domcomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: domcomLANGSPEC_Category; 
                          c: domcomDECL_psurfgraph); EXTERNAL;
 
END {domcomGRAPH};
