pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('#langspec.pf');

PACKAGE #DECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     #LANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   #DECL_Surfrulemode = (loccond, globcond);
   #DECL_psyntcat     = ^#LANGSPEC_Category;
   #DECL_syntcatset   = SET OF #LANGSPEC_Category;
   #DECL_nodeid         = HINIT..HFINAL;
   #DECL_plonodeid      = ^#DECL_lonodeid;
   #DECL_lonodeid       = RECORD
   			          next: #DECL_plonodeid;
   			          arg : #DECL_nodeid
   	 	               END;
   #DECL_pSnode       = ^#DECL_Snode;
   #DECL_pRsnode      = ^#DECL_Rsnode;
   #DECL_Rsnode       = RECORD
                                sonnumber:#DECL_nodeid;
                                node    : #DECL_pSnode;
                                brother : #DECL_pRsnode
                             END;
   #DECL_Snode        = RECORD
                                sonlist : #DECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : #LANGSPEC_Category;
                                ldfield : #LANGSPEC_FieldDef
                             END;
   #DECL_pLostree     = ^#DECL_Lostree;
   #DECL_Lostree      = RECORD
                                next    : #DECL_pLostree;
                                arg     : #DECL_pSnode
                             END;
   #DECL_pConnectionnode
                           = ^#DECL_Connectionnode;
   #DECL_pSingleSegmList
                           = ^#DECL_SingleSegmList;
   #DECL_Connectionnode 
                           = RECORD
                                list    : #DECL_pSingleSegmList;
                                next,
                                prev    : #DECL_pConnectionnode;
                                idnr    : integer
                             END;
   #DECL_SingleSegmList
                           = RECORD
                                next    : #DECL_pSingleSegmlist;
                                rn      : #DECL_pConnectionnode;
                                stree   : #DECL_pSnode
                             END;
   #DECL_psurfgraph     = ^#DECL_surfgraphtype;
   #DECL_psurfgraphnode = ^#DECL_surfgraphnode;
   #DECL_surfgraphtype  = RECORD
   			          first,
   			          last: #DECL_psurfgraphnode
   		               END;
   #DECL_plossurfgraphnode 
                             = ^#DECL_lossurfgraphnode;
   #DECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : #DECL_plossurfgraphnode;
   			       END;
   #DECL_lossurfgraphnode 
                             = RECORD
   				   next :  #DECL_plossurfgraphnode;
   				   arg  :  #DECL_psurfgraphnode
   			       END;
   #DECL_surfgraphnode  = RECORD
      			          left,
   			          right: #DECL_psurfgraphnode;
   			          n    : #DECL_nodeid;
   			          cat  : #DECL_psyntcat;
   			          nextnodes: #DECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : #DECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

