 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE ldsubgrammars_TheCtrlExpr (sg: ldmrules_SubgrammarIndex;
                                           VAR ce: ldmrules_CtrlExpr);
EXTERNAL;

END {ldsubgrammars};
