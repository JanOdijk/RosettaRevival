pragma C_include('oldtree.pf');
pragma C_include('drawtree.pf');
pragma C_include('hiltree.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE DrawHILtree;
WITH OLDTREE, DRAWTREE, HILTREE;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : DrawHILtree_GenerateTree
 *  Description     : Prints the Hyper D-tree in a newly created window on the screen.
 *                    The user can walk through the tree by means of the cursor
 *                    keys. He furthermore can enlarge a node by hitting the 
 *                    "DO" key. Before returning control to the calling program
 *                    the window is closed.
 *                    Actually the set of Dtrees contained in the HyperDtree is
 *                    printed.
 *  Parameters      : OldNode: HyperDtree_pHyperDtree; The D-tree that is to be printed
 *  Precondition    : Oldnode contains a correct superD-tree
 *  Postcondition   : None
 *  Side Effects    : The D-tree is printed on the screen
 *
 *EMP:::===================================================================*)

PROCEDURE DrawHILtree_GenerateTree(OldNode : HILtree_pHyperILtree);
EXTERNAL;


END {DrawHILtree};
