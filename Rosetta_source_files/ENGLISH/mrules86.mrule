\begin{verbatim}
% RULE RPPPNpMod
< m1: PREPPPROP{PREPPPROPrec1}
               [ mu1, 
                 predrel/PREPP{PREPPrec1}[mu2] 
               ]

  m2: NP{NPrec1}[mu3] 
>

< m : PREPPPROP{PREPPPROPrec1}
               [ mu1, 
                 predrel/PREPP{PREPPrec1}
                        [ modrel/NP{NPrec2}[mu3],
                          mu2
                        ] 
               ]
>

      COMP
         <
          C1: unitnoun IN NPrec1.actsubcs AND
              NPrec1.superdeixis = presentdeixis AND
              NPrec1.generic = nogeneric
          A1: NPrec2 := NPrec1;
              NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: unitnoun IN NPrec1.actsubcs AND
              NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
          A1: NPrec1 := NPrec2;
              NPrec1.superdeixis := presentdeixis;
              NPrec1.generic := nogeneric;
         >
&

\end{verbatim}
