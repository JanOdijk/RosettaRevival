\newpage
\begin{verbatim}
% TRANSFORMATION TpppPattern1
< m1: I1::PREPPPROP{PREPPPROPrec1}
                  [ mu1,
                    predrel/I2::PREPP{PREPPrec1}
                           [ head/PREP{PREPrec1},
                             argrel/T1
                           ]
                  ]
>

< m : PREPPPROP{PREPPPROPrec2}
               [ mu1,
                 predrel/PREPP{PREPPrec2}
                        [ head/PREP{PREPrec1},
                          objrel/T1
                        ]
              ]
>

   MATCHCONDITIONS
      <
       I1: PREPPPROPrec1.synppefs = []
       I2: PREPPrec1.synppefs = []
      >

<
   SUBRULE (* 1. NPVAR, CNVAR: from the house *)
      < T1:T2 >
      < T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR,CNVAR]
      >

      COMP
         <
          C1: synNP IN PREPrec1.synpps 
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synNP];
              PREPPPROPrec2 := PREPPPROPrec1;
              PREPPPROPrec2.synppefs := [synNP];
         >
      DECOMP
         <
          C1:  synNP IN PREPrec1.synpps AND
               synNP IN PREPPrec2.synppefs AND
               synNP IN PREPPPROPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
              PREPPPROPrec1 := PREPPPROPrec2;
              PREPPPROPrec1.synppefs := [];
         >

   SUBRULE  (* 2. PREPPVAR: from behind the door;
                  ADVPVAR: till tomorrow  *)
      < T1:T2 >
      < T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [PREPPVAR, ADVPVAR]
      >

      COMP
         <
          C1: synLOCPREPP IN PREPrec1.synpps 
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synLOCPREPP];
              PREPPPROPrec2 := PREPPPROPrec1;
              PREPPPROPrec2.synppefs := [synLOCPREPP];
         >
      DECOMP
         <
          C1:  synLOCPREPP IN PREPrec1.synpps AND
               synLOCPREPP IN PREPPrec2.synppefs AND
               synLOCPREPP IN PREPPPROPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
              PREPPPROPrec1 := PREPPPROPrec2;
              PREPPPROPrec1.synppefs := [];
         >

>

&

\end{verbatim}
