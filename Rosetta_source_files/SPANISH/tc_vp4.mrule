                                   [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                     objrel/T2
                                   ]
                       ] 
              ]
>

(* Acusa al hombre de robo (vp123) *)
<
   SUBRULE (*1a*)
      <T2:NPVAR{NPVARrec1}>
