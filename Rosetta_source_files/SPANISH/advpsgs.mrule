\begin{verbatim}
% RULE RADVPPsubst1
< m1: ADVPFORMULA{ADVPFORMULArec1}
                 [mu1,
                  I1:rel1/I2::NPVAR{NPVARrec1},
                  mu2,
                  predrel/ADVP{ADVPrec3}[mu3],
                  mu4
                 ] 
SUBST:
  m2: T1=NP{NPrec1}[mu5]
>

< m : ADVPFORMULA{ADVPFORMULArec1}
                 [mu1,
                  I1:rel1/T2=NP{NPrec2}[mu6],
                  mu2,
                  predrel/ADVP{ADVPrec3}[mu3],
                  mu4
                 ] 

>

   MATCHCONDITIONS
      <m2: QUOTE_Gsubstordercondition(mu2, mu3, mu4)
       m : QUOTE_substordercondition(mu2, mu3, mu4)
       I2: NPVARrec1.index = LEVEL
       I1: rel1 IN [subjrel]
       
      >
   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:ADVPFORMULArec1.PROsubject =false AND
             NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
             NPrec1.cases = [] AND
             NPrec1.generic = nogeneric AND
             NPrec1.supertiempo = ADVPFORMULArec1.supertiempo
          A1: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases); 
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo := omegatiempo
         >

      DECOMP
         <
          C1: ADVPFORMULArec1.PROsubject =false AND
              NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: QUOTE_assigncase(NPrec2,mu6,NPrec1,mu5,[]); 
              NPrec1.supertiempo := ADVPFORMULArec1.supertiempo;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric
         >
&

\end{verbatim}
