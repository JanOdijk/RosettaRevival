\newpage
\begin{verbatim}
% TRANSFORMATION TPPpreppattern1
< m1: PREPP{PREPPrec1}
           [ head/PREP{PREPrec1},
             argrel/T1
           ]
>

< m : PREPP{PREPPrec2}
           [ head/PREP{PREPrec1},
             objrel/T1
           ]
>

<
   SUBRULE (* 1. NPVAR, CNVAR; under the house *)
      < T1:T2 >
      < T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR,CNVAR]
      >

      COMP
         <
          C1: synNP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synNP];
         >
      DECOMP
         <
          C1:  synNP IN PREPrec1.synpps AND
               synNP IN PREPPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
         >

   SUBRULE  (* 2. PREPPVAR: from before the war;
                  ADVPVAR: till tomorrow *)
      < T1:T2 >
      < T1:T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [PREPPVAR, ADVPVAR]
      >

      COMP
         <
          C1: synLOCPREPP IN PREPrec1.synpps AND
              PREPPrec1.synppefs = []  
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.synppefs := [synLOCPREPP];
         >
      DECOMP
         <
          C1:  synLOCPREPP IN PREPrec1.synpps AND
               synLOCPREPP IN PREPPrec2.synppefs 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.synppefs := [];
         >

>

&

\end{verbatim}
