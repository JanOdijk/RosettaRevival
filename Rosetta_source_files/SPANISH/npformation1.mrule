\begin{verbatim}
% RULE RNPformation13
< m1: I1::DEMPRO{DEMPROrec1}
>

< m : NP{NPrec1}[head/I1::DEMPRO{DEMPROrec1}]
>


   MATCHCONDITIONS

      <
       I1: DEMPROrec1.key = KEY_estoDEMPROkey    OR 
           DEMPROrec1.key = KEY_esoDEMPROkey     OR
           DEMPROrec1.key = KEY_aquelloDEMPROkey
       m: NPrec1 = { 
                      persona   : 3
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }
      >


      COMP
         <
          C1: true 

             C11: DEMPROrec1.key = KEY_estoDEMPROkey
             A11: NPrec1.NPhead    := esteNP;
             C12: DEMPROrec1.key = KEY_esoDEMPROkey
             A12: NPrec1.NPhead    := eseNP;
             C13: DEMPROrec1.key = KEY_aquelloDEMPROkey
             A13: NPrec1.NPhead    := aquelNP;

          A1: NPrec1.numero      := DEMPROrec1.numero;  (* singular *)
              NPrec1.definite    := def;
              NPrec1.genero      := DEMPROrec1.genero;  (* neutro *)
              NPrec1.actcomas    := [];
              NPrec1.posspred    := false;
              NPrec1.generic     := nogeneric;
              NPrec1.supertiempo := omegatiempo;
              NPrec1.specQ       := yesspec;
          >

       DECOMP
         <          
          C1: NPrec1 = 
              {numero      : DEMPROrec1.numero   (* singular *)
               definite    : def 
               genero      : DEMPROrec1.genero   (* neutro *)
               actcomas    : [] 
               posspred    : false 
               generic     : nogeneric 
               supertiempo : omegatiempo 
               specQ       : yesspec 
              }
             C11: DEMPROrec1.key = KEY_estoDEMPROkey AND
                  NPrec1.NPhead    = esteNP
             A11: @
             C12: DEMPROrec1.key = KEY_esoDEMPROkey AND
                  NPrec1.NPhead    = eseNP
             A12: @
             C13: DEMPROrec1.key = KEY_aquelloDEMPROkey AND
                  NPrec1.NPhead    = aquelNP
             A13: @
          A1:@

        >

&


\end{verbatim}
