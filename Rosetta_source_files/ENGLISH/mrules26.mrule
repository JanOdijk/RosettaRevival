\newpage
\begin{verbatim}
%
% FILTER FPreObjCaseAssign
< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       head/VERB{VERBrec1}[mu3],
                       mu4,
                       rel1/T2,
                       mu5 
                     ],
              mu6 
            ]

>

   MATCHCONDITIONS
      <
       m : rel1 IN [predrel, objrel, indobjrel] AND
           (T2.CAT IN [NPVAR, CNVAR, NP] WITH T2.REC.cases <> [])
           AND 
           NOT EXIST (mu1, [auxrel/I11::VERB{VERBrec2}[mu7]])
       I11: VERBrec2.subc = modalverb
      >


         <
          C1: true
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{verbatim}
% FILTER FPreSubjCaseAssign
< m : I3::CLAUSE{CLAUSErec1}
                [ mu1,
                  I2:subjrel/T2,
                  mu2 
                ]
>

   MATCHCONDITIONS
      <
       I2: T2.CAT IN [NPVAR, CNVAR, NP] WITH nominative IN T2.REC.cases 
       I3: CLAUSErec1.finiteness = finite
      >


         <
          C1: true
          A1: @
         >
&
\end{verbatim}
\newpage
\begin{verbatim}
% FILTER FPrePrepCaseAssign
<  m : CLAUSE{CLAUSErec1}
             [ mu1,
               predrel/VERBP{VERBPrec1}
                      [ mu2,
                        I4:rel1/N1
                               [ mu3,
                                 objrel/T2
                               ],
                        mu5 
                      ],
               mu6 
             ]
>

   MATCHCONDITIONS
      <
       m : T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
           AND 
           NOT EXIST (mu1, [auxrel/I11::VERB{VERBrec1}[mu7]])
       I11: VERBrec1.subc = modalverb
       I4: rel1 IN [prepobjrel, byobjrel] AND
           N1.CAT IN [PREPP, VARPREPP]
      >


         <
          C1: true
          A1: @
         >
&
\end{verbatim}
\newpage
\begin{verbatim}
% FILTER FPreExceptCaseAssign
< m : I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu5],
                           complrel/I2::SENTENCE{SENTENCErec1}[mu8],
                           mu6
                         ],
                  mu7
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.voice <> passive 
       I2: SENTENCErec1.PROsubject = false
       I3: VERBrec1.Caseassigner = true AND 
           VERBrec1.thetavp IN [vp120, vp123] 
      >

<
   SUBRULE  (* 1. the embedded subject has not been shifted *)
      < mu8: [I6:sig1, I5:subjrel/T2, mu9] >

   MATCHCONDITIONS
      <
       I5: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
           AND 
           NOT EXIST (mu1, [auxrel/I11::VERB{VERBrec2}[mu3]])
         I11: VERBrec2.subc = modalverb
       I6: ALL (sig1, shiftrel/..)
      >


         <
          C1: true
          A1: @
         >

   SUBRULE  (* 2. the embedded subject has been shifted *)
      < mu8: [I7:shiftrel/T2, I6:mu9] >

   MATCHCONDITIONS
      <
       I6: NOT EXIST (mu9, [subjrel/..])
       I7: T2.CAT IN [NPVAR, CNVAR, NP] WITH accusative IN T2.REC.cases 
           AND 
           NOT EXIST (mu1, [auxrel/I11::VERB{VERBrec2}[mu3]])
       I11: VERBrec2.subc = modalverb
      >


         <
          C1: true
          A1: @
         >
>

&
\end{verbatim}
