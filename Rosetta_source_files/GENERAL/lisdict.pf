(*MPD:::===================================================================*
 *
 *  Rosetta Project
 *
 *  Module Title    : LISDICT
 *  Creation date   :  7-JAN-1987
 *  Author          : Joep Rous
 *
 *  Copyright (c) 1986, by Nederlandse Philips Bedrijven BV.
 *
 *  Remarks         : Implementation of the abstract datatype SDICT.
 *                    The module provides I/O functions for accessing
 *                    ASDICT and GSDICT.
 *
 *EMP:::===================================================================*)

pragma C_include('cisam.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LISDICT;
WITH CISAM;

(*MPC:::===================================================================*
 *
 *  Constant name  : LISDICT_MaxContextKeys
 *  Description    : Maximum number of context keys in a SDICT entry
 *
 *EMP:::===================================================================*)
CONST
   LISDICT_MaxContextKeys = 1;


(*MPT:::===================================================================*
 *
 *  Type name      : LISDICT_RecordDef
 *  Description    : Type of and entry in SDICT.
 *
 *EMP:::===================================================================*)
TYPE
   LISDICT_RecordDef = RECORD
                          fkey : INTEGER;
                          skey : INTEGER;
                          nr   : 1..LISDICT_MaxContextKeys;
                          ctxt : ARRAY [1..LISDICT_MaxContextKeys] OF INTEGER
                       END;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISDICT_OpenSDICT
 *  Description     : Open SDICT for Read access
 *  Parameters      : none
 *  Precondition    : SDICT is not yet open
 *  Postcondition   : SDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISDICT_OpenSDICT;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LISDICT_GetASDICT
 *  Description    : 
 *  Parameters     : fkey     : INTEGER;
 *                   VAR rec  : LISDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   key
 *  Precondition   : SDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISDICT_GetASDICT(fkey     : INTEGER;
                                      VAR rec  : LISDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISDICT_GetNextASDICT
 *  Description    : 
 *  Parameters     : fkey     : INTEGER;
 *                   VAR rec  : LISDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   key
 *  Precondition   : SDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISDICT_GetNextASDICT(fkey     : INTEGER;
                                          VAR rec  : LISDICT_RecordDef)
                                          : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISDICT_GetGSDICT
 *  Description    : 
 *  Parameters     : skey     : INTEGER;
 *                   VAR rec  : LISDICT_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   key
 *  Precondition   : SDICT has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LISDICT_GetGSDICT(skey     : INTEGER;
                                      VAR rec  : LISDICT_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISDICT_Release
 *  Description     : Unlock SDICT 
 *  Parameters      : none
 *  Precondition    : SDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISDICT_Release;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISDICT_Reset
 *  Description     : Resets SDICT 
 *  Parameters      : none
 *  Precondition    : SDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISDICT_Reset;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LISDICT_CloseSdict
 *  Description     : Close SDICT 
 *  Parameters      : none
 *  Precondition    : SDICT is open
 *
 *EMP:::===================================================================*)

PROCEDURE LISDICT_CloseSDICT;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LISDICT_OpenSDICTWrite
 *  Description     : Opens SDICT dictionary for writing
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LISDICT_OpenSDICTWrite;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LISDICT_WriteSequential
 *  Description    : Writes the current record of the SDICT file
 *  Parameters     : VAR rec: LISDICT_RecordDef;
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LISDICT_WriteSequential(rec: LISDICT_RecordDef): INTEGER;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LISDICT_OpenSDICTUpdate
 *  Description     : Opens SDICT dictionary for shared updating
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LISDICT_OpenSDICTUpdate;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LISDICT_Update
 *  Description    : Updates the current record of the SDICT file
 *  Parameters     : rec: LISDICT_RecordDef;
 *  Result         : VMSRMS_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LISDICT_Update(rec: LISDICT_RecordDef): CISAM_StatusType;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LISDICT_Delete
 *  Description    : Deletes the current record from the SDICT file
 *  Parameters     : rec: LISDICT_RecordDef;
 *  Result         : VMSRMS_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LISDICT_Delete: CISAM_StatusType;
EXTERNAL;

END {LISDICT};
