ENGLISH 1

%SUBGRAMMAR Verbderivation

RBVERBTOSUB/1

HEAD:
<
BVERB    BASIC EXPRESSION
>

<(* no import *)>

EXPORT:
< SUBVERB >

&
% RULE ErrorRule (* this rule is never applicable, and is translated in during
                    transfer if the M-rule mentioned in the transferrules does
                    not exist. It should remain the first rule in MRULES"1".
                    It may safely be removed, if it is no longer useful *)
< m1:T1
>
< m:T1
>
COMP <C1:T1.cat<>T1.cat
      A1:@
     >
DECOMP <C1:T1.cat<>T1.cat
        A1:@
       >
&

\newpage
\begin{verbatim}
% RULE RNNcompounds
< m1:CN{CNrec1}[head/NOUN{NOUNrec1}[mu1]] 
  m2:CN{CNrec2}[head/NOUN{NOUNrec2}[mu2]] 
>

< m :CN{CNrec1}
      [head/NOUN{NOUNrec3}
          [ modrel/NOUN{NOUNrec2}[mu2],
            head/NOUN{NOUNrec1}[mu1] 
          ] 
      ]
>
                      

      COMP
         <
          C1: CNrec2 =
               {
                req:               [pospol, negpol, omegapol]
                env:               [pospol, negpol, omegapol]
                superdeixis:       CNrec1.superdeixis
                    
                class:             NOUNrec2.class
                deixis:            NOUNrec2.deixis
                aspect:            NOUNrec2.aspect
                retro:             NOUNrec2.retro

                definite:          omegadef   
                numbers:           NOUNrec2.numbers
                cases:             []           
                genders:           NOUNrec2.genders
                sexes:             NOUNrec2.sexes
                temporal:          NOUNrec2.temporal
                poss:              NOUNrec2.poss
                animate:           NOUNrec2.animate
                human:             NOUNrec2.human
                thetanp:           NOUNrec2.thetanp
               }                                                      AND
                CNrec2.actsubcs * NOUNrec2.subcs <> []                AND
                CNrec2.posscomas * NOUNrec2.posscomas <> []           AND
                ((CNrec2.nounpatternefs * NOUNrec2.nounpatterns <> []) OR
                 (CNrec2.nounpatternefs = NOUNrec2.nounpatterns)
                )
          A1: NOUNrec3 := NOUNrec1;
         >
      DECOMP
         <
          C1: NOUNrec3 = NOUNrec1
          A1: CNrec2 :=
               {
                req:               [pospol, negpol, omegapol]
                env:               [pospol, negpol, omegapol]
                superdeixis:       CNrec1.superdeixis
                    
                class:             NOUNrec2.class
                deixis:            NOUNrec2.deixis
                aspect:            NOUNrec2.aspect
                retro:             NOUNrec2.retro

                definite:          omegadef   
                numbers:           NOUNrec2.numbers
                cases:             [Nominative]           
                genders:           NOUNrec2.genders
                sexes:             NOUNrec2.sexes
                temporal:          NOUNrec2.temporal
                poss:              NOUNrec2.poss
                animate:           NOUNrec2.animate
                human:             NOUNrec2.human
                thetanp:           NOUNrec2.thetanp
               };
              CNrec2.actsubcs := NOUNrec2.subcs;
              CNrec2.posscomas :=  NOUNrec2.posscomas;
              CNrec2.nounpatternefs := NOUNrec2.nounpatterns;
         >


&

\end{verbatim}
