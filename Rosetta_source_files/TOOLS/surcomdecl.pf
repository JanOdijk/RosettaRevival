 *EMP:::===================================================================*)

 FUNCTION SURCOMDECL_surfgraph(i:INTEGER):SURCOMDECL_psurfgraph; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : SURCOMDECL_assignsurfgraph
 *  Description    : 
 *  Parameters     : o<i<=maxrnr
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : valeu of surfgraph(i) is 'valeu'
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

  PROCEDURE SURCOMDECL_assignsurfgraph(i:INTEGER;valeu:SURCOMDECL_psurfgraph); EXTERNAL;

