\begin{verbatim}

%
% RULE Radjppconjsvar
< m1: ADJPPROP{ADJPPROPrec1}
                [ mu1,
                  predrel/ADJP{ADJPrec1}[I2:mu2],                  
                  mu3 
                ]

  m2: I1::SENTENCEVAR{SENTENCEVARrec1}                 
>

< m :ADJPPROP{ADJPPROPrec1}
                [ mu1,
                  predrel/ADJP{ADJPrec1}
                              [ I2:mu2,
                                postsentadvrel/I1::SENTENCEVAR{SENTENCEVARrec1}
                              ],
                  mu3
                ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCEVARrec1.adverbial =true
       I2: NOT EXIST(mu2, [postsentadvrel/..])
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
