/* select: semi idioms window */

object le_sid_window : XmFormDialog {
  arguments {
    arguments form_dialog_args;
    XmNdialogTitle    = 'Semi Idiom';
    XmNdialogStyle          = XmDIALOG_FULL_APPLICATION_MODAL; 
/*    XmNmenuBar    = XmMenuBar le_sid_menubar; */
    XmNnoResize  = true;
  };
  controls {
    XmMenuBar   le_sid_menubar;
    XmRowColumn le_sid_argument;
    XmRowColumn le_sid_number;
    XmRowColumn le_sid_skey;
    XmRowColumn le_sid_mkey;
    XmRowColumn le_sid_comments;
/*    XmSeparator le_sid_separator; */
    XmRowColumn le_sid_button_box;
    XmLabel     le_sid_deleted;
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_sid_window + 
               DEFAULT_BUTTON_OFFSET*X_le_sid_ok_button);
  };
};

object le_sid_menubar : XmMenuBar {
  arguments {
    XmNtopAttachment  = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNmenuHelpWidget = XmCascadeButton le_sid_help_menu; 
    XmNspacing    = 30;
  };
  controls {
    XmCascadeButton le_sid_edit_menu;
    XmCascadeButton le_sid_options_menu;
    XmCascadeButton le_sid_help_menu; 
  };
};

object le_sid_edit_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Edit';
    XmNsensitive   = true;
  };
  controls {
    XmPulldownMenu {
      controls {
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Modify';
          };
          controls {
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Argument';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_sid_modify_argument_button);
                    XmNactivateCallback = procedure
              XwbAction (X_le_sid_modify_argument_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Number';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_sid_modify_number_button);
                    XmNactivateCallback = procedure
              XwbAction (X_le_sid_modify_number_button);
                  };
                };
                XmCascadeButton {
                  arguments {
                    arguments cascade_args;
                    XmNsensitive   = true;
                    XmNlabelString = 'Meaning';
                  };
                  controls {
                    XmPulldownMenu {
                      controls {
                        XmPushButton {
                          arguments {
                            arguments cascade_args;
                            XmNlabelString = 'New meaning';
                          };
                          callbacks {
                            MrmNcreateCallback = procedure
                      XwuCreateWidget (X_le_sid_new_meaning_button);
                            XmNactivateCallback = procedure
                      XwbAction (X_le_sid_new_meaning_button);
                          };
                        };
                        XmCascadeButton {
                          arguments {
                            arguments cascade_args;
                            XmNsensitive   = true;
                            XmNlabelString = 'Existing meaning';
                          };
                          controls {
                            XmPulldownMenu {
                              controls {
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'Dutch';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_sid_dutch_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_sid_dutch_meaning_button);
                                  };
                                };
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'English';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_sid_english_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_sid_english_meaning_button);
                                  };
                                };
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'Spanish';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_sid_spanish_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_sid_spanish_meaning_button);
                                  };
                                };
                              };
                            };
                          };
                        };
                      };
                    };
                  };
                };
              };
            };
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Delete Idiom';
          };
          callbacks {
            MrmNcreateCallback = procedure
      XwuCreateWidget (X_le_sid_delete_sid_button);
            XmNactivateCallback = procedure
      XwbAction (X_le_sid_delete_sid_button);
          };
        };
      };
    };
  };
};

object le_sid_options_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Options';
    XmNsensitive   = true;
  };
  controls {
    XmPulldownMenu {
      controls {
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Translate';
          };
          controls {
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Dutch';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_sid_translate_dutch_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_sid_translate_dutch_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'English';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_sid_translate_english_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_sid_translate_english_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Spanish';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_sid_translate_spanish_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_sid_translate_spanish_button);
                  };
                };
              };
            };
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Show Argument';
          };
          callbacks {
            MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_sid_show_argument_button);
            XmNactivateCallback = procedure
              XwbAction (X_le_sid_show_argument_button);
          };
        };
      };
    };
  };
};

object le_sid_help_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Help';
    XmNsensitive   = true;
  };
  callbacks {
    MrmNcreateCallback = procedure
             XwuCreateWidget (X_le_sid_help_button);
    XmNactivateCallback = procedure XwhAction (X_le_sid_help_button);
  };
};

object le_sid_argument: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmMenuBar le_sid_menubar;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Argument: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 75;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_sid_argument);
      };
    };
  };
};

object le_sid_number: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_sid_argument;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Number: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 75;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_sid_argnr);
      };
    };
  };
};

object le_sid_skey: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_sid_number;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Skey: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 75;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_sid_skey);
      };
    };
  };
};

object le_sid_mkey: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_sid_skey;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Mkey: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 75;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_sid_mkey);
      };
    };
  };
};

object le_sid_comments : XmRowColumn {
  arguments {
    XmNtopAttachment   = XmATTACH_WIDGET;
    XmNtopWidget       = XmRowColumn le_sid_mkey;
    XmNleftAttachment  = XmATTACH_FORM;
    XmNrightAttachment = XmATTACH_FORM;
    XmNorientation     = XmVERTICAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Comments: ';
      };
    };
    XmScrolledText {
      arguments {
        arguments text_args;
        XmNeditMode     = XmMULTI_LINE_EDIT;
        XmNscrollHorizontal = false;
        XmNcolumns      = 80;
        XmNrows       = 3;
/*        XmNsensitive       = false;  becomes always insensitive! */
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget 
                    (X_le_sid_comments);
      };
    };
  };
};
/*
object le_sid_separator : XmSeparator {
  arguments {
    XmNleftAttachment  = XmATTACH_FORM;
    XmNrightAttachment   = XmATTACH_FORM;
    XmNtopAttachment   = XmATTACH_WIDGET;
    XmNtopWidget     = XmRowColumn le_sid_comments;

    XmNleftOffset    = 0;
    XmNrightOffset     = 0;
    XmNmargin      = 0;
  };
};
*/
object le_sid_button_box : XmRowColumn {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_sid_comments;
    XmNbottomAttachment = XmATTACH_FORM; 
    XmNleftAttachment   = XmATTACH_FORM;
/*    XmNrightAttachment  = XmATTACH_FORM; */

    arguments button_box_args;
    XmNorientation    = XmHORIZONTAL;
  };
  controls {
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'OK';
      };
      callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_le_sid_ok_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_sid_ok_button);
      };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Cancel';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_sid_cancel_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_sid_cancel_button);
         };
    };
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Select';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_sid_select_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_sid_select_button);
         };
    };
/*
    XmPushButton {
      arguments {
        arguments button_args;
        XmNlabelString    = 'Help';
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_le_sid_help_button);
        XmNactivateCallback = procedure 
          XwbAction (X_le_sid_help_button);
         };
    };
*/
  };
};

object le_sid_deleted: XmLabel {
  arguments {
    XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmRowColumn le_sid_comments;
    XmNbottomAttachment = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_WIDGET;
    XmNleftWidget        = XmRowColumn le_sid_button_box;
    XmNrightAttachment  = XmATTACH_FORM; 
    arguments label_args;
    XmNfontList     = bigbold; 
    XmNlabelString  = '';
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget
           (X_le_sid_deleted);
  };
};
