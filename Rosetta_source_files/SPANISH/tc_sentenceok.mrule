                     (VERBrec4.synvps = [synNP]))    OR
                    ((VERBrec4.thetavp = vp012)       AND
                     (VERBrec4.synvps = [synANP_DONP])))
              A11: NPrec1 := COPYT_PERSPROtoNP(PERSPROrec1); 
                   NPrec1.cases := [Nominative]

              C12: (PERSPROrec1.forma = Acuscl)             AND
                   ((VERBrec4.thetavp IN [vp100, vp010])   OR
                    ((VERBrec4.thetavp = vp120)         AND
                     (VERBrec4.synvps * [synNP] = []))    OR
                    ((VERBrec4.thetavp = vp012)     AND
                     (VERBrec4.synvps * [synANP_DONP] = [])))
              A12: NPrec1 := COPYT_PERSPROtoNP(PERSPROrec1); 
                   NPrec1.cases := [Nominative]
 
          A1: @
         >
   

