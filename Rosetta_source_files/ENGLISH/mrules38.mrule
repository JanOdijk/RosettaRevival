\newpage
\begin{verbatim}
% RULE Raspecthabitual
< m1:CLAUSE{CLAUSErec1}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5,
            tempadvrel/T1,
            mu6
           ] 
>

< m :CLAUSE{CLAUSErec2}
           [mu1,
            predrel/VERBP{VERBPrec1}
                   [mu2,
                    rel1/VERB{VERBrec1}[mu3],
                    mu4
                   ],
            I1: mu5,
            tempadvrel/T1,
            mu6
            ]
>
   MATCHCONDITIONS
      <
        I1: QUOTE_tempfreqnotfound(mu5)
      >
<

   SUBRULE
      <T1: I2:: ADVPVAR{ADVPVARrec1}[mu7] >
      <T1: I2:: ADVPVAR{ADVPVARrec1}[mu7] >

   MATCHCONDITIONS
      <
       I2: ADVPVARrec1.class = frequential
      >
    
      COMP
         <
          C1: (CLAUSErec1.aspect = omegaaspect) 
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aspect := habitual;
         >

      DECOMP
         <
          C1: (CLAUSErec2.aspect = habitual) 
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.aspect := omegaaspect;
         >

   SUBRULE
      <T1: I2:: NPVAR{NPVARrec1}[mu7]>
      <T1: I2:: NPVAR{NPVARrec1}[mu7]>

   MATCHCONDITIONS
      <
       I2: NPVARrec1.class = frequential
      >

      COMP
         <
          C1: (CLAUSErec1.aspect = omegaaspect) 
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.aspect := habitual;
         >

      DECOMP
         <
          C1: (CLAUSErec2.aspect = habitual) 
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.aspect := omegaaspect;
         >


>
&

\end{verbatim}


