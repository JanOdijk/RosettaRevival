pragma C_include('listree.pf');

PACKAGE GENLEXIF;
WITH listree;
(*MPT:::===================================================================*
 *
 *  Type name      : GENLEXIF_lexruletype
 *  Description    : type of rule numbers
 *
 *EMP:::===================================================================*)

TYPE
   GENLEXIF_lexruletype = INTEGER;

TYPE
   GENLEXIF_pLosRule = ^GENLEXIF_losRule ;

   GENLEXIF_losRule = RECORD
                       arg:GENLEXIF_lexruletype;
                       next:GENLEXIF_pLosRule
                      END;

(*MPT:::===================================================================*
 *
 *  Type name      : GENLEXIF_setofRules
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   GENLEXIF_setofRules = RECORD
                          first,last:GENLEXIF_pLosRule
                         END;

(*MPF:::===================================================================*
 *
 *  Function Name  : GENLEXIF_maxlexrulenr
 *  Description    : gives the total number of lextree rules
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION GENLEXIF_maxlexrulenr
                    : INTEGER;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : GENLEXIF_stillRules
 *  Description    : tests wether setofRules is empty
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : is true iff setorRules is not empty
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION GENLEXIF_stillRules(setofRules:GENLEXIF_setofRules)
                    : boolean;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure name : GENLEXIF_takeRule
 *  Description    : takes rule out of setofRules
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 0 < rule < GENLEXIF_maxlexrulenr iff setofRules not empty
 *                   else rule=0
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 PROCEDURE GENLEXIF_takeRule(VAR rule:GENLEXIF_lexruletype;
                                      VAR setofRules:GENLEXIF_setofRules);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : GENLEXIF_init
 *  Description     : initializes the module GENLEXIF. This procedure should
 *                    be called before invoking GENLEXIF_switch or -lexrule.
 *  Parameters      : 
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 PROCEDURE GENLEXIF_init;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : GENLEXIF_switch
 *  Description    : gives a set of rule numbers corresponding to rules that are
 *                   possibly applicable to t
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION GENLEXIF_switch(t:LISTREE_pstree)
                    : GENLEXIF_setofRules;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Function Name  : GENLEXIF_lexrule
 *  Description    : gives the set of stree tuples yielded by rule 'L' with
 *                   input t
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 FUNCTION GENLEXIF_lexrule(L:GENLEXIF_lexruletype;t:LISTREE_pstree)
                    : LISTREE_setoftupleofstrees;
EXTERNAL;

END {GENLEXIF};
