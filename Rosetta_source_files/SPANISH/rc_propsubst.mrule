\newpage
\begin{verbatim}
% RULE ROPENADVPPROPsubstitution
< m1:VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ mu2,
                         rel1/ADVPPROPVAR{ADVPPROPVARrec1},
                         mu3 
                       ],
                mu7
              ] 

SUBST:
  m2: OPENADVPPROP{OPENADVPPROPrec1}[ mu4 ]         (* substituent *)
>

< m :VERBPPROP{VERBPPROPrec1}
              [ mu1,
                predrel/VERBP{VERBPrec1}
                       [ mu2,
                         rel1/OPENADVPPROP{OPENADVPPROPrec1}[mu4],
                         mu3 
                       ],
                mu7
              ] 
>

      PARAMETERS
         <
          LEVEL
         >


      COMP
         <
          C1:  ( ADVPPROPVARrec1.index = LEVEL ) AND
	       ADVPPROPVARrec1 = 
                    COPYT_ADVPPROPtoVAR(OPENADVPPROPrec1) 
               C11: rel1 = locargrel AND
                    (locadv IN OPENADVPPROPrec1.actsubcefs )
               A11: @
               C12: rel1 = dirargrel AND
                    (diradv IN OPENADVPPROPrec1.actsubcefs )
               A12: @
               C13: rel1 = complrel AND
                    (vpadv IN OPENADVPPROPrec1.actsubcefs )
               A13: @
          A1: @
         >

      DECOMP
         <
          C1: true
	       C11: rel1 = locargrel AND
                    (locadv IN OPENADVPPROPrec1.actsubcefs )
	       A11: @
               C12: rel1 = dirargrel AND
                    (diradv IN OPENADVPPROPrec1.actsubcefs )
               A12: @
               C13: rel1 = complrel AND
                    (vpadv IN OPENADVPPROPrec1.actsubcefs )
               A13: @
          A1: ADVPPROPVARrec1 := 
                    COPYT_ADVPPROPtoVAR(OPENADVPPROPrec1) ;
              ADVPPROPVARrec1.index := LEVEL;
         >
&

\end{verbatim}
