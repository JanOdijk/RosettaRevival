\begin{description}
\item[* name:] RSIDSTARTVPPROP123
\item[* relevant examples:] x1 geven demonstratie (aan) x2, Marie geeft een 
demonstratie aan Piet
\item[* language:]  Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] RC:Startverbprules
\item[* date of creation:] 04-AUG-1988 13:25:00  
\item[* author:] Andre\'{e} Schenk
\item[* copied from:Dutch:rsidstartvpprop123]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Combines a SUBVERB with its required number of arguments and 
puts one of them in subject position and two inside the VERBP; the head of the 
first argument NP in VERBP is specified; this is a part of a semi-idiom.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of 
parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] Function-application and "thematic role" .
assignment.
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ Attribute thetavp with BVERBs.

\item rules:\\ This is the first rule-class.

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{} The number of arguments should remain 
the same.
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc. nr. 269 (Semi-Idioms and the 
Dictionary)
\item[\ \ remarks:]\mbox{} In this rule the subverbrecords are copied from each 
other analytically and generatively; another way is to change the bverb first
(i.e. attributes values are the same except for the key) and then copy the
subverb from the bverb. If dictionary structure changes: keep this in
account!!! 
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}


%RULE RSTARTVPPROP000

<m1: I3::SUBVERB{SUBVERBrec1}[mu1]
>
<m: I1::VERBPPROP{VERBPPROPrec1}
           [ subjrel/NP{NPrec1}
                    [ head/PERSPRO{PERSPROrec1}
                          [ head/BPERSPRO(AUX_redellobpersprokey){BPERSPROrec1}]
                    ], 
             predrel/VERBP{VERBPrec1}
                    [ head/I2::VERB{VERBrec1}
                          [ head/I3::SUBVERB{SUBVERBrec1}[mu1]]
                    ]
           ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1 = 
		  { 
                   thetavp     : vp000
		   req         : [pospol, negpol, omegapol]
		   env         : [pospol, negpol, omegapol]
		   supertiempo : omegatiempo
		   PROsubject  : false
		   voice       : omegavoice
		   synvpefs    : []
		   aktionsarts : [] 
		  }
       I2: VERBrec1 =
		  {
		   numero       : omeganumero  
		   persona      : 3
                   genero       : omegagenero
		   modo         : omegamodo
		   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
		   status       : bareV
                   foundauxes   : []
		  }
       
       I3: SUBVERBrec1.thetavp = vp000
      >


  COMP
   <
    C1: true
    A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);
        PERSPROrec1.forma := Nomdebil;

        NPrec1 := AUX_NPONredelloBPRSPR;
        VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
        VERBPPROPrec1.thetavp := vp000
   >
&

\end{verbatim}
