\newpage
\begin{verbatim}
% RULE RppSubstitution1
< m1: PREPP{PREPPrec1}
           [ mu1,
             head/PREP(KEY1){PREPrec1}[mu4],
             mu2,
             objrel/I1::NPVAR{NPVARrec1},
             mu3 
           ]
  SUBST:
  m2: NP{NPrec1}[mu5]
>

< m : PREPP{PREPPrec1}
           [ mu1,
             head/PREP(KEY1){PREPrec1}[mu4],
             mu2,
             objrel/NP{NPrec2}[mu6],
             mu3 
           ]
>


   MATCHCONDITIONS
      <
       I1: NPVARrec1.index = LEVEL
       m2: [temp] * PREPPrec1.actsubcefs = []
           OR NPrec1.NPhead IN [thisNP, thatNP, itNP] (* JO *)
           OR
           ([temp] * PREPPrec1.actsubcefs <> [] AND
            KEY1 <> KEY_'s_prep1274710' (* for -- 'lang' *) AND
            KEY1 <> KEY_'s_prep1274810' (* for -- 'al' *) AND
            NPrec1.temporal = true AND
            PREPPrec1.class <> duration
           )
           OR
           ([temp] * PREPPrec1.actsubcefs <> [] AND
            (KEY1 = KEY_'s_prep1274710' (* for -- 'lang' *) OR
             KEY1 = KEY_'s_prep1274810' (* for -- 'al' *) OR
             PREPPrec1.class = duration
            ) AND
            NPrec1.temporal = true AND
            ((NPrec1.definite = indef AND
              NPrec1.actsubcs * [unitnoun] <> []
             )
             OR
             (EXIST(mu5, [head/CN{CNrec1}[mu7,
                                          modrel/ADJP{ADJPrec1}
                                                [mu11,
                                                 I4:head/ADJ{ADJrec1}[mu13],
                                                 mu12
                                                ], 
                                           mu8
                                          ]
                          ]
                    )
             )
            )
           )

       m: [temp] * PREPPrec1.actsubcefs = []
           OR NPrec2.NPhead IN [thisNP, thatNP, itNP] (* JO *)
           OR
           ([temp] * PREPPrec1.actsubcefs <> [] AND
            KEY1 <> KEY_'s_prep1274710' (* for -- 'lang' *) AND
            KEY1 <> KEY_'s_prep1274810' (* for -- 'al' *)
           )
           OR
           ([temp] * PREPPrec1.actsubcefs <> [] AND
            (KEY1 = KEY_'s_prep1274710' (* for -- 'lang' *) OR
             KEY1 = KEY_'s_prep1274810' (* for -- 'al' *)
            ) AND
            NPrec2.temporal = true AND
            ((NPrec2.definite = indef AND
              NPrec2.actsubcs * [unitnoun] <> []
             )
             OR
             (EXIST(mu6, [head/CN{CNrec1}[mu7,
                                          modrel/ADJP{ADJPrec1}
                                                [mu11,
                                                 I4:head/ADJ{ADJrec1}[mu13],
                                                 mu12
                                                ], 
                                           mu8
                                          ]
                          ]
                    )
             )
            )
           )

       I4: measureadj IN ADJrec1.subcs

      >
       

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPrec1.generic = nogeneric AND
              NPVARrec1 = COPYT_nptovar(NPrec1) 
                           EXCEPT FOR [cases] AND
              NPrec1.cases = [] AND
              NPrec1.superdeixis = PREPPrec1.superdeixis
          A1: QUOTE_assigncase(NPrec1, mu5, NPrec2, mu6, NPVARrec1.cases);
              NPrec2.generic := omegageneric;
              NPrec2.superdeixis := omegadeixis;
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric  AND
              NPrec2.superdeixis = omegadeixis
          A1: QUOTE_assigncase(NPrec2, mu6, NPrec1, mu5, []);
              NPrec1.generic := nogeneric;
              NPrec1.superdeixis := PREPPrec1.superdeixis;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              NPVARrec1.generic := nogeneric;
         >

&

\end{verbatim}
