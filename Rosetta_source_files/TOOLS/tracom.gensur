
%UTT
BASIS RULE
  UTT = LANGVERSION/1.[PARAMETERSTRANS/2].RULESTRANS/3

SURFACE PART
HELP function initfun:BOOLEAN;
BEGIN
initfun:=TRUE;
assigncounter(0)
END;

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:initfun
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_UTT;
                END
*>
END;

PROCEDURAL PART
VAR pairsets::setofpairsets; 
    pairset::pairset;
    pairs::setofpairs;
    idents::setofidents;
    ident::ident;
    pair::pair;
    intequals:LOCALFILE;
BEGIN 
INIT:BEGIN 
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
                 TFILES_open(of1,'anofpas',7,3);
                 BEGIN
                   \of1.\GLOBAL.\\
"EXPORT(LDANILRULES);"\\
"pragma C_include('lsparams.pf');"\\
"pragma C_include('lsdomaint.pf');"\\
"pragma C_include('ldanilrules.pf');"\\
"pragma C_include('hiltree.pf');"\\
"pragma C_include('liilrules.pf');"\\
"pragma C_include('ldmrules.pf');"\\
                   "PROGRAM LDANILRULES;"\\\\
"WITH lsparams,lsdomaint,"
"hiltree,liilrules,ldmrules;"\\
                   " FUNCTION LDAnIlrules_RuleTransFer("\\
                   " R:LDMrules_Ruleindex;ps:LDMrules_LiParameters):"\\
                   " HILtree_SetOfHyperNodeElt;"\\
                   " VAR resultelt:HILTREE_HyperNodeElt;"\\
                   " p:HILTREE_pHyperNodeElt;"\\
                   " result,result1,result2,helpresult1:HILTREE_SetOfHyperNodeElt;"\\
                   " lsps:LSPARAMS_precord;"\\
                   " lips:LIILRULES_ilparams;"\\
                   " X1,X2,X3:INTEGER;"\\
                 END;
                 TFILES_open(of2,'genofpas',8,3);
                 BEGIN
                   \of2.\GLOBAL.\\
"EXPORT(LDGENILRULES);"\\
"pragma C_include('lsparams.pf');"\\
"pragma C_include('lsdomaint.pf');"\\
"pragma C_include('ldgenilrules.pf');"\\
"pragma C_include('hiltree.pf');"\\
"pragma C_include('liilrules.pf');"\\
"pragma C_include('ldmrules.pf');"\\
"pragma C_include('hyperdtree.pf');"\\
"pragma C_include('mem.pf');"\\
                   "PROGRAM LDGENILRULES;"\\\\
"WITH lsparams,lsdomaint,"
"hiltree,liilrules,ldmrules,hyperdtree,mem;"\\
                   " FUNCTION LDGenIlrules_RuleTransFer("\\
                   " R:LIILrules_Ruleindex;ps:LIILrules_LiParameters):"\\
                   " HyperDtree_SetOfHNECluster;"\\
                   " VAR resultelt:HYPERDTREE_HyperNodeElt;"\\
                   " p:HYPERDTREE_pHyperNodeElt;"\\
                   " result:HYPERDTREE_setofHNECluster;"\\
                   " result1,result2,helpresult1:HYPERDTREE_SetOfHyperNodeElt;"\\
                   " lsps,lsps1:LSPARAMS_precord;"\\
                   " X1,X2,X3:INTEGER;"\\
                 END;
               END
   *>
2: <* SEND: BEGIN pairsets:=%PARAMETERSTRANS.pairsets END
      !PARAMETERSTRANS.
      RECEIVE: BEGIN
               END
   *>
3: <* SEND: BEGIN \of1.\GLOBAL.
"procedure appendresults(result1:HILTREE_SetOfHyperNodeElt;"\\
"            VAR result:HILTREE_SetOfHyperNodeElt);"\\
"VAR node:HILTREE_pHypernodeelt;listrec:HILTREE_LoHyperIltree;"\\
"BEGIN"\\
"IF HILTREE_Isemptynode(result) THEN result:=result1 ELSE BEGIN"\\
"WHILE NOT HILTREE_Isemptynode(result1) DO"\\
" BEGIN"\\
" HILTREE_Takefromnode(node,result1);"\\
" HILTREE_Addtonode(node,result);"\\
" END;"\\
"END;"\\
"END;"\\

{also:
"IF NOT(HILTREE_Isemptynode(result1)) THEN BEGIN"\\
"HILtree_LoadLoHyperILtree(result.last,listrec);"\\
"listrec.next:=result1.first;"\\
"HILtree_StoreLoHyperILtree(result.last,listrec);"\\
"result.last:=result1.last END END;"\\}
                  \of2.\GLOBAL.
"procedure appendresults(sg:INTEGER;result1:HYPERDTREE_SetOfHyperNodeElt;"\\
"            VAR result:HYPERDTREE_SetOfHNECluster);"\\
"VAR helpset1,helpset2:HYPERDTREE_SetOfHNECluster;"\\
"    cluster:HYPERDTREE_setofhypernodeelt;"\\
"    found:BOOLEAN;"\\
"procedure appendresults(result1:HYPERDTREE_SetOfHyperNodeElt;"\\
"            VAR result:HYPERDTREE_SetOfHyperNodeElt);"\\
"VAR node:HYPERDTREE_pHypernodeelt;"\\
"BEGIN"\\
"IF HYPERDTREE_Isemptynode(result) THEN result:=result1 ELSE BEGIN"\\
"IF NOT(HYPERDTREE_Isemptynode(result1)) THEN BEGIN"\\
"result.last^.next:=result1.first;"\\
"result.last:=result1.last END END;"\\
{also:
"WHILE NOT HYPERDTREE_Isemptynode(result1) DO"\\
" BEGIN"\\
" HYPERDTREE_Takefromnode(node,result1);"\\
" HYPERDTREE_Addtonode(node,result);"\\
" END;"\\}
"END;"\\
"BEGIN"\\
"helpset1:=result;"\\
"found:=FALSE;"\\
"WHILE NOT(HYPERDTREE_isemptyclusterset(helpset1)) AND NOT(found) DO"\\
" BEGIN"\\
" helpset2:=helpset1;"\\
" HYPERDTREE_takeCluster(cluster,helpset1);"\\
" IF cluster.sg=sg THEN"\\
"   BEGIN"\\
"   found:=TRUE;"\\
"   appendresults(result1,helpset2.first^.elts);"\\
"   END;"\\
" END;"\\
"IF NOT found THEN"\\
"  BEGIN"\\
"  cluster:=result1;"\\
"  cluster.sg:=sg;"\\
"  HYPERDTREE_Addcluster(cluster,result)"\\
"  END;"\\
"END;"\\
            %%RULESTRANS.pairsets:=pairsets;
            END
      !RULESTRANS.
      RECEIVE: BEGIN intequals:=%%RULESTRANS.intequals;
                     appendfile(intequals,of1);
                     appendfile(%%RULESTRANS.intequals,of2);
                  \of1.\GLOBAL.
                   "BEGIN"\\
                   "resultelt.nodeKind := Hiltree_RuleNode;"\\
                   "HILTREE_EmptyNode(result);"\\
                   "HILTREE_EmptyNode(result1);"\\
                  \of2.\GLOBAL.
                   "BEGIN"\\
                   "resultelt.nodeKind := HyperDtree_RuleNode;"\\
                   "HYPERDTREE_EmptyClusterSet(result);"\\
                   "HYPERDTREE_EmptyNode(result1);"\\
                     appendfile(%%RULESTRANS.anfile,of1);
                     appendfile(%%RULESTRANS.genfile,of2);
               END
   *>
*>
FINAL: BEGIN \of1.\GLOBAL.
                    "LDANILRULES_RuleTransfer:=result;"\\
                    "END;"\\ 
             \of2.\GLOBAL.
                    "LDGENILRULES_RuleTransfer:=result;"\\
                    "END;"\\ 
             TFILES_close(of1);
             TFILES_close(of2);
       END
END;
&

%PARAMETERSTRANS
BASIS RULE
  PARAMETERSTRANS = PARAMETER/1.TRANSLATION/1.LEFTARROW/1.{PARAMETERTRANS/2}.RIGHTARROW/1

SURFACE PART
VAR pairsets::setofpairsets;

<*
 INIT:BEGIN initsetofpairsets(pairsets);
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN appendpairset(%PARAMETERTRANS.pairset,pairsets);
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_PARAMETERSTRANS;
                  $PARAMETERSTRANS.pairsets:=pairsets;
                END
*>
END;

PROCEDURAL PART
VAR  
BEGIN
INIT: BEGIN
      END;
<*
1: <* SEND: BEGIN
            END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !PARAMETERTRANS.
      RECEIVE: BEGIN
               END
   *>
*>
FINAL:BEGIN 
      END
END;
&

%PARAMETERTRANS
BASIS RULE
  PARAMETERTRANS = PARAMNAME/2.COLON/1.TYPENAME/7.LEFTARROW/4
                   .DASH/1.RIGHTARROW/5.PARAMNAME/3.COLON/1.TYPENAME/8
                   .EQUIVALENT/1.
                   ROUNDOPEN/1.ELEMENTTRANS/6.{COMMA/1.ELEMENTTRANS/6}.ROUNDCLOSE/1
SURFACE PART
VAR leftpresent,rightpresent::bool;
    pairset::pairset;

<*
 INIT:BEGIN leftpresent:=false;rightpresent:=false;
            initsetofpairs(pairset.pairs);
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN pairset.mruparam:=%PARAMNAME.str;
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN pairset.ilparam:=%PARAMNAME.str;
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN leftpresent:=true
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN rightpresent:=true
                          END
       *>
6:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN appendpair(%ELEMENTTRANS.pair,pairset.pairs);
                          END
       *>
7:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN pairset.mrutype:=%TYPENAME.str
                          END
       *>
8:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN pairset.iltype:=%TYPENAME.str
                          END
       *>
FINAL: #CONDITION: leftpresent or rightpresent
       #ACTION: BEGIN
                  SEND_PARAMETERTRANS;
                  $PARAMETERTRANS.pairset:=pairset;
                END
*>
END;

