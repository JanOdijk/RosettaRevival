\newpage
\begin{verbatim}
% TRANSFORMATION TNPqpcomplextrapos
< m1: NP{NPrec1}[mu1,
                 detrel/DETP{DETPrec1}
                             [head/QP{QPrec1}[mu2,
                                              I1:rel1/T1
                                             ]
                             ],
                 mu4
                 ]
>
< m : NP{NPrec1}[mu1,
                 detrel/DETP{DETPrec1}
                             [head/QP{QPrec1}[mu2]],
                 mu4,
                 I2:extraposrel/T1
                 ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [ofcomplrel, thanascomplrel] AND
           T1.CAT IN [PREPP, THANP]
       I2: T1.CAT IN [PREPP, THANP]

      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
            C11: QPrec1.thanas IN [thancompl, ascompl]
            A11: rel1 := thanascomplrel
            C12: QPrec1.thanas = ofcompl
            A12: rel1 := ofcomplrel
          A1: @
         >


&

\end{verbatim}
