\begin{verbatim}

% RULE RNPpartitiveformation2    (* DETP + () + NOUN + posrel --> 
                                    DETP of POSSADJ + [() + NOUN] *)
< m1: CN{CNrec1}[mu1,
                 head/NOUN{NOUNrec3}[mu6],
                 mu7,
                 posrel/NP{NPrec1}[mu2, 
                                   head/T1
                                   ]
                ]
  m2: DETP{DETPrec1}[mu9]
>

< m : NP{NPrec2}[detrel/DETP{DETPrec3}[modrel/DETP{DETPrec2}[mu9],
                                       partrel/PREP(KEY_ofprepkey){PREPrec1},
                                       head/T2
                                      ],
                 head/CN{CNrec1}[mu1,
                                 head/NOUN{NOUNrec3}[mu6],
                                 mu7
                                 ]
                ]
>


<
   (* 1 *)      (* two + books my father --> two of my  father's books *)
   SUBRULE
      < 
        T1:CN{CNrec2}[mu3,head/NOUN{NOUNrec1}[mu4]] 
      >
      < T2:NP{NPrec1}[mu2,
                      head/CN{CNrec2}[mu3,
                                      head/NOUN{NOUNrec2}[mu4]
                                     ],
                      gluerel/GLUE{},
                      modrel/GEN(KEY_genGENkey){GENrec1}
                     ] 
      >


      COMP
         <
          C1: CNrec2.poss= true AND
              DETPrec1.superdeixis = CNrec1.superdeixis
              C11: singular IN NOUNrec3.numbers 
              A11: NPrec1.number := singular
              C12: plural IN NOUNrec3.numbers 
              A12: NPrec1.number := plural
          A1: NOUNrec2 := NOUNrec1;
(*              NOUNrec2.geni := true; *)
              DETPrec3 := 
                         { possnietnp  :  DETPrec1.possnietnp
                           definite    :  adef
                           posspred    :  DETPrec1.posspred
                           possnumbers :  [singular, plural]
                                            (* om one of my aan te kunnen 
                                               is extra atribuut nodig *)
                           posscomas   :  DETPrec1.posscomas
                           mood        :  DETPrec1.mood
                           };
              NPrec2 := { posspred          : DETPrec3.posspred
                          definite          : adef
                          possnietnp        : DETPrec3.possnietnp
                          mood              : DETPrec3.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          cases      : []
                          
                         };
               DETPrec2 := DETPrec1;
               DETPrec2.superdeixis := omegadeixis;
         >

      DECOMP
         <
           C1: (CNrec2.poss = true) AND
(*               (NOUNrec2.geni = true) AND *)
               DETPrec3 = 
                         { possnietnp  :  DETPrec2.possnietnp
                           definite    :  adef
                           posspred    :  DETPrec2.posspred
                           possnumbers :  [singular, plural]
                                            (* om one of my aan te kunnen 
                                               is extra atribuut nodig *)
                           posscomas   :  DETPrec2.posscomas
                           mood        :  DETPrec2.mood
                           }
              AND
              NPrec2 = { posspred          : DETPrec3.posspred
                          definite          : adef
                          possnietnp        : DETPrec3.possnietnp
                          mood              : DETPrec3.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          cases      : []
                        } AND
                DETPrec2.superdeixis = omegadeixis

              C11: singular IN NOUNrec1.numbers AND
                   NPrec1.number = singular
              A11: @
              C12: plural IN NOUNrec1.numbers  AND
                   NPrec1.number = plural
              A12: @

          A1:  NOUNrec1 := NOUNrec2;
               DETPrec1 := DETPrec2;
               DETPrec1.superdeixis := CNrec1.superdeixis;
(*         dutch:      NOUNrec1.geni := false; english: 's in model *)
         >


   (* 2 *)      (* two  +  books I --> two of my books *)
   SUBRULE
      < 
        T1:PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}]
        mu2:[] 
      >

      < 
        T2:POSSADJ{POSSADJrec1}[head/BPERSPRO{BPERSPROrec1}] 
      >


      COMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  superdeixis   : omegadeixis
		  deixis        : omegadeixis
		  aspect        : omegaAspect
		  retro         : false
		  definite      : def
		  person        : PERSPROrec1.person
		  number        : PERSPROrec1.number
		  cases         : []
		  genders       : [PERSPROrec1.gender] 
		  sexes         : []
		  actsubcs      : [othernoun]
		  temporal      : false
(*		  poss          : false
*)
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : nowh
		  generic       : omegageneric
		  syntquant     : omegaquant
		  NPhead        : PERSPROrec1.NPhead
		  specQ         : yesspec
		  } AND
              PERSPROrec1 = COPYT_BPERSPROTOPERSPRO(BPERSPROrec1) AND
              DETPrec1.superdeixis = CNrec1.superdeixis

              C11: singular IN NOUNrec3.numbers 
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers 
              A12: NPrec2.number := plural

          A1: 
               DETPrec3 := 
                         { possnietnp  :  DETPrec1.possnietnp
                           definite    :  adef
                           posspred    :  DETPrec1.posspred
                           possnumbers :  [singular, plural]
                                            (* om een van mijn aan te kunnen 
                                               is extra atribuut nodig *)
                           posscomas   :  DETPrec1.posscomas
                           mood        :  DETPrec1.mood
                           }; 
              NPrec2 :=  { posspred          : DETPrec3.posspred
                          definite          : adef
                          possnietnp        : DETPrec3.possnietnp
                          mood              : DETPrec3.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          cases      : []
                         };
                DETPrec2 := DETPrec1;
                DETPrec2.superdeixis := omegadeixis;
 
              (* the POSSADJ happens to have default values only *)
         >

      DECOMP
         <
          C1: POSSADJrec1.antecedent = noant AND
              POSSADJrec1.mood = nowh AND
               DETPrec3 = 
                         { possnietnp  :  DETPrec2.possnietnp
                           definite    :  adef
                           posspred    :  DETPrec2.posspred
                           possnumbers :  [singular, plural]
                                            (* om one of my  aan te kunnen 
                                               is extra atribuut nodig *)
                           posscomas   :  DETPrec2.posscomas
                           mood        :  DETPrec2.mood
                           } AND
               NPrec2 =  { posspred          : DETPrec3.posspred
                          definite          : adef
                          possnietnp        : DETPrec3.possnietnp
                          mood              : DETPrec3.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          cases      : []
                         } AND
                  DETPrec2.superdeixis = omegadeixis

              C11: singular IN NOUNrec3.numbers  AND
                   NPrec2.number = singular
              A11: @
              C12: plural IN NOUNrec3.numbers  AND
                   NPrec2.number = plural
              A12: @

          A1: PERSPROrec1 := COPYT_BPERSPROTOPERSPRO(BPERSPROrec1);
              NPrec1 := 
		  {
		  req           : [pospol,negpol,omegapol]
		  env           : [pospol,negpol,omegapol]
		  class         : omegaTimeAdvClass
		  superdeixis   : omegadeixis
		  deixis        : omegadeixis
		  aspect        : omegaAspect
		  retro         : false
		  definite      : def
		  person        : PERSPROrec1.person
		  number        : PERSPROrec1.number
		  cases         : []
		  genders       : [PERSPROrec1.gender] 
		  sexes         : []
		  actsubcs      : [othernoun]
		  temporal      : false
(*		  poss          : false
*)
		  animate       : PERSPROrec1.animate
		  human         : Omegahuman
		  actcomas      : [count]
		  thetanp       : omegathetanp
		  nounpatternefs: []
		  posspred      : true
		  possnietnp    : false
		  mood          : nowh
		  generic       : omegageneric
		  syntquant     : omegaquant
		  NPhead        : PERSPROrec1.NPhead
		  specQ         : yesspec
		  };
            DETPrec1 := DETPrec2;
            DETprec1.superdeixis := CNrec1.superdeixis;
      
         >

   (* 3 *)      (* two + books Jan --> two of Jan's books *) 
   SUBRULE
      < 
        T1:PROPERNOUN{PROPERNOUNrec1}[mu8]
      >

      < 
        T2:NP{NPrec1}[mu2, 
                      head/PROPERNOUN{PROPERNOUNrec2}[mu8],
                      gluerel/GLUE{},
                      modrel/GEN(KEY_genGENkey){GENrec1}
                     ] 
      >

      COMP
         <
          C1: PROPERNOUNrec1.poss = true AND
              DETPrec1.superdeixis = CNrec1.superdeixis
              C11: singular IN NOUNrec3.numbers 
              A11: NPrec2.number := singular
              C12: plural IN NOUNrec3.numbers 
              A12: NPrec2.number := plural

          A1: PROPERNOUNrec2 := PROPERNOUNrec1;
           (*dutch:    PROPERNOUNrec1.geni := true; for english: 's in model *) 
              NPrec1 := { definite          : def
                          number            : singular
                          poss              : PROPERNOUNrec2.poss
                          animate           : PROPERNOUNrec2.animate
                          human             : PROPERNOUNrec2.human
                         };
               DETPrec3 := 
                         { possnietnp  :  DETPrec1.possnietnp
                           definite    :  adef
                           posspred    :  DETPrec1.posspred
                           possnumbers :  [singular, plural]
                                            (* om een van mijn aan te kunnen 
                                               is extra atribuut nodig *)
                           posscomas   :  DETPrec1.posscomas
                           mood        :  DETPrec1.mood
                           }; 
              NPrec2 :=  { posspred          : DETPrec3.posspred
                          definite          : adef
                          possnietnp        : DETPrec3.possnietnp
                          mood              : DETPrec3.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : NPrec1.syntquant 
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          cases      : []
                         };
            DETPrec2 := DETPrec1;
            DETPrec2.superdeixis := omegadeixis;
         >

      DECOMP
         <
          C1: (PROPERNOUNrec2.poss = true) AND
 (*             (PROPERNOUNrec2.geni = true) AND ; cf. remarks above *) 
              NPrec1  = { definite          : def
                          number            : singular
                          poss               : PROPERNOUNrec2.poss
                          animate           : PROPERNOUNrec2.animate
                          human             : PROPERNOUNrec2.human
                        } AND
              DETPrec3 = 
                         { possnietnp  :  DETPrec2.possnietnp
                           definite    :  adef
                           posspred    :  DETPrec2.posspred
                           possnumbers :  [singular, plural]
                                            (* om een van mijn aan te kunnen 
                                               is extra atribuut nodig *)
                           posscomas   :  DETPrec2.posscomas
                           mood        :  DETPrec2.mood
                           } AND 
              NPrec2 =  { posspred          : DETPrec3.posspred
                          definite          : adef
                          possnietnp        : DETPrec3.possnietnp
                          mood              : DETPrec3.mood

                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : CNrec1.posscomas
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : NPrec1.syntquant 
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          cases      : []
                         }  AND
              DETPrec2.superdeixis = omegadeixis

              C11: singular IN NOUNrec3.numbers  AND
                   NPrec2.number = singular
              A11: @
              C12: plural IN NOUNrec3.numbers  AND
                   NPrec2.number = plural
              A12: @

          A1:  PROPERNOUNrec1 := PROPERNOUNrec2;
               DETPrec1 := DETPrec2;
               DETPrec1.superdeixis := CNrec1.superdeixis;
         >
>

&

\end{verbatim}
