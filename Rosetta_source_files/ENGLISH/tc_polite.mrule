\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION Tpolite2 (* will -> would *)
< m1:SENTENCE{SENTENCErec1}
           [I2:mu1,
            I3:auxrel/VERB{VERBrec1}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 
>

< m :SENTENCE{SENTENCErec2}
           [I2:mu1,
            I4:auxrel/VERB{VERBrec3}
                  [head/SUBVERB{SUBVERBrec1}
                       [head/BVERB(KEY_willBVERBkey){BVERBrec1}]
                  ],
            mu2,
            predrel/VERBP{VERBPrec1}
                   [head/VERB{VERbrec2}
                        [head/SUBVERB{SUBVERBrec2}
                             [I1:head/BVERB(KEY2){BVERBrec2}]
                        ],
                    mu3
                   ],
            mu4
           ] 

>
   MATCHCONDITIONS
      <
       I1: KEY2 = KEY_likeBVERBkey OR
           KEY2 = KEY_preferBVERBkey OR
           KEY2 = KEY_appreciateBVERBkey OR
           KEY2 = KEY_wantBVERBkey OR
           KEY2 = KEY_'s_auxverb177' (* want *)
 
       I2: EXIST (mu1, [I5:subjrel/NP{NPrec1}[mu5]])
       I3: VERBrec1.tense = presenttense
       I4: VERBrec3.tense = pasttense
       I5: NPrec1.person = 1
       m1: SENTENCErec1.mood = declarative
       m : SENTENCErec2.mood = declarative

      >


      COMP
         <
          C1: (SENTENCErec1.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec1 = COPYT_subverbtoverb(SUBVERBrec1) EXCEPT FOR
                                      [numbers, persons, tense, modus]) AND
              (SUBVERBrec1.affix = noaffix) AND
              (SENTENCErec1.deixis = presentdeixis)  AND
              (VERBrec1.tense = presenttense)

          A1: VERBrec3 := VERBrec1;
              VERBrec3.tense := pasttense;
              SENTENCErec2 := SENTENCErec1;
              SENTENCErec2.deixis := pastdeixis;
         >
      DECOMP
         <
          C1:(SENTENCErec2.finiteness = finite) AND
              (SUBVERBrec1 = COPYT_bverbtosubverb(BVERBrec1)) AND
              (VERBrec3 = COPYT_subverbtoverb(SUBVERBrec1) EXCEPT FOR
                                      [numbers, persons, tense, modus]) AND
              (SUBVERBrec1.affix = noaffix)  AND 
              (SENTENCErec2.deixis = pastdeixis) AND
              (VERBrec3.tense = pasttense)
              
          A1:VERBrec1 := VERBrec3;
             VERBrec1.tense := presenttense;
             SENTENCErec1 := SENTENCErec2;
             SENTENCErec1.deixis := presentdeixis;  

         >

&

\end{verbatim}
