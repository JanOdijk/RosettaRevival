\newpage
\begin{verbatim}
% RULE Ridnppsuperdeixis
< m1:NPPROP{NPPROPrec1}[I1:mu1] 
>

< m :NPPROP{NPPROPrec1'}[I1:mu1] 
>

   MATCHCONDITIONS
      <
       I1: EXIST(mu1,[idrel/..])
      >

   PARAMETERS
      <
       super: tiempotype
      >


      COMP
         <
          C1:NPPROPrec1.supertiempo = omegatiempo
          A1:NPPROPrec1' := NPPROPrec1;
             NPPROPrec1'.supertiempo := super;
         >
      DECOMP
         <
          C1: true
          A1: NPPROPrec1 := NPPROPrec1';
              NPPROPrec1.supertiempo := omegatiempo;
              super := NPPROPrec1'.supertiempo;
         >


&

\end{verbatim}
