\newpage
\begin{verbatim}
% TRANSFORMATION TnoClustering
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     head/I2::VERB{VERBrec2}[mu8],
                     mu9,
                     complrel/I3::SENTENCE{SENTENCErec1}
                           [ mu3,
                             predrel/VERBP{VERBPrec2}
                                 [mu10,
                                  rel1/I1::VERB{VERBrec1}[mu5],
                                  I11:mu11
                                 ],
                             mu4
                           ],
                     mu6
                   ],
             mu7
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                   [ mu2,
                     head/I2::VERB{VERBrec2}[mu8],
                     mu9,
                     complrel/I3::SENTENCE{SENTENCErec1}
                           [mu3,
                            predrel/VERBP{VERBPrec2}
                                [mu10,
                                 rel1/I1::VERB{VERBrec1}[mu5],
                                 I11:mu11
                                ],
                            mu4
                           ],
                     mu6
                   ],
            mu7
           ]
>

   MATCHCONDITIONS   
      <
       I1: ( VERBrec1.modo IN [Infinitivo, gerundio] )
       I2: ( VERBrec2.Clustering IN [ NoClustering, OptVR ] ) 
       I3: ( SENTENCErec1.VRcompl = false) AND
           (SENTENCErec1.restructuring = false)
       I11: EXIST (mu11, [I112:cliticrel/CLITIC{}[mu112]])      
             -> EXIST (mu11, [gluerel/GLUE{}])
       I112:EXIST(mu112,[I122:rel12/T1])
       I122:rel12 IN [seCLrel,unoCLrel,dosCLrel,tresCLrel] 
     >
         
     
      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >

&

\end{verbatim}
