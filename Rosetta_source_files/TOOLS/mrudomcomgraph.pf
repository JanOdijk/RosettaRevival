pragma C_include ('mrudomcomlangspec.pf');
pragma C_include ('mrudomcomdecl.pf');

PACKAGE mrudomcomGRAPH;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH mrudomcomDECL,
     mrudomcomLANGSPEC;


     { the functions atom, alt, conc, opt and star to build the
     syntaxgraphs }
 
FUNCTION atom (a: mrudomcomLANGSPEC_Category;
                          b: mrudomcomDECL_nodeid): mrudomcomDECL_psurfgraph; EXTERNAL;

FUNCTION alt(a,b: mrudomcomDECL_psurfgraph): mrudomcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION conc(a,b: mrudomcomDECL_psurfgraph): mrudomcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION opt(a: mrudomcomDECL_psurfgraph): mrudomcomDECL_psurfgraph; EXTERNAL;
 
FUNCTION star(a: mrudomcomDECL_psurfgraph): mrudomcomDECL_psurfgraph; EXTERNAL;
 
PROCEDURE prod(a: integer; 
                          b: mrudomcomLANGSPEC_Category; 
                          c: mrudomcomDECL_psurfgraph); EXTERNAL;
 
END {mrudomcomGRAPH};
