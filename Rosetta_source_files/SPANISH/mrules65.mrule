SPANISH 65
&
The rules Radjlocpreppvar and Radjcauspreppvar have been removed here
(by putting them into comment).

They have been replaced by rules in spanish:rc_advvar, (mrules6).

Jan O

\begin{verbatim}


 RULE RAdjLocpreppVar
< m1: ADJPPROP{ADJPPROPrec1}
               [ mu1,
                 predrel/ADJP{ADJPrec1}[mu2],
                 mu3 
               ]

  m2: I1::PREPPVAR{PREPPVARrec1}                 
>

< m : ADJPPROP{ADJPPROPrec1}
               [ mu1,
                 predrel/ADJP{ADJPrec1}[mu2],
                 locadvrel/I1::PREPPVAR{PREPPVARrec1},
                 mu3
               ]
>

   MATCHCONDITIONS
      <
       I1: loc IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
