\newpage
\begin{verbatim}
% TRANSFORMATION TemptySEspelling
< m1:I1::CLAUSE{CLAUSErec1}
           [ I4:mu1,
             subjrel/I2::NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}],
             I3:mu2,
             cliticrel/CLITIC{}[I7:mu8],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I5::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5
           ]
>

< m:I1::CLAUSE{CLAUSErec1}
          [ I4:mu1,
            subjrel/NP{NPrec2}
                   [ head/PERSPRO{PERSPROrec1}
                        [ head/BPERSPRO(KEY_redellosBPERSPROkey){BPERSPROrec1}]
                   ],
            I3:mu2,
            cliticrel/CLITIC{}[I7:mu8],
            head/VERB{VERBrec4}
                 [ mu15,
                   head/VERB{VERBrec3}
                     [head/SUBVERB{SUBVERBrec1}
                        [head/I5::BVERB{BVERBrec1}]
                     ]
                 ],
            mu5
          ]
>

   MATCHCONDITIONS
      <
       I1:  CLAUSErec1.finiteness = finite
       I2:  (NPrec1.NPhead = Seimpershead)    AND
            (NPrec1.numero = singular)        AND
            (NPrec1.persona = 3)              AND
            (NPrec1.cases = [nominative])
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel,  negrel ]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  BVERBrec1.reflexivity = reflexive
       I7: EXIST (mu8, [seCLrel/..])
      >

      COMP
         <
          C1: True
          A1: PERSPROrec1 := COPYT_BtoPERSPRO(BPERSPROrec1);
              NPrec2 := AUX_NPONnomBPRSPR;
                          NPrec2.NPhead := redellosNP;
                          NPrec2.numero := PERSPROrec1.numero;
                          NPrec2.genero := PERSPROrec1.genero;
              VERBrec3 := VERBrec1;
                          VERBrec3.numero := PERSPROrec1.numero;
                          VERBrec3.genero := PERSPROrec1.genero;
                          VERBrec3.persona:= PERSPROrec1.persona;
              VERBrec4 := VERBrec2;
                        VERBrec4.numero := VERBrec3.numero;
                        VERBrec4.genero := VERBrec3.genero;
                        VERBrec4.persona := VERBrec3.persona     
             
         >
&

\end{verbatim}
