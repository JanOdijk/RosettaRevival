\begin{verbatim}
*)

<
   SUBRULE (* 1. NPVAR *)
      < T1:NPVAR{NPVARrec1}
        T2:NPVAR{NPVARrec2} >
      < T1:NPVAR{NPVARrec1} >

      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL AND
              CLAUSEVARrec1  = COPYT_clauseTOvar(CLAUSErec1) AND
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [superdeixis, PROsubject, aktionsarts] AND
              OPENADVPPROPrec1 = { aktionsarts   : [stative]
                                   PROsubject    : true } AND
              NPVARrec2 = NPVARrec1 EXCEPT FOR [ cases ] AND
              NPVARrec2.cases = [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis)
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: CLAUSEVARrec1 := COPYT_clauseTOvar(CLAUSErec1);
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advpTOprop(ADVPrec1);
              OPENADVPPROPrec1 := { aktionsarts   : [stative]
                                    PROsubject    : true };
              NPVARrec2 := NPVARrec1 ;
              NPVARrec2.cases := [];
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis);
         >

   SUBRULE   (* 2. CNVAR *)
      < T1:CNVAR{CNVARrec1}
        T2:CNVAR{CNVARrec2} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL AND
              CLAUSEVARrec1 = COPYT_clauseTOvar(CLAUSErec1) AND
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [superdeixis, PROsubject, aktionsarts] AND
              OPENADVPPROPrec1 = { aktionsarts   : [stative]
                                   PROsubject    : true } AND
              CNVARrec2 = CNVARrec1 EXCEPT FOR [ cases ] AND
              CNVARrec2.cases = [] AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis)
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: CLAUSEVARrec1 := COPYT_clauseTOvar(CLAUSErec1);
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advpTOprop(ADVPrec1);
              OPENADVPPROPrec1 := { aktionsarts   : [stative]
                                    PROsubject    : true };
              CNVARrec2 := CNVARrec1 ;
              CNVARrec2.cases := []; 
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis);
         >

SUBRULE  (* 3. EMPTYVAR *)
      < T1:EMPTYVAR{EMPTYVARrec1}
        T2:EMPTYVAR{EMPTYVARrec2} >
      < T1:EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: CLAUSEVARrec1.index = LEVEL AND
              CLAUSEVARrec1 = COPYT_clauseTOvar(CLAUSErec1) AND
              OPENADVPPROPrec1 = COPYT_advpTOprop(ADVPrec1) 
                EXCEPT FOR [superdeixis, PROsubject, aktionsarts] AND
              OPENADVPPROPrec1 = { aktionsarts   : [stative]
                                   PROsubject   : true } AND
              EMPTYVARrec2 = EMPTYVARrec1 AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis)
          A1: @
         >

      DECOMP
         <
          C1: true
          A1: CLAUSEVARrec1 := COPYT_clauseTOvar(CLAUSErec1);
              CLAUSEVARrec1.index := LEVEL;
              OPENADVPPROPrec1 := COPYT_advpTOprop(ADVPrec1);
              OPENADVPPROPrec1 := { aktionsarts   : [stative]
                                    PROsubject    : true };
              EMPTYVARrec2 := EMPTYVARrec1 ;
              QUOTE_assdeixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis,
                    OPENADVPPROPrec1.superdeixis);
         >
>
