% TRANSFORMATION TObjectok5 (* se-passive, vp120,vp123, object -> object *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             I4:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/I5::VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      I2:objrel/T1,          
                      mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I3:mu1,
             subjrel/PRONPVAR{PRONPVARrec1}[],
             I4:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu6,
                      head/I5::VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      I2:objrel/T1,
                      mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1: ((CLAUSErec1.voice = SEpassive)        AND
            (CLAUSErec1.thetavp IN [vp120,vp123])
           )
       I2: T1.CAT IN [NP,NPVAR,CNVAR ]
       I3: ALL (mu1, I31:rel1/..)
       I31: rel1 IN AUX_presubjrels
       I4: NOT EXIST (mu8, [subjrel/..]) AND
           NOT EXIST (mu8, [I41:rel2/..])
       I41: rel2 IN AUX_presubjrels
       I5: VERBrec1.persona = 3

      >


<
   SUBRULE (* 5 *)
      < T1:NP{NPrec1}[mu9] >
      < T1:NP{NPrec1}[mu9] >


      COMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARonECBPRSPR;
              PRONPVARrec1.persona := NPrec1.persona;
              PRONPVARrec1.numero := NPrec1.numero;
              PRONPVARrec1.genero := NPrec1.genero
         >

      DECOMP
         <
          C1: (PRONPVARrec1 = AUX_PRONPVARonECBPRSPR EXCEPT FOR 
                               [persona, numero, genero]) AND
              (PRONPVARrec1.persona = NPrec1.persona)        AND
              (PRONPVARrec1.numero = NPrec1.numero)          AND
              (PRONPVARrec1.genero = NPrec1.genero) 
          A1: @
         >


   SUBRULE (* 5a *)
      < T1:NPVAR{NPVARrec1} >
      < T1:NPVAR{NPVARrec1} >


      COMP
         <
          C1: true
          A1: PRONPVARrec1 := AUX_PRONPVARonECBPRSPR;
              PRONPVARrec1.persona := NPVARrec1.persona;
              PRONPVARrec1.numero := NPVARrec1.numero;
              PRONPVARrec1.genero := NPVARrec1.genero;
         >

      DECOMP
         <
          C1: (PRONPVARrec1 = AUX_PRONPVARonECBPRSPR EXCEPT FOR
                                [persona, numero, genero]) AND
              (PRONPVARrec1.persona = NPVARrec1.persona)      AND
              (PRONPVARrec1.numero = NPVARrec1.numero)        AND
              (PRONPVARrec1.genero = NPVARrec1.genero) 
          A1: @
         >


   SUBRULE (* 5b *)
      < T1:CNVAR{CNVARrec1} >
      < T1:CNVAR{CNVARrec1} >

      COMP
         <
          C1: masc IN CNVARrec1.generos
          A1: PRONPVARrec1 := AUX_PRONPVARonECBPRSPR;
              PRONPVARrec1.numero := CNVARrec1.numero;
              PRONPVARrec1.genero := masc
          C1: fem IN CNVARrec1.generos
          A1: PRONPVARrec1 := AUX_PRONPVARonECBPRSPR;
              PRONPVARrec1.numero := CNVARrec1.numero;
              PRONPVARrec1.genero := fem
         >

      DECOMP
         <
          C1: (PRONPVARrec1 = AUX_PRONPVARonECBPRSPR EXCEPT FOR
                                [numero, genero]) AND
              (PRONPVARrec1.numero = CNVARrec1.numero)        AND
              (PRONPVARrec1.genero = masc)
          A1:  @
          C1: (PRONPVARrec1 = AUX_PRONPVARonECBPRSPR EXCEPT FOR
                                [numero, genero]) AND
              (PRONPVARrec1.numero = CNVARrec1.numero)        AND
              (PRONPVARrec1.genero = fem)
          A1:  @
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TObjectok5
\item[* relevant examples:]
se vendieron (los/muchos) libros $\rightarrow$ $<$PRONPVAR$>$ se vendieron 
(los/muchos) libros \\
Hay bueyes. ????
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] TC:ObjectOkrules
\item[* date of creation:] 11-MAR-1988 15:30:00  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 02/12/88\ \ \ \ \ author: Elly van Munster\\
Matchcondition added for "hay" (thetavpAUX and Active).
\item date: 13/12/88\ \ \ \ \ author: Elly van Munster\\
cliticrel/.. added.
\item date: 20/01/89\ \ \ \ \ author: Lisette Appelo\\
Added mu6-mu8, MC I3,I4.
\item date: 18/09/89\ \ \ \ \ author: Lisette Appelo\\
Changed PRONP into PRONPVAR.\\
I do not know if this rule works for existentials too.
\end{enumerate}
\item[* task:] 
To introduce in a SE-passive construction a subjrel/PRONP[EC] with the record 
of the object. The object remains in object-position.\\
(NB. The PRONP[EC] is equivalent to the so-called "little pro" in LGB).
Maybe a later transformation will topicalize the (non-bare) object optionally.
(e.g. los libros se venden).\\
Also for existential HAY.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
Two subrules for NPVAR vs. CNVAR.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:]
