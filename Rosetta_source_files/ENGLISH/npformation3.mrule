\begin{verbatim}
% RULE RNPformation11

< m1: CN{CNrec1}I1:[mu1,
                 head/EN(KEY_countenkey){ENrec1},
                 mu2
                ]

>

< m: NP{NPrec1}[detrel/DETP{DETPrec1}[head/ART(KEY_aartkey){ARTrec1}],
                 head/CN{CNrec1}I1:[mu1,
                                 head/EN(KEY_countenkey){ENrec1},
                                 mu2
                                ]
                ]                       
>

   MATCHCONDITIONS
      <
       I1: (EXIST (mu1, [I11:modrel/T2]) OR
           EXIST (mu2, [I12:rel1/T3])) AND
           (NOT EXIST (mu2, [posrel/NP{NPrec8}[mu8]]))

       I11: T2.CAT IN [ADJP, SENTENCE]
       I12: ((T3.CAT IN [ADJP, ADVP, PREPP]) OR 
            (T3.CAT IN [SENTENCE] WITH T3.REC.mood =relative)) AND
            rel1 IN [posrel, postmodrel]
      >

      COMP
        <
          C1: CNrec1.numbers = [singular]
          A1: DETPrec1 := COPYT_ARTtoDETP(ARTrec1);
              DETPrec1.posspred := true;
              DETPrec1.possnietnp := true;
              DETPrec1.mood := nowh;
              NPrec1 := { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          number            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          actcomas          : [count]
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          class             : CNrec1.class 
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro
                          
                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          NPhead     : otherNP
                         }  
         >

      DECOMP
         <
          C1: CNrec1.numbers = [singular] AND
              DETPrec1  = COPYT_ARTtoDETP(ARTrec1) AND
              DETPrec1.posspred = true AND
              DETPrec1.possnietnp = true AND
              DETPrec1.mood = nowh AND
              CNrec1.posscomas * [count] <> [] AND
              NPrec1.actcomas * [count] <> [] AND
              NPrec1 = { posspred          : DETPrec1.posspred
                          definite          : DETPrec1.definite
                          possnietnp        : DETPrec1.possnietnp
                          mood              : DETPrec1.mood

                          number            : singular
                          nounpatternefs    : CNrec1.nounpatternefs
                          thetanp           : CNrec1.thetanp
                          human             : CNrec1.human
                          animate           : CNrec1.animate
                          poss              : CNrec1.poss
                          temporal          : CNrec1.temporal
                          actsubcs          : CNrec1.actsubcs
                          sexes             : CNrec1.sexes
                          genders           : CNrec1.genders
                          class             : CNrec1.class 
                          deixis            : CNrec1.deixis
                          aspect            : CNrec1.aspect
                          retro             : CNrec1.retro

                          specQ      : yesspec (* auxiliary *)
                          syntquant  : omegaquant (* auxiliary *)
                          generic    : nogeneric
                          superdeixis: omegadeixis
                          NPhead     : otherNP
                         }  
            
              AND (NPrec1.cases = []) 
             
          A1:  @
         >

&


\end{verbatim}
\newpage
\begin{description}
\item[* name:] RNPformation11
\item[* relevant examples:]
\begin{enumerate}
\item
         yellow EN  $\rightarrow$ a yellow EN (EN to be replaced by one)
\begin{enumerate}
NB (EN {\em with a view (in it)} $\rightarrow$ {\em one with a view} may be be 
derived via NPformation2, with {\em one} as numeral. ???

\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NP-subgrammar
\item[* class:] (name of rule, transformation or filter class) NPformationrules
\item[* date of creation:] 21-JUN-1986 11:22:32  
\item[* author:] Franciska de Jong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 31/10/88\ \ \ \ \ author: Lisette Appelo
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:]
The formation of an NP out of a CN with (a) an empty head (EN), and a DETP
that is not indefinite. The complement of this rule is RNPformation2. The 
rules are split up in order to block 'alle', 'elke', 'iedere', etc. 
as bare NP (see above).
            NB. there is a problem with 'beide':
                    *alle
                    *alle met een strikje
              
              but:   beide
                    *beide met een strikje
           
            If 'beide' is considered def, the problem is that 'beide'  
            will be blocked wrongly; but if it is adef e.g., the 
            problem is that the 
            ungrammatical 'beide met een strikje' won't be blocked.

    --> The best solution will probably be to assign 'beide' two categories: 
                                       INDEFPRO / DET
        Assuming now 'beide' is def, NPformation1 will block 'beide', but 
        another rule for INDEFPRO's will accept it.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
    Not yet specified: the value of NPrec1.possnietnp
                                          .syntquant         ;
    It should be investigated whether bare demonstratives (always 
    definite!!) should be dealt with by this rule (which would possibly
    require an extra attribute), or by another one.
\item modifications:31/10/88: Added superdeixis for DETP.\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE RNPformation14     (* each other; one another  *)
< m1: RECIPRO{RECIPROrec1}
>

< m : NP{NPrec1}[head/I1::RECIPRO{RECIPROrec1}]
>

   MATCHCONDITIONS
      <
       m1: RECIPROrec1.key = KEY_eachotherkey OR
           RECIPROrec1.key = KEY_oneanotherkey
       I1: RECIPROrec1.key = KEY_eachotherkey OR
           RECIPROrec1.key = KEY_oneanotherkey
      >

      COMP
        <
          C1: true
          A1: NPrec1 := { req           : [pospol,negpol,omegapol]
                          env           : [pospol,negpol,omegapol]
                          class         : omegaTimeAdvClass
                          superdeixis   : omegadeixis
                          deixis        : omegadeixis
                          aspect        : omegaaspect
                          retro         : false
                          definite      : def
                          person        : 3
                          number        : plural
                          cases         : []
                          genders       : [omegagender]
                          sexes         : []
                          actsubcs      : [othernoun]
                          temporal      : false
                          poss          : false
                          animate       : omegaanimate
                          human         : omegahuman
                          actcomas      : [count]
                          thetanp       : omegathetanp
                          nounpatternefs: []
                          posspred      : false
                          possnietnp    : false
                          mood          : nowh
                          generic       : nogeneric
                          syntquant     : omegaquant
                          NPhead        : reciproNP
                          specQ         : yesspec
                         }
         >

      DECOMP
         <
          C1: NPrec1.actcomas * [count] <> [] AND
              NPrec1 = { req           : [pospol,negpol,omegapol]
                         env           : [pospol,negpol,omegapol]
                         class         : omegaTimeAdvClass
                         superdeixis   : omegadeixis
                         deixis        : omegadeixis
                         aspect        : omegaaspect
                         retro         : false
                         definite      : def
                         person        : 3
                         number        : plural
                         cases         : []
                         genders       : [omegagender]
                         sexes         : []
                         actsubcs      : [othernoun]
                         temporal      : false
                         poss          : false
                         animate       : omegaanimate
                         human         : omegahuman
                         thetanp       : omegathetanp
                         nounpatternefs: []
                         posspred      : false
                         possnietnp    : false
                         mood          : nowh
                         generic       : nogeneric
                         syntquant     : omegaquant
                         NPhead        : reciproNP
                         specQ         : yesspec
                        }
           A1: @
         >

&

\end{verbatim}
