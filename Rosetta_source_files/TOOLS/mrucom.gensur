FINAL: BEGIN BEGIN \cofenv1.\GLOBAL. \\ END;
             BEGIN \decofenv1.\GLOBAL. \\ END;
             TFILES_close(cofenv1);
             TFILES_close(cofpas1); 
             TFILES_close(decofenv1);
             TFILES_close(decofpas1);
       END
END;
