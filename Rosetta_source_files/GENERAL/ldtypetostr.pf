pragma C_include('strings.pf');
pragma C_include('str.pf');
pragma C_include('limorfdef.pf');
pragma C_include('lidomaint.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
PACKAGE LDTYPETOSTR;
WITH STR,
     LIMORFDEF,
     LIDOMAINT,
     STRINGS;


(*MPF:::===================================================================*
 *
 *  proc Name      : LDTYPETOSTR_Affix
 *  Description    : Converts strings to affixkey values (if possible)
 *  Parameters     : VAR str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   VAR l  : length of str
 *                   afx: INTEGER; affix key value
 *  Precondition   : none
 *  Postcondition  : str = name(afx)
 *  Side Effects   : none
 *
 *EMP:::===================================================================*)

PROCEDURE LDTYPETOSTR_Affix(
           VAR str: STRING;
           VAR l: STR_Range;
           afx: INTEGER); EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LDTYPETOSTR_Cat
 *  Description    : Converts strings to Category values (if possible)
 *  Parameters     : VAR str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   VAR l  : length of str
 *                   cat: LIDOMAINT_syntcat; cat. value
 *  Precondition   : none
 *  Postcondition  : str = name(cat)
 *
 *EMP:::===================================================================*)

PROCEDURE LDTYPETOSTR_Cat(
           VAR str: STRING;
           VAR l: STR_Range;
           cat: LIDOMAINT_syntcat); EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDTYPETOSTR_Rel
 *  Description    : Converts strings to relegory values (if possible)
 *  Parameters     : VAR str: PACKED ARRAY [lb1..ub1: STR_Range] of CHAR; 
 *                        input string
 *                   VAR l  : length of str
 *                   rel: LIDOMAINT_synrel; rel. value
 *  Precondition   : none
 *  Postcondition  : str = name(rel)
 *
 *EMP:::===================================================================*)

PROCEDURE LDTYPETOSTR_Rel(
           VAR str: STRING;
           VAR l: STR_Range;
           rel: LIDOMAINT_synrel); EXTERNAL;
END{LDTYPETOSTR};
