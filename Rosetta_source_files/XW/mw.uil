object mw_output_pane : XmForm {
    arguments {
        XmNpaneMinimum = 200;
        arguments form_args;
    };
    controls {
	XmLabel mw_translation_label;
	XmRowColumn mw_generation_button_box;
	XmFrame mw_generation_frame;
	XmScrolledText mw_output_area;
    };
};

object mw_translation_label : XmLabel {
    arguments {
	XmNtopAttachment    = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;

        arguments label_args;
	XmNlabelString      = N_mw_output_area;
    };
};

object mw_generation_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;
	XmNresizable        = false;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
	XmPushButton mw_nextstruct_button;
	XmPushButton mw_nextlex_button;
	XmPushButton mw_gnext_button;
    };
};

object mw_generation_frame : XmFrame {
    arguments {
	XmNtopAttachment     = XmATTACH_WIDGET;
	XmNtopWidget	     = XmLabel mw_translation_label;
	XmNrightAttachment   = XmATTACH_FORM;
	XmNmappedWhenManaged = false;
    };
    controls {
	XmRowColumn {
	    arguments {
        	XmNorientation      = XmVERTICAL;
            };
	    controls {
		XmLabel mw_gtrans_label;
		XmLabel mw_mgeneration_label;
		XmLabel mw_linearizer_label;
		XmLabel mw_gmorph_label;
		XmLabel mw_glayout_label;
	    };
	};
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_generation_frame);
    };
};

