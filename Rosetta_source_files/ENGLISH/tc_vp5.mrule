\begin{verbatim}

%
% TRANSFORMATION TVerbpattern7
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                            [ head/VERB{VERBrec1}[mu2],
                              argrel/T1,
                              argrel/T2
                            ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
                [ mu1,
                  I2:predrel/VERBP{VERBPrec1}
                         [ head/VERB{VERBrec1}[mu2],
                           I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                     [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                       objrel/T1
                                     ],
                           I4:prepobjrel/VARPREPP{VARPREPPrec2}
                                     [ head/PREP(VERBrec1.prepkey2){PREPrec2},
                                       objrel/T2
                                     ]
                         ] 
                 ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1 AND
           PREPrec2.key = VERBrec1.prepkey2
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR 
                [headkey, actsubcefs, synppefs, mood, thetapp,
                 specQ, class, aspect, deixis, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            aspect     : PREPrec1.aspect
                            deixis     : PREPrec1.deixis
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
       I4: VARPREPPrec2 = PREPPrecdef EXCEPT FOR 
                [headkey, actsubcefs, synppefs, mood, thetapp,
                 specQ, class, aspect, deixis, retro] AND
           VARPREPPrec2 = { headkey    : PREPrec2.key
                            class      : PREPrec2.class
                            aspect     : PREPrec2.aspect
                            deixis     : PREPrec2.deixis
                            retro      : PREPrec2.retro } AND
           VARPREPPrec2.actsubcefs * PREPrec2.subcs <> []
      >

<
   SUBRULE (* 1a. x1 talk to x2 about x3 *)
      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >

      < T1: NPVAR{NPVARrec1}
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synPREPNP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VARPREPPrec2 := { headkey    : PREPrec2.key
                                actsubcefs : PREPrec2.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec1.mood 
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec2.class
                                aspect     : PREPrec2.aspect
                                deixis     : PREPrec2.deixis
                                retro      : PREPrec2.retro
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPNP_PREPNP IN VERBPPROPrec2.synvpefs AND
              synPREPNP_PREPNP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec2.mood 
                               specQ     : NPVARrec2.specQ
                               thetapp   : pp120 } AND
              VARPREPPrec2 = { synppefs NI synNP
                               mood      : NPVARrec1.mood
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120  }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. x1 talk to x2 about x3 *)
      < T1: CNVAR{CNVARrec1}
        T2: NPVAR{NPVARrec2} >

      < T1: CNVAR{CNVARrec1}
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synPREPNP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec2.mood 
                                specQ      : NPVARrec2.specQ
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VARPREPPrec2 := { headkey    : PREPrec2.key
                                actsubcefs : PREPrec2.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood
                                specQ      : yesspec
                                class      : PREPrec2.class
                                aspect     : PREPrec2.aspect
                                deixis     : PREPrec2.deixis
                                retro      : PREPrec2.retro
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPNP_PREPNP IN VERBPPROPrec2.synvpefs AND
              synPREPNP_PREPNP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec2.mood 
                               specQ     : NPVARrec2.specQ
                               thetapp   : pp120 } AND
              VARPREPPrec2 = { synppefs NI synNP
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1c. x1 talk to x2 about x3 *)
      < T1: NPVAR{NPVARrec1}
        T2: CNVAR{CNVARrec2} >

      < T1: NPVAR{NPVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synPREPNP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VARPREPPrec2 := { headkey    : PREPrec2.key
                                actsubcefs : PREPrec2.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec1.mood 
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec2.class
                                aspect     : PREPrec2.aspect
                                deixis     : PREPrec2.deixis
                                retro      : PREPrec2.retro
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPNP_PREPNP IN VERBPPROPrec2.synvpefs AND
              synPREPNP_PREPNP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              VARPREPPrec2 = { synppefs NI synNP
                               mood      : NPVARrec1.mood 
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1d. x1 talk to x2 about x3 *)
      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >

      < T1: CNVAR{CNVARrec1}
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synPREPNP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPREPNP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              VARPREPPrec2 := { headkey    : PREPrec2.key
                                actsubcefs : PREPrec2.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood
                                specQ      : yesspec
                                class      : PREPrec2.class
                                aspect     : PREPrec2.aspect
                                deixis     : PREPrec2.deixis
                                retro      : PREPrec2.retro
                                thetapp    : pp120 }
         >
      DECOMP
         <
          C1: synPREPNP_PREPNP IN VERBPPROPrec2.synvpefs AND
              synPREPNP_PREPNP IN VERBrec1.synvps AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              VARPREPPrec2 = { synppefs NI synNP
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (*2. x1 agree with x2 (up)on x3 *)
      <T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}>

      <T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}>

      COMP
         <
          C1:synPREPNP_PREPOPENGERUND IN VERBrec1.synvps AND
             NPVARrec2.NPhead = openingNP
          A1:VERBPPROPrec2 := VERBPPROPREC1;
             VERBPPROPrec2.synvpefs := [synPREPNP_PREPOPENGERUND];
             VARPREPPrec1 := { headkey    : PREPrec1.key
                               actsubcefs : PREPrec1.subcs
                               synppefs   : [synNP]
                               mood       : relativexpmood 
                               specQ      : yesspec
                               class      : PREPrec1.class
                               aspect     : PREPrec1.aspect
                               deixis     : PREPrec1.deixis
                               retro      : PREPrec1.retro
                               thetapp    : pp120 } ;
             VARPREPPrec2 := { synppefs   : [synOPENGERUND]
                               mood       : nowh
                               specQ      : NPVARrec1.specQ
                               class      : PREPrec1.class
                               aspect     : PREPrec1.aspect
                               deixis     : PREPrec1.deixis
                               retro      : PREPrec1.retro
                               headkey    : PREPrec1.key
                               actsubcefs : PREPrec1.subcs
                               thetapp    : pp120 }
         >
      DECOMP
         <
          C1:synPREPNP_PREPOPENGERUND IN VERBPPROPrec2.synvpefs AND
             synPREPNP_PREPOPENGERUND IN VERBrec1.synvps AND
             VARPREPPrec1 = { synppefs NI synNP
                              mood      : relativexpmood 
                              specQ     : yesspec
                              thetapp   : pp120 } AND
             VARPREPPrec2 = { synppefs NI synOPENGERUND
                              mood      : nowh
                              specQ     : NPVARrec1.specQ
                              thetapp   : pp120 } AND
             NPVARrec2.NPhead = openingNP
          A1:VERBPPROPrec1 := VERBPPROPrec2;
             VERBPPROPrec1.synvpefs := [];
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] RVerbpattern7
\item[* relevant examples:] \mbox{}
\begin{description}
\item[subrule 1a/d:] PREPNP\_PREPNP\\
  (vp123): x1 talk to/with x2 about x3: I talked to/with my father about a 
  new car / about his financing our next car\\
  (vp123): x1 talk with x2 about x3: I talked with my 
  friends about our new house  (but see below under problems)
\item[subrule 2:] PREPNP\_PREPOPENGERUND\\
  (vp123): x1 agree with x2 (up)on x3 (They agreed with him (up)on selling the 
  house)
\end{description}
\item[* language:] (Dutch, English, Spanish) english
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] (name of rule, transformation or filter class)TC:
Verbpatternrules
\item[* date of creation:] 18-DEC-1986, 09-DEC-1987
\item[* author:] Agnes Mijnhout, margreet sanders
\item[* copied from:] Dutch RVerbpattern8
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 09-DEC-1987\ \ \ \ \ author: margreet sanders. See below under 
`presuppositions: rules'.
\item date: 30-AUG-1988\ \ \ \ \ author: margreet sanders, jan odijk. SpecQ, 
class, deixis, aspect, retro. For comment, see Verbpattern 6.
\item date: 01-JUN-1990\ \ \ \ \ author: Petra de Wit
addes subrule 2 (for comment see above)
\end{enumerate}
\item[* task:] Checks if the category of the variable is compatible with the 
categories of the arguments that the verb expects. Note the order of the 
arguments: it is assumed that the "indirect object" is placed in front, and is 
the second argument in Dutch as well, and 
should be combined with prepkey1. See below under `problems'.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] none
\item[\  \ suggested semantics:] none
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\
Values for the attribute `synvps' for basic verbs
\item rules:\\
These transformations follow the startrules\\
It is assumed that indirect objects formed with `to' + NP behave just like 
other prepobjs (this in contrast to the earlier rule, where a synvps [TONP\_PREPNP] 
differed from other [PREPNP\_PREPNP] patterns in the relation name, viz.\ {\em 
toobjrel\/} vs.\ {\em prepobjrel\/}). If this assumption is incorrect, an extra 
subrule should be added, together with the corresponding synvps.
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc.\ nr.\ 108 (Verbpatterns in 
Rosetta3)
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
For verbs that prefer (or optionally take) a reverse order of 
their prep-arguments (i.e.\ first the `direct object' or theme, then the 
indirect object or goal/adressee), 
no rule has been written yet. Perhaps these verbs 
should get a new verbpattern, thetavp132, which spells out this order. The 
alternative is a movement rule; however, the constraints on movement would 
depend on the combination of actual preps, e.g.\ talk to x about y, but talk 
about y with x (in contrast to what was written above).
\item modifications:\\

\end{enumerate}
\end{description}

