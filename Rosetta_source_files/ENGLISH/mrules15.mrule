\newpage
\begin{verbatim}
% RULE Rdeepsubst1
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       I1:rel1/T1,                       
                       mu3
                     ],
              mu4
            ]

  SUBST:
  m2: T3=I3::NP{NPrec1}[I5:mu5]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu2,
                       rel1/T2,
                       mu3
                     ],
              mu4
            ]
>


   MATCHCONDITIONS
      <
       m2: QUOTE_gsubstordercondition2(mu3,mu4,T3, CLAUSErec1.prosubject) AND
           NOT QUOTE_NegPhrase(T3)
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I5: NOT EXIST (mu5, [head/BIGPRO{}[mu10]])
       I1: rel1 IN [complrel, objrel] AND
           (T1.CAT IN [SENTENCE] OR
            (T1.CAT IN [NP] WITH T1.REC.NPhead IN [openingNP])
           )
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: NPrec1.cases = [] AND
              NPrec1.generic = nogeneric AND
              QUOTE_deixismax(CLAUSErec1.deixis, CLAUSErec1.superdeixis, 
                          NPrec1.superdeixis)                AND
              QUOTE_Deepsubst(T1, T3, T2, level)
          A1: @
         >

(*
cond 
 `ga op zoek naar NPVAR met index = LEVEL in T1; Check of NPVAR=NPrec1 except
                    for cases' (check voor gsubstorder special??)
 'indien gevonden, haal NPVAR weg, zet daar NPrec2[mu6] neer zet het geheel in 
T2

T3:NPrec1[mu5], T1
T4:NPrec2[mu6], T2
*)

&

\end{verbatim}
