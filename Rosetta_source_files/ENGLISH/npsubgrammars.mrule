\begin{verbatim}
% RULE RNPargmodsubst2                  (* provisional draft; 17-JAN-89 *)

< m1 : NP{NPrec1}[mu1,
                  head/CN{CNrec1}[mu5,
                                  head/I2::NOUN{NOUNrec1}[mu2],
                                  complrel/I1::SENTENCEVAR{SENTENCEVARrec1}
                                  ],
                  mu3
                 ]

SUBST:
  m2: SENTENCE{SENTENCErec1}[mu4]
>

< m1 : NP{NPrec1}[mu1,
                  head/CN{CNrec1}[mu5,
                                  head/I2::NOUN{NOUNrec1}[mu2],
                                  complrel/SENTENCE{SENTENCErec2}[mu4]
                                  ],
                  mu3
                 ]
>

   MATCHCONDITIONS
      <
       I1: SENTENCEVARrec1.index = LEVEL 
       I2: NOUNrec1.nounpatterns <> []
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1:SENTENCEVARrec1 = COPYT_sentencetovar(SENTENCErec1)
              C11: NPrec1.deixis = omegadeixis              AND
                   NPrec1.superdeixis = SENTENCErec1.superdeixis
              A11: @
              C12: NPrec1.deixis <> omegadeixis             AND
                   NPrec1.superdeixis = SENTENCErec1.deixis
              A12: @
          A1: SENTENCErec2 := SENTENCErec2;
              SENTENCErec2.superdeixis := omegadeixis  ;

         >
      DECOMP
         <
          C1: true
              C11: NPrec1.deixis = omegadeixis AND
                   SENTENCErec2.superdeixis = omegadeixis
              A11: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.superdeixis := NPrec1.superdeixis;
              C12: NPrec1.deixis <> omegadeixis AND
                   SENTENCErec2.superdeixis = omegadeixis  
              A12: SENTENCErec1 := SENTENCErec2;
                   SENTENCErec1.superdeixis := NPrec1.deixis;
          A1:SENTENCEVARrec1 := COPYT_sentencetovar(SENTENCErec2);
             SENTENCEVARrec1.index := LEVEL;
         >
&

\end{verbatim}
