\newpage
\begin{verbatim}
% TRANSFORMATION TOblControl6b
                          (* SENTENCE, subject antecedent *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu4],
                      mu5,
                      I2:complrel/SENTENCE{SENTENCErec1}
                                 [ I3:mu9,
                                   subjrel/T2,
                                   I4:mu6 
                                 ],
                      mu7 
                    ],
              mu8 
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu4],
                      mu5,
                      I2:complrel/SENTENCE{SENTENCErec1}
                                 [ I3:mu9,
                                   I4:mu6 
                                 ],
                      mu7 
                    ],
              mu8 
           ]
>

   MATCHCONDITIONS
      <
       I2: SENTENCErec1.PROSubject = true
       I3: ALL(mu9, I31:rel3/..)
           I31: rel3 IN [shiftrel, conjrel]
       I4: NOT EXIST(mu6, [shiftrel/..])
      >

<
   SUBRULE
      <
       T1:NPVAR{NPVARrec1}
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1}>

      COMP
         <
          C1: (VERBrec1.controller = subject) AND
              (NPVARrec1 = NPVARrec2)
          A1: @
         >

      DECOMP
         <
          C1: (VERBrec1.controller = subject) 
          A1: NPVARrec2 := NPVARrec1
         >


   SUBRULE
      <
       T1:CNVAR{CNVARrec1}
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1}>

      COMP
         <
          C1: (VERBrec1.controller = subject ) AND
              (CNVARrec1 = CNVARrec2)
          A1: @
         >

      DECOMP
         <
          C1: (VERBrec1.controller = subject)
          A1: CNVARrec2 := CNVARrec1
         >
>
&

\end{verbatim}
