\newpage
\begin{verbatim}

% RULE RWhToInfMood
< m1: I3::CLAUSE{CLAUSErec1}
                [ I1:shiftrel/T1,
                  I2:subjrel/T2,
                  mu1,
                  predrel/VERBP{VERBPrec1}
                         [rel1/VERB{VERBrec1}[mu2],
                          mu3
                         ],
                  mu5
                ]
>

< m : I4::SENTENCE{SENTENCErec1}
                  [ I1:shiftrel/T1,
                    I2:subjrel/T2,
                    mu1,
                    torel/TOCAT(KEY_toTOCATkey){TOCATrec1},
                    predrel/VERBP{VERBPrec1}
                           [rel1/VERB{VERBrec2}[mu2],
                            mu3
                           ],
                    mu5
                  ]
>

   MATCHCONDITIONS
      <
       I1 : T1.CAT IN [NP, PREPP, ADJP, ADVP] WITH
            T1.REC.mood = wh
       I2 : T2.CAT IN [NPVAR, CNVAR]
       I3 : CLAUSErec1.finiteness = infinite AND
            CLAUSErec1.PROsubject = true AND
            CLAUSErec1.infsort = omegainf AND
            CLAUSErec1.modus = omegamodus AND
            CLAUSErec1.aspect = perfective
       I4 : SENTENCErec1 = { mood       : whinterrogative
                             senttype   : subordinateclause
                             modus      : infinitive
                             finiteness : infinite
                             aspect     : perfective
                             PROsubject : true
                             infsort    : toinf
                             conjkey    : 0
                             adverbial  : false
                             temporal   : false
                             conjclass  : omegaTimeadvClass
                             conjdeixis : omegadeixis
                             conjaspect : omegaAspect
                             conjretro  : false }
      >

      COMP
         <
          C1: VERBrec1.modus = omegamodus
          A1: VERBrec2 := VERBrec1;
              VERBrec2.modus := infinitive;
              SENTENCErec1 := COPYT_clauseTOsentence(CLAUSErec1);
              SENTENCErec1 := { mood     : whinterrogative
                                senttype : subordinateclause
                                modus    : infinitive
                                infsort  : toinf }
            (* other attributes specific to sentence
               retain default values *)
         >

      DECOMP
         <
          C1: VERBrec2.modus = infinitive 
          A1: VERBrec1 := VERBrec2;
              VERBrec1.modus := omegamodus;
              CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modus := omegamodus;
              CLAUSErec1.infsort := omegainf
         >

&
\end{verbatim}
