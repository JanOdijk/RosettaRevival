\newpage
\begin{verbatim}
% TRANSFORMATION TextraposFinSent
< m1: CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                    [I2:mu2,
                     cliticrel/CLITIC{CLITICrec1}[mu3],
                     mu7,
                     complrel/I1::SENTENCE{SENTENCErec1}[mu4],
                     I3:mu5
                    ],
              mu6
            ]
>

< m : CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                    [I2:mu2,
                     cliticrel/CLITIC{CLITICrec1}[mu3],
                     mu7,
                     I3:mu5
                    ],
              mu6,
              complrel/I1::SENTENCE{SENTENCErec1}[mu4]
            ]
>

   MATCHCONDITIONS
      <
       I1:  SENTENCErec1.finiteness = finite
       I2:  NOT EXIST (mu2, [I21:rel1/..])
       I21: rel1 IN [objrel, indobjrel] 
       I3:  ALL (mu5, I31:rel2/..)
       I31: rel2 IN [vpadvrel, complrel, objrel, indobjrel]
      >

      COMP
         <
          C1:true
          A1:@
         >

      DECOMP
         <
          C1:true
          A1:@
         >
&

\end{verbatim}
