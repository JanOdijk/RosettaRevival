 *
 *  Remarks         : Module that provides a function to print the 
 *                    datastructure on the screen of each interface between
 *                    two major Rosetta components.
 *
 *EMP:::===================================================================*)

pragma C_include('interfaces.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE PRINTERF;
WITH INTERFACES;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : PRINTERF_Init
 *  Description     : Initializes the PRINTERF module
 *  Postcondition   : PRINTERF module initialized
 *
 *EMP:::===================================================================*)

PROCEDURE PRINTERF_Init;
EXTERNAL;


(*MPP:::===================================================================*
 *
 *  Procedure Name  : PRINTERF_Set
 *  Description     : Enables/disables the PRINTERF mode for a particular 
 *                    interface.
 *  Parameters      : value: boolean 
 *                    level: INTERFACES_LevelType
 *  Precondition    : Printerf_Init has been called
 *  Postcondition   : PRINTERF[level] = value
 *  Side Effects    : none
 *
 *EMP:::===================================================================*)

PROCEDURE PRINTERF_Set(level: INTERFACES_LevelType;
                        valeu: BOOLEAN);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : PRINTERF_Write
 *  Description     : General function to write the specified interface to
 *                    screen. Interf[level] will only appear on the screen if
 *                    the function call PRINTERF_Set(level, TRUE) has preceded.
 *  Parameters      : level: INTERFACES_LevelType
 *                    interf: INTERFACES_IfDescr
 *  Precondition    : PRINTERF_Init has been called
 *  Postcondition   : TRUE
 *  Side Effects    : IF PRINTERF_Set(level, TRUE) then the interface has been
 *                    printed on the screen.
 *
 *EMP:::===================================================================*)

PROCEDURE PRINTERF_Write(level: INTERFACES_leveltype;
                                   interf: INTERFACES_IfDescr);
EXTERNAL;


END {PRINTERF};
