SUBRULE  (* él = le; masc animate subject -> D0  
                     masc subject -> IO            *)
      <mu7: [I7:mu71]>                                       
      <mu8: [I7:mu71, rel8/PERSPRO{PERSPROrec1}
                      [head/BPERSPRO(KEY_elBPERSPROkey){BPERSPROrec1}]
            ]
      >       


   MATCHCONDITIONS
      <
       I7:  ALL (mu71, I71:rel7/..)
             I71: rel7 IN [seCLrel]  
      >

      COMP
         <
          C1: (NPrec1.persona = 3)             AND
              (NPrec1.numero = singular)       AND
              (NPrec1.genero = masc) 

              C11: ((VERBrec4.thetavp = vp123)                OR
                    ((VERBrec4.thetavp = vp120)        AND
                     (VERBrec4.synvps = [synNP]))       OR
                    ((VERBrec4.thetavp = vp012)        AND
                     (VERBrec4.synvps = [synANP_DONP])))
              A11: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
                   PERSPROrec1.forma := datCL             
              
              
              C12: (NPrec1.animate = yesanimate)                AND
                   ((VERBrec4.thetavp IN [vp100, vp010])     OR
                    ((VERBrec4.thetavp = vp120)        AND
                     (VERBrec4.synvps * [synNP] = []))       OR
                    ((VERBrec4.thetavp = vp012)    AND
                     (VERBrec4.synvps * [synANP_DONP] = [])))   
              A12: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1); 
                   PERSPROrec1.forma := acusLEcl
              
          
          A1: VERBrec3.status := VV;
              PERSPROrec1.numero := singular;
              PERSPROrec1.persona := 3;
              PERSPROrec1.genero := masc;
              rel8 := tresCLrel
         >

      DECOMP
         <
          C1: (PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1) EXCEPT FOR [forma])
                                                                         AND
              (PERSPROrec1.numero = singular)    AND
              (PERSPROrec1.persona = 3)          AND
              (PERSPROrec1.genero = masc )       AND
              (rel8 = tresCLrel)

              C11: (PERSPROrec1.forma = datCL)               AND 
                   ((VERBrec4.thetavp = vp123)             OR
                    ((VERBrec4.thetavp = vp120)       AND
                     (VERBrec4.synvps = [synNP]))    OR
                    ((VERBrec4.thetavp = vp012)       AND
                     (VERBrec4.synvps = [synANP_DONP])))
              A11: NPrec1 := COPYT_PERSPROtoNP(PERSPROrec1); 
                   NPrec1.cases := [Nominative]
              C12: (PERSPROrec1.animate = yesanimate)        AND
                   (PERSPROrec1.forma = AcusLEcl)             AND
                   ((VERBrec4.thetavp IN [vp100, vp010])   OR
                    ((VERBrec4.thetavp = vp120)         AND
                     (VERBrec4.synvps * [synNP] = []))    OR
                    ((VERBrec4.thetavp = vp012)     AND
                     (VERBrec4.synvps * [synANP_DONP] = [])))
              A12: NPrec1 := COPYT_PERSPROtoNP(PERSPROrec1); 
                   NPrec1.cases := [Nominative]
 

          A1: @
            
     >
   

   
