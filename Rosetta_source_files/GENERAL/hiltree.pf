PACKAGE HILtree;
WITH LIILRULES;

CONST
   HNIL = 0;

(*MPT:::===================================================================*
 *
 *  Type name      : HILtree_pLIRecord, HILtree_LIRecord,
 *                   HILtree_pDtree.
 *  Description    : the language independent extras only used in the parsers, 
 *                   Dtree is used to remember from which Dtree this HyperILtree
 *                   resulted. Done indiquates whether this Dtree has been
 *                   remembered or not.
 *
 *EMP:::===================================================================*)

TYPE
   HILtree_pHyperILtree   = INTEGER;
   HILtree_pDnode         = ^INTEGER;
   HILtree_pLIRecord      = ^HILtree_LIRecord;
   HILtree_LIRecord       = RECORD
                               Dtree : HILtree_pDnode;
                               done  : BOOLEAN;
                            END;


(*MPT:::===================================================================*
 *
 *  Type name      : HILtree_pHyperILtree,HyperILtree,pTupleOfHyperILtree,TupleOfHyperILtree,
 *                   HILtree_pLoHyperILtree, HILtree_LoHyperILtree
 *  Description    : the types to make a HyperILtree
 *                   - a HyperILtree node contains a tuple of HyperILtrees
 *                     for its arguments. Futhermore it contains conceptually
 *                     a set of rule nodes. This set is implemented as a
 *                     linked list.
 *                   - a HyperILtree leave is either an empty HyperILtree (DEPS) or the name
 *                     of a basic expression or the name of a variable.
 *                   A tuple of HyperILtrees is implemented by means of a list of
 *                   HyperILtrees (HILtree_LoHyperILtree).
 *                   A HyperILtree contains also some information that is only
 *                   relevant for the implementation of A-Transfer/ G-Transfer,
 *                   this is hidden in HILtree_pLIRecord^.
 *
 *   Note            In order to be able to handle individual ILDtrees in such
 *                   a HyperILtree the record type HyperILtree is extended with a
 *                   field (called `cur'). The routine MarkFirstHyperILtree lets
 *                   this mark field point to the 'first' Dtree in a
 *                   HyperILtree and the routine MarkNextHyperILtree marks the
 *                   'next' Dtree.
 *
 *
 *                   ILtree =     ---------------
 *                                |  R          |
 *                          ........ args.first |
 *                          .     |  args.last .......
 *                          .     ---------------    .
 *                          .                        .
 *                      ---------
 *                      | next .....    etc
 *                      | arg   |
 *                      --- . ---
 *                          .
 *                      ---------
 *                      | R     |
 *                      | args  |
 *                      ---------
 *                                       .                 .
 *                                       .                 .
 *                                       .                 .
 *                                       .                 .
 *                   HyperILtree = -------.-------       ---.----     --------
 *                                |  Elts.last  |       | nxt  |     |      |
 *                                |  Elts.first .......... arg ........     |
 *                                |  nrargs     |       |      |     | R    |
 *                          ........ args.first |       |      |     |params|
 *                          .     |  args.last .......  --------     --------
 *                          .     ---------------    .
 *                          .                        .
 *                      --------
 *                      | next .......    etc
 *                      | arg  |   
 *                      ---.----  
 *                         .           
 *                         .
 *    HyperILtree     --------------
 *                   | Elts       ...
 *                   | nrargs     |
 *                   | args.first |
 *                   | args.last  |
 *                   --------------
 *
 *
 *  Type name      : HILtree_pLoHyperILtree, HILtree_LoHyperILtree,
 *                   HILtree_TupleOfHyperILtree
 *
 *EMP:::===================================================================*)

{  HILtree_pHyperILtree   = ^HILtree_HyperILtree; }
   HILtree_pLoHyperILtree = INTEGER;
   HILtree_LoHyperILtree  = RECORD
                                   arg:HILtree_pHyperILtree;
                                   next:HILtree_pLoHyperILtree
                                END {RECORD};
   HILtree_TupleOfHyperILtree = RECORD
                        	     first,last:HILtree_pLoHyperILtree
                                  END {RECORD};
   HILtree_SetOfHyperILtree = HILtree_TupleOfHyperILtree;

   HILtree_pHyperNodeElt   = INTEGER;
   HILtree_pLoHyperNodeElt = INTEGER;
   HILtree_LoHyperNodeElt  = RECORD
                                   arg:HILtree_pHyperNodeElt;
                                   next:HILtree_pLoHyperNodeElt
                                END {RECORD};
   HILtree_SetOfHyperNodeElt = RECORD
                        	     first,last:HILtree_pLoHyperNodeElt;
                                     cur       : HILtree_pLoHyperNodeElt;
                                     NrOfElts  : INTEGER;
                                  END {RECORD};
   HILtree_pSetOfHyperNodeElt = ^HILtree_SetOfHyperNodeElt;
   HILtree_NodeKind = ( HILtree_BasicNode,
                           HILtree_VarNode,
                           HILtree_SubstRuleNode,
                           HILtree_RuleNode  );

   HILtree_HyperILtree =
      RECORD
         synbonus : INTEGER;
         LI       : HILtree_pLIrecord;
         Elts     : HILtree_SetOfHyperNodeElt;
         CASE IsRuleNode : BOOLEAN OF
         FALSE: (BasicNodeKind : HILtree_NodeKind);
         TRUE : (nrOfArgs : INTEGER;
                 args     : HILtree_TupleOfHyperILtree;
                 EndOfSg  : BOOLEAN;
                 CASE RuleNodeKind : HILtree_NodeKind OF
                 HILtree_RuleNode : ( );
                 HILtree_SubstRuleNode : ( substituent: INTEGER))
      END {RECORD};

   HILtree_HyperNodeElt =
      RECORD
         sembonus : INTEGER;
         CASE nodeKind : HILtree_NodeKind OF
         HILtree_VarNode : (index : INTEGER);
         HILtree_BasicNode : ( key : INTEGER);
         HILtree_RuleNode  : (   R          : LIILRules_RuleIndex;
                                 parameters : LIILRules_LIParameters)
      END {RECORD};



(*MPF:::===================================================================*
 *
 *  Procedure Name  : HILtree_MarkFirstDtree
 *  Description     : Marks the first Dtree in a HyperILtree.
 *  Parameters      : VAR d : HILtree_pHyperILtree
 *  Precondition    : 
 *  Postcondition   : It is implemented by marking the first Dtree of each
 *                    'superson' of the top level of HyperILtree d.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE HILtree_MarkFirstDtree (VAR d : HILtree_pHyperILtree);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Function Name  : HILtree_MarkNextDtree
 *  Description    : Marks the next Dtree in HyperILtree d. Returns FALSE iff
 *                   there are no more Dtrees in d, in this case the first Dtree
 *                   will have been marked again.
 *                   It is implemented by marking the next Dtree in the first
 *                   rule node of the top level of HyperILtree d. If this was
 *                   impossible (all Dtrees in the first rule node list had been
 *                   marked already and the first is marked again), then the
 *                   same is tried for the second hyper node, etc. If it was
 *                   impossible for all the sons, then FALSE is returned.
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION HILtree_MarkNextDtree (VAR d : HILtree_pHyperILtree)
                    : BOOLEAN;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Function Name  : HILtree_ExistsNextDtree
 *  Description    : Checks the existence of the next Dtree in HyperILtree d. 
 *                   Returns FALSE iff
 *                   there are no more Dtrees in d.
 *                   It is implemented by marking the next Dtree in the first
 *                   rule node of the top level of HyperILtree d. If this was
 *                   impossible (all Dtrees in the first rule node list had been
 *                   marked already and the first is marked again), then the
 *                   same is tried for the second hyper node, etc. If it was
 *                   impossible for all the sons, then FALSE is returned.
 *  Parameters     : 
 *  Result         : 
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION HILtree_ExistsNextDtree (VAR d : HILtree_pHyperILtree)
                    : BOOLEAN;
EXTERNAL;



