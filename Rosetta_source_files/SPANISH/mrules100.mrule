              ADJrec1 = AUX_ADJonmismo EXCEPT FOR [genero, numero] AND
              ADJrec1.genero = fem AND
              ADJrec1.numero = plural AND
              ADJPrec1 = AUX_ADJPonmismo EXCEPT FOR [genero, numero] AND
              ADJPrec1.genero = fem AND
              ADJPrec1.numero = plural AND
              NPVARrec1 =  {
                             persona : 2 
