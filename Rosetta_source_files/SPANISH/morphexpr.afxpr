(* IOclitics: *)
 | ( SFKcliticOI )
(* PrepPronFuerte: *)
 | ( SFKpronFuerte )
(* posADJ: *)
 | ( SFKposADJ | SFKregPL )

(* VARIA:                                                                  *)
(* posPRO: *)
 | ( SFKposAdjFuerte | SFKregFem | SFKregPL )
(* DemAdj: *)
 | ( SFKmascDEMADJpl | SFKfemDEMADJsg | SFKfemDEMADJpl )
(* DemPro: *)
 | ( SFKmascDEMPROpl | SFKfemDEMPROsg | SFKfemDEMPROpl | SFKneutDEMPRO )
(* WhADJ: *)
 | ( SFKregFEM )
(* WhPRO: *)
 | ( SFKregFEM )
(* CARDINALS *)
 | (  ([ SFKregPL | SFKirrPL ] .[SFKregFem] .[SFKo])
      ( SFK0 | SFK1 | SFK2 | SFK3 | SFK4 | SFK5 | SFK6 | SFK7 | SFK8 | SFK9 )
      { SFK0 | SFK1 | SFK2 | SFK3 | SFK4 | SFK5 | SFK6 | SFK7 | SFK8 | SFK9 }
   )
) (* end other categories *)
]
EXPREND
