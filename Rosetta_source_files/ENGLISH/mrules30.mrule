                [ mu1,
                  predrel/VERBP{VERBPrec1}
                         [ mu7,
                           head/VERB{VERBrec1}[mu6],
                           I2:mu2,
                           I5:mu3
                         ],
                  mu4
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.synvpefs * AUX_emptyObjVps <> []
       I2: ALL (mu2, I21:rel1/..)
         I21: rel1 IN AUX_preObjVPrels
       I3: ALL (mu3, I31:rel2/..)
       I5: ALL (mu3, I31:rel2/..) AND
           NOT EXIST (mu3, [../EMPTYVAR{}]) AND
           NOT EXIST (mu3, [../VARPREPP{} [ I51:mu5] ])
         I31: rel2 IN AUX_postObjVPrels
         I51: EXIST (mu5, [../EMPTYVAR{}])
       I4: EMPTYVARrec1.index = LEVEL
       I9: CLAUSErec2.synvpefs * AUX_emptyObjVps <> []
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: EMPTYVARrec1 = { person : 3
                               number : omeganumber
                               gender : omegagender }
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.synvpefs := 
                     CLAUSErec1.synvpefs * AUX_emptyObjVps
         >
      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := 
                     CLAUSErec2.synvpefs * AUX_emptyObjVps;
              EMPTYVARrec1 := { index  : LEVEL
                                person : 3
                                number : omeganumber
                                gender : omegagender }
         >
&

\end{verbatim}
