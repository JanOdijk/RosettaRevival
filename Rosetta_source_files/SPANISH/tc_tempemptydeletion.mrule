SPANISH 47
&
\newpage
\begin{verbatim}
%
% FILTER Frefdeletion
< m: SENTENCE{SENTENCErec1}
              I1: [I2: mu1,
                   tempadvrel/ADVP{ADVPrec1}
                             [head/ADV{ADVrec1}
                                  [head/SUBADV{SUBADVrec1}
                                       [head/T1]
                                  ] 
                              ],
                    I3: mu2 
                   ]
>
   MATCHCONDITIONS
      <
       I1: RIGHTTOLEFT
       I2: (ALL(mu1, I4: rel1/..)) AND
           (QUOTE_temprefnotfound(mu1))
       I3: (NOT EXIST (mu2, [I4: rel1/..])) AND
           (QUOTE_temprefnotfound(mu2))
       I4: rel1 IN [head, leftdislocrel, shiftrel, subjrel, cliticrel, predrel,
                    locadvrel, tempadvrel, conjrel, meltnegrel,
                    negrel, posrel, vpadvrel]
      >

<
   SUBRULE (* presrefempty *)
      < T1: BADV(AUX_presrefemptykey){BADVrec1} >
 
          <
          C1: (ADVPrec1 = AUX_advpONprsrfempty) AND
              (ADVrec1 = AUX_advONprsrfempty) AND
              (SUBADVrec1 = COPYT_btosubadv(BADVrec1)) AND
              (SENTENCErec1.tiempo = presente) 
          A1: @
         >

  SUBRULE (* pastrefempty *)

      < T1: BADV(AUX_pastrefemptykey){BADVrec1} >

         <
          C1: (ADVPrec1 = AUX_advpONpstrfempty) AND
              (ADVrec1 = AUX_advONpstrfempty) AND
              (SUBADVrec1 = COPYT_btosubadv(BADVrec1)) AND
              (SENTENCErec1.tiempo = pasado) 
          A1: @
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Frefdeletion
\item[* relevant examples:]
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC: tempemptydeletion
\item[* date of creation:] 18-MAR-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Trefdeletion 
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 11/11/88\ \ \ \ \ author:  Lisette Appelo
\item date: 15/10/90\ \ \ \ \ author:  Lisette Appelo\\
Changed topnode from CLAUSE to SENTENCE
\end{enumerate}
\item[* task:] Filter abstract temporal reference 
adverbs in finite sentences.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] There is an 
abstract adverb for present and past reference.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:11/11/88: deleted condition on finiteness of CLAUSE. The 
superdeixisadaptation rules take care of the determination of the deixis value 
of infinite (and finite) complement clauses.\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% TRANSFORMATION trefdeletion
< m1: SENTENCE{SENTENCErec1}
              I1: [I2: mu1,
                   tempadvrel/ADVP{ADVPrec1}
                             [head/ADV{ADVrec1}
                                  [head/SUBADV{SUBADVrec1}
                                       [head/T1]
                                  ] 
                              ],
                    I3: mu2 
                   ]
>

< m : SENTENCE{SENTENCErec1}
              I1: [I2: mu1,
                   I3: mu2
                  ]
>
   MATCHCONDITIONS
      <
       I1: RIGHTTOLEFT
       I2: (ALL(mu1, I4: rel1/..)) AND
           (QUOTE_temprefnotfound(mu1))
       I3: (NOT EXIST (mu2, [I4: rel1/..])) AND
           (QUOTE_temprefnotfound(mu2))
       I4: rel1 IN [head, leftdislocrel, shiftrel, subjrel, cliticrel, predrel,
                    locadvrel, tempadvrel, conjrel, meltnegrel, 
                    negrel, posrel, vpadvrel]
      >

<
   SUBRULE (* presrefempty *)
      < T1: BADV(AUX_presrefemptykey){BADVrec1} >
      < >

      COMP
         <
          C1: (ADVPrec1 = AUX_advpONprsrfempty) AND
              (ADVrec1 = AUX_advONprsrfempty) AND
              (SUBADVrec1 = COPYT_btosubadv(BADVrec1)) AND
              (SENTENCErec1.tiempo = presente)
          A1: @
         >
      DECOMP
         <
          C1: (SENTENCErec1.tiempo = presente) 
          A1: ADVPrec1 := AUX_advpONprsrfempty;
              ADVrec1 := AUX_advONprsrfempty;
              SUBADVrec1 := COPYT_btosubadv(BADVrec1);

         >

   SUBRULE (* pastrefempty *)
      < T1: BADV(AUX_pastrefemptykey){BADVrec1} >
      < >

      COMP
         <
          C1: (ADVPrec1 = AUX_advpONpstrfempty) AND
              (ADVrec1 = AUX_advONpstrfempty) AND
              (SUBADVrec1 = COPYT_btosubadv(BADVrec1)) AND
              (SENTENCErec1.tiempo = pasado) 
          A1: @
         >

      DECOMP
         <
          C1:(SENTENCErec1.tiempo = pasado) 
          A1: ADVPrec1 := AUX_advpONpstrfempty;
              ADVrec1 := AUX_advONpstrfempty;
              SUBADVrec1 := COPYT_btosubadv(BADVrec1);
         >
>
&

\end{verbatim}
