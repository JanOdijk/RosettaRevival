      <
       I1: singular  IN NOUNrec1.numbers  AND NOUNrec1.human = yeshuman
       I2: singular  IN PROPERNOUNrec1.numbers 
      > 


      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&
\end{verbatim}
