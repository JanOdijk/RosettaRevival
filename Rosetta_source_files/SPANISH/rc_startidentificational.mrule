\newpage
\begin{verbatim}
% RULE RidentRefvarInsert
< m1: NPPROP{NPPROPrec1}
            [ I4:mu2, idrel/T2, I1:mu1, I3:mu3 ]

  m2: T1 
>

< m : NPPROP{NPPROPrec1}
            [ I4:mu2,
              idrel/T2,
              I1:mu1,
              I2:tempadvrel/T1,
              I7:mu3
            ]
>
   MATCHCONDITIONS
      <
       I1: ALL(mu1, locadvrel/..) 
       I4: QUOTE_temprefnotfound(mu2) AND
           QUOTE_tempretronotfound(mu2) AND
           QUOTE_tempdurnotfound(mu2)
       I3: NOT EXIST(mu3, [locadvrel/..]) AND
           QUOTE_temprefnotfound(mu3) AND
           QUOTE_tempretronotfound(mu3) AND
           QUOTE_tempdurnotfound(mu3)
       I7: NOT EXIST(mu3, [I71:rel7/..])
           I71: rel7 IN [locadvrel, tempadvrel, sentadvrel]
       I2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
       m2: T1.CAT IN [ADVPVAR, PREPPVAR, SENTENCEVAR]
      >

<
   SUBRULE (* 1. ADVPVAR *)
      < T1: ADVPVAR{ADVPVARrec1} >
      < T1: ADVPVAR{ADVPVARrec1} >

      COMP
         <
          C1: ADVPVARrec1.class = reference AND
              ADVPVARrec1.retro = false
          A1: @
         >

      DECOMP
         <
          C1: ADVPVARrec1.class = reference AND
              ADVPVARrec1.retro = false
          A1: @
         >

   SUBRULE (* 2. PREPPVAR *)
      < T1: PREPPVAR{PREPPVARrec1} >
      < T1: PREPPVAR{PREPPVARrec1} >

      COMP
         <
          C1: PREPPVARrec1.class = reference AND
              PREPPVARrec1.retro = false
          A1: @
         >

      DECOMP
         <
          C1: PREPPVARrec1.class = reference AND
              PREPPVARrec1.retro = false
          A1: @
         >

   SUBRULE (* 3. SENTENCEVAR *)
      < T1: SENTENCEVAR{SENTENCEVARrec1} >
      < T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <

          C1: SENTENCEVARrec1.conjclass = reference AND
              SENTENCEVARrec1.conjretro = false
          A1: @
         >

      DECOMP
         <
          C1: SENTENCEVARrec1.conjclass = reference AND
              SENTENCEVARrec1.conjretro = false
          A1: @
         >
>
&

\end{verbatim}
