\newpage
\begin{verbatim}
% RULE RppNPmod
< m1:PREPP{PREPPrec1}[mu2] 
  m2:NP{NPrec1}[mu3] 
>

< m :PREPP{PREPPrec1}
          [ modrel/NP{NPrec2}[mu4],
            mu2
          ] 
>

      COMP
         <
          C1: unitnoun  IN NPrec1.actsubcs AND
              NPrec1.supertiempo = PREPPrec1.supertiempo AND
              NPrec1.generic = nogeneric AND
              NPrec1.cases = []
          A1: QUOTE_Assigncase(NPrec1, mu3,NPrec2, mu4,[accusative]);
              NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative] 
         >
      DECOMP
         <
          C1: unitnoun  IN NPrec2.actsubcs AND
              accusative IN NPrec2.cases AND
              NPrec2.generic = omegageneric AND
              NPrec2.supertiempo = omegatiempo
          A1: QUOTE_Assigncase(NPrec2, mu4,NPrec1, mu3,[]);
              NPrec1 := NPrec2;
              NPrec1.supertiempo := PREPPrec1.supertiempo;
              NPrec1.generic := nogeneric;
              NPrec1.cases := [] 
         >


&

\end{verbatim}
