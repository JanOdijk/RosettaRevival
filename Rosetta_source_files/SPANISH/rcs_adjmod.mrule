% RULE RADJDegreemod2b    (* te ... om mee te nemen *)
            
< m1: ADJPPROP{ADJPPROPrec1}[mu1,
                             predrel/ADJP{ADJPrec1},
                                     [mu2,
                                      head/T1,
                                      mu4 
                                     ]
                            ]  
  m2: ADVP{ADVPrec1}[head/T3,
                     I1:paramodrel/SENTENCE{SENTENCErec1}[mu5]
                    ]
