ENGLISH 64
&
\begin{verbatim}
%
%RULE RDETderivation
< m1: BDET{BDETrec1} 
>

< m : DET{DETrec1}[head/BDET{BDETrec1}]
>

      COMP
         <
          C1: true
          A1: DETrec1 := 
                        { req         : BDETrec1.req
                          env         : BDETrec1.env      
                          possnietnp  : BDETrec1.possnietnp 
                          definite    : BDETrec1.definite
                          posspred    : BDETrec1.posspred
                          possnumbers : BDETrec1.possnumbers 
                          posscomas   : BDETrec1.posscomas
                          mood        : BDETrec1.mood
                          syntquant   : BDETrec1.syntquant 
                         }
(*          A1: DETrec1 := COPYT_BDETtoDET(BDETrec1)  *)
         >
      DECOMP
         <
          C1: DETrec1 = (* COPYT_BDETtoDET(BDETrec1) *)
                        { req         : BDETrec1.req
                          env         : BDETrec1.env      
                          possnietnp  : BDETrec1.possnietnp 
                          definite    : BDETrec1.definite
                          posspred    : BDETrec1.posspred
                          possnumbers : BDETrec1.possnumbers 
                          posscomas   : BDETrec1.posscomas
                          mood        : BDETrec1.mood
                          syntquant   : BDETrec1.syntquant  (* attribute has become 
                                                       irrelevant *)
                         }
          A1: @
         >

&

\end{verbatim}
