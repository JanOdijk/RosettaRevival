/* hn : hypernode window */

object hn_window : XmFormDialog {
    arguments {
	XmNdialogTitle	= N_hn_window;
        arguments form_dialog_args;
    };
    controls {
	XmRowColumn      hn_button_box;
        XmScrolledWindow hn_output_window;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_hn_window + DEFAULT_BUTTON_OFFSET*X_hn_ok_button);
    };
};

object hn_button_box : XmRowColumn {
    arguments {
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_hn_ok_button;
                XmNsensitive    = false;
	    };
	    callbacks {
                MrmNcreateCallback  = procedure XwuCreateWidget (X_hn_ok_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_hn_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_hn_attr_button;
                XmNsensitive    = false;
	    };
	    callbacks {
        	MrmNcreateCallback = procedure XwuCreateWidget(
                    X_hn_attr_button);
		XmNactivateCallback = procedure 
		    XwbAction (X_hn_attr_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_hn_help_button;
	    };
	    callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_hn_help_button);
		XmNactivateCallback = procedure XwhAction (X_hn_help_button);
	    };
	};
    };
};

object hn_output_window : XmScrolledWindow {
    arguments {
	XmNtopAttachment	= XmATTACH_FORM;
	XmNleftAttachment       = XmATTACH_FORM;
	XmNrightAttachment	= XmATTACH_FORM;
	XmNbottomAttachment	= XmATTACH_WIDGET;
	XmNbottomWidget		= XmRowColumn hn_button_box;

	XmNscrollingPolicy      = XmAUTOMATIC;
	XmNworkWindow		= user_defined hn_area;
        XmNheight	        = 400;
	XmNwidth	        = 200;
    };
    controls {
        user_defined hn_area;
    };
};

object hn_area : user_defined procedure AttrCreate () {
    arguments {
	XmNverticalSpace	= 1;
	XmNhorizontalSpace	= 20;
        XmNborderWidth          = 0;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_hn_area);
    };
};
