\newpage
\begin{verbatim}
% RULE Rretroperfective
< m1: CLAUSE{CLAUSErec1}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [rel1/VERB{VERBrec1}[mu4],
                     mu2
                    ],
             I1: mu3
            ] 
>

< m : CLAUSE{CLAUSErec2}
            [mu1,
             predrel/VERBP{VERBPrec1}
                    [auxrel/VERB{VERBrec3}
                           [head/SUBVERB{SUBVERBrec1}
                               [head/T2]
                           ],
                     rel1/VERB{VERBrec2}[mu4],
                     mu2
                    ],
             I1: mu3
            ] 

>
   MATCHCONDITIONS
      <
       I1: EXIST(mu3, [tempadvrel/..])
      >

<
   SUBRULE

      < mu3: [mu5, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu6] >
      < mu3: [mu5, I2: tempadvrel/ADVPVAR{ADVPVARrec1}[ ], mu6] 
        T2: BVERB(AUX_haberbverbkey){BVERBrec1}
      >
   MATCHCONDITIONS
      <
       I2: (ADVPVARrec1.retro = true) 

      >

      COMP
         <
          C1: ((CLAUSErec1.aspecto = perfectivo) AND
               (VERBrec1.aspecto = omegaaspecto) AND
               (VERBrec1.modo = omegamodo) AND
               (VERBrec1.genero = omegagenero) AND
               (VERBrec1.numero = omeganumero) AND
               (VERBrec1.futuro = nofuturo) AND
               (CLAUSErec1.retro = false)
               )
              C11: true
              A11: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
                   VERBrec3.aspecto := omegaaspecto;
                   (* other attributes retain their default values *)
              C12: true
              A12: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
                   VERBrec3.aspecto := imperfectivo;
                   (* perfective form is not modern Spanish anymore *)
                   (* other attributes retain their default values *)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              VERBrec2.genero := masc;
              VERBrec2.numero := singular;
         >
      DECOMP
         <
          C1: ((CLAUSErec2.retro = true) AND
               (CLAUSErec2.aspecto = perfectivo) AND
               (VERBrec2.genero = masc) AND
               (VERBrec2.numero = singular) AND
               (VERBrec2.aspecto = omegaaspecto) AND
               (VERBrec2.futuro = nofuturo) AND
               (VERBrec2.modo = ptcpas)
              ) 
              C11:(VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
                  (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
                  (VERBrec3 =
                  { 
                   numero       : omeganumero   
                   persona      : 3   
                   modo         : omegamodo
                   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
                   futuro       : nofuturo
                   status       : bareV
                  }
                 )
                 (* the default values for these attributes *)
              A11: @
              C12:(VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
                  (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
                  (VERBrec3 =
                  { 
                   numero       : omeganumero   
                   persona      : 3   
                   modo         : omegamodo
                   tiempo       : omegatiempo 
                   aspecto      : imperfectivo
                   futuro       : nofuturo
                   status       : bareV
                  }
                 )
                 (* the default values for these attributes *)
              A12: @
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;              
              VERBrec1.genero := omegagenero;
              VERBrec1.numero := omeganumero;
         >

   SUBRULE
      < mu3: [mu5, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu6] >
      < mu3: [mu5, I2: tempadvrel/PREPPVAR{PREPPVARrec1}[ ], mu6] 
        T2: BVERB(AUX_haberbverbkey){BVERBrec1}
      >

   MATCHCONDITIONS
      <
       I2: (PREPPVARrec1.retro = true) 

      >

      COMP
         <
          C1: ((CLAUSErec1.aspecto = perfectivo) AND
               (CLAUSErec1.aktionsarts * [stative] = []) AND
               (VERBrec1.aspecto = omegaaspecto) AND
               (VERBrec1.modo = omegamodo) AND
               (VERBrec1.genero = omegagenero) AND
               (VERBrec1.numero = omeganumero) AND
               (VERBrec1.futuro = nofuturo) AND
               (CLAUSErec1.retro = false)
              )
              C11: true
              A11: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
                   VERBrec3.aspecto := omegaaspecto;
                   (* other attributes retain their default values *)
              C12: true
              A12: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
                   VERBrec3.aspecto := imperfectivo;
                   (* other attributes retain their default values *)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              VERBrec2.genero := masc;
              VERBrec2.numero := singular;
         >
      DECOMP
         <
          C1: ((CLAUSErec2.retro = true) AND
               (CLAUSErec2.aspecto = perfectivo) AND
               (CLAUSErec2.aktionsarts * [stative] = []) AND
               (VERBrec2.genero = masc) AND
               (VERBrec2.numero = singular) AND
               (VERBrec2.aspecto = omegaaspecto) AND
               (VERBrec2.futuro = nofuturo) AND
               (VERBrec2.modo = ptcpas)
              ) 
              C11:(VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
                  (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
                  (VERBrec3 =
                  { 
                   numero       : omeganumero   
                   persona      : 3   
                   modo         : omegamodo
                   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
                   futuro       : nofuturo
                   status       : bareV
                  }
                 )
                 (* the default values for these attributes *)
              A11: @
              C12:(VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
                  (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
                  (VERBrec3 =
                  { 
                   numero       : omeganumero   
                   persona      : 3   
                   modo         : omegamodo
                   tiempo       : omegatiempo 
                   aspecto      : imperfectivo
                   futuro       : nofuturo
                   status       : bareV
                  }
                 )
                 (* the default values for these attributes *)
              A12: @
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;              
              VERBrec1.genero := omegagenero;
              VERBrec1.numero := omeganumero;
         >

   SUBRULE
      < mu3: [mu5, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu6] >
      < mu3: [mu5, I2: tempadvrel/SENTENCE{SENTENCErec1}[mu9], mu6] 
        T2: BVERB(AUX_haberbverbkey){BVERBrec1}[]
      >
   MATCHCONDITIONS
      <
       I2: (SENTENCErec1.conjretro = true) 

      >

      COMP
         <
          C1: ((CLAUSErec1.aspecto = perfectivo) AND
               (CLAUSErec1.aktionsarts * [stative] = []) AND
               (VERBrec1.aspecto = omegaaspecto) AND
               (VERBrec1.modo = omegamodo) AND
               (VERBrec1.genero = omegagenero) AND
               (VERBrec1.numero = omeganumero) AND
               (VERBrec1.futuro = nofuturo) AND
               (CLAUSErec1.retro = false)
              )
              C11: true
              A11: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
                   VERBrec3.aspecto := omegaaspecto;
                   (* other attributes retain their default values *)
              C12: true
              A12: SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
                   VERBrec3 := COPYT_subtoverb(SUBVERBrec1);
                   VERBrec3.aspecto := imperfectivo;
                   (* other attributes retain their default values *)
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.retro := true;
              VERBrec2 := VERBrec1;
              VERBrec2.modo := ptcpas;
              VERBrec2.genero := masc;
              VERBrec2.numero := singular;
         >
      DECOMP
         <
          C1: ((CLAUSErec2.retro = true) AND
               (CLAUSErec2.aspecto = perfectivo) AND
               (CLAUSErec2.aktionsarts * [stative] = []) AND
               (VERBrec2.genero = masc) AND
               (VERBrec2.numero = singular) AND
               (VERBrec2.aspecto = omegaaspecto) AND
               (VERBrec2.futuro = nofuturo) AND
               (VERBrec2.modo = ptcpas)
              ) 
              C11:(VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
                  (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
                  (VERBrec3 =
                  { 
                   numero       : omeganumero   
                   persona      : 3   
                   modo         : omegamodo
                   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
                   futuro       : nofuturo
                   status       : bareV
                  }
                 )
                 (* the default values for these attributes *)
              A11: @
              C12:(VERBrec3 = COPYT_subtoverb(SUBVERBrec1)) AND
                  (SUBVERBrec1 = COPYT_btosubverb(BVERBrec1)) AND
                  (VERBrec3 =
                  { 
                   numero       : omeganumero   
                   persona      : 3   
                   modo         : omegamodo
                   tiempo       : omegatiempo 
                   aspecto      : imperfectivo
                   futuro       : nofuturo
                   status       : bareV
                  }
                 )
                 (* the default values for these attributes *)
              A12: @
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.retro := false;
              VERBrec1 := VERBrec2;
              VERBrec1.modo := omegamodo;              
              VERBrec1.genero := omegagenero;
              VERBrec1.numero := omeganumero;

         >

>
&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] Rretroperfective
\item[* relevant examples:]  CL(..... haber durmido desde ayer)
\item[* language:] SPANISH
\item[* kind of rule:] M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] Retrospectivity rules
\item[* date of creation:] 16-MAR-1988 
\item[* author:] Lisette appelo
\item[* copied from:] Rretroimperfective Spanish
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 17/10/90\ \ \ \ \ author: Lisette Appelo\\
Removed condition that the retro adverbial has to have imperfective aspect. 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Between the reference interval Re and the reference Rs holds a
relation "until".\\
This rule is meant for a clause that is marked for perfective aspect, has not 
stative Aktionsart and that
contains a reference adverbial variable
that has for its attribute retro the value true and for aspect the value 
imperfective.\\
The resulting clause is
marked for retrospectivity and the auxiliary ver {\em haber} is introduced. 
The main verb gets modus {\em ptcpas}.
\item[\ \ strategy:] deviation from accepted proposal of doc. 53. The reference 
time adverbial variables are no longer introduced by the retrospectivity rules 
but in a separate rule class following the retrospectivity rule class.
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:] T1 stands for a reference time adverbial 
variable of category ADVP, PREPP or SENTENCE.
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of
 parameters) 
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] function application (see also task)\\
This rule has the same semantics as Rretroperfective of SPANISH
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ 

\item rules:\\ perfective aspect rule and rule introducing a variable for a 
retrospective time adverbial.

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\
This rule has the same semantics as Rretroperfective

\item in other languages:\\
This rule corresponds to the Rretro rules in other grammars
\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: CONJSENT has been substituted by SENTENCE. Therefore, the 
generalisation over the time attribute {\em retro} is not possible anymore. the 
rule had to be split up in 3 subrules.\\

\end{enumerate}
\end{description}


