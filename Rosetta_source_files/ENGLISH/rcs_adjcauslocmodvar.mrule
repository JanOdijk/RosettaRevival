\begin{verbatim}
% RULE RAdjSentadvVar
< m1: ADJPPROP{ADJPPROPrec1}
              [ I1:mu1,
                predrel/ADJP{ADJPrec1}[mu2],
                mu3
              ]

  m2: T2
>

< m :ADJPPROP{ADJPPROPrec1}
             [ leftdislocrel/T2,
               I1:mu1,
               predrel/ADJP{ADJPrec1}[I2:mu2],
               I3:mu3
             ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [leftdislocrel/..])
       I2: NOT EXIST (mu2, [I21:rel1/..])
       I3: NOT EXIST (mu3, [I21:rel1/..])
         I21: rel1 IN [locadvrel, tempadvrel, postsentadvrel]
      >

<
   SUBRULE (* 1. ADVP *)
      < T2: ADVPVAR{ADVPVARrec1} >
      < T2: ADVPVAR{ADVPVARrec1} >

   MATCHCONDITIONS
      <
       T2: ADVPVARrec1.actsubcefs * [sentadv, causadv] <> []
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. PREPPVAR *)
      < T2: PREPPVAR{PREPPVARrec1} >
      < T2: PREPPVAR{PREPPVARrec1} >

   MATCHCONDITIONS
      <
       T2: caus IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
