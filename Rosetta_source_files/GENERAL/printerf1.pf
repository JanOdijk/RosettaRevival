pragma C_include('interfaces.pf');


(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE PRINTERF1;
WITH INTERFACES;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : PRINTERF1
 *  Description     : Prints the interface datastructure between AMORPH and
 *                    SURFPARSER on the screen.
 *  Parameters      : ifin: INTERFACES_IfDescr
 *  Precondition    : ifin should contain a consistent datastructure (cf.
 *                    module INTERFACE1.ENV for more detailed information
 *                    about the datastructure.)
 *  Postcondition   : TRUE
 *  Side Effects    : The datatstructure is printed on the screen
 *
 *EMP:::===================================================================*)

PROCEDURE PRINTERF1_body(ifin: INTERFACES_IfDescr);
EXTERNAL;



END {PRINTERF1};
