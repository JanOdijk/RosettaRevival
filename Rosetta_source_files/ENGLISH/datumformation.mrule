\newpage
\begin{verbatim}
% RULE RNPday1
< m1:NP{NPrec1}[head/PROPERNOUN{PROPERNOUNrec1}[mu1],
                mu2
               ]

  m2:DETP{DETPrec1}[I1:head/N1[mu3]]
>

< m :NP{NPrec1}[
                head/PROPERNOUN{PROPERNOUNrec1}[mu1],
                detrel/DETP{DETPrec2}[I1:head/N1[mu3]],
                I2:sig1,
                mu2
               ]
>   
    MATCHCONDITIONS
      <
       I1:N1.cat IN [CARD]
       I2:ALL (sig1,puncrel/PUNC(KEY_commaPUNCkey){PUNCrec2})
      >

<
    SUBRULE
      < mu2 : [I3:mu4]>
      < sig1: [puncrel/PUNC(KEY_commaPUNCkey){PUNCrec1}]
        mu2 : [I3:mu4] >

   MATCHCONDITIONS
      <
       I3: EXIST (mu4,[rel1/..])
      >
     
  COMP
         <
          C1:NPrec1.actsubcs = [monthnoun] AND
             DETprec1.superdeixis = NPrec1.superdeixis
          A1:DETPrec2 := DETPrec1;
             DETPrec2.superdeixis := omegadeixis;
         >
  DECOMP
         <
          C1:monthnoun IN NPrec1.actsubcs AND
             DETPrec2.superdeixis = omegadeixis
          A1:DETPrec1 := DETPrec2;
             DETPrec1.superdeixis := NPrec1.superdeixis;
         >
 
  SUBRULE
      < mu2: [I3:mu4]>
      < sig1: []
        mu2: [I3:mu4] > 

   MATCHCONDITIONS
      <
       I3: NOT EXIST (mu4,[rel1/..])
      >
  COMP
         <
          C1:NPrec1.actsubcs = [monthnoun] AND
             DETprec1.superdeixis = NPrec1.superdeixis
          A1:DETPrec2 := DETPrec1;
             DETPrec2.superdeixis := omegadeixis;
         >
  DECOMP
         <
          C1:monthnoun IN NPrec1.actsubcs AND
             DETPrec2.superdeixis = omegadeixis
          A1:DETPrec1 := DETPrec2;
             DETPrec1.superdeixis := NPrec1.superdeixis;
         >
>
&

\end{verbatim}
