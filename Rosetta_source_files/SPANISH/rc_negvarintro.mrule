\newpage
\begin{verbatim}
% TRANSFORMATION Tnegdel1
< m1:SENTENCE{SENTENCErec1}
           [ mu1,
             meltnegrel/NEG(KEY_negkey){NEGrec1},
             I1:rel1/T1,
             mu2
           ]
>

< m :SENTENCE{SENTENCErec2}
           [ mu1,
             I1:rel1/T1,
             mu2
           ]
>


   MATCHCONDITIONS
      <
       I1: rel1 IN [subjrel, shiftrel] AND QUOTE_NegPhrase(T1)
      >


      COMP
         <
          C1: SENTENCErec1.negpos = noneg
              C11: rel1 = shiftrel
              A11: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.negpos := shiftneg; 
              C12: rel1 = subjrel
              A12: SENTENCErec2 := SENTENCErec1;
                   SENTENCErec2.negpos := subjneg; 
          A1: @
         >
      DECOMP
         <
          C1: true
              C11: rel1 = shiftrel              AND 
                   SENTENCErec2.negpos = shiftneg
              A11: SENTENCErec1 := SENTENCErec2;
              C11: rel1 = subjrel              AND 
                   SENTENCErec2.negpos = subjneg
              A11: SENTENCErec1 := SENTENCErec2;
          A1: SENTENCErec1.negpos := noneg;
         >

&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] Tnegdel1
\item[* relevant examples:]
no nadie nada -> nadie nada
no a nadie el hombre ve -> a nadie ve el hombre
