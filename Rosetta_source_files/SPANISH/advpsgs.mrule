% RULE Radvppsuperdeixis
< m1:ADVPFORMULA{ADVPFORMULArec1}[mu1] 
>

< m :ADVPFORMULA{ADVPFORMULArec2}[mu1] 
>

   PARAMETERS
      <
       super : tiempotype
      >

      COMP
         <
          C1: ADVPFORMULArec1.supertiempo = omegatiempo AND
              super IN [presente, pasado]
          A1: ADVPFORMULArec2 := ADVPFORMULArec1;
              ADVPFORMULArec2.supertiempo := super;
         >
      DECOMP
         <
          C1: ADVPFORMULArec2.supertiempo IN [presente, pasado]
          A1: ADVPFORMULArec1 := ADVPFORMULArec2;
              ADVPFORMULArec1.supertiempo := omegatiempo;
              super := ADVPFORMULArec2.supertiempo;
         >

&

\end{verbatim}
