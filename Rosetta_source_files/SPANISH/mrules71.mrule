



SPANISH 71
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION TSEspelling  
    < m1:I1::CLAUSE{CLAUSErec1}
           [ I4:mu1,
             subjrel/I2::NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}[mu6]],
             I3:mu2,
             cliticrel/CLITIC{}[I5:mu3], 
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5
           ]
>

< m:I1::CLAUSE{CLAUSErec2}
          [ I4:mu1,
            I3:mu2,
            cliticrel/CLITIC{}[seCLrel/REFLPRO(KEY_seREFLPROkey){REFLPROrec1},
                               I5:mu3
                              ],
            head/VERB{VERBrec2}
                 [ mu15,
                   head/VERB{VERBrec1}
                     [head/SUBVERB{SUBVERBrec1}
                        [head/I6::BVERB{BVERBrec1}]
                     ]
                 ],
            mu5
          ]
>

   MATCHCONDITIONS
      
      <
       I1:  CLAUSErec1.finiteness = finite   
       I2:  (NPrec1.NPhead = Seimpershead)    AND
            (NPrec1.numero = singular)        AND
            (NPrec1.persona = 3)              AND
            (NPrec1.cases = [nominative])
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  ALL (mu3, I53:rel3/PERSPRO{PERSPROrec1}[mu51])
       I53: PERSPROrec1.forma = DatCl 
       I6:  (BVERBrec1.reflexivity = notreflexive)    AND
            (BVERBrec1.key <> KEY_haberque1BVERBkey)  AND
            (BVERBrec1.key <> KEY_haberque2BVERBkey)
      > 


<

SUBRULE

       <mu5: [predrel/VERBP{VERBPrec1}[I7:mu7],mu52]>
       <mu5: [predrel/VERBP{VERBPrec1}[I7:mu7],mu52]>

    MATCHCONDITIONS
      <  
         I7: NOT EXIST (mu7, [objrel/..])
      >
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEactive
         >

  SUBRULE

       <mu5: [predrel/VERBP{VERBPrec1}[I7:mu7],mu52]>
       <mu5: [predrel/VERBP{VERBPrec1}[I7:mu7],mu52]>

    MATCHCONDITIONS
      <  
         I7: EXIST (mu7, [I71:Objrel/T1])
         I71: T1.CAT <> NP           
      >
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEactive
         >

 SUBRULE
       
      
       <mu5: [predrel/VERBP{VERBPrec1}
                     [mu54,
                     I7:objrel/NP{NPrec7}[mu71],
                     I8:mu8],
              mu52
             ] >
       <mu5: [predrel/VERBP{VERBPrec1}
                       [mu54,
                        I7:objrel/NP{NPrec7}[mu71],
                        I8:mu8],
              mu52
             ]>

     MATCHCONDITIONS
      <  
         I7: (NPrec7.NPhead = PERSPRONP AND
              NPrec7.genero <> neutro) OR
             ( NPrec7.NPhead <> PERSPRONP AND 
               NPrec7.human = yeshuman AND
               NPrec7.definite = def)
         I8: NOT EXIST (mu8, [indobjrel/..])
         
        >  
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEactive       
         >

SUBRULE
       
      
       <mu5: [I8:predrel/VERBP{VERBPrec1}
                         [mu54,
                         I7:objrel/NP{NPrec7}[mu71],
                         mu57,
                         indobjrel/PREPP{PREPPrec1}
                                  [mu81,
                                   objrel/NP{NPrec8}[mu82]]
                     ],
              mu52
             ] >

       <mu5: [I8:predrel/VERBP{VERBPrec1}
                         [mu54,
                          I7:objrel/NP{NPrec7}[mu71],
                          mu57,
                          indobjrel/PREPP{PREPPrec1}
                                  [mu81,
                                   objrel/NP{NPrec8}[mu82]]
                     ],
              mu52
             ]>

     MATCHCONDITIONS
      <  
         I7: (NPrec7.NPhead = PERSPRONP AND
              NPrec7.genero <> neutro) OR
             ( NPrec7.NPhead <> PERSPRONP AND 
               NPrec7.human = yeshuman AND
               NPrec7.definite = def)
         I8: ((NPrec8.NPhead = PERSPRONP AND
              NPrec7.NPhead = PERSPRONP) ->
              NPrec7.persona <> 3  )
         
        >  
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: CLAUSErec2 := CLAUSErec1;
              CLAUSErec2.voice := SEactive
         >


>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TSEspelling
\item[* relevant examples:] SE baila, SE ve a Juan, SE dice que habrá guerra 
\item[* language:] Spanish 
\item[* kind of rule:] M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] TC\_sespelling
\item[* date of creation:] 20-SEP-1988 15:10:34  
\item[* author:] Elly van Munster
\item[* copied from:] --
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 16/10/89\ \ \ \ \ author: Lisette Appelo\\
Adapted this Sespelling rule to the new proposal. It spells out an abstract `
men' as {\em se}, but only in generation. 
\item date: 27/11/90\ \ \ \ \ author: Elena Pinillos\\
Condition on mu5 added  in order to exclude the cases which have to use the
SE Passive construction, like 'se venden perros' and not 'se vende perros'
which is considered marginal; the modification will exclude all sentences
with an NP [-human] and the function of a canonical DO
\end{enumerate}
\item[* task:] To replace subjrel/NP{}[INDEFPRO{}] by SE (category REFLPRO) in 
clitic-position.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:] To consider SE as a PERSPRO (under the CLITIC 
node; compare the ind.obj. in TC\_indobjcliticspelling).
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] \\
3 subrules made in order to account for all the cases which have to go through
this rule without making the rule to opaque to read.
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
{\bf Se le ve} ("Men ziet hem") seems to be preferable to {\bf Se lo ve}.
This is not taken account of (yet).

\item modifications:\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% FILTER FSEspelling
< m:I1::CLAUSE{CLAUSErec1}
           [ I4:mu1,
             subjrel/I2::NP{NPrec1}[head/INDEFPRO{INDEFPROrec1}[mu6]],
             I3:mu2,
             cliticrel/CLITIC{}[I5:mu3],
             head/VERB{VERBrec2}
                  [ mu15,
                    head/VERB{VERBrec1}
                      [head/SUBVERB{SUBVERBrec1}
                         [head/I6::BVERB{BVERBrec1}]
                      ]
                  ],
             mu5
           ]
>


   MATCHCONDITIONS
      <
       I1:  CLAUSErec1.finiteness = finite
         I2:(NPrec1.numero = singular)     AND 
            (NPrec1.persona = 3)           AND
            (NPrec1.NPhead = SEimpershead) AND
            (NPrec1.cases = [nominative])
       I3:  ALL (mu2, I31:rel1/..)
       I31: rel1 IN [vpadvrel, negrel]
       I4:  ALL (mu1, I41:rel2/..)
       I41: rel2 IN [conjrel, shiftrel, meltnegrel]
       I5:  ALL (mu3, I53:rel3/PERSPRO{PERSPROrec1}[mu51])
       I53: PERSPROrec1.forma = Datcl                        
       I6:  (BVERBrec1.reflexivity = notreflexive)    AND
            (BVERBrec1.key <> KEY_haberque1BVERBkey)  AND
            (BVERBrec1.key <> KEY_haberque2BVERBkey)
      >

<

SUBRULE

        <mu5: [predrel/VERBP{VERBPrec1}[I7:mu7],mu52]>

    MATCHCONDITIONS
      <  
         I7: NOT EXIST (mu7, [objrel/..])
      >
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1:  @
         >

SUBRULE

       <mu5: [predrel/VERBP{VERBPrec1}[I7:mu7],mu52]>

    MATCHCONDITIONS
      <  
         I7: EXIST (mu7, [I71:Objrel/T1])
         I71: T1.CAT <> NP           
      >
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1:  @
         >

 SUBRULE

      <mu5: [predrel/VERBP{VERBPrec1}
                     [mu54,
                      I7:objrel/NP{NPrec7}[mu71],
                      I8:mu8],
             mu52
             ] >

     MATCHCONDITIONS
      <  
         I7: ( NPrec7.NPhead = PersproNP AND 
               NPrec7.genero <> neutro) OR
             ( NPrec7.NPhead <> PersproNP AND 
               NPrec7.human = yeshuman  AND
               NPrec7.definite = def )
         I8: NOT EXIST (mu8, [indobjrel/..])
         
      > 
   
      COMP
         <
          C1:  CLAUSErec1.voice = active
          A1:  @
         >


SUBRULE
       
      
       <mu5: [I8:predrel/VERBP{VERBPrec1}
                         [mu54,
                         I7:objrel/NP{NPrec7}[mu71],
                         mu57,
                         indobjrel/PREPP{PREPPrec1}
                                  [mu81,
                                   objrel/NP{NPrec8}[mu82]]
                     ],
              mu52
             ] >


     MATCHCONDITIONS
      <  
         I7: (NPrec7.NPhead = PERSPRONP AND
              NPrec7.genero <> neutro) OR
             ( NPrec7.NPhead <> PERSPRONP AND 
               NPrec7.human = yeshuman AND
               NPrec7.definite = def)
         I8: ((NPrec8.NPhead = PERSPRONP AND
              NPrec7.NPhead = PERSPRONP) ->
              NPrec7.persona <> 3  )
         
        >  
   
      COMP
         <
          C1: CLAUSErec1.voice = active
          A1: @
         >


>
 
&

\end{verbatim}
