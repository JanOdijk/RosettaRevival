PROCEDURAL PART
VAR fieldId : TSTRING_string;
    NumberOfFields : INTEGER;
    recassign:LOCALFILE;
BEGIN
INIT: BEGIN 
        INITLOCALFILE(recassign);
        NumberOfFields:=$FIELDLIST.RecFieldCount
      END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN
              fieldId:=%.str;
            END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN
              %%FIELDVALUE.fieldId:=fieldId;
              %%FIELDVALUE.NumberOfFieldsInh:=NumberOfFields;
            END
      !FIELDVALUE.
      RECEIVE: BEGIN 
                 APPENDLOCFILE(%%FIELDVALUE.recassign,recassign);
                 NumberOfFields:=%%FIELDVALUE.NumberOfFieldsSyn; 
               END
   *>
*>
FINAL:BEGIN
            $$FIELDLIST.recassign:=recassign;
      END
END;
