       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN NOTpresent:=true END
    *>
23: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: NOTpresent
               #ACTION: BEGIN beginhaakjepresent:=TRUE END
    *>
24: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION:TRUE
               #ACTION: BEGIN END
    *>
