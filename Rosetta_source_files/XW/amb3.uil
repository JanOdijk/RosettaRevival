object amb3_window : XmFormDialog {
    arguments {
        arguments form_dialog_args;
        XmNdialogTitle = N_amb_window;
        XmNnoResize    = true;
    };
    controls {
        XmRowColumn amb3_button_box;
        XmForm amb3_form1;
        XmForm amb3_form2;
        XmForm amb3_form3;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
                             (X_amb3_window + DEFAULT_BUTTON_OFFSET*X_amb3_ok_button);
    };
};

object amb3_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;
	XmNresizable        = false;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
	XmPushButton amb3_ok_button;
	XmPushButton amb3_help_button;
    };
};

object amb3_ok_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString       = N_amb_ok_button;
        XmNsensitive         = false;
    };
    callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_amb3_ok_button);
        XmNactivateCallback = procedure XwbAction (X_amb3_ok_button);
    };
};

object amb3_help_button : XmPushButton {
    arguments {
        arguments button_args;
	XmNlabelString       = N_amb_help_button;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb3_help_button);
        XmNactivateCallback = procedure XwhAction (X_amb3_help_button);
    };
};

object amb3_form1 : XmForm {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn amb3_button_box;

        arguments form_args;
    };
    controls {
        XmFrame amb3_stem1;
        XmScrolledList amb3_list1;
    };
};

object amb3_stem1 : XmFrame {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
     	XmNrightAttachment  = XmATTACH_FORM;
    };
    controls {
        XmRowColumn {
            arguments {
                XmNorientation      = XmHORIZONTAL;
            };
            controls {
	        XmLabel amb3_stem1_label;
                XmLabel amb3_stem1_text;
            };
        };
    };
};

object amb3_stem1_label : XmLabel {
    arguments {
        arguments label_args;
	XmNlabelString      = N_amb_stem_text;
    };
};

object amb3_stem1_text : XmLabel {
    arguments {
        arguments text_args;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb3_stem1_text);
    };
};

object amb3_list1 : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame amb3_stem1;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments list_args;
        XmNvisibleItemCount = 9;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;

        XmNitemCount = 2;
        XmNitems = string_table ( '<jur.>', 'fgfhdj' );
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb3_mean1_list);
        XmNdefaultActionCallback = procedure XwbAction (X_amb3_ok_button);
    };
};

object amb3_form2 : XmForm {
    arguments {
     	XmNleftAttachment   = XmATTACH_WIDGET;
        XmNleftWidget       = XmForm amb3_form1;
        XmNleftOffset       = 0;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn amb3_button_box;

        arguments form_args;
    };
    controls {
        XmFrame amb3_stem2;
        XmScrolledList amb3_list2;
    };
};

object amb3_stem2 : XmFrame {
    arguments {
     	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_FORM;
     	XmNrightAttachment  = XmATTACH_FORM;
    };
    controls {
        XmRowColumn {
            arguments {
                XmNorientation      = XmHORIZONTAL;
            };
            controls {
	        XmLabel amb3_stem2_label;
                XmLabel amb3_stem2_text;
            };
        };
    };
};

object amb3_stem2_label : XmLabel {
    arguments {
        arguments label_args;
	XmNlabelString      = N_amb_stem_text;
    };
};

object amb3_stem2_text : XmLabel {
    arguments {
        arguments text_args;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb3_stem2_text);
    };
};

object amb3_list2 : XmScrolledList {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame amb3_stem2;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments list_args;
        XmNvisibleItemCount = 9;
        XmNselectionPolicy  = XmMULTIPLE_SELECT;

        XmNitemCount = 2;
        XmNitems = string_table ( 'door velen gekend', 
                                  'kennis hebbende van' );
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_amb3_mean2_list);
        XmNdefaultActionCallback = procedure XwbAction (X_amb3_ok_button);
    };
};

object amb3_form3 : XmForm {
    arguments {
     	XmNleftAttachment   = XmATTACH_WIDGET;
        XmNleftWidget       = XmForm amb3_form2;
        XmNleftOffset       = 0;
        XmNtopAttachment    = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_WIDGET;
        XmNbottomWidget     = XmRowColumn amb3_button_box;
        XmNrightAttachment  = XmATTACH_FORM;

        arguments form_args;
    };
    controls {
        XmFrame amb3_stem3;
        XmScrolledList amb3_list3;
    };
};

