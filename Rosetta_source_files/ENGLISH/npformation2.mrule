\newpage
\begin{verbatim}
% TRANSFORMATION TNPENdeletion1    (*  countENkey*)
                                   (* Als deze regel geordend is na RNPmodADV
                                     dan twee regels nodig *)

< m1: NP{NPrec1}[detrel/DETP{DETPrec2}[I4:head/T4],
                 head/CN{CNrec1}
                        I1: [I2:mu2,
                          head/EN(KEY_countENkey){ENrec1},  
                          I3:mu3
                         ],
                 mu4
                ]
>

< m : NP{NPrec1}[detrel/DETP{DETPrec2}[I4:head/T4],
                 head/CN{CNrec2}
                        I1:[I2:mu2,
                           I3:mu3
                           ],
                 mu4 
                ]
>

   MATCHCONDITIONS
      <
       I1: mu2 <> [] OR mu3 <> []
       I2: ALL(mu2, modrel/DETP{DETPrec1}[head/NUM{NUMrec1}])
       I3: ALL(mu3, I13:rel3/T1) 
       I13: (rel3 IN [postmodrel, posrel, modrel]) AND
            ((T1.CAT IN [PREPP, ADVP]) OR
            (T1.CAT IN [SENTENCE] WITH T1.REC.mood =relative))
       I4: T4.CAT IN [DEMADJ, DET]
      >

      COMP
         <
          C1: count IN NPrec1.actcomas AND
              NPrec1.number = plural AND
              NPrec1.definite = def AND
              count IN CNrec1.posscomas
          A1: CNrec2 := CNrec1;
         >
      DECOMP
         <
          C1: count IN NPrec1.actcomas AND
              NPrec1.number = plural AND
              NPrec1.definite = def 
          A1: CNrec1 := CNrec2;
              CNrec1.posscomas := [count];
         >


&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TNPENdeletion1 
\item[* relevant examples:] those at the table, these three in the shop window,
those three, all hundred
 
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] NPformation
\item[* class:] (name of rule, transformation or filter class)
\item[* date of creation:] 16-FEB-1989 13:13:34  
\item[* author:] Franciska deJong
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Deletion of count EN.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}

\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\begin{enumerate} 
\item In Dutch there are rules for EN-deletion that probably should be replaced by
an ellipsis treatment. 
E.g.  sommige (rozen)  de tuin --> some roses in the 
garden  

\item Dutch NPs without nominal head, but with an adjective, are marked by a -n
suffix on the adjective if they refer to a human. In English only a limited
set of adjectives may be used without nominal head. E.g. {\em the rich}.
These examples are considered to be fully nominalised and are dealt with by
assuming a nominal entry {\em rich} in the dictionary. For other cases 
{\em one(s)}-insertion should apply. (TNPoneInsertion)
\end{enumerate}
\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}
\newpage
\begin{verbatim}
% TRANSFORMATION TNPCNdeletion1    (*  countENkey*)
                                   (* Als deze regel geordend is na RNPmodADV
                                     dan twee regels nodig *)

< m1: NP{NPrec1}[detrel/T1,
                 head/CN{CNrec1}
                         [head/EN(KEY_countENkey){ENrec1}
                         ],
                 I1:mu1
                ]
>

< m : NP{NPrec1}[detrel/T1,
                 I1:mu1
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [head/CN{CNrec2}[mu2]])
      >

      COMP
         <
          C1: count IN NPrec1.actcomas AND
              NPrec1.number = plural
          A1: @
         >
      DECOMP
         <
          C1: count IN NPrec1.actcomas  AND
              NPrec1.number = plural
          A1: CNrec1 := {
                         numbers : [plural]
                         posscomas : [count]
                        }
         >


&

\end{verbatim}
