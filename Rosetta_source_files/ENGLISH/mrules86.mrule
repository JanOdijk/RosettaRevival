\newpage
\begin{verbatim}
% RULE RStartPPProp000
< m1: SUBPREP{SUBPREPrec1}[head/PREP{PREPrec1}] 
>

< m : PREPPPROP{PREPPPROPrec1}
               [ subjrel/NP{NPrec1}
                        [ head/PERSPRO{PERSPROrec1}
                              [ head/BPERSPRO(AUX_itbpersprokey)
                                                  {BPERSPROrec1} ] 
                        ] ,
                 predrel/PREPP{PREPPrec1}[head/PREP{PREPrec1}]
               ]
>

      COMP
         <
          C1: PREPrec1.thetapp = pp000 AND
              SUBPREPrec1 = PREPrec1   
          A1: PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              (* PERSPROrec1.persprocase remains default *)
              NPrec1      := AUX_NPONitPRSPR;
              PREPPrec1   := { thetapp     : pp000
                               headkey     : PREPrec1.key
                               actsubcefs  : PREPrec1.subcs
                               class       : PREPrec1.class
                               deixis      : PREPrec1.deixis
                               aspect      : PREPrec1.aspect
                               retro       : PREPrec1.retro };
               (* req, env, mood, superdeixis, specQ, stranded,
                  synppefs: default values *)
              PREPPPROPrec1 := COPYT_prepptopreppprop(PREPPrec1);
              PREPPPROPrec1.aktionsarts := [stative]
               (* PROsubject : default value *)
         >
      DECOMP
         <
          C1: PREPrec1.thetapp = pp000 AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) AND
              PERSPROrec1.persprocase = omegacase AND
              NPrec1      = AUX_NPONitPRSPR AND
              PREPPrec1   = PREPPrecdef 
                EXCEPT FOR [thetapp, headkey, actsubcefs, 
                            class, deixis, aspect, retro] AND
              PREPPrec1 = { thetapp     : pp000 
                            headkey     : PREPrec1.key 
                            actsubcefs  : PREPrec1.subcs 
                            class       : PREPrec1.class 
                            deixis      : PREPrec1.deixis 
                            aspect      : PREPrec1.aspect 
                            retro       : PREPrec1.retro  } AND
              PREPPPROPrec1 = COPYT_PREPPtoPREPPPROP(PREPPrec1) AND
              PREPPPROPrec1 = { PROsubject : false
                                aktionsarts : [stative] }

          A1: SUBPREPrec1 := PREPrec1;
         >
&

\end{verbatim}
