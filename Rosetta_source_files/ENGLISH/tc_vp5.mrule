% TRANSFORMATION TVerbpattern9
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [ mu1,
                     predrel/VERBP{VERBPrec1}
                           [ head/VERB{VERBrec1}[mu2],
                             argrel/T1,
                             argrel/T2
                           ] 
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 I2:predrel/VERBP{VERBPrec1}
                           [ head/VERB{VERBrec1}[mu2],
                             rel1/T2,
                             I3:prepobjrel/VARPREPP{VARPREPPrec1}
                                     [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                       objrel/T1 ]
                           ] 
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
       I2: PREPrec1.key = VERBrec1.prepkey1
       I3: VARPREPPrec1 = PREPPrecdef EXCEPT FOR 
                [headkey, actsubcefs, synppefs, mood, thetapp,
                 specQ, class, aspect, deixis, retro] AND
           VARPREPPrec1 = { headkey    : PREPrec1.key
                            class      : PREPrec1.class
                            aspect     : PREPrec1.aspect
                            deixis     : PREPrec1.deixis
                            retro      : PREPrec1.retro } AND
           VARPREPPrec1.actsubcefs * PREPrec1.subcs <> []
      >

<
   SUBRULE (* 1a. strike x1 as (x2 x3) *)
      < T1: ADJPPROPVAR{ADJPPROPVARrec1} 
        T2: NPVAR{NPVARrec1} >

      < T1: ADJPPROPVAR{ADJPPROPVARrec1} 
        T2: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synIONP_PREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PREPCLOSEDADJPPROP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synCLOSEDADJPPROP]
                                mood       : nowh 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 } ;
              rel1 := indobjrel
         >
      DECOMP
         <
          C1: synIONP_PREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              synIONP_PREPCLOSEDADJPPROP IN VERBPPROPrec2.synvpefs 
              AND
              ADJPPROPVARrec1.PROsubject = false AND
              VARPREPPrec1 = { synppefs NI synCLOSEDADJPPROP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              rel1 = indobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b. strike as x1 x2 *)
      < T1: ADJPPROPVAR{ADJPPROPVARrec1} 
        T2: CNVAR{CNVARrec1} >

      < T1: ADJPPROPVAR{ADJPPROPVARrec1} 
        T2: CNVAR{CNVARrec1} >

      COMP
         <
          C1: synIONP_PREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PREPCLOSEDADJPPROP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synCLOSEDADJPPROP]
                                mood       : nowh 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := indobjrel
         >
      DECOMP
         <
          C1: synIONP_PREPCLOSEDADJPPROP IN VERBrec1.synvps AND
              synIONP_PREPCLOSEDADJPPROP IN VERBPPROPrec2.synvpefs 
              AND
              ADJPPROPVARrec1.PROsubject = false AND
              VARPREPPrec1 = { synppefs NI synCLOSEDADJPPROP
                               mood      : nowh 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              rel1 = indobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2a. x1 ask x2 about x3 *)
      < T1: NPVAR{NPVARrec1} 
        T2: NPVAR{NPVARrec2} >

      < T1: NPVAR{NPVARrec1} 
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec1.mood 
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := indobjrel
         >
      DECOMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps AND
              synIONP_PREPNP IN VERBPPROPrec2.synvpefs AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec1.mood 
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 } AND
              rel1 = indobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2b. ?1 ask x2 about x3 *)
      < T1: CNVAR{CNVARrec1} 
        T2: NPVAR{NPVARrec2} >

      < T1: CNVAR{CNVARrec1} 
        T2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := indobjrel
         >
      DECOMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps AND
              synIONP_PREPNP IN VERBPPROPrec2.synvpefs AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : relativexpmood 
                               specQ     : yesspec
                               thetapp   : pp120 } AND
              rel1 = indobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2c. x1 ask x2 about x3 *)
      < T1: NPVAR{NPVARrec1} 
        T2: CNVAR{CNVARrec2} >

      < T1: NPVAR{NPVARrec1} 
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : NPVARrec1.mood 
                                specQ      : NPVARrec1.specQ
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := indobjrel
         >
      DECOMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps AND
              synIONP_PREPNP IN VERBPPROPrec2.synvpefs AND
              VARPREPPrec1 = { synppefs NI synNP
                               mood      : NPVARrec1.mood 
                               specQ     : NPVARrec1.specQ
                               thetapp   : pp120 } AND
              rel1 = indobjrel 
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2d. x1 ask x2 about x3 *)
      < T1: CNVAR{CNVARrec1} 
        T2: CNVAR{CNVARrec2} >

      < T1: CNVAR{CNVARrec1} 
        T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: synIONP_PREPNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synIONP_PREPNP];
              VARPREPPrec1 := { headkey    : PREPrec1.key
                                actsubcefs : PREPrec1.subcs
                                synppefs   : [synNP]
                                mood       : relativexpmood 
                                specQ      : yesspec
                                class      : PREPrec1.class
                                aspect     : PREPrec1.aspect
                                deixis     : PREPrec1.deixis
                                retro      : PREPrec1.retro
                                thetapp    : pp120 };
              rel1 := indobjrel
         >
      DECOMP
         <
