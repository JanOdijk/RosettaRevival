\newpage
\begin{verbatim}
% RULE RadvppAspectImperf
< m1: ADVPFORMULA{ADVPFORMULArec1}
                 [ mu1,
                   predrel/ADVP{ADVPrec1}[mu2],
                   I1:mu4
                 ] 
>

< m : ADVPFORMULA{ADVPFORMULArec2}
                 [ mu1,
                   predrel/ADVP{ADVPrec1}[mu2],
                   I1:mu4
                 ] 
>

   MATCHCONDITIONS
      <
       I1: QUOTE_tempdurnotfound(mu4) AND
           QUOTE_temprefnotfound(mu4) AND
           QUOTE_tempretronotfound(mu4) 
      >

      COMP
         <
          C1: ADVPFORMULArec1.aspect = omegaaspect
          A1: ADVPFORMULArec2 := ADVPFORMULArec1;
              ADVPFORMULArec2.aspect := imperfective
         >
      DECOMP
         <
          C1: ADVPFORMULArec2.aspect = imperfective
          A1: ADVPFORMULArec1 := ADVPFORMULArec2;
              ADVPFORMULArec1.aspect := omegaaspect
         >
&

\end{verbatim}
