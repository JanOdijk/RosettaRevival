               #ACTION: BEGIN END
    *>
30: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION:NOTpresent and beginhaakjepresent
               #ACTION: BEGIN END
    *>
31: <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION:TRUE
               #ACTION: BEGIN END
    *>
32: <* LOCALCONDITION:TRUE
