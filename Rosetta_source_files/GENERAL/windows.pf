(*MPC:::===================================================================*
 *
 *  Constant name  : Windows_MaxIO
 *  Description    : maximum length of input/output buffer
 *
 *EMP:::===================================================================*)

CONST
   Windows_MaxIO = 255;




(*MPC:::===================================================================*
 *
 *  Constant name  : Windows_MaxWindowName
 *  Description    : maximal length of a window name
 *
 *EMP:::===================================================================*)

CONST
   Windows_MaxWindowName = 40;



(*MPC:::===================================================================*
 *
 *  Constant name  : Windows_MaxHelpWindows
 *  Description    : The maximum number of help windows a window can contain
 *
 *EMP:::===================================================================*)

CONST
   Windows_MaxHelpWindows = 5;



(*MPC:::===================================================================*
 *
 *  Constant name  : Windows_MaxDeviceName
 *  Description    : maximal length of a device name
 *
 *EMP:::===================================================================*)

CONST
   Windows_MaxDeviceName = 255;



(*MPC:::===================================================================*
 *
 *  Constant name  : Windows_MaxColumn
 *  Description    : maximal number of columns that a window may have
 *
 *EMP:::===================================================================*)

CONST
   Windows_MaxColumn = maxint;



(*MPC:::===================================================================*
 *
 *  Constant name  : Windows_MaxRow
 *  Description    : maximal number of rows that a window may have
 *
 *EMP:::===================================================================*)

CONST
   Windows_MaxRow = maxint;



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_IORange
 *  Description    : index range of input/output buffer
 *
 *EMP:::===================================================================*)

TYPE
   Windows_IORange = 0..Windows_MaxIO;



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_WindowNameRange
 *  Description    : index range of window names
 *
 *EMP:::===================================================================*)

TYPE
   Windows_WindowNameRange = 0..Windows_MaxWindowName;





(*MPT:::===================================================================*
 *
 *  Type name      : Windows_DeviceNameRange
 *  Description    : index range of device names
 *
 *EMP:::===================================================================*)

TYPE
   Windows_DeviceNameRange = 0..Windows_MaxDeviceName;





(*MPT:::===================================================================*
 *
 *  Type name      : Windows_ColumnRange
 *  Description    : Column range of a window.
 *
 *EMP:::===================================================================*)

TYPE
   Windows_ColumnRange = 1..Windows_MaxColumn;





(*MPT:::===================================================================*
 *
 *  Type name      : Windows_RowRange
 *  Description    : row range of a window
 *
 *EMP:::===================================================================*)

TYPE
   Windows_RowRange = 1..Windows_MaxRow;





(*MPT:::===================================================================*
 *
 *  Type name      : Windows_IOBuffer
 *  Description    : Largest possible buffer needed for IO operations.
 *
 *EMP:::===================================================================*)

TYPE
   Windows_IOBuffer = PACKED ARRAY [1..Windows_MaxIO] OF Char;




(*MPT:::===================================================================*
 *
 *  Type name      : Windows_WindowNameBuffer
 *  Description    : Largest possible buffer needed for window-names
 *
 *EMP:::===================================================================*)

TYPE
   Windows_WindowNameBuffer = PACKED ARRAY [1..Windows_MaxWindowName] OF Char;




(*MPT:::===================================================================*
 *
 *  Type name      : Windows_DeviceNameBuffer
 *  Description    : Largest possible buffer needed for device-names
 *
 *EMP:::===================================================================*)

TYPE
   Windows_DeviceNameBuffer = PACKED ARRAY [1..Windows_MaxDeviceName] OF Char;



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_VideoAttributes
 *  Description    : The possible video attributes.
 *
 *EMP:::===================================================================*)

TYPE
   Windows_VideoAttributes = (Windows_Blink, Windows_Bold,
                              Windows_Reverse, Windows_Underline);



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_VideoAttributeSet
 *  Description    : Set of possible video attributes.
 *
 *EMP:::===================================================================*)

TYPE
   Windows_VideoAttributeSet = SET OF Windows_VideoAttributes;



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_Device
 *  Description    : A device information record,
 *                   its structure should be considered hidden!
 *
 *EMP:::===================================================================*)

TYPE
   Windows_Device = RECORD did : Integer;
                           Rows : Windows_RowRange;
                           Columns : Windows_ColumnRange;
                    END;


(*MPT:::===================================================================*
 *
 *  Type name      : Windows_Viewport
 *  Description    : A viewport information record,
 *                   its structure should be considered hidden!
 *
 *EMP:::===================================================================*)

TYPE
   Windows_Viewport = RECORD vid : Integer;   {NOT USED}
                             did : Integer;
                             wid : Integer
                      END;



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_Window
 *  Description    : standard text window.
 *                   its structure should be considered hidden!
 *
 *EMP:::===================================================================*)

TYPE
   Windows_Window = RECORD 
      wid          : Integer;
      Rows         : Windows_RowRange;
      Row          : Windows_RowRange;
      Columns      : Windows_ColumnRange;
      Column       : Windows_ColumnRange;
      VideoAttribs : Integer;
      Help         : RECORD 
                        d : ARRAY [1..Windows_MaxHelpWindows] OF 
                            RECORD 
                               wp : ^Windows_Window;
                               v  : Windows_Viewport;
                               d  : Windows_Device;
                               x  : Integer;
                               y  : Integer
                            END {RECORD};
                        sp: 0..Windows_MaxHelpWindows
                     END {RECORD};
      Again        : Boolean;
      i            : Integer
   END;



(*MPT:::===================================================================*
 *
 *  Type name      : Windows_LeftJustify
 *  Description    : Windows_LeftJustify determines the ways in which Strings
 *                   may be justified.
 *                      TRUE  -> String is padded with blanks
 *                      FALSE -> String is preceded by blanks
 *
 *EMP:::===================================================================*)

TYPE
   Windows_LeftJustify = Boolean;




(*MPT:::===================================================================*
 *
 *  Type name      : WINDOWS_Direction
 *  Description    : Defines the possible directions of the cursor.
 *
 *EMP:::===================================================================*)

TYPE
   WINDOWS_Direction = (WINDOWS_Up, WINDOWS_Down, WINDOWS_Left, WINDOWS_Right);



(*MPF:::===================================================================*
 *
 *  Function Name  : Windows_Done
 *  Description    : determines the status of the last operation.
 *  Parameters     : 
 *  Result         : Boolean
 *  Precondition   : 
 *  Postcondition  : RETURNS TRUE IFF the last Read, Open/Close/Move,
 *                   Initialize action went well. (the ReadAgain routine
 *                   has no effect in this respect)
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 
FUNCTION Windows_Done
                    : Boolean;
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_Initialize
 *  Description     : Initializes this module
 *  Parameters      : 
 *  Precondition    : This module is initialized
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_Initialize;
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_OpenWindow
 *  Description     : opens a window
 *  Parameters      : VAR w : Windows_Window
 *                    name : STRING
 *                    len : Windows_WindowNameRange
 *                    Rows : Windows_RowRange
 *                    Columns : Windows_ColumnRange
 *  Precondition    : lb1=1 AND Windows_Initialize has been called
 *  Postcondition   : A window will be created. This window can be referenced by
 *                    w. The specified name will be written in the border of w.
 *                    The window consists of Rows lines of Columns Characters
 *                    each. Initially the window is cleared and the cursor is
 *                    positioned at (row 1, column 1).
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_OpenWindow (VAR w : Windows_Window;
                              CONST name : STRING;
                              len : Windows_WindowNameRange;
                              Rows : Windows_RowRange;
                              Columns : Windows_ColumnRange);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ClearWindow
 *  Description     : clears a previous opened window
 *  Parameters      : VAR w : Windows_Window
 *  Precondition    : w was previously opened using Windows_OpenWindow AND
 *                    Windows_Initialize has been called
 *  Postcondition   : w is cleared and the cursor is positioned at
 *                    (row 1, column 1).
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ClearWindow (VAR w : Windows_Window);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_CloseWindow
 *  Description     : closes a previous opened window
 *  Parameters      : VAR w : Windows_Window
 *  Precondition    : w was previously opened using Windows_OpenWindow AND
 *                    Windows_Initialize has been called
 *  Postcondition   : w is closed
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_CloseWindow (VAR w : Windows_Window);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_NewHelpWindow
 *  Description     : Will add a new help window to the window given which is 
 *                    displayed after pressing the HELP-key when the input was
 *                    expected out of w. The previous added windows are saved 
 *                    and can, one at a time, be restored by calling 
 *                    Windows_OldHelpWindow (w). The window is displayed at
 *                    the co-ordinates x, y at device dv.
 *  Parameters      : VAR w  : Windows_Window
 *                    VAR n  : Windows_Window
 *                        dv : Windows_Device
 *                        x  : Integer
 *                        y  : Integer
 *  Precondition    : 
 *  Postcondition   : N is stored as helpwindow for w.
 *  Side Effects    : Older windows are saved
 *
 *EMP:::===================================================================*)

 PROCEDURE Windows_NewHelpWindow (VAR w : Windows_window;
                                            VAR n : Windows_Window;
                                                dv: Windows_Device;
                                                x : Integer;
                                                y : Integer);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_OldHelpWindow
 *  Description     : Will restore one of the old help windows.
 *  Parameters      : w : Windows_Window
 *  Precondition    : There must be an old window
 *  Postcondition   : The old window is restored
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 PROCEDURE Windows_OldHelpWindow (VAR w: Windows_Window);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_AddHelpWindow
 *  Description     : Will store the given window as new help window (saving
 *                    the already stored ones.
 *  Parameters      : w : Windows_Window
 *                    h : Windows_Window
 *                    x : Windows_RowRange
 *                    y : Windows_ColumnRange
 *  Precondition    : Both windows are opened
 *  Postcondition   : h is stored in w as helpwindow
 *  Side Effects    : previous helpwindow is not visible after pressing helpkey
 *
 *EMP:::===================================================================*)

 PROCEDURE Windows_AddHelpWindow;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_CreateViewport
 *  Description     : Creates a viewport on a window (virtual display)
 *  Parameters      :     w : Windows_Window
 *                    VAR v : Windows_Viewport
 *                        d : Windows_Device
 *                    Row   : Windows_RowRange;
 *                    Column: Windows_ColumnRange;
 *                    Rows : Windows_RowRange
 *                    Columns : Windows_ColumnRange
 *  Precondition    : lb1=1 AND Windows_Initialize has been called
 *  Postcondition   : A viewportwill be created on window w. 
 *                    The viewport consists of Rows lines of Columns Characters
 *                    each. The left upper corner of the viewport is positioned
 *                    at position (Row, Column) of the window.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_CreateViewport (w : Windows_Window;
                                  VAR v : Windows_Viewport;
                                  d : Windows_Device;
                                  Row : Windows_RowRange;
                                  Column : Windows_ColumnRange;
                                  Rows : Windows_RowRange;
                                  Columns : Windows_ColumnRange);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ChangeViewport
 *  Description     : Chanegs the position and size of the viewport 
 *                    on a window (virtual display)
 *  Parameters      : VAR v : Windows_Viewport
 *                    Row   : Windows_RowRange;
 *                    Column: Windows_ColumnRange;
 *                    Rows : Windows_RowRange
 *                    Columns : Windows_ColumnRange
 *  Precondition    : lb1=1 AND Windows_Initialize has been called
 *  Postcondition   : 
 *                    The viewport consists of Rows lines of Columns Characters
 *                    each. The left upper corner of the viewport is positioned
 *                    at position (Row, Column) of the window.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ChangeViewport (VAR v : Windows_Viewport;
                                  Row : Windows_RowRange;
                                  Column : Windows_ColumnRange;
                                  Rows : Windows_RowRange;
                                  Columns : Windows_ColumnRange);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_OpenViewport
 *  Description     : opens a viewport at the specified device and displays
 *                    the specified window in the viewport.
 *  Parameters      : VAR v : Windows_Viewport
 *                        d : Windows_Device
 *                        w : Windows_Window
 *                        y : Integer
 *                        x : Integer
 *  Precondition    : d and w are opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : The window w is displayed at device d, any update to 
 *                    w is immediately
 *                    displayed at d. The top left corner of w is positioned at
 *                    (x,y). The top left corner of the device is (1,1). The
 *                    part of w that is visible at d depends on the column and
 *                    row range of the device. Only the overlapping part of
 *                       ((x..x+w.Columns),(y,y+w.Rows)) and
 *                       ((1..d.Columns),(1..d.Rows)) is displayed!
 *                    If there has been no previous call to 
 *                    WINDOWS_CreateViewport the viewport has the size of the
 *                    complete window.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_OpenViewPort (VAR v : Windows_Viewport;
                                    d : Windows_Device;
                                    w : Windows_Window;
                                    y : Integer;
                                    x : Integer);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ResetViewport
 *  Description     : Repaints the complete the specified device 
 *  Parameters      : VAR v : Windows_Viewport
 *                        d : Windows_Device
 *                        w : Windows_Window
 *                        y : Integer
 *                        x : Integer
 *  Precondition    : d and w are opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : The window w is displayed at device d, any update to 
 *                    w is immediately
 *                    displayed at d. The top left corner of w is positioned at
 *                    (x,y). The top left corner of the device is (1,1). The
 *                    part of w that is visible at d depends on the column and
 *                    row range of the device. Only the overlapping part of
 *                       ((x..x+w.Columns),(y,y+w.Rows)) and
 *                       ((1..d.Columns),(1..d.Rows)) is displayed!
 *                    If there has been no previous call to 
 *                    WINDOWS_CreateViewport the viewport has the size of the
 *                    complete window.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ResetViewPort (VAR v : Windows_Viewport;
                                    d : Windows_Device;
                                    w : Windows_Window;
                                    y : Integer;
                                    x : Integer);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_MoveViewport
 *  Description     : moves a previous opened viewport
 *  Parameters      : VAR v : Windows_Viewport
 *                        x : Integer
 *                        y : Integer
 *  Precondition    : v was previously opened using Windows_OpenViewport AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Replaces the window, that was previously put on a device
 *                    by a call to Windows_OpenViewport, on the device
 *                    according to x,y in the same way as Windows_OpenViewport
 *                    would have done.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_MoveViewport (VAR v : Windows_Viewport;
                                    x : Integer;
                                    y : Integer);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ScrollViewport
 *  Description     : moves a previous opened viewport
 *  Parameters      : VAR v : Windows_Viewport
 *                        direction : WINDOWS_Direction;
 *                        count     : Integer
 *  Precondition    : v was previously opened using Windows_OpenViewport AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Move the window under the previously opened viewport
 *                    according to the specified direction
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ScrollViewport (VAR v : Windows_Viewport;
                                  direction : WINDOWS_Direction;
                                  count : Integer);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_CloseViewport
 *  Description     : closes a previous opened viewport
 *  Parameters      : VAR v : Windows_Viewport
 *  Precondition    : v was previously opened using Windows_OpenViewport AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Removes the window that was previously put on a device by
 *                    a call to Windows_OpenViewport from that device.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_CloseViewport (VAR v : Windows_Viewport);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_OpenDevice
 *  Description     : the named device will be opened
 *  Parameters      : VAR d : Windows_Device
 *                    name : STRING
 *                    len : Windows_DeviceNameRange
 *                    shared : Boolean
 *  Precondition    : Windows_Initialize has been called
 *  Postcondition   : The device with the (logical) name name[1..min(ub1,len1)
 *                    will be opened and marked for exclusive/shared use
 *                    according to shared. The device can be referenced by d.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_OpenDevice (VAR d : Windows_Device;
                              CONST name : STRING;
                              len : Windows_DeviceNameRange;
                              shared : Boolean);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_CloseDevice
 *  Description     : closes a previous opened device
 *  Parameters      : VAR d : Windows_Device
 *  Precondition    : d was previously opened using Windows_OpenDevice AND
 *                    all viewports associated with d have been closed AND
 *                    Windows_Initialize has been called
 *  Postcondition   : d is closed.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_CloseDevice (VAR d : Windows_Device);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Function Name  : Windows_EndOfPage
 *  Description    : determines the end of window status of w
 *  Parameters     : VAR w : Windows_Window
 *  Result         : Boolean
 *  Precondition   : w has been opened AND
 *                   Windows_Initialize has been called
 *  Postcondition  : RETURNS TRUE IFF the last read Character of w equals the
 *                   end-of-page symbol
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 
FUNCTION Windows_EndOfPage (VAR w : Windows_Window)
                    : Boolean;
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Function Name  : Windows_EndOfLine
 *  Description    : determines the end of line status of w
 *  Parameters     : VAR w : Windows_Window
 *  Result         : Boolean
 *  Precondition   : w has been opened AND
 *                   Windows_Initialize has been called
 *  Postcondition  : RETURNS TRUE IFF the last read Character of w equals the
 *                   end-of-line symbol
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 
FUNCTION Windows_EndOfLine (VAR w : Windows_Window)
                    : Boolean;
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Function Name  : Windows_Column
 *  Description    : returns the current column position
 *  Parameters     : w : Windows_Window
 *  Result         : Windows_ColumnRange
 *  Precondition   : w is previously opened AND
 *                   Windows_Initialize has been called
 *  Postcondition  : RETURNS the current column position
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 
FUNCTION Windows_Column (VAR w : Windows_Window)
                    : Windows_ColumnRange;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : Windows_Row
 *  Description    : returns the current row position
 *  Parameters     : w : Windows_Window
 *  Result         : Windows_RowRange
 *  Precondition   : w is previously opened AND
 *                   Windows_Initialize has been called
 *  Postcondition  : RETURNS the current row position
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

 
FUNCTION Windows_Row (VAR w : Windows_Window)
                    : Windows_RowRange;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_NewRowColumn
 *  Description     : moves the cursor to specified place
 *  Parameters      : VAR w : Windows_Window
 *                    Row : Windows_RowRange
 *                    Column : Windows_ColumnRange
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : cursor is positioned at (row,column) if possible
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_NewRowColumn (VAR w  : Windows_Window;
                                Row    : Windows_RowRange;
                                Column : Windows_ColumnRange);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadIdentifier
 *  Description     : reads a String of Characters, consisting of letters and
 *                    digits only
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *  Parameters      : VAR w : Windows_Window
 *                    VAR Str : STRING
 *                    VAR len : Windows_IORange
 *  Precondition    : w has been opened AND lb1=1 AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Str[1..len] is filled with input Characters
 *                    after len Characters have been read the remaining
 *                    letters and digits are skipped.
 *                    input is terminated at first non-letter/digit(note that
 *                    this closing Character is not read yet).
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadIdentifier (VAR w : Windows_Window;
                                  VAR Str : STRING;
                                  VAR len : Windows_IORange);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadStr
 *  Description     : reads a String of Characters, not consisting of spaces
 *                    and/or control-Characters
 *  Parameters      : VAR w : Windows_Window
 *                    VAR Str : STRING
 *                    VAR len : Windows_IORange
 *  Precondition    : w has been opened AND lb1=1 AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Str[1..len] is filled with input Characters
 *                    after len Characters have been read the remaining
 *                    Chars>space are skipped.
 *                    input is terminated at first Char<=space (note that this
 *                    closing Character is not read yet).
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadStr (VAR w : Windows_Window;
                           VAR Str : STRING;
                           VAR len : Windows_IORange);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadToEndOfLine
 *  Description     : reads a String of Characters, not consisting of
 *                    control-Characters
 *  Parameters      : VAR w : Windows_Window
 *                    VAR Str : STRING
 *                    VAR len : Windows_IORange
 *  Precondition    : w has been opened AND lb1=1 AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Str[1..len] is filled with input Characters
 *                    after len Characters have been read the remaining
 *                    Chars<>end-of-line-marker are skipped.
 *                    input is terminated at first end-of-line (note that this
 *                    closing Character is not read yet).
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadToEndOfLine (VAR w : Windows_Window;
                                   VAR Str : STRING;
                                   VAR len : Windows_IORange);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadString
 *  Description     : reads a String of Characters, not consisting of spaces,
 *                    and/or control-Characters
 *  Parameters      : VAR w : Windows_Window
 *                    VAR Str : String_String
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Str is filled with input Characters
 *                    after length(Str) Characters have been read the remaining
 *                    Chars>space are skipped.
 *                    input is terminated at first Char<=space (note that this
 *                    closing Character is not read yet).
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadString (VAR w : Windows_Window;
                              VAR Str : String_String);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadKey
 *  Description     : reads one Character from the input window
 *  Parameters      : VAR w : Windows_Window
 *                    VAR k : Integer
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : k contains the representation of the last key read.
 *                    (f.e. k = Windows_HelpKey)
 *                    The read key is not echoed to the window!
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadKey (VAR w : Windows_Window;
                           VAR k : Integer);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadChar
 *  Description     : reads one Character from the input window
 *  Parameters      : VAR w : Windows_Window
 *                    VAR c : Char
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : c contains last Character read
 *                    incase end-of-line was read, c contains its representation
 *                    the same for end-of-page and end-of-window.
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadChar (VAR w : Windows_Window;
                            VAR c : Char);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadInteger
 *  Description     : reads an Integer from the input window
 *  Parameters      : VAR w : Windows_Window
 *                    VAR i : Integer
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : i contains the representation of the last read Integer
 *                    preceding spaces and new-lines are skipped.
 *                    An in Integer consists of an optional sign and a sequence
 *                    of digits.
 *                    Input is terminated at first non-digit (note that this
 *                    closing Character is not read yet)
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadInteger (VAR w : Windows_Window;
                               VAR i : Integer);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadBoolean
 *  Description     : reads a Boolean from the window
 *  Parameters      : VAR w : Windows_Window
 *                    VAR b : Boolean
 *  Precondition    : w is opened
 *  Postcondition   : b contains the representation of the last read Boolean
 *                    preceding spaces and new-lines are skipped.
 *                    A Boolean consists of the Charecter sequence "TRUE" or
 *                    "FALSE".
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *                    A call of Windows_Done will return TRUE IFF all went well.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadBoolean (VAR w : Windows_Window;
                               VAR b : Boolean);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_SkipSpace
 *  Description     : skips all the spaces (and end-of-lines) in the input
 *  Parameters      : VAR w : Windows_Window
 *                    b : Boolean
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : IF b THEN all spaces, tabs and end-of-lines
 *                              are skipped
 *                    ELSE all spaces and tabs are skipped
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_SkipSpace (VAR w : Windows_Window;
                                 b : Boolean);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_SkipLine
 *  Description     : skips the input past next end-of-line Character
 *  Parameters      : VAR w : Windows_Window
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : input is skipped past next end-of-line Character
 *                    The read Characters are written in the window at the
 *                    current row and column position.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_SkipLine (VAR w : Windows_Window);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_ReadAgain
 *  Description     : inStructs to read the last read Character again
 *  Parameters      : 
 *  Precondition    : w has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : The last read Character will be read again in the next
 *                    read action, it will not be written to the window again.
 *                    This has no effect on Windows_EndOfLine and 
 *                    Windows_EndOfFile!
 *  Side Effects    : After a call of this routine a read operation on w
 *                    will never give an error, even if the w was not opened!
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_ReadAgain (VAR w : Windows_Window);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteStr
 *  Description     : writes String to text window
 *  Parameters      : VAR w : Windows_Window
 *                    Str         : STRING
 *                    len         : Windows_IORange
 *                    width       : Windows_IORange
 *                    LeftJustify : Windows_LeftJustify
 *  Precondition    : w is has been opened AND lb1=1 AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Str[1..min(ub,len)] is written to w using at least width
 *                    Chars starting at current row and column position.
 *                    The written String is justified according to LeftJustify.
 *                    If the String does not fit on the current line, then the
 *                    complete String is written on a new line! Preceding and
 *                    trailing spaces are written as far as possible in the
 *                    currentline, remaining spaces are written on the new line.
 *                    If the String does not fit on the current line, then the
 *                    complete String is written on a new line! Preceding and
 *                    trailing spaces are written as far as possible in the
 *                    currentline, remaining spaces are written on the new line.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteStr (VAR w       : Windows_Window;
                            CONST Str         : STRING;
                            len         : Windows_IORange;
                            width       : Windows_IORange;
                            LeftJustify : Windows_LeftJustify);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteString
 *  Description     : writes String_String to text window
 *  Parameters      : VAR w : Windows_Window
 *                    Str : String_String
 *                    width : Windows_IORange
 *                    LeftJustify : Windows_LeftJustify
 *  Precondition    : w is has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : Str is written to w using atleast width Chars starting
 *                    at current row and column position.
 *                    The written String is justified according to LeftJustify.
 *                    If the String does not fit on the current line, then the
 *                    complete String is written on a new line! Preceding and
 *                    trailing spaces are written as far as possible in the
 *                    currentline, remaining spaces are written on the new line.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteString (VAR w : Windows_Window;
                               Str : String_String;
                               width : Windows_IORange;
                               LeftJustify : Windows_LeftJustify);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteChar
 *  Description     : writes one Character to text window
 *  Parameters      : VAR w : Windows_Window
 *                    c : Char
 *  Precondition    : w is has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : c is written to w at current row and column position.
 *                    If it does not fit on the current line, then the Character
 *                    is written on a new line!
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteChar (VAR w : Windows_Window;
                                 c : Char);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteInteger
 *  Description     : writes an Integer to text window
 *  Parameters      : VAR w : Windows_Window
 *                    i : Integer
 *                    width : Windows_IORange
 *                    LeftJustify : Windows_LeftJustify
 *  Precondition    : w is has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : i is written to w, using at least width positions
 *                    starting at current row and column position.
 *                    The written Integer is justified according to LeftJustify.
 *                    If the Integer does not fit on the current line, then the
 *                    complete Integer is written on a new line! Preceding and
 *                    trailing spaces are written as far as possible in the
 *                    currentline, remaining spaces are written on the new line.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteInteger (VAR w : Windows_Window;
                                i : Integer;
                                width : Windows_IORange;
                                LeftJustify : Windows_LeftJustify);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteBoolean
 *  Description     : writes a Boolean to window
 *  Parameters      : VAR w : Windows_Window
 *                    b : Boolean
 *                    width : Windows_IORange
 *                    LeftJustify : Windows_LeftJustify
 *  Precondition    : w is opened
 *  Postcondition   : b is written to w, using at least width positions
 *                    starting at current row and column position.
 *                    The written Boolean is justified according to LeftJustify.
 *                    If the Boolean does not fit on the current line, then the
 *                    complete Boolean is written on a new line! Preceding and
 *                    trailing spaces are written as far as possible in the
 *                    currentline, remaining spaces are written on the new line.
 *                    The text representation of the Boolean is "TRUE" or
 *                    "FALSE".
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteBoolean (VAR w : Windows_Window;
                                b : Boolean;
                                width : Windows_IORange;
                                LeftJustify : Windows_LeftJustify);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteSpace
 *  Description     : writes spaces to text window
 *  Parameters      : VAR w : Windows_Window
 *                    width : Windows_IORange
 *  Precondition    : w is has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : width spaces are written to w starting at current row
 *                    and column position.
 *                    The spaces are written as far as possible in the
 *                    currentline, remaining spaces are written on the new line.
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteSpace (VAR w : Windows_Window;
                              width : Windows_IORange);
EXTERNAL;




(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_WriteLine
 *  Description     : writes and end-of-line mark in the window w
 *  Parameters      : VAR w : Windows_Window
 *                    b : Boolean
 *  Precondition    : w is has been opened AND
 *                    Windows_Initialize has been called
 *  Postcondition   : IFF b OR 'current-line is not closed yet' THEN
 *                       end-of-line marker is written into w,
 *                       current row is incremented and current column
 *                       becomes 1
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_WriteLine (VAR w : Windows_Window;
                                 b : Boolean);
EXTERNAL;





(*MPF:::===================================================================*
 *
 *  Procedure Name  : Windows_SetVideoAttrExist
 *  Description     : Changes the way in which the specified part of the
 *                    window is displayed.
