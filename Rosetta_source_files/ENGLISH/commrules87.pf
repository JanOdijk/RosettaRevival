                                                      FUNCTION ELEMGRAPH3:LDMRULES_pCtrlExpr;
VAR result:LDMRULES_pCtrlExpr;
BEGIN
LDMRULES_makectrlexpr(result);
NAME: RPPPSUPERDEIXIS
