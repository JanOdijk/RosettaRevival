\newpage
\begin{verbatim}
% RULE Rpunc1
< m1:SENTENCE{SENTENCErec1}[I1:sig1,I2:mu1] 
>

< m :SENTENCE{SENTENCErec1}[I1:sig1,
                            puncrel/PUNC(AUX_invinterrogPUNCkey){PUNCrec1},
                            I2:mu1, 
                            puncrel/PUNC(AUX_interrogPUNCkey){PUNCrec2}
                           ]
>

   MATCHCONDITIONS
      <
       I1:  ALL (sig1, I11:rel1/..)
       I11: rel1 IN [leftdislocrel] 
       I2:  NOT EXIST (mu1, [I21:rel2/..])
       I21: rel2 IN [leftdislocrel]
      >

      COMP
         <
          C1:SENTENCErec1.senttype = mainclause AND
             SENTENCErec1.mood IN [yesnointerrogative, WHinterrogative]
          A1:@
         >

      DECOMP
         <
          C1:SENTENCErec1.senttype = mainclause AND
             SENTENCErec1.mood IN [yesnointerrogative, WHinterrogative]
          A1:@
         >
&

\end{verbatim}
