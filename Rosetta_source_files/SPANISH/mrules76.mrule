\newpage
\begin{verbatim}
% RULE RCNmodposs1

< m1: CN{CNrec1}[I1:mu1] 

  m2: NP{NPrec1}[mu2, 
                 head/T1,
                 mu3
                ]
>

< m : CN{CNrec1}[I1:mu1,
                 posrel/PREPP{PREPPrec1}[head/PREP(KEY_deprepkey){PREPrec1},
                                          complrel/NP{NPrec2}[mu2,
                                                              head/T2,
                                                              mu3
                                                             ]
                                         ]     
                ]
>

   MATCHCONDITIONS
      < I1: NOT EXIST (mu1, [head/EN{ENrec1}])  AND
            NOT EXIST (mu1, [posrel/..]) AND
            NOT EXIST (mu1, [postmodrel/PROPERNOUN{PROPERNOUNrec2}[mu7]]) 
      >

<
(* 1 *) 
SUBRULE          (*  libro de mi padre *)

<T1: CN{CNrec2}[mu4]>
<T2: CN{CNrec3}[mu4]>

      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.cases := [accusative];
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo := omegatiempo;
              CNrec3 := CNrec2;
              CNrec3.cases := NPrec2.cases;
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo AND
              NPrec2.cases = [accusative] AND
              NPrec2.generic = omegageneric AND
              CNrec3.cases = NPrec2.cases 
              
          A1: NPrec1 := NPrec2;
              NPrec1.generic := nogeneric;
              NPrec1.cases := [];
              NPrec1.supertiempo := CNrec1.supertiempo;
              CNrec2 := CNrec3;
              CNrec2.cases := [];
         >

(* 2 *) 
SUBRULE            (*  libro de mi *)

<T1: PERSPRO{PERSPROrec1}[mu5]>
<T2: PERSPRO{PERSPROrec2}[mu5]>

      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.cases := [accusative];
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo := omegatiempo;
              PERSPROrec2 := PERSPROrec1;
              PERSPROrec2.forma := prepfuerte
         >

      DECOMP
         <
          C1: PERSPROrec2.forma = prepfuerte AND
              NPrec2.supertiempo = omegatiempo AND
              NPrec2.cases = [accusative] AND
              NPrec2.generic = omegageneric
          A1: NPrec1 := NPrec2;
              NPrec1.cases := [];
              NPrec1.generic := nogeneric;
              NPrec1.supertiempo := CNrec1.supertiempo;
              PERSPROrec1 := PERSPROrec2;
              PERSPROrec2.forma := Nomfuerte
         >

(* 3 *)  
SUBRULE        (* boek van iedereen: NB: geen BINDEFPRO *)

<T1: INDEFPRO{INDEFPROrec1}>
<T2: INDEFPRO{INDEFPROrec1}>

      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.cases := [accusative]; 
              NPrec2.generic := omegageneric
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo AND
              NPrec2.cases = [accusative] AND
              NPrec2.generic = omegageneric
          A1: NPrec1 := NPrec2;
              NPrec1.cases := [];
              NPrec1.generic := nogeneric;
              NPrec1.supertiempo := CNrec1.supertiempo;
         >

(* 4 *) 
SUBRULE           (* libro de Juan *)

<T1: PROPERNOUN{PROPERNOUNrec1}[mu6]>
<T2: PROPERNOUN{PROPERNOUNrec1}[mu6]>

      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.cases := [accusative]; 
              NPrec2.generic := omegageneric
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo AND
              NPrec2.cases = [accusative] AND
              NPrec2.generic = omegageneric
          A1: NPrec1 := NPrec2;
              NPrec1.cases := [];
              NPrec1.generic := nogeneric;
              NPrec1.supertiempo := CNrec1.supertiempo;
         >
>
&


\end{verbatim}
