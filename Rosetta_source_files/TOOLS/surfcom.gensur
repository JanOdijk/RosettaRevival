                #ACTION:  BEGIN 
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_FINALBLOCK;
                END;
*>
END;

PROCEDURAL PART
VAR blockpas,blockenv:LOCALFILE;
    rulename:TSTRING_string;
BEGIN 
INIT:BEGIN \blockenv.\LOCAL.
           rulename:=$$FINALBLOCK.rulename;
           initlocalfile(blockenv);
           "FUNCTION " ""rulename"" "_F"\\
           "(VAR rec:" ""rulename"" 
           "typ;VAR topset:LISTREE_setofstrees):BOOLEAN;EXTERNAL;"\\
           \blockpas.\LOCAL.
           initlocalfile(blockpas);
           "FUNCTION " ""rulename"" "_F"\\
           "(VAR rec:" ""rulename"" 
           "typ;VAR topset:LISTREE_setofstrees):BOOLEAN;"\\
           "VAR result:BOOLEAN;top:LSSTREE_pstree;"\\
           "BEGIN LISTREE_initsetofstrees(topset);"
           "WITH rec^ DO BEGIN result:="\\
     END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN
               END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
4: <* SEND: BEGIN END
      !PASCALTOHEKJE.
      RECEIVE: BEGIN appendlocfile(%%PASCALTOHEKJE.copy,blockpas);
                   \\";IF result THEN"\\
               END
   *>
5: <* SEND: BEGIN initsetofidents(%%PSTOSTARRIGHT.parameters) END
      !PSTOSTARRIGHT.
      RECEIVE: BEGIN appendlocfile(%%PSTOSTARRIGHT.copy,blockpas);
               END
   *>
*>
FINAL: BEGIN
             $$finalblock.blockenv:=blockenv;
             "END;" ""rulename"" "_F"
             ":=result;"\\
             "DEBUG_writestr('<-" ""rulename"" "_F "
            "',DEBUG_MaxIO,0,TRUE);"
            "IF LISTREE_stillstrees(topset) THEN"
             " DEBUG_writestr('TRUE',DEBUG_MaxIO,0,TRUE)"\\
            "ELSE"
             " DEBUG_writestr('FALSE',DEBUG_MaxIO,0,TRUE);"
             "Debug_WriteLine(TRUE);"\\
             "END;"\\
             $$finalblock.blockpas:=blockpas;
             initlocalfile($$finalblock.blockenv);
             initlocalfile($$finalblock.blockpas);
       END
END;
&

%PASCALTOHEKJE
BASIS RULE
  PASCALTOHEKJE = {PASCAL1}.HEKJE/7
  PASCAL1 = ROUNDOPEN/1|ROUNDCLOSE/1|COMMA/1|IDENTIFIER/1|PROCENT/2|DOT/4|
            AUX/6|KEYtje/3|COLON/1|SEMICOLON/5|ISCAT/1|UNDERSCORE/8

SURFACE PART

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
