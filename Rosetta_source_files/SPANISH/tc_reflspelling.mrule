\newpage
\begin{verbatim}
%TRANSFORMATION TREFLspelling4    (* reflexive, object antecedent, CNVAR *)
< m1:I1::VERBPPROP{VERBPPROPrec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                    [ mu11,
                      head/I2::VERB{VERBrec1}[mu4],
                      cliticrel/CLITIC{CLITICrec1}[mu5],
                      mu2,
                      objrel/I3::CNVAR{CNVARrec1},
                      mu3
                    ],
                 mu6
               ]
>

< m :I1::VERBPPROP{VERBPPROPrec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                    [ mu11,
                      head/I2::VERB{VERBrec1}[mu4],
                      cliticrel/CLITIC{CLITICrec1}
                          [seclrel/REFLPRO(AUX_Sereflprokey){REFLPROrec1},
                           mu5
                          ],
                      mu2,
                      objrel/I3::CNVAR{CNVARrec1},
                      mu3
                    ],
                 mu6
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.thetavp IN [vp010, vp012, vp021]
       I2: ( VERBrec1.Caseassigner = true ) AND
          ( VERBrec1.reflexivity = reflexive )
       I3: ( CNVARrec1.Animate = NoAnimate ) 
      >

      COMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
