PACKAGE Batch;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Batch_PrepareBatchMode
 *  Description     : Creates, if the system runs in batchmode, two global
 *                    buffers. The first global buffer is used by Analysis
 *                    for the input sentence, the second global buffer is
 *                    used by generation for the output sentence.
 *  Parameters      : Batch: BOOLEAN; TRUE if system runs in batchmode
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE Batch_PrepareBatchMode(Batch: BOOLEAN);
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : Batch_PrepareInputBuffer
 *  Description     : Reads a new sentence from the inputfile and puts it into
 *                    the global buffer for analysis.
 *                    The sentence is also written to the outputfile.
 *  Parameters      : Batch: BOOLEAN; TRUE if system runs in batchmode
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE Batch_PrepareInputBuffer(Batch: BOOLEAN);
EXTERNAL;



(*MPF:::===================================================================*
 *
 *  Procedure Name  : Batch_EvalOutputBuffer
 *  Description     : Reads a generated sentence from the global buffer 
 *                    associated with the generation process and writes it
 *                    to the outputfile.
 *  Parameters      : Batch: BOOLEAN; TRUE if system runs in batchmode
 *  Precondition    : 
 *  Postcondition   : 
 *  Side Effects    : 
 *
 *EMP:::===================================================================*)

PROCEDURE Batch_EvalOutputBuffer(Batch: BOOLEAN);
EXTERNAL;



