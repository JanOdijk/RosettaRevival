FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_PASCALTOHEKJE;
                END
*>
END;

PROCEDURAL PART
VAR copy:LOCALFILE;
    writekey,writefield,writeextra::bool;
    str,str1:TSTRING_string;
BEGIN 
INIT:BEGIN \copy.\LOCAL.
           writeextra:=FALSE;
           writekey:=FALSE;
           writefield:=FALSE;
           initlocalfile(copy);
     END;
<*
1: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN IF TSTRING_comparechars(str,'IN',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'NOT',3)=0 THEN " "
                     IF TSTRING_comparechars(str,'AND',3)=0 THEN " "
                     TSTRING_constant(str1,'END',3);
                     IF TSTRING_comparebegin(str1,str)=0 THEN " "
                     IF TSTRING_comparechars(str,'OR',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'IF',2)=0 THEN " "
                     IF writekey THEN IF str[STRING_length(str)]=')' THEN BEGIN
                     TSTRING_extractbegin(str,str,STRING_length(str)-1);
                     writeextra:=TRUE;
                       END;
                     ""str""
                     IF TSTRING_comparechars(str,'IN',2)=0 THEN " "
                     TSTRING_constant(str1,'NOT',3);
                     IF TSTRING_compareend(str,str1)=0 THEN " "
                     IF TSTRING_comparechars(str,'IF',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'OR',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'AND',3)=0 THEN " "
                     IF TSTRING_comparechars(str,'END',3)=0 THEN " "
                     IF writekey THEN BEGIN
                       "')"
                       IF writeextra THEN ")"
                       writeextra:=FALSE;
                       writekey:=FALSE;
                       END;
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"b^.ls^."
                     writefield:=TRUE;
               END
   *>
3: <* SEND: BEGIN writekey:=TRUE END
      !.
      RECEIVE: BEGIN "auxkey('"
               END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF writefield THEN BEGIN
                     "field^"
                     writefield:=FALSE;
                     END;
                     "."
               END
   *>
5: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN ""str""\\
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"LSAUXDOM"
               END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF NOT writekey THEN "_"
               END
   *>
*>
FINAL: BEGIN $$PASCALTOHEKJE.copy:=copy
       END
END;
&

%PASCALTOGLOBAL
BASIS RULE
  PASCALTOGLOBAL = {PASCAL2}.GLOBAL/7
  PASCAL2 = ROUNDOPEN/1|ROUNDCLOSE/1|COMMA/1|IDENTIFIER/1|PROCENT/2|DOT/4|AUX/6|KEYtje/3|
           COLON/1|SEMICOLON/5|ISCAT/1|UNDERSCORE/8

SURFACE PART

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
6:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
7:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
8:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
FINAL: #CONDITION: TRUE
       #ACTION: BEGIN
                  SEND_PASCALTOGLOBAL;
                END
*>
END;

PROCEDURAL PART
VAR copy:LOCALFILE;
    writekey,writefield,writeextra::bool;
    str,str1:TSTRING_string;
BEGIN 
INIT:BEGIN \copy.\LOCAL.
           writeextra:=FALSE;
           writekey:=FALSE;
           writefield:=FALSE;
           initlocalfile(copy);
     END;
<*
1: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN IF TSTRING_comparechars(str,'IN',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'NOT',3)=0 THEN " "
                     IF TSTRING_comparechars(str,'IF',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'OR',2)=0 THEN " "
                     TSTRING_constant(str1,'END',3);
                     IF TSTRING_comparebegin(str1,str)=0 THEN " "
                     IF TSTRING_comparechars(str,'AND',3)=0 THEN " "
                     IF writekey THEN IF str[STRING_length(str)]=')' THEN BEGIN
                     TSTRING_extractbegin(str,str,STRING_length(str)-1);
                     writeextra:=TRUE;
                       END;
                     ""str""
                     IF TSTRING_comparechars(str,'IN',2)=0 THEN " "
                     TSTRING_constant(str1,'NOT',3);
                     IF TSTRING_compareend(str,str1)=0 THEN " "
                     IF TSTRING_comparechars(str,'IF',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'OR',2)=0 THEN " "
                     IF TSTRING_comparechars(str,'END',3)=0 THEN " "
                     IF TSTRING_comparechars(str,'AND',3)=0 THEN " "
                     IF writekey THEN BEGIN
                       "')"
                       IF writeextra THEN ")"
                       writeextra:=FALSE;
                       writekey:=FALSE;
                       END;
               END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"b^.ls^."
                     writefield:=TRUE;
               END
   *>
3: <* SEND: BEGIN writekey:=TRUE END
      !.
      RECEIVE: BEGIN "auxkey('"
               END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF writefield THEN BEGIN
                     "field^"
                     writefield:=FALSE;
                     END;
                     "."
               END
   *>
5: <* SEND: BEGIN str:=%.str END
      !.
      RECEIVE: BEGIN ""str""\\
               END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN \\"LSAUXDOM"
               END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN 
               END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN IF NOT writekey THEN "_"
               END
   *>
*>
FINAL: BEGIN $$PASCALTOGLOBAL.copy:=copy
       END
END;
&

%PSTOSTARRIGHT
BASIS RULE
  PSTOSTARRIGHT = {PASCAL3}.STARRIGHT/7
  PASCAL3 = ROUNDOPEN/1|ROUNDCLOSE/1|COMMA/1|IDENTIFIER/1|PROCENT/2|DOT/4|
            AUX/6|KEYtje/3|MAKE/9|ISCAT/1|
            SEMICOLON/5|COLON/1.ISCAT/11|UNDERSCORE/8|DOLLAR/10

SURFACE PART

<*
 INIT:BEGIN 
       END;
1:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN
                          END
       *>
2:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
3:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
4:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
5:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
6:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
7:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
                          END
       *>
8:     <*
        LOCALCONDITION:TRUE
        GLOBAL: #CONDITION: TRUE
                #ACTION:  BEGIN 
