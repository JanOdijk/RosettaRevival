echo "#build: $1:$2"
savedir=`pwd`
cd $RBS_USER_ROOT$RBS_USER$RBS_RELEASE 
if ( test -s $1/target/$2 )
then buildtarget=$1/target/$2
elif ( test -s $RBS_ARCHIVE$RBS_RELEASE/$1/$2 )
then buildtarget=$RBS_ARCHIVE$RBS_RELEASE/$1/$2
else buildtarget=$1/target/$2
fi
if ( test "$1" = "dutch") || (test "$1" = "english") || (test "$1" = "spanish")
then test "$3" = "-f"  || makemake $1 
     make -n -f $1/target/descrip.make $buildtarget language=$1
else test "$3" = "-f"  || makemake dutch 
     make -n -f dutch/target/descrip.make $buildtarget language=dutch
fi
cd $savedir
