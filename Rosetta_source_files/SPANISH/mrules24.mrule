\newpage
\begin{verbatim}
% RULE Rsubstitution4            (* (VAR)PREPP for PREPPVAR in S*)
< m1: CLAUSE{CLAUSErec1}
           [ mu1,
             I2:rel1/PREPPVAR{PREPPVARrec1},
             mu2
           ] 
SUBST:
  m2: T1
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             I3:rel1/T1,
             mu2
           ] 
>


   MATCHCONDITIONS
      <
       m1: QUOTE_Gsubstordercondition1(mu2)
       m : QUOTE_substordercondition1(mu2)
       m2: T1.CAT IN [PREPP, VARPREPP]
       I1: PREPPVARrec1.index = LEVEL 
       I2: rel1 IN [locadvrel, causadvrel (*, tempadvrel*), shiftrel ]
       I3: rel1 IN [locadvrel, causadvrel (*, tempadvrel*), shiftrel ] AND
           T1.CAT IN [PREPP, VARPREPP]
      >

   PARAMETERS
      <
       LEVEL
      >

<

   SUBRULE
      <T1: PREPP{PREPPrec1}[mu7] >
      <T1: PREPP{PREPPrec1}[mu7] >


      COMP
         <
          C1: PREPPrec1.actsubcefs * [loc, caus] <> []             AND
              PREPPVARrec1 = COPYT_prepptovar(PREPPrec1)
          A1: @
         >
      DECOMP
         <
          C1: PREPPrec1.actsubcefs * [loc, caus] <> []             
          A1: PREPPVARrec1 := COPYT_prepptovar(PREPPrec1);
              PREPPVARrec1.index := LEVEL;
         >


   SUBRULE
      <T1: VARPREPP{VARPREPPrec1}[mu7] >
      <T1: VARPREPP{VARPREPPrec1}[mu7] >


      COMP
         <
          C1: VARPREPPrec1.actsubcefs * [loc, caus] <> []             AND
              PREPPVARrec1 = COPYT_prepptovar(VARPREPPrec1)
          A1: @
         >
      DECOMP
         <
          C1: VARPREPPrec1.actsubcefs * [loc, caus] <> []             
          A1: PREPPVARrec1 := COPYT_prepptovar(VARPREPPrec1);
              PREPPVARrec1.index := LEVEL;
         >
>

&

\end{verbatim}

