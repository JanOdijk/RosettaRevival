\newpage
\begin{verbatim}

% TRANSFORMATION TStrandedWhShift
< m1: CLAUSE{CLAUSErec1}
            [ I1:sig1, 
              I2:mu1 ]
>

< m : CLAUSE{CLAUSErec2}
            [ I1:sig1, 
              I3:mu2 ]
>

   MATCHCONDITIONS
      <
       I1: ALL (sig1, leftdislocrel/..)
       I2: NOT EXIST (mu1, [I21:rel1/..])
           I21: rel1 IN [leftdislocrel, shiftrel]
       I3: NOT EXIST (mu2, [leftdislocrel/..])  AND
           QUOTE_FIRSTrel(mu2, shiftrel)         
           (* not really necessary *)
      >

<
   SUBRULE (* 1. prepobjrel, obj from VARPREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:prepobjrel/VARPREPP{VARPREPPrec1}
                                [ head/PREP{PREPrec1},
                                  I9:objrel/T1
                                ],
                      I7:mu7], 
              mu12] >

      < mu2: [I9:shiftrel/T1,
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      prepobjrel/I5::PREPP{PREPPrec1}
                                [ head/PREP{PREPrec1} ],
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I5: PREPPrec1 = { stranded : true
                         mood     : nowh
                         specQ    : omegaspec }
       I6: ALL (mu6, I61:rel6/..) AND 
           NOT EXIST (mu6, [I62:rel2/T3]) 
         I61: QUOTE_VPrelprec(rel6, prepobjrel)
       I7: ALL (mu7, I71:rel7/..) AND 
           NOT EXIST (mu7, [I62:rel2/T3]) 
         I71: QUOTE_VPrelprec(prepobjrel, rel7)
       I8: VARPREPPrec1.stranded = false AND
           VARPREPPrec1.mood IN [wh, relativexpmood, topicmood] 
       I9: ( T1.CAT IN [NPVAR] WITH 
                   T1.REC.mood IN [wh, relativexpmood, topicmood])
             OR ( T1.CAT IN [CNVAR] )                          OR
           (T1.CAT IN [NP] WITH
            ((T1.REC.mood = wh) AND
             (QUOTE_VARinNP(T1)
             )
            )
           )
       I62: rel2 IN [predrel, locargrel, dirargrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_prepobjvps <> [] OR
              CLAUSErec1.adjuncts * [benfactPP] <> []
            C11: (T1.CAT IN [NPVAR, NP] WITH 
                        (T1.REC.specQ = VARPREPPrec1.specQ AND
                         T1.REC.mood = VARPREPPrec1.mood) )
            A11: PREPPrec1 := VARPREPPrec1;
                 PREPPrec1.mood := nowh;
                 PREPPrec1.specQ := omegaspec
            C12: T1.CAT IN [CNVAR, NP] AND
                 VARPREPPrec1.specQ = yesspec AND
                 VARPREPPrec1.mood = relativexpmood
            A12: PREPPrec1 := VARPREPPrec1;
                 PREPPrec1.mood := nowh;
                 PREPPrec1.specQ := omegaspec
          A1: CLAUSErec2 := CLAUSErec1;
              PREPPrec1.stranded := true
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_prepobjvps <> [] OR
              CLAUSErec2.adjuncts * [benfactPP] <> []
            C11: (T1.CAT IN [NPVAR, NP] WITH 
                   T1.REC.mood IN [wh, relativexpmood, topicmood])
               C111: CLAUSErec2.synvpefs * AUX_prepobjvps <> []
               A111: CLAUSErec1 := CLAUSErec2;
                    CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_prepobjvps);
               C112: CLAUSErec2.adjuncts * [benfactPP] <> []
               A112: CLAUSErec1 := CLAUSErec2;
            A11: VARPREPPrec1 := PREPPrec1;
                 VARPREPPrec1.mood := T1.REC.mood;
                 VARPREPPrec1.specQ := T1.REC.specQ
            C12: T1.CAT IN [CNVAR, NP]
               C121: CLAUSErec2.synvpefs * AUX_prepobjvps <> []
               A121: CLAUSErec1 := CLAUSErec2;
                    CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_prepobjvps);
               C122: CLAUSErec2.adjuncts * [benfactPP] <> []
               A122: CLAUSErec1 := CLAUSErec2;
            A12: VARPREPPrec1 := PREPPrec1;
                 VARPREPPrec1.mood := relativexpmood;
                 VARPREPPrec1.specQ := yesspec
          A1: VARPREPPrec1.stranded := false;
         > 

   SUBRULE (* 2. dirargrel, obj from PREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:dirargrel/PREPP{PREPPrec1}
                                  [ head/PREP{PREPrec1},
                                    I9:objrel/T1
                                  ],
                      I7:mu7], 
              mu12] >

      < mu2: [I9:shiftrel/T1,
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      dirargrel/I5::PREPP{PREPPrec2}
                               [ head/PREP{PREPrec1} ],
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I5: PREPPrec2 = { stranded : true
                         mood     : nowh
                         specQ    : omegaspec }
       I6: ALL (mu6, I61:rel6/..) AND 
           NOT EXIST (mu6, [I62:rel2/T3]) 
         I61: QUOTE_VPrelprec(rel6, dirargrel)
       I7: ALL (mu7, I71:rel7/..) AND 
           NOT EXIST (mu7, [I62:rel2/T3]) 
         I71: QUOTE_VPrelprec(dirargrel, rel7)
       I8: PREPPrec1.stranded = false AND
           PREPPrec1.mood IN [wh, relativexpmood, topicmood]
       I9: (T1.CAT IN [NPVAR] WITH 
                      T1.REC.mood IN [wh, relativexpmood, topicmood])
           OR (T1.CAT IN [CNVAR] )                          OR
           (T1.CAT IN [NP] WITH
            ((T1.REC.mood = wh) AND
             (QUOTE_VARinNP(T1)
             )
            )
           )
       I62: rel2 IN [predrel, locargrel, dirargrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_dirargvps <> [] OR
              CLAUSErec1.adjuncts * [diradjunct] <> []
            C11: T1.CAT IN [NPVAR, NP] WITH 
                         (T1.REC.mood = PREPPrec1.mood AND
                          T1.REC.specQ = PREPPrec1.specQ)
            A11: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := nowh;
                 PREPPrec2.specQ := omegaspec
            C12: T1.CAT IN [CNVAR, NP] AND
                 PREPPrec1.mood = relativexpmood AND
                 PREPPrec1.specQ = yesspec
            A12: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := nowh;
                 PREPPrec2.specQ := omegaspec
          A1: CLAUSErec2 := CLAUSErec1;
              PREPPrec2.stranded := true
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_dirargvps <> [] OR
              CLAUSErec2.adjuncts * [diradjunct] <> []
            C11: T1.CAT IN [NPVAR, NP] WITH 
                        T1.REC.mood IN [wh, relativexpmood, topicmood]
                C111: CLAUSErec2.synvpefs * AUX_dirargvps <> []
                A111: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                             (CLAUSErec2.synvpefs * AUX_dirargvps);
                C112: CLAUSErec2.adjuncts * [diradjunct] <> []
                A112: CLAUSErec1 := CLAUSErec2;
            A11: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := T1.REC.mood;
                 PREPPrec1.specQ := T1.REC.specQ
            C12: T1.CAT IN [CNVAR, NP]
                C121: CLAUSErec2.synvpefs * AUX_dirargvps <> []
                A121: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_dirargvps);
                C122: CLAUSErec2.adjuncts * [diradjunct] <> []
                A122: CLAUSErec1 := CLAUSErec2;
            A12: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := relativexpmood;
                 PREPPrec1.specQ := yesspec
          A1: PREPPrec1.stranded := false;
         >

   SUBRULE (* 3. locargrel, obj from PREPP *)
      < mu1: [mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      I8:locargrel/PREPP{PREPPrec1}
                                  [ head/PREP{PREPrec1},
                                    I9:objrel/T1
                                  ],
                      I7:mu7], 
              mu12] >

      < mu2: [I9:shiftrel/T1,
              mu9, 
              predrel/VERBP{VERBPrec1}
                     [I6:mu6, 
                      locargrel/I5::PREPP{PREPPrec2}
                               [ head/PREP{PREPrec1} ],
                      I7:mu7], 
              mu12] >

   MATCHCONDITIONS
      <
       I5: PREPPrec2 = { stranded : true
                         mood     : nowh
                         specQ    : omegaspec }
       I6: ALL (mu6, I61:rel6/..) AND 
           NOT EXIST (mu6, [I62:rel2/T3]) 
         I61: QUOTE_VPrelprec(rel6, locargrel)
       I7: ALL (mu7, I71:rel7/..) AND 
           NOT EXIST (mu7, [I62:rel2/T3]) 
         I71: QUOTE_VPrelprec(locargrel, rel7)
       I8: PREPPrec1.stranded = false AND
           PREPPrec1.mood IN [wh, relativexpmood, topicmood]
       I9: (T1.CAT IN [NPVAR] WITH 
                   T1.REC.mood IN [wh, relativexpmood, topicmood])
           OR (T1.CAT IN [CNVAR] )                          OR
           (T1.CAT IN [NP] WITH
            ((T1.REC.mood = wh) AND
             (QUOTE_VARinNP(T1)
             )
            )
           )
       I62: rel2 IN [predrel, locargrel, dirargrel] OR
            ( rel2 IN [complrel] AND T3.CAT IN [PREPP] )
      >

      COMP
         <
          C1: CLAUSErec1.synvpefs * AUX_locargvps <> [] OR
              CLAUSErec1.adjuncts * [locadjunct] <> []
            C11: T1.CAT IN [NPVAR, NP] WITH 
                         (T1.REC.mood = PREPPrec1.mood AND
                          T1.REC.specQ = PREPPrec1.specQ)
            A11: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := nowh;
                 PREPPrec2.specQ := omegaspec
            C12: T1.CAT IN [CNVAR, NP] AND
                 PREPPrec1.mood = relativexpmood AND
                 PREPPrec1.specQ = yesspec
            A12: PREPPrec2 := PREPPrec1;
                 PREPPrec2.mood := nowh;
                 PREPPrec2.specQ := omegaspec
          A1: CLAUSErec2 := CLAUSErec1;
              PREPPrec2.stranded := true
         >

      DECOMP
         <
          C1: CLAUSErec2.synvpefs * AUX_locargvps <> [] OR
              CLAUSErec2.adjuncts * [locadjunct] <> []
            C11: T1.CAT IN [NPVAR, NP] WITH 
                        T1.REC.mood IN [wh, relativexpmood, topicmood]
                C111: CLAUSErec2.synvpefs * AUX_locargvps <> []
                A111: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_locargvps);
                C112: CLAUSErec2.adjuncts * [locadjunct] <> []
                A112: CLAUSErec1 := CLAUSErec2;
            A11: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := T1.REC.mood;
                 PREPPrec1.specQ := T1.REC.specQ
            C12: T1.CAT IN [CNVAR, NP]
                C121: CLAUSErec2.synvpefs * AUX_locargvps <> []
                A121: CLAUSErec1 := CLAUSErec2;
                      CLAUSErec1.synvpefs :=  
                            (CLAUSErec2.synvpefs * AUX_locargvps);
                C122: CLAUSErec2.adjuncts * [locadjunct] <> []
                A122: CLAUSErec1 := CLAUSErec2;
            A12: PREPPrec1 := PREPPrec2;
                 PREPPrec1.mood := relativexpmood;
                 PREPPrec1.specQ := yesspec
          A1: PREPPrec1.stranded := false;
         >

>
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TStrandedWhShift
\item[* relevant examples:]\mbox{}\\
\begin{description}
    \item[1. obj from prepobjrel] What did you talk to John about - \\
       Whom did you talk to - about our new car; \\
       .. which you talked to John about \\ .. whom you talked to about our new 
car\\
  (Note that no condition is 
formulated on the presence of another prepobj somewhere in the VERBP. The right 
match should follow automatically from the conditions on (VAR)PREPP and NPVAR.
    \item[2. obj from dirargrel] Which house did he move to; .. which he 
moved to 
    \item[3. obj from locargrel] Which town do you live in; .. which you live 
in
\end{description}
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] CLAUSEtoSENTENCE
\item[* class:] (name of rule, transformation or filter class) TC\_WhShift
\item[* date of creation:] 14-JUN-1988
\item[* author:] Margreet Sanders
\item[* copied from:] Dutch TWhShift1a and TWhShift1b
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: 28/9/88\ \ \ \ \ author: margreet sanders\\
Adapted for shift of relativexpmood-NPVARs and for shift of CNVARs
\item date: 07/05/91\ \ \ \ \ author:Petra de Wit\\
Adapted to allow stranded shift out of adjuncts 
\end{enumerate}
\item[* task:] to move a wh-element or a relative inside a prepp to the 
beginning of the sentence, and put it in shiftrel, leaving the prep in stranded 
position
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:] one subrule for 
every position the shifted element must be put back in (analysis)
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:] In analysis the synvpefs
of the CLAUSE is reduced in accordance with the relation/cat introduced. 
In generation this reduction is not necessary, since there is only one element 
in the set to begin with.
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\
It is assumed that for (VAR)PREPPs, the mood has been copied from the object 
under it, or (in case of CNVAR objects) has been set to relativexpmood. The 
appropriate rules have been written for PREPP and PPPROP subgrammars, 
startrules (prepobjrel/VARPREPP) and for byobjs (voice rules).
\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\
Subrules 10 of TWhShift and 1 of TStrandedWhShift now both 
work in generation, so both {\em To whom did you talk about our new car\/} and 
{\em Whom did you talk to about our new car\/} are produced. A decision still 
has to be taken which of this two rules should get a lower bonus.

\item modifications:\\

\end{enumerate}
\end{description}

