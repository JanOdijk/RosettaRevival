object mg_toggle_frame : XmFrame {
    arguments {
        XmNtopAttachment     = XmATTACH_WIDGET;
        XmNtopWidget         = XmFrame mg_rule_frame;
        XmNleftAttachment    = XmATTACH_FORM;
        XmNrightAttachment   = XmATTACH_FORM;
    };
    controls {
        XmRowColumn mg_toggles;
    };    
};

object mg_toggles : XmRowColumn {
    arguments {
        XmNorientation       = XmVERTICAL;
    };
    controls {
        XmToggleButton {
            arguments {
                XmNlabelString = N_mg_tree_toggle;
                XmNfontList    = big;
            };
            callbacks {
                MrmNcreateCallback = procedure
                                         XwuCreateWidget (X_mg_tree_toggle);
            };
        };
        XmToggleButton {
            arguments {
                XmNlabelString = N_mg_trace_toggle;
                XmNfontList    = big;
            };
            callbacks {
                MrmNcreateCallback = procedure
                                         XwuCreateWidget (X_mg_trace_toggle);
            };
        };
    };
};

object mg_button_box : XmRowColumn {
    arguments {
        XmNtopAttachment    = XmATTACH_WIDGET;
        XmNtopWidget        = XmFrame mg_toggle_frame;
        XmNleftAttachment   = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;

        arguments button_box_args;
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton mg_start_button;
        XmPushButton mg_step_button;
        XmPushButton mg_stop_button;
        XmPushButton mg_stopall_button;
        XmPushButton mg_treein_button;
        XmPushButton mg_treeout_button;
        XmPushButton mg_help_button;
    };
};

object mg_start_button : XmPushButton {
    arguments {
	arguments button_args;
        XmNlabelString       = N_mg_start_button;
        XmNsensitive         = false;
    };
    callbacks {
        MrmNcreateCallback  = procedure XwuCreateWidget (X_mg_start_button);
        XmNactivateCallback = procedure
            XwbAction(X_mg_start_button);
    };
};

