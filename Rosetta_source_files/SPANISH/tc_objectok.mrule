% TRANSFORMATION Tobjectok6b (* passive or ergative, subject to subject,
                                PREPP[....SENTENCE] *)

                         (* subject to subject Raising *)

< m1:CLAUSE{CLAUSErec1}
           [ I1:mu1,
             I2:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu5],
                      cliticrel/CLITIC{}[mu8],
                      mu9,
                      complrel/PREPP{PREPPrec1}
                           [head/PREP(VERBrec1.prepkey1){PREPrec1},
                            objrel/I3::SENTENCE{SENTENCErec1}
                                        [ I4:mu10,
                                          I5:subjrel/T1,
                                          I6:mu4 
                                        ]
                           ],
                      mu6 
                    ],
             mu7
           ]
>

< m :CLAUSE{CLAUSErec1}
           [ I1:mu1,
             I5:subjrel/T1,
             I2:mu2,
             predrel/VERBP{VERBPrec1}
                    [ mu3,
                      head/VERB{VERBrec1}[mu5],
                      cliticrel/CLITIC{}[mu8],
                      mu9,
                      complrel/PREPP{PREPPrec1}
                           [head/PREP(VERBrec1.prepkey1){PREPrec1},
                             objrel/I3::SENTENCE{SENTENCErec1}
                                         [ I4:mu10,
                                           I6:mu4 
                                         ]
                           ],
                      mu6 
                    ],
             mu7
           ]
>

   MATCHCONDITIONS
      <
       I1 : ALL(mu1, I10:rel1/..)
       I2 : NOT EXIST (mu2,[I10:rel1/..]) AND
            NOT EXIST (mu2,[subjrel/..])
       I3 : SENTENCErec1.PROsubject = false
       I4 : ALL(mu10, I11:rel2/..)
       I5 : T1.CAT IN [NP,PRONPVAR]
       I6 : NOT EXIST(mu4,[I11:rel2/..])
       I10: rel1 IN AUX_presubjrels
       I11: rel2 IN [shiftrel, conjrel]
      >


      COMP
         <
          C1: (CLAUSErec1.voice = Passive) OR
              (CLAUSErec1.thetavp IN [vp010, vp012, vp021])
          A1: @
         >

      DECOMP
         <
          C1: (CLAUSErec1.voice = Passive) OR
              (CLAUSErec1.thetavp IN [vp010, vp012, vp021])
          A1: @
         >
&


\end{verbatim}
