%TRANSFORMATION TIDCLAUSETOVPPROP

< m1: CLAUSE{CLAUSEREC1}[mu1]
>

< m : VERBPPROP{VERBPPROPREC1}[mu1]
>

COMP
 <
  C1: true
  A1: VERBPPROPREC1 := COPYT_clausetoverbpprop(CLAUSEREC1);

 >
DECOMP
 <
