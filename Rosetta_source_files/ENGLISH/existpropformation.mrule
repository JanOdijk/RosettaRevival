ENGLISH 99

&
\begin{verbatim}
%
%SUBGRAMMAR ExistPropFormation

  (* RC_StartExistential *)
( RStartExist/1 )
.
  (* RC_ExistTempVarInsertion *)
  (* RC_ExistSentAdvVarInsertion *)
  (* RC_ExistLocAdvVarInsertion *)
{ RExistRefVarInsert/2 |
  RExistConjSentVar/5  | RExistFinalConjsentVar/7 | RExistSentAdvVar/6 |
  RExistLocAdvVar/3    | RExistLocPreppVar/4 }


HEAD:
<
NPVAR  BASIC EXPRESSION
>

(* IMPORT: *) 
<
 2: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION
      ARGUMENT 2    ADVPVAR       BASIC EXPRESSION
      ARGUMENT 2    SENTENCEVAR   BASIC EXPRESSION
    >
 3: < ARGUMENT 2    ADVPVAR       BASIC EXPRESSION
    >
 4: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION
    >
 5: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION
      ARGUMENT 2    SENTENCEVAR   BASIC EXPRESSION
    >
 6: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION
      ARGUMENT 2    ADVPVAR       BASIC EXPRESSION
    >
 7: < ARGUMENT 2    PREPPVAR      BASIC EXPRESSION
      ARGUMENT 2    SENTENCEVAR   BASIC EXPRESSION
    >
>

EXPORT:
<
NPPROP
>

&
\end{verbatim}
\newpage
\begin{verbatim}

% RULE RStartExist
< m1: NPVAR{NPVARrec1} 
>

< m : NPPROP{NPPROPrec1}[ objrel/NPVAR{NPVARrec1} ] 
>

      COMP
         <
          C1: NPVARrec1.definite = indef
          A1: NPPROPrec1.aktionsarts := [stative]
              (* rest of NPPROPrec retains default values *)
         >
      DECOMP
         <
          C1: NPVARrec1.definite = indef AND
              NPPROPrec1 = NPPROPrecdef 
                               EXCEPT FOR [aktionsarts] AND
              NPPROPrec1.aktionsarts = [stative]
          A1: @
         >

&

\end{verbatim}
