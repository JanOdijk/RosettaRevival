%LABELtje
BASIS RULE
      LABELtje = MLABELtje/1|ILABELtje/2|RLABELtje/3|LLABELtje/4
                 |TREEVAR/5|MUVAR/6|SIGMAVAR/7
SURFACE PART
VAR 
    labelkind::labelkindtype;
    str:TSTRING_string;

<*
INIT: BEGIN TSTRING_constantempty(str);
            labelkind:=Ilabel 
      END;
1 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%MLABELtje.str;
                              labelkind:=Mlabel
                        END
    *>
