% RULE REmptysubstitution4

                   (* subst of seEMPTY as a subjrel/.. *)

< m1: I1::CLAUSE{CLAUSErec1}
                [ mu6,
                  I4: subjrel/EMPTYVAR{EMPTYVARrec1},
                  mu7,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu4
                         ],
                  mu5
                ]
SUBST:
  m2: EMPTY(KEY_seemptykey){EMPTYrec1}            (*substituent*)
>

< m: I2::CLAUSE{CLAUSErec2}
                [ mu6,
                  mu7,
                  predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu4
                         ],
                  mu5
                ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice IN [SEactive, active])
       I2: (CLAUSErec2.voice IN [SEactive, active])
       I3: (Active IN VERBrec1.possvoices ) AND
           (VERBrec1.thetavp IN [vp100, vp120, vp123] ) 
       I4: EMPTYVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2
         >
&

\end{verbatim}
