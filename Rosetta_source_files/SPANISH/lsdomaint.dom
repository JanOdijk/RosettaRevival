RECORDS:
<

NOrecord =         
                   <
                   >

BADJrecord =
                   <
                    req:            polarityEFFSETtype:[pospol,negpol,omegapol]
                    env:            polarityEFFSETtype:[pospol,negpol,omegapol]

                    pluralforma:    ADJpluralformatype:reg  {*morph*}
                    femforma:       femformatype:normal     {*morph*}
                    irrComp:        sinotype:no             {*morph*}
                    possApocope:    sinotype:no             {*morph*}
                 
                    posicion:       posiciontype:ambosPosicion

                    class:          timeadvclasstype:omegaTimeAdvClass
                    tiempo:         tiempotype:omegatiempo
                    aspecto:        aspectotype:omegaaspecto
                    retro:          retrotype:false

                    uses:           adjuseSETtype:[attributive, predicative]

                    temporal:       temporaltype:false
                    subcs:          adjsubcSETtype:[otheradj]
                    reflexivity:    reflexivetype:notreflexive
                    thetaadj:       thetaadjtype:omegathetaadjp
                    adjpatterns:    synpatternSETtype:[]
                    prepkey:        keytype:0
                    possadv:        possadvtype:true

                    ARTindef:       sinotype:si             {*Spanish*}
                    copulas:        copulaSETtype:[estar]   {*Spanish*}
                    KEY
                   >

SUBADJrecord =
                   <
                    req:            polarityEFFSETtype:[pospol,negpol,omegapol]
                    env:            polarityEFFSETtype:[pospol,negpol,omegapol]

                    class:          timeadvclasstype:omegaTimeAdvClass
                    tiempo:         tiempotype:omegatiempo  
                    aspecto:        aspectotype:omegaaspecto
                    retro:          retrotype:false

                    pluralforma:    ADJpluralformatype:reg  {*morph*}
                    femforma:       femformatype:normal     {*morph*}
                    possApocope:    sinotype:no             {*morph*}

                    posicion:       posiciontype:ambosPosicion

                    uses:           adjuseSETtype:[attributive, predicative]

                    temporal:       temporaltype:false
                    subcs:          adjsubcSETtype:[otheradj]
                    reflexivity:    reflexivetype:notreflexive
                    thetaadj:       thetaadjtype:omegathetaadjp
                    adjpatterns:    synpatternSETtype:[]
                    prepkey:        keytype:0
