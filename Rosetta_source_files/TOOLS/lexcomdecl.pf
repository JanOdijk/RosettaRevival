(*MPF:::===================================================================*
 *
 *  Function Name  : LEXCOMDECL_surfgraph
 *  Description    : 
 *  Parameters     :0<i<=LEXCOMDECL_maxrnr 
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : 
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

FUNCTION LEXCOMDECL_surfgraph(i:INTEGER):LEXCOMDECL_psurfgraph; EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LEXCOMDECL_assignsurfgraph
 *  Description    : 
 *  Parameters     : o<i<=LEXCOMDECL_maxrnr
 *  Result         :  
 *  Precondition   : 
 *  Postcondition  : valeu of surfgraph(i) is 'valeu'
 *  Side Effects   : 
 *
 *EMP:::===================================================================*)

PROCEDURE LEXCOMDECL_assignsurfgraph(i:INTEGER;valeu:LEXCOMDECL_psurfgraph); EXTERNAL;

(*MPF:::===================================================================*
