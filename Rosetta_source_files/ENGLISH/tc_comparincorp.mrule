\begin{verbatim}
% TRANSFORMATION Tincorpdefault
< m1:CLAUSE{CLAUSErec1}[mu1, predrel/VERBP{VERBPrec1}[mu2],mu3]
>

< m :CLAUSE{CLAUSErec1}[mu1, predrel/VERBP{VERBPrec1}[mu2],mu3]
>

   MATCHCONDITIONS
      <
       m1: NOT EXIST(mu2,[../ADJP{}[mu4]]) OR
           CLAUSErec1.synvpefs * [synbe] = []
       m : NOT EXIST(mu2,[../ADJP{}[mu4]]) OR
           CLAUSErec1.synvpefs * [synbe] = []
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
