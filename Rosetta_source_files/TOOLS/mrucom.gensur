       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%RLABELtje.str;
                              labelkind:=RLABEL
                        END
    *>
4 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%LLABELtje.str;
                              labelkind:=LLABEL
                        END
    *>
5 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%TREEVAR.str;
                              labelkind:=TLABEL
                        END
    *>
6 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%MUVAR.str;
                              labelkind:=MULABEL
                        END
    *>
7 : <* LOCALCONDITION: TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str:=%SIGMAVAR.str;
                              labelkind:=SIGLABEL
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_LABELtje; 
                      $LABELtje.labelkind:=labelkind;
                      $LABELtje.str:=str
                END
*>
END;
