\newpage
\begin{verbatim}
% TRANSFORMATION TNoWhInfShift
< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1, 
                  subjrel/I2::NPVAR{NPVARrec2},
                  mu3 
                ]
>

< m : I1::CLAUSE{CLAUSErec1}
                [ mu1, 
                  subjrel/I2::NPVAR{NPVARrec1},
                  mu3 
                ]
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = infinite
       I2: NPVARrec1.mood = wh
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TNoWhInfShift
\item[* relevant examples:] (seem) who to have done it
\item[* language:] (Dutch, English, Spanish) English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] clauseTOsentence
\item[* class:] (name of rule, transformation or filter class) TC\_WhShift
\item[* date of creation:] 12-AUG-1988 
\item[* author:] margreet sanders
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] to let infinite clauses with a wh-subject still pass this 
transformation class. This is needed for TSubjToSubjRaising (in the 
ObjectOK rules), where only subjects are moved to the higher clause, not 
shiftrels.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
