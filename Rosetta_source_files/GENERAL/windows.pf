 *
 *EMP:::===================================================================*)

 
PROCEDURE Windows_Erase (VAR w        : Windows_Window;
                         Row          : Windows_RowRange;
                         Rows         : Windows_RowRange; 
                         Column       : Windows_ColumnRange;
                         Columns      : Windows_ColumnRange);
EXTERNAL;





