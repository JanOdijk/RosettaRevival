\begin{verbatim}

% TRANSFORMATION TVerbpattern1
< m1: I1::VERBPPROP{VERBPPROPrec1}[sig1,
                                   predrel/VERBP{VERBPrec1}
                                          [head/VERB{VERBrec1}[mu1],
                                           argrel/T1  
                                          ] 
                                  ]
>

< m : VERBPPROP{VERBPPROPrec2}[sig1,
                               predrel/VERBP{VERBPrec1}
                                      [head/VERB{VERBrec1}[mu1],
                                       rel1/T1  
                                      ] 
                              ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
      >

<
   SUBRULE (* 1a: melt x1; x1 beat x2, x1 regret x2 *)
      <T1: NPVAR{NPVARrec1} >
      <T1: NPVAR{NPVARrec1} >

      COMP
         <
          C1: synNP IN VERBrec1.synvps AND
              NPVARrec1.NPhead <> openIngNP
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synNP];
              rel1 := objrel
         >
      DECOMP
         <
          C1: synNP IN VERBPPROPrec2.synvpefs AND
              synNP IN VERBrec1.synvps AND
              rel1 = objrel AND
              NPVARrec1.NPhead <> openIngNP
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 1b: melt x1; x1 beat x2, x1 regret x2 *)
      <T1: CNVAR{CNVARrec1} >
      <T1: CNVAR{CNVARrec1} >

      COMP
         <
          C1: synNP IN VERBrec1.synvps 
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synNP];
              rel1 := objrel
         >
      DECOMP
         <
          C1: synNP IN VERBPPROPrec2.synvpefs AND
              synNP IN VERBrec1.synvps AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 2: x1 eat EMPTY *)
      <T1: EMPTYVAR{EMPTYVARrec1} >
      <T1: EMPTYVAR{EMPTYVARrec1} >

      COMP
         <
          C1: synEMPTY IN VERBrec1.synvps
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synEMPTY];
              rel1 := objrel
         >
      DECOMP
         <
          C1: synEMPTY IN VERBPPROPrec2.synvpefs AND
              synEMPTY IN VERBrec1.synvps AND
              rel1 = objrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3a: become x1; x1 consider x2 *)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synCLOSEDNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDNPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synCLOSEDNPPROP IN VERBPPROPrec2.synvpefs AND
              synCLOSEDNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = false AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 3b: ? *)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synOPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENNPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENNPPROP IN VERBPPROPrec2.synvpefs AND
              synOPENNPPROP IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4a: turn out x1; x1 consider x2 *)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synCLOSEDADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDADJPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synCLOSEDADJPPROP IN VERBPPROPrec2.synvpefs AND
              synCLOSEDADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = false AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 4b: x1 smell x2 *)
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T1: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: synOPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENADJPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENADJPPROP IN VERBPPROPrec2.synvpefs AND
              synOPENADJPPROP IN VERBrec1.synvps AND
              ADJPPROPVARrec1.PROsubject = true AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 5: x1 weigh x2 *)
      <T1: NPPROPVAR{NPPROPVARrec1} >
      <T1: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: synMEASUREPHRASE IN  VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synMEASUREPHRASE];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synMEASUREPHRASE IN VERBPPROPrec2.synvpefs AND
              synMEASUREPHRASE IN VERBrec1.synvps AND
              NPPROPVARrec1.PROsubject = true AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 6: appear x1 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synASIFSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood       : declarative
                                 senttype   : subordinateclause
                                 PROsubject : false
                                 finiteness : finite
                                 conjkey    : KEY_asifconjkey
                                } (* not all attributes *)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synASIFSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synASIFSENT IN VERBPPROPrec2.synvpefs AND
              synASIFSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood       : declarative
                                 senttype   : subordinateclause
                                 PROsubject : false
                                 finiteness : finite
                                 conjkey    : KEY_asifconjkey
                                } (* not all attributes *)
              AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7a1: x1 get in x2, x1 put in x2 *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synLOCCLOSEDPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = false AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCCLOSEDPREPPPROP];
              rel1 := locargrel
         >
      DECOMP
         <
          C1: synLOCCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synLOCCLOSEDPREPPPROP IN VERBrec1.synvps AND
              rel1 = locargrel AND
              PREPPPROPVARrec1.PROsubject = false AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7a2: x1 get x2 *)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synLOCCLOSEDPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = false AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCCLOSEDPREPPPROP];
              rel1 := locargrel
         >
      DECOMP
         <
          C1: synLOCCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synLOCCLOSEDPREPPPROP IN VERBrec1.synvps AND
              rel1 = locargrel AND
              ADVPPROPVARrec1.PROsubject = false AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7b1: x1 stand behind x2 *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synLOCOPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCOPENPREPPPROP];
              rel1 := locargrel
         >
      DECOMP
         <
          C1: synLOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synLOCOPENPREPPPROP IN VERBrec1.synvps AND
              rel1 = locargrel AND
              PREPPPROPVARrec1.PROsubject = true AND
              loc IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 7b2: x1 live in x2 *)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synLOCOPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synLOCOPENPREPPPROP];
              rel1 := locargrel
         >
      DECOMP
         <
          C1: synLOCOPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synLOCOPENPREPPPROP IN VERBrec1.synvps AND
              rel1 = locargrel AND
              ADVPPROPVARrec1.PROsubject = true AND
              locadv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 8a1: ?x1 get into x2 *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDIRCLOSEDPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = false AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIRCLOSEDPREPPPROP];
              rel1 := dirargrel
         >
      DECOMP
         <
          C1: synDIRCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDIRCLOSEDPREPPPROP IN VERBrec1.synvps AND
              rel1 = dirargrel AND
              PREPPPROPVARrec1.PROsubject = false AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 8a2: ? *)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      COMP
         <
          C1: synDIRCLOSEDPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = false AND
              diradv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIRCLOSEDPREPPPROP];
              rel1 := dirargrel
         >
      DECOMP
         <
          C1: synDIRCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDIRCLOSEDPREPPPROP IN VERBrec1.synvps AND
              rel1 = dirargrel AND
              ADVPPROPVARrec1.PROsubject = false AND
              diradv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 8b1: x1 jump off x2 *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synDIROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIROPENPREPPPROP];
              rel1 := dirargrel
         >
      DECOMP
         <
          C1: synDIROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDIROPENPREPPPROP IN VERBrec1.synvps AND
              rel1 = dirargrel AND
              PREPPPROPVARrec1.PROsubject = true AND
              dir IN PREPPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 8b2: x1 swim x2 *)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synDIROPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              diradv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synDIROPENPREPPPROP];
              rel1 := dirargrel
         >
      DECOMP
         <
          C1: synDIROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synDIROPENPREPPPROP IN VERBrec1.synvps AND
              rel1 = dirargrel AND
              ADVPPROPVARrec1.PROsubject = true AND
              diradv IN ADVPPROPVARrec1.actsubcefs
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 9a1: ? seem x1 *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHERCLOSEDPREPPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOTHERCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              rel1 = complrel AND
              PREPPPROPVARrec1.PROsubject = false AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 9a2: ?? *)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = false AND
              ADVPPROPVARrec1.actsubcefs * AUX_otheradvsubcs <> []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHERCLOSEDPREPPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOTHERCLOSEDPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synOTHERCLOSEDPREPPPROP IN VERBrec1.synvps AND
              rel1 = complrel AND
              ADVPPROPVARrec1.PROsubject = false AND
              ADVPPROPVARrec1.actsubcefs * AUX_otheradvsubcs <> []
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 9b1: ?? *)
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >
      <T1: PREPPPROPVAR{PREPPPROPVARrec1} >

      COMP
         <
          C1: synOTHEROPENPREPPPROP IN VERBrec1.synvps AND
              PREPPPROPVARrec1.PROsubject = true AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHEROPENPREPPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOTHEROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synOTHEROPENPREPPPROP IN VERBrec1.synvps AND
              rel1 = complrel AND
              PREPPPROPVARrec1.PROsubject = true AND
              PREPPPROPVARrec1.actsubcefs * AUX_otherprepsubcs <> []
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 9b2: ?? *)
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >
      <T1: ADVPPROPVAR{ADVPPROPVARrec1} >

      COMP
         <
          C1: synOTHEROPENPREPPPROP IN VERBrec1.synvps AND
              ADVPPROPVARrec1.PROsubject = true AND
              ADVPPROPVARrec1.actsubcefs * AUX_otheradvsubcs <> []
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOTHEROPENPREPPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOTHEROPENPREPPPROP IN VERBPPROPrec2.synvpefs AND
              synOTHEROPENPREPPPROP IN VERBrec1.synvps AND
              rel1 = complrel AND
              ADVPPROPVARrec1.PROsubject = true AND
              ADVPPROPVARrec1.actsubcefs * AUX_otheradvsubcs <> []
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 10a: get x1; x1 have x2 *)
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >

      COMP
         <
          C1: synCLOSEDVERBPPROP IN VERBrec1.synvps AND
              VERBPPROPVARrec1 = { PROsubject : false 
                                   voice      : passive }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDVERBPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synCLOSEDVERBPPROP IN VERBPPROPrec2.synvpefs AND
              synCLOSEDVERBPPROP IN VERBrec1.synvps AND
              VERBPPROPVARrec1 = { PROsubject : false 
                                   voice      : passive } AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 10b: ? *)
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >
      <T1: VERBPPROPVAR{VERBPPROPVARrec1} >

      COMP
         <
          C1: synOPENVERBPPROP IN VERBrec1.synvps AND
              VERBPPROPVARrec1.PROsubject = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENVERBPPROP];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENVERBPPROP IN VERBPPROPrec2.synvpefs AND
              synOPENVERBPPROP IN VERBrec1.synvps AND
              VERBPPROPVARrec1.PROsubject = true AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 11a: can x1; x1 see x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synCLOSEDINFSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : inf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDINFSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synCLOSEDINFSENT IN VERBPPROPrec2.synvpefs AND
              synCLOSEDINFSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : inf        
                                }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 11b: x1 can x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synOPENINFSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : inf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENINFSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENINFSENT IN VERBPPROPrec2.synvpefs AND
              synOPENINFSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : inf        
                                }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 12a: x1 expect x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synCLOSEDTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : toinf
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDTOSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synCLOSEDTOSENT IN VERBPPROPrec2.synvpefs AND
              synCLOSEDTOSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : toinf        
                                }(*not all attributes*)
           A1: VERBPPROPrec1 := VERBPPROPrec2;
               VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 12b: x1 decide x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      COMP
         <
          C1: synOPENTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf
                                }(*not all attriubtes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENTOSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENTOSENT IN VERBPPROPrec2.synvpefs AND
              synOPENTOSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : true
                                 finiteness  : infinite
                                 infsort     : toinf        
                                }(*not all attributes*)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 13: x1 prefer x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synFORTOSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : fortoinf        
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synFORTOSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synFORTOSENT IN VERBPPROPrec2.synvpefs AND
              synFORTOSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : fortoinf        
                                }(*not all attributes*)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 14: x1 know x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synTHATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synTHATSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synTHATSENT IN VERBPPROPrec2.synvpefs AND
              synTHATSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = {
                                 mood        : declarative
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : finite
                                }(*not all attributes*)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 15: x1 wonder x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synQSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synQSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synQSENT IN VERBPPROPrec2.synvpefs AND
              synQSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1.senttype = subordinateclause AND
             (SENTENCEVARrec1.mood = yesnointerrogative OR
              SENTENCEVARrec1.mood = WHinterrogative)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 16a: x1 watch x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synCLOSEDGERUND IN VERBrec1.synvps AND
              SENTENCEVARrec1 = {
                                 senttype    : subordinateclause
                                 PROsubject  : false
                                 finiteness  : infinite
                                 infsort     : accing        
                                }(*not all attributes*)
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synCLOSEDGERUND];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synCLOSEDGERUND IN VERBPPROPrec2.synvpefs AND
              synCLOSEDGERUND IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 ={
                                senttype    : subordinateclause
                                PROsubject  : false
                                finiteness  : infinite
                                infsort     : accing        
                               }(*not all attributes*)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 16b: x1 burst out x2 *)
      <T1: SENTENCEVAR{SENTENCEVARrec1} >
      <T1: SENTENCEVAR{SENTENCEVARrec1} >

      COMP
         <
          C1: synOPENGERUND IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { senttype   : subordinateclause
                                  PROsubject : true
                                  finiteness : infinite
                                  infsort    : opening }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synOPENGERUND];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synOPENGERUND IN VERBPPROPrec2.synvpefs AND
              synOPENGERUND IN VERBrec1.synvps AND
              rel1 = complrel AND
              SENTENCEVARrec1 = { senttype   : subordinateclause
                                  PROsubject : true
                                  finiteness : infinite
                                  infsort    : opening }
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 17: x1 wonder x2 *)
      <T1: PROSENTVAR{PROSENTVARrec1} >
      <T1: PROSENTVAR{PROSENTVARrec1} >

      COMP
         <
          C1: synPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = false
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synPROSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synPROSENT IN VERBPPROPrec2.synvpefs AND
              synPROSENT IN VERBrec1.synvps AND
              rel1 = complrel AND
              PROSENTVARrec1.so = false
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >

   SUBRULE (* 18: x1 think x2 *)
      <T1: PROSENTVAR{PROSENTVARrec1} >
      <T1: PROSENTVAR{PROSENTVARrec1} >

      COMP
         <
          C1: synSOPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synSOPROSENT];
              rel1 := complrel
         >
      DECOMP
         <
          C1: synSOPROSENT IN VERBPPROPrec2.synvpefs AND
              synSOPROSENT IN VERBrec1.synvps AND
              PROSENTVARrec1.so = true AND
              rel1 = complrel
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >
>
&

\end{verbatim}
\newpage
\begin{description}
\item[* language:]  English
\item[* name:] TVerbpattern1
\item[* kind of rule:] M-rule
\item[* subgrammar:] Verbppropformation
\item[* class:] TC: Verbpatternrules
\item[* date of creation:] 11-DEC-1986 16:21:01  
\item[* author:] Agnes Mijnhout, Margreet Sanders
\item[* copied from:]
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Checks if the category of the variables (and possibly more 
specific restrictions on these categories) are compatible with the category of 
the arguments that the verb allows.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
Each subrule handles a verbpattern which has one argument inside the verb 
phrase and which puts this argument directly under the verb phrase. \\
Prepositional verbs, i.e.\ verbs which place their objects inside a PREPP, are 
handled by a different rule (TVerbpattern2).
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of 
parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:] none
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\ value(s) for the attribute synvps.

\item rules:\\ follow the startrules

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc. nr. 108 (Verbpatterns in Rosetta3)
and doc. nr. 144 (Longman's grammatical codes for verbs).
\item[* relevant examples:] \mbox{}
\begin{description}
\item [subrule 1a/b] NP/CN\\
\ \ (vp010): melt x1 (the ice melts)\\
\ \ (vp120) x1 beat x2 (Mary beats John); x1 regret x2 (I regret his coming 
home late)
\item [subrule 2] EMPTY\\
\ \ (vp010): ? \\
\ \ (vp120): x1 eats x2 (John eats EMPTY)
\item [subrule 3a] CLOSEDNPPROP\\
\ \ (vp010) become x1 (She became President)\\
\ \ (vp120): x1 consider x2 (They considered him a fool)
\item [subrule 3b] OPENNPPROP\\
\ \ (vp120): ?x1 act x2 (He is always acting the experienced man)
\item [subrule 4a] CLOSEDADJPPROP\\
\ \ (vp010): turn out x1 (It turned out nice and sunny)\\
\ \ (vp120): x1 consider x2 (I consider him foolish)
\item [subrule 4b] OPENADJPPROP\\
\ \ (vp120): ?x1 smell x2 (This book smells old) (or is this verb ergative, 
with vp012?)
\item [subrule 5] MEASUREPHRASE\\
\ \ (vp120): x1 weigh x2 (This weighs a stone)
\item [subrule 6] ASIFSENT\\
\ \ (vp010): appear x1 (It appears as if she will win)\\
\ \ (vp120): x1 act x2 (He acted as if he had gone mad)
\item [subrule 7a1] LOCCLOSEDPREPPPROP\\
\ \ (vp010): ?\\
\ \ (vp120): x1 get x2 (I got the two sides round the table), x1 put x2 (I put 
him in bed)
\item [subrule 7a2] LOCCLOSED'ADVPPROP'\\
\ \ (vp010): ?\\
\ \ (vp120): x1 get x2 (I got them ?home)
\item [subrule 7b1] LOCOPENPREPPPROP\\
\ \ (vp120): x1 stand x2 (He stood behind the door), x1 remain x2 (He 
remained in bed)
\item [subrule 7b2] LOCOPEN'ADVPPROP'\\
\ \ (vp120): x1 live x2 (He lives southwards)
\item [subrule 8a1] DIRCLOSEDPREPPPROP\\
\ \ (vp010): ?\\
\ \ (vp120): ?x1 see x2 (We saw them to the door)
\item [subrule 8a2] DIRCLOSED'ADVPPROP'\\
\ \ (vp010): ?\\
\ \ (vp120): ?
\item [subrule 8b1] DIROPENPREPPPROP\\
\ \ (vp120): x1 jump x2 (He jumped off the fence)
\item [subrule 8b2] DIROPEN'ADVPPROP'\\
\ \ (vp120): x1 swim x2 (He swam southwards)
\item [subrule 9a1] OTHERCLOSEDPREPPPROP\\
\ \ (vp010): ?seem x1 (She seemed with child)\\
\ \ (vp120): ?
\item [subrule 9a2] OTHERCLOSED'ADVPPROP'\\
\ \ (vp010): ?\\
\ \ (vp120): ?
\item [subrule 9b1] OTHEROPENPREPPPROP\\
\ \ (vp120): ?
\item [subrule 9b1] OTHEROPEN'ADVPPROP'\\
\ \ (vp120): ?
\item [subrule 10a] CLOSEDVERBPPROP\\
\ \ (vp010): get x1 (He got trapped)\\
\ \ (vp120): x1 have x2 (He had a house built)
\item [subrule 10b] OPENVERBPPROP\\
\ \ (vp120): ?
\item [subrule 11a] CLOSEDINFSENT\\
\ \ (vp010): can x1 (He can come; He can be rached; epistemic modal: 
             possibility)\\
\ \ (vp120): x1 see x2 (I saw the man leave; I saw him be hit)
\item [subrule 11b] OPENINFSENT\\
\ \ (vp120): x1 can x2 (He can come: ability, not modal)
\item [subrule 12a] CLOSEDTOSENT\\
\ \ (vp010): appear x1 (He appears to be your friend)\\
\ \ (vp120): x1 expect x2 (I expect you to come)
\item [subrule 12b] OPENTOSENT\\
\ \ (vp120): x1 decide x2 (We decided to leave)
\item [subrule 13] FORTOSENT\\
\ \ (vp120): x1 prefer x2 (I prefer for John to go)
\item [subrule 14] THATSENT\\
\ \ (vp010): seems x1 (It seems that John comes)\\
\ \ (vp120): x1 know x2 (I know that he will come)\\
The absence or presence of the conjunction THAT depends on the verb (thatdel = 
yesdel implies possible absence of THAT), but also on whether the THATSENT will 
be extraposed or not (extraposed sentences always need THAT). A check on 
correct occurrence will be performed in RComplSentSubst and TExtraposition1.
This does not cause any temporal ambiguities, since in generation only 
sentences with THAT are produced.
\item [subrule 15] QSENT\\
\ \ (vp010): ?\\
\ \ (vp120): x1 wonder x2 (I wonder where to go; I wonder where I should go)
\item [subrule 16a] CLOSEDGERUND\\
\ \ (vp010): ?\\
\ \ (vp120): x1 watch x2 (He watched the moon rising over the mountain)
\item [subrule 16b] OPENGERUND\\
\ \ (vp120): x1 burst out x2 (He burst out singing) (Note that the gerund is 
analysed as a SENTENCE, contrary to PREPOPENGERUNDs which are considered NPs)
\item [subrule 17] PROSENT\\
\ \ (vp010): ?\\
\ \ (vp120): x1 wonder x2 (I wonder)
\item [subrule 18] SOPROSENT\\
\ \ (vp010): ?\\
\ \ (vp120): x1 think x2 (I think so)
\end{description}
\item[\ \ remarks:]\mbox{}
\begin{description}
\item In subrule 4a, {\em turn out\/} + ADJ is different from {\em turn out 
well\/} etc., which probably is a middle (just as: to look well?). 
\item Subrule 5 assumes that the measure phrases are analyzed 
separately, although they are OPENNPROPs. This analysis may change.
\item Subrule 6 only recognises a full AsIfSent; no rule has been added yet 
for a sentence like {\em She looked as if 
struck by some brilliant thought\/}, which probably should be classified as 
ASIFOPENVERBPPROP. (Unless the sentence is ungrammatical, and should be spelled 
without `as if'; note that Longman does not give L6 as possible pattern (= 
wh-sent), although Van Dale has the sentence {\em It looks as if it is raining\/} 
(het lijkt (wel) te regenen))
\item Is {\em look as if\/} ergative? If so, the rule just mentioned should be 
added for vp012, not for vp120. Is {\em look (like)\/} ergative? (He looks ill, 
he looks his part/age)
\item Subrule 7b1 uses {\em remain\/} as a two place verb; in sentences like {
\em It remained cold till April\/} the verb probably is monadic, while Jan O.\ 
claims that {\em Hij blijft werken\/} is ambiguous. \\
I consider Agnes' example {\em They filed past the grave\/} an instance of a 
directional prep.
\item {\em Seem\/} seems (to me?) to have two constructions: one with an
indirect (prep)object, either overt or understood (she seems rather ill 
(to me/empty)
= ze lijkt (mij) nogal ziek (covered in TVerbpattern5)),
and one without any indirect object (she seems to
be rather ill = ze schijnt goed ziek te zijn/men zegt dat ze goed ziek is
(covered in the present rules)). It 
is unclear what synpatterns combine with which of the two verbs. (Examples in 
subrules 4a, 9a1, 12a, 14)
\item In subrule 9b1 (OTHEROPENPREPPPROP) the original example was {\em he 
walks with a limp\/} (vp120). Since it is doubtful whether the PP in this 
sentence is a real argument, the example has not been included in the list. 
Perhaps this kind of PP is a `free PP', in the same way as free ADJs seem to 
exist in constructions like {\em He eats the meat raw\/} (but cf.\ {\em He 
paints the door green\/}, with a DONP\_OPENADJPPROP). The other alternative is 
that the PP is just an adverbial: {\em He walks `limpingly'\/}.
\end{description}
\begin{enumerate}
\item problems:\\ 

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}

% TRANSFORMATION Tverbpattern2
< m1: I1::VERBPPROP{VERBPPROPrec1}
                   [mu1,
                    predrel/VERBP{VERBPrec1}
                           [head/VERB{VERBrec1}[mu2],
                            argrel/SENTENCEVAR{SENTENCEVARrec1}
                           ]
                   ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [mu1,
                predrel/VERBP{VERBPrec1}
                       [head/VERB{VERBrec1}[mu2],
                        objrel/NP{NPrec1}
                              [head/PERSPRO{PERSPROrec1}
                                   [head/BPERSPRO(KEY_itbpersprokey)
                                                      {BPERSPROrec1} ]
                              ],
                        complrel/SENTENCEVAR{SENTENCEVARrec1}
                       ]
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs = []
      >

      COMP
         <
          C1: synITTHATSENT IN VERBrec1.synvps AND
              SENTENCEVARrec1 = { mood         : declarative
                                  senttype     : subordinateclause
                                  PROsubject   : false
                                  finiteness   : finite }
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.synvpefs := [synITTHATSENT];
              PERSPROrec1 := COPYT_bpersproTOperspro(BPERSPROrec1);
              (* persprocase retains the default value `omegacase' *)
              NPrec1 := AUX_NPONitPRSPR
         >
      DECOMP
         <
          C1: synITTHATSENT IN VERBrec1.synvps AND
              synITTHATSENT IN VERBPPROPrec2.synvpefs AND
              SENTENCEVARrec1 = { mood         : declarative
                                  senttype     : subordinateclause
                                  PROsubject   : false
                                  finiteness   : finite } AND
              PERSPROrec1 = COPYT_bpersproTOperspro(BPERSPROrec1) 
                            EXCEPT FOR [persprocase] AND
              PERSPROrec1.persprocase = omegacase AND
              NPrec1 = AUX_NPONitPRSPR
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.synvpefs := []
         >
&
\end{verbatim}
