(*MPD:::===================================================================*
 *
 *  Rosetta Project                                                 
 *                                                                  
 *  Module Title    : LISTREE 
 *  Creation date   :                                               
 *  Author          :                                               
 *                                                                  
 *  Copyright (c) 1985, by Nederlandse Philips Bedrijven BV.        
 *                                                                  
 *  Remarks         :  This module defines the abstract datatype S-trees.
 *                     The S-trees defined here are completely
 *                     language independent. In order to accomplish this
 *                     a kind of trick has been used. For each language
 *                     there will be a module LS-STREE, in which the
 *                     language specific parts are defined explicitely.
 *                     If S-trees are passed from language specific modules
 *                     to language independent modules a CAST operation 
 *                     transforms the LS-Strees into the LI-Strees.
 *
 *  Modified at  27-APR-1987 by Carel Fellinger
 *                     The definitions of the data types Stree and Dtree are
 *                     mutual dependent. An Stree contains a pointer to a list
 *                     of Dtrees, beeing the result of applying M-Parser to
 *                     that Stree. A Dtree contains a pointer to a list of
 *                     Strees, beeing the result of applying M-Generator to
 *                     that Dtree. In this way both M-Parser and M-Generator
 *                     can be a little more efficient, because in case of
 *                     convergence in Strees cq. Dtrees M_Parser cq. M_Generator
 *                     only have to be applied once!
 *                     In a language like Modula2 this mutual dependency could
 *                     be solved by defining the type Dtree as a hidden type in
 *                     the definition of Stree, and declare it to be a real
 *                     Dtree in the implementation of Stree. (The same has to
 *                     be done for Stree in Dtree.) In VAX/VMS Pascal we have to
 *                     use the CAST trick again (see above).
 *
 *EMP:::===================================================================*)

pragma C_include('lidomaint.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE LISTREE;
WITH LIDOMAINT;

(*MPC:::===================================================================*
 *
 *  Constant name  : LISTREE_MaxBugString
 *  Description    : Maximum length of strings used in LI part of S-tree node
 *
 *EMP:::===================================================================*)

CONST
   LISTREE_MaxBugString = 50;

TYPE

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_pStree
 *  Description    : Pointer to S-tree
 *
 *EMP:::===================================================================*)
   LISTREE_pStree   = ^LISTREE_Stree;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_Prelnode
 *  Description    : Pointer to relation node
 *
 *EMP:::===================================================================*)
   LISTREE_pRelNode = ^LISTREE_RelNode;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_PLIrecord
 *  Description    : Pointer to LI stree information
 *
 *EMP:::===================================================================*)
   LISTREE_pLIrecord = ^LISTREE_LIrecord;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_stree
 *  Description    : This is the LI definition of an S-tree.
 *
 *                           LISTREE_stree
 *                           +-----+
 *                           |     |
 *                           |     |
 *                           +-----+
 *                              |
 *                              |                    LISTREE_relnode
 *                           +-----+     +-----+     +-----+
 *                           |     |---->|     |---->|     |
 *                           +-----+     +-----+     +-----+
 *                              |           |           |
 *                              |           |           |
 *
 *EMP:::===================================================================*)
   LISTREE_Stree = RECORD cat  : LIDOMAINT_syntcat;
                          sons : LISTREE_pRelNode;
                          twin : LISTREE_pstree;
                          LI   : LISTREE_pLIrecord;
                          LS   : LIDOMAINT_pLSrecord
                   END;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_relnode
 *  Description    : Definition of relation-node
 *
 *EMP:::===================================================================*)
   LISTREE_RelNode = RECORD node     : LISTREE_pStree;
                            brother  : LISTREE_pRelNode;
                            relation : LIDOMAINT_synrel
                     END;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_LIrecord
 *  Description    : Definition of a record which can contain specific
 *                   LI information which is irrelevant for the LS software
 *
 *                   Done iff MParser has been applied to this Stree and
 *                   the resulting Dtrees have been saved in Dtrees.
 *                   Dtrees holds a pointer to a set of dtrees, implemented
 *                   by means of the CAST trick.
 *                   Both Done and Dtrees are only to be accessed via the 
 *                   routines LIStree_IsParseResultSaved, LIStree_SaveParseResult
 *                   and LIStree_ReturnParseResult.
 *
 *EMP:::===================================================================*)
   LIStree_pSetOfSuperDtree = ^integer;
   LISTREE_pHyperNodeElt    = ^integer;
   LISTREE_BugString        = RECORD
                                 str: STRING(LISTREE_MaxBugString);
                                 len: INTEGER
                              END;
   LISTREE_pBugString       = ^LISTREE_BugString;
   LISTREE_LIrecord = RECORD n,minpos,maxpos : integer;
                             first        : BOOLEAN;
                             Done         : BOOLEAN;
                             Dtrees       : LIStree_pSetOfSuperDtree;
                             HyperNodeElt : LISTREE_pHyperNodeElt;
                             X, Y, len    : INTEGER;
                             BxprId       : INTEGER;
                             BugString    : LISTREE_pBugString;
                             synbonus     : INTEGER;
                             sembonus     : INTEGER;
                      END;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_SetOfStrees
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LISTREE_pLoStree   = ^LISTREE_LoStree;
   LISTREE_LoStree    = RECORD
                             arg: LISTREE_pStree;
                             next: LISTREE_pLoStree;
                             bonus: INTEGER;
                         END;
   LISTREE_SetOfStrees = RECORD
   			     first,last:LISTREE_pLoStree;
                             j:INTEGER; {for use in surface parser}
                             cur : LISTREE_pLoStree
   			 END;

   LISTREE_pSetOfStrees = ^LISTREE_SetOfStrees;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_SetOfSetOfStrees
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LISTREE_plossetofstrees = ^LISTREE_lossetofstrees;
   LISTREE_lossetofstrees = RECORD
                     next:LISTREE_plossetofstrees;
                     arg:LISTREE_setofstrees
                    END;
   LISTREE_SetOfSetOfStrees = RECORD
                               first,last:LISTREE_plossetofstrees;
                               StillCartProdElts: BOOLEAN
                              END;
   LISTREE_TupleOfSetOfStrees = LISTREE_SetOfSetOfStrees;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_TupleOfStrees
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LISTREE_TupleOfStrees = LISTREE_SetOfStrees;

(*MPT:::===================================================================*
 *
 *  Type name      : LISTREE_SetOfTupleOfStrees
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LISTREE_pTupleOfStrees = ^LISTREE_TupleOfStrees;
   LISTREE_pLoTupleOfStrees = ^LISTREE_LoTupleOfStrees;
   LISTREE_LoTupleOfStrees = RECORD
                                 arg:LISTREE_TupleOfStrees;
                                 next:LISTREE_pLoTupleOfStrees;
                                 bonus: INTEGER;
                             END;
   LISTREE_SetOfTupleOfStrees = RECORD
                                  first,last:LISTREE_pLoTupleOfStrees
                                END;

