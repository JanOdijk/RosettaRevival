/* select: semi idioms window */

object le_id_window : XmFormDialog {
  arguments {
    arguments form_dialog_args;
    XmNdialogTitle    = 'Idiom';
    XmNdialogStyle    = XmDIALOG_FULL_APPLICATION_MODAL; 
/*    XmNmenuBar    = XmMenuBar le_id_menubar; */
    XmNnoResize  = true;
  };
  controls {
    XmMenuBar   le_id_menubar;
    XmRowColumn le_id_arguments;
    XmRowColumn le_id_pattern;
    XmRowColumn le_id_skey;
    XmRowColumn le_id_mkey;
    XmRowColumn le_id_comments;
/*    XmSeparator le_id_separator; */
    XmRowColumn le_id_button_box;
    XmLabel     le_id_deleted;
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_id_window + 
               DEFAULT_BUTTON_OFFSET*X_le_id_ok_button);
  };
};

object le_id_menubar : XmMenuBar {
  arguments {
    XmNtopAttachment  = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNmenuHelpWidget = XmCascadeButton le_id_help_menu; 
    XmNspacing    = 30;
  };
  controls {
    XmCascadeButton le_id_edit_menu;
    XmCascadeButton le_id_options_menu;
    XmCascadeButton le_id_help_menu; 
  };
};

object le_id_edit_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Edit';
    XmNsensitive   = true;
  };
  controls {
    XmPulldownMenu {
      controls {
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Modify';
          };
          controls {
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Argument';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_id_modify_argument_button);
                    XmNactivateCallback = procedure
              XwbAction (X_le_id_modify_argument_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Pattern';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure 
              XwuCreateWidget (X_le_id_modify_pattern_button);
                    XmNactivateCallback = procedure
              XwbAction (X_le_id_modify_pattern_button);
                  };
                };
                XmCascadeButton {
                  arguments {
                    arguments cascade_args;
                    XmNsensitive   = true;
                    XmNlabelString = 'Meaning';
                  };
                  controls {
                    XmPulldownMenu {
                      controls {
                        XmPushButton {
                          arguments {
                            arguments cascade_args;
                            XmNlabelString = 'New meaning';
                          };
                          callbacks {
                            MrmNcreateCallback = procedure
                      XwuCreateWidget (X_le_id_new_meaning_button);
                            XmNactivateCallback = procedure
                      XwbAction (X_le_id_new_meaning_button);
                          };
                        };
                        XmCascadeButton {
                          arguments {
                            arguments cascade_args;
                            XmNsensitive   = true;
                            XmNlabelString = 'Existing meaning';
                          };
                          controls {
                            XmPulldownMenu {
                              controls {
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'Dutch';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_id_dutch_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_id_dutch_meaning_button);
                                  };
                                };
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'English';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_id_english_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_id_english_meaning_button);
                                  };
                                };
                                XmPushButton {
                                  arguments {
                                    arguments cascade_args;
                                    XmNlabelString = 'Spanish';
                                  };
                                  callbacks {
                                    MrmNcreateCallback = procedure
                           XwuCreateWidget (X_le_id_spanish_meaning_button);
                                    XmNactivateCallback = procedure
                           XwbAction (X_le_id_spanish_meaning_button);
                                  };
                                };
                              };
                            };
                          };
                        };
                      };
                    };
                  };
                };
              };
            };
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Insert Argument';
          };
          callbacks {
            MrmNcreateCallback = procedure
      XwuCreateWidget (X_le_id_insert_argument_button);
            XmNactivateCallback = procedure
      XwbAction (X_le_id_insert_argument_button);
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Delete Idiom';
          };
          callbacks {
            MrmNcreateCallback = procedure
      XwuCreateWidget (X_le_id_delete_id_button);
            XmNactivateCallback = procedure
      XwbAction (X_le_id_delete_id_button);
          };
        };
      };
    };
  };
};

object le_id_options_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Options';
    XmNsensitive   = true;
  };
  controls {
    XmPulldownMenu {
      controls {
        XmCascadeButton {
          arguments {
            arguments cascade_args;
            XmNsensitive   = true;
            XmNlabelString = 'Translate';
          };
          controls {
            XmPulldownMenu {
              controls {
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Dutch';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_id_translate_dutch_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_id_translate_dutch_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'English';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_id_translate_english_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_id_translate_english_button);
                  };
                };
                XmPushButton {
                  arguments {
                    arguments cascade_args;
                    XmNlabelString = 'Spanish';
                  };
                  callbacks {
                    MrmNcreateCallback = procedure
            XwuCreateWidget (X_le_id_translate_spanish_button);
                    XmNactivateCallback = procedure
            XwbAction (X_le_id_translate_spanish_button);
                  };
                };
              };
            };
          };
        };
        XmPushButton {
          arguments {
            arguments cascade_args;
            XmNlabelString = 'Show Argument';
          };
          callbacks {
            MrmNcreateCallback = procedure
              XwuCreateWidget (X_le_id_show_argument_button);
            XmNactivateCallback = procedure
              XwbAction (X_le_id_show_argument_button);
          };
        };
      };
    };
  };
};

object le_id_help_menu : XmCascadeButton {
  arguments {
    arguments cascade_args;
    XmNlabelString = 'Help';
    XmNsensitive   = true;
  };
  callbacks {
    MrmNcreateCallback = procedure
             XwuCreateWidget (X_le_id_help_button);
    XmNactivateCallback = procedure XwhAction (X_le_id_help_button);
  };
};

object le_id_arguments: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmMenuBar le_id_menubar;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Arguments: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 80;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_id_arguments);
      };
    };
  };
};

object le_id_pattern: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_id_arguments;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
  };
  controls {
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = 'Pattern: ';
        XmNx = 3;
      };
    };
    XmLabel {
      arguments {
        arguments label_args;
        XmNlabelString  = '';
        XmNx = 80;
      };
      callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget
               (X_le_id_pattern);
      };
    };
  };
};

object le_id_skey: XmRowColumn {
  arguments {
    XmNtopAttachment    = XmATTACH_WIDGET;
    XmNtopWidget        = XmRowColumn le_id_pattern;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNrightAttachment  = XmATTACH_FORM;
    XmNpacking          = XmPACK_NONE;
    XmNorientation      = XmHORIZONTAL;
