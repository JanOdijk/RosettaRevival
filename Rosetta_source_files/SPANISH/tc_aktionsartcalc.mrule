SPANISH 35
&
\newpage
\begin{verbatim}
%
% TRANSFORMATION taktactivity1
< m1:VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu3], 
                       I1:mu4
                      ],
               mu5
              ]
>

< m :VERBPPROP{VERBPPROPrec2}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu3], 
                       I1:mu4
                      ],
               mu5
              ]

>
   MATCHCONDITIONS
      < I1: NOT EXIST(mu4, [I2:rel1/T1])
        I2: (rel1 IN [objrel, prepobjrel]) AND (T1.CAT IN [CNVAR, NPVAR, VARPREPP])
      >
      COMP
         <
          C1: (durativeclass IN VERBrec1.classes) AND
              (VERBrec1.thetavp IN [vp000, vp100, vp120, vp123, vp132, vp321,
                                    vp312, vp210]) AND
              (VERBPPROPrec1.aktionsarts = [])
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.aktionsarts := [activity];
         >
      DECOMP
         <
          C1: (durativeclass IN VERBrec1.classes) AND
              (VERBrec1.thetavp IN [vp000, vp100, vp120, vp123, vp132, vp321,
                                    vp312, vp210]) AND
              (activity IN VERBPPROPrec2.aktionsarts)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.aktionsarts := [];

         >

&
\end{verbatim}
\newpage
\begin{description}
\item[* name:] taktactivity1
\item[* relevant examples:] x1 dormir, x1 trabajar, x1 escribir, x1 caminar,
llover, x1 comer EMPTY
\item[* language:] Spanish
\item[* kind of rule:] M-rule
\item[* subgrammar:] VERBtoVERBPPROP
\item[* class:] Aktionsartcalculation transformations
\item[* date of creation:] 26-JAN-1988 
\item[* author:] Lisette Appelo
\item[* copied from:] Taktactivity1 Dutch Lisette Appelo
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author: 
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] Calculate the value for the attribute {\em aktionsarts}
on basis of 
properties of the main VERB (attribute {\em classes})
 and properties of the arguments
. In this rule a subject argument is allowed (but not needed)
without restrictions.
This rule is for non-ergative verbs with type {\em 
durativeclass}. An object is not allowed except for EMPTY(VAR) or idiom part.
\item[\ \ strategy:] (also: deviations from accepted proposals)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]  no
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary: the attribute {\em classes}
 for verbs has been assigned properly\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:] doc 53
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications: The attribute Aktionsart is now an (eff)set, because of 
the surface parser. The record of the VERBP does not have {\em Aktionsarts}
as an 
attribute but {\em classes}.\\

\end{enumerate}
\end{description}


\newpage
\begin{verbatim}
% TRANSFORMATION taktactivity2
< m1:VERBPPROP{VERBPPROPrec1}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu3], 
                       I1:mu4
                      ],
               mu5
              ]
>

< m :VERBPPROP{VERBPPROPrec2}
              [mu1,
               predrel/VERBP{VERBPrec1}
                      [mu2,
                       head/VERB{VERBrec1}[mu3], 
                       I1:mu4
                      ],
               mu5
              ]

>
   MATCHCONDITIONS
      < I1: NOT EXIST(mu4, [I2:rel1/T1])
        I2: (rel1 IN [dirargrel]) AND (T1.CAT = PREPPPROPVAR)
      >
      COMP
         <
          C1: (movementclass IN VERBrec1.classes) AND
              (VERBPPROPrec1.aktionsarts = [])
          A1: VERBPPROPrec2 := VERBPPROPrec1;
              VERBPPROPrec2.aktionsarts := [activity];
         >
      DECOMP
         <
          C1: (movementclass IN VERBrec1.classes) AND
              (activity IN VERBPPROPrec2.aktionsarts)
          A1: VERBPPROPrec1 := VERBPPROPrec2;
              VERBPPROPrec1.aktionsarts := [];

         >

&
\end{verbatim}
