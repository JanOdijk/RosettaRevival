pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('mrudomcomlangspec.pf');

PACKAGE mrudomcomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     mrudomcomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   mrudomcomDECL_Surfrulemode = (loccond, globcond);
   mrudomcomDECL_psyntcat     = ^mrudomcomLANGSPEC_Category;
   mrudomcomDECL_syntcatset   = SET OF mrudomcomLANGSPEC_Category;
   mrudomcomDECL_nodeid         = HINIT..HFINAL;
   mrudomcomDECL_plonodeid      = ^mrudomcomDECL_lonodeid;
   mrudomcomDECL_lonodeid       = RECORD
   			          next: mrudomcomDECL_plonodeid;
   			          arg : mrudomcomDECL_nodeid
   	 	               END;
   mrudomcomDECL_pSnode       = ^mrudomcomDECL_Snode;
   mrudomcomDECL_pRsnode      = ^mrudomcomDECL_Rsnode;
   mrudomcomDECL_Rsnode       = RECORD
                                sonnumber:mrudomcomDECL_nodeid;
                                node    : mrudomcomDECL_pSnode;
                                brother : mrudomcomDECL_pRsnode
                             END;
   mrudomcomDECL_Snode        = RECORD
                                sonlist : mrudomcomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : mrudomcomLANGSPEC_Category;
                                ldfield : mrudomcomLANGSPEC_FieldDef
                             END;
   mrudomcomDECL_pLostree     = ^mrudomcomDECL_Lostree;
   mrudomcomDECL_Lostree      = RECORD
                                next    : mrudomcomDECL_pLostree;
                                arg     : mrudomcomDECL_pSnode
                             END;
   mrudomcomDECL_pConnectionnode
                           = ^mrudomcomDECL_Connectionnode;
   mrudomcomDECL_pSingleSegmList
                           = ^mrudomcomDECL_SingleSegmList;
   mrudomcomDECL_Connectionnode 
                           = RECORD
                                list    : mrudomcomDECL_pSingleSegmList;
                                next,
                                prev    : mrudomcomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   mrudomcomDECL_SingleSegmList
                           = RECORD
                                next    : mrudomcomDECL_pSingleSegmlist;
                                rn      : mrudomcomDECL_pConnectionnode;
                                stree   : mrudomcomDECL_pSnode
                             END;
   mrudomcomDECL_psurfgraph     = ^mrudomcomDECL_surfgraphtype;
   mrudomcomDECL_psurfgraphnode = ^mrudomcomDECL_surfgraphnode;
   mrudomcomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: mrudomcomDECL_psurfgraphnode
   		               END;
   mrudomcomDECL_plossurfgraphnode 
                             = ^mrudomcomDECL_lossurfgraphnode;
   mrudomcomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : mrudomcomDECL_plossurfgraphnode;
   			       END;
   mrudomcomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  mrudomcomDECL_plossurfgraphnode;
   				   arg  :  mrudomcomDECL_psurfgraphnode
   			       END;
   mrudomcomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: mrudomcomDECL_psurfgraphnode;
   			          n    : mrudomcomDECL_nodeid;
   			          cat  : mrudomcomDECL_psyntcat;
   			          nextnodes: mrudomcomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : mrudomcomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

