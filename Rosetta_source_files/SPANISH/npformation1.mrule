\begin{verbatim}
% RULE RNPformation6

< m1: WHPRO{WHPROrec1}[mu1]
>

< m: NP{NPrec1}[head/WHPRO{WHPROrec1}[mu1]] 
>

   MATCHCONDITIONS
      <
         m: NPrec1 = { 
                      NPhead    : otherNP
                      class     : omegaTimeAdvclass
                      tiempo    : omegatiempo
                      aspecto   : omegaaspecto
                      retro     : false 
                     }
      >

      COMP
         <
          C1: true
              C11: WHPROrec1.animate = yesanimate
              A11: NPrec1.human := yeshuman;
              C12: WHPROrec1.animate = noanimate
              A12: NPrec1.human := nohuman;
          A1: (* NPrec1 :=  COPYT_WHPROtoNP(WHPROrec1); *)
              NPrec1.animate := WHPROrec1.animate;
              NPrec1.numero := WHPROrec1.numero ; 
              NPrec1.genero := WHPROrec1.genero ; 
           
              NPrec1.definite  := indef;
              NPrec1.mood      := wh;
              NPrec1.supertiempo := omegatiempo;
              NPrec1.generic := nogeneric;
              NPrec1.NPhead := QuewhproNP;
              NPrec1.specQ := yesspec;
         >

      DECOMP
         <
          C1: 
              NPrec1.animate = WHPROrec1.animate AND
              NPrec1.numero = WHPROrec1.numero AND
              NPrec1.genero = WHPROrec1.genero AND
              
              (NPrec1.definite  = indef) AND
              (NPrec1.mood = wh)
              AND (NPrec1.supertiempo = omegatiempo)
              AND (NPrec1.generic = nogeneric)
              AND (NPrec1.NPhead = QuewhproNP)
              AND (NPrec1.specQ = yesspec)
              C11: WHPROrec1.animate = yesanimate AND
                   NPrec1.human = yeshuman
              A11: @
              C12: WHPROrec1.animate = noanimate AND
                   NPrec1.human = nohuman
              A12: @
          A1:  @
         >
&
\end{verbatim}
