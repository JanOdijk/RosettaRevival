\begin{verbatim}

% RULE RQPCOMPARATIVEcomplmod2   (* In Spanish a construction without ellipsis
                                    is preferred *)

< m1: QP{QPrec1}[head/Q{Qrec1}]
  m2: T1
>


< m : QP{QPrec1}[head/Q{Qrec1},
                     thanascomplrel/THANP{THANPrec1}
                         [head/THANAS(KEY_quethanaskey){THANASrec1},
                          I2:complrel/T2
                         ]
                    ]

>


   MATCHCONDITIONS
      <m1: QPrec1.thanas = quecompl
       m: QPrec1.thanas = quecompl 
       I2: (T2.cat IN [NPVAR, CNVAR] WITH T2.REC.cases = []) OR
           (T2.cat IN [ADVP, PREPP, QP, DETP, ADJP] )
       m2: T1.cat IN  [NPVAR, CNVAR, ADVP, PREPP, QP, DETP, OPENADJPPROP]
      >
<

   SUBRULE (* 1: PREPP *)
      <T1: PREPP{PREPPrec1}[mu1] >
      <t2: PREPP{PREPPrec2}[mu1] >

      COMP
         <
          C1: PREPPrec1.supertiempo= QPrec1.supertiempo
          A1: PREPPrec2 := PREPPrec1;
              PREPPrec2.supertiempo:= omegatiempo;
         >
      DECOMP
         <
          C1: PREPPrec2.supertiempo = omegatiempo 
          A1: PREPPrec1 := PREPPrec2;
              PREPPrec1.supertiempo := QPrec1.supertiempo;
         >

   SUBRULE (* 2: ADVP *)
      <T1: ADVP{ADVPrec1}[mu1] >
      <t2: ADVP{ADVPrec2}[mu1] >

      COMP
         <
          C1: ADVPrec1.supertiempo = QPrec1.supertiempo
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: ADVPrec2.supertiempo = omegatiempo
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.supertiempo := QPrec1.supertiempo;
         >

   SUBRULE (* 3: ADJP  mas que possibile *)

      <T1: OPENADJPPROP{OPENADJPPROPrec3}
                  [subjrel/EMPTY(KEY_zeroemptykey){EMPTYrec1},
                   predrel/ADJP{ADJPrec3}[mu2] 
                  ]
      >

      <T2: ADJP{ADJPrec3}[mu2] >

 


     COMP
         <
          C1: OPENADJPPROPrec3.supertiempo = QPrec1.supertiempo
          A1: @

         >
      DECOMP
         <
          C1: true
          A1: OPENADJPPROPrec3 := COPYT_ADJPtoADJPPROP(ADJPrec3);
              OPENADJPPROPrec3.aktionsarts := [stative];
              OPENADJPPROPrec3.prosubject := true;
              OPENADJPPROPrec3.supertiempo := QPrec1.supertiempo;
         >

   SUBRULE (* 4 NPVAR *)
      <T1: NPVAR{NPVARrec1}>
      <t2: NPVAR{NPVARrec2} >

      COMP
         <
          C1: NPVARrec1.supertiempo = QPrec1.supertiempo AND
              NPVARrec1.definite <> indef
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: NPVARrec2.supertiempo = omegatiempo AND
              NPVARrec2.definite <> indef 
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.supertiempo := QPrec1.supertiempo;
         >

   SUBRULE (* 5 CNVAR *)
      <T1: CNVAR{CNVARrec1} >
      <T2: CNVAR{CNVARrec2} >

      COMP
         <
          C1: CNVARrec1.supertiempo = QPrec1.supertiempo
          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: CNVARrec2.supertiempo = omegatiempo 
          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.supertiempo := QPrec1.supertiempo;
         >

>
&

\end{verbatim}
