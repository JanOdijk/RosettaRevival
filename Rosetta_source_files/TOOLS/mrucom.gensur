                  "LDMRULES_makectrlexpr(result);"\\
                  "result^.kind:=iteration;"\\
                  "result^.ce:=GRAPH;"\\
                  "ELEMGRAPH" """number""" ":=result;"\\
                  "END;"\\
               END
   *>
5: <* SEND: BEGIN \make.\LOCAL.
                  str:=%.str;
                  "VAR result:LDMRULES_pCtrlExpr;"\\
                  "BEGIN"\\
                  "LDMRULES_makectrlexpr(result);"\\
                  "NAME: " ""str""\\
                  "ELEMGRAPH" """number""" ":=result;"\\
                  "END;"\\
            END
      !.
      RECEIVE: BEGIN END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN $$ELEMENTARYGRAPH.make:=make END
END;
