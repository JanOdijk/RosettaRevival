       I1: NOT EXIST(mu1,[head/EN{ENrec1}])
       I2: SENTENCErec1 =
                 { mood        : relative
                   senttype    : subordinateclause
                   finiteness  : finite
                 }
       I3: PREPrec1.contraction = ADEcontraction
      >

      COMP
         <
          C1: true
          A1:  @
         >

      DECOMP
         <
          C1: true
          A1:  @
         >
&

\end{verbatim}
