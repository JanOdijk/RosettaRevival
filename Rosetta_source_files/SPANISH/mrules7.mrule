% RULE RcardTOdetp
< 
    m1:CARD{CARDrec1} [mu1] 
>

< 
   m :DETP{DETPrec1}
          [
           head/CARD{CARDrec1} [mu1]
          ]
>

      COMP
         <
          C1:True
          A1:DETPrec1 :=
                         { 
                           req          : [pospol,negpol,omegapol]
                           env          : [pospol,negpol,omegapol]
                           numero       : CARDrec1.numero
                           genero       : omegagenero
                           definite     : indef
                           posspred     : true
                           posscomas    : [count]
                           mood         : declxpmood
                           syntquant    : omegaquant
                           supertiempo  : omegatiempo 
                         }   

         >
      DECOMP
         <
          C1: DETPrec1 =           
                         { 
                           req          : [pospol,negpol,omegapol]
                           env          : [pospol,negpol,omegapol]
                           numero       : CARDrec1.numero
                           genero       : omegagenero
                           definite     : indef
                           posspred     : true
                           posscomas    NI count
                           mood         : declxpmood
                           syntquant    : omegaquant
                           supertiempo  : omegatiempo 
                         }
          A1: @
         >

&

\end{verbatim}
