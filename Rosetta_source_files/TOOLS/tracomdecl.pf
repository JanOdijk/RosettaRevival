pragma C_include ('strings.pf');
pragma C_include ('tstring.pf');
pragma C_include ('files.pf');
pragma C_include ('tracomlangspec.pf');

PACKAGE tracomDECL;

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
WITH STRINGS,
     tracomLANGSPEC,
     TSTRING,
     FILES;


CONST
   HINIT = -1;
   HDUM  = -1;
   HFINAL= 60;

TYPE
   tracomDECL_Surfrulemode = (loccond, globcond);
   tracomDECL_psyntcat     = ^tracomLANGSPEC_Category;
   tracomDECL_syntcatset   = SET OF tracomLANGSPEC_Category;
   tracomDECL_nodeid         = HINIT..HFINAL;
   tracomDECL_plonodeid      = ^tracomDECL_lonodeid;
   tracomDECL_lonodeid       = RECORD
   			          next: tracomDECL_plonodeid;
   			          arg : tracomDECL_nodeid
   	 	               END;
   tracomDECL_pSnode       = ^tracomDECL_Snode;
   tracomDECL_pRsnode      = ^tracomDECL_Rsnode;
   tracomDECL_Rsnode       = RECORD
                                sonnumber:tracomDECL_nodeid;
                                node    : tracomDECL_pSnode;
                                brother : tracomDECL_pRsnode
                             END;
   tracomDECL_Snode        = RECORD
                                sonlist : tracomDECL_pRsnode;
                                minpos,
                                maxpos  : integer;
                                n       : integer;
                                cl      : integer;
                                connected : boolean;
                                cat     : tracomLANGSPEC_Category;
                                ldfield : tracomLANGSPEC_FieldDef
                             END;
   tracomDECL_pLostree     = ^tracomDECL_Lostree;
   tracomDECL_Lostree      = RECORD
                                next    : tracomDECL_pLostree;
                                arg     : tracomDECL_pSnode
                             END;
   tracomDECL_pConnectionnode
                           = ^tracomDECL_Connectionnode;
   tracomDECL_pSingleSegmList
                           = ^tracomDECL_SingleSegmList;
   tracomDECL_Connectionnode 
                           = RECORD
                                list    : tracomDECL_pSingleSegmList;
                                next,
                                prev    : tracomDECL_pConnectionnode;
                                idnr    : integer
                             END;
   tracomDECL_SingleSegmList
                           = RECORD
                                next    : tracomDECL_pSingleSegmlist;
                                rn      : tracomDECL_pConnectionnode;
                                stree   : tracomDECL_pSnode
                             END;
   tracomDECL_psurfgraph     = ^tracomDECL_surfgraphtype;
   tracomDECL_psurfgraphnode = ^tracomDECL_surfgraphnode;
   tracomDECL_surfgraphtype  = RECORD
   			          first,
   			          last: tracomDECL_psurfgraphnode
   		               END;
   tracomDECL_plossurfgraphnode 
                             = ^tracomDECL_lossurfgraphnode;
   tracomDECL_surfgraphnodelist
                             = RECORD
   				   first,
      				   last  : tracomDECL_plossurfgraphnode;
   			       END;
   tracomDECL_lossurfgraphnode 
                             = RECORD
   				   next :  tracomDECL_plossurfgraphnode;
   				   arg  :  tracomDECL_psurfgraphnode
   			       END;
   tracomDECL_surfgraphnode  = RECORD
      			          left,
   			          right: tracomDECL_psurfgraphnode;
   			          n    : tracomDECL_nodeid;
   			          cat  : tracomDECL_psyntcat;
   			          nextnodes: tracomDECL_surfgraphnodelist;
   			          nextcats,
   			          nexttops : tracomDECL_syntcatset;
   			          completed,
                                  alreadysearched:boolean
   	                       END;

