\newpage
\begin{verbatim}
% RULE RQuMark
< m1: SENTENCE{SENTENCErec1}[mu1] 
>

< m : SENTENCE{SENTENCErec1}[mu1, 
                             I2:sig1 ]
>

   MATCHCONDITIONS
      <
       I2: ALL (sig1, puncrel/PUNC(AUX_quPUNCkey){PUNCrec2})
      >

<
   SUBRULE (* 1. A question mark exists in analysis *)
      < >
      < sig1: [puncrel/PUNC(AUX_quPUNCkey){PUNCrec3}] >

      COMP
         <
          C1:SENTENCErec1.senttype = mainclause AND
             SENTENCErec1.mood IN [yesnointerrogative, whinterrogative]
          A1:@
         >
      DECOMP
         <
          C1:SENTENCErec1.senttype = mainclause AND
             SENTENCErec1.mood IN [yesnointerrogative, whinterrogative]
          A1:@
         >

   SUBRULE (* 2. No question mark in analysis *)
      < >
      < sig1:[] >

       (* no COMP part *)

      DECOMP
         <
          C1:SENTENCErec1.senttype = mainclause AND
             SENTENCErec1.mood IN [yesnointerrogative, whinterrogative]
          A1:@
         >
>

&

\end{verbatim}
