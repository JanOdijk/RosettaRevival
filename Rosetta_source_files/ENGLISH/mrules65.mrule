\begin{verbatim}
% RULE RQTOQP1      (* subgrammar-definition requires this to be a rule, 
                       not a transformation *)

< m1: Q{Qrec1}
>

< m : QP{QPrec1}[head/Q{Qrec1}]
>


      COMP
         <
          C1: true
          A1: QPrec1 := COPYT_qTOqp(Qrec1)
         >
      DECOMP
         <
          C1: QPrec1 = COPYT_qTOqp(Qrec1) AND
              QPrec1.superdeixis = omegadeixis AND
              QPrec1.thanascompl = false

          A1: @
         >

&

\end{verbatim}
