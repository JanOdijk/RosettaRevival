\begin{verbatim}
% RULE RNPmodADVP1  
< m1: NP{NPrec1}[I1:mu1]

  m2: ADVP{ADVPrec1}[mu2]
>

< m : NP{NPrec2}[modrel/ADVP{ADVPrec2}[mu2],
                 head/NP{NPrec1}[I1:mu1]
                ]
>

   MATCHCONDITIONS
      < I1: (NOT EXIST(mu1,[head/INDEFPRO{INDEFPROrec1}])) AND
            (NOT EXIST(mu1,[head/WHPRO{WHPROrec1}[mu3]]))
      
      >

      COMP
         <
          C1: PreXPAdv IN ADVPrec1.actsubcefs
              
          A1: ADVPrec2 := ADVPrec1;
              ADVPrec1.superdeixis := omegadeixis;
              NPrec2 := NPrec1;
              NPrec1.superdeixis := omegadeixis;
              NPrec1.generic := omegageneric;
         >

      DECOMP
         <
          C1: PreXPAdv IN ADVPrec2.actsubcefs AND
              NPrec1 = NPrec2 EXCEPT FOR [superdeixis, generic, cases] AND
              NPrec1.superdeixis = omegadeixis AND
              NPrec1.generic = omegageneric AND
              ADVPrec2.superdeixis = omegadeixis
          A1: ADVPrec1 := ADVPrec2;
              ADVPrec1.superdeixis := NPrec2.superdeixis;
              NPrec1 := NPrec2;

          >
&

\end{verbatim}
