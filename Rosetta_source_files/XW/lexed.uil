object le_edit_menu : XmCascadeButton {
  arguments { 
    arguments cascade_args;
    XmNlabelString = 'Edit'; 
    XmNsensitive   = true;
  };
  controls { 
    XmPulldownMenu {
      controls {
        XmPushButton {
          arguments { 
            arguments cascade_args;
            XmNlabelString = 'Modify lemma'; 
          };
          callbacks {
            MrmNcreateCallback = procedure
                XwuCreateWidget (X_le_modify_lemma_button);
