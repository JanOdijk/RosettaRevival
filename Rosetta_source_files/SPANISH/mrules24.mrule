       m1 : QUOTE_Gsubstordercondition(mu2,mu3,mu4) 
       m  : QUOTE_substordercondition(mu2, mu3, mu4)  
       I1 : rel1 IN [negrel, meltnegrel]
      >



      COMP
         <
          C1: true
          A1: CLAUSErec2 := CLAUSErec1;
         >
