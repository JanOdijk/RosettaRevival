\newpage
\begin{verbatim}

 RULE RTheySubjEMPTYsubst

BEWARE: this rule has been removed from the control expression and the 
        transfer! The percentage-sign is removed here. 
It is assumed that this rule is no longer necessary, since the `generalized' 
`ze' in Dutch is now recognised as a real basic expression, translating into 
the basic expression `they'; in analysis, `they' is always considered to be 
a full non-generic personal pronoun. Should it be possible to formulate 
severe restrictons under which the pronoun can only be generalized, then
there must be two different pronouns (like in Dutch), or some kind of parameter 
must be passed on to IL.

< m1: I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  subjrel/I4::EMPTYVAR{EMPTYVARrec1}, 
                  mu2
                ]
  
  SUBST:
  m2: EMPTY(KEY_theyEMPTYkey){EMPTYrec1}
>

< m : I1::CLAUSE{CLAUSErec1}
                [ mu1,
                  subjrel/NP{NPrec1}
                         [head/PERSPRO{PERSPROrec1}
                              [head/BPERSPRO(KEY_theygenBPRSPRkey)
                                                {BPERSPROrec1}
                              ] 
                         ],
                  mu2
                ]
>

   MATCHCONDITIONS
      <
       I1: CLAUSErec1.finiteness = finite
       I4: EMPTYVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

      COMP
         <
          C1: EMPTYVARrec1 = { person : 3
                               number : plural
                               gender : omegagender }
          A1: PERSPROrec1 := AUX_persproONthey;
              NPrec1 := AUX_NPONtheyPRSPR;
              NPrec1.generic := yesgeneric
         >

(*      DECOMP
         <
          C1: PERSPROrec1 = AUX_persproONthey AND
              NPrec1 = AUX_NPONtheyPRSPR
          A1: EMPTYVARrec1 := { index  : LEVEL
                                person : 3
                                number : plural
                                gender : omegagender }
         >
*)
&

\end{verbatim}
