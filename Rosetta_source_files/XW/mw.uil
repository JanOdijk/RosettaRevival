};

object mw_options_menu : XmCascadeButton {
    arguments { 
        arguments cascade_args;
	XmNlabelString = N_mw_options_menu;
    };
    controls { 
        XmPulldownMenu {
            controls {
                XmPushButton {
                    arguments { 
                        arguments cascade_args;
		        XmNlabelString = N_mw_env_button; 
                        XmNsensitive   = false;
		    };
                    callbacks {
                        MrmNcreateCallback = procedure
                                XwuCreateWidget (X_mw_env_button);
                        XmNactivateCallback = procedure 
	   		        XwuManageWidget (X_env_window);
                    };
                };
                XmPushButton {
                    arguments { 
                        arguments cascade_args;
		        XmNlabelString = N_mw_dbgset_button; 
		    };
                    callbacks {
                        MrmNcreateCallback = procedure
                                XwuCreateWidget (X_mw_dbgset_button);
                        XmNactivateCallback = procedure 
	   		        XwuManageWidget (X_dbgset_window);
                    };
                };
            };
        };
    };
};

object mw_work_window : XmPanedWindow {
    controls {
	XmForm	mw_input_pane;
	XmForm	mw_output_pane;
    };
};

object mw_input_pane : XmForm {
    arguments {
        arguments form_args;
        XmNpaneMinimum = 200;
    };
    controls {
	XmLabel mw_input_label;
	XmRowColumn mw_analysis_button_box;
	XmFrame mw_analysis_frame;
	XmScrolledText mw_input_area;
    };
};

object mw_input_label : XmLabel {
    arguments {
        arguments label_args;
	XmNtopAttachment    = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNlabelString      = N_mw_input_area;
    };
};

object mw_analysis_button_box : XmRowColumn {
    arguments {
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;
        XmNbottomAttachment = XmATTACH_FORM;

	arguments button_box_args;
        XmNorientation      = XmHORIZONTAL;
    };
    controls {
	XmPushButton mw_translate_button;
	XmPushButton mw_anext_button;
        XmPushButton mw_inspect_button;
	XmPushButton mw_continue_button;
    };
};

object mw_analysis_frame : XmFrame {
    arguments {
	XmNtopAttachment    = XmATTACH_WIDGET;
	XmNtopWidget	    = XmLabel mw_input_label;
	XmNrightAttachment  = XmATTACH_FORM;
	XmNmappedWhenManaged = false;
    };
    controls {
	XmRowColumn {
	    arguments {
        	XmNorientation      = XmVERTICAL;
            };
	    controls {
		XmLabel mw_alayout_label;
		XmLabel mw_amorph_label;
		XmLabel mw_sparser_label;
		XmLabel mw_mparser_label;
		XmLabel mw_atrans_label;
	    };
	};
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_analysis_frame);
    };
};

object mw_alayout_label : XmLabel widget {
    arguments {
        arguments label_args;
	XmNlabelString      = N_mw_alayout_text;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_mw_alayout_text);
    };
};

object mw_amorph_label : XmLabel widget {
    arguments {
        arguments label_args;
	XmNlabelString      = N_mw_amorph_text;
    };
    callbacks {
