pragma C_include('liprims.pf'); 
pragma C_include('lidomaint.pf');
pragma C_include('listree.pf');

PACKAGE ITEMS;
WITH LIPRIMS, LIDOMAINT, LISTREE;


TYPE ITEMS_params = ^INTEGER;
     ITEMS_pitem = ^ITEMS_item;
     ITEMS_plositem = ^ITEMS_lositem;
     ITEMS_lositem = record
			next:ITEMS_plositem;
			arg:ITEMS_pitem
                     end;
     ITEMS_setofitems = record
	        		first,last:ITEMS_plositem;
                        end;
     ITEMS_psetofitems = ^ITEMS_setofitems;
     ITEMS_rulerec = record
			rnr:integer;
   			history:LIPRIMS_listofsurfnodelists;
			completed:boolean;
			nextnodes:LIPRIMS_surfgraphnodelist;
			nexttops:LIPRIMS_syntcatset;
			nextcats:LIPRIMS_syntcatset;
                        params:ITEMS_params;
	             end;
     ITEMS_item = record
			cat: LIDOMAINT_syntcat;
			adoptedsons:LISTREE_setofsetofstrees;
			minpos:integer;
			curpos:integer;
			parents:ITEMS_psetofitems;
			followup:boolean;
			ruleinfo:ITEMS_rulerec;
	    end;

END {ITEMS};

