\newpage
\begin{verbatim}
% TRANSFORMATION TObjectok7 (* ergative, complrel/SENTENCE, no  subj-to-subj-
                               raising possible, introduction redello *)
< m1:I1::CLAUSE{CLAUSErec1}
           [ I2:mu1,
             I3:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu9,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      complrel/I4::SENTENCE{SENTENCErec1}[I5:mu6],          
                      mu3
                    ],
             mu4
           ]
>

< m :I1::CLAUSE{CLAUSErec1}
           [ I2:mu1,
             subjrel/NP{NPrec1}
                     [head/PERSPRO{PERSPROrec1}
                           [head/BPERSPRO(KEY_redellobpersprokey){BPERSPROrec1}]
                     ],
             I3:mu8,
             predrel/VERBP{VERBPrec1}
                    [ mu9,
                      head/VERB{VERBrec1}[mu2],
                      cliticrel/CLITIC{}[mu5],
                      mu7,
                      complrel/I4::SENTENCE{SENTENCErec1}[I5:mu6],
                      mu3
                    ],
             mu4
           ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.thetavp IN [vp021,vp010, vp012])
       I2: NOT EXIST (mu1, [subjrel/..]) AND
           ALL(mu1, I21:rel1/..)
       I21: rel1 IN AUX_presubjrels
       I3: NOT EXIST (mu1, [subjrel/..]) AND
           ALL(mu1, I31:rel2/..)
       I31: rel2 IN [vpadvrel]
       I4: SENTENCErec1.finiteness = finite OR
           (SENTENCErec1.finiteness = infinite AND
            SENTENCErec1.prosubject = true)
       I5: NOT EXIST (mu6, [subjrel/..])
 
      >



      COMP
         <
          C1: true
          A1: PERSPROrec1 := COPYT_btoperspro(BPERSPROrec1);
              PERSPROrec1.forma := Nomdebil;
              NPrec1 := AUX_NPONredelloBPRSPR;
         >

      DECOMP
         <
          C1: NPrec1 = AUX_NPonRedelloBPRSPR AND
              PERSPROrec1.forma = Nomdebil AND
              PERSPROrec1 = COPYT_btoperspro(BPERSPROrec1)
          A1: @
         >


&

\end{verbatim}
