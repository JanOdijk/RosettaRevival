   *>
2: <* SEND: BEGIN END
      !GRAPH.
      RECEIVE: BEGIN APPENDlocfile(%%GRAPH.make,make);
                     "BEGIN"\\
                     "ELEMGRAPH" """number""" ":=GRAPH"\\
                     "END;"\\
               END
   *>
3: <* SEND: BEGIN \make.\LOCAL.
            END
      !GRAPH.
      RECEIVE: BEGIN 
                  APPENDlocfile(%%GRAPH.make,make);
                  "VAR result:LDMRULES_pCtrlExpr;"\\
                  "BEGIN"\\
                  "LDMRULES_makectrlexpr(result);"\\
                  "result^.kind:=option;"\\
                  "result^.ce:=GRAPH;"\\
                  "ELEMGRAPH" """number""" ":=result;"\\
                  "END;"\\
               END
   *>
4: <* SEND: BEGIN \make.\LOCAL.
            END
      !GRAPH.
