pragma C_include('liprims.pf');
pragma C_include('items.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)

PACKAGE LDPRIMS;
WITH   LIPRIMS, ITEMS;

FUNCTION LDPRIMS_initialitem(rnr:INTEGER):ITEMS_pitem; EXTERNAL;

PROCEDURE LDPRIMS_assinitialitem(rnr:INTEGER;
                                                valeu:ITEMS_pitem); EXTERNAL;
PROCEDURE LDPRIMS_initindices;EXTERNAL;

FUNCTION LDPRIMS_testindex(rnr:INTEGER):BOOLEAN; EXTERNAL;

PROCEDURE LDPRIMS_addindex(rnr:INTEGER); EXTERNAL;

FUNCTION LDPRIMS_parentlist(i:INTEGER):ITEMS_pSetOfItems; EXTERNAL;

PROCEDURE LDPRIMS_assparentlist(i:INTEGER;
                                               valeu:ITEMS_pSetOfItems); EXTERNAL;

FUNCTION LDPRIMS_params(i:INTEGER):ITEMS_params; EXTERNAL;

PROCEDURE LDPRIMS_assparams(i:INTEGER;
                                               valeu:ITEMS_params); EXTERNAL;

FUNCTION LDPRIMS_surfgraph(i:integer):LIPRIMS_psurfgraph; EXTERNAL;

PROCEDURE LDPRIMS_assignsurfgraph(i:integer; 
                                            valeu: LIPRIMS_psurfgraph); EXTERNAL;

FUNCTION LDPRIMS_rnrset(i:integer):BOOLEAN; EXTERNAL;

PROCEDURE LDPRIMS_assignrnrset(i:integer; 
                                            valeu: BOOLEAN); EXTERNAL;
END {LDPRIMS};
