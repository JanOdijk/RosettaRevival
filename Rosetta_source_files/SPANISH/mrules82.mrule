\end{enumerate}
\end{description}

\newpage
\begin{verbatim}
% RULE Rpppsuperdeixis
< m1:PREPPFORMULA{PREPPFORMULArec1}[mu1] 
>

< m :PREPPFORMULA{PREPPFORMULArec2}[mu1] 
>

   PARAMETERS
      <
       super : tiempotype
      >

      COMP
         <
          C1: PREPPFORMULArec1.supertiempo = omegatiempo AND
              super IN [presente, pasado]
          A1: PREPPFORMULArec2 := PREPPFORMULArec1;
              PREPPFORMULArec2.supertiempo := super;
         >
      DECOMP
         <
          C1: PREPPFORMULArec2.supertiempo IN [presente, pasado]
          A1: PREPPFORMULArec1 := PREPPFORMULArec2;
              PREPPFORMULArec1.supertiempo := omegatiempo;
              super := PREPPFORMULArec2.supertiempo;
         >

&

\end{verbatim}
