
ENGLISH 67
&
\begin{verbatim}
%
% TRANSFORMATION TNPadjadvpcomplextrapos1
< m1: NP{NPrec1}[mu1,
                 head/CN{CNrec1}
                      [mu2,
                       modrel/ADJP{ADJPrec1}
                              [mu4,
                               degreemodrel/I2::N1
                                    [mu3
                                    ],
                               mu5,
                               I1:extraposrel/T1
                               ],
                        mu6
                       ]
                 ]
>
< m : NP{NPrec1}[mu1,
                 head/CN{CNrec1}
                      [mu2,
                       modrel/ADJP{ADJPrec1}
                              [mu4,
                               degreemodrel/I2::N1
                                    [mu3
                                    ],
                               mu5
                               ],
                       mu6
                       ],
                 I1:extraposrel/T1
                 ]
>

   MATCHCONDITIONS
      <
       I1: T1.CAT IN [PREPP, THANP]
       I2: N1.CAT IN [ADVP] 
                  WITH N1.REC.thanas IN [ascompl]
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >


&

\end{verbatim}
