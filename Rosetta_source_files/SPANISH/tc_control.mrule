\begin{verbatim}
% TRANSFORMATION TNoControl2 
                             (* CLOSEDADJPPROP in  prepobj *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      prepobjrel/PREPP{PREPPrec1}
                            [ mu3,
                              objrel/CLOSEDADJPPROP{CLOSEDADJPPROPrec1}
                                    [ subjrel/T1,
                                      predrel/ADJP{ADJPrec1}[mu4]
                                    ],
                              mu5
                            ],
                      mu6 
                    ],
             mu7 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ I1:mu2,
                      objrel/T1,
                      prepobjrel/PREPP{PREPPrec2}
                            [ mu3,
                              predrel/ADJP{ADJPrec1}[mu4],
                              mu5
                            ],
                      mu6 
                    ],
             mu7 
           ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu2, [objrel/..])
      >

<
   SUBRULE
      <T1:NP{NPrec1}[mu8] >
      <T1:NP{NPrec1}[mu8] >


      COMP
         <
          C1: ( CLOSEDADJPPROPrec1 =
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
              )
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: true
          A1: CLAUSErec1 := CLAUSErec2;
              CLOSEDADJPPROPrec1 :=
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
         >


   SUBRULE
      <T1: T2 >
      <T1: T2 >

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [ NPVAR, CNVAR]
      >

      COMP
         <
          C1: ( CLOSEDADJPPROPrec1 =
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   }
              )
          A1: PREPPrec2 := PREPPrec1
         >

      DECOMP
         <
          C1: true
          A1: CLOSEDADJPPROPrec1 :=
		   {
		    class         : ADJPrec1.class
		    tiempo        : ADJPrec1.tiempo
		    aspecto       : ADJPrec1.aspecto
		    retro         : ADJPrec1.retro
		    aktionsarts   : [stative ]
		    supertiempo   : omegatiempo
		    actsubcefs    : ADJPrec1.actsubcefs
		    thetaadj      : ADJPrec1.thetaadj
		    adjpatternefs : ADJPrec1.adjpatternefs
		    PROsubject    : false
		   };
              PREPPrec1 := PREPPrec2
         >
>
&

\end{verbatim}
