%ELEMENTARYCOND
BASIS RULE
    ELEMENTARYCOND = (ROUNDOPEN/1.ANDCOND/2.ROUNDCLOSE/1|
                      PASCALEXPR/3)
SURFACE PART
VAR simple::bool;

<*
INIT: BEGIN
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN simple:=%ANDCOND.simple
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN simple:=%PASCALEXPR.simple
                        END
    *>
FINAL: #CONDITION:TRUE
       #ACTION: BEGIN SEND_ELEMENTARYCOND;
                      $ELEMENTARYCOND.simple:=simple;
                END
*>
END;
PROCEDURAL PART
VAR copy,intequals:LOCALFILE;
    rulenumber::int;
    simple::simple;
BEGIN
INIT: BEGIN rulenumber:=%%ELEMENTARYCOND.rulenumber
