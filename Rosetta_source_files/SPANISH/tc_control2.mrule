                    ],
             mu6 
           ]
>

< m :CLAUSE{CLAUSErec2}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/T1,
                      mu3,
                      I1:rel1/VARPREPP{VARPREPPrec1}[mu4],
                      mu5
                    ],
             mu6 
           ]
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [locargrel, dirargrel]
      >

<
   SUBRULE
      <
       T1:NPVAR{NPVARrec1} 
       T2:NPVAR{NPVARrec2}
      >
      <T1:NPVAR{NPVARrec1}  
      >

      COMP
         <
          C1:
              (NPVARrec1 = NPVARrec2) AND
              (
               OPENPREPPPROPrec1 =
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : true
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
              )
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDONP_DIROPENPREPPPROP,
                                      synDONP_LOCOPENPREPPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
                                      [synDONP_DIROPENPREPPPROP,
                                       synDONP_LOCOPENPREPPPROP];
              NPVARrec2 := NPVARrec1;
              OPENPREPPPROPrec1:=
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : true
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
         >


   SUBRULE
      <
       T1:CNVAR{CNVARrec1} 
       T2:CNVAR{CNVARrec2}
      >
      <T1:CNVAR{CNVARrec1}  
      >

      COMP
         <
          C1:
              (CNVARrec1 = CNVARrec2) AND
              (
               OPENPREPPPROPrec1 =
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : true
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
              )
          A1: CLAUSErec2 := CLAUSErec1
         >

      DECOMP
         <
          C1: (CLAUSErec1.synvpefs * [synDONP_DIROPENPREPPPROP,
                                      synDONP_LOCOPENPREPPPROP] <> [])
          A1: CLAUSErec1 := CLAUSErec2;
              CLAUSErec1.synvpefs := CLAUSErec2.synvpefs * 
                                      [synDONP_DIROPENPREPPPROP,
                                       synDONP_LOCOPENPREPPPROP];
              CNVARrec2 := CNVARrec1;
              OPENPREPPPROPrec1:=
		   {
		    mood        : declxpmood
		    actsubcefs  : VARPREPPrec1.actsubcefs
		    PROsubject  : true
		    synppefs    : VARPREPPrec1.synppefs
                    thetapp     : VARPREPPrec1.thetapp
		    headkey     : VARPREPPrec1.headkey
		    class       : VARPREPPrec1.class
		    tiempo      : VARPREPPrec1.tiempo
		    aspecto     : VARPREPPrec1.aspecto
		    retro       : VARPREPPrec1.retro
		    aktionsarts : [stative] 
		    supertiempo : omegatiempo
		   }
         >
>
&

\end{verbatim}
