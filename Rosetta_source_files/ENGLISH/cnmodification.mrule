% RULE RCNmodRELSENT1       
< SUBST:
  m1: CN{CNrec1}[I1:mu1]                 (* substituent *)
  m2: I2::SENTENCE{SENTENCErec1}
              [ shiftrel/T1,
                conjrel/CONJ(KEY_thatconjkey){CONJrec1},
                mu2 
              ] 
>

< m : CN{CNrec1}[ I1:mu1, 
                  postmodrel/I4::SENTENCE{SENTENCErec2}
                            [ shiftrel/T2,
                              mu2 
                            ],
                  I3:sig1 
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1,[head/EN{ENrec1}])
       I2: SENTENCErec1 =
                 { mood        : relative
                   senttype    : subordinateclause
                   finiteness  : finite
                   conjkey     : KEY_thatconjkey
                 }
       I3: ALL(sig1, puncrel/PUNC(KEY_commapunckey){PUNCrec2})
       I4: SENTENCErec2 =
                 { mood        : relative
                   senttype    : subordinateclause
                   finiteness  : finite
                 }
      >

   PARAMETERS
      <
       LEVEL
      >

(* 
\end{verbatim}
\newpage
\begin{verbatim}
*)

<
   SUBRULE  (* 1a. thatrelpro, comma *)
      < T1: CNVAR{CNVARrec1} >
      < sig1: [puncrel/PUNC(KEY_commapunckey){PUNCrec1}]
        T2: RELPRO(KEY_thatrelprokey){RELPROrec1}
      >

      (* no COMP part *)

      DECOMP
         <
          C1: true
              C11: (* temporally independent *)
                   (SENTENCErec2.superdeixis = omegadeixis) AND
                   (((SENTENCErec2.deixis = presentdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> presentdeixis)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.deixis = pastdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> pastdeixis) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;

               C12: (* temporally dependent *)
                    SENTENCErec2. superdeixis = omegadeixis AND
                    SENTENCErec2.deixis = CNrec1.superdeixis 
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.deixis := omegadeixis;
                    SENTENCErec1.superdeixis := CNrec1.superdeixis
                    
          A1: CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [Nominative, Accusative];
              SENTENCErec1.conjkey := KEY_thatCONJkey;

         >

   SUBRULE  (* 1b. thatrelpro, no comma *)
      < T1  : CNVAR{CNVARrec1} >
      < sig1: []
        T2  : RELPRO(KEY_thatrelprokey){RELPROrec1}
      >

      (* no COMP part *)

      DECOMP
         <
          C1: true
              C11: (* temporally independent *)
                   (SENTENCErec2.superdeixis = omegadeixis) AND
                   (((SENTENCErec2.deixis = presentdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> presentdeixis)
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    ) OR
                    ((SENTENCErec2.deixis = pastdeixis) AND
                     (((QUOTE_temprefnotfound(mu2)) AND
                       (CNrec1.superdeixis <> pastdeixis) 
                      ) OR
                      (NOT QUOTE_temprefnotfound(mu2))
                      )
                     )
                    )
                   )
               A11: SENTENCErec1 := SENTENCErec2;

               C12: (* temporally dependent *)
                    SENTENCErec2. superdeixis = omegadeixis AND
                    SENTENCErec2.deixis = CNrec1.superdeixis 
               A12: SENTENCerec1 := SENTENCErec2;
                    SENTENCErec1.deixis := omegadeixis;
                    SENTENCErec1.superdeixis := CNrec1.superdeixis

          A1: CNVARrec1 := COPYT_CNTOVAR(CNrec1);
              CNVARrec1.index := LEVEL;
              CNVARrec1.cases := [Nominative, Accusative];
              SENTENCErec1.conjkey := KEY_thatCONJkey;
         >

(* 
