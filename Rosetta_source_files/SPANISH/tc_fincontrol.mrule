% TRANSFORMATION tobjTOobjcontrol
< m1:CLAUSE{CLAUSErec1}[ mu1,
                         predrel/VERBP{VERBPrec1}
                                [ mu11,
                                  head/I11::VERB{VERBrec1}[mu13],
                                  mu16,
                                  objrel/NPVAR{NPVARrec1}[mu15],
                                  mu12 
                                ], 
                         mu2,
                         I1:rel1/I5::SENTENCE{SENTENCErec1}
                              [ I3:mu3,
                                predrel/VERBP{VERBPrec2}
                                        [ mu10,
                                          objrel/T1, 
                                          mu9,
                                          complrel/ADJP{ADJPrec1}[mu8]
                                        ]
                               ], 
                        I4:mu4 
                        ]
 >

< m:CLAUSE{CLAUSErec1}[ mu1,
                        predrel/VERBP{VERBPrec1}
                                [ mu11,
                                  head/I11::VERB{VERBrec1}[mu13],
                                  mu16, 
                                  objrel/NPVAR{NPVARrec1}[mu15],
                                  mu12 
                                ], 
                         mu2,
                         I1:rel1/I5::SENTENCE{SENTENCErec1}
                              [ I3:mu3,
                                predrel/VERBP{VERBPrec2}
                                     [ mu10,
                                       gluerel/GLUE{},
                                       objrel/T3
                                     ],
                                mu9,
                                complrel/ADJP{ADJPrec1}[mu8]
                            ], 
                          I4:mu4 
                       ]
 
>

   MATCHCONDITIONS
      <
       I1: rel1 IN [postsentadvrel (* tempadvrel *)]
       I3: EXIST(mu3,[I31:rel3/..])
           I31: rel3 IN [modrel (* conjrel *)]
       I4: ALL(mu4,postsentadvrel/..) 
       I5: SENTENCErec1.adverbial = true AND
           SENTENCErec1.finiteness = infinite
       I11: VERBrec1.reflexivity = notreflexive 
           (* a rule for reflexive verbs must also be added; the reflexive SE
              must also appear on the lower sentence :
              se frota los dientes hasta dejarselos limpios *)
      >

<
   SUBRULE                            (* dejarLO *)
      < T1:NPVAR{NPVARrec1}[mu15]
      > 

      < T3:NP{NPrec1}
        [ head/PERSPRO{PERSPROrec1}
                  [ head/BPERSPRO(KEY_ellobpersprokey){BPERSPROrec1}] 
            ]
      > 
      
      
      COMP
         <
          C1:NPVARrec1.genero IN [masc, neutro] AND
             NPVARrec1.numero = singular AND
             NPVARrec1.animate = noanimate AND 
             ( NPVARrec1.NPhead = otherNP OR
               NPVARrec1.NPhead = persproNP AND NPVARrec1.persona = 3 ) 
          A1:PERSPROrec1:= COPYT_BtoPERSPRO(BPERSPROrec1);
             PERSPROrec1.forma := AcusCL;
             NPrec1:= COPYT_PERSPROtoNP(PERSPROrec1)

          >        
 
    
    SUBRULE                            (* dejarLO yesanimate *)  
        < T1:NPVAR{NPVARrec1}[mu15]
        > 

        < T3:NP{NPrec1}
               [ head/PERSPRO{PERSPROrec1}
                      [ head/BPERSPRO(KEY_elbpersprokey){BPERSPROrec1}] 
               ]
        > 
      
      
      COMP
         <
          C1:NPVARrec1.genero = masc AND
             NPVARrec1.numero = singular AND
             NPVARrec1.animate = yesanimate AND
             ( NPVARrec1.NPhead = otherNP OR
               NPVARrec1.NPhead = persproNP AND NPVARrec1.persona = 3 ) 
          A1:PERSPROrec1:= COPYT_BtoPERSPRO(BPERSPROrec1);
             PERSPROrec1.forma := AcusCL;
             NPrec1:= COPYT_PERSPROtoNP(PERSPROrec1)

          >        


