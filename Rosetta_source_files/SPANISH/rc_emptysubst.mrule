\begin{verbatim}
% RULE REmptysubstitution5

        (* subst of ellosEMPTY as a subjrel/.. *)

< m1: I1::CLAUSE{CLAUSErec1}
                [mu6,
                 I4:subjrel/EMPTYVAR{EMPTYVARrec1},
                 mu7,
                 predrel/VERBP{VERBPrec1}
                         [ mu2,
                           head/I3::VERB{VERBrec1}[mu3],
                           mu4
                         ],
                  mu5
                ]
SUBST:
  m2: EMPTY(KEY_ellosemptykey){EMPTYrec1}            (*substituent*)

>

< m: I2::CLAUSE{CLAUSErec2}
       [ mu6,
         subjrel/NP{NPrec1}
          [head/PERSPRO{PERSPROrec1}
            [head/BPERSPRO(KEY_redellosbpersprokey){BPERSPROrec1}]
          ],
         mu7,
         predrel/VERBP{VERBPrec1}
                   [ mu2,
                     head/I3::VERB{VERBrec1}[mu3],
                     mu4
                   ],
             mu5
       ]
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice = Active)
       I2: (CLAUSErec2.voice = Active)
       I3: (Active IN VERBrec1.possvoices ) AND
           (VERBrec1.thetavp IN [vp100, vp120, vp123] )
       I4: EMPTYVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >


      COMP
         <
          C1: true
          A1: PERSPROrec1:= COPYT_BtoPERSPRO(BPERSPROrec1);
              NPrec1.NPhead := redellosNP;
              NPrec1.persona := 3;
              NPrec1.numero := plural;
              NPrec1.genero := masc;
              NPrec1.generic := yesgeneric;
              NPrec1.animate := yesanimate;
              NPrec1.definite := indef;

              (* the other values are default *)

              CLAUSErec2 := CLAUSErec1
         >

(*      DECOMP
         <
          C1: (NPrec1 = NPrecdef EXCEPT FOR [NPhead, persona, numero]) AND
              (NPrec1.NPhead = redellosNP) AND
              (NPrec1.persona = 3) AND
              (NPrec1.numero = plural)

          A1: CLAUSErec1 := CLAUSErec2
         >
*)
&

\end{verbatim}
