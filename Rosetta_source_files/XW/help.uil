/* help: help output window */

object help_window : XmFormDialog {
    arguments {
        arguments form_args;
	XmNdialogTitle	    = N_help_window;
	XmNdialogStyle      = XmDIALOG_MODELESS;
        XmNdefaultPosition  = false;
    };
    controls {
	XmRowColumn       help_button_box;
        XmScrolledText    help_area;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_help_window);
    };
};

object help_button_box : XmRowColumn {
    arguments {
	XmNbottomAttachment = XmATTACH_FORM;
	XmNleftAttachment   = XmATTACH_FORM;
	XmNrightAttachment  = XmATTACH_FORM;

        arguments button_box_args;
	XmNorientation      = XmHORIZONTAL;
    };
    controls {
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_help_ok_button;
	    };
	    callbacks {
		XmNactivateCallback = procedure 
		    XwhAction (X_help_ok_button);
	    };
	};
        XmPushButton {
	    arguments {
                arguments button_args;
	        XmNlabelString	= N_help_help_button;
	    };
            callbacks {
                MrmNcreateCallback = procedure XwuCreateWidget (X_help_help_button);
		XmNactivateCallback = procedure XwhAction (X_help_help_button);
   	    };
	};
    };
};

object help_area : XmScrolledText {
    arguments {
	XmNtopAttachment	= XmATTACH_FORM;
	XmNleftAttachment       = XmATTACH_FORM;
	XmNrightAttachment	= XmATTACH_FORM;
	XmNbottomAttachment	= XmATTACH_WIDGET;
	XmNbottomWidget		= XmRowColumn help_button_box;

        arguments text_args;
        XmNeditable		= false;
	XmNeditMode		= XmMULTI_LINE_EDIT;
	XmNcolumns		= 80;
	XmNrows			= 10;
        XmNscrollHorizontal     = false;
        XmNwordWrap             = true;
    };
    callbacks {
        MrmNcreateCallback = procedure XwuCreateWidget (X_help_area);
    };
};

