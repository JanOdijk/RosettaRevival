\begin{verbatim}
% RULE Rposvarintro1
< m1:CLAUSE{CLAUSErec1}
           [ I1:mu1,
             subjrel/T1,
             I2:mu2 
           ] 
>

< m :CLAUSE{CLAUSErec1}
           [ I1:mu1,
             subjrel/T1,
             posrel/POSVAR{POSVARrec1},
             I2:mu2 
           ] 

>

   MATCHCONDITIONS
      <
       I1: NOT EXIST(mu1, [meltnegrel/..])
       I2: NOT EXIST(mu2, [I21:rel1/..])
           I21: rel1 IN [posrel, negrel]
      >


      COMP
         <
          C1: CLAUSErec1.finiteness = finite
          A1: @
         >
      DECOMP
         <
          C1: CLAUSErec1.finiteness = finite
          A1: @
         >


&

\end{verbatim}
