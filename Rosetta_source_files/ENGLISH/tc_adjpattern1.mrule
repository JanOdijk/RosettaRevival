(* uitgezet (nooit aan geweest) *)
 TRANSFORMATION TADJPATTERN17   (*  unchanged copy from 
                                    Dutch M-grammar  *)
                                 (*  sentential prepositional object
                                    with pro-object,
                                    without overt preposition (VOOR):
                                    bedoeld/geschikt/MEANT 
                                 *)   

< m1: ADJPPROP{ADJPPROPrec1}
                      [mu1,
                       predrel/ADJP{ADJPrec1}
                              [argrel/SENTENCEVAR{SENTENCEVARrec1},
