\newpage
\begin{verbatim}
%

%RULE RIDCN1

<m1: NOUN{NOUNREC1}[head/SUBNOUN{SUBNOUNREC1}[head/BNOUN(KEY1){BNOUNREC1}]]
>

< m:  CNFORMATION/RCNMODPP{LEVEL:X1
                           SUBST:1}
        [CNFORMATION/RCNFORMATION1
           [BLEX/NOUN{NOUNREC1}[head/SUBNOUN{SUBNOUNREC1}
                                  [head/BNOUN(KEY2){BNOUNREC1}]
                               ]
           ],
         PREPPFORMATION/ROPENPPPMOOD
           [PREPPFORMATION/TPPPPROSUBJ
              [PREPPFORMATION/RPPPNPSUBST{LEVEL:X2
                                          SUBST:2}
                 [PREPPPROPFORMATION/RPREPTOFORMULA
                    [PREPPPROPFORMATION/TPPPPATTERN1
                       [PREPPPROPFORMATION/RSTARTPPPROP120
                          [PREPDERIVATION/RPREPTOSUB
                             [BLEX/PREP(KEY3)],
                           BLEX/CNVAR(X1){CNVARREC1},
                           BLEX/NPVAR(X2){NPVARREC1}
                          ]
                       ]
                    ],
                  NPFORMATION/RIDNPFORMATION2
                    [CNFORMATION/RCNFORMATION1
                       [CNFORMATION/RSUBNOUNTONOUN1
                          [NPDERIVATION/BNOUNTOSUBNOUN
                             [BLEX/BNOUN(KEY4)]
                          ]
                       ]
                    ]
                 ]
              ]
           ]
        ]
>

COMP
 <
   C1: COMPINIDDICT(KEY1, VPID150)
   A1: <KEY2, KEY3, KEY4> := COMPGETIDDICT (KEY1, VPID150);
 >
DECOMP
 <
   C1: DECOMPINIDDICT(<KEY2, KEY3, KEY4>, VPID150)
   A1: KEY1 := DECOMPGETIDDICT(<KEY2, KEY3, KEY4>, VPID150);
 >

&
\end{verbatim}

