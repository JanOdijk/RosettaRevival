ENGLISH 15

&
\begin{verbatim}


RC_Substitution2

 1. RIdSubstitution1 (NP in objNP in VP)
 2. RIdSubstitution2 (NP in subjNP in S)
 3. RIdSubstitution3 (NP in objNP in (locopen)PREPP in VP)
 4. RxppObjNPsubst (objrel, indobjrel/NP in predrel/XP in VERBP)
 5. RxppVarPrepNPsubst (NP in VARPREPP in predrel/XP in VERBP)
 6. Rdeepsubst1 (NP at indefinite depths, generation only)
 7. RdeepsubstPP (PREPP at indefinite depths, generation only)
 8. RdeepsubstVARPP (VARPREPP at indefinite depths, generation only)
 9. RdeepsubstADVP (ADVP at indefinite depths, generation only)
10. RvpadvPPsubst (PREPP for vpadvrel/PREPPVAR)
11. Rbigprosubst (BIGPRO-NP for subjrel)
12. Tsubstspeed (to speed up substitution in analysis)
\end{verbatim}
\newpage
\begin{verbatim}
%
% RULE RIdSubstitution1                  (* NP in objNP in VP *)
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/NP{NPrec3}
                         [ detrel/I1::NPVAR{NPVARrec1},
                           head/CN{CNrec1}[mu7]
                         ],
                      mu3
                    ],
             mu4 
           ] 
SUBST:
  m2: T1
>

< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      objrel/NP{NPrec3}
                        [ detrel/T2,
                          head/CN{CNrec1}[mu7]
                        ],
                      mu3
                    ],
             mu4 
           ] 
>

   MATCHCONDITIONS
      <
       m2: QUOTE_Gsubstordercondition2(mu3, mu4, T1, CLAUSErec1.prosubject) 
       m : QUOTE_substordercondition2(mu3, mu4, CLAUSErec1.prosubject) 
       I1: NPVARrec1.index = LEVEL
      >

   PARAMETERS
      <
       LEVEL
      >

<
   SUBRULE (* 1 *) (* Johns *)
      < T1: I3::NP{NPrec1}
                     [ head/PROPERNOUN{PROPERNOUNrec1}[mu8]
                     ]
      >

      < T2: I4::NP{NPrec2}
                     [ head/PROPERNOUN{PROPERNOUNrec1}[mu8],
                       gluerel/GLUE{GLUErec1},
                       modrel/GEN(KEY_genGENkey){GENrec1}
                     ]
      >

   MATCHCONDITIONS
      <
       T1: QUOTE_Checkgen(T1)
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I4: NOT ( NPrec2.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_NPtoVAR(NPrec1) 
                                   EXCEPT FOR [cases] AND
              NPrec1.cases = [] AND
              NPrec1.generic = nogeneric
            C11: CLAUSErec1.deixis = omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.superdeixis
            A11: NPrec2 := NPrec1;
                 NPrec2.cases := NPVARREC1.cases;
            C12: CLAUSErec1.deixis <> omegadeixis AND
                 NPrec1.superdeixis = CLAUSErec1.deixis
            A12: NPrec2 := NPrec1;
                 NPrec2.cases := NPVARREC1.cases;
          A1: NPrec2.superdeixis := omegadeixis;
              NPrec2.generic := omegageneric
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric AND
              NPrec2.superdeixis = omegadeixis
            C11: CLAUSErec1.deixis = omegadeixis
            A11: NPrec1 := NPrec2;
                 NPrec1.cases := [];
                 NPrec1.superdeixis := CLAUSErec1.superdeixis
            C12: CLAUSErec1.deixis <> omegadeixis
            A12: NPrec1 := NPrec2;
                 NPrec1.cases := [];
                 NPrec1.superdeixis := CLAUSErec1.deixis
          A1: NPVARrec1 := COPYT_NPtoVAR(NPrec2);
              (* including cases *)
              NPVARrec1 := { index   : LEVEL
                             generic : nogeneric };
              NPrec1.generic := nogeneric
         >

   SUBRULE (* 2 *) (* my *)
      <T1: I3::NP{NPrec1}[head/PERSPRO{PERSPROrec1}
                               [head/BPERSPRO{BPERSPROREC1}]
                         ] >
      <T2: POSSADJ{POSSADJrec1}[head/BPERSPRO{BPERSPROREC1}] >

   MATCHCONDITIONS
      <
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I4: NOT ( NPrec2.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
      >

      COMP
         <
          C1: PERSPROrec1 = COPYT_bpersprotoperspro(BPERSPROrec1)  AND
              NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
	      NPrec1 = 
		  {
		   req            : [pospol,negpol,omegapol]
		   env            : [pospol,negpol,omegapol]
		   class          : omegaTimeAdvClass
		   deixis         : omegadeixis
		   aspect         : omegaAspect
		   retro          : false
		   definite       : def
		   person         : BPERSPROrec1.person
		   number         : BPERSProrec1.number
		   cases          : []
		   genders        : [BPERSPROrec1.gender]
		   sexes          : []
		   actsubcs       : [othernoun]
		   temporal       : false
		   poss           : false
                   animate        : BPERSPROrec1.animate
		   actcomas       : [count]
		   thetanp        : omegathetanp
		   nounpatternefs : []
		   posspred       : true
		   possnietnp     : false
		   mood           : nowh
		   generic        : nogeneric
		   syntquant      : omegaquant
                   NPhead         : BPERSPROrec1.NPhead
		   specQ          : yesspec
                  }
              C11: CLAUSErec1.deixis = omegadeixis              AND
                   NPrec1.superdeixis = CLAUSErec1.superdeixis
              A11: @
              C12: CLAUSErec1.deixis <> omegadeixis             AND
                   NPrec1.superdeixis = CLAUSErec1.deixis
              A12: @
          A1: @
         >
               (* Possadjrec happens to be default *)
      DECOMP
         <
          C1: TRUE
              C11: CLAUSErec1.deixis = omegadeixis
              A11: NPrec1.superdeixis := CLAUSErec1.superdeixis;
              C12: CLAUSErec1.deixis <> omegadeixis
              A12: NPrec1.superdeixis := CLAUSErec1.deixis;
          A1: PERSPROrec1 := COPYT_bpersprotoperspro(BPERSPROrec1);
              NPVARrec1 := 
		  {
                   index          : LEVEL
		   req            : [pospol,negpol,omegapol]
		   env            : [pospol,negpol,omegapol]
		   class          : omegaTimeAdvClass
		   deixis         : omegadeixis
		   aspect         : omegaAspect
		   retro          : false
		   definite       : def
		   person         : BPERSPROrec1.person
		   number         : BPERSProrec1.number
		   cases          : []
		   genders        : [BPERSPROrec1.gender]
		   sexes          : []
		   actsubcs       : [othernoun]
		   temporal       : false
		   poss           : false
		   actcomas       : [count]
		   thetanp        : omegathetanp
		   nounpatternefs : []
		   posspred       : true
		   possnietnp     : false
		   mood           : nowh
		   generic        : nogeneric
		   syntquant      : omegaquant
		   specQ          : yesspec
                  }                                      ;
	      NPrec1 := 
		  {
		   req            : [pospol,negpol,omegapol]
		   env            : [pospol,negpol,omegapol]
		   class          : omegaTimeAdvClass
		   deixis         : omegadeixis
		   aspect         : omegaAspect
		   retro          : false
		   definite       : def
		   person         : BPERSPROrec1.person
		   number         : BPERSProrec1.number
		   cases          : [Nominative]
		   genders        : [BPERSPROrec1.gender]
		   sexes          : []
		   actsubcs       : [othernoun]
		   temporal       : false
		   poss           : false
                   animate        : BPERSPROrec1.animate
		   actcomas       : [count]
		   thetanp        : omegathetanp
		   nounpatternefs : []
		   posspred       : true
		   possnietnp     : false
		   mood           : nowh
		   generic        : nogeneric
		   syntquant      : omegaquant
                   NPhead         : BPERSPROrec1.NPhead
		   specQ          : yesspec
                  }                                      
         >

   SUBRULE (* 3 *) (* my fathers *)
      <T1: NP{NPrec1}[mu11, 
                      head/CN{CNREC2}[mu5, 
                                      head/NOUN{NOUNREC1}[mu8]
                                     ]
                     ]
      >

      <T2: NP{NPrec2}[mu11,
                      head/CN{CNREC2}[mu5,
                                      head/NOUN{NOUNREC2}[mu8]
                                     ],
                      gluerel/GLUE{GLUErec1},
                      modrel/GEN(KEY_genGENkey){GENrec1}
                     ]
      >

   MATCHCONDITIONS
      <
       T1: QUOTE_Checkgen(T1)
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
       I4: NOT ( NPrec2.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
      >

      COMP
         <
          C1: NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = []                                    AND
              NPrec1.generic = nogeneric                           AND
              CNrec1.poss = true
              C11: CLAUSErec1.deixis = omegadeixis              AND
                   NPrec1.superdeixis = CLAUSErec1.superdeixis
              A11: NPrec2 := NPrec1;
                   NPrec2.cases := NPVARrec1.cases;
                   NPrec2.superdeixis := omegadeixis
              C12: CLAUSErec1.deixis <> omegadeixis             AND
                   NPrec1.superdeixis = CLAUSErec1.deixis
              A12: NPrec2 := NPrec1;
                   NPrec2.cases := NPVARrec1.cases;
                   NPrec2.superdeixis := omegadeixis  
          A1: NPrec2.generic := omegageneric;
              NOUNrec2 := NOUNrec1;
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric           AND
              CNrec2.poss = true
              C11: CLAUSErec1.deixis = omegadeixis AND
                   NPrec2.superdeixis = omegadeixis
              A11: NPrec1 := NPrec2;
                   NPrec1.cases := [];
                   NPrec1.superdeixis := CLAUSErec1.superdeixis;
              C12: CLAUSErec1.deixis <> omegadeixis AND
                   NPrec2.superdeixis = omegadeixis  
              A12: NPrec1 := NPrec2;
                   NPrec1.cases := [];
                   NPrec1.superdeixis := CLAUSErec1.deixis;
          A1: NOUNrec1 := NOUNrec2;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.cases := NPrec2.cases;
              NPVARrec1.index := LEVEL;
              NPrec1.generic := nogeneric;
              NPVARrec1.generic := nogeneric;
         >

   SUBRULE (* 4 *) (* whose *)
      <T1: I3::NP{NPrec1}[head/WHPRO{WHPROrec1}
                               [head/BWHPRO{BWHPROREC1}]
                         ] >
      <T2: POSSADJ{POSSADJrec1}[head/BWHPRO{BWHPROREC1}] >

   MATCHCONDITIONS
      <
       I3: NOT ( NPrec1.NPhead IN [reflNP, reciproNP,
                                   sentNP, openingNP] )
      >

      COMP
         <
          C1: WHPROrec1 = COPYT_bwhprotowhpro(BWHPROrec1)          AND
              NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPVARrec1.cases = []                                 AND
              NPVARrec1.generic = nogeneric                        AND
              NPVARrec1.index = LEVEL                              AND
              NPrec1.generic = nogeneric                           AND
              NPrec1.definite = NPrec3.definite                    AND
              NPrec1.mood = NPrec3.mood                            AND
              NPrec1.animate = WHPROrec1.animate                   AND
              NPrec1.sexes = WHPROrec1.sexes                       AND
              NPrec1.number = WHPROrec1.number
              C11: CLAUSErec1.deixis = omegadeixis              AND
                   NPrec1.superdeixis = CLAUSErec1.superdeixis
              A11: @                   
              C12: CLAUSErec1.deixis <> omegadeixis             AND
                   NPrec1.superdeixis = CLAUSErec1.deixis
              A12: @
          A1: POSSADJrec1.mood := wh;
         >

      DECOMP
         <
          C1: POSSADJrec1.mood = wh
              C11: CLAUSErec1.deixis = omegadeixis
              A11: NPrec1.superdeixis := CLAUSErec1.superdeixis;
              C12: CLAUSErec1.deixis <> omegadeixis
              A12: NPrec1.superdeixis := CLAUSErec1.deixis;
          A1: WHPROrec1 := COPYT_bwhprotowhpro(BWHPROrec1);
              NPrec1.generic := nogeneric;
              NPrec1.definite := NPrec3.definite;
              NPrec1.mood := NPrec3.mood;
              NPrec1.animate := WHPROrec1.animate;
              NPrec1.sexes := WHPROrec1.sexes;
              NPrec1.number := WHPROrec1.number;
              NPVARrec1 := COPYT_nptovar(NPrec1);
              NPVARrec1.cases := [];
              NPVARrec1.index := LEVEL;
         >

>

&

\end{verbatim}

