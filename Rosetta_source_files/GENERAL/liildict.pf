 *  Copyright (c) 1986, by Nederlandse Philips Bedrijven BV.
 *
 *  Remarks         : Implementation of the abstract datatype ILDict.
 *                    The module provides I/O functions for accessing
 *                    AILDICT and GILDICT.
 *
 *                    15-okt-1990: 'marked' added to RecordDef, Read
 *                                 functions modified.
 *
 *EMP:::===================================================================*)



(*=========================================================================*
 *  Imported modules
 *=========================================================================*)
pragma C_Include('cisam.pf');

PACKAGE LIILDICT;
WITH CISAM;

(*MPC:::===================================================================*
 *
 *  Constant name  : LIILDict_MaxMDLength
 *  Description    : Maximum length of the meaning description string
 *
 *EMP:::===================================================================*)

CONST
   LIILDict_MaxMDLength = 50;


(*MPC:::===================================================================*
 *
 *  Constant name  : LIILDict_MaxLPinfoLength
 *  Description    : Maximum length of the language pair info description
 *
 *EMP:::===================================================================*)

CONST
   LIILDict_MaxLPinfoLength = 5;


(*MPT:::===================================================================*
 *
 *  Type name      : LIILDict_MeaningDescr
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LIILDict_MeaningDescr = PACKED ARRAY[1..LIILDict_MaxMDLength] OF CHAR; 


(*MPT:::===================================================================*
 *
 *  Type name      : LIILDict_LPinfoDescr
 *  Description    : 
 *
 *EMP:::===================================================================*)

TYPE
   LIILDict_LPinfoDescr = PACKED ARRAY[1..LIILDict_MaxLPinfoLength] OF CHAR; 


(*MPT:::===================================================================*
 *
 *  Type name      : LIILDict_AnGenSwitch
 *  Description    : Defines whether a record is relevant for analysis,
 *                   generation or both.
 *
 *EMP:::===================================================================*)

TYPE
   LIILDict_AnGenSwitch = ( LIILDict_Analysis, LIILDict_Generation,
                             LIILDict_Both );

(*MPT:::===================================================================*
 *
 *  Type name      : LIILDict_RecordDef
 *  Description    : Definition of the record type of ILDICT
 *
 *EMP:::===================================================================*)

TYPE
   LIILDict_RecordDef = RECORD
                            skey          : INTEGER;
                            mkey          : INTEGER;
                            spref         : INTEGER;
                            mpref         : INTEGER;
                            md            : LIILDict_MeaningDescr;
                            info          : LIILDICT_LPinfoDescr;
                            ag            : LIILDict_AnGenSwitch;
                            marked        : BOOLEAN;
                         END;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIILDICT_OpenILDict
 *  Description     : Open ILDict for Read access
 *  Parameters      : none
 *  Precondition    : ILDict is not yet open
 *  Postcondition   : ILDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIILDICT_OpenILDict;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetAILDict
 *  Description    : 
 *  Parameters     : skey        : INTEGER
 *                   VAR rec     : LIILDict_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey and 'marked' is false
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetAILDict(skey        : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetNextAILDict
 *  Description    : 
 *  Parameters     : skey        : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey and 'marked' is false
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetNextAILDict(skey        : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetGILDict
 *  Description    : 
 *  Parameters     : mkey        : INTEGER
 *                   VAR rec     : LIILDict_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey and 'marked' is false
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetGILDict(mkey        : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetNextGILDict
 *  Description    : 
 *  Parameters     : mkey        : INTEGER
 *                   VAR rec     : LIILDict_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey and 'marked' is false
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetNextGILDict(mkey    : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetAILDictAll
 *  Description    : 
 *  Parameters     : skey        : INTEGER
 *                   VAR rec     : LIILDict_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetAILDictAll(skey        : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetNextAILDictAll
 *  Description    : 
 *  Parameters     : skey        : INTEGER
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   skey
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetNextAILDictAll(skey        : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetGILDictAll
 *  Description    : 
 *  Parameters     : mkey        : INTEGER
 *                   VAR rec     : LIILDict_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetGILDictAll(mkey        : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_GetNextGILDictAll
 *  Description    : 
 *  Parameters     : mkey        : INTEGER
 *                   VAR rec     : LIILDict_RecordDef;
 *  Result         : BOOLEAN; false if no entry can be found with specified
 *                   mkey
 *  Precondition   : ILDict has been opened
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_GetNextGILDictAll(mkey    : INTEGER;
                                        VAR rec     : LIILDict_RecordDef)
                                      : BOOLEAN; 
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIILDICT_Release
 *  Description     : Unlock ILDict 
 *  Parameters      : none
 *  Precondition    : ILDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIILDICT_Release;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIILDICT_Reset
 *  Description     : Resets ILDict 
 *  Parameters      : none
 *  Precondition    : ILDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIILDICT_Reset;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name  : LIILDICT_CloseILDict
 *  Description     : Close ILDict 
 *  Parameters      : none
 *  Precondition    : ILDict is open
 *
 *EMP:::===================================================================*)

PROCEDURE LIILDICT_CloseILDict;
EXTERNAL;

(*MPP:::===================================================================*
 *
 *  Procedure Name  : LIILDICT_OpenILDICT
 *  Description     : Opens ILDICT dictionary for reading
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LIILDICT_OpenILDictWrite;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_WriteSequential
 *  Description    : Writes the current record of the ILDICT file
 *  Parameters     : VAR rec: LIILDICT_RecordDef;
 *  Result         : BOOLEAN;
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_WriteSequential(rec: LIILDICT_RecordDef): BOOLEAN;
EXTERNAL;


(*MPP:::===================================================================*
 *
 *  Procedure Name  : LIILDICT_OpenILDICTUpdate
 *  Description     : Opens ILDICT dictionary for updating
 *  Parameters      : None
 *
 *EMP:::===================================================================*)

PROCEDURE LIILDICT_OpenILDictUpdate;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_Update
 *  Description    : Updates the current record of the ILDICT file
 *  Parameters     : rec: LIILDICT_RecordDef;
 *  Result         : VMSRMS_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_Update(rec: LIILDICT_RecordDef): CISAM_StatusType;
EXTERNAL;


(*MPF:::===================================================================*
 *
 *  Function Name  : LIILDICT_Delete
 *  Description    : Deletes the current record of the ILDICT file
 *  Parameters     : rec: LIILDICT_RecordDef;
 *  Result         : VMSRMS_StatusType;
 *
 *EMP:::===================================================================*)

FUNCTION LIILDICT_Delete: CISAM_StatusType;
EXTERNAL;


END {LIILDICT};
