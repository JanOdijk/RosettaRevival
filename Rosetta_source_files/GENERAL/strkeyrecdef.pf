PACKAGE StrKeyRecDef;

CONST
   StrKeyRecDef_MaxStrLength = 50;

TYPE
   StrKeyRecDef_StrType   = PACKED ARRAY [1..StrKeyRecDef_MaxStrLength] OF CHAR;
   StrKeyRecDef_RecordDef = RECORD
                               StrKey : StrKeyRecDef_StrType;
                               IntKey : INTEGER
                            END;

END {StrKeyRecDef};
