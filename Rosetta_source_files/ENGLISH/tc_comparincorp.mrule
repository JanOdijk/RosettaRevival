\newpage
\begin{verbatim}


% TRANSFORMATION TComparIncorp
< m1: I5::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu6,
                       predrel/ADJP{ADJPrec1}
                              [ I2:mu2,
                                degreemodrel/QP{QPrec1}
                                           [ I3:mu3,
                                             head/Q(KEY_moreQkey){Qrec1}
                                           ],
                                 head/I1::ADJ{ADJrec1}[mu4],
                                 mu5
                               ],
                       mu7
                     ],
               mu8
             ]
>

< m : I5::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu6,
                       predrel/ADJP{ADJPrec1}
                              [ I2:mu2,
                                I3:mu3, (* much/a bit/ 3 METER *)
                                head/I4::ADJ{ADJrec2}[mu4],
                                mu5
                              ],
                       mu7
                     ],
              mu8
            ]
>

   MATCHCONDITIONS
      < I1: ADJrec1.compformations <> [noComp] AND
            ADJrec1.compformations <> [moreComp]
        I2: NOT EXIST (mu2, [premodrel/..])
        I3: ALL (mu3, premodrel/..)
        I4: ADJrec2.compformations <> [noComp] AND
            ADJrec2.compformations <> [moreComp]
        I5: synbe IN CLAUSErec1.synvpefs
      >

      COMP
         <
          C1: ADJrec1.compform = basic AND
              QPrec1 = COPYT_qTOqp(Qrec1)
          A1: ADJrec2 := ADjrec1;
              ADJrec2.compform := compar
         >

      DECOMP
         <
          C1: ADJrec2.compform = compar
          A1: ADJrec1 := ADjrec2;
              ADJrec1.compform := basic;
              QPrec1 := COPYT_qTOqp(Qrec1);
         >
&

\end{verbatim}
\newpage
\begin{description}
\item[* name:] TComparIncorp
\item[* relevant examples:] (he is) more long $\rightarrow$ (he is) longer 
\item[* language:] English
\item[* kind of rule:] (M-rule, S-rule, Transferrule) M-rule
\item[* subgrammar:] XPPROPtoCLAUSE
\item[* class:] TC\_ComparIncorp
\item[* date of creation:] 17-APR-1989
\item[* author:] margreet sanders
\item[* copied from:] English TADJmoreTOer
\item[* modification:]\mbox{}
\begin{enumerate}
\item date: ../../..\ \ \ \ \ author:
\item date: ../../..\ \ \ \ \ author:
\end{enumerate}
\item[* task:] morphological incorporation of the comparative expression 
`more'
\item[\ \ strategy:] (also: deviations from accepted proposals) It is assumed 
that superdeixis and thanascompl of the QP are indeed default. I don't know
whether that affects translation of sentences like {\em He is taller than John
\/}.\\
If moreComp is 
in the set of possible compformations, but not as the only member, both the 
current rule and the default rule apply.\\
Finally, it is assumed that the present rule and the next one (for 
superlative formation) are mutually exclusive. Note that they are called only
after AdjClauseFormation, and not after any of the other clause formation rules
(see the control expression)
\item[\ \ rejected alternatives:]
\item[\ \ clarification of variables:]
mu2 for all kinds of arguments and modifiers (not degreemodifiers),
mu3 for modifiers of {\em more}
\item[\ \ clarification of the splitting up into subrules:]
\item[\ \ clarification of the collapsing of rules:] (e.g. clarification of parameters)
\item[\ \ differences analytical/generative version:]
\item[\  \ suggested semantics:]
\item[\ \ presuppositions:]\mbox{}
\begin{enumerate}
\item dictionary:\\

\item rules:\\

\end{enumerate}
\item[\ \ consequences in the grammar:]
\item[\ \ translation aspects:]\mbox{}
\begin{enumerate} 
\item within this language:\\

\item in other languages:\\

\end{enumerate}
\item[* relevant literature/documents:]
\item[\ \ remarks:]\mbox{}
\begin{enumerate}
\item problems:\\

\item modifications:\\

\end{enumerate}
\end{description}

\newpage
\begin{verbatim}

% TRANSFORMATION TSuperIncorp
< m1: I5::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu6,
                       predrel/ADJP{ADJPrec1}
                              [ I2:mu2,
                                degreemodrel/QP{QPrec1}
                                        [ I3:mu3,
                                          artrel/ART(KEY_theARTkey){ARTrec1},
                                          head/Q(KEY_mostQkey){Qrec1}
                                         ],
                                 head/I1::ADJ{ADJrec1}[mu4],
                                 mu5
                               ],
                        mu7
                      ],
              mu8
            ]
>

< m : I5::CLAUSE{CLAUSErec1}
            [ mu1,
              predrel/VERBP{VERBPrec1}
                     [ mu6,
                       predrel/ADJP{ADJPrec1}
                              [ I2:mu2,
                                I3:mu3, (* ALMOST *)
                                artrel/ART(KEY_theARTkey){ARTrec1},
                                head/I4::ADJ{ADJrec2}[mu4],
                                mu5
                              ],
                       mu7
                     ],
              mu8
            ]
>
   MATCHCONDITIONS
      < I1: ADJrec1.compformations <> [noComp] AND
            ADJrec1.compformations <> [moreComp]
        I2: NOT EXIST (mu2, [premodrel/..])
        I3: ALL (mu3, premodrel/..)
        I4: ADJrec2.compformations <> [noComp] AND
            ADJrec2.compformations <> [moreComp]
        I5: synbe IN CLAUSErec1.synvpefs
      >

      COMP
         <
          C1: ADJrec1.compform = basic AND
              QPrec1 = COPYT_qTOqp(Qrec1) 
          A1: ADJrec2 := ADjrec1;
              ADJrec2.compform := super
         >

      DECOMP
         <
          C1: ADJrec2.compform = super
          A1: ADJrec1 := ADjrec2;
              ADJrec1.compform := basic;
              QPrec1 := COPYT_qTOqp(Qrec1);   
         >
&

\end{verbatim}
