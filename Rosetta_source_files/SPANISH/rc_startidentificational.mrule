% RULE RidentformationESO2
< m1: I2::NPVAR{NPVARrec1}
  m2: NP{NPrec1}[mu1] 
>

< m :NPPROP{NPPROPrec1}
           [ subjrel/NP{NPrec2}[mu2],
             idrel/I2::NPVAR{NPVARrec1} 
           ]
>

   MATCHCONDITIONS
      <
       I2: NOT (NPVARrec1.NPhead IN [quewhproNP, persproNP])
      >


<
   SUBRULE (* 1. aquél *)
      < mu1: [head/DEMPRO(KEY_aquelloDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_aquelDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONaquelloDMPR EXCEPT FOR
                         [supertiempo, generic]  AND
              NPrec1.supertiempo = presente      AND
              NPrec1.generic = nogeneric         AND
              NPVARrec1.numero = singular        AND
              NPVARrec1.genero = masc
          A1: NPrec2 := AUX_NPONaquelDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >


   SUBRULE (* 2. aquélla *)
      < mu1: [head/DEMPRO(KEY_aquelloDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_aquellaDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONaquelloDMPR EXCEPT FOR
                         [supertiempo, generic]  AND
              NPrec1.supertiempo = presente      AND
              NPrec1.generic = nogeneric         AND
              NPVARrec1.numero = singular        AND
              NPVARrec1.genero = fem
          A1: NPrec2 := AUX_NPONaquellaDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

   SUBRULE (* 3. aquéllos *)
      < mu1: [head/DEMPRO(KEY_aquelloDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_aquellosDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONaquelloDMPR EXCEPT FOR
                         [supertiempo, generic]  AND
              NPrec1.supertiempo = presente      AND
              NPrec1.generic = nogeneric         AND
              NPVARrec1.numero = plural          AND
              NPVARrec1.genero = masc
          A1: NPrec2 := AUX_NPONaquellosDMPR;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPPROPrec1.aktionsarts := [stative]
              (* rest of npprop remains default *)
         >

   SUBRULE (* 4. aquéllas *)
      < mu1: [head/DEMPRO(KEY_aquelloDEMPROkey){DEMPROrec1}] >
      < mu2: [head/DEMPRO(KEY_aquellasDEMPROkey){DEMPROrec2}] >

      COMP
         <
          C1: NPrec1 = AUX_NPONaquelloDMPR EXCEPT FOR
                         [supertiempo, generic]  AND
              NPrec1.supertiempo = presente      AND
              NPrec1.generic = nogeneric         AND
              NPVARrec1.numero = plural          AND
              NPVARrec1.genero = fem
       A1: NPrec2 := AUX_NPONaquellasDMPR;
              NPrec2.supertiempo := omegatiempo;
