ENGLISH 84

&
\begin{verbatim}
%
%SUBGRAMMAR Advderivation

( RBadvToSubadv/1  | RSubadjToSubadv/2 )


HEAD:
<
BADV BASIC EXPRESSION
BADVSUFF BASIC EXPRESSION
>

(* IMPORT *)
< 
 2: < ARGUMENT 2    SUBADJ       FROM (AdjDerivation) >
>

EXPORT:
< SUBADV >

&

\end{verbatim}
\newpage
\begin{verbatim}
% RULE RBAdvtoSubAdv
< m1: BADV{BADVrec1} 
>

< m : SUBADV{SUBADVrec1}[head/BADV{BADVrec1}]
>

      COMP
         <
          C1: true
          A1: SUBADVrec1 := COPYT_badvTOsubadv(BADVrec1);
              SUBADVrec1.affix := noaffix
         >
      DECOMP
         <
          C1: SUBADVrec1 = COPYT_badvTOsubadv(BADVrec1) AND
              SUBADVrec1.affix = noaffix 
          A1: @
         >
&

\end{verbatim}
