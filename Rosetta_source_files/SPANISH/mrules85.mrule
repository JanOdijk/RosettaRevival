\newpage
\begin{verbatim}
% RULE Rppsubstitution1
< m1:PREPP{PREPPrec1}
          [ mu2,
            objrel/I1::NPVAR{NPVARrec1},
            mu3 
          ]
  SUBST:
  m2:NP{NPrec1}[mu5]
>

< m :PREPP{PREPPrec1}
          [ mu2,
            objrel/NP{NPrec2}[mu6],
            mu3 
          ]
>


   MATCHCONDITIONS
      <
       I1: NPVARrec1.index = LEVEL
      >


   PARAMETERS
      <
       LEVEL
      >



      COMP
         <
          C1: NPrec1.generic = nogeneric AND
              NPVARrec1 = COPYT_nptovar(NPrec1) EXCEPT FOR [cases] AND
              NPrec1.cases = [] AND
              NPrec1.supertiempo = PREPPrec1.supertiempo
          A1: QUOTE_assigncase(NPrec1,mu5,NPrec2,mu6,NPVARrec1.cases);
              NPrec2.generic := omegageneric;
              NPrec2.supertiempo := omegatiempo;
         >
      DECOMP
         <
          C1: NPrec2.generic = omegageneric  AND
              NPrec2.supertiempo = omegatiempo
          A1: QUOTE_assigncase(NPrec2,mu6,NPrec1, mu5, []);
              NPrec1.generic := nogeneric;
              NPVARrec1 := COPYT_nptovar(NPrec2);
              NPVARrec1.index := LEVEL;
              NPVARRec1.generic := nogeneric;
              NPrec1.supertiempo := PREPPrec1.supertiempo;
         >

&

\end{verbatim}
