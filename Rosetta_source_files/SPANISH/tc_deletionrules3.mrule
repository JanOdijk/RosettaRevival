                     actsubcefs    : PREPrec1.subcs
                     synppefs      : PREPrec1.synpps
                     thetapp       : PREPrec1.thetapp
                     headkey       : PREPrec1.key
                     class         : NPrec1.class
                     tiempo        : NPrec1.tiempo
                     aspecto       : NPrec1.aspecto
                     retro         : NPrec1.retro
                     supertiempo   : NPrec1.supertiempo
                     SpecQ         : NPrec1.SpecQ
                   })                           AND

              (NPrec1 = AUX_NPONnomBPRSPR EXCEPT FOR [cases, numero,
                                                      persona, genero]) AND
              (prepositive IN NPrec1.cases) AND
              (NPrec1.numero = PERSPROrec2.numero) AND
              (NPrec1.persona = PERSPROrec2.persona) AND
              (NPrec1.genero = PERSPROrec2.genero) AND
 
              (PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                              EXCEPT FOR [forma]) AND
              (PERSPROrec2.forma = PrepFuerte)
          A1:  @
         >
  

   SUBRULE  (* les vrouwelijk; ustedes *)
      < T1:BPERSPRO(KEY_ustedesfembpersprokey){BPERSPROrec1}
        T2:BPERSPRO(KEY_ustedesfembpersprokey){BPERSPROrec2}>

         <
          C1: (PERSPROrec1.forma = datCL)      AND
              (PERSPROrec1.numero = plural)    AND
              (PERSPROrec1.persona = 3)        AND
              (PERSPROrec1.genero = fem)       AND
              (PERSPROrec1.cortesia = si)      AND
              (rel1 = tresCLrel)                AND

              (PREPPrec1 =
                   { mood          : NPrec1.mood
                     actsubcefs    : PREPrec1.subcs
                     synppefs      : PREPrec1.synpps
                     thetapp       : PREPrec1.thetapp
                     headkey       : PREPrec1.key
                     class         : NPrec1.class
                     tiempo        : NPrec1.tiempo
                     aspecto       : NPrec1.aspecto
                     retro         : NPrec1.retro
                     supertiempo   : NPrec1.supertiempo
                     SpecQ         : NPrec1.SpecQ
                   })                           AND

              (NPrec1 = AUX_NPONnomBPRSPR EXCEPT FOR [cases, numero,
                                                      persona, genero]) AND
              (prepositive IN NPrec1.cases) AND
              (NPrec1.numero = PERSPROrec2.numero) AND
              (NPrec1.persona = PERSPROrec2.persona) AND
              (NPrec1.genero = PERSPROrec2.genero) AND
 
              (PERSPROrec2 = COPYT_btoperspro(BPERSPROrec2) 
                                              EXCEPT FOR [forma]) AND
              (PERSPROrec2.forma = PrepFuerte)
          A1:  @
         >
  

>
&

\end{verbatim}
