                                    SFKyPlusPres | SFKbendic ) ] )
 | ( ( SFKa | SFKe | SFKe1 ) [ ( SFKdiftong | SFKeiouHeel | SFKyPlusPres | 
                                 SFKbendic ) ] )
(* pres. plur. ind.: *)
 | ( SFKamos | SFKemos | SFKimos )
 | ( SFKa1is | SFKe1is | SFKi1s  )
 | ( ( SFKan | SFKen  | SFKe1n ) [ ( SFKdiftong| SFKeiouHeel | SFKyPlusPres | 
                                     SFKbendic ) ] )


(* pres. sing. subj.: *)
 | ( ( SFKe | SFKa |  SFKes | SFKas ) [ ( SFKdiftong | SFKirrMedek | 
                                                SFKeiouHeel | SFKumlaut | 
                                                SFKve | SFKsepa ) ] )
(* pres. plur. subj.: *)
 | ( ( SFKemos | SFKamos ) [ ( SFKirrMedek | SFKeiouHalf | SFKeiouHeel | 
                               SFKumlaut | SFKve | SFKsepa ) ] )
 | ( ( SFKe1is | SFKa1is ) [ ( SFKirrMedek | SFKeiouHalf | SFKeiouHeel | 
                               SFKumlaut | SFKve | SFKsepa ) ] )
 | ( ( SFKen | SFKan ) [ ( SFKdiftong | SFKirrMedek | SFKeiouHeel | SFKumlaut | 
                           SFKve | SFKsepa ) ] )


(* imperf. sing.: *)
 | ( ( SFKaba | SFKi1a | SFKabas | SFKi1as | SFKaba | SFKi1a ) [ SFKve ] )
(* imperf. plur.: *)
 | ( ( SFKa1bamos | SFKi1amos | SFKabais | SFKi1ais | SFKaban | SFKi1an )
     [ SFKve ] )

(* PD sing.: *)
 | ( ( SFKe1 | SFKi1 | SFKe ) [ ( SFKsterk | SFKeiouPD ) ] )
 | ( ( SFKaste | SFKiste | SFKiste ) [ ( SFKsterk | SFKeiouPD ) ] )
 | ( ( SFKo1 | SFKio1 | SFKo ) [ ( SFKsterk | SFKeiouHalf | SFKeiouHeel | 
                                 SFKyMinPres | SFKeiouPD ) ] )
(* PD plur.: *)
 | ( ( SFKamos | SFKimos ) [ ( SFKsterk | SFKeiouPD ) ] )
 | ( ( SFKasteis | SFKisteis ) [ ( SFKsterk | SFKeiouPD ) ] )
 | ( ( SFKaron | SFKieron ) [ ( SFKsterk | SFKeiouHalf | SFKeiouHeel | 
                                SFKyMinPres | SFKeiouPD ) ] )


(* Subj. Pas(a). Sing.: *)
 | ( ( SFKara | SFKiera | SFKase | SFKiese | 
       SFKaras | SFKieras | SFKases | SFKieses | 
       SFKara | SFKiera | SFKase | SFKiese )
     [ ( SFKsterk | SFKeiouHalf | SFKeiouHeel | SFKyMinPres | SFKeiouPD | 
         SFKyPlusPres ) ] )
(* Subj. Pas(a). Plur.: *)
 | ( ( SFKa1ramos | SFKie1ramos | SFKa1semos | SFKie1semos | 
       SFKarais | SFKierais | SFKaseis | SFKieseis | 
       SFKaran | SFKieran | SFKasen | SFKiesen )
     [ ( SFKsterk | SFKeiouHalf | SFKeiouHeel | SFKyMinPres | SFKeiouPD | 
         SFKyPlusPres ) ] )


(* Fut. Sing.: *)
 | ( SFKare1 | SFKere1 | SFKire1 | SFKara1s | SFKera1s | SFKira1s | 
     SFKara1 | SFKera1 | SFKira1 )
(* Fut. Plur.: *)
 | ( SFKaremos | SFKeremos | SFKiremos | SFKare1is | SFKere1is | SFKire1is | 
     SFKara1n | SFKera1n | SFKira1n )


(* Cond. Sing.: *)
 | ( SFKari1a  | SFKeri1a | SFKiri1a | SFKari1as | SFKeri1as | SFKiri1as |  
     SFKari1a | SFKeri1a | SFKiri1a )
(* Cond. Plur.: *)
 | ( SFKari1amos | SFKeri1amos | SFKiri1amos | SFKari1ais | SFKeri1ais | 
     SFKiri1ais | SFKari1an | SFKeri1an | SFKiri1an )


(* Infinitivo: *)
 | ( SFKar | SFKer | SFKir )
(* Irr. Infinitivo: *)
 | ( SFKirrInf )


(* Imperativo: *)
 | ( ( SFKa | SFKe | SFKe1 ) [ ( SFKdiftong | SFKeiouHeel | SFKve ) ] )
 | ( SFKad | SFKed | SFKid )
(* Irr. Imperativo: *)
 | ( SFKirrImperatSG )


(* Participio: *)
 | ( SFKado | SFKido | SFKada | SFKida | SFKados | SFKidos | SFKadas | SFKidas )
(* Irr. Participio: *)                 
