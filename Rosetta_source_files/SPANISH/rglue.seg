*u(MED1)an+(B)+(A3) :: *ú(MED1)an(B)(A3) ;



*a(MED1)(MED2)an+(B)+(A3) :: *á(MED1)(MED2)an(B)(A3) ;

*e(MED1)(MED2)an+(B)+(A3) :: *é(MED1)(MED2)an(B)(A3) ;

*i(MED1)(MED2)an+(B)+(A3) :: *í(MED1)(MED2)an(B)(A3) ;

*o(MED1)(MED2)an+(B)+(A3) :: *ó(MED1)(MED2)an(B)(A3) ;

*u(MED1)(MED2)an+(B)+(A3) :: *ú(MED1)(MED2)an(B)(A3) ;


*a(MED1)(MED2)(MED3)an+(B)+(A3) :: *á(MED1)(MED2)(MED3)an(B)(A3) ;

*e(MED1)(MED2)(MED3)an+(B)+(A3) :: *é(MED1)(MED2)(MED3)an(B)(A3) ;

*i(MED1)(MED2)(MED3)an+(B)+(A3) :: *í(MED1)(MED2)(MED3)an(B)(A3) ;

