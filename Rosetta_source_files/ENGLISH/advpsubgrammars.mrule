\begin{verbatim}
% RULE RADVPdegreemod3
< m1: I3::ADVP{ADVPrec1}
                    [head/ADV{ADVrec1}[mu2]
                    ]

  m2: ADVP{ADVPrec3}[mu1,
                 I1:head/T1,
                 I5:thanascomplrel/T3
                ]
>

< m: I4::ADVP{ADVPrec2}
                   [degreemodrel/ADVP{ADVPrec4}
                                           [mu1,
                                            I1:head/T1
                                           ],
                    head/ADV{ADVrec1}[mu2],
                    I5:postmodrel/T3
                    ]

>

   MATCHCONDITIONS
      <I1: T1.cat IN [ADV] WITH degreeadv IN T1.REC.subcs 
       I3: ADVPrec1.temporal = true
       I4: ADVPrec2.temporal = true
       I5: T3.cat IN [THANP]
      >


      COMP
         <
          C1: ADVPrec3.superdeixis = ADVPrec1.superdeixis
          A1: ADVPrec4 := ADVPrec3;
              ADVPrec4.superdeixis := omegadeixis;
              ADVPrec2 := ADVPrec1;
              ADVPrec2.mood := ADVPrec4.mood;  (* m.h.o. op een WH-modifier *)
         >
      DECOMP
         < 
          C1: ADVPrec4.superdeixis = omegadeixis AND
              ADVPrec2.mood = ADVPrec4.mood
          A1: ADVPrec3 := ADVPrec4;
              ADVPrec3.superdeixis := ADVPrec2.superdeixis;
              ADVPrec1 := ADVPrec2;
              ADVPrec1.mood := nowh;          

        >

&

\end{verbatim}
