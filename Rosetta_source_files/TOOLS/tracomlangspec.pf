pragma c_include('tstring.pf');
package tracomlangspec;
with tstring;
const
     tracomlangspec_nrow = 15 ;
type setofchar = set of char;
type
     tracomlangspec_int=integer;
     tracomlangspec_bool=boolean;
plosstring = ^losstring;
losstring = record
   next:plosstring;
   carriage:boolean;
   arg:tstring_string
 end; 
localfile = record 
first,last:plosstring
 end; 
tracomlangspec_ident = record 
str:TSTRING_string;

 end; 
plosident = ^losident;
losident = record
   next:plosident;
   arg:tracomlangspec_ident
 end; 
tracomlangspec_setofidents = record 
first,last:plosident
 end; 
tracomlangspec_identset = record 
val:tracomlangspec_setofidents;

 end; 
plosidentset = ^losidentset;
losidentset = record
   next:plosidentset;
   arg:tracomlangspec_identset
 end; 
tracomlangspec_setofidentsets = record 
first,last:plosidentset
 end; 
tracomlangspec_pair = record 
lefts:tracomlangspec_setofidents;
rights:tracomlangspec_setofidents;
leftsetvalued:tracomlangspec_bool;
rightsetvalued:tracomlangspec_bool;
leftpresent:tracomlangspec_bool;
rightpresent:tracomlangspec_bool;
leftsets:tracomlangspec_setofidentsets;
rightsets:tracomlangspec_setofidentsets;

 end; 
plospair = ^lospair;
lospair = record
   next:plospair;
   arg:tracomlangspec_pair
 end; 
tracomlangspec_setofpairs = record 
first,last:plospair
 end; 
tracomlangspec_numcode = record 
num:tracomlangspec_int;
code:LOCALFILE;

 end; 
plosnumcode = ^losnumcode;
losnumcode = record
   next:plosnumcode;
   arg:tracomlangspec_numcode
 end; 
tracomlangspec_setofnumcodes = record 
first,last:plosnumcode
 end; 
tracomlangspec_pairset = record 
mruparam:TSTRING_string;
ilparam:TSTRING_string;
mrutype:TSTRING_string;
iltype:TSTRING_string;
pairs:tracomlangspec_setofpairs;

 end; 
plospairset = ^lospairset;
lospairset = record
   next:plospairset;
   arg:tracomlangspec_pairset
 end; 
tracomlangspec_setofpairsets = record 
first,last:plospairset
 end; 
tracomlangspec_simple = record 
param:TSTRING_string;
valeu:LOCALFILE;
copy:LOCALFILE;

 end; 
plossimple = ^lossimple;
lossimple = record
   next:plossimple;
   arg:tracomlangspec_simple
 end; 
tracomlangspec_setofsimples = record 
first,last:plossimple
 end; 
tracomlangspec_simpleset = record 
val:tracomlangspec_setofsimples;
copy:LOCALFILE;
rulenr:tracomlangspec_int;

 end; 
plossimpleset = ^lossimpleset;
lossimpleset = record
   next:plossimpleset;
   arg:tracomlangspec_simpleset
 end; 
tracomlangspec_setofsimplesets = record 
first,last:plossimpleset
 end; 
     tracomlangspec_pterminal = ^tracomlangspec_terminal;
     tracomlangspec_terminal = 
         record
                       str:tstring_string
           end;
     tracomlangspec_puttrecord = ^tracomlangspec_uttrecord;
     tracomlangspec_uttrecord = 
         record
           end;
     tracomlangspec_plangrecord = ^tracomlangspec_langrecord;
     tracomlangspec_langrecord = 
         record
           end;
     tracomlangspec_prulestransrec = ^tracomlangspec_rulestransrec;
     tracomlangspec_rulestransrec = 
         record
           end;
     tracomlangspec_pruletransrec = ^tracomlangspec_ruletransrec;
     tracomlangspec_ruletransrec = 
         record
           leftpresent:tracomlangspec_bool;
          rightpresent:tracomlangspec_bool;
                sbonus:tracomlangspec_int;
                wbonus:tracomlangspec_int;
           end;
     tracomlangspec_pparstransrec = ^tracomlangspec_parstransrec;
     tracomlangspec_parstransrec = 
         record
              pairsets:tracomlangspec_setofpairsets;
           end;
     tracomlangspec_ppartransrec = ^tracomlangspec_partransrec;
     tracomlangspec_partransrec = 
         record
               pairset:tracomlangspec_pairset;
           end;
     tracomlangspec_pelttransrec = ^tracomlangspec_elttransrec;
     tracomlangspec_elttransrec = 
         record
                  pair:tracomlangspec_pair;
           end;
     tracomlangspec_pandcondrec = ^tracomlangspec_andcondrec;
     tracomlangspec_andcondrec = 
         record
                simple:tracomlangspec_bool;
           end;
     tracomlangspec_porcondrec = ^tracomlangspec_orcondrec;
     tracomlangspec_orcondrec = 
         record
                simple:tracomlangspec_bool;
           end;
     tracomlangspec_pelemcondrec = ^tracomlangspec_elemcondrec;
     tracomlangspec_elemcondrec = 
         record
                simple:tracomlangspec_bool;
           end;
     tracomlangspec_ppascalexprrec = ^tracomlangspec_pascalexprrec;
     tracomlangspec_pascalexprrec = 
         record
                simple:tracomlangspec_bool;
            notpresent:tracomlangspec_bool;
        initialcounter:tracomlangspec_int;
           end;
     tracomlangspec_pvaluenamerec = ^tracomlangspec_valuenamerec;
     tracomlangspec_valuenamerec = 
         record
                   str:TSTRING_string;
           end;
     tracomlangspec_pparamnamerec = ^tracomlangspec_paramnamerec;
     tracomlangspec_paramnamerec = 
         record
                   str:TSTRING_string;
           end;
     tracomlangspec_ptypenamerec = ^tracomlangspec_typenamerec;
     tracomlangspec_typenamerec = 
         record
                   str:TSTRING_string;
           end;
     tracomlangspec_pmrulenamerec = ^tracomlangspec_mrulenamerec;
     tracomlangspec_mrulenamerec = 
         record
                   str:TSTRING_string;
           end;
     tracomlangspec_pilrulenamerec = ^tracomlangspec_ilrulenamerec;
     tracomlangspec_ilrulenamerec = 
         record
                   str:TSTRING_string;
           end;
     tracomlangspec_psetvaluerec = ^tracomlangspec_setvaluerec;
     tracomlangspec_setvaluerec = 
         record
                  copy:tracomlangspec_setofidents;
           end;
     tracomlangspec_category = (comment,identifier,UTT,LANGVERSION,RULESTRANS,RULETRANS,PARAMETERSTRANS,PARAMETERTRANS,ELEMENTTRANS,
ANDCOND,ORCOND,ELEMENTARYCOND,PASCALEXPR,VALUENAME,PARAMNAME,TYPENAME,MRULENAME,ILRULENAME,SETVALUENAME,LEFTARROW,RIGHTARROW,
SQUAREOPEN,SQUARECLOSE,ROUNDOPEN,ROUNDCLOSE,CURLYOPEN,CURLYCLOSE,X1,X2,X3,INTEGERtje,BOOLEANtje,EQUIVALENT,NOTCAT,NICAT,PLUS,SBONUS,
WBONUS,RULE,LEVEL,LANGUAGE,TRANSLATION,BAR,DASH,ANDCAT,ORCAT,INCAT,DEFINITION,COLON,PARAMETER,COMMA);

tracomlangspec_pfielddef = ^tracomlangspec_fielddef;
tracomlangspec_fielddef =
         record
      case cat:tracomlangspec_category of
                  UTT:
                     (UTTfield:tracomlangspec_puttrecord);
                  LANGVERSION:
                     (LANGVERSIONfield:tracomlangspec_plangrecord);
                  RULESTRANS:
                     (RULESTRANSfield:tracomlangspec_prulestransrec);
                  RULETRANS:
                     (RULETRANSfield:tracomlangspec_pruletransrec);
                  PARAMETERSTRANS:
                     (PARAMETERSTRANSfield:tracomlangspec_pparstransrec);
                  PARAMETERTRANS:
                     (PARAMETERTRANSfield:tracomlangspec_ppartransrec);
                  ELEMENTTRANS:
                     (ELEMENTTRANSfield:tracomlangspec_pelttransrec);
                  ANDCOND:
                     (ANDCONDfield:tracomlangspec_pandcondrec);
                  ORCOND:
                     (ORCONDfield:tracomlangspec_porcondrec);
                  ELEMENTARYCOND:
                     (ELEMENTARYCONDfield:tracomlangspec_pelemcondrec);
                  PASCALEXPR:
                     (PASCALEXPRfield:tracomlangspec_ppascalexprrec);
                  VALUENAME:
                     (VALUENAMEfield:tracomlangspec_pvaluenamerec);
                  PARAMNAME:
                     (PARAMNAMEfield:tracomlangspec_pparamnamerec);
                  TYPENAME:
                     (TYPENAMEfield:tracomlangspec_ptypenamerec);
                  MRULENAME:
                     (MRULENAMEfield:tracomlangspec_pmrulenamerec);
                  ILRULENAME:
                     (ILRULENAMEfield:tracomlangspec_pilrulenamerec);
                  SETVALUENAME:
                     (SETVALUENAMEfield:tracomlangspec_psetvaluerec);
identifier,                  LEFTARROW,
                  RIGHTARROW,
                  SQUAREOPEN,
                  SQUARECLOSE,
                  ROUNDOPEN,
                  ROUNDCLOSE,
                  CURLYOPEN,
                  CURLYCLOSE,
                  X1,
                  X2,
                  X3,
                  INTEGERtje,
                  BOOLEANtje,
                  EQUIVALENT,
                  NOTCAT,
                  NICAT,
                  PLUS,
                  SBONUS,
                  WBONUS,
                  RULE,
                  LEVEL,
                  LANGUAGE,
                  TRANSLATION,
                  BAR,
                  DASH,
                  ANDCAT,
                  ORCAT,
                  INCAT,
                  DEFINITION,
                  COLON,
                  PARAMETER,
                  COMMA:
                     (      terminal:tracomlangspec_pterminal);
           end;

procedure initint(var s:integer);external;
procedure initbool(var s:boolean);external;
procedure initsetofidents(var s:tracomlangspec_setofidents); external;
function stillidents(var s:tracomlangspec_setofidents):boolean; external;
procedure takeident(var ident1:tracomlangspec_ident
        ;var s:tracomlangspec_setofidents); external;
procedure appendident(ident1:tracomlangspec_ident
        ;var s:tracomlangspec_setofidents); external;
procedure initsetofidentsets(var s:tracomlangspec_setofidentsets); external;
function stillidentsets(var s:tracomlangspec_setofidentsets):boolean; external;
procedure takeidentset(var identset1:tracomlangspec_identset
        ;var s:tracomlangspec_setofidentsets); external;
procedure appendidentset(identset1:tracomlangspec_identset
        ;var s:tracomlangspec_setofidentsets); external;
procedure initsetofpairs(var s:tracomlangspec_setofpairs); external;
function stillpairs(var s:tracomlangspec_setofpairs):boolean; external;
procedure takepair(var pair1:tracomlangspec_pair
        ;var s:tracomlangspec_setofpairs); external;
procedure appendpair(pair1:tracomlangspec_pair
        ;var s:tracomlangspec_setofpairs); external;
procedure initsetofnumcodes(var s:tracomlangspec_setofnumcodes); external;
function stillnumcodes(var s:tracomlangspec_setofnumcodes):boolean; external;
procedure takenumcode(var numcode1:tracomlangspec_numcode
        ;var s:tracomlangspec_setofnumcodes); external;
procedure appendnumcode(numcode1:tracomlangspec_numcode
        ;var s:tracomlangspec_setofnumcodes); external;
procedure initsetofpairsets(var s:tracomlangspec_setofpairsets); external;
function stillpairsets(var s:tracomlangspec_setofpairsets):boolean; external;
procedure takepairset(var pairset1:tracomlangspec_pairset
        ;var s:tracomlangspec_setofpairsets); external;
procedure appendpairset(pairset1:tracomlangspec_pairset
        ;var s:tracomlangspec_setofpairsets); external;
procedure initsetofsimples(var s:tracomlangspec_setofsimples); external;
function stillsimples(var s:tracomlangspec_setofsimples):boolean; external;
procedure takesimple(var simple1:tracomlangspec_simple
        ;var s:tracomlangspec_setofsimples); external;
procedure appendsimple(simple1:tracomlangspec_simple
        ;var s:tracomlangspec_setofsimples); external;
procedure initsetofsimplesets(var s:tracomlangspec_setofsimplesets); external;
function stillsimplesets(var s:tracomlangspec_setofsimplesets):boolean; external;
procedure takesimpleset(var simpleset1:tracomlangspec_simpleset
        ;var s:tracomlangspec_setofsimplesets); external;
procedure appendsimpleset(simpleset1:tracomlangspec_simpleset
        ;var s:tracomlangspec_setofsimplesets); external;
 function tracomlangspec_scanchars:setofchar;
         external;
 procedure tracomlangspec_init; external;
 procedure tracomlangspec_word(i:integer;var s:tstring_string);
         external;
 function tracomlangspec_wcat(i:integer):tracomlangspec_category;
         external;
 function tracomlangspec_scat(c:char):tracomlangspec_category;
         external;
 procedure tracomlangspec_createterm(s:tracomlangspec_category;
           w:tstring_string;var f:tracomlangspec_fielddef);
         external;
end{langspec};
