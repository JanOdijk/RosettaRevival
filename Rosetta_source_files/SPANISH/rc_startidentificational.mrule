\newpage
\begin{verbatim}
% RULE RPersproIdent
< m1: I1::NPVAR{NPVARrec1}
  m2: I2::NPVAR{NPVARrec2} 
>

< m : NPPROP{NPPROPrec1}
            [ subjrel/I2::NPVAR{NPVARrec2},
              idrel/I1::NPVAR{NPVARrec1}
            ]
>

   MATCHCONDITIONS
      <
       I1: NPVARrec1.NPhead = otherNP AND
           NPVARrec1.definite = def
       I2: NPVARrec2.NPhead = persproNP
      >

      COMP
         <
          C1: true
          A1: NPPROPrec1.aktionsarts := [stative]
              (* rest of NPPROP remains default *)
         >
      DECOMP
         <
          C1: NPPROPrec1 = NPPROPrecdef EXCEPT FOR [aktionsarts] AND
              NPPROPrec1.aktionsarts = [stative]
          A1: @
         >
&

\end{verbatim}
