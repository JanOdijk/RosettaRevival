\begin{verbatim}
%
% TRANSFORMATION TVerbpattern7
< m1: VERBPPROP{VERBPPROPrec1}[ mu1,
                                predrel/VERBP{VERBPrec1}
                                       [ head/VERB{VERBrec1}[mu2],
                                         argrel/T1,
                                         argrel/T2
                                       ] 
                               ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
		        [ head/VERB{VERBrec1}[mu2],
		          objrel/T1,
                          paraobjrel/VARPREPP{VARPREPPrec1}
				[ head/PREP(KEY_paraioprepkey){PREPrec1},
                                  objrel/T2
				]
		        ] 
	       ]
>


   (* Compro un libro para esta mujer (vp123) *)

<
  SUBRULE (*a*)
     <T2:NPVAR{NPVARrec1}>
     <T2:NPVAR{NPVARrec1}>

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synPARANP_DONP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: VARPREPPrec1 := PREPPrecdef;
                VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_paraioprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : NPVARrec1.SpecQ
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synPARANP_DONP]
          A1:  @
         >

  SUBRULE (*b*)
     <T2:NPVAR{NPVARrec1}>
     <T2:NPVAR{NPVARrec1}>

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synPARANP_DONP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = []
            A2: VARPREPPrec1 := PREPPrecdef;
                VARPREPPrec1 :=
                  { mood       : NPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synNP]
                    thetapp    : pp120
                    headkey    : KEY_paraioprepkey
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };

                VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synPARANP_DONP]
          A1:  @
         >
>
&

\end{verbatim}
