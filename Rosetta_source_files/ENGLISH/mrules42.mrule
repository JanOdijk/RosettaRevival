\begin{verbatim}
% TRANSFORMATION TObjReflInsertion2        (* CNVAR antecedent *)
< m1: VERBPPROP{VERBPPROPrec1}
               [mu8,
                subjrel/CNVAR{CNVARrec1},
                mu1,
                predrel/VERBP{VERBPrec1}
                       [mu4,
                        head/I1::VERB{VERBrec1}[mu3],
                        I3:sig1,
                        I2:mu2
                       ],
                mu5
               ]
>

< m : VERBPPROP{VERBPPROPrec1}
               [mu8,
                subjrel/CNVAR{CNVARrec1},
                mu1,
                predrel/VERBP{VERBPrec1}
                       [mu4,
                        head/I1::VERB{VERBrec1}[mu3],
                        I3:sig1,
                        objrel/NP{NPrec1}[head/T1],
                        I2:mu2
                       ],
                mu5
               ]
>

   MATCHCONDITIONS
      <
       I1: VERBrec1.reflexivity = dobjrefl 
       I2: NOT EXIST (mu2, [objrel/..]) AND
           NOT EXIST (mu2, [partrel/..])
       I3: ALL (sig1, partrel/..)
      >

<
   SUBRULE (* 1. himself *)
      < >
      < T1: REFLPRO(AUX_himselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: singular IN CNVARrec1.numbers 
            C11: masculine IN CNVARrec1.sexes OR
                 CNVARrec1 = { sexes    : []
                               genders NI masculinegender }
            A11: @
          A1: NPrec1 := AUX_NPONhimRFLPR
         >
      DECOMP
         <
          C1: singular IN CNVARrec1.numbers AND
              NPrec1 = AUX_NPONhimRFLPR
            C11: masculine IN CNVARrec1.sexes OR
                 CNVARrec1 = { sexes    : []
                               genders NI masculinegender }
            A11: @
          A1: @
         >

   SUBRULE (* 2. herself *)
      < >
      < T1: REFLPRO(AUX_herselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: singular IN CNVARrec1.numbers 
            C11: feminine IN CNVARrec1.sexes OR
                 CNVARrec1 = { sexes    : []
                               genders NI femininegender }
            A11: @
          A1: NPrec1 := AUX_NPONherRFLPR
         >
      DECOMP
         <
          C1: singular IN CNVARrec1.numbers AND
              NPrec1 = AUX_NPONherRFLPR
            C11: feminine IN CNVARrec1.sexes OR
                 CNVARrec1 = { sexes    : []
                               genders NI femininegender }
            A11: @
          A1: @
         >

   SUBRULE (* 3. itself *)
      < >
      < T1: REFLPRO(AUX_itselfreflprokey){REFLPROrec1} >

      COMP
         <
          C1: singular IN CNVARrec1.numbers 
            C11: CNVARrec1.genders = [omegagender] AND
                 CNVARrec1.sexes = []
            A11: @
          A1: NPrec1 := AUX_NPONitRFLPR
         >
      DECOMP
         <
          C1: singular IN CNVARrec1.numbers AND
              NPrec1 = AUX_NPONitRFLPR
            C11: CNVARrec1.genders = [omegagender] AND
                 CNVARrec1.sexes = []
            A11: @
          A1: @
         >

   SUBRULE (* 4. themselves *)
      < >
      < T1: REFLPRO(AUX_themselvesreflprokey){REFLPROrec1} >

      COMP
         <
          C1: plural IN CNVARrec1.numbers 
          A1: NPrec1 := AUX_NPONthemRFLPR
         >
      DECOMP
         <
          C1: plural IN CNVARrec1.numbers AND
              NPrec1 = AUX_NPONthemRFLPR
          A1: @
         >
>
&

