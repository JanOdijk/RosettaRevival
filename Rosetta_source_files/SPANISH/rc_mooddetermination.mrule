\begin{verbatim}
% RULE RmoodPtcPas2
< m1:I1::CLAUSE{CLAUSErec1}
               [ I2:subjrel/T1, 
                 mu1,
                 predrel/VERBP{VERBPrec1}
                     [ auxrel/VERB{VERBrec2}
                                [ head/SUBVERB{SUBVERBrec1}
                                   [ head/BVERB(KEY_haberBVERBkey){BVERBrec1} 
                                   ]
                                ],
                       auxrel/VERB{VERBrec3}
                                 [ head/SUBVERB{SUBVERBrec3}
                                       [ head/BVERB(KEY_serBVERBkey){BVERBrec3} 
                                       ] 
                                 ],
                       mu2
                     ],
                 mu3
               ] 
>

< m :I3::SENTENCE{SENTENCErec1}
               [ I2:subjrel/T1, 
                 mu1,
                 predrel/VERBP{VERBPrec1}[mu2],
                 mu3
               ] 
>


   MATCHCONDITIONS
      <
       I1: CLAUSErec1.PROsubject = true
       I3: SENTENCErec1 =
                  {
 		    mood       : declarative
		    senttype   : subordinateclause
                    modo       : PtcPas
                    finiteness : infinite
                    PROsubject : true
                    adverbial  : false
                    temporal   : false
                    conjclass  : omegaTimeadvClass
                    conjtiempo : omegatiempo
                    conjaspecto : omegaaspecto
                    conjretro  : false
                   }
       I2: T1.CAT IN [NPVAR, CNVAR]
      >

      COMP
         <
          C1: CLAUSErec1.voice = Passive    AND
              CLAUSErec1.modo  = omegamodo  AND
              VERBrec2.modo  = omegamodo   AND
              SUBVERBrec1 = COPYT_btosubverb(BVERBrec1) AND
              VERBrec2 = COPYT_subTOverb(SUBVERBrec1) AND
              VERBrec2 = 
		  {
		   numero    : omeganumero
		   persona   : 3
                   genero    : omegagenero
                   futuro    : nofuturo     
                   modo      : omegamodo       
                   tiempo    : omegatiempo 
                   aspecto   : omegaaspecto 
                   status    : bareV
                  }                                              AND
              SUBVERBrec3 = COPYT_btosubverb(BVERBrec3)      AND
              VERBrec3 = COPYT_subTOverb(SUBVERBrec3)        AND
              VERBrec3 =
		  {
		  numero  : omeganumero
		  persona : 3
		  genero  : masc
		  futuro  : nofuturo
		  modo    : PTcPas
		  tiempo  : omegatiempo
		  aspecto : omegaaspecto
		  status  : bareV
		  }
          A1: SENTENCErec1 := COPYT_clausetosentence(CLAUSErec1);
              SENTENCErec1 :=
		   {
 		    mood     : declarative
		    senttype : subordinateclause
                    modo     : PtcPas
		   }
            (* other attributes retain default values *)

         >
      DECOMP
         <
          C1: SENTENCErec1.voice = Passive 
          A1: CLAUSErec1 := COPYT_sentenceTOclause(SENTENCErec1);
              CLAUSErec1.modo  := omegamodo ;
              SUBVERBrec1 := COPYT_btosubverb(BVERBrec1);
              VERBrec2 := COPYT_subTOverb(SUBVERBrec1);
              VERBrec2 := 
		  {
		   numero    : omeganumero
		   persona   : 3
                   genero    : omegagenero
                   futuro    : nofuturo     
                   modo      : omegamodo       
                   tiempo    : omegatiempo 
                   aspecto   : omegaaspecto 
                   status    : bareV
                  };
              SUBVERBrec3 := COPYT_btosubverb(BVERBrec3);
              VERBrec3 := COPYT_subTOverb(SUBVERBrec3);
              VERBrec3 :=
		  {
		  numero  : omeganumero
		  persona : 3
		  genero  : masc
		  futuro  : nofuturo
		  modo    : PtcPas
		  tiempo  : omegatiempo
		  aspecto : omegaaspecto
		  status  : bareV
		  };

         >


&

\end{verbatim}
