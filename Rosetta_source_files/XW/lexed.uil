object le_morf_separator: XmSeparator {
  arguments {
  XmNtopAttachment  = XmATTACH_WIDGET;
  XmNtopWidget    = le_morf;
  XmNleftAttachment   = XmATTACH_FORM;
  XmNrightAttachment  = XmATTACH_FORM;
  XmNmargin       = 0;
  XmNorientation    = XmHORIZONTAL;
  };
};

object le_part_mean_form : XmForm {
  arguments {
  XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = le_morf_separator;
  XmNleftAttachment   = XmATTACH_FORM;
  XmNrightAttachment   = XmATTACH_FORM;
  };
  controls {
    XmForm   le_part_form;
    XmForm   le_mean_form;
  };
};

object le_part_form : XmForm {
  arguments {
    XmNtopAttachment  = XmATTACH_FORM;
    XmNleftAttachment   = XmATTACH_FORM;
    XmNwidth = 150;
    arguments form_args;
  };
  controls {
    XmLabel     le_part_text;
    XmScrolledList  le_part_list;
  };
};

object le_part_text : XmLabel {
  arguments {
  XmNtopAttachment  = XmATTACH_FORM;
  XmNleftAttachment   = XmATTACH_FORM;

    arguments label_args;
    XmNlabelString = 'Particles:';
  };
};

object le_part_list : XmScrolledList {
  arguments {
  XmNtopAttachment  = XmATTACH_WIDGET;
    XmNtopWidget    = XmLabel le_part_text;
  XmNleftAttachment   = XmATTACH_FORM;
  XmNrightAttachment  = XmATTACH_FORM;

    arguments list_args;
    XmNvisibleItemCount = 4;
    XmNselectionPolicy  = XmSINGLE_SELECT;
/*
    XmNitemCount = 5;
    XmNitems = string_table ( 'geit', 
                  'mannetje', 
                  'hijswerktuig', 
                  'gymnastiektoestel',
                  'zitplaats');
*/
  };
  callbacks {
    MrmNcreateCallback = procedure XwuCreateWidget (X_le_part_list);
    XmNdefaultActionCallback = procedure XwbAction (X_le_part_list);
  };
};

