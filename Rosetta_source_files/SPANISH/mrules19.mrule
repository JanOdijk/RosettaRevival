\newpage
\begin{verbatim}
% TRANSFORMATION TPtcPasAgr2

    (* agreement for Participium in infinite Passive clauses *)

< m1:I1::CLAUSE{CLAUSErec1}
           [ mu1,
             I4:subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                   [ mu4,
                     head/I6::VERB{VERBrec3}[mu5],
                     mu6
                   ],
             mu7
           ]             
>

< m :I1::CLAUSE{CLAUSErec1}
           [ mu1,
             I4:subjrel/T1,
             mu2,
             predrel/VERBP{VERBPrec1}
                   [ mu4,
                     head/I7::VERB{VERBrec6}[mu5],
                     mu6
                   ],
             mu7
           ]             
>

   MATCHCONDITIONS
      <
       I1: (CLAUSErec1.voice = Passive)
       I4: T1.CAT IN [NPVAR, PRONPVAR, CNVAR]
       I6: VERBrec3.modo = PtcPas
       I7: VERBrec6.modo = PtcPas

      >
<
   SUBRULE (* 1: NPVAR, PRONPVAR *)
      <T1: T2>
      <T1: T2>

   MATCHCONDITIONS
      <
       T1: T2.CAT IN [NPVAR, PRONPVAR]
      >

      COMP
         <
          C1: (VERBrec3 =
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  })                        
          A1: VERBrec6 := VERBrec3;
              VERBrec6.numero := T2.REC.numero;
              VERBrec6.genero := T2.REC.genero;
         >

      DECOMP
         <
          C1: (VERBrec6.genero = T2.REC.genero)     AND
              (VERBrec6.numero = T2.REC.numero)  


          A1: VERBrec3 := VERBrec6;
              VERBrec3 :=
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  };

         >

   SUBRULE (* CNVAR fem *)
      <T1: CNVAR{CNVARrec1}>
      <T1: CNVAR{CNVARrec1}>

      COMP
         <
          C1: (VERBrec3 =
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  })                        AND
              fem IN CNVARrec1.generos

          A1: VERBrec6 := VERBrec3;
              VERBrec6 :=
                  {
                   numero   : CNVARrec1.numero
                   genero   : fem
                  };
                   
         >

      DECOMP
         <
          C1: (VERBrec6.genero = fem)     AND
              (VERBrec6.numero = CNVARrec1.numero)     AND

              (fem IN CNVARrec1.generos)

          A1: VERBrec3 := VERBrec6;
              VERBrec3 :=
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  };

         >
   SUBRULE (* CNVAR masc *)
      <T1: CNVAR{CNVARrec1}>
      <T1: CNVAR{CNVARrec1}>

      COMP
         <
          C1: (VERBrec3 =
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  })                        AND
              masc IN CNVARrec1.generos

          A1: VERBrec6 := VERBrec3;
              VERBrec6 :=
                  {
                   numero   : CNVARrec1.numero
                   genero   : masc
                  };
         >

      DECOMP
         <
          C1: (VERBrec6.genero = masc)     AND
              (VERBrec6.numero = CNVARrec1.numero)     AND

              (masc IN CNVARrec1.generos)

          A1: VERBrec3 := VERBrec6;
              VERBrec3 :=
                  {
                   numero   : omeganumero
                   genero   : omegagenero
                  };

         >


>
&


\end{verbatim}
