\newpage
\begin{verbatim}
% RULE RIdentSentadvVar
< m1: NPPROP{NPPROPrec1}
                [ I1:mu1,
                  idrel/T1,
                  mu3 
                ]

  m2: T2
>

< m :NPPROP{NPPROPrec1}
                [ leftdislocrel/T2,
                  I1:mu1,
                  idrel/T1,
                  I3:mu3 
                ]
>

   MATCHCONDITIONS
      <
       I1: NOT EXIST (mu1, [leftdislocrel/..])
       I3: NOT EXIST (mu3, [I31:rel1/..])
         I31: rel1 IN [locadvrel, tempadvrel, postsentadvrel]
      >

<
   SUBRULE (* 1. ADVP *)
      < T2: ADVPVAR{ADVPVARrec1} >
      < T2: ADVPVAR{ADVPVARrec1} >

   MATCHCONDITIONS
      <
       T2: ADVPVARrec1.actsubcefs * [sentadv, causadv] <> []
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

   SUBRULE (* 2. PREPPVAR *)
      < T2: PREPPVAR{PREPPVARrec1} >
      < T2: PREPPVAR{PREPPVARrec1} >

   MATCHCONDITIONS
      <
       T2: caus IN PREPPVARrec1.actsubcefs
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >
>
&

\end{verbatim}
