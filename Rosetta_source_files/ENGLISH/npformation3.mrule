\begin{verbatim}

% RULE RNPformation6

< m1: WHPRO{WHPROrec1}[mu1]
>

< m: NP{NPrec1}[head/WHPRO{WHPROrec1}[mu1]] 
>


      COMP
         <
          C1: true
            C11: WHPROrec1.animate = yesanimate
            A11: NPrec1 := { human       : yeshuman
                             NPhead      : otherNP }
            C12: WHPROrec1.animate = noanimate
            A12: NPrec1 := { human       : nohuman
                             NPhead      : whatwhproNP }
          A1: NPrec1 := { animate     : WHPROrec1.animate
                          poss        : WHPROrec1.poss
                          definite    : indef
                          mood        : wh
                          superdeixis : omegadeixis
                          generic     : nogeneric
                          specQ       : yesspec
                          person      : 3
                          number      : WHPROrec1.number
                          sexes       : WHPROrec1.sexes 
                          posspred    : true}
             (* other attributes remain default, MJS *)
         >

      DECOMP
         <
          C1: NPrec1 = NPrecdef EXCEPT FOR [animate, human, person,
                 number, definite, mood, superdeixis, generic, poss,
                 sexes, specQ, NPhead, posspred] AND
              NPrec1 = { animate      : WHPROrec1.animate 
                         poss         : WHPROrec1.poss
                         definite     : indef
                         mood         : wh
                         superdeixis  : omegadeixis 
                         generic      : nogeneric
                         specQ        : yesspec
                         person       : 3
                         number       : WHPROrec1.number 
                         sexes        : WHPROrec1.sexes 
                         posspred     : true}
            C11: WHPROrec1.animate = yesanimate AND
                 NPrec1.human = yeshuman AND
                 NPrec1.NPhead = otherNP
            A11: @
            C12: WHPROrec1.animate = noanimate AND
                 NPrec1.human = nohuman AND
                 NPrec1.NPhead = whatwhproNP
            A12: @
          A1:  @
         >
&

\end{verbatim}
\newpage
