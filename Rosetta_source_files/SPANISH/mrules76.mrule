\newpage
\begin{verbatim}
% RULE RCNmodposs2

< m1: CN{CNrec1}[I1:mu1]


  m2: NP{NPrec1}[mu2, 
                 head/T1,
                 mu3
                ]
>

< m : CN{CNrec1}[I1:mu1,
                 posrel/PREPP{PREPPrec1}[head/PREP(KEY_deprepkey){PREPrec1}],
                                          complrel/NP{NPrec2}[mu2,
                                                              head/T2,
                                                              mu3
                                                             ]
                ]
>

   MATCHCONDITIONS
      < I1: EXIST(mu1, [head/EN{ENrec1}])  AND
            NOT EXIST (mu1, [posrel/..])  AND
            NOT EXIST (mu1, [postmodrel/PROPERNOUN{PROPERNOUNrec2}[mu7]]) 

         m2: NPrec1.generic = nogeneric AND
            NPrec1.cases = []
        I2: NPrec2.generic = omegageneric AND
            accusative IN NPrec2.cases 
      >

<
(* 1 *) 
SUBRULE          (*  (las EN  de) mi padre  *)

<T1: CN{CNrec2}[mu8]>
<T2: CN{CNrec3}[mu8]>


      COMP
         <
          C1: NPrec1.supertiempo = CNrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative];
              CNrec3 := CNrec2;
              CNrec3.cases := NPrec2.cases;
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo AND
              CNrec3.cases = NPrec2.cases
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := CNrec1.supertiempo;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
              CNrec2 := CNrec3;
              CNrec2.cases := [];

         >

(* 2 *) 
SUBRULE            (*  (las EN de ) mi *)

<T1: PERSPRO{PERSPROrec1}[head/BPERSPRO{BPERSPROrec1}]>
<T2: PERSPRO{PERSPROrec2}[head/BPERSPRO{BPERSPROrec1}]>

      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo AND
              PERSPROrec1 = COPYT_bTOperspro(BPERSPROrec1) AND
              PERSPROrec1.forma = Nomfuerte
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              PERSPROrec2 := PERSPROrec1;
              PERSPROrec2.forma := prepfuerte;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative]; 
         >

      DECOMP
         <
          C1: PERSPROrec2.forma = prepfuerte AND
              NPrec2.supertiempo = omegatiempo
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := CNrec1.supertiempo;
              PERSPROrec1 := PERSPROrec2;
              PERSPROrec1.forma := Nomfuerte;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
         >

(* 3 *) 
 SUBRULE   (* (las EN de) todo el mundo; NB: geen BINDEFPRO in het Spaans *)

<T1: INDEFPRO{INDEFPROrec1}>
<T2: INDEFPRO{INDEFPROrec1}>


      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative]; 
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := CNrec1.supertiempo;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
         >

(* 4 *) 
SUBRULE           (* (los EN de ) Juan *)

<T1: PROPERNOUN{PROPERNOUNrec1}[mu5]>
<T2: PROPERNOUN{PROPERNOUNrec1}[mu5]>


      COMP
         <
          C1: CNrec1.supertiempo = NPrec1.supertiempo
          A1: NPrec2 := NPrec1;
              NPrec2.supertiempo := omegatiempo;
              NPrec2.generic := omegageneric;
              NPrec2.cases := [accusative]; 
         >

      DECOMP
         <
          C1: NPrec2.supertiempo = omegatiempo
          A1: NPrec1 := NPrec2;
              NPrec1.supertiempo := CNrec1.supertiempo;
              NPrec1.generic := nogeneric;
              NPrec1.cases := []; 
         >

>
&

\end{verbatim}
