%KEYNAME
BASIS RULE
      KEYNAME = (AUX/1|KEYtje/6).UNDERSCORE/1.[QUOTEtje/7].IDENTIFIER/2.
                   {UNDERSCORE/1.IDENTIFIER/2}.[QUOTEtje/8]
          |IDENTIFIER/3.DOT/1.IDENTIFIER/4|
          KEY1/5|KEY2/5|KEY3/5|KEY4/5|KEY5/5|KEY6/5|KEY7/5|KEY8/5|KEY9/5|KEY10/5
SURFACE PART
VAR keyvar,keyIvar::bool;
    str1,str2:TSTRING_string;
    str3:TSTRING_string;int::int;
    beginquote,endquote::bool;

<*
INIT: BEGIN keyvar:=false; keyIvar:=false;TSTRING_constantempty(str1);
            TSTRING_constantempty(str3);
            TSTRING_constantempty(str2);
            beginquote:=FALSE;endquote:=FALSE;
      END;
1 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
2 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str1:=%.str;
                              IF TSTRING_length(str3)<>0 THEN
                                 BEGIN
                                 TSTRING_append(str3,'_');
                                 TSTRING_append(str3,str1);
                                 END
                              ELSE
                                 BEGIN
                                 str3:=str1;
                                 END;
                        END
    *>
3 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN str1:=%.str END
    *>
4 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN keyvar:= TRUE; str2:=%.str END
    *>
5 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN keyIvar:= TRUE; str1:=%.str END
    *>
6 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN END
    *>
7 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN beginquote:=TRUE END
    *>
8 : <* LOCALCONDITION:TRUE
       GLOBAL: #CONDITION: TRUE
               #ACTION: BEGIN endquote:=TRUE END
    *>
FINAL: #CONDITION:NOT(beginquote) OR endquote
       #ACTION: BEGIN SEND_KEYNAME;
                      IF TSTRING_length(str3)<>0 THEN
                        BEGIN
                        str1:=str3;
                        IF NOT(STRTOKEY_getSkey(str3,int)) THEN
                          BEGIN
       writeln('Skey ',str3,' must still be added to SKEYDEF.KDF!!');
writeln('OR string key must occur between quotes (if underscores in it)');
                          END;
                        END;
                      $KEYNAME.keyvar:=keyvar;
                      $KEYNAME.keyIvar:=keyIvar;
                      $KEYNAME.str1:=str1; $KEYNAME.str2:=str2
                END
*>
END;
PROCEDURAL PART
VAR
BEGIN
INIT: BEGIN END;
<*
1: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
2: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
3: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
4: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
5: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
6: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
7: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
8: <* SEND: BEGIN END
      !.
      RECEIVE: BEGIN END
   *>
*>
FINAL:BEGIN END
END;
