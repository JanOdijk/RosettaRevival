\begin{verbatim}
%
% TRANSFORMATION TIdVerbpattern
< m1: I1::VERBPPROP{VERBPPROPrec1}[mu1]
>

< m : I1::VERBPPROP{VERBPPROPrec1}[mu1]
>

   MATCHCONDITIONS
      <
       I1: VERBPPROPrec1.synvpefs <> []
      >

      COMP
         <
          C1: true
          A1: @
         >
      DECOMP
         <
          C1: true
          A1: @
         >

&

\end{verbatim}
