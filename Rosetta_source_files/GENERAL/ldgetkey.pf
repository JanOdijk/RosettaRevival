pragma C_include('ldgetkey.pf');

(*=========================================================================*
 *  Imported modules
 *=========================================================================*)


PACKAGE LDGETKEY;
WITH LISTREE;


(*MPF:::===================================================================*
 *
 *  Function Name  : LDGETKEY_Get
 *  Description    : Fetches the key from the topnode of the specified
 *                   tree. The function may only be called if the record
 *                   has a key field.
 *  Parameters     : s : LISTREE_pStree
 *  Result         : INTEGER;
 *
 *EMP:::===================================================================*)

FUNCTION LDGETKEY_Get(s: LISTREE_pStree): INTEGER;
EXTERNAL;

(*MPF:::===================================================================*
 *
 *  Procedure Name : LDGETKEY_Put
 *  Description    : Stores the key in the record of the topnode the specified
 *                   tree. The function may only be called if the record
 *                   has a key field.
 *  Parameters     : VAR s : LISTREE_pStree
 *                   k     : INTEGER
 *
 *EMP:::===================================================================*)

PROCEDURE LDGETKEY_Put(VAR s: LISTREE_pStree; k: INTEGER);
EXTERNAL;

END {LDGETKEY};
