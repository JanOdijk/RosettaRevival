% TRANSFORMATION TAcaseCausat
< m1:CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}
                            [ head/I1::VERB{VERBrec2}[mu13],
                              head/VERB{VERBrec3}[mu11]
                            ],
                      mu3,
                      I2:objrel/T2,
                      mu5,
                      mu12 
                    ],
             mu7 
           ]
> 


< m :CLAUSE{CLAUSErec1}
           [ mu1,
             predrel/VERBP{VERBPrec1}
                    [ mu2,
                      head/VERB{VERBrec1}
                            [head/I1::VERB{VERBrec2}[mu13],
                             head/BVERB{BVERBrec1}[mu11]
                            ],
                      mu3,
                      I3:objrel/T3,
                      mu5,
                      mu12 
                     ],
             mu7 
           ]
>


   MATCHCONDITIONS
      <
       I1: VERBrec2.Clustering = Restructuring
       I2: T2.CAT IN [NP, NPVAR, CNVAR]
       I3: T3.CAT IN [NP, NPVAR, CNVAR]    
      >


<
   SUBRULE  (* NP *)
      <T2: NP{NPrec1}[mu6] >
      <T3: NP{NPrec2}[mu6] >


      COMP
         <
          C1: Accusative IN NPrec1.cases   AND
              NPrec1.NPhead <> persproNP   AND
              (NPrec1.human = YesHuman     OR          
              (NPrec1.animate = yesAnimate  AND 
               NPrec1.definite = def)
              ) 

                (* AND
                (NPrec1.NPhead = persproNP) AND
                (NPrec1.genero <> neutro)  *)

          A1: NPrec2 := NPrec1;
              NPrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: Prepositive IN NPrec2.cases  AND
              NPrec2.NPhead <> persproNP AND
              (NPrec2.human = YesHuman OR
              (NPrec2.animate = yesAnimate  AND
               NPrec2.definite = def )
              )
              
          A1: NPrec1 := NPrec2;
              NPrec1.cases := [Accusative]
         >


   SUBRULE  (* NPVAR *)
      <T2: NPVAR{NPVARrec1}[mu6] >
      <T3: NPVAR{NPVARrec2}[mu6] >


      COMP
         <
          C1: Accusative IN NPVARrec1.cases   AND
              NPVARrec1.NPhead <> persproNP   AND
              (NPVARrec1.human = YesHuman     OR          
              (NPVARrec1.animate = yesAnimate  AND 
               NPVARrec1.definite = def)
              ) 
               
              
          A1: NPVARrec2 := NPVARrec1;
              NPVARrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: Prepositive IN NPVARrec2.cases  AND
              NPVARrec2.NPhead <> persproNP AND
              (NPVARrec2.human = YesHuman OR
              (NPVARrec2.animate = yesAnimate  AND
               NPVARrec2.definite = def )
              )
             
          A1: NPVARrec1 := NPVARrec2;
              NPVARrec1.cases := [Accusative]
         >


   SUBRULE  (* CNVAR *)
      <T2: CNVAR{CNVARrec1}[mu6] >
      <T3: CNVAR{CNVARrec2}[mu6] >


      COMP
         <
          C1: Accusative IN CNVARrec1.cases  AND
              (CNVARrec1.human = YesHuman     OR          
              (CNVARrec1.animate = yesAnimate  AND 
               CNVARrec1.definite = def)
              )

          A1: CNVARrec2 := CNVARrec1;
              CNVARrec2.cases := [Prepositive]
         >

      DECOMP
         <
          C1: Prepositive IN CNVARrec2.cases  AND
              (CNVARrec2.human = YesHuman OR
              (CNVARrec2.animate = yesAnimate  AND
               CNVARrec2.definite = def )
              )

          A1: CNVARrec1 := CNVARrec2;
              CNVARrec1.cases := [Accusative]
         >
>

&

\end{verbatim}
