\newpage
\begin{verbatim}
% RULE DETPformation1
< m1: DET{DETrec1}[mu1] 
>

< m : DETP{DETPrec1}[head/DET{DETrec1}[mu1]
                    ]
>

      COMP
         <
          C1: true
          A1: DETPrec1 := COPYT_DETtoDETP(DETrec1);
              DETPrec1.syntquant := omegaquant;
              (* superdeixis remains default *)
         >

      DECOMP
         <
          C1: DETPrec1 = (* COPYT_DETtoDETP(DETrec1) *)
                        { req         : DETrec1.req
                          env         : DETrec1.env      
                          possnietnp  : DETrec1.possnietnp 
                          definite    : DETrec1.definite
                          posspred    : DETrec1.posspred
                          possnumbers : DETrec1.possnumbers 
                          posscomas   : DETrec1.posscomas
                          mood        : DETrec1.mood
                          syntquant   : omegaquant  (* attribute has become 
                                                       irrelevant *)
                          superdeixis : omegadeixis
                         }
          A1:  @
         >
&

\end{verbatim}
