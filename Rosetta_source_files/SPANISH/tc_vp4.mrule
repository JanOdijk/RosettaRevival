\begin{verbatim}
% TRANSFORMATION TVerbpattern10
< m1: VERBPPROP{VERBPPROPrec1}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                        [ head/VERB{VERBrec1}[mu2],
                          argrel/T1,
                          argrel/T2
                        ] 
               ]
>

< m : VERBPPROP{VERBPPROPrec2}
               [ mu1,
                 predrel/VERBP{VERBPrec1}
                        [ head/VERB{VERBrec1}[mu2],
                          objrel/T1,
                          prepobjrel/VARPREPP{VARPREPPrec1}
                                   [ head/PREP(VERBrec1.prepkey1){PREPrec1},
                                     objrel/T2
                                   ]
                        ] 
               ]
>


<
   (* Lo consideran (a e\'{e}l como un loco (vp123)  *)

   SUBRULE (* 1 *)
      <T2: NPPROPVAR{NPPROPVARrec1} >
      <T2: NPPROPVAR{NPPROPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_PREPOPENNPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                NPPROPVARrec1.PROsubject = true
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_PREPOPENNPPROP];
                VARPREPPrec1 := PREPPrecdef;
                VARPREPPrec1 :=
                  { actsubcefs : PREPrec1.subcs
                    synppefs   : [synOPENNPPROP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
                    aspecto    : PREPrec1.aspecto
                    retro      : PREPrec1.retro
                    SpecQ      : yesspec
                  };
                        (* mood default *)

          A1:  @
         >


   (* Pintaron la puerta de rojo (vp123)\\
      NB. pintar {\em de} in lexicon!         *)

   SUBRULE (* 2 *)
      <T2: ADJPPROPVAR{ADJPPROPVARrec1} >
      <T2: ADJPPROPVAR{ADJPPROPVARrec1} >

      COMP
         <
          C1: T1.CAT IN [ NPVAR,CNVAR ]
            C2: synDONP_PREPOPENADJPPROP IN VERBrec1.synvps AND
                VERBPPROPrec1.synvpefs = [] AND
                ADJPPROPVARrec1.PROsubject = true
            A2: VERBPPROPrec2 := VERBPPROPrec1;
                VERBPPROPrec2.synvpefs := [synDONP_PREPOPENADJPPROP];
                VARPREPPrec1 := PREPPrecdef;
                VARPREPPrec1 :=
                  { mood       : ADJPPROPVARrec1.mood
                    actsubcefs : PREPrec1.subcs
                    synppefs   : [synOPENADJPPROP]
                    thetapp    : pp120
                    headkey    : PREPrec1.key
                    class      : PREPrec1.class
                    tiempo     : PREPrec1.tiempo
