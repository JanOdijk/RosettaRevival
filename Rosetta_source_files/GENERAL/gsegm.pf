PACKAGE GSEGM;
WITH LIMORFDEF, LISTREE, STRNG, INTERFACE7, INTERFACE8;

TYPE

(*MPT:::===================================================================*
 *
 *  Type name      : GSEGM_LayoutRuleMode
 *  Description    : Defines the two possible modes of the word layout rules:
 *                   splitting mode and non-splitting mode
 *
 *EMP:::===================================================================*)

   GSEGM_LayoutRuleMode = ( splitmode, nosplitmode );


(*MPF:::===================================================================*
 *
 *  Function Name  : GSEGM_GSEGMENTATION
 *  Description    : Implements the Generative Morphological Segmentation
 *                   formalism, as described in document R....
 *  Parameters     : sw : sequence of words (string without blanks)
 *  Result         : Datastructure containing the segmented results of each
 *                   of the words.
 *  Precondition   : 
 *  Postcondition  : 
 *
 *EMP:::===================================================================*)

FUNCTION GSEGM_GSEGMENTATION(sw: INTERFACE7_pRowSeqSegmKeys): 
                                        INTERFACE8_pSeqWords; 
EXTERNAL;


END {GSEGM};
