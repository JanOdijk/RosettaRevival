\newpage
\begin{verbatim}

%RULE RSTARTVPPROP100

<m1: I1::SUBVERB{SUBVERBrec1}[mu1]
 m2: T1
>
<m: I3::VERBPPROP{VERBPPROPrec1}[ I2:subjrel/T1, 
                             predrel/VERBP{VERBPrec1}
                                     [ head/I4::VERB{VERBrec1}
                                            [head/I1::SUBVERB{SUBVERBrec1}[mu1]]
                                     ]
                                ]
>

   MATCHCONDITIONS
      <
        I1: SUBVERBrec1.thetavp = vp100
        I2: T1.CAT IN AUX_VARCATSET
        m2: T1.CAT IN AUX_VARCATSET
        I3: VERBPPROPrec1=
		  { 
		   thetavp     : vp100
		   req         : [pospol, negpol, omegapol]
		   env         : [pospol, negpol, omegapol]
		   supertiempo : omegatiempo
		   PROsubject  : false
		   voice       : omegavoice
		   synvpefs    : []
		   aktionsarts : [] 
		  }
        I4: VERBrec1 =
		  {
		   numero       : omeganumero  
		   persona      : 3
                   genero       : omegagenero
		   modo         : omegamodo
		   tiempo       : omegatiempo  
                   aspecto      : omegaaspecto
		   status       : bareV
                   foundauxes   : []
		  }
      >


COMP
 <
   C1: true
   A1: VERBrec1 := COPYT_subtoverb(SUBVERBrec1);
       (* all other attributes retain their default values *)
       VERBPPROPrec1.thetavp := vp100
       (* all other attributes retain their default values *)
 >
&


\end{verbatim}
