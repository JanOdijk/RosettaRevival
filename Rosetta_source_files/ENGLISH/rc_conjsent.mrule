\newpage
\begin{verbatim}
% RULE RPrepFinSubsent
< m1: SENTENCE{SENTENCErec1}
              [ conjrel/CONJ(KEY_thatCONJkey){CONJrec1}, 
                mu1 
              ] 
  m2: PREP{PREPrec1}
>

< m : SENTENCE{SENTENCErec2}
              [ conjrel/PREP{PREPrec1}, 
                mu1 
              ] 
>

      COMP
         <
          C1: synTHATSENT IN PREPrec1.synpps AND
              SENTENCErec1 = { senttype   : subordinateclause
                               conjkey    : KEY_thatCONJkey
                               adverbial  : false
                               temporal   : false
                               conjclass  : omegaTimeAdvClass
                               conjdeixis : omegadeixis
                               conjaspect : omegaAspect
                               conjretro  : false }
            C11: temp IN PREPrec1.subcs
            A11: SENTENCErec2 := SENTENCErec1;
                 SENTENCErec2.temporal := true; 
            C12: PREPrec1.subcs - [temp] <> []
            A12: SENTENCErec2 := SENTENCErec1;
                 SENTENCErec2.temporal := false;
          A1: SENTENCErec2 := { adverbial  : true
                                conjclass  : PREPrec1.class
                                conjdeixis : PREPrec1.deixis
                                conjaspect : PREPrec1.aspect
                                conjretro  : PREPrec1.retro 
                                conjkey    : 0 }
         >

      DECOMP
         <
          C1: synTHATSENT IN PREPrec1.synpps AND
              SENTENCErec2 = { senttype   : subordinateclause
                               adverbial  : true
                               conjclass  : PREPrec1.class
                               conjdeixis : PREPrec1.deixis
                               conjaspect : PREPrec1.aspect
                               conjretro  : PREPrec1.retro
                               conjkey    : 0 }
            C11: temp IN PREPrec1.subcs AND
                 SENTENCErec2.temporal = true
            A11: SENTENCErec1 := SENTENCErec2;
            C12: PREPrec1.subcs - [temp] <> [] AND
                 SENTENCErec2.temporal = false
            A12: SENTENCErec1 := SENTENCErec2;
          A1: SENTENCErec1 := { adverbial  : false
                                temporal   : false
                                conjclass  : omegaTimeAdvClass
                                conjdeixis : omegadeixis
                                conjaspect : omegaAspect
                                conjretro  : false
                                conjkey    : KEY_thatCONJkey }
         >

&

\end{verbatim}
